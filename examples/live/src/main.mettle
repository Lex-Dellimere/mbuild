// A tiny simulation to patch while it runs: `mbuild live`, then edit
// rules.mettle; or `mbuild shell` and poke it from the prompt.
import "std/io";
import "std/thread";
import "mbuild/shell";
import "rules";

// the simulation's state
struct World {
  tick: int32;   // ticks so far
  pop: int32;    // people
  food: int32;   // food in store
}

// the one world, a global so `mbuild shell` can reach it
var world: World;

fn main() -> int32 {
  world.tick = 0;
  world.pop = 10;
  world.food = 100;
  while (world.tick < 600) {
    quiesce;
    shell_point();
    world.food = world.food + harvest(world.pop);
    world.pop = grow(world.pop, world.food);
    world.food = world.food - world.pop;
    if (world.food < 0) {
      world.food = 0;
    }
    println("tick {world.tick}  pop {world.pop}  food {world.food}  ({rule_name()})");
    world.tick = world.tick + 1;
    Sleep(500);
  }
  return 0;
}
