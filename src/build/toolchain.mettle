// toolchain: finds and runs Mettle compilers per target, and installs,
// pins and updates toolchains (DESIGN.md section 9).
//
// A Windows .exe is built by the Windows compiler and a Linux binary by the
// Linux one, so each target has its own compiler: on Linux the Windows
// compiler runs as `wine mettle.exe`, under wine the Linux compiler runs as a
// host program. tc_select never starts a compiler (wine takes about a second
// to start); tc_version asks it lazily and caches the answer by identity.
//
// Installed toolchains are host compilers in $MBUILD_HOME/toolchains/<id>/
// (a release tag, or dev-<git describe> for a source build), laid out like
// the release archives: bin/mettle (mettle.exe on Windows), stdlib/,
// runtime/ and toolchain.toml. Each is put together in a temporary directory
// beside them and renamed into place, so a half-finished install never
// looks installed.

import "std/io";
import "std/mem";
import "../core/base";
import "../core/path";
import "../core/fs";
import "../core/proc";
import "../core/sha256";
import "../model/semver";
import "../model/toml";
import "../model/manifest";
import "../model/project";
import "../config/mbfile";
import "../core/sys_linux" if linux;
import "../core/sys_windows" if windows;

export struct Mettle {
  target: string;        // what it builds for: "linux" | "windows"
  path: string;          // the compiler executable (host form)
  via_wine: bool;        // a Windows compiler started as `wine path` from Linux
  tool: Tool;            // what actually runs (wine, the compiler, or a host program under wine)
  stdlib_dir: string;
  runtime_dir: string;
  id: string;            // identity for fingerprints: path|size|mtime
  version: string;       // "" until tc_version
  source: string;        // how it was found, for messages
  installed: string;     // the toolchains/<version> it came from, "" otherwise
}

// Why the last tcx_pick or tcx_download failed.
var g_tcx_err: string;
var g_tcx_hint: string;

// ---------------------------------------------------------------------------
// Paths
// ---------------------------------------------------------------------------

// Under wine a Linux absolute path ("/home/x") becomes its Z: form, which
// the Windows file APIs open; anything else is returned as is.
fn tcx_win_form(p: string) -> string {
  if (sys_is_wine() && s_starts(p, "/") && !s_starts(p, "//")) {
    return "Z:" + p;
  }
  return p;
}

// $MBUILD_HOME accepts the Windows or (under wine) the Linux form.
fn tcx_home() -> string {
  var h: string = env_get("MBUILD_HOME");
  if (slen(h) > 0) {
    if (s_eq(sys_os(), "windows")) {
      h = s_replace_byte(h, 92, 47);
    }
    return p_clean(tcx_win_form(h));
  }
  return fs_mbuild_home();
}

fn tcx_root() -> string {
  return tcx_home() + "/toolchains";
}

fn tcx_dir(id: string) -> string {
  return tcx_root() + "/" + id;
}

fn tcx_rel_exe(target: string) -> string {
  if (s_eq(target, "windows")) {
    return "mettle.exe";
  }
  return "bin/mettle";
}

fn tcx_exe_in(dir: string) -> string {
  return dir + "/" + tcx_rel_exe(sys_os());
}

fn tcx_installed(id: string) -> bool {
  if (slen(id) == 0 || s_starts(id, ".") || s_find_byte(id, 47) >= 0 || s_find_byte(id, 92) >= 0) {
    return false;
  }
  return fs_is_file(tcx_exe_in(tcx_dir(id)));
}

fn tcx_upper(target: string) -> string {
  if (s_eq(target, "windows")) {
    return "WINDOWS";
  }
  return "LINUX";
}

// "0.16.3" -> "v0.16.3"; "latest" and anything that is not a version stay.
fn tcx_norm(v: string) -> string {
  var t: string = s_trim(v);
  if (sv_is(t)) {
    return sv_canonical(t);
  }
  return t;
}

// Releases first, newest first, then dev builds by id.
fn tcx_id_before(a: string, b: string) -> bool {
  var ra: bool = sv_is(a);
  var rb: bool = sv_is(b);
  if (ra != rb) {
    return ra;
  }
  if (ra) {
    return sv_cmp(a, b) > 0;
  }
  return s_cmp(a, b) > 0;
}

// The installed toolchain ids.
fn tcx_ids() -> StrList* {
  var found: StrList* = sl_new();
  var files: StrList* = sl_new();
  var dirs: StrList* = sl_new();
  sys_list_dir(tcx_root(), files, dirs);
  var i: int64 = 0;
  while (i < dirs->len) {
    var id: string = sl_get(dirs, i);
    if (tcx_installed(id)) {
      var j: int64 = found->len;
      sl_push(found, id);
      while (j > 0 && tcx_id_before(id, sl_get(found, j - 1))) {
        sl_set(found, j, sl_get(found, j - 1));
        j = j - 1;
      }
      sl_set(found, j, id);
    }
    i = i + 1;
  }
  tcx_sl_free(files);
  tcx_sl_free(dirs);
  return found;
}

// toolchains/<id>/toolchain.toml.
struct TcxInfo {
  id: string;
  version: string;    // as the compiler reports it
  source: string;     // "release", or the checkout it was built from
  describe: string;   // the release tag, or git describe of the checkout
  installed: string;  // YYYY-MM-DD
}

fn tcx_info(id: string) -> TcxInfo {
  var t: TcxInfo;
  t.id = id;
  var file: string = tcx_dir(id) + "/toolchain.toml";
  var r: FsRead = fs_read(file);
  var doc: Toml* = toml_parse(r.data, file);
  t.version = toml_str(doc, "toolchain", "version");
  t.source = toml_str(doc, "toolchain", "source");
  t.describe = toml_str(doc, "toolchain", "describe");
  t.installed = toml_str(doc, "toolchain", "installed");
  return t;
}

fn tcx_info_text(t: TcxInfo) -> string {
  var b: Buf* = buf_new();
  buf_line(b, "# written by mbuild toolchain install");
  buf_line(b, "[toolchain]");
  buf_line(b, "id = " + toml_quote(t.id));
  buf_line(b, "version = " + toml_quote(t.version));
  buf_line(b, "source = " + toml_quote(t.source));
  buf_line(b, "describe = " + toml_quote(t.describe));
  buf_line(b, "installed = " + toml_quote(t.installed));
  return buf_take(b);
}

fn tcx_two(n: int64) -> string {
  if (n < 10) {
    return "0" + s_int(n);
  }
  return s_int(n);
}

// The modification day of file as YYYY-MM-DD (UTC).
fn tcx_date_of(file: string) -> string {
  var fi: FileInfo = sys_stat(file);
  var secs: int64 = fi.mtime / 1000000000;
  if (s_eq(sys_os(), "windows")) {
    secs = fi.mtime / 10000000 - 11644473600;
  }
  var z: int64 = secs / 86400 + 719468;
  var era: int64 = z / 146097;
  var doe: int64 = z - era * 146097;
  var yoe: int64 = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
  var doy: int64 = doe - (365 * yoe + yoe / 4 - yoe / 100);
  var mp: int64 = (5 * doy + 2) / 153;
  var d: int64 = doy - (153 * mp + 2) / 5 + 1;
  var m: int64 = mp + 3;
  var y: int64 = yoe + era * 400;
  if (m > 12) {
    m = m - 12;
    y = y + 1;
  }
  return s_int(y) + "-" + tcx_two(m) + "-" + tcx_two(d);
}

// The machine default, [toolchain] default in $MBUILD_HOME/config.toml.
fn tcx_config_file() -> string {
  return tcx_home() + "/config.toml";
}

fn tcx_default() -> string {
  var file: string = tcx_config_file();
  var r: FsRead = fs_read(file);
  if (!r.ok) {
    return s_empty();
  }
  return toml_str(toml_parse(r.data, file), "toolchain", "default");
}

fn tcx_set_default(id: string) -> bool {
  var text: string = "# written by mbuild toolchain default\n[toolchain]\n";
  if (slen(id) > 0) {
    text = text + "default = " + toml_quote(id) + "\n";
  }
  fs_mkdirs(tcx_home());
  return fs_write(tcx_config_file(), text);
}

// An installed toolchain named by id or version ("0.18" too), "" when none.
// A version names the most recently installed toolchain reporting it.
fn tcx_find(name: string) -> string {
  var n: string = tcx_norm(name);
  if (tcx_installed(n)) {
    return n;
  }
  var ids: StrList* = tcx_ids();
  var best: string = s_empty();
  var best_day: string = s_empty();
  var i: int64 = 0;
  while (i < ids->len) {
    var t: TcxInfo = tcx_info(sl_get(ids, i));
    if (s_eq(tcx_norm(t.version), n) && (slen(best) == 0 || s_cmp(t.installed, best_day) > 0)) {
      best = t.id;
      best_day = t.installed;
    }
    i = i + 1;
  }
  tcx_sl_free(ids);
  return best;
}

fn tcx_mbfile(p: Project*) -> string {
  if (slen(p->mbfile) > 0) {
    return p->mbfile;
  }
  return p->root + "/mbuild.mettle";
}

// mb_toolchain("...") in fn project(), read as text: it chooses the
// compiler that compiles mbuild.mettle itself.
fn tcx_pin(p: Project*) -> string {
  var file: string = tcx_mbfile(p);
  var r: FsRead = fs_read(file);
  if (!r.ok) {
    return s_empty();
  }
  return s_trim(mbf_call_arg(r.data, "mb_toolchain", s_empty(), 0));
}

// The compiler's own rule: <exe dir>/../leaf when it exists, else
// <exe dir>/leaf; "" when neither does.
fn tcx_sibling(exe: string, leaf: string) -> string {
  var dir: string = p_dir(exe);
  var packaged: string = p_clean(p_join(dir, "../" + leaf));
  if (fs_is_dir(packaged)) {
    return packaged;
  }
  var beside: string = p_join(dir, leaf);
  if (fs_is_dir(beside)) {
    return beside;
  }
  return s_empty();
}

// A user-given compiler (a path or a name on PATH) as a path this process
// can open. Unresolvable names come back unchanged for the caller to report.
fn tcx_resolve(given: string) -> string {
  var w: string = tcx_win_form(given);
  if (fs_is_file(w)) {
    return w;
  }
  var t: Tool = sys_find_tool(w);
  if (tool_found(t)) {
    if (t.unix) {
      return tcx_win_form(t.path);
    }
    return t.path;
  }
  return w;
}

// ---------------------------------------------------------------------------
// Host tools
// ---------------------------------------------------------------------------

fn tcx_wine() -> Tool {
  return proc_tool("wine", "MBUILD_WINE");
}

// curl, tar, unzip, ...: the variable env_override when set, else PATH;
// under wine the host's programs (wine's PATH holds Windows programs only).
fn tcx_host_tool(name: string, env_override: string) -> Tool {
  var ev: string = env_get(env_override);
  if (slen(ev) > 0) {
    return sys_find_tool(ev);
  }
  if (!sys_is_wine()) {
    return sys_find_tool(name);
  }
  var unix_path: string = env_get("MBUILD_UNIX_PATH");
  if (slen(unix_path) == 0) {
    unix_path = sys_unix_path_default();
  }
  var dirs: StrList* = s_split(unix_path, 58);
  var i: int64 = 0;
  while (i < dirs->len) {
    var d: string = sl_get(dirs, i);
    if (slen(d) > 0) {
      var t: Tool = sys_find_tool(p_join(d, name));
      if (tool_found(t) && t.unix) {
        tcx_sl_free(dirs);
        return t;
      }
    }
    i = i + 1;
  }
  tcx_sl_free(dirs);
  return tool_none();
}

// Explains a host tool that was not found: what it is needed for (`what`),
// then either the override variable's bad value or the plain miss.
fn tcx_tool_missing(what: string, name: string, env_override: string, install: string) {
  var ev: string = env_get(env_override);
  if (slen(ev) == 0) {
    tcx_set_err(what + ": " + name + " not found", install + ", or set " + env_override + " to its path");
    return;
  }
  var unset_hint: string = "point " + env_override + " at the " + name + " executable, or unset it to search for " + name;
  if (s_find_byte(ev, 47) < 0 && s_find_byte(ev, 92) < 0) {
    tcx_set_err(what + ", but " + env_override + "=" + ev + " is not found on PATH", unset_hint);
  } else if (!fs_exists(tcx_win_form(ev))) {
    tcx_set_err(what + ", but " + env_override + "=" + ev + " does not exist", unset_hint);
  } else {
    tcx_set_err(what + ", but " + env_override + "=" + ev + " is not a program mbuild can run", unset_hint);
  }
}

fn tcx_wine_missing() -> Mettle* {
  tcx_tool_missing("building for windows on Linux needs wine to run the Windows Mettle compiler", "wine", "MBUILD_WINE", "install wine (e.g. `sudo apt install wine`)");
  return (Mettle*)0;
}

fn tcx_sl_free(l: StrList*) {
  free(l->items);
  free(l);
}

fn tcx_cmd_free(c: Cmd*) {
  tcx_sl_free(c->args);
  tcx_sl_free(c->kinds);
  tcx_sl_free(c->env);
  free(c);
}

// The tools KEY of mbuild.local.mettle (m->local->tools, "key=value"; read
// as text before the file is evaluated); "" when it does not set it.
fn tcx_tools_value(p: Project*, key: string) -> string {
  if (p->man == (Manifest*)0 || p->man->local == (Manifest*)0) {
    var file: string = p->root + "/mbuild.local.mettle";
    var r: FsRead = fs_read(file);
    if (!r.ok) {
      return s_empty();
    }
    return mbf_call_arg(r.data, "mb_tool", key, 1);
  }
  if (p->man->local->tools == (StrList*)0) {
    return s_empty();
  }
  var l: StrList* = p->man->local->tools;
  var i: int64 = 0;
  while (i < l->len) {
    if (s_starts(sl_get(l, i), key + "=")) {
      return s_from(sl_get(l, i), slen(key) + 1);
    }
    i = i + 1;
  }
  return s_empty();
}

// A relative path in [tools] is relative to the project root; a bare name
// is looked up on PATH.
fn tcx_tools_path(p: Project*, v: string) -> string {
  if (p_is_abs(v) || (s_find_byte(v, 47) < 0 && s_find_byte(v, 92) < 0)) {
    return v;
  }
  return p_clean(p_join(p->root, v));
}

fn tcx_set_err(msg: string, hint: string) {
  g_tcx_err = msg;
  g_tcx_hint = hint;
}

fn tcx_none(msg: string, hint: string) -> Mettle* {
  tcx_set_err(msg, hint);
  return (Mettle*)0;
}

// ---------------------------------------------------------------------------
// Selection
// ---------------------------------------------------------------------------

fn tcx_make(target: string, exe: string, source: string) -> Mettle* {
  var real: string = sys_realpath(exe);
  if (slen(real) == 0) {
    real = exe;
  }
  var fi: FileInfo = sys_stat(real);
  if (!fi.exists || fi.is_dir) {
    return tcx_none("the Mettle compiler " + exe + " (from " + source + ") does not exist", "point " + source + " at a Mettle compiler executable");
  }
  var m: Mettle* = new Mettle;
  m->target = target;
  m->path = real;
  m->via_wine = false;
  m->tool = tool_none();
  if (s_eq(sys_os(), "linux") && s_eq(target, "windows")) {
    m->tool = tcx_wine();
    m->via_wine = true;
    if (!tool_found(m->tool)) {
      return tcx_wine_missing();
    }
  } else {
    m->tool = sys_find_tool(real);
    if (!tool_found(m->tool)) {
      return tcx_none("the Mettle compiler " + real + " (from " + source + ") cannot be run", "make it executable, or point " + source + " at another compiler");
    }
    if (sys_is_wine() && m->tool.unix != s_eq(target, "linux")) {
      return tcx_none(real + " (from " + source + ") is not a " + target + " compiler", "point " + source + " at the " + target + " Mettle compiler");
    }
  }
  m->stdlib_dir = tcx_sibling(real, "stdlib");
  m->runtime_dir = tcx_sibling(real, "runtime");
  m->id = real + "|" + s_int(fi.size) + "|" + s_int(fi.mtime);
  m->version = s_empty();
  m->source = source;
  m->installed = s_empty();
  var root: string = tcx_root() + "/";
  if (s_starts(real, root)) {
    var rest: string = s_from(real, slen(root));
    var slash: int64 = s_find_byte(rest, 47);
    if (slash > 0 && tcx_installed(s_sub(rest, 0, slash))) {
      m->installed = s_sub(rest, 0, slash);
    }
  }
  return m;
}

fn tcx_make_installed(target: string, id: string, source: string) -> Mettle* {
  return tcx_make(target, tcx_exe_in(tcx_dir(id)), source);
}

// The compiler for target, or 0 with g_tcx_err/g_tcx_hint set: --mettle
// (host), MBUILD_METTLE_<T>, $METTLE (host), mb_tool("mettle-<t>") in
// mbuild.local.mettle, then for the host the project's mb_toolchain pin,
// the default toolchain and mettle on PATH.
fn tcx_pick(p: Project*, target: string) -> Mettle* {
  tcx_set_err(s_empty(), s_empty());
  if (!target_valid(target)) {
    return tcx_none("unknown target '" + target + "'", "targets are linux and windows");
  }
  var host: string = sys_os();
  if (s_eq(host, "windows") && s_eq(target, "linux") && !sys_is_wine()) {
    return tcx_none("cannot build for linux on Windows: the Linux Mettle compiler only runs on Linux", "build Linux binaries on Linux (or WSL); mbuild running under wine can also drive the Linux compiler");
  }
  if (s_eq(host, "linux") && s_eq(target, "windows") && !tool_found(tcx_wine())) {
    return tcx_wine_missing();
  }
  var is_host: bool = s_eq(target, host);
  var env_name: string = "MBUILD_METTLE_" + tcx_upper(target);
  var ev: string = env_get(env_name);
  var tools_key: string = "mettle-" + target;
  var tools_val: string = tcx_tools_value(p, tools_key);
  var local_src: string = "mb_tool(\"" + tools_key + "\") in mbuild.local.mettle";
  if (is_host && p->opts != (Options*)0 && slen(p->opts->mettle) > 0) {
    return tcx_make(target, tcx_resolve(p->opts->mettle), "--mettle");
  }
  if (slen(ev) > 0) {
    if (s_eq(ev, tools_val)) {
      return tcx_make(target, tcx_resolve(tcx_tools_path(p, tools_val)), local_src);
    }
    return tcx_make(target, tcx_resolve(ev), env_name);
  }
  if (is_host) {
    var me: string = env_get("METTLE");
    if (slen(me) > 0) {
      return tcx_make(target, tcx_resolve(me), "$METTLE");
    }
  }
  if (slen(tools_val) > 0) {
    return tcx_make(target, tcx_resolve(tcx_tools_path(p, tools_val)), local_src);
  }
  if (!is_host) {
    return tcx_none("no Mettle compiler for " + target, "set " + env_name + ", or mb_tool(\"mettle-" + target + "\", PATH) in mbuild.local.mettle, to a " + target + " build of Mettle");
  }
  var pin: string = tcx_pin(p);
  if (slen(pin) > 0) {
    var id: string = tcx_find(pin);
    if (slen(id) == 0) {
      var hint: string = "mbuild toolchain install " + pin;
      if (s_starts(pin, "dev-")) {
        hint = "mbuild toolchain install --from DIR (the Mettle checkout at " + s_from(pin, 4) + ")";
      }
      return tcx_none("this project pins Mettle " + pin + " (mb_toolchain in mbuild.mettle), which is not installed", hint);
    }
    return tcx_make_installed(target, id, "mb_toolchain(\"" + pin + "\") in mbuild.mettle");
  }
  var def: string = tcx_default();
  if (slen(def) > 0) {
    if (tcx_installed(def)) {
      return tcx_make_installed(target, def, "the default toolchain");
    }
    verbose("the default toolchain " + def + " is not installed any more");
  }
  var on_path: Tool = sys_find_tool("mettle");
  if (tool_found(on_path) && !on_path.unix) {
    return tcx_make(target, on_path.path, "mettle on PATH");
  }
  return tcx_none("no Mettle compiler for " + target, "run `mbuild toolchain install latest`, or `mbuild toolchain install --from DIR` for a Mettle checkout, or set METTLE");
}

fn tcx_fail_last() {
  if (slen(g_tcx_hint) > 0) {
    fail_hint(g_tcx_err, g_tcx_hint);
  }
  fail(g_tcx_err);
}

export fn tc_select(p: Project*, target: string) -> Mettle* {
  var m: Mettle* = tcx_pick(p, target);
  if (m == (Mettle*)0) {
    tcx_fail_last();
  }
  verbose("mettle for " + target + ": " + m->path + " (" + m->source + ")");
  return m;
}

export fn tc_cmd(m: Mettle*) -> Cmd* {
  var c: Cmd* = cmd_new(m->tool);
  if (m->via_wine) {
    cmd_env(c, "WINEDEBUG", "-all");
    cmd_path(c, m->path);
  }
  return c;
}

// ---------------------------------------------------------------------------
// Version (cached by identity: running wine costs about a second)
// ---------------------------------------------------------------------------

fn tcx_parse_version(text: string) -> string {
  var lines: StrList* = s_lines(s_trim(text));
  var first: string = s_empty();
  if (lines->len > 0) {
    first = s_trim(sl_get(lines, 0));
  }
  tcx_sl_free(lines);
  var words: StrList* = s_fields(first);
  var v: string = first;
  if (words->len >= 2 && s_eq(sl_get(words, 0), "mettle")) {
    v = sl_get(words, 1);
  }
  tcx_sl_free(words);
  return v;
}

export fn tc_version(m: Mettle*) -> string {
  if (slen(m->version) > 0) {
    return m->version;
  }
  var cache: string = tcx_root() + "/versions.cache";
  var r: FsRead = fs_read(cache);
  var old: string = s_empty();
  if (r.ok) {
    old = r.data;
    var lines: StrList* = s_lines(r.data);
    var i: int64 = 0;
    while (i < lines->len) {
      var line: string = sl_get(lines, i);
      var tab: int64 = s_find_byte(line, 9);
      if (tab > 0 && s_eq(s_sub(line, 0, tab), m->id)) {
        m->version = s_from(line, tab + 1);
      }
      i = i + 1;
    }
    tcx_sl_free(lines);
    if (slen(m->version) > 0) {
      return m->version;
    }
  }
  var c: Cmd* = tc_cmd(m);
  cmd_arg(c, "--version");
  var cap: Captured = proc_capture_all(c);
  tcx_cmd_free(c);
  var v: string = tcx_parse_version(cap.out);
  if (cap.code != 0 || slen(v) == 0) {
    return s_empty();
  }
  m->version = v;
  if (slen(old) > 0 && !s_ends(old, "\n")) {
    old = old + "\n";
  }
  fs_write(cache, old + m->id + "\t" + v + "\n");
  return v;
}

// "" when m is new enough for `need`, else the error text (DESIGN.md 11.6)
// without the "error: " prefix: the first line, then "\n  help: ..." that
// callers may extend with ", or require ...". A compiler whose version is
// not a release number (a development build) passes.
export fn tc_require_minimum(m: Mettle*, need: string, who: string) -> string {
  var want: string = tcx_norm(need);
  if (!sv_is(want)) {
    return s_empty();
  }
  var have: string = tc_version(m);
  if (!sv_is(have)) {
    verbose("the " + m->target + " compiler " + m->path + " reports version '" + have + "', not a release: assuming it satisfies Mettle " + want + " (" + who + ")");
    return s_empty();
  }
  if (sv_cmp(have, want) >= 0) {
    return s_empty();
  }
  return who + " needs Mettle " + want + " or newer; the " + m->target + " compiler is " + have + " (" + m->path + ")\n  help: install a newer compiler (mbuild toolchain install)";
}

// ---------------------------------------------------------------------------
// Flag support (DESIGN.md 11.7): probed once per compiler identity
// ---------------------------------------------------------------------------

// The argument the compiler rejected in `out`, "" when it rejected none.
fn tcx_rejected(out: string) -> string {
  var mark: string = "Unknown or misplaced argument '";
  var at: int64 = s_find(out, mark);
  if (at < 0) {
    return s_empty();
  }
  var start: int64 = at + slen(mark);
  var end: int64 = start;
  while (end < slen(out) && s_byte(out, end) != 39 && s_byte(out, end) != 10) {
    end = end + 1;
  }
  return s_sub(out, start, end);
}

// A probe unit: a flag starting with '-' and the values that follow it
// ("--subsystem windows"), so value pairs stay pairs.
struct TcxUnits {
  keys: StrList*;   // the unit's arguments joined by spaces (the cache key)
  first: int64*;    // index of the flag in the argument list
  count: int64*;    // number of arguments
  state: int32*;    // 0 unknown, 1 supported, 2 unsupported
  n: int64;
}

fn tcx_units(flags: StrList*) -> TcxUnits* {
  var u: TcxUnits* = new TcxUnits;
  u->keys = sl_new();
  u->first = (int64*)malloc((flags->len + 1) * 8);
  u->count = (int64*)malloc((flags->len + 1) * 8);
  u->state = (int32*)malloc((flags->len + 1) * 4);
  u->n = 0;
  var i: int64 = 0;
  while (i < flags->len) {
    var a: string = sl_get(flags, i);
    if (slen(a) > 1 && s_byte(a, 0) == 45) {
      var j: int64 = i + 1;
      var key: string = a;
      while (j < flags->len && !s_starts(sl_get(flags, j), "-")) {
        key = key + " " + sl_get(flags, j);
        j = j + 1;
      }
      if (!sl_has(u->keys, key)) {
        sl_push(u->keys, key);
        u->first[u->n] = i;
        u->count[u->n] = j - i;
        u->state[u->n] = 0;
        u->n = u->n + 1;
      }
      i = j;
    } else {
      i = i + 1;
    }
  }
  return u;
}

fn tcx_units_free(u: TcxUnits*) {
  tcx_sl_free(u->keys);
  free(u->first);
  free(u->count);
  free(u->state);
  free(u);
}

// The flags (of `flags`, a compiler argument list) that m rejects, each
// named by its flag (the value of a pair is not repeated). Every flag costs
// one probe per compiler identity, ever: answers live in
// $MBUILD_HOME/toolchains/flags.cache as "<id>\t<flag>\t<1|0>".
export fn tc_unsupported(m: Mettle*, flags: StrList*) -> StrList* {
  var bad: StrList* = sl_new();
  var u: TcxUnits* = tcx_units(flags);
  var cache: string = tcx_root() + "/flags.cache";
  var r: FsRead = fs_read(cache);
  var old: string = s_empty();
  var pending: int64 = 0;
  if (r.ok) {
    old = r.data;
  }
  var lines: StrList* = s_lines(old);
  var prefix: string = m->id + "\t";
  var i: int64 = 0;
  while (i < lines->len) {
    var line: string = sl_get(lines, i);
    if (s_starts(line, prefix)) {
      var rest: string = s_from(line, slen(prefix));
      var tab: int64 = s_rfind_byte(rest, 9);
      if (tab > 0) {
        var at: int64 = sl_index(u->keys, s_sub(rest, 0, tab));
        if (at >= 0) {
          if (s_eq(s_from(rest, tab + 1), "1")) {
            u->state[at] = 1;
          } else {
            u->state[at] = 2;
          }
        }
      }
    }
    i = i + 1;
  }
  tcx_sl_free(lines);
  i = 0;
  while (i < u->n) {
    if (u->state[i] == 0) {
      pending = pending + 1;
    }
    i = i + 1;
  }

  var learned: Buf* = buf_new();
  if (pending > 0) {
    var tmp: string = tcx_home() + "/tmp";
    fs_mkdirs(tmp);
    var probe: string = tmp + "/mbuild-probe-missing.mettle";
    if (fs_exists(probe)) {
      sys_remove_tree(probe);
    }
    verbose("probing " + s_int(pending) + " flag(s) of the " + m->target + " compiler " + m->path);
  }
  while (pending > 0) {
    var c: Cmd* = tc_cmd(m);
    cmd_path(c, tcx_home() + "/tmp/mbuild-probe-missing.mettle");
    i = 0;
    while (i < u->n) {
      if (u->state[i] == 0) {
        var k: int64 = 0;
        while (k < u->count[i]) {
          cmd_arg(c, sl_get(flags, u->first[i] + k));
          k = k + 1;
        }
      }
      i = i + 1;
    }
    var cap: Captured = proc_capture_all(c);
    tcx_cmd_free(c);
    var rejected: string = tcx_rejected(cap.out);
    var hit: int64 = -1;
    if (slen(rejected) > 0) {
      i = 0;
      while (i < u->n && hit < 0) {
        if (u->state[i] == 0) {
          var k2: int64 = 0;
          while (k2 < u->count[i]) {
            if (s_eq(sl_get(flags, u->first[i] + k2), rejected)) {
              hit = i;
            }
            k2 = k2 + 1;
          }
        }
        i = i + 1;
      }
    }
    if (hit >= 0) {
      u->state[hit] = 2;
      buf_line(learned, prefix + sl_get(u->keys, hit) + "\t0");
      pending = pending - 1;
    } else {
      // "Could not read file" (or any other answer) ends the probe; only an
      // answer from the compiler itself is worth remembering.
      var answered: bool = slen(rejected) == 0 && s_contains(cap.out, "Error");
      i = 0;
      while (i < u->n) {
        if (u->state[i] == 0) {
          u->state[i] = 1;
          if (answered) {
            buf_line(learned, prefix + sl_get(u->keys, i) + "\t1");
          }
        }
        i = i + 1;
      }
      if (!answered) {
        verbose("unexpected answer from " + m->path + " while probing flags: " + s_trim(cap.out));
      }
      pending = 0;
    }
  }
  var add: string = buf_take(learned);
  if (slen(add) > 0) {
    if (slen(old) > 0 && !s_ends(old, "\n")) {
      old = old + "\n";
    }
    fs_mkdirs(tcx_root());
    fs_write(cache, old + add);
  }
  i = 0;
  while (i < u->n) {
    if (u->state[i] == 2) {
      sl_add_uniq(bad, sl_get(flags, u->first[i]));
    }
    i = i + 1;
  }
  tcx_units_free(u);
  return bad;
}

// ---------------------------------------------------------------------------
// Running built programs
// ---------------------------------------------------------------------------

export fn tc_run_program_cmd(target: string, exe_path: string) -> Cmd* {
  var host: string = sys_os();
  if (s_eq(target, host)) {
    var t: Tool = tool_none();
    t.path = exe_path;
    return cmd_new(t);
  }
  if (s_eq(host, "linux") && s_eq(target, "windows")) {
    var w: Tool = tcx_wine();
    if (!tool_found(w)) {
      return (Cmd*)0;
    }
    var c: Cmd* = cmd_new(w);
    cmd_env(c, "WINEDEBUG", "-all");
    cmd_path(c, exe_path);
    return c;
  }
  if (sys_is_wine() && s_eq(target, "linux")) {
    var u: Tool = tool_none();
    u.path = sys_host_path(tcx_win_form(exe_path));
    if (s_starts(s_lower(u.path), "z:")) {
      // wine answers nothing for a path whose directory does not exist yet.
      u.path = s_replace_byte(s_from(u.path, 2), 92, 47);
    }
    u.unix = true;
    return cmd_new(u);
  }
  return (Cmd*)0;
}

// ---------------------------------------------------------------------------
// Releases
// ---------------------------------------------------------------------------

// The GitHub API of the Mettle repository; MBUILD_METTLE_API replaces it
// (mirrors, tests).
fn tcx_api() -> string {
  var a: string = env_get("MBUILD_METTLE_API");
  if (slen(a) > 0) {
    return a;
  }
  return "https://api.github.com/repos/The-Mettle-Project/Mettle";
}

fn tcx_releases_page() -> string {
  return "https://github.com/The-Mettle-Project/Mettle/releases";
}

fn tcx_asset(v: string, target: string) -> string {
  if (s_eq(target, "windows")) {
    return "mettle-" + v + "-windows-x64.zip";
  }
  return "mettle-" + v + "-linux-x64.tar.gz";
}

fn tcx_curl() -> Tool {
  return tcx_host_tool("curl", "MBUILD_CURL");
}

fn tcx_curl_cmd(t: Tool) -> Cmd* {
  var c: Cmd* = cmd_new(t);
  cmd_arg(c, "-fsSL");
  cmd_arg(c, "--retry");
  cmd_arg(c, "2");
  return c;
}

// The first JSON string `"key": "..."` at or after from: at = -1 when there
// is none, val = "" when it is not a string (null).
struct TcxJson {
  val: string;
  at: int64;
}

fn tcx_json_str(json: string, key: string, from: int64) -> TcxJson {
  var r: TcxJson;
  r.val = s_empty();
  r.at = -1;
  var needle: string = "\"" + key + "\"";
  var at: int64 = s_find_from(json, needle, from);
  if (at < 0) {
    return r;
  }
  r.at = at;
  var i: int64 = at + slen(needle);
  while (i < slen(json) && (is_space_b(s_byte(json, i)) || s_byte(json, i) == 58)) {
    i = i + 1;
  }
  if (i >= slen(json) || s_byte(json, i) != 34) {
    return r;
  }
  var b: Buf* = buf_new();
  var j: int64 = i + 1;
  while (j < slen(json) && s_byte(json, j) != 34) {
    if (s_byte(json, j) == 92 && j + 1 < slen(json)) {
      j = j + 1;
    }
    buf_addb(b, s_byte(json, j));
    j = j + 1;
  }
  r.val = buf_take(b);
  return r;
}

// A release and this host's archive in it.
struct TcxRelease {
  tag: string;      // "" when it could not be read (g_tcx_err says why)
  url: string;
  digest: string;   // "sha256:<hex>", "" when the release lists none
  soft: bool;       // the lookup failed for want of curl or the network
}

// The release `tag` ("latest" = the newest) from the GitHub API.
fn tcx_release(tag: string) -> TcxRelease {
  var rel: TcxRelease;
  rel.tag = s_empty();
  rel.url = s_empty();
  rel.digest = s_empty();
  rel.soft = true;
  var curl: Tool = tcx_curl();
  if (!tool_found(curl)) {
    tcx_tool_missing("cannot look up Mettle releases", "curl", "MBUILD_CURL", "install curl");
    return rel;
  }
  var what: string = "releases/tags/" + tag;
  if (s_eq(tag, "latest")) {
    what = "releases/latest";
  }
  var url: string = tcx_api() + "/" + what;
  var c: Cmd* = tcx_curl_cmd(curl);
  cmd_arg(c, "-H");
  cmd_arg(c, "Accept: application/vnd.github+json");
  cmd_arg(c, url);
  var r: Captured = proc_capture(c);
  tcx_cmd_free(c);
  if (r.code == 22) {
    rel.soft = false;
    tcx_set_err("no Mettle release " + tag + " (" + url + " answered an error)", "the releases are listed at " + tcx_releases_page());
    return rel;
  }
  if (r.code != 0) {
    tcx_set_err("cannot reach " + url + " (curl exit " + s_int(r.code) + ")", "check the network, or install a source checkout with --from DIR");
    return rel;
  }
  rel.soft = false;
  var t: TcxJson = tcx_json_str(r.out, "tag_name", 0);
  if (!sv_is(t.val)) {
    tcx_set_err("unexpected answer from " + url + ": no release tag", "check MBUILD_METTLE_API");
    return rel;
  }
  var asset: string = tcx_asset(t.val, sys_os());
  var from: int64 = 0;
  while (true) {
    var n: TcxJson = tcx_json_str(r.out, "name", from);
    if (n.at < 0) {
      break;
    }
    from = n.at + 6;
    if (!s_eq(n.val, asset)) {
      continue;
    }
    var u: TcxJson = tcx_json_str(r.out, "browser_download_url", from);
    var d: TcxJson = tcx_json_str(r.out, "digest", from);
    rel.url = u.val;
    if (d.at >= 0 && d.at < u.at) {
      rel.digest = d.val;
    }
    break;
  }
  if (slen(rel.url) == 0) {
    tcx_set_err("Mettle " + t.val + " has no " + asset, "see " + tcx_releases_page());
    return rel;
  }
  rel.tag = tcx_norm(t.val);
  return rel;
}

// Runs and frees c.
fn tcx_run_ok(c: Cmd*) -> bool {
  var ok: bool = proc_run(c) == 0;
  tcx_cmd_free(c);
  return ok;
}

// tar -xzf / unzip / bsdtar / python3 zipfile: whichever this host has.
fn tcx_extract(archive: string, dir: string, target: string) -> bool {
  if (s_eq(target, "linux")) {
    var tar: Tool = tcx_host_tool("tar", "MBUILD_TAR");
    if (!tool_found(tar)) {
      tcx_tool_missing("cannot unpack " + p_base(archive), "tar", "MBUILD_TAR", "install tar");
      return false;
    }
    var c: Cmd* = cmd_new(tar);
    cmd_arg(c, "-xzf");
    cmd_path(c, archive);
    cmd_arg(c, "-C");
    cmd_path(c, dir);
    if (tcx_run_ok(c)) {
      return true;
    }
    tcx_set_err("cannot unpack " + archive, "the download may be damaged; try again");
    return false;
  }
  var tried: bool = false;
  if (s_eq(sys_os(), "windows") && !sys_is_wine()) {
    // tar.exe (bsdtar) ships with Windows 10 and later and reads zip files.
    var wtar: Tool = sys_find_tool("tar");
    if (tool_found(wtar)) {
      tried = true;
      var cw: Cmd* = cmd_new(wtar);
      cmd_arg(cw, "-xf");
      cmd_path(cw, archive);
      cmd_arg(cw, "-C");
      cmd_path(cw, dir);
      if (tcx_run_ok(cw)) {
        return true;
      }
    }
  }
  var unzip: Tool = tcx_host_tool("unzip", "MBUILD_UNZIP");
  if (tool_found(unzip)) {
    tried = true;
    var cu: Cmd* = cmd_new(unzip);
    cmd_arg(cu, "-q");
    cmd_arg(cu, "-o");
    cmd_path(cu, archive);
    cmd_arg(cu, "-d");
    cmd_path(cu, dir);
    if (tcx_run_ok(cu)) {
      return true;
    }
  }
  var bsdtar: Tool = tcx_host_tool("bsdtar", "MBUILD_BSDTAR");
  if (tool_found(bsdtar)) {
    tried = true;
    var cb: Cmd* = cmd_new(bsdtar);
    cmd_arg(cb, "-xf");
    cmd_path(cb, archive);
    cmd_arg(cb, "-C");
    cmd_path(cb, dir);
    if (tcx_run_ok(cb)) {
      return true;
    }
  }
  var py: Tool = tcx_host_tool("python3", "MBUILD_PYTHON");
  if (tool_found(py)) {
    tried = true;
    var cp: Cmd* = cmd_new(py);
    cmd_arg(cp, "-m");
    cmd_arg(cp, "zipfile");
    cmd_arg(cp, "-e");
    cmd_path(cp, archive);
    cmd_path(cp, dir);
    if (tcx_run_ok(cp)) {
      return true;
    }
  }
  if (!tried) {
    tcx_set_err("cannot unpack " + p_base(archive) + ": no unzip, bsdtar or python3 found", "install unzip");
  } else {
    tcx_set_err("cannot unpack " + archive, "the download may be damaged; try again");
  }
  return false;
}

// The directory of an unpacked archive that holds the compiler: dir itself,
// or its only subdirectory (the Linux tarball has a top-level folder).
fn tcx_find_top(dir: string) -> string {
  if (fs_is_file(tcx_exe_in(dir))) {
    return dir;
  }
  var files: StrList* = sl_new();
  var dirs: StrList* = sl_new();
  sys_list_dir(dir, files, dirs);
  var found: string = s_empty();
  if (dirs->len == 1) {
    var sub: string = dir + "/" + sl_get(dirs, 0);
    if (fs_is_file(tcx_exe_in(sub))) {
      found = sub;
    }
  }
  tcx_sl_free(files);
  tcx_sl_free(dirs);
  return found;
}

fn tcx_download_failed(url: string, http: string) {
  var why: string = "";
  if (s_eq(http, "404")) {
    why = ": not found (404)";
  } else if (slen(http) > 0 && !s_eq(http, "000")) {
    why = " (HTTP " + http + ")";
  }
  tcx_set_err("downloading " + url + " failed" + why, "check the network and the releases at " + tcx_releases_page());
}

// The version the compiler exe reports, "" when it cannot say.
fn tcx_exe_version(exe: string) -> string {
  var t: Tool = sys_find_tool(exe);
  if (!tool_found(t)) {
    return s_empty();
  }
  var c: Cmd* = cmd_new(t);
  cmd_arg(c, "--version");
  var cap: Captured = proc_capture_all(c);
  tcx_cmd_free(c);
  if (cap.code != 0) {
    return s_empty();
  }
  return tcx_parse_version(cap.out);
}

// Writes dir/toolchain.toml.
fn tcx_finish(dir: string, id: string, source: string, describe: string) {
  var file: string = dir + "/toolchain.toml";
  var t: TcxInfo;
  t.id = id;
  t.version = tcx_exe_version(tcx_exe_in(dir));
  t.source = source;
  t.describe = describe;
  t.installed = s_empty();
  fs_write(file, tcx_info_text(t));
  t.installed = tcx_date_of(file);
  fs_write(file, tcx_info_text(t));
}

// Renames the finished top (inside tmp) to toolchains/<id>, replacing an
// older one, and removes tmp.
fn tcx_move_in(tmp: string, top: string, id: string) -> bool {
  var dest: string = tcx_dir(id);
  if (fs_exists(dest)) {
    tcx_forget(dest);
    sys_remove_tree(dest);
  }
  var moved: bool = sys_rename(top, dest);
  sys_remove_tree(tmp);
  if (!moved || !tcx_installed(id)) {
    tcx_set_err("cannot move the new toolchain into " + dest, "check that " + tcx_root() + " is writable");
    return false;
  }
  return true;
}

fn tcx_tmp(id: string) -> string {
  return tcx_root() + "/.tmp-" + id + "-" + s_int(sys_now_ms());
}

// Downloads, verifies and unpacks rel into toolchains/<tag>. False with
// g_tcx_err set; nothing half-installed is left behind.
fn tcx_install_release(rel: TcxRelease) -> bool {
  var curl: Tool = tcx_curl();
  if (!tool_found(curl)) {
    tcx_tool_missing("cannot download Mettle " + rel.tag, "curl", "MBUILD_CURL", "install curl");
    return false;
  }
  var tmp: string = tcx_tmp(rel.tag);
  var unpack: string = tmp + "/x";
  if (!fs_mkdirs(unpack)) {
    tcx_set_err("cannot create " + unpack, "check that " + tcx_root() + " is writable");
    return false;
  }
  var archive: string = tmp + "/" + p_base(rel.url);
  var c: Cmd* = tcx_curl_cmd(curl);
  cmd_arg(c, "-o");
  cmd_path(c, archive);
  cmd_arg(c, "-w");
  cmd_arg(c, "%{{http_code}");
  cmd_arg(c, rel.url);
  var got: Captured = proc_capture(c);
  tcx_cmd_free(c);
  if (got.code != 0 || !fs_is_file(archive)) {
    sys_remove_tree(tmp);
    tcx_download_failed(rel.url, s_trim(got.out));
    return false;
  }
  if (s_starts(rel.digest, "sha256:")) {
    var want: string = s_lower(s_from(rel.digest, 7));
    var have: string = sha_file(archive);
    if (!s_eq(want, have)) {
      sys_remove_tree(tmp);
      tcx_set_err(p_base(archive) + " does not match the release's sha256 (got " + have + ", the release lists " + want + ")", "the download is damaged or was altered; nothing was installed");
      return false;
    }
  } else {
    note("the release lists no sha256 for " + p_base(archive) + "; it is not verified");
  }
  if (!tcx_extract(archive, unpack, sys_os())) {
    sys_remove_tree(tmp);
    return false;
  }
  var top: string = tcx_find_top(unpack);
  if (slen(top) == 0) {
    sys_remove_tree(tmp);
    tcx_set_err(p_base(archive) + " does not contain " + tcx_rel_exe(sys_os()) + " (unexpected layout)", "report this, or set METTLE to a compiler");
    return false;
  }
  sys_set_executable(tcx_exe_in(top));
  tcx_finish(top, rel.tag, "release", rel.tag);
  return tcx_move_in(tmp, top, rel.tag);
}

fn tcx_copy_tree(src: string, dst: string) -> bool {
  if (!fs_mkdirs(dst)) {
    return false;
  }
  var files: StrList* = sl_new();
  var dirs: StrList* = sl_new();
  sys_list_dir(src, files, dirs);
  var ok: bool = true;
  var i: int64 = 0;
  while (ok && i < files->len) {
    ok = fs_copy(src + "/" + sl_get(files, i), dst + "/" + sl_get(files, i));
    i = i + 1;
  }
  i = 0;
  while (ok && i < dirs->len) {
    ok = tcx_copy_tree(src + "/" + sl_get(dirs, i), dst + "/" + sl_get(dirs, i));
    i = i + 1;
  }
  tcx_sl_free(files);
  tcx_sl_free(dirs);
  return ok;
}

// git describe --tags of a checkout, "" when git cannot say.
fn tcx_describe(dir: string) -> string {
  var git: Tool = tcx_host_tool("git", "MBUILD_GIT");
  if (!tool_found(git)) {
    return s_empty();
  }
  var c: Cmd* = cmd_new(git);
  cmd_arg(c, "-C");
  cmd_path(c, dir);
  cmd_arg(c, "describe");
  cmd_arg(c, "--tags");
  cmd_arg(c, "--always");
  var r: Captured = proc_capture(c);
  tcx_cmd_free(c);
  if (r.code != 0) {
    return s_empty();
  }
  return s_trim(r.out);
}

fn tcx_abs(dir: string) -> string {
  var d: string = s_replace_byte(dir, 92, 47);
  if (!p_is_abs(d)) {
    d = p_join(s_replace_byte(sys_cwd(), 92, 47), d);
  }
  return p_clean(d);
}

fn tcx_is_checkout(dir: string) -> bool {
  return fs_is_file(dir + "/Makefile") && fs_is_dir(dir + "/src") && fs_is_dir(dir + "/stdlib/std");
}

// Builds the Mettle checkout at given with make and installs its compiler
// as dev-<git describe>: the id, or "" with g_tcx_err set.
fn tcx_install_source(given: string) -> string {
  var dir: string = tcx_abs(given);
  if (!tcx_is_checkout(dir)) {
    tcx_set_err(dir + " is not a Mettle source checkout (it needs a Makefile, src/ and stdlib/std/)", "pass the directory of a clone of https://github.com/The-Mettle-Project/Mettle");
    return s_empty();
  }
  var desc: string = tcx_describe(dir);
  if (slen(desc) == 0) {
    tcx_set_err("cannot name the build: `git describe --tags` fails in " + dir, "install --from takes a git clone of Mettle");
    return s_empty();
  }
  var make: Tool = tcx_host_tool("make", "MBUILD_MAKE");
  if (!tool_found(make)) {
    tcx_tool_missing("building Mettle from source needs make", "make", "MBUILD_MAKE", "install make");
    return s_empty();
  }
  var jobs: string = s_int(proc_jobs());
  status("Building", "Mettle " + desc + " in " + dir + " (make -j " + jobs + ")");
  var c: Cmd* = cmd_new(make);
  cmd_arg(c, "-j");
  cmd_arg(c, jobs);
  c->cwd = dir;
  var r: Captured = proc_capture_all(c);
  tcx_cmd_free(c);
  if (r.code != 0) {
    flush_out();
    print_err(r.out);
    tcx_set_err("make failed in " + dir, "fix the build there and run this again");
    return s_empty();
  }
  var exe: string = tcx_exe_in(dir);
  if (!fs_is_file(exe)) {
    tcx_set_err("make in " + dir + " built no " + tcx_rel_exe(sys_os()), "is it a Mettle checkout?");
    return s_empty();
  }
  var id: string = "dev-" + desc;
  var tmp: string = tcx_tmp(id);
  var top: string = tmp + "/t";
  var dst: string = tcx_exe_in(top);
  var ok: bool = fs_mkdirs(p_dir(dst)) && fs_copy(exe, dst);
  var sd: string = tcx_sibling(exe, "stdlib");
  if (ok && slen(sd) > 0) {
    ok = tcx_copy_tree(sd, top + "/stdlib");
  }
  var rd: string = tcx_sibling(exe, "runtime");
  if (ok && slen(rd) > 0) {
    ok = tcx_copy_tree(rd, top + "/runtime");
  }
  if (!ok) {
    sys_remove_tree(tmp);
    tcx_set_err("cannot copy the compiler into " + top, "check that " + tcx_root() + " is writable");
    return s_empty();
  }
  sys_set_executable(dst);
  tcx_finish(top, id, dir, desc);
  if (!tcx_move_in(tmp, top, id)) {
    return s_empty();
  }
  return id;
}

// ---------------------------------------------------------------------------
// mbuild toolchain
// ---------------------------------------------------------------------------

fn tcx_err_last() {
  error_msg(g_tcx_err);
  if (slen(g_tcx_hint) > 0) {
    err_line("  " + cyan("help") + ": " + g_tcx_hint);
  }
}

fn tcx_help(hint: string) {
  err_line("  " + cyan("help") + ": " + hint);
}

fn tcx_offline(p: Project*) -> bool {
  return p->opts != (Options*)0 && p->opts->offline;
}

// The value of "--name=VALUE" (or "--name VALUE") among the command's
// arguments, "" when absent.
fn tcx_opt(p: Project*, name: string) -> string {
  var rest: StrList* = p->opts->rest;
  var eq: string = name + "=";
  var i: int64 = 0;
  while (i < rest->len) {
    var a: string = sl_get(rest, i);
    if (s_starts(a, eq)) {
      return s_from(a, slen(eq));
    }
    if (s_eq(a, name) && i + 1 < rest->len) {
      return sl_get(rest, i + 1);
    }
    i = i + 1;
  }
  return s_empty();
}

fn tcx_flag(p: Project*, name: string) -> bool {
  return sl_has(p->opts->rest, name);
}

// The arguments that are not flags (nor the value of "--from DIR").
fn tcx_positional(p: Project*) -> StrList* {
  var rest: StrList* = p->opts->rest;
  var l: StrList* = sl_new();
  var i: int64 = 0;
  while (i < rest->len) {
    var a: string = sl_get(rest, i);
    if (s_eq(a, "--from") || s_eq(a, "--home")) {
      i = i + 1;
    } else if (!s_starts(a, "-")) {
      sl_push(l, a);
    }
    i = i + 1;
  }
  return l;
}

// Installs "latest", a release, or (from != "") a source checkout; the id,
// or "" after printing the error. soft (may be 0) is set when only the
// network or curl was missing.
fn tcx_install(p: Project*, given: string, from: string, soft: bool*) -> string {
  if (slen(from) > 0) {
    var id: string = tcx_install_source(from);
    if (slen(id) == 0) {
      tcx_err_last();
      return s_empty();
    }
    status("Installed", "Mettle " + id + " in " + tcx_dir(id));
    return id;
  }
  var v: string = tcx_norm(given);
  if (!s_eq(v, "latest") && !sv_is(v)) {
    error_msg("'" + given + "' is not a Mettle release (expected vX.Y.Z or latest)");
    tcx_help("a source checkout installs with `mbuild toolchain install --from DIR`");
    return s_empty();
  }
  if (tcx_installed(v)) {
    status("Installed", "Mettle " + v + " is already in " + tcx_dir(v));
    return v;
  }
  if (tcx_offline(p)) {
    tcx_set_err("--offline: not downloading Mettle " + v, "run `mbuild toolchain install " + v + "` without --offline");
    if (soft != (bool*)0) {
      *soft = true;
      return s_empty();
    }
    tcx_err_last();
    return s_empty();
  }
  var rel: TcxRelease = tcx_release(v);
  if (slen(rel.tag) == 0) {
    if (soft != (bool*)0 && rel.soft) {
      *soft = true;
      return s_empty();
    }
    tcx_err_last();
    return s_empty();
  }
  if (tcx_installed(rel.tag)) {
    status("Installed", "Mettle " + rel.tag + " is already in " + tcx_dir(rel.tag));
    return rel.tag;
  }
  status("Downloading", "Mettle " + rel.tag + " (" + p_base(rel.url) + ")");
  if (!tcx_install_release(rel)) {
    tcx_err_last();
    return s_empty();
  }
  status("Installed", "Mettle " + rel.tag + " in " + tcx_dir(rel.tag));
  if (sv_cmp(rel.tag, "v0.17.0") <= 0) {
    warn("releases up to v0.17.0 cannot build current projects; install a source build with `mbuild toolchain install --from DIR`");
  }
  return rel.tag;
}

fn tcx_source_text(t: TcxInfo) -> string {
  if (s_eq(t.source, "release")) {
    return "release";
  }
  return "from " + t.source;
}

fn tcx_cmd_list(p: Project*) -> int32 {
  var ids: StrList* = tcx_ids();
  defer tcx_sl_free(ids);
  var def: string = tcx_default();
  var pin: string = tcx_pin(p);
  var pin_id: string = s_empty();
  if (slen(pin) > 0) {
    pin_id = tcx_find(pin);
  }
  var hm: Mettle* = tcx_pick(p, sys_os());
  var sel: string = s_empty();
  if (hm != (Mettle*)0) {
    sel = hm->installed;
  }
  say(bold("Installed toolchains") + " (" + tcx_root() + "):");
  if (ids->len == 0) {
    say("  (none)");
  }
  var w: int64 = 0;
  var i: int64 = 0;
  while (i < ids->len) {
    if (slen(sl_get(ids, i)) > w) {
      w = slen(sl_get(ids, i));
    }
    i = i + 1;
  }
  i = 0;
  while (i < ids->len) {
    var t: TcxInfo = tcx_info(sl_get(ids, i));
    var mark: string = "  ";
    if (s_eq(t.id, sel)) {
      mark = "* ";
    }
    var tags: StrList* = sl_new();
    if (s_eq(t.id, def)) {
      sl_push(tags, "default");
    }
    if (s_eq(t.id, pin_id)) {
      sl_push(tags, "pinned");
    }
    var line: string = "  " + mark + s_pad_right(t.id, w) + "  mettle " + s_pad_right(t.version, 8) + "  " + tcx_source_text(t) + ", " + t.installed;
    if (tags->len > 0) {
      line = line + "  [" + sl_join(tags, ", ") + "]";
    }
    say(line);
    tcx_sl_free(tags);
    i = i + 1;
  }
  say("");
  say(bold("Selected compilers") + ":");
  var targets: StrList* = sl_of("linux");
  defer tcx_sl_free(targets);
  sl_push(targets, "windows");
  i = 0;
  while (i < targets->len) {
    var tg: string = sl_get(targets, i);
    var m: Mettle* = hm;
    if (!s_eq(tg, sys_os())) {
      m = tcx_pick(p, tg);
    }
    if (m != (Mettle*)0) {
      var how: string = s_empty();
      if (slen(m->installed) > 0) {
        how = ": " + m->installed;
      }
      if (m->via_wine) {
        how = how + ", through wine";
      } else if (m->tool.unix) {
        how = how + ", as a host program";
      }
      say("  " + s_pad_right(tg, 8) + " " + m->path + "  (" + m->source + how + ")");
    } else {
      say("  " + s_pad_right(tg, 8) + " none: " + g_tcx_err);
      if (slen(g_tcx_hint) > 0) {
        say("  " + s_pad_right("", 8) + " " + dim(g_tcx_hint));
      }
    }
    i = i + 1;
  }
  return 0;
}

fn tcx_not_installed(given: string) -> int32 {
  error_msg("Mettle " + given + " is not installed");
  var v: string = tcx_norm(given);
  if (sv_is(v)) {
    tcx_help("mbuild toolchain install " + v);
  } else {
    tcx_help("see `mbuild toolchain list`; a source build installs with `mbuild toolchain install --from DIR`");
  }
  return 1;
}

// Pins the project to an installed toolchain (mb_toolchain in fn
// project()); --local writes its compiler as mb_tool("mettle-<host>", PATH)
// into mbuild.local.mettle instead.
fn tcx_cmd_use(p: Project*, given: string, local: bool) -> int32 {
  var id: string = tcx_find(given);
  if (slen(id) == 0) {
    return tcx_not_installed(given);
  }
  var host: string = sys_os();
  var file: string = tcx_mbfile(p);
  var label: string = "mbuild.mettle";
  var call: string = "mb_toolchain";
  var key: string = s_empty();
  var args: StrList* = sl_of(id);
  defer tcx_sl_free(args);
  if (local) {
    file = p->root + "/mbuild.local.mettle";
    label = "mbuild.local.mettle";
    call = "mb_tool";
    key = "mettle-" + host;
    sl_set(args, 0, key);
    sl_push(args, tcx_exe_in(tcx_dir(id)));
  }
  var r: FsRead = fs_read(file);
  if (!r.ok && !local) {
    error_msg("no mbuild.mettle in " + p->root);
    tcx_help("`mbuild toolchain default " + id + "` sets this machine's default instead");
    return 1;
  }
  var text: string = s_empty();
  if (r.ok) {
    text = r.data;
  }
  var e: MbfEdit = mbf_set_call(text, call, key, args);
  if (!e.ok) {
    var want: string = call + "(\"" + sl_join(args, "\", \"") + "\");";
    error_msg(label + ":" + s_int(e.line) + " sets the compiler in a way mbuild cannot edit (" + e.why + ")");
    tcx_help("change it to: " + want);
    return 1;
  }
  if (!s_eq(e.text, text)) {
    if (!fs_write(file, e.text)) {
      error_msg("cannot write " + file);
      return 1;
    }
    status("Updating", label + ": " + mbf_call_at(e.text, e.line));
  }
  return 0;
}

fn tcx_cmd_default(given: string) -> int32 {
  var id: string = tcx_find(given);
  if (slen(id) == 0) {
    return tcx_not_installed(given);
  }
  if (!tcx_set_default(id)) {
    error_msg("cannot write " + tcx_config_file());
    return 1;
  }
  status("Default", "Mettle " + id);
  return 0;
}

// Drops versions.cache lines of compilers under dir.
fn tcx_forget(dir: string) {
  var cache: string = tcx_root() + "/versions.cache";
  var r: FsRead = fs_read(cache);
  if (!r.ok) {
    return;
  }
  var keep: Buf* = buf_new();
  var lines: StrList* = s_lines(r.data);
  var prefix: string = dir + "/";
  var i: int64 = 0;
  while (i < lines->len) {
    var line: string = sl_get(lines, i);
    if (!s_starts(line, prefix)) {
      buf_line(keep, line);
    }
    i = i + 1;
  }
  tcx_sl_free(lines);
  fs_write(cache, buf_take(keep));
}

fn tcx_cmd_remove(given: string) -> int32 {
  var id: string = tcx_find(given);
  if (slen(id) == 0) {
    return tcx_not_installed(given);
  }
  var dir: string = tcx_dir(id);
  tcx_forget(dir);
  if (!sys_remove_tree(dir)) {
    error_msg("cannot remove " + dir);
    return 1;
  }
  status("Removed", "Mettle " + id);
  if (s_eq(tcx_default(), id)) {
    tcx_set_default(s_empty());
    note(id + " was the default toolchain; there is no default now");
  }
  return 0;
}

// Rebuilds source toolchains whose checkout moved on and tells of a newer
// release than the newest installed one.
fn tcx_cmd_update(p: Project*) -> int32 {
  var ids: StrList* = tcx_ids();
  defer tcx_sl_free(ids);
  var rc: int32 = 0;
  var newest: string = s_empty();
  var def: string = tcx_default();
  if (ids->len == 0) {
    say("no toolchains installed (" + tcx_root() + ")");
    return 0;
  }
  var i: int64 = 0;
  while (i < ids->len) {
    var t: TcxInfo = tcx_info(sl_get(ids, i));
    i = i + 1;
    if (s_eq(t.source, "release") || slen(t.source) == 0) {
      if (sv_is(t.id) && (slen(newest) == 0 || sv_cmp(t.id, newest) > 0)) {
        newest = t.id;
      }
      continue;
    }
    if (!tcx_is_checkout(t.source)) {
      note(t.id + ": its checkout " + t.source + " is gone; not updated");
      continue;
    }
    var desc: string = tcx_describe(t.source);
    if (s_eq(desc, t.describe)) {
      status("Fresh", t.id + " (" + t.source + ")");
      continue;
    }
    var cur: string = "dev-" + desc;
    if (tcx_installed(cur)) {
      status("Fresh", t.id + ": its checkout's build " + cur + " is installed");
      continue;
    }
    var nid: string = tcx_install_source(t.source);
    if (slen(nid) == 0) {
      tcx_err_last();
      rc = 1;
      continue;
    }
    status("Installed", "Mettle " + nid + " in " + tcx_dir(nid));
    if (s_eq(def, t.id)) {
      tcx_set_default(nid);
      def = nid;
      status("Default", "Mettle " + nid);
    }
  }
  if (slen(newest) > 0) {
    if (tcx_offline(p)) {
      note("--offline: not looking for a newer Mettle release");
      return rc;
    }
    var rel: TcxRelease = tcx_release("latest");
    if (slen(rel.tag) == 0) {
      tcx_err_last();
      return 1;
    }
    if (sv_cmp(rel.tag, newest) > 0) {
      status("Available", "Mettle " + rel.tag + " (newest installed: " + newest + "): mbuild toolchain install " + rel.tag);
    } else {
      status("Fresh", newest + " is the latest release");
    }
  }
  return rc;
}

fn tcx_usage() {
  err_line("usage: mbuild toolchain [list]");
  err_line("       mbuild toolchain install VERSION|latest");
  err_line("       mbuild toolchain install --from DIR");
  err_line("       mbuild toolchain use ID|VERSION [--local]");
  err_line("       mbuild toolchain default ID|VERSION");
  err_line("       mbuild toolchain remove ID|VERSION");
  err_line("       mbuild toolchain update");
}

fn tcx_bad_args(sub: string, what: string) -> int32 {
  error_msg("mbuild toolchain " + sub + " takes " + what);
  tcx_usage();
  return 2;
}

export fn tc_cmd_toolchain(p: Project*) -> int32 {
  var pos: StrList* = tcx_positional(p);
  defer tcx_sl_free(pos);
  var sub: string = "list";
  if (pos->len > 0) {
    sub = sl_get(pos, 0);
  }
  if (s_eq(sub, "list") || s_eq(sub, "ls")) {
    return tcx_cmd_list(p);
  }
  if (s_eq(sub, "install")) {
    var from: string = tcx_opt(p, "--from");
    if (slen(from) > 0 && pos->len != 1) {
      return tcx_bad_args(sub, "a VERSION or --from DIR, not both");
    }
    if (slen(from) == 0 && pos->len != 2) {
      return tcx_bad_args(sub, "one VERSION (or --from DIR)");
    }
    var v: string = s_empty();
    if (pos->len == 2) {
      v = sl_get(pos, 1);
    }
    if (slen(tcx_install(p, v, from, (bool*)0)) == 0) {
      return 1;
    }
    return 0;
  }
  if (s_eq(sub, "update")) {
    if (pos->len != 1) {
      return tcx_bad_args(sub, "no arguments");
    }
    return tcx_cmd_update(p);
  }
  if (s_eq(sub, "use") || s_eq(sub, "default") || s_eq(sub, "remove") || s_eq(sub, "rm")) {
    if (pos->len != 2) {
      return tcx_bad_args(sub, "one ID or VERSION");
    }
    var v2: string = sl_get(pos, 1);
    if (s_eq(sub, "use")) {
      return tcx_cmd_use(p, v2, tcx_flag(p, "--local"));
    }
    if (s_eq(sub, "default")) {
      return tcx_cmd_default(v2);
    }
    return tcx_cmd_remove(v2);
  }
  error_msg("unknown toolchain command '" + sub + "'");
  tcx_usage();
  return 2;
}

// ---------------------------------------------------------------------------
// Self-setup
// ---------------------------------------------------------------------------

fn tcx_show_home(h: string) -> string {
  var home: string = s_replace_byte(sys_home(), 92, 47);
  var hp: string = home + "/";
  if (slen(home) > 1 && s_starts(h, hp)) {
    return "~" + s_from(h, slen(home));
  }
  return h;
}

fn tcx_layout(home: string) -> bool {
  return fs_mkdirs(home + "/toolchains") && fs_mkdirs(home + "/tmp");
}

// On the first run (no $MBUILD_HOME yet) creates it and says so once.
export fn tc_first_run() {
  var home: string = tcx_home();
  if (fs_is_dir(home)) {
    return;
  }
  if (tcx_layout(home) && !g_quiet) {
    err_line(green(s_pad_left("Created", 12)) + " " + tcx_show_home(home));
  }
}

fn tcx_setup_tool(label: string, name: string, env_override: string, why: string) -> bool {
  var t: Tool = tcx_host_tool(name, env_override);
  if (tool_found(t)) {
    say("  " + s_pad_right(label, 10) + green("found") + "    " + t.path);
    return true;
  }
  say("  " + s_pad_right(label, 10) + yellow("missing") + "  " + why);
  return false;
}

// The Mettle checkout a compiler was built in (<checkout>/bin/mettle), "".
fn tcx_checkout_of(exe: string) -> string {
  var real: string = sys_realpath(exe);
  if (slen(real) == 0) {
    return s_empty();
  }
  var dir: string = p_dir(p_dir(real));
  if (tcx_is_checkout(dir)) {
    return dir;
  }
  return s_empty();
}

fn tcx_on_path(dir: string) -> bool {
  var parts: StrList* = s_split(env_get("PATH"), sys_list_sep());
  var found: bool = false;
  var i: int64 = 0;
  while (i < parts->len && !found) {
    var d: string = sl_get(parts, i);
    if (slen(d) > 0) {
      found = s_eq(p_clean(s_replace_byte(d, 92, 47)), dir);
    }
    i = i + 1;
  }
  tcx_sl_free(parts);
  return found;
}

// mbuild setup [--home DIR] [--from DIR | --no-compiler] [--yes]
export fn tc_cmd_setup(p: Project*) -> int32 {
  var rc: int32 = 0;
  var given: string = tcx_opt(p, "--home");
  var why: string = s_empty();
  if (slen(given) > 0) {
    var h: string = tcx_abs(given);
    var hf: string = fs_home_file();
    if (!fs_write(hf, h + "\n")) {
      error_msg("cannot write " + hf);
      tcx_help("install mbuild in a directory you can write to, or set MBUILD_HOME");
      return 1;
    }
    sys_setenv("MBUILD_HOME", h);
    why = "--home, saved in " + hf;
  } else {
    why = fs_home_origin();
    if (!s_eq(why, "the default") && !s_eq(why, "MBUILD_HOME")) {
      why = "from " + why;
    }
  }
  var home: string = tcx_home();
  var fresh: bool = !fs_is_dir(home);
  if (!tcx_layout(home)) {
    error_msg("cannot create " + home);
    return 1;
  }
  var made: string = s_empty();
  if (fresh) {
    made = ", created";
  }
  say(bold("home") + "  " + tcx_show_home(home) + " (" + why + made + ")");

  say(bold("compilers"));
  var checkout: string = s_empty();
  var me: string = env_get("METTLE");
  if (slen(me) > 0) {
    say("  $METTLE      " + me);
    checkout = tcx_checkout_of(tcx_resolve(me));
  }
  var on_path: Tool = sys_find_tool("mettle");
  if (tool_found(on_path)) {
    say("  on PATH      " + on_path.path);
    if (slen(checkout) == 0) {
      checkout = tcx_checkout_of(on_path.path);
    }
  }
  var ids: StrList* = tcx_ids();
  if (ids->len > 0) {
    say("  installed    " + sl_join(ids, ", "));
  }
  tcx_sl_free(ids);
  if (slen(checkout) > 0) {
    say("  checkout     " + checkout);
  }
  if (!tcx_flag(p, "--no-compiler")) {
    var from: string = tcx_opt(p, "--from");
    if (slen(from) == 0 && tcx_flag(p, "--yes")) {
      from = checkout;
    }
    var soft: bool = false;
    var id: string = tcx_install(p, "latest", from, &soft);
    if (slen(id) == 0) {
      if (soft) {
        note(g_tcx_err + "; no compiler installed: run `mbuild toolchain install latest` when online");
      } else {
        rc = 1;
      }
    } else {
      var def: string = tcx_default();
      if (slen(def) == 0 || !tcx_installed(def) || (tcx_flag(p, "--yes") && slen(from) > 0)) {
        tcx_set_default(id);
        status("Default", "Mettle " + id);
      } else if (!s_eq(def, id)) {
        note("the default toolchain stays " + def + " (`mbuild toolchain default " + id + "` switches)");
      }
    }
  }

  say(bold("tools"));
  tcx_setup_tool("curl", "curl", "MBUILD_CURL", "needed to download packages and compilers");
  tcx_setup_tool("tar", "tar", "MBUILD_TAR", "needed to unpack packages and compilers");
  tcx_setup_tool("gcc", "gcc", "CC", "needed for packages with C code");
  tcx_setup_tool("make", "make", "MBUILD_MAKE", "needed for toolchain install --from");
  tcx_setup_tool("git", "git", "MBUILD_GIT", "needed for toolchain install --from");
  if (s_eq(sys_os(), "linux")) {
    tcx_setup_tool("wine", "wine", "MBUILD_WINE", "optional: builds for windows");
  }

  var bin: string = p_dir(s_replace_byte(sys_self_exe(), 92, 47));
  if (tcx_on_path(bin)) {
    say(bold("PATH") + "  " + bin + " is on PATH");
  } else if (s_eq(sys_os(), "windows")) {
    say(bold("PATH") + "  " + bin + " is not on PATH: add it to your user PATH (Settings > System > About > Advanced system settings > Environment Variables)");
  } else {
    say(bold("PATH") + "  " + bin + " is not on PATH; add this line to ~/.bashrc (or your shell's rc file):");
    say("  export PATH=\"" + bin + ":$PATH\"");
  }
  return rc;
}
