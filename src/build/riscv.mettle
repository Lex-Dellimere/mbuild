// riscv: running RISC-V programs under qemu and rvsim

import "std/mem";
import "../core/base";
import "../core/path";
import "../core/fs";
import "../core/proc";
import "../model/manifest";
import "../model/project";
import "toolchain";
import "services";
import "../core/sys_linux" if linux;
import "../core/sys_windows" if windows;

// a board a package declares (mb_board), as the build sees it
export struct Board {
  name: string;
  pkg: string;
  file: string;       // absolute
  target: string;
  runner: string;
  outputs: string;
  flash: string;
}

var g_rv_boards: Board* = (Board*)0;
var g_rv_nboards: int64 = 0;
var g_rv_loaded: bool = false;

fn rvx_boards_add(m: Manifest*, dir: string, pkg: string) {
  if (m == (Manifest*)0) {
    return;
  }
  var i: int64 = 0;
  while (i < m->nboards) {
    var bs: BoardSpec* = &m->boards[i];
    i = i + 1;
    var old: Board* = rv_board(bs->name);
    if (old != (Board*)0) {
      if (s_eq(old->pkg, pkg)) {
        continue;
      }
      fail_hint("board " + bs->name + " is declared by two packages: " + old->pkg + " and " + pkg, "drop one of the mb_board(\"" + bs->name + "\", ...) calls, or rename one of the boards");
    }
    g_rv_boards = (Board*)realloc(g_rv_boards, (g_rv_nboards + 1) * sizeof(Board));
    var b: Board* = &g_rv_boards[g_rv_nboards];
    g_rv_nboards = g_rv_nboards + 1;
    b->name = bs->name;
    b->pkg = pkg;
    b->file = p_clean(p_join(dir, bs->file));
    b->target = bs->target;
    b->runner = bs->runner;
    b->outputs = bs->outputs;
    b->flash = bs->flash;
  }
}

// the boards of the project, then of every dependency; two packages
// declaring one name stop the command
export fn rv_boards_load(p: Project*, ds: DepState*) {
  if (g_rv_loaded) {
    return;
  }
  g_rv_loaded = true;
  rvx_boards_add(p->man, p->root, p->man->name);
  if (ds == (DepState*)0) {
    return;
  }
  var i: int64 = 0;
  while (i < ds->n) {
    rvx_boards_add(ds->mods[i].man, ds->mods[i].dir, ds->mods[i].module);
    i = i + 1;
  }
}

export fn rv_boards_loaded() -> bool {
  return g_rv_loaded;
}

export fn rv_board_count() -> int64 {
  return g_rv_nboards;
}

export fn rv_board_at(i: int64) -> Board* {
  return &g_rv_boards[i];
}

// the declared board of that name, 0 when no package declares it
export fn rv_board(name: string) -> Board* {
  var i: int64 = 0;
  while (i < g_rv_nboards) {
    if (s_eq(g_rv_boards[i].name, name)) {
      return &g_rv_boards[i];
    }
    i = i + 1;
  }
  return (Board*)0;
}

// a declared board fills in st: its file for --board, its runner, and its
// outputs when the project sets none
export fn rv_board_apply(st: Settings*) {
  if (slen(st->board) == 0) {
    return;
  }
  var b: Board* = rv_board(st->board);
  if (b == (Board*)0) {
    return;
  }
  st->board_file = b->file;
  st->board_runner = b->runner;
  if (slen(st->outputs) == 0) {
    st->outputs = b->outputs;
  }
}

// the mflash a runner named mflash starts, set by the build when it found one
var g_rv_mflash: string = "";

export fn rv_set_mflash(path: string) {
  g_rv_mflash = path;
}

// the program of a declared runner's first word: a path from the project,
// else rvsim as mbuild finds it, else PATH
fn rvx_runner_tool(p: Project*, m: Mettle*, w0: string) -> Tool {
  if (s_eq(w0, "rvsim")) {
    return rvx_rvsim(m);
  }
  if (s_eq(w0, "mflash") && slen(g_rv_mflash) > 0) {
    var mt: Tool = tool_none();
    mt.path = g_rv_mflash;
    return mt;
  }
  if (s_find_byte(w0, 47) >= 0) {
    var t: Tool = tool_none();
    t.path = p_join(p->root, w0);
    return t;
  }
  return sys_find_tool(w0);
}

// why a declared runner can't run here, "" when it can
fn rvx_runner_missing(st: Settings*) -> string {
  if (s_eq(st->board_runner, "none")) {
    return "board " + st->board + " has no runner (mb_board_set(\"" + st->board + "\", \"runner\", \"none\"))";
  }
  var w: SvcWords = svc_split(st->board_runner);
  if (!w.ok || w.words->len == 0) {
    return "board " + st->board + ": its runner `" + st->board_runner + "` does not split into words";
  }
  var w0: string = sl_get(w.words, 0);
  if (s_eq(w0, "rvsim") || (s_eq(w0, "mflash") && slen(g_rv_mflash) > 0)) {
    return s_empty();
  }
  if (s_find_byte(w0, 47) >= 0 || tool_found(sys_find_tool(w0))) {
    return s_empty();
  }
  return "no " + w0 + " (board " + st->board + "'s runner)";
}

// qemu-riscv64 / qemu-riscv32: MBUILD_QEMU_USER_DIR, ~/.local/opt/qemu-user/bin, PATH
fn rvx_qemu_user(target: string) -> Tool {
  var name: string = "qemu-riscv64";
  if (s_starts(target, "riscv32")) {
    name = "qemu-riscv32";
  }
  var dir: string = env_get("MBUILD_QEMU_USER_DIR");
  if (slen(dir) > 0) {
    var at: string = p_join(dir, name);
    if (!fs_is_file(at)) {
      fail_hint("MBUILD_QEMU_USER_DIR=" + dir + " has no " + name + " (needed to run a " + target + " program)", "point MBUILD_QEMU_USER_DIR at the directory that holds " + name + ", or unset it");
    }
    return sys_find_tool(at);
  }
  var local: string = sys_home() + "/.local/opt/qemu-user/bin/" + name;
  if (fs_is_file(local)) {
    return sys_find_tool(local);
  }
  var t: Tool = sys_find_tool(name);
  if (!tool_found(t)) {
    fail_hint("running a " + target + " program needs " + name + " (QEMU's user mode), and it is not on PATH", "install QEMU's user mode (Debian: apt install qemu-user), put it in ~/.local/opt/qemu-user/bin, or set MBUILD_QEMU_USER_DIR to its directory");
  }
  return t;
}

// why target's programs can't run here, "" when they can: the emulator is
// missing, or the board has none (rv_image_cmd would fail)
export fn rv_runner_missing(m: Mettle*, target: string, st: Settings*) -> string {
  if (!target_is_bare(target)) {
    var name: string = "qemu-riscv64";
    if (s_starts(target, "riscv32")) {
      name = "qemu-riscv32";
    }
    var dir: string = env_get("MBUILD_QEMU_USER_DIR");
    if (slen(dir) > 0) {
      if (fs_is_file(p_join(dir, name))) {
        return s_empty();
      }
      return "MBUILD_QEMU_USER_DIR=" + dir + " has no " + name;
    }
    if (fs_is_file(sys_home() + "/.local/opt/qemu-user/bin/" + name) || tool_found(sys_find_tool(name))) {
      return s_empty();
    }
    return "no " + name + " (QEMU's user mode)";
  }
  if (slen(st->board_runner) > 0) {
    var why: string = rvx_runner_missing(st);
    if (slen(why) > 0 || !man_board_rvsim(st)) {
      return why;
    }
  }
  if (s_eq(st->board, "qemu-virt") && slen(st->board_runner) == 0) {
    var q: string = "qemu-system-riscv64";
    if (s_starts(target, "riscv32")) {
      q = "qemu-system-riscv32";
    }
    if (tool_found(sys_find_tool(q))) {
      return s_empty();
    }
    return "no " + q;
  }
  if (man_board_rvsim(st)) {
    var given: string = env_get("MBUILD_RVSIM");
    if (slen(given) > 0) {
      if (fs_is_file(given)) {
        return s_empty();
      }
      return "MBUILD_RVSIM=" + given + " does not exist";
    }
    if (tool_found(sys_find_tool("rvsim")) || fs_is_file(fs_mbuild_home() + "/tools/rvsim" + sys_exe_ext())) {
      return s_empty();
    }
    var tree: string = rvx_tree(env_get("METTLE"));
    if (slen(tree) == 0) {
      tree = rvx_tree(m->path);
    }
    if (slen(tree) == 0) {
      return "no rvsim, and no Mettle checkout to build it from";
    }
    if (!tool_found(sys_find_tool("gcc"))) {
      return "no rvsim, and no gcc to build it";
    }
    return s_empty();
  }
  return "board " + st->board + " has no emulator mbuild can run";
}

// the command that runs a riscv*-linux executable
export fn rv_program_cmd(target: string, exe: string) -> Cmd* {
  var c: Cmd* = cmd_new(rvx_qemu_user(target));
  cmd_path(c, exe);
  return c;
}

// the command that runs a board image: base is the image's path without
// its extension, outs the files the build wrote (bin, elf, ...)
export fn rv_image_cmd(p: Project*, m: Mettle*, target: string, base: string, outs: StrList*, st: Settings*) -> Cmd* {
  var board: string = st->board;
  if (slen(st->board_runner) > 0) {
    return rvx_declared_cmd(p, m, base, outs, st);
  }
  if (s_eq(board, "qemu-virt")) {
    var image: string = base + ".bin";
    if (!sl_has(outs, "bin")) {
      image = base + ".elf";
      if (!sl_has(outs, "elf")) {
        fail_hint("running a qemu-virt image needs its .bin or .elf, and outputs = \"" + st->outputs + "\" has neither", "add \"bin\" to outputs");
      }
    }
    var name: string = "qemu-system-riscv64";
    if (s_starts(target, "riscv32")) {
      name = "qemu-system-riscv32";
    }
    var q: Tool = sys_find_tool(name);
    if (!tool_found(q)) {
      fail_hint("running a qemu-virt image needs " + name + ", and it is not on PATH", "install QEMU's system emulators (Debian: apt install qemu-system-misc)");
    }
    var c: Cmd* = cmd_new(q);
    cmd_arg(c, "-M");
    cmd_arg(c, "virt");
    cmd_arg(c, "-bios");
    cmd_arg(c, "none");
    cmd_arg(c, "-nographic");
    cmd_arg(c, "-kernel");
    cmd_path(c, image);
    return c;
  }
  if (s_eq(board, "pico2")) {
    if (!sl_has(outs, "bin")) {
      fail_hint("rvsim loads the raw image, and outputs = \"" + st->outputs + "\" has no bin", "add \"bin\" to outputs");
    }
    var r: Cmd* = cmd_new(rvx_rvsim(m));
    cmd_arg(r, "--machine");
    cmd_arg(r, "rp2350");
    rvx_rvsim_args(p, r, base, st);
    return r;
  }
  fail_hint("board " + board + " has no emulator mbuild can run", "write a project command that flashes or emulates it: fn cmd_upload in mbuild.mettle (docs/project.md)");
  return (Cmd*)0;
}

// a declared runner's command: its words, then for rvsim --load and the
// rvsim settings, else the image's path
fn rvx_declared_cmd(p: Project*, m: Mettle*, base: string, outs: StrList*, st: Settings*) -> Cmd* {
  var why: string = rvx_runner_missing(st);
  if (slen(why) > 0) {
    fail_hint(why, "install it, or change the board's runner (mb_board_set(\"" + st->board + "\", \"runner\", ...))");
  }
  var w: SvcWords = svc_split(st->board_runner);
  var c: Cmd* = cmd_new(rvx_runner_tool(p, m, sl_get(w.words, 0)));
  var i: int64 = 1;
  while (i < w.words->len) {
    cmd_arg(c, sl_get(w.words, i));
    i = i + 1;
  }
  if (man_board_rvsim(st)) {
    if (!sl_has(outs, "bin")) {
      fail_hint("rvsim loads the raw image, and outputs = \"" + st->outputs + "\" has no bin", "add \"bin\" to outputs");
    }
    rvx_rvsim_args(p, c, base, st);
    return c;
  }
  if (sl_has(outs, "bin")) {
    cmd_path(c, base + ".bin");
  } else if (sl_has(outs, "elf")) {
    cmd_path(c, base + ".elf");
  } else {
    fail_hint("board " + st->board + "'s runner takes the .bin or .elf, and outputs = \"" + st->outputs + "\" has neither", "add \"bin\" to outputs");
  }
  return c;
}

// --load IMAGE.bin and the rvsim settings
fn rvx_rvsim_args(p: Project*, r: Cmd*, base: string, st: Settings*) {
  var raw: string = base + ".bin";
  cmd_arg(r, "--load");
  cmd_path(r, raw);
  if (slen(st->rvsim_until_ms) > 0) {
    cmd_arg(r, "--until-ms");
    cmd_arg(r, st->rvsim_until_ms);
  }
  if (slen(st->exit_on_uart) > 0) {
    cmd_arg(r, "--exit-on-uart");
    cmd_arg(r, st->exit_on_uart);
  }
  if (slen(st->uart_script) > 0) {
    cmd_arg(r, "--uart-in");
    cmd_path(r, p_join(p->root, st->uart_script));
  }
  if (slen(st->pins) > 0) {
    cmd_arg(r, "--pins");
    cmd_path(r, p_join(p->root, st->pins));
  }
}

// turns the console of a --pgo-gen board run into the profile, with
// tools/riscv-pgo-capture.py of the mettle checkout ($METTLE's or m's)
export fn rv_pgo_capture(m: Mettle*, console: string, prof: string) {
  var tree: string = rvx_tree(env_get("METTLE"));
  if (slen(tree) == 0) {
    tree = rvx_tree(m->path);
  }
  var script: string = tree + "/tools/riscv-pgo-capture.py";
  if (slen(tree) == 0 || !fs_is_file(script)) {
    var why: string = "the compiler is not in a Mettle checkout";
    if (slen(tree) > 0) {
      why = tree + " has no tools/riscv-pgo-capture.py";
    }
    fail_hint("a board prints its profile on the console, and turning that into the profile needs tools/riscv-pgo-capture.py: " + why, "use a compiler from a Mettle checkout with RISC-V --pgo-gen (set METTLE); the console is in " + console);
  }
  var py: Tool = proc_tool("python3", "MBUILD_PYTHON");
  if (!tool_found(py)) {
    fail_hint("turning the board's console into a profile needs python3", "install python3, or set MBUILD_PYTHON");
  }
  var c: Cmd* = cmd_new(py);
  defer free(c);
  cmd_path(c, script);
  cmd_path(c, console);
  cmd_path(c, prof);
  var cap: Captured = proc_capture_all(c);
  if (cap.code != 0) {
    err_line(cap.out);
    fail_hint("the run's console has no complete profile (mettle-profile-begin ... mettle-profile-end)", "main must return before the emulator stops: raise rvsim-until-ms or drop exit-on-uart for the training run");
  }
}

// the mettle checkout a compiler was built in ("" when it is not in one)
fn rvx_tree(compiler: string) -> string {
  if (slen(compiler) == 0) {
    return s_empty();
  }
  var real: string = sys_realpath(compiler);
  if (slen(real) == 0) {
    real = compiler;
  }
  var dir: string = p_dir(p_dir(real));
  if (fs_is_file(dir + "/tools/riscv-sim/rvsim.c")) {
    return dir;
  }
  return s_empty();
}

// rvsim: MBUILD_RVSIM, PATH, $MBUILD_HOME/tools, else built there from the
// mettle checkout of $METTLE or of the selected compiler
fn rvx_rvsim(m: Mettle*) -> Tool {
  var given: string = env_get("MBUILD_RVSIM");
  if (slen(given) > 0) {
    if (!fs_is_file(given)) {
      fail_hint("MBUILD_RVSIM=" + given + " does not exist", "point MBUILD_RVSIM at a built rvsim, or unset it");
    }
    return sys_find_tool(given);
  }
  var t: Tool = sys_find_tool("rvsim");
  if (tool_found(t)) {
    return t;
  }
  var tools: string = fs_mbuild_home() + "/tools";
  var exe: string = tools + "/rvsim" + sys_exe_ext();
  if (fs_is_file(exe)) {
    return sys_find_tool(exe);
  }
  var tree: string = rvx_tree(env_get("METTLE"));
  if (slen(tree) == 0) {
    tree = rvx_tree(m->path);
  }
  if (slen(tree) == 0) {
    fail_hint("board pico2 runs on rvsim, the Mettle project's simulator, and mbuild finds neither rvsim nor its source", "put rvsim on PATH, set MBUILD_RVSIM to it, or set METTLE to the compiler of a Mettle checkout (it has tools/riscv-sim/rvsim.c)");
  }
  var gcc: Tool = sys_find_tool("gcc");
  if (!tool_found(gcc)) {
    fail_hint("building rvsim from " + tree + " needs gcc", "install gcc, or set MBUILD_RVSIM to a built rvsim");
  }
  fs_mkdirs(tools);
  var tmp: string = exe + ".tmp";
  status("Building", "rvsim from " + tree + "/tools/riscv-sim");
  var c: Cmd* = cmd_new(gcc);
  defer free(c);
  cmd_arg(c, "-std=c99");
  cmd_arg(c, "-O2");
  cmd_arg(c, "-o");
  cmd_path(c, tmp);
  cmd_path(c, "tools/riscv-sim/rvsim.c");
  cmd_arg(c, "-lm");
  c->cwd = tree;
  var cap: Captured = proc_capture_all(c);
  if (cap.code != 0 || !fs_is_file(tmp)) {
    err_line(cap.out);
    fail("could not build rvsim (gcc exited with " + s_int((int64)cap.code) + ")");
  }
  sys_rename(tmp, exe);
  return sys_find_tool(exe);
}
