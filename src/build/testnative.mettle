// testnative: an @test file as a program, for tests the interpreter cannot run

import "std/mem";
import "../core/base";

// whether text[at..] starts with word, at a line's first non-blank byte
fn tnv_at_line_start(text: string, at: int64) -> bool {
  var i: int64 = at - 1;
  while (i >= 0) {
    var c: int32 = s_byte(text, i);
    if (c == 10) {
      return true;
    }
    if (c != 32 && c != 9) {
      return false;
    }
    i = i - 1;
  }
  return true;
}

fn tnv_skip_space(text: string, i: int64) -> int64 {
  while (i < slen(text) && is_space_b(s_byte(text, i))) {
    i = i + 1;
  }
  return i;
}

// the @test functions of text in source order: "name\t1" when it returns a
// value (int32, 0 = passed), "name\t0" when it returns nothing
export fn tnv_tests(text: string) -> StrList* {
  var l: StrList* = sl_new();
  var n: int64 = slen(text);
  var at: int64 = s_find(text, "@test");
  while (at >= 0) {
    var after: int64 = at + 5;
    if (tnv_at_line_start(text, at) && (after >= n || is_space_b(s_byte(text, after)))) {
      var f: int64 = s_find_from(text, "fn ", after);
      if (f > 0) {
        var i: int64 = tnv_skip_space(text, f + 3);
        var start: int64 = i;
        while (i < n && is_ident_b(s_byte(text, i))) {
          i = i + 1;
        }
        var name: string = s_sub(text, start, i);
        var open: int64 = s_find_from(text, "(", i);
        var depth: int64 = 0;
        var k: int64 = open;
        while (k >= 0 && k < n) {
          var c: int32 = s_byte(text, k);
          if (c == 40) {
            depth = depth + 1;
          } else if (c == 41) {
            depth = depth - 1;
            if (depth == 0) {
              break;
            }
          }
          k = k + 1;
        }
        var brace: int64 = s_find_from(text, "{{", k);
        var returns: string = "0";
        if (k > 0 && brace > k && s_contains(s_sub(text, k, brace), "->")) {
          returns = "1";
        }
        if (slen(name) > 0) {
          sl_push(l, name + "\t" + returns);
        }
      }
    }
    at = s_find_from(text, "@test", after);
  }
  return l;
}

// the program: text with line 1 importing std/io, fn main renamed, and a
// main that runs tests ("name\t1" / "name\t0" entries) in order
export fn tnv_source(text: string, tests: StrList*) -> string {
  var b: Buf* = buf_new();
  buf_add(b, "import \"std/io\"; ");
  var n: int64 = slen(text);
  var from: int64 = 0;
  var at: int64 = s_find(text, "fn main(");
  while (at >= 0) {
    if (tnv_at_line_start(text, at)) {
      buf_add(b, s_sub(text, from, at));
      buf_add(b, "fn mbt_orig_main(");
      from = at + 8;
    }
    at = s_find_from(text, "fn main(", at + 8);
  }
  buf_add(b, s_sub(text, from, n));
  if (n > 0 && s_byte(text, n - 1) != 10) {
    buf_addb(b, 10);
  }
  buf_add(b, "\n// generated by mbuild: the tests the interpreter could not run\n");
  buf_add(b, "fn mbt_ran(code: int32) -> int32 {{\n  if (code == 0) {{\n    println(\"ok\");\n    return 0;\n  }\n  println(\"FAILED (returned {{code})\");\n  return 1;\n}\n\n");
  buf_add(b, "fn main() -> int32 {{\n  var mbt_failed: int32 = 0;\n");
  var i: int64 = 0;
  while (i < tests->len) {
    var e: string = sl_get(tests, i);
    var tab: int64 = s_find_byte(e, 9);
    var name: string = s_sub(e, 0, tab);
    buf_add(b, "  print(\"test " + name + " ... \");\n");
    if (s_eq(s_from(e, tab + 1), "1")) {
      buf_add(b, "  mbt_failed = mbt_failed + mbt_ran(" + name + "());\n");
    } else {
      buf_add(b, "  " + name + "();\n  println(\"ok\");\n");
    }
    i = i + 1;
  }
  buf_add(b, "  if (mbt_failed > 0) {{\n    return 1;\n  }\n  return 0;\n}\n");
  return buf_take(b);
}

// the entries of all whose names are in names, in all's order
export fn tnv_pick(all: StrList*, names: StrList*) -> StrList* {
  var l: StrList* = sl_new();
  var i: int64 = 0;
  while (i < all->len) {
    var e: string = sl_get(all, i);
    if (sl_has(names, s_sub(e, 0, s_find_byte(e, 9)))) {
      sl_push(l, e);
    }
    i = i + 1;
  }
  return l;
}

// the checks of a native run: its "test NAME ... ok" lines
export fn tnv_passed(out: string) -> int64 {
  var lines: StrList* = s_lines(out);
  defer free(lines);
  var n: int64 = 0;
  var i: int64 = 0;
  while (i < lines->len) {
    var l: string = sl_get(lines, i);
    if (s_starts(l, "test ") && s_ends(l, " ... ok")) {
      n = n + 1;
    }
    i = i + 1;
  }
  return n;
}
