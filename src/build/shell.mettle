// shell: `mbuild shell`, a prompt inside a running program (DESIGN 18).
//
// The bin's project files are copied into .mbuild/shell/tree, whose
// mettle.deps maps "mbuild/shell" to a generated hook module, and built with
// --live. An input becomes the body of the hook's mbsh_eval: a --live-patch
// the program takes at its next quiesce, runs once in shell_point() and
// answers through a file in .mbuild/shell/out; --live-undo then takes the
// body out again. A `fn` input replaces that function's text in the tree and
// stays until `undo`. The type of an expression comes from a probe compile
// (the compiler names it in a type mismatch). --local builds each input into
// a program of its own that imports what the entry imports.

import "std/io";
import "std/mem";
import "../core/base";
import "../core/path";
import "../core/fs";
import "../core/proc";
import "../model/project";
import "../model/manifest";
import "scan";
import "graph";
import "toolchain";
import "build";
import "shell_term";
import "../core/sys_linux" if linux;
import "../core/sys_windows" if windows;

struct ShxSess {
  sb: ShellBuild*;
  local: bool;
  dir: string;         // .mbuild/shell
  tree: string;        // the program's sources as patched
  hook: string;        // the generated "mbuild/shell" (--local: the snippet)
  entry: string;       // what the compiler gets
  out: string;         // result files, one per input
  seq: int64;
  pid: int64;
  timeout: int64;      // ms
  tnames: StrList*;    // struct types: name, "a: int32; b: string", file, line
  tsigs: StrList*;
  tfiles: StrList*;
  tlines: StrList*;
  dnames: StrList*;    // every declaration for ls, explain and completion
  dkinds: StrList*;
  draws: StrList*;     // the scanner's sig
  dsigs: StrList*;
  ddocs: StrList*;
  dfiles: StrList*;
  dlines: StrList*;
  ufiles: StrList*;    // undo of r: tree files' text before it,
  utexts: StrList*;    // ugroups the change each belongs to
  ugroups: StrList*;
  ngroups: int64;      // the next change's id
  gids: StrList*;      // the changes kept, oldest first: id,
  gnames: StrList*;    // the fn it replaced ("" for r),
  gfiles: StrList*;    // its tree file,
  gold: StrList*;      // its text before ("" when it was added),
  gticks: StrList*;    // the tick it went in at
  wnames: StrList*;    // watch expressions
  wtypes: StrList*;
  cond: string;        // pause when this turns true ("" none)
  pausef: string;      // the program waits in shell_point while it exists
  stepf: string;       // one shell_point goes by
  statef: string;      // tick, paused, watch values: written by the program
  tick: int64;         // from the state file
  paused: bool;
  why: string;         // "user" or "when"
  serve: bool;         // for mbuild-shell: framed output
  sent: string;        // the last status sent (serve)
  binds: StrList*;     // --local: var statements so far
  defs: StrList*;      // --local: fn inputs so far
  fields: StrList*;    // field names of the struct types, for completion
  hist: StrList*;
  tty: bool;
  fifo: string;        // the program's stdout and stderr come through it
  fd: int32;           // -1: no program (--local)
  pend: Buf*;          // output after its last whole line
  pend_ms: int64;
  log: StrList*;       // its last lines, for :log
  muted: bool;         // its output is held (the default)
  held: int64;         // lines held since the last prompt
  exitf: string;       // the program's exit code, written when it ends
  ended: bool;         // it has exited and the shell leaves
  lead: string;        // in front of an answer
}

// ---------------------------------------------------------------------------
// Declarations: struct printers, h, completion
// ---------------------------------------------------------------------------

fn shx_display(it: ExportItem*) -> string {
  if (s_eq(it->kind, "fn")) {
    return "fn " + it->name + it->sig;
  }
  if (s_eq(it->kind, "extern")) {
    return "extern fn " + it->name + it->sig;
  }
  if (s_eq(it->kind, "struct") || s_eq(it->kind, "enum")) {
    return it->kind + " " + it->name + " {{ " + it->sig + " }";
  }
  if (slen(it->sig) == 0) {
    return it->kind + " " + it->name;
  }
  return it->kind + " " + it->name + ": " + it->sig;
}

fn shx_add_decls(ss: ShxSess*, file: string, text: string, all: bool, types: bool) {
  var l: ExportList* = (ExportList*)0;
  if (all) {
    l = scan_decls(text);
  } else {
    l = scan_exports(text);
  }
  var lines: StrList* = s_lines(text);
  var i: int64 = 0;
  while (i < l->n) {
    var it: ExportItem* = scan_export(l, i);
    i = i + 1;
    var doc: StrList* = shx_doc(lines, it->line);
    sl_push(ss->dnames, it->name);
    sl_push(ss->dkinds, it->kind);
    sl_push(ss->draws, it->sig);
    sl_push(ss->dsigs, shx_display(it));
    sl_push(ss->ddocs, sl_join(doc, "\n"));
    free(doc);
    sl_push(ss->dfiles, file);
    sl_push(ss->dlines, s_int(it->line));
    if (types && s_eq(it->kind, "struct") && !s_starts(it->sig, "<") && !sl_has(ss->tnames, it->name)) {
      var fts: StrList* = sl_new();
      shx_fields(it->sig, ss->fields, fts);
      free(fts);
      sl_push(ss->tnames, it->name);
      sl_push(ss->tsigs, it->sig);
      sl_push(ss->tfiles, file);
      sl_push(ss->tlines, s_int(it->line));
    }
  }
  free(lines);
  free(l->items);
  free(l);
}

// The project's files (struct printers come from these; --local skips the
// entry, which the snippet does not import), then the exports of the
// packages' files in the bin's import graph.
fn shx_scan(ss: ShxSess*) {
  ss->tnames = sl_new();
  ss->tsigs = sl_new();
  ss->tfiles = sl_new();
  ss->tlines = sl_new();
  ss->dnames = sl_new();
  ss->dkinds = sl_new();
  ss->draws = sl_new();
  ss->dsigs = sl_new();
  ss->ddocs = sl_new();
  ss->dfiles = sl_new();
  ss->dlines = sl_new();
  ss->fields = sl_new();
  var sb: ShellBuild* = ss->sb;
  var i: int64 = 0;
  while (i < sb->files->len) {
    var f: string = sl_get(sb->files, i);
    i = i + 1;
    var r: FsRead = fs_read(f);
    if (r.ok) {
      shx_add_decls(ss, f, r.data, true, !(ss->local && s_eq(f, sb->entry)));
    }
  }
  i = 0;
  while (i < sb->graph->len) {
    var f: string = sl_get(sb->graph, i);
    i = i + 1;
    if (sl_has(sb->files, f) || slen(shx_dep_of(ss, f)) == 0) {
      continue;
    }
    var r: FsRead = fs_read(f);
    if (r.ok) {
      shx_add_decls(ss, f, r.data, false, false);
    }
  }
}

// The package directory holding f, "" when none does (the project's own
// package, whose directory is the root, does not count).
fn shx_dep_of(ss: ShxSess*, f: string) -> string {
  var sb: ShellBuild* = ss->sb;
  var i: int64 = 0;
  while (i < sb->deps->len) {
    var dir: string = sl_get(sb->deps, i);
    if (!s_eq(dir, sb->p->root) && p_has_prefix_dir(f, dir)) {
      return dir;
    }
    i = i + 1;
  }
  return s_empty();
}

// A file as shown: PACKAGE/REL for a package's, else relative to the root.
fn shx_shown(ss: ShxSess*, file: string) -> string {
  var sb: ShellBuild* = ss->sb;
  var dir: string = shx_dep_of(ss, file);
  if (slen(dir) > 0) {
    var name: string = sl_get(sb->dep_names, sl_index(sb->deps, dir));
    var rel: string = p_rel(dir, file);
    return name + "/" + rel;
  }
  if (p_has_prefix_dir(file, sb->p->root)) {
    return p_rel(sb->p->root, file);
  }
  return file;
}

fn shx_is_scalar(t: string) -> bool {
  var l: StrList* = s_split("int8 int16 int32 int64 uint8 uint16 uint32 uint64 float32 float64 bool char cstring", 32);
  var has: bool = sl_has(l, t);
  free(l);
  return has;
}

// Generated code showing the value at acc (of type t) as a string; top: a
// pointer to a struct is shown with its fields, inside a struct as an address.
fn shx_fmt(ss: ShxSess*, t: string, acc: string, top: bool) -> string {
  if (shx_is_scalar(t)) {
    return "\"{{" + acc + "}\"";
  }
  if (s_eq(t, "string")) {
    return "mbsh_q(" + acc + ")";
  }
  if (sl_has(ss->tnames, t)) {
    return "mbsh_show_" + t + "(&" + acc + ")";
  }
  if (s_ends(t, "*")) {
    var to: string = s_sub(t, 0, slen(t) - 1);
    if (top && sl_has(ss->tnames, to)) {
      return "mbsh_ref_" + to + "(" + acc + ")";
    }
    if (top) {
      return "\"" + t + " \" + mbsh_hex((int64)" + acc + ")";
    }
    return "mbsh_hex((int64)" + acc + ")";
  }
  return "\"#" + t + "\"";
}

// "a: int32; b: string" as names and types.
fn shx_fields(sig: string, names: StrList*, types: StrList*) {
  var parts: StrList* = s_split(sig, 59);
  var i: int64 = 0;
  while (i < parts->len) {
    var f: string = s_trim(sl_get(parts, i));
    i = i + 1;
    var colon: int64 = s_find_byte(f, 58);
    if (colon <= 0) {
      continue;
    }
    sl_push(names, s_trim(s_sub(f, 0, colon)));
    sl_push(types, s_trim(s_from(f, colon + 1)));
  }
  free(parts);
}

fn shx_printers(ss: ShxSess*) -> string {
  var b: Buf* = buf_new();
  var i: int64 = 0;
  while (i < ss->tnames->len) {
    var n: string = sl_get(ss->tnames, i);
    var names: StrList* = sl_new();
    var types: StrList* = sl_new();
    shx_fields(sl_get(ss->tsigs, i), names, types);
    i = i + 1;
    buf_add(b, "fn mbsh_show_" + n + "(v: " + n + "*) -> string {{\n");
    buf_add(b, "  var s: string = \"" + n + " {{{{\";\n");
    var k: int64 = 0;
    while (k < names->len) {
      var sep: string = " ";
      if (k > 0) {
        sep = ", ";
      }
      var acc: string = "v->" + sl_get(names, k);
      buf_add(b, "  s = s + \"" + sep + sl_get(names, k) + ": \" + " + shx_fmt(ss, sl_get(types, k), acc, false) + ";\n");
      k = k + 1;
    }
    buf_add(b, "  s = s + \" }\";\n  return s;\n}\n\n");
    buf_add(b, "fn mbsh_ref_" + n + "(v: " + n + "*) -> string {{\n");
    buf_add(b, "  if (v == (" + n + "*)0) {{\n    return \"null\";\n  }\n  return \"&\" + mbsh_show_" + n + "(v);\n}\n\n");
    free(names);
    free(types);
  }
  return buf_take(b);
}

fn shx_keep(ss: ShxSess*) -> string {
  var b: Buf* = buf_new();
  var i: int64 = 0;
  while (i < ss->tnames->len) {
    var n: string = sl_get(ss->tnames, i);
    buf_add(b, "  mbsh_put(\"\", mbsh_ref_" + n + "((" + n + "*)0));\n");
    i = i + 1;
  }
  return buf_take(b);
}

// ---------------------------------------------------------------------------
// The hook module and the commands
// ---------------------------------------------------------------------------

// A path as the text of a Mettle string literal.
fn shx_lit(s: string) -> string {
  var t: string = s_replace(s, "\\", "\\\\");
  t = s_replace(t, "\"", "\\\"");
  return "\"" + s_replace(t, "{{", "{{{{") + "\"";
}

// The project imports of the entry, resolved to absolute paths (--local).
fn shx_local_imports(ss: ShxSess*) -> string {
  var sb: ShellBuild* = ss->sb;
  var r: FsRead = fs_read(sb->entry);
  var b: Buf* = buf_new();
  buf_add(b, "import \"std/io\";\n");
  if (!r.ok) {
    return buf_take(b);
  }
  var ctx: GraphCtx* = graph_ctx_new(sys_os(), sb->m->stdlib_dir);
  defer free(ctx);
  sl_extend(ctx->includes, sb->includes);
  ctx->cwd = sb->p->root;
  var sr: ScanResult* = scan_source(r.data);
  defer free(sr);
  var i: int64 = 0;
  while (i < sr->nimports) {
    var imp: ImportRef* = scan_import(sr, i);
    i = i + 1;
    if (!scan_guard_active(imp->guard, sys_os()) || s_eq(imp->path, "mbuild/shell")) {
      continue;
    }
    var at: string = graph_resolve(ctx, sb->entry, imp->path);
    if (slen(at) == 0) {
      at = imp->path;
    }
    buf_add(b, "import " + shx_lit(at) + ";\n");
  }
  return buf_take(b);
}

// The paths the hook polls and writes.
fn shx_paths(ss: ShxSess*) -> string {
  var b: Buf* = buf_new();
  buf_add(b, "var mbsh_pause_path: string = " + shx_lit(ss->pausef) + ";\n");
  buf_add(b, "var mbsh_step_path: string = " + shx_lit(ss->stepf) + ";\n");
  buf_add(b, "var mbsh_state_path: string = " + shx_lit(ss->statef) + ";\n");
  return buf_take(b);
}

// mbsh_watch's body: a line per watch, then the pause-when condition.
fn shx_watch_body(ss: ShxSess*) -> string {
  var b: Buf* = buf_new();
  if (ss->local) {
    return buf_take(b);
  }
  var i: int64 = 0;
  while (i < ss->wnames->len) {
    var v: string = "_w" + s_int(i);
    buf_add(b, "  var " + v + " = (" + sl_get(ss->wnames, i) + ");\n");
    var fmt: string = shx_fmt(ss, sl_get(ss->wtypes, i), v, true);
    buf_add(b, "  s = s + \"w \" + " + shx_lit(sl_get(ss->wnames, i)) + " + \"\\t\" + " + fmt + " + \"\\n\";\n");
    i = i + 1;
  }
  if (slen(ss->cond) > 0) {
    buf_add(b, "  var _c: bool = (" + ss->cond + ");\n  mbsh_hit = _c && !mbsh_was;\n  mbsh_was = _c;\n");
  }
  return buf_take(b);
}

fn shx_hook_text(ss: ShxSess*, body: string) -> string {
  var t: string = import_str "../mbapi/shell_live.mettle";
  t = s_replace(t, "//@printers\n", shx_printers(ss));
  t = s_replace(t, "//@keep\n", shx_keep(ss));
  t = s_replace(t, "//@paths\n", shx_paths(ss));
  t = s_replace(t, "//@watch\n", shx_watch_body(ss));
  t = s_replace(t, "//@body\n", body);
  if (!ss->local) {
    return t;
  }
  var cut: int64 = s_find(t, "export fn shell_point()");
  if (cut > 0) {
    t = s_sub(t, 0, cut);
  }
  var b: Buf* = buf_new();
  buf_add(b, shx_local_imports(ss));
  buf_add(b, t);
  var i: int64 = 0;
  while (i < ss->defs->len) {
    buf_add(b, "\n" + sl_get(ss->defs, i) + "\n");
    i = i + 1;
  }
  buf_add(b, "\nfn main() -> int32 {{\n  mbsh_eval();\n  return 0;\n}\n");
  return buf_take(b);
}

fn shx_tool(path: string) -> Tool {
  var t: Tool;
  t.path = path;
  t.unix = false;
  return t;
}

fn shx_cmd(ss: ShxSess*) -> Cmd* {
  var base: Cmd* = ss->sb->base;
  var c: Cmd* = cmd_new(base->tool);
  sl_extend(c->env, base->env);
  c->cwd = base->cwd;
  return c;
}

fn shx_flags(ss: ShxSess*, c: Cmd*) {
  sl_extend(c->args, ss->sb->base->args);
  sl_extend(c->kinds, ss->sb->base->kinds);
}

// The compiler's diagnostics, without the boxes around the source.
fn shx_show_errors(out: string) {
  var lines: StrList* = s_lines(out);
  var shown: StrList* = sl_new();
  var i: int64 = 0;
  while (i < lines->len) {
    var l: string = s_trim(sl_get(lines, i));
    i = i + 1;
    if ((s_starts(l, "error") || s_starts(l, "warning")) && !s_contains(l, "could not compile") && !sl_has(shown, l)) {
      sl_push(shown, l);
      err_line(red(l));
    }
  }
  if (shown->len == 0 && slen(s_trim(out)) > 0) {
    err_line(s_trim(out));
  }
  free(lines);
  free(shown);
}

fn shx_patch_count(ss: ShxSess*) -> int64 {
  var files: StrList* = sl_new();
  var dirs: StrList* = sl_new();
  sys_list_dir(ss->sb->exe + ".live.d", files, dirs);
  var n: int64 = 0;
  var i: int64 = 0;
  while (i < files->len) {
    if (s_ends(sl_get(files, i), ".mpatch")) {
      n = n + 1;
    }
    i = i + 1;
  }
  free(files);
  free(dirs);
  return n;
}

// Writes the hook with body and compiles: an object only (probe), a patch,
// or (--local) the snippet program. The compiler's output, "" when it failed
// (the errors are in *out).
fn shx_compile(ss: ShxSess*, body: string, probe: bool, out: Captured*) -> bool {
  fs_write(ss->hook, shx_hook_text(ss, body));
  var c: Cmd* = shx_cmd(ss);
  defer free(c);
  if (probe) {
    cmd_path(c, ss->entry);
    shx_flags(ss, c);
    cmd_arg(c, "-o");
    cmd_path(c, ss->dir + "/probe.o");
  } else if (ss->local) {
    cmd_arg(c, "--build");
    cmd_path(c, ss->entry);
    shx_flags(ss, c);
    cmd_arg(c, "-o");
    cmd_path(c, ss->dir + "/local/snippet");
  } else {
    cmd_arg(c, "--live-patch");
    cmd_path(c, ss->sb->exe);
    cmd_path(c, ss->entry);
    shx_flags(ss, c);
  }
  verbose(cmd_display(c));
  *out = proc_capture_all(c);
  return out->code == 0;
}

// The empty hook, and the eval patch undone (live).
fn shx_revert(ss: ShxSess*) {
  fs_write(ss->hook, shx_hook_text(ss, ""));
  if (ss->local) {
    return;
  }
  shx_undo_patch(ss);
}

fn shx_undo_patch(ss: ShxSess*) -> bool {
  var c: Cmd* = shx_cmd(ss);
  defer free(c);
  cmd_arg(c, "--live-undo");
  cmd_path(c, ss->sb->exe);
  var r: Captured = proc_capture_all(c);
  if (r.code != 0) {
    shx_show_errors(r.out);
  }
  return r.code == 0;
}

// ---------------------------------------------------------------------------
// Inputs
// ---------------------------------------------------------------------------

fn shx_binds_text(ss: ShxSess*, indent: string) -> string {
  var b: Buf* = buf_new();
  var i: int64 = 0;
  while (i < ss->binds->len) {
    buf_add(b, indent + sl_get(ss->binds, i) + "\n");
    i = i + 1;
  }
  return buf_take(b);
}

// The type of an expression, "" when it does not compile (errors shown).
fn shx_type_of(ss: ShxSess*, expr: string, quiet: bool) -> string {
  var body: string = "  if (mbsh_seq < -1) {{\n" + shx_binds_text(ss, "    ") + "    var _p: MbshProbe = (" + expr + ");\n  }\n";
  var r: Captured;
  if (shx_compile(ss, body, true, &r)) {
    return "MbshProbe";
  }
  var key: string = "MbshProbe', found '";
  var at: int64 = s_find(r.out, key);
  if (at >= 0) {
    var rest: string = s_from(r.out, at + slen(key));
    return s_sub(rest, 0, s_find_byte(rest, 39));
  }
  if (!quiet) {
    shx_show_errors(r.out);
  }
  return s_empty();
}

// Runs code once in the program (or the snippet) and answers what it wrote.
fn shx_run(ss: ShxSess*, code: string, result: string) -> bool {
  ss->seq = ss->seq + 1;
  var n: string = s_int(ss->seq);
  var path: string = ss->out + "/" + n;
  var b: Buf* = buf_new();
  buf_add(b, "  if (mbsh_seq >= " + n + ") {{\n    return;\n  }\n  mbsh_seq = " + n + ";\n");
  if (ss->local) {
    buf_add(b, shx_binds_text(ss, "  "));
    buf_add(b, "  print(\"\\n<mbsh>\\n\");\n");
  }
  buf_add(b, code);
  buf_add(b, "  mbsh_put(" + shx_lit(path) + ", " + result + ");\n");
  var body: string = buf_take(b);
  var r: Captured;
  if (!shx_compile(ss, body, false, &r)) {
    shx_show_errors(r.out);
    fs_write(ss->hook, shx_hook_text(ss, ""));
    return false;
  }
  if (ss->local) {
    var c: Cmd* = cmd_new(shx_tool(ss->dir + "/local/snippet"));
    defer free(c);
    c->cwd = ss->sb->p->root;
    var o: Captured = proc_capture_all(c);
    var mark: int64 = s_find(o.out, "\n<mbsh>\n");
    var shown: string = o.out;
    if (mark >= 0) {
      shown = s_from(o.out, mark + 8);
    }
    print(shown);
    var rd: FsRead = fs_read(path);
    if (rd.ok) {
      say(ss->lead + rd.data);
      return true;
    }
    error_msg("the snippet stopped with code " + s_int(o.code) + " before its answer");
    return false;
  }
  var got: bool = shx_wait(ss, path);
  shx_revert(ss);
  return got;
}

fn shx_wait(ss: ShxSess*, path: string) -> bool {
  var start: int64 = sys_now_ms();
  while (sys_now_ms() - start < ss->timeout) {
    shx_relay(ss);
    var rd: FsRead = fs_read(path);
    if (rd.ok) {
      shx_relay(ss);
      say(ss->lead + rd.data);
      return true;
    }
    if (!sys_pid_alive(ss->pid)) {
      error_msg("the program has exited");
      return false;
    }
    sys_sleep_ms(5);
  }
  error_msg("no answer in " + s_int(ss->timeout / 1000) + "s: the program never reached shell_point()");
  err_line("  " + cyan("help") + ": call `shell_point();` (import \"mbuild/shell\") next to its `quiesce;`");
  return false;
}

fn shx_is_statement(line: string) -> bool {
  var t: string = s_trim(line);
  if (s_ends(t, ";") || s_ends(t, "}")) {
    return true;
  }
  var words: StrList* = s_split("var if while for return defer", 32);
  defer free(words);
  var i: int64 = 0;
  while (i < words->len) {
    if (s_starts(t, sl_get(words, i) + " ") || s_starts(t, sl_get(words, i) + "(")) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

fn shx_eval(ss: ShxSess*, line: string) {
  if (!ss->local && !sys_pid_alive(ss->pid)) {
    error_msg("the program has exited; h and i still work, :q leaves");
    return;
  }
  if (shx_is_statement(line)) {
    var stmt: string = s_trim(line);
    if (!s_ends(stmt, ";") && !s_ends(stmt, "}")) {
      stmt = stmt + ";";
    }
    if (shx_run(ss, "  " + stmt + "\n", "\"ok\"") && ss->local && s_starts(stmt, "var ")) {
      sl_push(ss->binds, stmt);
    }
    return;
  }
  var t: string = shx_type_of(ss, line, false);
  if (slen(t) == 0) {
    fs_write(ss->hook, shx_hook_text(ss, ""));
    return;
  }
  if (s_eq(t, "void")) {
    shx_run(ss, "  " + line + ";\n", "\"ok\"");
    return;
  }
  shx_run(ss, "  var _v = (" + line + ");\n", shx_fmt(ss, t, "_v", true));
}

// `fn NAME...`: NAME's text in the tree replaced (or the fn added to the
// entry), patched, kept until undo.
fn shx_define(ss: ShxSess*, line: string) {
  var text: string = s_trim(line);
  var head: string = text;
  if (s_starts(head, "export ")) {
    head = s_from(head, 7);
  }
  var name: string = s_trim(s_from(head, 3));
  var k: int64 = 0;
  while (k < slen(name) && is_ident_b(s_byte(name, k))) {
    k = k + 1;
  }
  name = s_sub(name, 0, k);
  if (slen(name) == 0) {
    error_msg("fn needs a name: fn NAME(ARGS) -> T {{ ... }");
    return;
  }
  if (ss->local) {
    var di: int64 = 0;
    while (di < ss->defs->len) {
      if (s_starts(sl_get(ss->defs, di), "fn " + name + "(") || s_starts(sl_get(ss->defs, di), "fn " + name + "<")) {
        sl_remove_at(ss->defs, di);
      } else {
        di = di + 1;
      }
    }
    sl_push(ss->defs, text);
    var lr: Captured;
    if (!shx_compile(ss, "", true, &lr)) {
      shx_show_errors(lr.out);
      sl_remove_at(ss->defs, ss->defs->len - 1);
      return;
    }
    say("defined " + name);
    return;
  }
  var found: ShxSpan = shx_find_fn(ss, name);
  var file: string = found.file;
  var old: string = s_empty();
  var next: string = s_empty();
  var added: bool = slen(file) == 0;
  if (added) {
    file = ss->entry;
    var er: FsRead = fs_read(file);
    old = er.data;
    next = er.data + "\n" + text + "\n";
  } else {
    var mine: string = text;
    if (found.exported && !s_starts(mine, "export ")) {
      mine = "export " + mine;
    }
    old = found.data;
    next = s_sub(found.data, 0, found.spos) + mine + s_from(found.data, found.epos);
  }
  fs_write(file, next);
  var r2: Captured;
  var before: int64 = shx_patch_count(ss);
  if (!shx_compile(ss, "", false, &r2)) {
    fs_write(file, old);
    shx_show_errors(r2.out);
    return;
  }
  if (shx_patch_count(ss) > before) {
    shx_state(ss);
    sl_push(ss->gids, s_int(ss->ngroups));
    sl_push(ss->gnames, name);
    sl_push(ss->gfiles, file);
    sl_push(ss->gold, found.text);
    sl_push(ss->gticks, s_int(ss->tick));
    ss->ngroups = ss->ngroups + 1;
  }
  if (added) {
    say("defined " + name);
  } else {
    say("redefined " + name);
  }
}

// Where a function is in the tree: its file ("" when no file has it), the
// file's text, its span and text.
struct ShxSpan {
  file: string;
  data: string;
  spos: int64;
  epos: int64;
  text: string;
  line: int64;
  exported: bool;
}

fn shx_find_fn(ss: ShxSess*, name: string) -> ShxSpan {
  var sp: ShxSpan;
  sp.file = s_empty();
  sp.data = s_empty();
  sp.spos = 0;
  sp.epos = 0;
  sp.text = s_empty();
  sp.line = 0;
  sp.exported = false;
  var i: int64 = 0;
  while (i < ss->sb->files->len && slen(sp.file) == 0) {
    var f: string = shx_tree_path(ss, sl_get(ss->sb->files, i));
    i = i + 1;
    var r: FsRead = fs_read(f);
    if (!r.ok) {
      continue;
    }
    var l: ExportList* = scan_decls(r.data);
    var j: int64 = 0;
    while (j < l->n) {
      var it: ExportItem* = scan_export(l, j);
      j = j + 1;
      if (s_eq(it->kind, "fn") && s_eq(it->name, name) && it->epos > it->spos) {
        sp.file = f;
        sp.data = r.data;
        sp.spos = it->spos;
        sp.epos = it->epos;
        sp.text = s_sub(r.data, it->spos, it->epos);
        sp.line = it->line;
        sp.exported = it->exported;
        break;
      }
    }
    free(l->items);
    free(l);
  }
  return sp;
}

fn shx_push_undo(ss: ShxSess*, file: string, text: string) {
  sl_push(ss->ufiles, file);
  sl_push(ss->utexts, text);
  sl_push(ss->ugroups, s_int(ss->ngroups));
}

fn shx_drop_group(ss: ShxSess*, k: int64) {
  sl_remove_at(ss->gids, k);
  sl_remove_at(ss->gnames, k);
  sl_remove_at(ss->gfiles, k);
  sl_remove_at(ss->gold, k);
  sl_remove_at(ss->gticks, k);
}

// Takes back change k: a fn's text as it was (taken out if it was added),
// r's files as they were; then patched in. Undo is a patch forward, so
// the watch patches stay.
fn shx_undo_at(ss: ShxSess*, k: int64) -> bool {
  var name: string = sl_get(ss->gnames, k);
  var g: string = sl_get(ss->gids, k);
  var undo_files: StrList* = sl_new();
  var undo_texts: StrList* = sl_new();
  defer free(undo_files);
  defer free(undo_texts);
  if (slen(name) > 0) {
    var sp: ShxSpan = shx_find_fn(ss, name);
    if (slen(sp.file) == 0) {
      error_msg(name + " is no longer in the program");
      return false;
    }
    sl_push(undo_files, sp.file);
    sl_push(undo_texts, sp.data);
    var was: string = sl_get(ss->gold, k);
    if (sp.exported && slen(was) > 0 && !s_starts(was, "export ")) {
      was = "export " + was;
    }
    var next: string = s_sub(sp.data, 0, sp.spos) + was + s_from(sp.data, sp.epos);
    fs_write(sp.file, next);
  } else {
    var j: int64 = ss->ugroups->len - 1;
    while (j >= 0) {
      if (s_eq(sl_get(ss->ugroups, j), g)) {
        var f: string = sl_get(ss->ufiles, j);
        var cur: FsRead = fs_read(f);
        sl_push(undo_files, f);
        sl_push(undo_texts, cur.data);
        fs_write(f, sl_get(ss->utexts, j));
        sl_remove_at(ss->ufiles, j);
        sl_remove_at(ss->utexts, j);
        sl_remove_at(ss->ugroups, j);
      }
      j = j - 1;
    }
  }
  var r: Captured;
  if (!shx_compile(ss, "", false, &r)) {
    var i: int64 = 0;
    while (i < undo_files->len) {
      fs_write(sl_get(undo_files, i), sl_get(undo_texts, i));
      i = i + 1;
    }
    shx_show_errors(r.out);
    return false;
  }
  shx_drop_group(ss, k);
  return true;
}

// undo [NAME]: the last change, or NAME's last redefinition.
fn shx_undo(ss: ShxSess*, name: string) {
  if (ss->local) {
    if (ss->defs->len == 0) {
      say("nothing to undo");
      return;
    }
    sl_remove_at(ss->defs, ss->defs->len - 1);
    say("ok");
    return;
  }
  var k: int64 = ss->gids->len - 1;
  if (slen(name) > 0) {
    while (k >= 0 && !s_eq(sl_get(ss->gnames, k), name)) {
      k = k - 1;
    }
    if (k < 0) {
      say(name + " has no patch to undo");
      return;
    }
  }
  if (k < 0) {
    say("nothing to undo");
    return;
  }
  var what: string = sl_get(ss->gnames, k);
  if (shx_undo_at(ss, k)) {
    if (slen(what) > 0) {
      say("undone: " + what + " as before");
    } else {
      say("undone");
    }
  }
}

fn shx_tree_path(ss: ShxSess*, f: string) -> string {
  return ss->tree + "/" + p_rel(ss->sb->p->root, f);
}

// The project's files into the tree; with record, the texts they replace
// go on the undo stack as one group. The number of files that changed.
fn shx_copy_tree(ss: ShxSess*, record: bool) -> int64 {
  var n: int64 = 0;
  var i: int64 = 0;
  while (i < ss->sb->files->len) {
    var f: string = sl_get(ss->sb->files, i);
    i = i + 1;
    var dst: string = shx_tree_path(ss, f);
    var src: FsRead = fs_read(f);
    var cur: FsRead = fs_read(dst);
    if (!src.ok || (cur.ok && s_eq(cur.data, src.data))) {
      continue;
    }
    if (record) {
      shx_push_undo(ss, dst, cur.data);
    }
    fs_write(dst, src.data);
    n = n + 1;
  }
  return n;
}

// r: the files on disk again (redefinitions dropped), patched in.
fn shx_reload(ss: ShxSess*) {
  shx_scan(ss);
  if (ss->local) {
    say("rescanned");
    return;
  }
  var changed: int64 = shx_copy_tree(ss, true);
  var before: int64 = shx_patch_count(ss);
  var r: Captured;
  if (!shx_compile(ss, "", false, &r)) {
    shx_show_errors(r.out);
    return;
  }
  if (shx_patch_count(ss) > before) {
    shx_state(ss);
    sl_push(ss->gids, s_int(ss->ngroups));
    sl_push(ss->gnames, s_empty());
    sl_push(ss->gfiles, s_empty());
    sl_push(ss->gold, s_empty());
    sl_push(ss->gticks, s_int(ss->tick));
    ss->ngroups = ss->ngroups + 1;
    var files: string = " files";
    if (changed == 1) {
      files = " file";
    }
    say("patched (" + s_int(changed) + files + ")");
  } else {
    while (ss->ugroups->len > 0 && s_eq(sl_get(ss->ugroups, ss->ugroups->len - 1), s_int(ss->ngroups))) {
      sl_remove_at(ss->ufiles, ss->ugroups->len - 1);
      sl_remove_at(ss->utexts, ss->ugroups->len - 1);
      sl_remove_at(ss->ugroups, ss->ugroups->len - 1);
    }
    say("no changes");
  }
}

// The comment lines directly above line `at` (from 1) of lines.
fn shx_doc(lines: StrList*, at: int64) -> StrList* {
  var doc: StrList* = sl_new();
  var k: int64 = at - 2;
  while (k >= 0 && k < lines->len && s_starts(s_trim(sl_get(lines, k)), "@")) {
    k = k - 1;
  }
  var last: int64 = k;
  while (k >= 0 && k < lines->len && s_starts(s_trim(sl_get(lines, k)), "//")) {
    k = k - 1;
  }
  k = k + 1;
  while (k <= last) {
    var d: string = s_from(s_trim(sl_get(lines, k)), 2);
    if (s_starts(d, " ")) {
      d = s_from(d, 1);
    }
    sl_push(doc, d);
    k = k + 1;
  }
  return doc;
}

fn shx_where(ss: ShxSess*, file: string, line: string) -> string {
  var shown: string = shx_shown(ss, file);
  return shown + ":" + line;
}

// The first line of declaration i's doc comment.
fn shx_doc1(ss: ShxSess*, i: int64) -> string {
  var doc: string = sl_get(ss->ddocs, i);
  var nl: int64 = s_find_byte(doc, 10);
  if (nl >= 0) {
    return s_sub(doc, 0, nl);
  }
  return doc;
}

// Declaration i on one line; a long struct or enum body cut short.
fn shx_brief(ss: ShxSess*, i: int64) -> string {
  var d: string = sl_get(ss->dsigs, i);
  var k: string = sl_get(ss->dkinds, i);
  if ((s_eq(k, "struct") || s_eq(k, "enum")) && slen(d) > 64) {
    var cut: string = s_sub(d, 0, 60);
    return cut + " ...}";
  }
  return d;
}

// The declarations at idx grouped by file: a line each, its signature and
// the first line of its doc comment.
fn shx_list(ss: ShxSess*, idx: StrList*) {
  var k: int64 = 0;
  while (k < idx->len) {
    var file: string = sl_get(ss->dfiles, s_to_int(sl_get(idx, k)));
    var w: int64 = 0;
    var e: int64 = k;
    while (e < idx->len && s_eq(sl_get(ss->dfiles, s_to_int(sl_get(idx, e))), file)) {
      var n: int64 = slen(shx_brief(ss, s_to_int(sl_get(idx, e))));
      if (n > w && n <= 48) {
        w = n;
      }
      e = e + 1;
    }
    say(bold(shx_shown(ss, file)));
    while (k < e) {
      var i: int64 = s_to_int(sl_get(idx, k));
      k = k + 1;
      var doc: string = shx_doc1(ss, i);
      if (slen(doc) == 0) {
        say("  " + shx_brief(ss, i));
      } else {
        say("  " + s_pad_right(shx_brief(ss, i), w) + "  " + dim(doc));
      }
    }
  }
}

fn shx_file_is(shown: string, arg: string) -> bool {
  var slash: string = "/" + arg;
  var ext: string = arg + ".mettle";
  var slash_ext: string = slash + ".mettle";
  var dir: string = arg + "/";
  return s_eq(shown, arg) || s_eq(shown, ext) || s_ends(shown, slash) || s_ends(shown, slash_ext) || s_starts(shown, dir);
}

// ls [FILE]: what the program declares, by file.
fn shx_ls(ss: ShxSess*, arg: string) {
  var idx: StrList* = sl_new();
  defer free(idx);
  var i: int64 = 0;
  while (i < ss->dnames->len) {
    if (slen(arg) == 0 || shx_file_is(shx_shown(ss, sl_get(ss->dfiles, i)), arg)) {
      sl_push(idx, s_int(i));
    }
    i = i + 1;
  }
  if (idx->len == 0) {
    if (slen(arg) == 0) {
      say("no declarations");
    } else if (sl_has(ss->dnames, arg)) {
      shx_explain(ss, arg);
    } else {
      error_msg("no file " + arg + " in this program; ls lists them all");
    }
    return;
  }
  shx_list(ss, idx);
}

// apropos TEXT: the declarations whose name or doc comment has TEXT, any case.
fn shx_apropos(ss: ShxSess*, text: string) {
  if (slen(text) == 0) {
    error_msg("apropos needs a word: apropos food");
    return;
  }
  var want: string = s_lower(text);
  var idx: StrList* = sl_new();
  defer free(idx);
  var i: int64 = 0;
  while (i < ss->dnames->len) {
    if (s_contains(s_lower(sl_get(ss->dnames, i)), want) || s_contains(s_lower(sl_get(ss->ddocs, i)), want)) {
      sl_push(idx, s_int(i));
    }
    i = i + 1;
  }
  if (idx->len == 0) {
    say("nothing matches " + text);
    return;
  }
  shx_list(ss, idx);
}

// The comment on field f of the struct declared at line `at`: after the
// field on its line, else the comment lines just above it.
fn shx_field_doc(lines: StrList*, at: int64, f: string) -> string {
  var k: int64 = at;
  while (k < lines->len) {
    var l: string = s_trim(sl_get(lines, k));
    if (s_starts(l, "}")) {
      break;
    }
    if (s_starts(l, f) && s_starts(s_trim(s_from(l, slen(f))), ":")) {
      var c: int64 = s_find(l, "//");
      if (c >= 0) {
        return s_trim(s_from(l, c + 2));
      }
      var above: StrList* = shx_doc(lines, k + 1);
      var d: string = sl_join(above, " ");
      free(above);
      return d;
    }
    k = k + 1;
  }
  return s_empty();
}

fn shx_say_doc(ss: ShxSess*, i: int64) {
  var doc: string = sl_get(ss->ddocs, i);
  if (slen(doc) == 0) {
    return;
  }
  var lines: StrList* = s_lines(doc + "\n");
  var k: int64 = 0;
  while (k < lines->len) {
    say("  " + sl_get(lines, k));
    k = k + 1;
  }
  free(lines);
}

// A struct's fields (with their comments) or an enum's variants.
fn shx_say_body(ss: ShxSess*, i: int64) {
  if (s_eq(sl_get(ss->dkinds, i), "enum")) {
    var vs: StrList* = s_split(sl_get(ss->draws, i), 44);
    var k: int64 = 0;
    while (k < vs->len) {
      say("  " + s_trim(sl_get(vs, k)));
      k = k + 1;
    }
    free(vs);
    return;
  }
  var names: StrList* = sl_new();
  var types: StrList* = sl_new();
  shx_fields(sl_get(ss->draws, i), names, types);
  var r: FsRead = fs_read(sl_get(ss->dfiles, i));
  var lines: StrList* = sl_new();
  if (r.ok) {
    free(lines);
    lines = s_lines(r.data);
  }
  var w: int64 = 0;
  var k: int64 = 0;
  while (k < names->len) {
    var n: int64 = slen(sl_get(names, k)) + 2 + slen(sl_get(types, k));
    if (n > w) {
      w = n;
    }
    k = k + 1;
  }
  k = 0;
  while (k < names->len) {
    var f: string = sl_get(names, k);
    var ft: string = f + ": " + sl_get(types, k);
    var doc: string = shx_field_doc(lines, s_to_int(sl_get(ss->dlines, i)), f);
    if (slen(doc) == 0) {
      say("  " + ft);
    } else {
      say("  " + s_pad_right(ft, w) + "  " + dim(doc));
    }
    k = k + 1;
  }
  free(lines);
  free(names);
  free(types);
}

// explain NAME (h NAME): a fn's signature and doc; a global's type, doc and
// value in the program; a struct's fields.
fn shx_explain(ss: ShxSess*, name: string) {
  if (slen(name) == 0) {
    error_msg("explain needs a name: explain harvest");
    return;
  }
  var found: bool = false;
  var i: int64 = 0;
  while (i < ss->dnames->len) {
    if (!s_eq(sl_get(ss->dnames, i), name)) {
      i = i + 1;
      continue;
    }
    found = true;
    var kind: string = sl_get(ss->dkinds, i);
    var at: string = shx_where(ss, sl_get(ss->dfiles, i), sl_get(ss->dlines, i));
    if (s_eq(kind, "struct") || s_eq(kind, "enum")) {
      say(kind + " " + name + "  " + dim(at));
    } else {
      say(sl_get(ss->dsigs, i) + "  " + dim(at));
    }
    shx_say_doc(ss, i);
    if (s_eq(kind, "struct") || s_eq(kind, "enum")) {
      shx_say_body(ss, i);
    } else if (s_eq(kind, "var") || s_eq(kind, "const")) {
      shx_value(ss, name);
    }
    i = i + 1;
  }
  if (!found) {
    var sug: string = man_suggest(name, ss->dnames);
    if (slen(sug) > 0) {
      error_msg("no " + name + " in this project or its packages; did you mean " + sug + "?");
    } else {
      error_msg("no " + name + " in this project or its packages");
    }
  }
}

// A global's value, from the program.
fn shx_value(ss: ShxSess*, name: string) {
  if (!ss->local && !sys_pid_alive(ss->pid)) {
    say("  = ?  " + dim("(the program has exited)"));
    return;
  }
  ss->lead = "  = ";
  shx_eval(ss, name);
  ss->lead = s_empty();
}

fn shx_inspect(ss: ShxSess*, expr: string) {
  var t: string = s_empty();
  if (sl_has(ss->tnames, expr)) {
    t = expr;
  } else {
    t = shx_type_of(ss, expr, false);
    fs_write(ss->hook, shx_hook_text(ss, ""));
    if (slen(t) == 0) {
      return;
    }
  }
  var base_t: string = t;
  if (s_ends(base_t, "*")) {
    base_t = s_sub(base_t, 0, slen(base_t) - 1);
  }
  var at: int64 = sl_index(ss->tnames, base_t);
  if (at < 0) {
    say(t);
    return;
  }
  say(t + "  " + dim("struct, " + shx_where(ss, sl_get(ss->tfiles, at), sl_get(ss->tlines, at))));
  var names: StrList* = sl_new();
  var types: StrList* = sl_new();
  shx_fields(sl_get(ss->tsigs, at), names, types);
  var i: int64 = 0;
  while (i < names->len) {
    say("  " + sl_get(names, i) + ": " + sl_get(types, i));
    i = i + 1;
  }
  free(names);
  free(types);
}

fn shx_help(ss: ShxSess*) {
  say(bold("evaluate"));
  say("  EXPR                its value: world.pop + 1");
  say("  STATEMENT;          runs it: world.food = 1000;");
  say(bold("pause"));
  say("  pause, resume       stop the program at its next shell_point(), go on: Ctrl-P in the TUI");
  say("  step                one tick: on to the next shell_point(), paused again: Ctrl-N");
  say("  pause when EXPR     pause where EXPR turns true: pause when world.food < 50");
  say("  status              running or paused, the tick, patches, the pause-when condition");
  say("  watch [EXPR]        EXPR's value at every tick; no EXPR: the values: watch world.pop * 2");
  say("  unwatch EXPR        stop watching it");
  say(bold("change code"));
  say("  fn NAME(...) {{}     redefines NAME, kept until undo: fn harvest(pop: int32) -> int32 {{ return pop * 3; }");
  say("  edit NAME           NAME in $EDITOR (vi), patched in when saved: edit harvest");
  say("  undo [NAME]         takes back the last change (r or a redefinition), or NAME's");
  say("  r                   patches in the files on disk");
  say(bold("discover"));
  say("  ls [FILE]           functions, globals and structs by file: ls rules");
  say("  apropos TEXT        names and doc comments with TEXT: apropos food");
  say("  explain NAME, h     signature and doc; a global's value, a struct's fields: explain world");
  say("  i EXPR              type, and the fields of a struct: i &world");
  say(bold("output"));
  say("  :log [N]            the program's last N output lines (20): :log 5");
  say("  :unmute, :mute      stream the program's output above the prompt, hold it again");
  say(bold("session"));
  say("  help                this");
  say("  :q, Ctrl-D          quit (and stop the program); Ctrl-C clears the line, tab completes");
  if (ss->local) {
    say("--local: each input runs in a new program that imports what the entry imports; var statements are replayed before each input.");
  } else {
    say("inputs run at the program's next shell_point(); while paused they run at once. globals and functions are in scope, locals of running functions are not. a pause stops the thread that calls shell_point(); the program's other threads keep running.");
  }
}

// :log [N]: the program's last N lines, shown or held.
fn shx_log(ss: ShxSess*, arg: string) {
  var n: int64 = 20;
  if (slen(arg) > 0) {
    if (!s_is_int(arg) || s_to_int(arg) <= 0) {
      error_msg(":log takes a number of lines: :log 50");
      return;
    }
    n = s_to_int(arg);
  }
  if (ss->fd < 0) {
    say("no program output here");
    return;
  }
  shx_relay(ss);
  if (ss->log->len == 0) {
    say("no output yet");
    return;
  }
  var i: int64 = ss->log->len - n;
  if (i < 0) {
    i = 0;
  }
  while (i < ss->log->len) {
    say(sl_get(ss->log, i));
    i = i + 1;
  }
  ss->held = 0;
}

fn shx_mute(ss: ShxSess*, on: bool) {
  shx_relay(ss);
  ss->muted = on;
  ss->held = 0;
  if (on) {
    say("holding the program's output; :log shows it, :unmute streams it");
  } else {
    say("streaming the program's output; :mute holds it");
  }
}

// Before a prompt: one dim line for the output held since the last one.
fn shx_notice(ss: ShxSess*) {
  shx_relay(ss);
  if (ss->held <= 0) {
    return;
  }
  var msg: string = "  (" + s_int(ss->held) + " new lines held, :log)";
  if (ss->held == 1) {
    msg = "  (1 new line held, :log)";
  }
  ss->held = 0;
  var d: string = dim(msg);
  say(d);
  flush_out();
}

// The program ended: its last 5 lines and its exit code.
fn shx_exited(ss: ShxSess*) -> bool {
  return !ss->local && ss->pid > 0 && !sys_pid_alive(ss->pid);
}

fn shx_report_exit(ss: ShxSess*) {
  ss->ended = true;
  var code: string = "?";
  var start: int64 = sys_now_ms();
  while (sys_now_ms() - start < 1000) {
    var r: FsRead = fs_read(ss->exitf);
    if (r.ok && s_ends(r.data, "\n")) {
      code = s_trim(r.data);
      break;
    }
    sys_sleep_ms(10);
  }
  sys_sleep_ms(60);
  ss->pend_ms = 0;
  shx_relay(ss);
  if (ss->pend->len > 0) {
    sl_push(ss->log, s_dup(buf_str(ss->pend)));
    ss->pend->len = 0;
  }
  if (ss->serve) {
    shx_send_status(ss, true);
    shx_ctl_line(29, "exit " + code);
    return;
  }
  if (ss->tty) {
    print("\r" + g_esc + "[K");
  }
  var i: int64 = ss->log->len - 5;
  if (i < 0) {
    i = 0;
  }
  while (i < ss->log->len) {
    say(sl_get(ss->log, i));
    i = i + 1;
  }
  var msg: string = "  the program exited with code " + code;
  say(dim(msg));
  flush_out();
}

// ---------------------------------------------------------------------------
// Pause, step, watch, edit
// ---------------------------------------------------------------------------

// The program's state file read into ss (tick, paused); its text.
fn shx_state(ss: ShxSess*) -> string {
  var r: FsRead = fs_read(ss->statef);
  if (!r.ok) {
    return s_empty();
  }
  var lines: StrList* = s_lines(r.data);
  defer free(lines);
  var i: int64 = 0;
  while (i < lines->len) {
    var l: string = sl_get(lines, i);
    i = i + 1;
    if (s_starts(l, "tick ")) {
      ss->tick = s_to_int(s_from(l, 5));
    } else if (s_starts(l, "paused ")) {
      ss->paused = s_eq(s_from(l, 7), "1");
    }
  }
  ss->why = "user";
  var pr: FsRead = fs_read(ss->pausef);
  if (pr.ok && s_starts(pr.data, "when")) {
    ss->why = "when";
  }
  return r.data;
}

// Up to the timeout for the state to show paused (want) at a tick past
// after (-1: any); false, with the reason shown, when it doesn't.
fn shx_await(ss: ShxSess*, want: bool, after: int64) -> bool {
  var start: int64 = sys_now_ms();
  while (sys_now_ms() - start < ss->timeout) {
    shx_relay(ss);
    shx_state(ss);
    if (ss->paused == want && ss->tick > after) {
      return true;
    }
    if (!sys_pid_alive(ss->pid)) {
      error_msg("the program has exited");
      return false;
    }
    sys_sleep_ms(5);
  }
  error_msg("no answer in " + s_int(ss->timeout / 1000) + "s: the program never reached shell_point()");
  err_line("  " + cyan("help") + ": call `shell_point();` (import \"mbuild/shell\") next to its `quiesce;`");
  return false;
}

fn shx_live_only(ss: ShxSess*, what: string) -> bool {
  if (ss->local) {
    error_msg(what + " needs a running program; --local has none");
    return false;
  }
  if (!sys_pid_alive(ss->pid)) {
    error_msg("the program has exited");
    return false;
  }
  return true;
}

fn shx_status_text(ss: ShxSess*) -> string {
  shx_state(ss);
  var st: string = "running · tick " + s_int(ss->tick);
  if (!sys_pid_alive(ss->pid)) {
    st = "stopped · tick " + s_int(ss->tick);
  } else if (ss->paused) {
    st = "paused at tick " + s_int(ss->tick);
  }
  var n: int64 = ss->gids->len;
  var pl: string = " patches";
  if (n == 1) {
    pl = " patch";
  }
  st = st + " · " + s_int(n) + pl;
  if (slen(ss->cond) > 0) {
    st = st + " · pause when " + ss->cond;
  }
  return st;
}

fn shx_pause(ss: ShxSess*) {
  if (!shx_live_only(ss, "pause")) {
    return;
  }
  shx_state(ss);
  if (ss->paused) {
    say("already paused at tick " + s_int(ss->tick));
    return;
  }
  fs_write(ss->pausef, "user\n");
  if (shx_await(ss, true, -1)) {
    say("paused at tick " + s_int(ss->tick));
  } else {
    sys_remove_file(ss->pausef);
  }
}

fn shx_resume(ss: ShxSess*) {
  if (!shx_live_only(ss, "resume")) {
    return;
  }
  shx_state(ss);
  if (!ss->paused && !fs_exists(ss->pausef)) {
    say("not paused");
    return;
  }
  sys_remove_file(ss->stepf);
  sys_remove_file(ss->pausef);
  var at: int64 = ss->tick;
  if (shx_await(ss, false, at)) {
    say("running from tick " + s_int(at));
  }
}

fn shx_step(ss: ShxSess*) {
  if (!shx_live_only(ss, "step")) {
    return;
  }
  shx_state(ss);
  if (!ss->paused) {
    error_msg("not paused; pause first (Ctrl-P in the TUI)");
    return;
  }
  var at: int64 = ss->tick;
  fs_write(ss->stepf, "1\n");
  if (shx_await(ss, true, at)) {
    say("paused at tick " + s_int(ss->tick));
  }
}

// The watch list (and pause-when) into the hook, patched in to stay.
fn shx_rewatch(ss: ShxSess*) -> bool {
  var r: Captured;
  if (!shx_compile(ss, "", false, &r)) {
    shx_show_errors(r.out);
    return false;
  }
  // until the program writes the new list (the next tick, or 100 ms paused)
  var start: int64 = sys_now_ms();
  while (sys_now_ms() - start < 2000 && sys_pid_alive(ss->pid)) {
    var vals: StrList* = shx_watch_lines(ss);
    var same: bool = vals->len == ss->wnames->len;
    var i: int64 = 0;
    while (same && i < vals->len) {
      var want: string = sl_get(ss->wnames, i) + "\t";
      same = s_starts(sl_get(vals, i), want);
      i = i + 1;
    }
    free(vals);
    if (same) {
      break;
    }
    shx_relay(ss);
    sys_sleep_ms(5);
  }
  return true;
}

fn shx_watch(ss: ShxSess*, expr: string) {
  if (slen(expr) == 0) {
    shx_watches(ss);
    return;
  }
  if (!shx_live_only(ss, "watch")) {
    return;
  }
  if (sl_has(ss->wnames, expr)) {
    say("already watching " + expr);
    return;
  }
  var t: string = shx_type_of(ss, expr, false);
  fs_write(ss->hook, shx_hook_text(ss, ""));
  if (slen(t) == 0) {
    return;
  }
  if (s_eq(t, "void")) {
    error_msg(expr + " has no value to watch");
    return;
  }
  sl_push(ss->wnames, expr);
  sl_push(ss->wtypes, t);
  if (!shx_rewatch(ss)) {
    sl_remove_at(ss->wnames, ss->wnames->len - 1);
    sl_remove_at(ss->wtypes, ss->wtypes->len - 1);
    fs_write(ss->hook, shx_hook_text(ss, ""));
    return;
  }
  say("watching " + expr);
}

fn shx_unwatch(ss: ShxSess*, expr: string) {
  var at: int64 = sl_index(ss->wnames, expr);
  if (at < 0) {
    error_msg("not watching " + expr + "; watch lists them");
    return;
  }
  sl_remove_at(ss->wnames, at);
  var t: string = sl_get(ss->wtypes, at);
  sl_remove_at(ss->wtypes, at);
  if (!ss->local && !shx_rewatch(ss)) {
    sl_push(ss->wnames, expr);
    sl_push(ss->wtypes, t);
    return;
  }
  say("unwatched " + expr);
}

// The watch values the program wrote last: NAME\tVALUE lines.
fn shx_watch_lines(ss: ShxSess*) -> StrList* {
  var out: StrList* = sl_new();
  var lines: StrList* = s_lines(shx_state(ss));
  defer free(lines);
  var i: int64 = 0;
  while (i < lines->len) {
    var l: string = sl_get(lines, i);
    if (s_starts(l, "w ")) {
      sl_push(out, s_from(l, 2));
    }
    i = i + 1;
  }
  return out;
}

fn shx_watches(ss: ShxSess*) {
  if (ss->wnames->len == 0) {
    say("watching nothing; watch EXPR adds one");
    return;
  }
  var vals: StrList* = shx_watch_lines(ss);
  defer free(vals);
  var i: int64 = 0;
  while (i < ss->wnames->len) {
    var n: string = sl_get(ss->wnames, i);
    var v: string = "?";
    var k: int64 = 0;
    while (k < vals->len) {
      var l: string = sl_get(vals, k);
      var tab: int64 = s_find_byte(l, 9);
      if (tab >= 0 && s_eq(s_sub(l, 0, tab), n)) {
        v = s_from(l, tab + 1);
      }
      k = k + 1;
    }
    say(n + " = " + v);
    i = i + 1;
  }
}

// pause when [EXPR]: the program pauses at the shell_point where EXPR turns true.
fn shx_pause_when(ss: ShxSess*, expr: string) {
  if (!shx_live_only(ss, "pause when")) {
    return;
  }
  var was: string = ss->cond;
  if (slen(expr) == 0) {
    if (slen(was) == 0) {
      say("no pause-when condition");
      return;
    }
    ss->cond = s_empty();
    if (shx_rewatch(ss)) {
      say("cleared: pause when " + was);
    } else {
      ss->cond = was;
    }
    return;
  }
  var t: string = shx_type_of(ss, expr, false);
  fs_write(ss->hook, shx_hook_text(ss, ""));
  if (slen(t) == 0) {
    return;
  }
  if (!s_eq(t, "bool")) {
    error_msg("pause when needs a bool, " + expr + " is " + t);
    return;
  }
  ss->cond = expr;
  if (!shx_rewatch(ss)) {
    ss->cond = was;
    fs_write(ss->hook, shx_hook_text(ss, ""));
    return;
  }
  say("will pause when " + expr);
}

// edit NAME: NAME's source in $EDITOR (vi when unset), patched in when it
// changed. In serve mode the editor gets the terminal.
fn shx_edit_fn(ss: ShxSess*, name: string) {
  if (slen(name) == 0) {
    error_msg("edit needs a function: edit harvest");
    return;
  }
  if (ss->local) {
    error_msg("edit needs a running program; --local has none");
    return;
  }
  var sp: ShxSpan = shx_find_fn(ss, name);
  if (slen(sp.file) == 0) {
    error_msg("no function " + name + " in this program; ls lists them");
    return;
  }
  var dir: string = ss->dir + "/edit";
  fs_mkdirs(dir);
  var path: string = dir + "/" + name + ".mettle";
  fs_write(path, sp.text + "\n");
  var line: string = "${{EDITOR:-vi} " + sh_quote(path);
  if (ss->serve) {
    line = line + " </dev/tty >/dev/tty 2>&1";
  }
  var c: Cmd* = cmd_new(shx_tool("/bin/sh"));
  defer free(c);
  cmd_arg(c, "-c");
  cmd_arg(c, line);
  flush_out();
  var code: int32 = sys_run(c);
  var r: FsRead = fs_read(path);
  if (code != 0 || !r.ok) {
    error_msg("the editor stopped with code " + s_int(code) + "; nothing patched");
    return;
  }
  var text: string = s_trim(r.data);
  if (s_eq(text, s_trim(sp.text))) {
    say("no changes to " + name);
    return;
  }
  shx_define(ss, text);
}

// ---------------------------------------------------------------------------
// Requests from mbuild-shell (any mode; answers one per line)
// ---------------------------------------------------------------------------

fn shx_is_project(ss: ShxSess*, f: string) -> bool {
  return sl_has(ss->sb->files, f);
}

fn shx_patched(ss: ShxSess*, name: string) -> bool {
  return sl_has(ss->gnames, name);
}

// :decls: KIND\tNAME\tFILE:LINE\tpatched|"" for the project's declarations.
fn shx_decls(ss: ShxSess*) {
  var i: int64 = 0;
  while (i < ss->dnames->len) {
    var f: string = sl_get(ss->dfiles, i);
    var k: string = sl_get(ss->dkinds, i);
    if (shx_is_project(ss, f) && (s_eq(k, "fn") || s_eq(k, "struct") || s_eq(k, "enum") || s_eq(k, "var"))) {
      var n: string = sl_get(ss->dnames, i);
      var mark: string = s_empty();
      if (shx_patched(ss, n)) {
        mark = "patched";
      }
      say(k + "\t" + n + "\t" + shx_where(ss, f, sl_get(ss->dlines, i)) + "\t" + mark);
    }
    i = i + 1;
  }
}

// :source NAME: FILE:LINE, the current text, then per patch (newest first)
// "@@ patched at tick N, was:" and the text it replaced.
fn shx_source(ss: ShxSess*, name: string) {
  var sp: ShxSpan = shx_find_fn(ss, name);
  if (slen(sp.file) > 0) {
    var orig: string = ss->sb->p->root + "/" + p_rel(ss->tree, sp.file);
    say(shx_where(ss, orig, s_int(sp.line)));
    say(sp.text);
  } else {
    var i: int64 = sl_index(ss->dnames, name);
    if (i < 0) {
      error_msg("no " + name + " in this program");
      return;
    }
    say(shx_where(ss, sl_get(ss->dfiles, i), sl_get(ss->dlines, i)));
    say(sl_get(ss->dsigs, i));
    shx_say_body(ss, i);
    return;
  }
  var k: int64 = ss->gids->len - 1;
  while (k >= 0) {
    if (s_eq(sl_get(ss->gnames, k), name)) {
      var was: string = sl_get(ss->gold, k);
      if (slen(was) == 0) {
        say("@@ added at tick " + sl_get(ss->gticks, k));
      } else {
        say("@@ patched at tick " + sl_get(ss->gticks, k) + ", was:");
        say(was);
      }
    }
    k = k - 1;
  }
}

// :fields EXPR: "\tTYPE\tVALUE" for EXPR, then NAME\tTYPE\tVALUE\tCHILD for
// each field of a struct (or of the struct a pointer points to); CHILD is
// the expression to expand it by, "" when it has no fields.
fn shx_fields_cmd(ss: ShxSess*, expr: string) {
  if (!shx_live_only(ss, "inspect")) {
    return;
  }
  var t: string = shx_type_of(ss, expr, false);
  if (slen(t) == 0) {
    fs_write(ss->hook, shx_hook_text(ss, ""));
    return;
  }
  var base_t: string = t;
  var arrow: string = ".";
  if (s_ends(t, "*")) {
    base_t = s_sub(t, 0, slen(t) - 1);
    arrow = "->";
  }
  var b: Buf* = buf_new();
  buf_add(b, "\"\\t" + t + "\\t\" + " + shx_fmt(ss, t, "_v", true));
  var at: int64 = sl_index(ss->tnames, base_t);
  if (at >= 0) {
    var names: StrList* = sl_new();
    var types: StrList* = sl_new();
    shx_fields(sl_get(ss->tsigs, at), names, types);
    var i: int64 = 0;
    while (i < names->len) {
      var fname: string = sl_get(names, i);
      var ft: string = sl_get(types, i);
      var child: string = s_empty();
      var fb: string = ft;
      if (s_ends(fb, "*")) {
        fb = s_sub(fb, 0, slen(fb) - 1);
      }
      if (sl_has(ss->tnames, fb)) {
        child = "(" + expr + ")" + arrow + fname;
      }
      var acc: string = "_v" + arrow + fname;
      buf_add(b, " + \"\\n" + fname + "\\t" + ft + "\\t\" + " + shx_fmt(ss, ft, acc, true) + " + \"\\t\" + " + shx_lit(child));
      i = i + 1;
    }
    free(names);
    free(types);
  }
  var result: string = buf_take(b);
  if (s_ends(t, "*")) {
    // a null pointer has no fields to read
    shx_run(ss, "  var _v = (" + expr + ");\n  if (_v == (" + t + ")0) {{\n    mbsh_put(" + shx_lit(ss->out + "/" + s_int(ss->seq + 1)) + ", \"\\t" + t + "\\tnull\");\n    return;\n  }\n", result);
    return;
  }
  shx_run(ss, "  var _v = (" + expr + ");\n", result);
}

// One input; false to quit.
fn shx_input(ss: ShxSess*, line: string) -> bool {
  var t: string = s_trim(line);
  if (slen(t) == 0) {
    return true;
  }
  if (s_eq(t, ":q") || s_eq(t, ":quit")) {
    return false;
  }
  if (s_eq(t, "help") || s_eq(t, ":h") || s_eq(t, "?")) {
    shx_help(ss);
  } else if (s_eq(t, "r")) {
    shx_reload(ss);
  } else if (s_eq(t, "undo") || s_starts(t, "undo ")) {
    shx_undo(ss, s_trim(s_from(t, 4)));
  } else if (s_eq(t, "pause") || s_eq(t, ":pause")) {
    shx_pause(ss);
  } else if (s_eq(t, "resume") || s_eq(t, ":resume")) {
    shx_resume(ss);
  } else if (s_eq(t, "step") || s_eq(t, ":step")) {
    shx_step(ss);
  } else if (s_eq(t, "pause when") || s_starts(t, "pause when ")) {
    shx_pause_when(ss, s_trim(s_from(t, 10)));
  } else if (s_eq(t, "status")) {
    say(shx_status_text(ss));
  } else if (s_eq(t, "watch") || s_starts(t, "watch ")) {
    shx_watch(ss, s_trim(s_from(t, 5)));
  } else if (s_starts(t, "unwatch ")) {
    shx_unwatch(ss, s_trim(s_from(t, 7)));
  } else if (s_starts(t, "edit ")) {
    shx_edit_fn(ss, s_trim(s_from(t, 4)));
  } else if (s_eq(t, ":decls")) {
    shx_decls(ss);
  } else if (s_starts(t, ":source ")) {
    shx_source(ss, s_trim(s_from(t, 7)));
  } else if (s_starts(t, ":fields ")) {
    shx_fields_cmd(ss, s_trim(s_from(t, 7)));
  } else if (s_eq(t, "ls") || s_starts(t, "ls ")) {
    shx_ls(ss, s_trim(s_from(t, 2)));
  } else if (s_eq(t, "apropos") || s_starts(t, "apropos ")) {
    shx_apropos(ss, s_trim(s_from(t, 7)));
  } else if (s_eq(t, "explain") || s_starts(t, "explain ")) {
    shx_explain(ss, s_trim(s_from(t, 7)));
  } else if (s_starts(t, "h ")) {
    shx_explain(ss, s_trim(s_from(t, 2)));
  } else if (s_eq(t, ":mute")) {
    shx_mute(ss, true);
  } else if (s_eq(t, ":unmute")) {
    shx_mute(ss, false);
  } else if (s_eq(t, ":log") || s_starts(t, ":log ")) {
    shx_log(ss, s_trim(s_from(t, 4)));
  } else if (s_starts(t, "i ")) {
    shx_inspect(ss, s_trim(s_from(t, 2)));
  } else if (s_starts(t, "fn ") || s_starts(t, "export fn ")) {
    shx_define(ss, t);
  } else {
    shx_eval(ss, t);
  }
  flush_out();
  return true;
}

// ---------------------------------------------------------------------------
// Reading lines: a small editor on a terminal, plain reads otherwise
// ---------------------------------------------------------------------------

fn shx_word_start(line: string, at: int64) -> int64 {
  var k: int64 = at;
  while (k > 0 && is_ident_b(s_byte(line, k - 1))) {
    k = k - 1;
  }
  return k;
}

// The program's new output: its whole lines into the log, and the text to
// show (none while muted). A line it leaves unended shows after 300 ms.
fn shx_take(ss: ShxSess*) -> string {
  if (ss->fd < 0) {
    return s_empty();
  }
  if (sys_fd_drain(ss->fd, ss->pend) > 0) {
    ss->pend_ms = sys_now_ms();
  }
  if (ss->pend->len == 0) {
    return s_empty();
  }
  var data: string = buf_str(ss->pend);
  var end: int64 = slen(data);
  while (end > 0 && s_byte(data, end - 1) != 10) {
    end = end - 1;
  }
  if (end == 0) {
    if (sys_now_ms() - ss->pend_ms < 300) {
      return s_empty();
    }
    end = slen(data);
  }
  var text: string = s_dup(s_sub(data, 0, end));
  var rest: string = s_dup(s_from(data, end));
  ss->pend->len = 0;
  buf_add(ss->pend, rest);
  var lines: StrList* = s_lines(text);
  sl_extend(ss->log, lines);
  if (ss->log->len > 2000) {
    var kept: StrList* = sl_new();
    var i: int64 = ss->log->len - 1000;
    while (i < ss->log->len) {
      sl_push(kept, sl_get(ss->log, i));
      i = i + 1;
    }
    ss->log = kept;
  }
  var n: int64 = lines->len;
  free(lines);
  if (ss->muted) {
    ss->held = ss->held + n;
    return s_empty();
  }
  return text;
}

// New program output, shown; true when there was some.
fn shx_relay(ss: ShxSess*) -> bool {
  var text: string = shx_take(ss);
  if (slen(text) == 0) {
    return false;
  }
  if (!s_ends(text, "\n")) {
    text = text + "\n";
  }
  if (ss->serve) {
    var lines: StrList* = s_lines(text);
    var i: int64 = 0;
    while (i < lines->len) {
      shx_ctl_line(31, sl_get(lines, i));
      i = i + 1;
    }
    free(lines);
  } else if (ss->tty) {
    print("\r" + g_esc + "[K" + text);
  } else {
    print(text);
  }
  flush_out();
  return true;
}

// A line for mbuild-shell: control byte c, then text (31 program output,
// 30 an answer ends, 29 status).
fn shx_ctl_line(c: int32, text: string) {
  var b: Buf* = buf_new();
  buf_addb(b, c);
  buf_add(b, text);
  buf_addb(b, 10);
  print(buf_take(b));
  flush_out();
}

// Status for mbuild-shell when it changed (or always): "s" key=value line
// (cond last), then "W" and a "w NAME\tVALUE" per watch.
fn shx_send_status(ss: ShxSess*, always: bool) {
  var st: string = shx_state(ss);
  var alive: string = "1";
  if (!sys_pid_alive(ss->pid) && !ss->local) {
    alive = "0";
  }
  var paused: string = "0";
  if (ss->paused) {
    paused = "1";
  }
  var line: string = "s tick=" + s_int(ss->tick) + " paused=" + paused + " why=" + ss->why + " alive=" + alive + " patches=" + s_int(ss->gids->len) + " cond=" + ss->cond;
  var all: string = line + "\n" + st;
  if (!always && s_eq(all, ss->sent)) {
    return;
  }
  ss->sent = all;
  shx_ctl_line(29, line);
  shx_ctl_line(29, "W");
  var vals: StrList* = shx_watch_lines(ss);
  var i: int64 = 0;
  while (i < vals->len) {
    shx_ctl_line(29, "w " + sl_get(vals, i));
    i = i + 1;
  }
  free(vals);
}

// The project's globals, watched from the start.
fn shx_default_watches(ss: ShxSess*) {
  if (ss->local) {
    return;
  }
  var i: int64 = 0;
  while (i < ss->dnames->len) {
    if (s_eq(sl_get(ss->dkinds, i), "var") && shx_is_project(ss, sl_get(ss->dfiles, i)) && slen(sl_get(ss->draws, i)) > 0 && !sl_has(ss->wnames, sl_get(ss->dnames, i))) {
      sl_push(ss->wnames, sl_get(ss->dnames, i));
      sl_push(ss->wtypes, sl_get(ss->draws, i));
    }
    i = i + 1;
  }
}

fn shx_redraw(prompt: string, line: string, at: int64) {
  print(shx_term_line(prompt, line, at));
  flush_out();
}

// The commands, for tab on the first word.
fn shx_commands() -> StrList* {
  return s_split("help ls apropos explain undo pause resume step status watch unwatch edit :mute :unmute :log :q", 32);
}

// Names for tab: completes the word before the cursor, or lists the choices.
fn shx_complete(ss: ShxSess*, line: string, at: int64*) -> string {
  var from: int64 = shx_word_start(line, *at);
  if (from == 1 && s_byte(line, 0) == 58) {
    from = 0;
  }
  var word: string = s_sub(line, from, *at);
  if (slen(word) == 0) {
    return line;
  }
  var pool: StrList* = ss->dnames;
  if (from > 0 && s_byte(line, from - 1) == 46) {
    pool = ss->fields;
  } else if (from == 0) {
    pool = shx_commands();
    sl_extend(pool, ss->dnames);
  }
  var cands: StrList* = sl_new();
  defer free(cands);
  var i: int64 = 0;
  while (i < pool->len) {
    var n: string = sl_get(pool, i);
    if (s_starts(n, word)) {
      sl_add_uniq(cands, n);
    }
    i = i + 1;
  }
  if (cands->len == 0) {
    return line;
  }
  var common: string = sl_get(cands, 0);
  i = 1;
  while (i < cands->len) {
    var c: string = sl_get(cands, i);
    var k: int64 = 0;
    while (k < slen(common) && k < slen(c) && s_byte(common, k) == s_byte(c, k)) {
      k = k + 1;
    }
    common = s_sub(common, 0, k);
    i = i + 1;
  }
  if (slen(common) > slen(word)) {
    var added: string = s_from(common, slen(word));
    if (from == 0 && cands->len == 1 && sl_has(shx_commands(), common)) {
      added = added + " ";
    }
    var next: string = s_sub(line, 0, *at) + added + s_from(line, *at);
    *at = *at + slen(added);
    return next;
  }
  if (cands->len > 1) {
    sl_sort(cands);
    say("");
    say(sl_join(cands, "  "));
  }
  return line;
}

// One line from the terminal in raw mode; *eof at Ctrl-D on an empty line.
fn shx_edit(ss: ShxSess*, prompt: string, eof: bool*) -> string {
  var line: string = s_empty();
  var at: int64 = 0;
  var h: int64 = ss->hist->len;
  *eof = false;
  shx_notice(ss);
  print(prompt);
  flush_out();
  while (true) {
    while (true) {
      var w: int32 = sys_wait_input(ss->fd, 100);
      var text: string = shx_take(ss);
      if (slen(text) > 0) {
        print(shx_term_above(prompt, line, at, text));
        flush_out();
      }
      if (shx_exited(ss)) {
        *eof = true;
        shx_report_exit(ss);
        return s_empty();
      }
      if ((w & 1) != 0) {
        break;
      }
    }
    var c: int32 = sys_read_byte();
    if (c == -2) {
      continue;
    }
    if (c < 0 || (c == 4 && slen(line) == 0)) {
      *eof = true;
      say("");
      return line;
    }
    if (c == 13 || c == 10) {
      say("");
      return line;
    }
    if (c == 3) {
      say("^C");
      line = s_empty();
      at = 0;
      print(prompt);
      flush_out();
      continue;
    }
    if (c == 127 || c == 8) {
      if (at > 0) {
        line = s_sub(line, 0, at - 1) + s_from(line, at);
        at = at - 1;
      }
    } else if (c == 1) {
      at = 0;
    } else if (c == 5) {
      at = slen(line);
    } else if (c == 21) {
      line = s_from(line, at);
      at = 0;
    } else if (c == 11) {
      line = s_sub(line, 0, at);
    } else if (c == 9) {
      line = shx_complete(ss, line, &at);
    } else if (c == 27) {
      var c1: int32 = sys_read_byte();
      var c2: int32 = sys_read_byte();
      if (c1 == 91 && c2 >= 48 && c2 <= 57) {
        sys_read_byte();
        if (c2 == 51 && at < slen(line)) {
          line = s_sub(line, 0, at) + s_from(line, at + 1);
        } else if (c2 == 49) {
          at = 0;
        } else if (c2 == 52) {
          at = slen(line);
        }
      } else if (c1 == 91 || c1 == 79) {
        if (c2 == 65 && h > 0) {
          h = h - 1;
          line = sl_get(ss->hist, h);
          at = slen(line);
        } else if (c2 == 66 && h < ss->hist->len) {
          h = h + 1;
          line = s_empty();
          if (h < ss->hist->len) {
            line = sl_get(ss->hist, h);
          }
          at = slen(line);
        } else if (c2 == 67 && at < slen(line)) {
          at = at + 1;
        } else if (c2 == 68 && at > 0) {
          at = at - 1;
        } else if (c2 == 72) {
          at = 0;
        } else if (c2 == 70) {
          at = slen(line);
        }
      }
    } else if (c >= 32) {
      var ch: Buf* = buf_new();
      buf_addb(ch, c);
      line = s_sub(line, 0, at) + buf_take(ch) + s_from(line, at);
      at = at + 1;
    }
    shx_redraw(prompt, line, at);
  }
  return line;
}

// A line from a pipe; the program's output relayed while none comes, the
// prompt shown once one does.
fn shx_read_plain(ss: ShxSess*, prompt: string, eof: bool*) -> string {
  var b: Buf* = buf_new();
  *eof = false;
  var c: int32 = -2;
  while (c == -2) {
    while ((sys_wait_input(ss->fd, 100) & 1) == 0) {
      shx_relay(ss);
      if (ss->serve) {
        shx_send_status(ss, false);
      }
      if (shx_exited(ss)) {
        *eof = true;
        shx_report_exit(ss);
        return buf_take(b);
      }
    }
    shx_relay(ss);
    c = sys_read_byte();
    if (c == -2) {
      sys_sleep_ms(2);
    }
  }
  if (c < 0) {
    *eof = true;
    return buf_take(b);
  }
  shx_notice(ss);
  if (!ss->serve) {
    print(prompt);
  }
  while (c != -1 && c != 10) {
    if (c >= 0 && c != 13) {
      buf_addb(b, c);
    }
    c = sys_read_byte();
    if (c == -2) {
      sys_sleep_ms(2);
    }
  }
  return buf_take(b);
}

// Open minus closed (, [ and { outside strings, comments and chars.
fn shx_depth(text: string) -> int64 {
  var d: int64 = 0;
  var i: int64 = 0;
  var q: int32 = 0;
  while (i < slen(text)) {
    var c: int32 = s_byte(text, i);
    if (q != 0) {
      if (c == 92) {
        i = i + 1;
      } else if (c == q) {
        q = 0;
      }
    } else if (c == 34 || c == 39) {
      q = c;
    } else if (c == 47 && i + 1 < slen(text) && s_byte(text, i + 1) == 47) {
      while (i < slen(text) && s_byte(text, i) != 10) {
        i = i + 1;
      }
    } else if (c == 40 || c == 91 || c == 123) {
      d = d + 1;
    } else if (c == 41 || c == 93 || c == 125) {
      d = d - 1;
    }
    i = i + 1;
  }
  return d;
}

// One input: more lines while brackets are open.
fn shx_read(ss: ShxSess*, eof: bool*) -> string {
  var prompt: string = "mettle> ";
  var text: string = s_empty();
  while (true) {
    var line: string = s_empty();
    if (ss->tty) {
      sys_term_raw();
      line = shx_edit(ss, prompt, eof);
      sys_term_cooked();
    } else {
      line = shx_read_plain(ss, prompt, eof);
      if (!*eof && !ss->serve) {
        say(line);
      }
    }
    if (*eof) {
      return text;
    }
    if (slen(text) > 0) {
      text = text + "\n" + line;
    } else {
      text = line;
    }
    if (shx_depth(text) <= 0) {
      break;
    }
    prompt = "   ...> ";
  }
  if (ss->tty && slen(s_trim(text)) > 0) {
    var flat: string = s_replace(text, "\n", " ");
    if (ss->hist->len == 0 || !s_eq(sl_get(ss->hist, ss->hist->len - 1), flat)) {
      sl_push(ss->hist, flat);
      fs_write(ss->dir + "/history", sl_join(ss->hist, "\n") + "\n");
    }
  }
  return text;
}

// ---------------------------------------------------------------------------
// The command
// ---------------------------------------------------------------------------

// The program in the background, its stdout and stderr into the FIFO, stderr
// through a grep that drops the live runtime's "[live] patch N: ..." lines
// (two per input).
// A watcher stops it if mbuild dies first (Ctrl-C while waiting).
fn shx_start(ss: ShxSess*) -> bool {
  var sb: ShellBuild* = ss->sb;
  var pidf: string = ss->dir + "/pid";
  sys_remove_file(pidf);
  sys_remove_file(ss->exitf);
  var prog: string = sh_quote(sb->exe);
  var i: int64 = 0;
  while (i < sb->p->opts->passthrough->len) {
    prog = prog + " " + sh_quote(sl_get(sb->p->opts->passthrough, i));
    i = i + 1;
  }
  var drop: string = sh_quote("^\\[live\\] patch [0-9]+(: [0-9]+ functions?| undoes patch [0-9]+)$");
  var watch: string = "(while kill -0 $mb 2>/dev/null; do sleep 1; done; kill $p 2>/dev/null) >/dev/null 2>&1 &";
  var to: string = "3>&1";
  if (ss->fd >= 0) {
    to = ">" + sh_quote(ss->fifo) + " 2>&1 3>&1";
  }
  var line: string = "mb=$PPID; ( ( " + prog + " </dev/null 2>&1 1>&3 3>&- & p=$!; echo $p > " + sh_quote(pidf) + "; " + watch + " wait $p 2>/dev/null; echo $? > " + sh_quote(ss->exitf) + " ) | grep --line-buffered -Ev " + drop + " >&2 ) " + to + " &";
  var c: Cmd* = cmd_new(shx_tool("/bin/sh"));
  defer free(c);
  cmd_arg(c, "-c");
  cmd_arg(c, line);
  c->cwd = sb->p->root;
  flush_out();
  if (sys_run(c) != 0) {
    return false;
  }
  var start: int64 = sys_now_ms();
  while (sys_now_ms() - start < 3000) {
    var r: FsRead = fs_read(pidf);
    if (r.ok && s_ends(r.data, "\n")) {
      ss->pid = s_to_int(s_trim(r.data));
      return ss->pid > 0;
    }
    sys_sleep_ms(5);
  }
  return false;
}

fn shx_stop(ss: ShxSess*) {
  if (ss->local || !sys_pid_alive(ss->pid)) {
    return;
  }
  sys_kill(ss->pid);
  var start: int64 = sys_now_ms();
  while (sys_pid_alive(ss->pid) && sys_now_ms() - start < 2000) {
    sys_sleep_ms(10);
  }
}

// The tree: the project's files, a mettle.deps that maps "mbuild/shell" to
// the hook (and the package's own name to the tree), the empty hook.
fn shx_make_tree(ss: ShxSess*) {
  var p: Project* = ss->sb->p;
  sys_remove_tree(ss->tree);
  fs_mkdirs(ss->tree);
  shx_copy_tree(ss, false);
  var deps: string = "# generated by mbuild shell\nmbuild=" + p_dir(ss->hook) + "\n";
  if (p->man != (Manifest*)0 && man_is_package_name(p->man->name)) {
    var own: string = man_import_dir(p->man, p->root);
    deps = deps + p->man->name + "=" + ss->tree + "/" + p_rel(p->root, own) + "\n";
  }
  fs_write(ss->tree + "/mettle.deps", deps);
}

// mbuild-shell, the full-screen shell: beside this mbuild, else built in a
// source checkout of mbuild above it; "" when neither.
fn shx_find_tui() -> string {
  var self: string = sys_self_exe();
  var beside: string = p_dir(self) + "/mbuild-shell";
  if (fs_exists(beside)) {
    return beside;
  }
  var d: string = p_dir(self);
  while (slen(d) > 1) {
    if (fs_exists(d + "/cmd/mbuild-shell/main.mettle") && fs_exists(d + "/lib/tui/mbuild.mettle")) {
      var built: string = d + "/build/" + sys_os() + "/debug/mbuild-shell";
      var c: Cmd* = cmd_new(shx_tool(self));
      cmd_arg(c, "build");
      cmd_arg(c, "mbuild-shell");
      cmd_arg(c, "--quiet");
      c->cwd = d;
      status("Building", "mbuild-shell (" + d + ")");
      var r: Captured = proc_capture_all(c);
      free(c);
      if (r.code != 0) {
        shx_show_errors(r.out);
      }
      if (fs_exists(built)) {
        return built;
      }
      return s_empty();
    }
    var up: string = p_dir(d);
    if (s_eq(up, d)) {
      break;
    }
    d = up;
  }
  return s_empty();
}

// On a terminal: the session runs in mbuild-shell, which starts this
// command again with --serve and talks to it through FIFOs. False (line
// mode) when there is no mbuild-shell.
fn shx_tui(p: Project*, code: int32*) -> bool {
  var exe: string = shx_find_tui();
  if (slen(exe) == 0) {
    note("no mbuild-shell beside mbuild (mbuild install puts it there); line mode");
    return false;
  }
  var c: Cmd* = cmd_new(shx_tool(exe));
  defer free(c);
  cmd_arg(c, "--dir");
  cmd_path(c, p->state_dir + "/shell");
  cmd_arg(c, "--");
  cmd_arg(c, sys_self_exe());
  var argv: StrList* = p->opts->argv;
  var put: bool = false;
  var i: int64 = 0;
  while (i < argv->len) {
    var a: string = sl_get(argv, i);
    if (s_eq(a, "--") && !put) {
      cmd_arg(c, "--serve");
      put = true;
    }
    cmd_arg(c, a);
    i = i + 1;
  }
  if (!put) {
    cmd_arg(c, "--serve");
  }
  fs_mkdirs(p->state_dir + "/shell");
  sys_term_save();
  *code = sys_run(c);
  sys_term_cooked();
  if (*code != 0) {
    // it may have died with the screen still its own
    print(g_esc + "[0m" + g_esc + "[?2004l" + g_esc + "[?25h" + g_esc + "[?1049l");
    flush_out();
  }
  return true;
}

export fn shell_cmd(p: Project*) -> int32 {
  if (!s_eq(sys_os(), "linux")) {
    fail("mbuild shell runs on Linux only for now");
  }
  var ss: ShxSess* = new ShxSess;
  defer free(ss);
  ss->local = sl_has(p->opts->rest, "--local");
  ss->serve = sl_has(p->opts->rest, "--serve");
  if (!ss->serve && !sl_has(p->opts->rest, "--plain") && sys_isatty(0) && sys_isatty(1)) {
    var code: int32 = 0;
    if (shx_tui(p, &code)) {
      return code;
    }
  }
  ss->sb = build_shell_open(p);
  ss->dir = p->state_dir + "/shell";
  ss->tree = ss->dir + "/tree";
  ss->out = ss->dir + "/out";
  ss->seq = 0;
  ss->pid = 0;
  ss->timeout = 5000;
  var tm: string = env_get("MBUILD_SHELL_TIMEOUT");
  if (s_is_int(tm) && s_to_int(tm) > 0) {
    ss->timeout = s_to_int(tm);
  }
  ss->ufiles = sl_new();
  ss->utexts = sl_new();
  ss->ugroups = sl_new();
  ss->ngroups = 0;
  ss->binds = sl_new();
  ss->defs = sl_new();
  ss->hist = sl_new();
  ss->tty = sys_isatty(0) && sys_isatty(1);
  ss->fifo = ss->dir + "/output";
  ss->fd = -1;
  ss->pend = buf_new();
  ss->pend_ms = 0;
  ss->log = sl_new();
  ss->muted = !sl_has(p->opts->rest, "--stream");
  ss->held = 0;
  ss->exitf = ss->dir + "/exit";
  ss->ended = false;
  ss->lead = s_empty();
  ss->gids = sl_new();
  ss->gnames = sl_new();
  ss->gfiles = sl_new();
  ss->gold = sl_new();
  ss->gticks = sl_new();
  ss->wnames = sl_new();
  ss->wtypes = sl_new();
  ss->cond = s_empty();
  ss->pausef = ss->dir + "/pause";
  ss->stepf = ss->dir + "/step";
  ss->statef = ss->dir + "/state";
  ss->tick = 0;
  ss->paused = false;
  ss->why = "user";
  ss->sent = s_empty();
  if (ss->serve) {
    ss->tty = false;
    ss->muted = false;
  }
  sys_remove_file(ss->pausef);
  sys_remove_file(ss->stepf);
  sys_remove_file(ss->statef);
  sys_remove_tree(ss->out);
  fs_mkdirs(ss->out);
  if (!ss->local) {
    ss->fd = sys_fifo_open(ss->fifo);
  }
  if (ss->tty) {
    var hr: FsRead = fs_read(ss->dir + "/history");
    if (hr.ok) {
      ss->hist = s_lines(hr.data);
    }
  }
  shx_scan(ss);
  shx_default_watches(ss);
  if (ss->local) {
    ss->hook = ss->dir + "/local/snippet.mettle";
    ss->entry = ss->hook;
    fs_mkdirs(ss->dir + "/local");
    if (!g_quiet) {
      say("mbuild shell --local: " + ss->sb->label + "; help for help, :q to leave");
    }
  } else {
    ss->hook = ss->dir + "/gen/mbuild/shell.mettle";
    ss->entry = shx_tree_path(ss, ss->sb->entry);
    shx_make_tree(ss);
    fs_write(ss->hook, shx_hook_text(ss, ""));
    status("Compiling", ss->sb->label);
    var c: Cmd* = shx_cmd(ss);
    cmd_arg(c, "--build");
    cmd_arg(c, "--live");
    cmd_path(c, ss->entry);
    shx_flags(ss, c);
    cmd_arg(c, "-o");
    cmd_path(c, ss->sb->exe);
    verbose(cmd_display(c));
    var r: Captured = proc_capture_all(c);
    free(c);
    if (r.code != 0) {
      shx_show_errors(r.out);
      error_msg("could not build " + ss->sb->label);
      sys_fd_close(ss->fd);
      return 1;
    }
    var how: string = "; its output is held (:log to see it, :unmute to stream it). help for help, :q to leave";
    if (!ss->muted) {
      how = "; its output streams above the prompt (:mute holds it). help for help, :q to leave";
    }
    var ran: string = p_rel(sys_cwd(), ss->sb->exe) + how;
    if (ss->serve) {
      ran = p_rel(sys_cwd(), ss->sb->exe);
    }
    status("Running", ran);
    if (!shx_start(ss)) {
      error_msg("could not start " + ss->sb->exe);
      sys_fd_close(ss->fd);
      return 1;
    }
  }
  if (ss->serve) {
    shx_ctl_line(29, "name " + p_base(ss->sb->exe));
    shx_send_status(ss, true);
    shx_ctl_line(30, "ready");
  }
  while (true) {
    var eof: bool = false;
    var line: string = shx_read(ss, &eof);
    if (ss->ended) {
      break;
    }
    if (eof && slen(s_trim(line)) == 0) {
      break;
    }
    var more: bool = shx_input(ss, line);
    if (ss->serve) {
      shx_send_status(ss, false);
      shx_ctl_line(30, "");
    }
    if (!more) {
      break;
    }
    if (eof) {
      break;
    }
  }
  shx_stop(ss);
  sys_sleep_ms(20);
  ss->pend_ms = 0;
  shx_relay(ss);
  sys_fd_close(ss->fd);
  sys_remove_file(ss->fifo);
  return 0;
}
