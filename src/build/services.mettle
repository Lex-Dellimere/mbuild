// services: the processes mb_service declares, started around `mbuild run`
// (DESIGN.md 12.9), and `mbuild services`.

import "std/mem";
import "../core/base";
import "../core/path";
import "../core/fs";
import "../model/manifest";
import "../model/project";
import "../core/sys_linux" if linux;
import "../core/sys_windows" if windows;

// One started service.
struct SvcRun {
  name: string;
  cmd: Cmd*;
  job: Job*;
}

// cmdline split into words as sh splits them: '...', "..." (\ escapes " \ $ `),
// \x outside quotes. ok is false on an unclosed quote.
export struct SvcWords {
  ok: bool;
  words: StrList*;
}

export fn svc_split(line: string) -> SvcWords {
  var r: SvcWords;
  r.ok = true;
  r.words = sl_new();
  var b: Buf* = buf_new();
  var has: bool = false;
  var n: int64 = slen(line);
  var i: int64 = 0;
  while (i < n) {
    var c: int32 = s_byte(line, i);
    if (c == 32 || c == 9 || c == 10) {
      if (has) {
        sl_push(r.words, buf_take(b));
        b = buf_new();
        has = false;
      }
      i = i + 1;
      continue;
    }
    has = true;
    if (c == 39) {
      var e: int64 = i + 1;
      while (e < n && s_byte(line, e) != 39) {
        e = e + 1;
      }
      if (e >= n) {
        r.ok = false;
      }
      buf_add(b, s_sub(line, i + 1, e));
      i = e + 1;
    } else if (c == 34) {
      i = i + 1;
      while (i < n && s_byte(line, i) != 34) {
        var d: int32 = s_byte(line, i);
        if (d == 92 && i + 1 < n && (s_byte(line, i + 1) == 34 || s_byte(line, i + 1) == 92 || s_byte(line, i + 1) == 36 || s_byte(line, i + 1) == 96)) {
          i = i + 1;
          d = s_byte(line, i);
        }
        buf_addb(b, d);
        i = i + 1;
      }
      if (i >= n) {
        r.ok = false;
      }
      i = i + 1;
    } else if (c == 92 && i + 1 < n) {
      buf_addb(b, s_byte(line, i + 1));
      i = i + 2;
    } else {
      buf_addb(b, c);
      i = i + 1;
    }
  }
  if (has) {
    sl_push(r.words, buf_take(b));
  } else {
    free(b);
  }
  return r;
}

fn svx_words(sv: ServiceSpec*) -> StrList* {
  var w: SvcWords = svc_split(sv->cmd);
  if (!w.ok || w.words->len == 0) {
    fail_hint("mb_service(\"" + sv->name + "\", ...): cannot split `" + sv->cmd + "` into words", "close every quote; the line is split like a shell does, without its other features");
  }
  return w.words;
}

// The first words of the services: bins they may name (built with the app).
export fn svc_programs(m: Manifest*) -> StrList* {
  var out: StrList* = sl_new();
  var i: int64 = 0;
  while (i < m->nservices) {
    var w: StrList* = svx_words(&m->services[i]);
    sl_add_uniq(out, sl_get(w, 0));
    free(w);
    i = i + 1;
  }
  return out;
}

// A word as written back for display: quoted when it holds a space or quote.
fn svx_word(w: string) -> string {
  var i: int64 = 0;
  while (i < slen(w)) {
    var c: int32 = s_byte(w, i);
    if (c == 32 || c == 9 || c == 39 || c == 34 || c == 92) {
      return sh_quote(w);
    }
    i = i + 1;
  }
  return w;
}

fn svx_secs(ms: int64) -> string {
  var tenths: int64 = (ms + 50) / 100;
  return s_int(tenths / 10) + "." + s_int(tenths % 10) + "s";
}

// The last n lines of a log, indented, on stderr.
fn svx_tail(p: Project*, log: string, n: int64) {
  var r: FsRead = fs_read(log);
  var lines: StrList* = s_lines(r.data);
  defer free(lines);
  var from: int64 = lines->len - n;
  if (from < 0) {
    from = 0;
  }
  var shown: string = p_rel(p->root, log);
  if (lines->len == 0) {
    err_line("  " + shown + " is empty");
    return;
  }
  err_line("  last lines of " + shown + ":");
  var i: int64 = from;
  while (i < lines->len) {
    err_line("    " + sl_get(lines, i));
    i = i + 1;
  }
}

fn svx_stop_all(runs: SvcRun*, n: int64) {
  var i: int64 = n - 1;
  while (i >= 0) {
    status("Stopping", runs[i].name);
    sys_spawn_stop(runs[i].job, 2000);
    i = i - 1;
  }
}

// Starts every service in declaration order (waiting for each port), runs
// app with stdio inherited, stops the services in reverse order, and answers
// the app's exit code. A first word in bins runs from out_dir (with ext).
export fn svc_run(p: Project*, out_dir: string, ext: string, bins: StrList*, app: Cmd*, app_shown: string) -> int32 {
  var m: Manifest* = p->man;
  var logs: string = p->state_dir + "/logs";
  fs_mkdirs(logs);
  var runs: SvcRun* = (SvcRun*)malloc((m->nservices + 1) * sizeof(SvcRun));
  defer free(runs);
  sys_catch_interrupt();
  var i: int64 = 0;
  while (i < m->nservices) {
    var sv: ServiceSpec* = &m->services[i];
    var words: StrList* = svx_words(sv);
    var prog: string = sl_get(words, 0);
    var t: Tool = tool_none();
    var shown: string = prog;
    if (sl_has(bins, prog)) {
      t.path = out_dir + "/" + prog + ext;
      shown = p_rel(p->root, t.path);
    } else if (s_find_byte(prog, 47) >= 0 || s_find_byte(prog, 92) >= 0) {
      t.path = p_join(p->root, prog);
    } else {
      t = sys_find_tool(prog);
      if (!tool_found(t)) {
        error_msg("service " + sv->name + ": cannot find `" + prog + "`");
        err_line("  " + cyan("help") + ": name a bin of this project or of mb_dep_bin, a path, or a program on PATH");
        svx_stop_all(runs, i);
        return 1;
      }
    }
    var c: Cmd* = cmd_new(t);
    var k: int64 = 1;
    while (k < words->len) {
      cmd_arg(c, sl_get(words, k));
      shown = shown + " " + svx_word(sl_get(words, k));
      k = k + 1;
    }
    c->cwd = p->root;
    sl_extend(c->env, sv->env);
    free(words);
    if (sv->port > 0 && sys_port_open(sv->port)) {
      error_msg("service " + sv->name + ": port " + s_int(sv->port) + " is already in use");
      err_line("  " + cyan("help") + ": stop what listens there, or give " + sv->name + " another port");
      svx_stop_all(runs, i);
      return 1;
    }
    status("Starting", sv->name + " (" + shown + ")");
    var log: string = logs + "/" + sv->name + ".log";
    var t0: int64 = sys_now_ms();
    runs[i].name = sv->name;
    runs[i].cmd = c;
    runs[i].job = sys_spawn(c, log, true);
    var why: string = s_empty();
    if (sv->port > 0) {
      while (true) {
        if (sys_port_open(sv->port)) {
          status("Ready", sv->name + " on :" + s_int(sv->port) + " (" + svx_secs(sys_now_ms() - t0) + ")");
          break;
        }
        if (sys_spawn_poll(runs[i].job)) {
          why = "service " + sv->name + " exited (code " + s_int(runs[i].job->code) + ") before port " + s_int(sv->port) + " opened";
          break;
        }
        if (sys_interrupted()) {
          why = "interrupted";
          break;
        }
        if (sys_now_ms() - t0 >= sv->wait_ms) {
          why = "service " + sv->name + ": port " + s_int(sv->port) + " not open after " + svx_secs(sv->wait_ms);
          break;
        }
        sys_sleep_ms(20);
      }
    } else if (sys_spawn_poll(runs[i].job)) {
      why = "service " + sv->name + " exited (code " + s_int(runs[i].job->code) + ") at once";
    }
    i = i + 1;
    if (slen(why) > 0) {
      if (s_eq(why, "interrupted")) {
        svx_stop_all(runs, i);
        return 130;
      }
      error_msg(why);
      svx_tail(p, log, 20);
      flush_out();
      svx_stop_all(runs, i);
      return 1;
    }
  }
  status("Running", app_shown);
  var aj: Job* = sys_spawn(app, s_empty(), false);
  var code: int32 = sys_spawn_wait(aj);
  free(aj);
  svx_stop_all(runs, m->nservices);
  return code;
}

// `mbuild services`: name, command and port of each, in start order.
export fn svc_cmd_list(p: Project*) -> int32 {
  var m: Manifest* = p->man;
  if (m->nservices == 0) {
    say("no services (declare one in fn project(): mb_service(\"db\", \"meosql --port 5433\"))");
    return 0;
  }
  var w: int64 = 0;
  var cw: int64 = 0;
  var i: int64 = 0;
  while (i < m->nservices) {
    if (slen(m->services[i].name) > w) {
      w = slen(m->services[i].name);
    }
    if (slen(m->services[i].cmd) > cw) {
      cw = slen(m->services[i].cmd);
    }
    i = i + 1;
  }
  i = 0;
  while (i < m->nservices) {
    var sv: ServiceSpec* = &m->services[i];
    var line: string = s_pad_right(sv->name, w + 2) + sv->cmd;
    if (sv->port > 0) {
      line = s_pad_right(sv->name, w + 2) + s_pad_right(sv->cmd, cw + 2) + ":" + s_int(sv->port);
    }
    say(line);
    i = i + 1;
  }
  return 0;
}
