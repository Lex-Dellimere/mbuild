// services: the mb_service processes around mbuild run, and mbuild services

import "std/mem";
import "../core/base";
import "../core/path";
import "../core/fs";
import "../model/manifest";
import "../model/project";
import "../core/sys_linux" if linux;
import "../core/sys_windows" if windows;

// cmdline split into words as sh splits them: '...', "..." (\ escapes " \ $ `),
// \x outside quotes. ok is false on an unclosed quote
export struct SvcWords {
  ok: bool;
  words: StrList*;
}

export fn svc_split(line: string) -> SvcWords {
  var r: SvcWords;
  r.ok = true;
  r.words = sl_new();
  var b: Buf* = buf_new();
  var has: bool = false;
  var n: int64 = slen(line);
  var i: int64 = 0;
  while (i < n) {
    var c: int32 = s_byte(line, i);
    if (c == 32 || c == 9 || c == 10) {
      if (has) {
        sl_push(r.words, buf_take(b));
        b = buf_new();
        has = false;
      }
      i = i + 1;
      continue;
    }
    has = true;
    if (c == 39) {
      var e: int64 = i + 1;
      while (e < n && s_byte(line, e) != 39) {
        e = e + 1;
      }
      if (e >= n) {
        r.ok = false;
      }
      buf_add(b, s_sub(line, i + 1, e));
      i = e + 1;
    } else if (c == 34) {
      i = i + 1;
      while (i < n && s_byte(line, i) != 34) {
        var d: int32 = s_byte(line, i);
        if (d == 92 && i + 1 < n && (s_byte(line, i + 1) == 34 || s_byte(line, i + 1) == 92 || s_byte(line, i + 1) == 36 || s_byte(line, i + 1) == 96)) {
          i = i + 1;
          d = s_byte(line, i);
        }
        buf_addb(b, d);
        i = i + 1;
      }
      if (i >= n) {
        r.ok = false;
      }
      i = i + 1;
    } else if (c == 92 && i + 1 < n) {
      buf_addb(b, s_byte(line, i + 1));
      i = i + 2;
    } else {
      buf_addb(b, c);
      i = i + 1;
    }
  }
  if (has) {
    sl_push(r.words, buf_take(b));
  } else {
    free(b);
  }
  return r;
}

fn svx_words(sv: ServiceSpec*) -> StrList* {
  var w: SvcWords = svc_split(sv->cmd);
  if (!w.ok || w.words->len == 0) {
    fail_hint("mb_service(\"" + sv->name + "\", ...): cannot split `" + sv->cmd + "` into words", "close every quote; the line is split like a shell does, without its other features");
  }
  return w.words;
}

// the first words of the services: bins they may name (built with the app)
export fn svc_programs(m: Manifest*) -> StrList* {
  var out: StrList* = sl_new();
  var i: int64 = 0;
  while (i < m->nservices) {
    var w: StrList* = svx_words(&m->services[i]);
    sl_add_uniq(out, sl_get(w, 0));
    free(w);
    i = i + 1;
  }
  return out;
}

// a word as written back for display: quoted when it holds a space or quote
fn svx_word(w: string) -> string {
  var i: int64 = 0;
  while (i < slen(w)) {
    var c: int32 = s_byte(w, i);
    if (c == 32 || c == 9 || c == 39 || c == 34 || c == 92) {
      return sh_quote(w);
    }
    i = i + 1;
  }
  return w;
}

// a service ready to start: its command (0 when prog was not found), the
// command as shown, and its log
export struct SvcItem {
  name: string;
  cmd: Cmd*;
  prog: string;
  shown: string;
  port: int64;
  auto_port: bool;
  wait_ms: int64;
  log: string;
}

// the services in start order. a first word in bins runs from out_dir (with ext)
export fn svc_items(p: Project*, out_dir: string, ext: string, bins: StrList*) -> SvcItem* {
  var m: Manifest* = p->man;
  var logs: string = p->state_dir + "/logs";
  fs_mkdirs(logs);
  var items: SvcItem* = (SvcItem*)malloc((m->nservices + 1) * sizeof(SvcItem));
  var vars: StrList* = sl_of("MBUILD_ROOT=" + p->root);
  defer free(vars);
  var ports: StrList* = svc_ports_for(p, m, sl_new(), vars);
  defer free(ports);
  var i: int64 = 0;
  while (i < m->nservices) {
    var sv: ServiceSpec* = &m->services[i];
    var it: SvcItem* = &items[i];
    var words: StrList* = svc_expand_all(svx_words(sv), vars);
    var prog: string = sl_get(words, 0);
    var t: Tool = tool_none();
    var shown: string = prog;
    if (sl_has(bins, prog)) {
      t.path = out_dir + "/" + prog + ext;
      shown = p_rel(p->root, t.path);
    } else if (s_find_byte(prog, 47) >= 0 || s_find_byte(prog, 92) >= 0) {
      t.path = p_join(p->root, prog);
    } else {
      t = sys_find_tool(prog);
    }
    it->name = sv->name;
    it->prog = prog;
    it->port = s_to_int(sl_get(ports, i));
    it->auto_port = sv->auto_port;
    it->wait_ms = sv->wait_ms;
    it->log = logs + "/" + sv->name + ".log";
    it->cmd = (Cmd*)0;
    if (tool_found(t)) {
      var c: Cmd* = cmd_new(t);
      var k: int64 = 1;
      while (k < words->len) {
        cmd_arg(c, sl_get(words, k));
        shown = shown + " " + svx_word(sl_get(words, k));
        k = k + 1;
      }
      c->cwd = p->root;
      sl_extend(c->env, sv->env);
      svc_port_env(c->env, vars);
      it->cmd = c;
    }
    it->shown = shown;
    free(words);
    i = i + 1;
  }
  return items;
}

export fn svc_secs(ms: int64) -> string {
  var tenths: int64 = (ms + 50) / 100;
  return s_int(tenths / 10) + "." + s_int(tenths % 10) + "s";
}

export fn svc_say_missing(it: SvcItem*) {
  error_msg("service " + it->name + ": cannot find `" + it->prog + "`");
  err_line("  " + cyan("help") + ": name a bin of this project or of mb_dep_bin, a path, or a program on PATH");
}

export fn svc_say_in_use(it: SvcItem*) {
  error_msg("service " + it->name + ": port " + s_int(it->port) + " is already in use");
  err_line("  " + cyan("help") + ": stop what listens there, or give " + it->name + " another port");
}

// why, then the last 20 lines of the service's log, indented, on stderr
export fn svc_say_failed(p: Project*, it: SvcItem*, why: string) {
  error_msg(why);
  var r: FsRead = fs_read(it->log);
  var lines: StrList* = s_lines(r.data);
  defer free(lines);
  var from: int64 = lines->len - 20;
  if (from < 0) {
    from = 0;
  }
  var shown: string = p_rel(p->root, it->log);
  if (lines->len == 0) {
    err_line("  " + shown + " is empty");
  } else {
    err_line("  last lines of " + shown + ":");
    var i: int64 = from;
    while (i < lines->len) {
      err_line("    " + sl_get(lines, i));
      i = i + 1;
    }
  }
  flush_out();
}

// `mbuild services`: name, command and port of each, in start order
export fn svc_cmd_list(p: Project*) -> int32 {
  var m: Manifest* = p->man;
  if (m->nservices == 0) {
    say("no services (declare one in fn project(): mb_service(\"db\", \"meosql --port 5433\"))");
    return 0;
  }
  var w: int64 = 0;
  var cw: int64 = 0;
  var i: int64 = 0;
  while (i < m->nservices) {
    if (slen(m->services[i].name) > w) {
      w = slen(m->services[i].name);
    }
    if (slen(m->services[i].cmd) > cw) {
      cw = slen(m->services[i].cmd);
    }
    i = i + 1;
  }
  i = 0;
  while (i < m->nservices) {
    var sv: ServiceSpec* = &m->services[i];
    var line: string = s_pad_right(sv->name, w + 2) + sv->cmd;
    if (sv->port > 0) {
      line = s_pad_right(sv->name, w + 2) + s_pad_right(sv->cmd, cw + 2) + ":" + s_int(sv->port);
    }
    say(line);
    i = i + 1;
  }
  return 0;
}

// ports: mb_service_port(name, 0) takes one from the pool, locked under
// $MBUILD_HOME/tmp/ports/PORT (a directory holding the owner's pid) so
// parallel runs and parallel mbuilds get distinct ones

var g_svc_held: StrList* = (StrList*)0;
var g_svc_next: int64 = 0;

fn svx_ports_dir() -> string {
  return fs_mbuild_home() + "/tmp/ports";
}

// takes the lock of port: free, or held by a process that is gone
fn svx_lock(port: int64) -> bool {
  var dir: string = svx_ports_dir() + "/" + s_int(port);
  var i: int64 = 0;
  while (i < 2) {
    if (sys_mkdir_new(dir)) {
      fs_write(dir + "/pid", s_int(sys_pid()) + "\n");
      return true;
    }
    var rd: FsRead = fs_read(dir + "/pid");
    var owner: int64 = s_to_int(s_trim(rd.data));
    if (!rd.ok || (owner > 0 && sys_pid_alive(owner))) {
      return false;
    }
    sys_remove_tree(dir);
    i = i + 1;
  }
  return false;
}

// a free port from lo-hi, locked for this process; 0 when none is left
export fn svc_port_take(lo: int64, hi: int64) -> int64 {
  if (g_svc_held == (StrList*)0) {
    g_svc_held = sl_new();
  }
  fs_mkdirs(svx_ports_dir());
  var span: int64 = hi - lo + 1;
  if (g_svc_next == 0) {
    g_svc_next = (sys_pid() * 7919) % span + 1;
  }
  var k: int64 = 0;
  while (k < span) {
    var port: int64 = lo + (g_svc_next + k) % span;
    if (svx_lock(port)) {
      if (sys_port_free(port)) {
        g_svc_next = g_svc_next + k + 1;
        sl_push(g_svc_held, s_int(port));
        return port;
      }
      sys_remove_tree(svx_ports_dir() + "/" + s_int(port));
    }
    k = k + 1;
  }
  return 0;
}

export fn svc_port_release(port: int64) {
  if (g_svc_held == (StrList*)0) {
    return;
  }
  var at: int64 = sl_index(g_svc_held, s_int(port));
  if (at >= 0) {
    sl_remove_at(g_svc_held, at);
    sys_remove_tree(svx_ports_dir() + "/" + s_int(port));
  }
}

export fn svc_ports_release_all() {
  while (g_svc_held != (StrList*)0 && g_svc_held->len > 0) {
    svc_port_release(s_to_int(sl_get(g_svc_held, 0)));
  }
}

// the pool of "*"'s ports setting
export fn svc_pool(m: Manifest*, lo: int64*, hi: int64*) {
  var v: string = man_test_get(m, "*", "ports");
  var dash: int64 = s_find_byte(v, 45);
  *lo = s_to_int(s_sub(v, 0, dash));
  *hi = s_to_int(s_from(v, dash + 1));
}

// "MBUILD_PORT_DB": the name upper-cased, other bytes '_'
export fn svc_port_var(name: string) -> string {
  var d: string = s_dup(s_lower(name));
  var i: int64 = 0;
  while (i < slen(d)) {
    var c: int32 = s_byte(d, i);
    if (c >= 97 && c <= 122) {
      d.chars[i] = (uint8)(c - 32);
    } else if (!(c >= 48 && c <= 57)) {
      d.chars[i] = (uint8)95;
    }
    i = i + 1;
  }
  return "MBUILD_PORT_" + d;
}

// the port of every service named in only (every one when only is empty),
// "0" for the others and for those without one; auto ports taken from the
// pool. vars gets "MBUILD_PORT_X=port" for each port
export fn svc_ports_for(p: Project*, m: Manifest*, only: StrList*, vars: StrList*) -> StrList* {
  var lo: int64 = 0;
  var hi: int64 = 0;
  svc_pool(m, &lo, &hi);
  var l: StrList* = sl_new();
  var i: int64 = 0;
  while (i < m->nservices) {
    var sv: ServiceSpec* = &m->services[i];
    var port: int64 = 0;
    if (only->len == 0 || sl_has(only, sv->name)) {
      port = sv->port;
      if (sv->auto_port) {
        port = svc_port_take(lo, hi);
        if (port == 0) {
          fail("service " + sv->name + ": no free port in " + s_int(lo) + "-" + s_int(hi) + " (mb_test_set(\"*\", \"ports\", ...))");
        }
      }
      if (port > 0) {
        sl_push(vars, svc_port_var(sv->name) + "=" + s_int(port));
      }
    }
    sl_push(l, s_int(port));
    i = i + 1;
  }
  return l;
}

// the MBUILD_PORT_ entries of vars into env
export fn svc_port_env(env: StrList*, vars: StrList*) {
  var i: int64 = 0;
  while (i < vars->len) {
    if (s_starts(sl_get(vars, i), "MBUILD_PORT_")) {
      sl_push(env, sl_get(vars, i));
    }
    i = i + 1;
  }
}

// word with each $NAME of vars ("NAME=value") replaced; nothing else is
export fn svc_expand(word: string, vars: StrList*) -> string {
  if (s_find_byte(word, 36) < 0) {
    return word;
  }
  var b: Buf* = buf_new();
  var n: int64 = slen(word);
  var i: int64 = 0;
  while (i < n) {
    var c: int32 = s_byte(word, i);
    var done: bool = false;
    if (c == 36) {
      var e: int64 = i + 1;
      while (e < n && (is_ident_b(s_byte(word, e)))) {
        e = e + 1;
      }
      var name: string = s_sub(word, i + 1, e);
      var k: int64 = 0;
      while (k < vars->len && !done) {
        var kv: string = sl_get(vars, k);
        var eq: int64 = s_find_byte(kv, 61);
        if (s_eq(s_sub(kv, 0, eq), name)) {
          buf_add(b, s_from(kv, eq + 1));
          i = e;
          done = true;
        }
        k = k + 1;
      }
    }
    if (!done) {
      buf_addb(b, c);
      i = i + 1;
    }
  }
  return buf_take(b);
}

export fn svc_expand_all(words: StrList*, vars: StrList*) -> StrList* {
  var i: int64 = 0;
  while (i < words->len) {
    sl_set(words, i, svc_expand(sl_get(words, i), vars));
    i = i + 1;
  }
  return words;
}

// MBUILD_PORT_X of every service with a port, into env (the app's)
export fn svc_items_env(m: Manifest*, items: SvcItem*, env: StrList*) {
  var i: int64 = 0;
  while (i < m->nservices) {
    if (items[i].port > 0) {
      sl_push(env, svc_port_var(items[i].name) + "=" + s_int(items[i].port));
    }
    i = i + 1;
  }
}
