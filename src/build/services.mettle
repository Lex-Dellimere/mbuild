// services: the processes mb_service declares, started around `mbuild run`
//, and `mbuild services`. svc_run is in services_linux
// (alph) and services_windows; this file holds what they share.

import "std/mem";
import "../core/base";
import "../core/path";
import "../core/fs";
import "../model/manifest";
import "../model/project";
import "../core/sys_linux" if linux;
import "../core/sys_windows" if windows;

// cmdline split into words as sh splits them: '...', "..." (\ escapes " \ $ `),
// \x outside quotes. ok is false on an unclosed quote.
export struct SvcWords {
  ok: bool;
  words: StrList*;
}

export fn svc_split(line: string) -> SvcWords {
  var r: SvcWords;
  r.ok = true;
  r.words = sl_new();
  var b: Buf* = buf_new();
  var has: bool = false;
  var n: int64 = slen(line);
  var i: int64 = 0;
  while (i < n) {
    var c: int32 = s_byte(line, i);
    if (c == 32 || c == 9 || c == 10) {
      if (has) {
        sl_push(r.words, buf_take(b));
        b = buf_new();
        has = false;
      }
      i = i + 1;
      continue;
    }
    has = true;
    if (c == 39) {
      var e: int64 = i + 1;
      while (e < n && s_byte(line, e) != 39) {
        e = e + 1;
      }
      if (e >= n) {
        r.ok = false;
      }
      buf_add(b, s_sub(line, i + 1, e));
      i = e + 1;
    } else if (c == 34) {
      i = i + 1;
      while (i < n && s_byte(line, i) != 34) {
        var d: int32 = s_byte(line, i);
        if (d == 92 && i + 1 < n && (s_byte(line, i + 1) == 34 || s_byte(line, i + 1) == 92 || s_byte(line, i + 1) == 36 || s_byte(line, i + 1) == 96)) {
          i = i + 1;
          d = s_byte(line, i);
        }
        buf_addb(b, d);
        i = i + 1;
      }
      if (i >= n) {
        r.ok = false;
      }
      i = i + 1;
    } else if (c == 92 && i + 1 < n) {
      buf_addb(b, s_byte(line, i + 1));
      i = i + 2;
    } else {
      buf_addb(b, c);
      i = i + 1;
    }
  }
  if (has) {
    sl_push(r.words, buf_take(b));
  } else {
    free(b);
  }
  return r;
}

fn svx_words(sv: ServiceSpec*) -> StrList* {
  var w: SvcWords = svc_split(sv->cmd);
  if (!w.ok || w.words->len == 0) {
    fail_hint("mb_service(\"" + sv->name + "\", ...): cannot split `" + sv->cmd + "` into words", "close every quote; the line is split like a shell does, without its other features");
  }
  return w.words;
}

// The first words of the services: bins they may name (built with the app).
export fn svc_programs(m: Manifest*) -> StrList* {
  var out: StrList* = sl_new();
  var i: int64 = 0;
  while (i < m->nservices) {
    var w: StrList* = svx_words(&m->services[i]);
    sl_add_uniq(out, sl_get(w, 0));
    free(w);
    i = i + 1;
  }
  return out;
}

// A word as written back for display: quoted when it holds a space or quote.
fn svx_word(w: string) -> string {
  var i: int64 = 0;
  while (i < slen(w)) {
    var c: int32 = s_byte(w, i);
    if (c == 32 || c == 9 || c == 39 || c == 34 || c == 92) {
      return sh_quote(w);
    }
    i = i + 1;
  }
  return w;
}

// A service ready to start: its command (0 when prog was not found), the
// command as shown, and its log.
export struct SvcItem {
  name: string;
  cmd: Cmd*;
  prog: string;
  shown: string;
  port: int64;
  wait_ms: int64;
  log: string;
}

// The services in start order. A first word in bins runs from out_dir (with ext).
export fn svc_items(p: Project*, out_dir: string, ext: string, bins: StrList*) -> SvcItem* {
  var m: Manifest* = p->man;
  var logs: string = p->state_dir + "/logs";
  fs_mkdirs(logs);
  var items: SvcItem* = (SvcItem*)malloc((m->nservices + 1) * sizeof(SvcItem));
  var i: int64 = 0;
  while (i < m->nservices) {
    var sv: ServiceSpec* = &m->services[i];
    var it: SvcItem* = &items[i];
    var words: StrList* = svx_words(sv);
    var prog: string = sl_get(words, 0);
    var t: Tool = tool_none();
    var shown: string = prog;
    if (sl_has(bins, prog)) {
      t.path = out_dir + "/" + prog + ext;
      shown = p_rel(p->root, t.path);
    } else if (s_find_byte(prog, 47) >= 0 || s_find_byte(prog, 92) >= 0) {
      t.path = p_join(p->root, prog);
    } else {
      t = sys_find_tool(prog);
    }
    it->name = sv->name;
    it->prog = prog;
    it->port = sv->port;
    it->wait_ms = sv->wait_ms;
    it->log = logs + "/" + sv->name + ".log";
    it->cmd = (Cmd*)0;
    if (tool_found(t)) {
      var c: Cmd* = cmd_new(t);
      var k: int64 = 1;
      while (k < words->len) {
        cmd_arg(c, sl_get(words, k));
        shown = shown + " " + svx_word(sl_get(words, k));
        k = k + 1;
      }
      c->cwd = p->root;
      sl_extend(c->env, sv->env);
      it->cmd = c;
    }
    it->shown = shown;
    free(words);
    i = i + 1;
  }
  return items;
}

export fn svc_secs(ms: int64) -> string {
  var tenths: int64 = (ms + 50) / 100;
  return s_int(tenths / 10) + "." + s_int(tenths % 10) + "s";
}

export fn svc_say_missing(it: SvcItem*) {
  error_msg("service " + it->name + ": cannot find `" + it->prog + "`");
  err_line("  " + cyan("help") + ": name a bin of this project or of mb_dep_bin, a path, or a program on PATH");
}

export fn svc_say_in_use(it: SvcItem*) {
  error_msg("service " + it->name + ": port " + s_int(it->port) + " is already in use");
  err_line("  " + cyan("help") + ": stop what listens there, or give " + it->name + " another port");
}

// why, then the last 20 lines of the service's log, indented, on stderr.
export fn svc_say_failed(p: Project*, it: SvcItem*, why: string) {
  error_msg(why);
  var r: FsRead = fs_read(it->log);
  var lines: StrList* = s_lines(r.data);
  defer free(lines);
  var from: int64 = lines->len - 20;
  if (from < 0) {
    from = 0;
  }
  var shown: string = p_rel(p->root, it->log);
  if (lines->len == 0) {
    err_line("  " + shown + " is empty");
  } else {
    err_line("  last lines of " + shown + ":");
    var i: int64 = from;
    while (i < lines->len) {
      err_line("    " + sl_get(lines, i));
      i = i + 1;
    }
  }
  flush_out();
}

// `mbuild services`: name, command and port of each, in start order.
export fn svc_cmd_list(p: Project*) -> int32 {
  var m: Manifest* = p->man;
  if (m->nservices == 0) {
    say("no services (declare one in fn project(): mb_service(\"db\", \"meosql --port 5433\"))");
    return 0;
  }
  var w: int64 = 0;
  var cw: int64 = 0;
  var i: int64 = 0;
  while (i < m->nservices) {
    if (slen(m->services[i].name) > w) {
      w = slen(m->services[i].name);
    }
    if (slen(m->services[i].cmd) > cw) {
      cw = slen(m->services[i].cmd);
    }
    i = i + 1;
  }
  i = 0;
  while (i < m->nservices) {
    var sv: ServiceSpec* = &m->services[i];
    var line: string = s_pad_right(sv->name, w + 2) + sv->cmd;
    if (sv->port > 0) {
      line = s_pad_right(sv->name, w + 2) + s_pad_right(sv->cmd, cw + 2) + ":" + s_int(sv->port);
    }
    say(line);
    i = i + 1;
  }
  return 0;
}
