  bx_group("tools");
  bx_def("doctor", "check the environment", "mbuild doctor [-t T]", "native.md");
  bx_ex("mbuild doctor", "tools, compilers, the native-code audit");
  bx_ex("mbuild doctor -t windows", "");
  bx_def("toolchain", "install, pin and update Mettle compilers", "mbuild toolchain [list | install V|latest|--from DIR | use V [--local] | default V | remove V | update]", "platforms.md");
  bx_ex("mbuild toolchain", "installed toolchains, the compiler per target and why");
  bx_ex("mbuild toolchain install latest", "the newest release");
