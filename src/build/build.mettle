  bx_fl("--dry-run", "show what it would write");
  bx_note("writes mbuild.mettle, a hello world src/main.mettle unless there's a main file, and the .gitignore lines.");
  bx_note("lines of an existing mettle.deps become dependencies.");
  bx_def("new", "start a project from a package", "mbuild new NAME --from PKG[@V]", "packages.md");
  bx_ex("mbuild new blog --from webfw", "");
  bx_ex("mbuild new blog --from ../webfw --yes", "a path; every option at its default");
  bx_fl("--from PKG[@V]", "a registry package or a path, with an init.rules");
  bx_fl("--opt K=V", "answer one of its options (repeatable)");
  bx_fl("--yes", "take the defaults, don't ask");
  bx_fl("--dry-run", "show what it would write");
  bx_fl("--force", "write into a non-empty NAME/");
  bx_def("build", "build the programs", "mbuild build [BINS...] [-t T] [-r | -p PROFILE]", "project.md");
  bx_ex("mbuild build", "");
  bx_ex("mbuild build -r", "release");
  bx_ex("mbuild build -t all", "linux and windows");
  bx_ex("mbuild build server", "one bin");
  bx_fl("-t T", "linux, windows, all or host (repeatable)");
  bx_fl("-r, -p NAME", "the release profile, or another one");
  bx_fl("--set KEY=VALUE", "a typed build setting (repeatable)");
  bx_fl("--flag ARG", "a raw compiler flag (repeatable)");
  bx_fl("--use NAME=IMPL", "a component impl (repeatable)");
  bx_fl("--no-hooks", "skip hook_pre_build and hook_post_build");
  bx_fl("--force", "rebuild what's fresh too");
  bx_note("output goes to build/<target>/<profile>/.");
  bx_note("imports of packages that aren't dependencies yet get added, unless --locked or --offline.");
  bx_note("a package with no bins (a library) is type-checked instead.");
  bx_def("run", "build and run a program", "mbuild run [BIN] [-t T] [-r | -p PROFILE] [-- ARGS...]", "project.md");
  bx_ex("mbuild run", "");
  bx_ex("mbuild run -- --port 8080", "args after -- go to the program");
  bx_ex("mbuild run -t windows", "through wine");
  bx_fl("-t T", "one target (default: the host)");
  bx_fl("-r, -p NAME", "the release profile, or another one");
  bx_fl("--no-services", "don't start the mb_service processes");
  bx_note("the exit code is the program's.");
  bx_note("mb_service processes start first, in order, each waited for on its port; they stop when the program exits. output in .mbuild/logs/NAME.log.");
  bx_def("live", "run a program and patch it as you edit", "mbuild live [BIN] [-p PROFILE] [-- ARGS...]", "components.md");
  bx_ex("mbuild live", "");
  bx_ex("mbuild use render=gl", "in another terminal: switch a component");
  bx_note("saved files patch the running program at its next `quiesce;`. host target only.");
  bx_def("shell", "a prompt inside the running program", "mbuild shell [BIN] [-p PROFILE] [--local] [-- ARGS...]", "project.md");
  bx_ex("mbuild shell", "build, start, then type at `mettle> `");
  bx_ex("mbuild shell --local", "no program: each input runs on its own");
  bx_fl("--local", "evaluate in a small program that imports the project's code");
  bx_note("the program calls `shell_point();` (import \"mbuild/shell\") next to its `quiesce;`; elsewhere it is an empty function.");
  bx_note("inputs: an expression prints its value, a statement runs, `fn NAME(...) {{...}` redefines NAME; `h NAME`, `i EXPR`, `r`, `undo`, `:q`. type `help` at the prompt.");
  bx_note("globals and functions are in scope, locals of running functions are not. Linux only.");
  bx_def("test", "run @test functions and test programs", "mbuild test [NAMES | FILES...] [--filter S] [-r]", "project.md");
