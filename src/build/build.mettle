// build: project discovery, help and the commands: build / run / live /
// test / check / clean / init / new / publish and the rest, plus the small
// shortcuts to the compiler (mettle, trace, why, explain) and doctor.
// Dependency resolution, native code, compiler selection, mbuild.mettle,
// components and registries live in their own modules; this one calls them.

import "std/io";
import "std/mem";
import "../core/base";
import "../core/path";
import "../core/fs";
import "../core/proc";
import "../model/toml";
import "scan";
import "../model/semver";
import "../model/manifest";
import "../model/project";
import "graph";
import "../pkg/deps";
import "../pkg/registry";
import "../pkg/api";
import "../core/sha256";
import "../config/mbfile";
import "../config/config";
import "../config/init";
import "../config/agents";
import "native";
import "toolchain";
import "riscv";
import "components";
import "complete";
import "services";
import "services_linux" if linux;
import "services_windows" if windows;
import "live";
import "live_linux" if linux;
import "live_windows" if windows;
import "testrun";
import "testnative";
import "golden";
import "testrun_linux" if linux;
import "testrun_windows" if windows;
import "../core/sys_linux" if linux;
import "../core/sys_windows" if windows;

export var build_version_text: string = "0.2.0";

var g_bx_warned: bool = false;

// One program to build.
export struct BinInfo {
  name: string;
  main: string;       // as written in the manifest, relative to the root
  entry: string;      // absolute
  flags: StrList*;
  kind: string;       // "exe" | "shared" | "object" | "flat"
  triple: string;     // "" = the target's; "*-none" = freestanding
}

export struct BinSet {
  items: BinInfo*;
  n: int64;
  root: string;
}

// Everything one command needs for a set of targets.
struct BxSess {
  p: Project*;
  ds: DepState*;
  targets: StrList*;
  mettles: Mettle**;   // parallel to targets
  host_m: Mettle*;     // the host's compiler (freestanding bins), 0 until needed
  profile: string;
  cur_t: TargetCtx*;
  cur_nl: NatLink*;
  comps: StrList*;     // component names of the build
  has_cmp: bool;       // components or rules: units go through cmp_prepare
  hooks_run: StrList*; // "name target profile" of the hooks already run
  dep: string;         // "" or the dependency whose bins this session builds (mb_dep_bin)
  app: Project*;       // the project they are built for (out dirs, profile); s->p itself otherwise
  app_profile: string;
  tests: bool;         // the units are test programs (mb_test_bin)
}

// Objects other modules may keep pointers to: held here, never freed.
var g_bx_ds: DepState* = (DepState*)0;
var g_bx_sess: BxSess* = (BxSess*)0;
var g_bx_t: TargetCtx* = (TargetCtx*)0;

// Settings warnings already shown, flag sets already probed (this command).
var g_bx_seen_warn: StrList* = (StrList*)0;
var g_bx_probed: StrList* = (StrList*)0;
// [tools] values applied to the environment: "ENV=file".
var g_bx_tools: StrList* = (StrList*)0;
var g_bx_verify_said: bool = false;
// cfg_info of mbuild.mettle, scanned once per command.
var g_bx_info: MbfInfo* = (MbfInfo*)0;
// The units, target contexts and requests of the command.
var g_bx_units: BxUnits* = (BxUnits*)0;
var g_bx_dep_bins: BxDepBins* = (BxDepBins*)0;
var g_bx_tctxs: TargetCtx** = (TargetCtx**)0;
var g_bx_nls: NatLink** = (NatLink**)0;
var g_bx_ini: IniRequest* = (IniRequest*)0;
// Held for the whole command (rollback state, plans).
var g_bx_snap: DepSnap* = (DepSnap*)0;
var g_bx_plan: UpdatePlan* = (UpdatePlan*)0;
var g_bx_req: UpdateReq* = (UpdateReq*)0;
var g_bx_proj: Project* = (Project*)0;

// ---------------------------------------------------------------------------
// Small helpers
// ---------------------------------------------------------------------------

fn bx_slash(p: string) -> string {
  return s_replace_byte(p, 92, 47);
}

fn bx_cwd() -> string {
  return bx_slash(sys_cwd());
}

fn bx_secs(ms: int64) -> string {
  if (ms < 0) {
    ms = 0;
  }
  var whole: int64 = ms / 1000;
  var tenth: int64 = (ms % 1000) / 100;
  return "{whole}.{tenth}s";
}

// A path for messages: relative to the working directory when inside it.
fn bx_show(p: string) -> string {
  return p_rel(bx_cwd(), p);
}

fn bx_rel(p: Project*, path: string) -> string {
  return p_rel(p->root, path);
}

fn bx_print_block(text: string) {
  if (slen(text) == 0) {
    return;
  }
  print_err(text);
  if (!s_ends(text, "\n")) {
    print_err("\n");
  }
  flush_out();
}

// The compiler's output minus its "Built executable" chatter.
fn bx_compiler_output(text: string) -> string {
  if (g_verbose) {
    return text;
  }
  var lines: StrList* = s_lines(text);
  var b: Buf* = buf_new();
  var i: int64 = 0;
  while (i < lines->len) {
    var line: string = sl_get(lines, i);
    var plain: string = bx_strip_ansi(line);
    if (!s_starts(plain, "Built executable") && !s_starts(plain, "Built object") && !s_starts(plain, "Wrote flat image") && !s_starts(plain, "Wrote UF2 file") && !s_starts(plain, "Wrote Intel HEX file") && !s_starts(plain, "Wrote ELF file")) {
      buf_line(b, line);
    }
    i = i + 1;
  }
  free(lines->items);
  free(lines);
  var s: string = buf_take(b);
  if (slen(s_trim(bx_strip_ansi(s))) == 0) {
    return s_empty();
  }
  return s;
}

fn bx_has_arg(l: StrList*, a: string) -> bool {
  return sl_has(l, a);
}

// Positional arguments that are not flags.
fn bx_positional(l: StrList*) -> StrList* {
  var r: StrList* = sl_new();
  var i: int64 = 0;
  while (i < l->len) {
    var a: string = sl_get(l, i);
    if (!s_starts(a, "-")) {
      sl_push(r, a);
    }
    i = i + 1;
  }
  return r;
}

// ---------------------------------------------------------------------------
// Project discovery
// ---------------------------------------------------------------------------

// The nearest directory at or above start holding mbuild.mettle or an old
// mbuild.toml (which build_open refuses), "" when none.
export fn build_find_root(start: string) -> string {
  var dir: string = p_clean(bx_slash(start));
  while (true) {
    if (fs_is_file(p_join(dir, "mbuild.mettle")) || fs_is_file(p_join(dir, "mbuild.toml"))) {
      return dir;
    }
    var up: string = p_dir(dir);
    if (s_eq(up, dir) || s_eq(up, ".")) {
      break;
    }
    dir = up;
  }
  return s_empty();
}

fn bx_safe_name(s: string) -> string {
  var d: string = s_dup(s);
  var i: int64 = 0;
  while (i < slen(d)) {
    var c: int32 = s_byte(d, i);
    if (!(is_ident_b(c) || c == 45 || c == 46)) {
      d.chars[i] = (uint8)95;
    }
    i = i + 1;
  }
  if (slen(d) == 0) {
    return "app";
  }
  return d;
}

// A directory name as a package name: lower case, '_' for anything else.
fn bx_pkg_name(s: string) -> string {
  var d: string = s_lower(s_dup(s));
  var i: int64 = 0;
  while (i < slen(d)) {
    var c: int32 = s_byte(d, i);
    if (!((c >= 97 && c <= 122) || is_digit_b(c) || c == 95)) {
      d.chars[i] = (uint8)95;
    }
    i = i + 1;
  }
  if (slen(d) > 64) {
    d = s_sub(d, 0, 64);
  }
  if (slen(d) == 0 || !(s_byte(d, 0) >= 97 && s_byte(d, 0) <= 122)) {
    d = "app_" + d;
  }
  if (s_eq(d, "std") || s_eq(d, "mbuild")) {
    d = d + "_app";
  }
  return d;
}

// cfg_load (mbuild.mettle, with mbuild.local.mettle in m->local).
fn bx_load_manifest(p: Project*) {
  var m: Manifest* = cfg_load(p);
  if (!g_bx_warned) {
    bx_apply_tools(m);
    var i: int64 = 0;
    while (i < m->warnings->len) {
      warn(bx_unroot(p, sl_get(m->warnings, i)));
      i = i + 1;
    }
    g_bx_warned = true;
  }
  p->man = m;
  p->has_manifest = true;
}

// The environment variable a [tools] key stands for ("" for the compilers,
// which toolchain.mettle reads itself to name their origin).
fn bx_tool_env(key: string) -> string {
  if (s_eq(key, "curl")) { return "MBUILD_CURL"; }
  if (s_eq(key, "cc")) { return "CC"; }
  if (s_eq(key, "cc-windows")) { return "CC_WINDOWS"; }
  if (s_eq(key, "pkg-config")) { return "PKG_CONFIG"; }
  if (s_eq(key, "wine")) { return "MBUILD_WINE"; }
  return s_empty();
}

// [tools] values go into the environment where it does not set them.
fn bx_apply_tools(m: Manifest*) {
  if (g_bx_tools == (StrList*)0) {
    g_bx_tools = sl_new();
  }
  var i: int64 = 0;
  while (i < m->tools->len) {
    var entry: string = sl_get(m->tools, i);
    i = i + 1;
    var eq: int64 = s_find_byte(entry, 61);
    if (eq <= 0) {
      continue;
    }
    var key: string = s_sub(entry, 0, eq);
    var env: string = bx_tool_env(key);
    if (slen(env) == 0 || env_set(env)) {
      continue;
    }
    sys_setenv(env, s_from(entry, eq + 1));
    sl_push(g_bx_tools, env + "=mbuild.local.mettle");
  }
}

// Finds the project from the working directory without loading it: the
// nearest mbuild.mettle (p->mbfile), an mbuild.toml (p->legacy_toml), or a
// zero-config project in the working directory.
export fn build_find(opts: Options*) -> Project* {
  var p: Project* = new Project;
  p->opts = opts;
  var root: string = build_find_root(bx_cwd());
  if (slen(root) == 0) {
    root = p_clean(bx_cwd());
  }
  p->root = root;
  p->state_dir = root + "/.mbuild";
  p->mbfile = s_empty();
  p->legacy_toml = false;
  p->man = man_empty(root, bx_safe_name(p_base(root)));
  p->has_manifest = false;
  if (fs_is_file(root + "/mbuild.mettle")) {
    p->mbfile = root + "/mbuild.mettle";
  } else if (fs_is_file(root + "/mbuild.toml")) {
    p->legacy_toml = true;
  }
  return p;
}

fn bx_refuse_legacy(p: Project*) {
  if (p->legacy_toml) {
    fail("mbuild.toml is no longer read; write mbuild.mettle (mbuild init)");
  }
}

// build_find, then the configuration from mbuild.mettle.
export fn build_open(opts: Options*) -> Project* {
  var p: Project* = build_find(opts);
  bx_refuse_legacy(p);
  if (slen(p->mbfile) > 0) {
    bx_load_manifest(p);
  }
  return p;
}

// build_open for the commands that only read registries (search, info): with
// no compiler to evaluate mbuild.mettle, the project stays unloaded, so only
// the registries that need no evaluation are used.
export fn build_open_soft(opts: Options*) -> Project* {
  var p: Project* = build_find(opts);
  bx_refuse_legacy(p);
  if (slen(p->mbfile) > 0 && tc_available(p, sys_os())) {
    bx_load_manifest(p);
  }
  return p;
}

// True after build_open_soft left a project unloaded for want of a compiler.
export fn build_registries_skipped(p: Project*) -> bool {
  return slen(p->mbfile) > 0 && !p->has_manifest;
}

// Loads the project's configuration (fails with the compiler's absence).
export fn build_load(p: Project*) {
  bx_refuse_legacy(p);
  bx_load_manifest(p);
}

// After an edit of mbuild.mettle (deps_add_missing, cfg_set_dep).
fn bx_reload(p: Project*) {
  if (slen(p->mbfile) > 0) {
    bx_load_manifest(p);
  }
}

// ---------------------------------------------------------------------------
// Bins, targets, profiles
// ---------------------------------------------------------------------------

fn bx_binset_push(bs: BinSet*, name: string, mainp: string) {
  var i: int64 = 0;
  while (i < bs->n) {
    if (s_eq(bs->items[i].name, name)) {
      return;
    }
    i = i + 1;
  }
  bs->items = (BinInfo*)realloc(bs->items, (bs->n + 1) * sizeof(BinInfo));
  var b: BinInfo;
  b.name = name;
  b.main = mainp;
  b.entry = p_clean(p_join(bs->root, mainp));
  b.flags = sl_new();
  b.kind = "exe";
  b.triple = s_empty();
  bs->items[bs->n] = b;
  bs->n = bs->n + 1;
}

// [bin.*] sections; else main.mettle or src/main.mettle (named after the
// package) plus every cmd/<name>/main.mettle; else top-level files with a main.
// [bin.NAME] without main: cmd/NAME/main.mettle, src/NAME.mettle,
// src/main.mettle, main.mettle, the first that exists.
fn bx_default_main(root: string, name: string) -> string {
  var cands: StrList* = sl_new();
  sl_push(cands, "cmd/" + name + "/main.mettle");
  sl_push(cands, "src/" + name + ".mettle");
  sl_push(cands, "src/main.mettle");
  sl_push(cands, "main.mettle");
  var found: string = s_empty();
  var i: int64 = 0;
  while (i < cands->len && slen(found) == 0) {
    if (fs_is_file(root + "/" + sl_get(cands, i))) {
      found = sl_get(cands, i);
    }
    i = i + 1;
  }
  if (slen(found) == 0) {
    fail_hint("bin " + name + " has no main and none of " + sl_join(cands, ", ") + " exists", "name it in mbuild.mettle: mb_bin(\"" + name + "\", \"path/to/file.mettle\");");
  }
  free(cands);
  return found;
}

export fn build_bins(p: Project*) -> BinSet* {
  var bs: BinSet* = new BinSet;
  bs->items = (BinInfo*)0;
  bs->n = 0;
  bs->root = p->root;
  var m: Manifest* = p->man;
  if (m->nbins > 0) {
    var i: int64 = 0;
    while (i < m->nbins) {
      var spec: BinSpec* = man_bin(m, i);
      var mainp: string = spec->main;
      if (slen(mainp) == 0) {
        mainp = bx_default_main(p->root, spec->name);
      }
      bx_binset_push(bs, spec->name, mainp);
      bs->items[bs->n - 1].flags = spec->flags;
      if (slen(spec->kind) > 0) {
        bs->items[bs->n - 1].kind = spec->kind;
      }
      bs->items[bs->n - 1].triple = spec->triple;
      i = i + 1;
    }
    return bs;
  }
  if (fs_is_file(p->root + "/main.mettle")) {
    bx_binset_push(bs, m->name, "main.mettle");
  } else if (fs_is_file(p->root + "/src/main.mettle")) {
    bx_binset_push(bs, m->name, "src/main.mettle");
  }
  var files: StrList* = sl_new();
  defer free(files);
  var dirs: StrList* = sl_new();
  defer free(dirs);
  if (sys_list_dir(p->root + "/cmd", files, dirs)) {
    sl_sort(dirs);
    var k: int64 = 0;
    while (k < dirs->len) {
      var d: string = sl_get(dirs, k);
      if (fs_is_file(p->root + "/cmd/" + d + "/main.mettle")) {
        bx_binset_push(bs, d, "cmd/" + d + "/main.mettle");
      }
      k = k + 1;
    }
  }
  if (bs->n == 0) {
    var top: StrList* = sl_new();
    defer free(top);
    var tdirs: StrList* = sl_new();
    defer free(tdirs);
    if (sys_list_dir(p->root, top, tdirs)) {
      sl_sort(top);
      var j: int64 = 0;
      while (j < top->len) {
        var f: string = sl_get(top, j);
        if (s_ends(f, ".mettle")) {
          var rd: FsRead = fs_read(p->root + "/" + f);
          if (rd.ok && scan_source(rd.data)->has_main) {
            bx_binset_push(bs, bx_safe_name(p_stem(f)), f);
          }
        }
        j = j + 1;
      }
    }
  }
  return bs;
}

fn bx_bin_names(bs: BinSet*) -> StrList* {
  var l: StrList* = sl_new();
  var i: int64 = 0;
  while (i < bs->n) {
    sl_push(l, bs->items[i].name);
    i = i + 1;
  }
  return l;
}

fn bx_no_bins(p: Project*) {
  if (!p->has_manifest) {
    fail_hint("nothing to build in " + bx_show(p->root) + ": no mbuild.mettle and no .mettle file with fn main", "run `mbuild init` to start a project here, or cd into one");
  }
  fail_hint("no program to build in " + bx_show(p->root), "add src/main.mettle (with fn main), cmd/NAME/main.mettle, or mb_bin(\"NAME\", \"path.mettle\") in mbuild.mettle");
}

fn bx_is_lib_file(name: string) -> bool {
  return s_ends(name, ".mettle") && !s_ends(name, "_test.mettle") && !s_starts(name, "test_");
}

// A library package (a manifest, no bins): its top-level, src/ and import
// root .mettle files but the project files, each one an entry for `check`.
// Empty for anything else.
fn bx_lib_set(p: Project*) -> BinSet* {
  var bs: BinSet* = new BinSet;
  bs->items = (BinInfo*)0;
  bs->n = 0;
  bs->root = p->root;
  if (!p->has_manifest || build_bins(p)->n > 0) {
    return bs;
  }
  var subs: StrList* = sl_of("");
  sl_push(subs, "src");
  sl_add_uniq(subs, p->man->import_root);
  var si: int64 = 0;
  while (si < subs->len) {
    var sub: string = sl_get(subs, si);
    var dir: string = p->root;
    var prefix: string = "";
    if (slen(sub) > 0) {
      dir = p->root + "/" + sub;
      prefix = sub + "/";
    }
    var files: StrList* = sl_new();
    var dirs: StrList* = sl_new();
    if (sys_list_dir(dir, files, dirs)) {
      sl_sort(files);
      var i: int64 = 0;
      while (i < files->len) {
        var f: string = sl_get(files, i);
        if (bx_is_lib_file(f) && !(slen(sub) == 0 && (s_eq(f, "mbuild.mettle") || s_eq(f, "mbuild.local.mettle")))) {
          var rel: string = prefix + f;
          bx_binset_push(bs, s_sub(rel, 0, slen(rel) - 7), rel);
        }
        i = i + 1;
      }
    }
    free(files);
    free(dirs);
    si = si + 1;
  }
  free(subs);
  return bs;
}

// The bins named in `names` (all when empty); unknown names are errors.
fn bx_select_bins(p: Project*, names: StrList*) -> BinSet* {
  var all: BinSet* = build_bins(p);
  if (all->n == 0) {
    bx_no_bins(p);
  }
  return bx_select_from(p, all, names);
}

fn bx_select_from(p: Project*, all: BinSet*, names: StrList*) -> BinSet* {
  if (names->len == 0) {
    return all;
  }
  var known: StrList* = bx_bin_names(all);
  defer free(known);
  var sel: BinSet* = new BinSet;
  sel->items = (BinInfo*)0;
  sel->n = 0;
  sel->root = p->root;
  var i: int64 = 0;
  while (i < names->len) {
    var nm: string = sl_get(names, i);
    var at: int64 = sl_index(known, nm);
    if (at < 0) {
      var hint: string = "the bins are: " + sl_join(known, ", ");
      var sug: string = man_suggest(nm, known);
      if (slen(sug) > 0) {
        hint = "did you mean `" + sug + "`? " + hint;
      }
      fail_hint("no bin named `" + nm + "`", hint);
    }
    bx_binset_push(sel, nm, all->items[at].main);
    sel->items[sel->n - 1].flags = all->items[at].flags;
    sel->items[sel->n - 1].kind = all->items[at].kind;
    sel->items[sel->n - 1].triple = all->items[at].triple;
    i = i + 1;
  }
  return sel;
}

// all: the targets mb_targets declares, else linux and windows.
fn bx_add_target(p: Project*, l: StrList*, t: string) {
  if (s_eq(t, "all")) {
    if (p->man->targets->len == 0) {
      sl_add_uniq(l, "linux");
      sl_add_uniq(l, "windows");
    }
    var i: int64 = 0;
    while (i < p->man->targets->len) {
      sl_add_uniq(l, sl_get(p->man->targets, i));
      i = i + 1;
    }
  } else if (s_eq(t, "host")) {
    sl_add_uniq(l, sys_os());
  } else if (target_valid(t)) {
    sl_add_uniq(l, t);
  } else {
    var names: string = target_names() + " all host";
    var opts: StrList* = s_split(names, 32);
    defer free(opts);
    var hint: string = "the targets are " + sl_join(opts, ", ");
    var sug: string = man_suggest(t, opts);
    if (slen(sug) > 0) {
      hint = "did you mean `" + sug + "`? " + hint;
    }
    fail_hint("unknown target `" + t + "`", hint);
  }
}

// -t values, else [build] targets, else the host.
export fn build_targets(p: Project*) -> StrList* {
  var l: StrList* = sl_new();
  var src: StrList* = p->opts->targets;
  if (src->len == 0) {
    src = p->man->targets;
  }
  var i: int64 = 0;
  while (i < src->len) {
    bx_add_target(p, l, sl_get(src, i));
    i = i + 1;
  }
  if (l->len == 0) {
    sl_push(l, sys_os());
  }
  return l;
}

// -t values, else the host only (commands that act on one compiler).
fn bx_targets_or_host(p: Project*) -> StrList* {
  var l: StrList* = sl_new();
  var i: int64 = 0;
  while (i < p->opts->targets->len) {
    bx_add_target(p, l, sl_get(p->opts->targets, i));
    i = i + 1;
  }
  if (l->len == 0) {
    sl_push(l, sys_os());
  }
  return l;
}

export fn build_profile(p: Project*) -> string {
  var prof: string = p->opts->profile;
  if (slen(prof) == 0) {
    prof = "debug";
  }
  if (p->opts->release) {
    prof = "release";
  }
  if (!man_has_profile(p->man, prof)) {
    var known: StrList* = sl_of("debug");
    sl_push(known, "release");
    var secs: StrList* = toml_sections(p->man->doc, "profile.");
    var i: int64 = 0;
    while (i < secs->len) {
      sl_add_uniq(known, s_from(sl_get(secs, i), 8));
      i = i + 1;
    }
    free(secs);
    var hint: string = "the profiles are: " + sl_join(known, ", ") + " (add mb_profile(\"" + prof + "\") to mbuild.mettle)";
    var sug: string = man_suggest(prof, known);
    if (slen(sug) > 0) {
      hint = "did you mean `" + sug + "`? " + hint;
    }
    fail_hint("unknown profile `" + prof + "`", hint);
    free(known);
  }
  return prof;
}

// ---------------------------------------------------------------------------
// Sessions: dependencies, compilers, components, hooks, import graphs
// ---------------------------------------------------------------------------

fn bx_fill_dirs(m: Mettle*) {
  var exe: string = m->path;
  if (s_find_byte(exe, 47) < 0 && s_find_byte(exe, 92) < 0) {
    exe = m->tool.path;
  }
  exe = bx_slash(exe);
  var dir: string = p_dir(exe);
  if (slen(m->stdlib_dir) == 0) {
    var up: string = p_clean(p_join(dir, "../stdlib"));
    if (fs_is_dir(up)) {
      m->stdlib_dir = up;
    } else if (fs_is_dir(p_join(dir, "stdlib"))) {
      m->stdlib_dir = p_join(dir, "stdlib");
    }
  }
  if (slen(m->runtime_dir) == 0) {
    var rup: string = p_clean(p_join(dir, "../runtime"));
    if (fs_is_dir(rup)) {
      m->runtime_dir = rup;
    } else if (fs_is_dir(p_join(dir, "runtime"))) {
      m->runtime_dir = p_join(dir, "runtime");
    }
  }
}

fn bx_mettle(p: Project*, target: string) -> Mettle* {
  var m: Mettle* = tc_select(p, target);
  bx_fill_dirs(m);
  return m;
}

// Dependencies, then the AGENT.rules block that points at them (16.3).
fn bx_deps(p: Project*) -> DepState* {
  var ds: DepState* = deps_ensure(p);
  g_bx_ds = ds;
  agt_refresh(p, ds);
  return ds;
}

fn bx_sess(p: Project*, targets: StrList*) -> BxSess* {
  return bx_sess_x(p, targets, true);
}

// "first line\n  help: rest" (a message with its help) as error and help.
fn bx_fail_text(e: string) {
  var at: int64 = s_find(e, "\n  help: ");
  if (at < 0) {
    fail(e);
  }
  fail_hint(s_sub(e, 0, at), s_from(e, at + 9));
}

// Names of every component of the build (root and dependencies).
fn bx_comp_names(p: Project*, ds: DepState*) -> StrList* {
  var l: StrList* = sl_new();
  var all: CompSpec** = cmp_all(p, ds);
  var i: int64 = 0;
  while (all[i] != (CompSpec*)0) {
    sl_add_uniq(l, all[i]->name);
    i = i + 1;
  }
  free(all);
  return l;
}

// check_min: fail when a compiler is older than a package needs (12.11).
fn bx_sess_x(p: Project*, targets: StrList*, check_min: bool) -> BxSess* {
  var s: BxSess* = new BxSess;
  s->p = p;
  s->targets = targets;
  s->profile = build_profile(p);
  s->ds = bx_deps(p);
  s->host_m = (Mettle*)0;
  s->hooks_run = sl_new();
  s->dep = s_empty();
  s->app = p;
  s->app_profile = s->profile;
  s->tests = false;
  s->mettles = (Mettle**)malloc((targets->len + 1) * 8);
  var i: int64 = 0;
  while (i < targets->len) {
    s->mettles[i] = bx_mettle(p, sl_get(targets, i));
    if (s_eq(sl_get(targets, i), sys_os())) {
      s->host_m = s->mettles[i];
    }
    i = i + 1;
  }
  i = 0;
  while (check_min && i < targets->len) {
    var e: string = deps_mettle_check(p, s->ds, s->mettles[i]);
    if (slen(e) > 0) {
      bx_fail_text(e);
    }
    i = i + 1;
  }
  bx_sess_comps(s);
  return s;
}

fn bx_sess_comps(s: BxSess*) {
  s->comps = bx_comp_names(s->p, s->ds);
  s->has_cmp = s->comps->len > 0 || s->p->man->rules->len > 0;
  var i: int64 = 0;
  while (s->comps->len == 0 && i < s->p->opts->uses->len) {
    var u: string = sl_get(s->p->opts->uses, i);
    var eq: int64 = s_find_byte(u, 61);
    if (eq > 0) {
      u = s_sub(u, 0, eq);
    }
    fail("--use " + sl_get(s->p->opts->uses, i) + ": this build has no component named " + u);
  }
}

// The compiler that builds freestanding bins: the host's (15.7).
fn bx_host_mettle(s: BxSess*) -> Mettle* {
  if (s->host_m == (Mettle*)0) {
    s->host_m = bx_mettle(s->p, sys_os());
  }
  return s->host_m;
}

fn bx_freestanding(b: BinInfo*) -> bool {
  return b != (BinInfo*)0 && s_ends(b->triple, "-none");
}

// One compile: a bin or a file for one target, with its component selection.
struct BxUnit {
  b: BinInfo*;       // 0 for a file that is no bin (tests, library checks)
  file: string;      // absolute source entry
  ti: int64;         // session target index, -1 for a freestanding bin
  target: string;    // "linux" | "windows" | the freestanding triple
  m: Mettle*;
  cmp: CmpOut*;      // 0 when the build has no components and no rules
  entry: string;     // what the compiler gets: file, or the rules wrapper
  g: Graph*;
  job: BxJob*;       // set by bx_compile_units
}

struct BxUnits {
  items: BxUnit**;
  n: int64;
}

fn bx_units_new() -> BxUnits* {
  var us: BxUnits* = new BxUnits;
  us->items = (BxUnit**)0;
  us->n = 0;
  return us;
}

fn bx_unit_add(us: BxUnits*, b: BinInfo*, file: string, ti: int64, target: string, m: Mettle*) {
  var u: BxUnit* = new BxUnit;
  u->b = b;
  u->file = file;
  u->ti = ti;
  u->target = target;
  u->m = m;
  u->cmp = (CmpOut*)0;
  u->entry = file;
  u->g = (Graph*)0;
  u->job = (BxJob*)0;
  us->items = (BxUnit**)realloc(us->items, (us->n + 1) * 8);
  us->items[us->n] = u;
  us->n = us->n + 1;
}

// Every bin for every session target; a freestanding bin once, by the host
// compiler, whatever -t says.
fn bx_bin_units(s: BxSess*, bs: BinSet*) -> BxUnits* {
  var us: BxUnits* = bx_units_new();
  var ci: int64 = 0;
  while (ci < bs->n) {
    bx_check_bin(s, &bs->items[ci]);
    ci = ci + 1;
  }
  var ti: int64 = 0;
  while (ti < s->targets->len) {
    var bi: int64 = 0;
    while (bi < bs->n) {
      var b: BinInfo* = &bs->items[bi];
      if (!bx_freestanding(b)) {
        bx_check_kind(b, sl_get(s->targets, ti));
        bx_unit_add(us, b, b->entry, ti, sl_get(s->targets, ti), s->mettles[ti]);
      }
      bi = bi + 1;
    }
    ti = ti + 1;
  }
  var fi: int64 = 0;
  while (fi < bs->n) {
    var fb: BinInfo* = &bs->items[fi];
    if (bx_freestanding(fb)) {
      bx_check_kind(fb, fb->triple);
      bx_unit_add(us, fb, fb->entry, -1, fb->triple, bx_host_mettle(s));
    }
    fi = fi + 1;
  }
  return us;
}

// A bin that cannot be built as declared stops the command (15.7).
fn bx_check_bin(s: BxSess*, b: BinInfo*) {
  var i: int64 = 0;
  while (i < s->p->man->nbins) {
    var spec: BinSpec* = man_bin(s->p->man, i);
    if (s_eq(spec->name, b->name)) {
      var os: string = sl_get(s->targets, 0);
      if (bx_freestanding(b)) {
        os = b->triple;
      }
      var why: string = cmp_bin_problem(s->p, spec, bx_settings_of(s->p, s->profile, b->name, os));
      if (slen(why) > 0) {
        fail(why);
      }
      return;
    }
    i = i + 1;
  }
}

// The component selection of every unit (15.5, 15.6); errors stop the command.
fn bx_components(s: BxSess*, us: BxUnits*, bin_for_files: string) {
  if (!s->has_cmp) {
    return;
  }
  var i: int64 = 0;
  while (i < us->n) {
    bx_unit_cmp(s, us->items[i], bin_for_files);
    i = i + 1;
  }
}

fn bx_unit_cmp(s: BxSess*, u: BxUnit*, bin_for_files: string) {
  if (!s->has_cmp) {
    return;
  }
  var cb: CmpBuild* = new CmpBuild;
  cb->target = u->target;
  cb->profile = s->profile;
  cb->bin = bin_for_files;
  if (u->b != (BinInfo*)0 && slen(bin_for_files) == 0) {
    cb->bin = s_replace_byte(u->b->name, 47, 95);
    if (s->tests) {
      cb->bin = "test-" + cb->bin;
    }
  }
  cb->entry = u->file;
  cb->settings = bx_settings_of(s->p, s->profile, bx_unit_bin(u), u->target);
  var co: CmpOut* = cmp_prepare(s->p, s->ds, cb);
  free(cb);
  if (!co->ok) {
    error_msg(co->err);
    exit_with(1);
  }
  u->cmp = co;
  if (slen(co->entry) > 0) {
    u->entry = co->entry;
  }
}

fn bx_unit_bin(u: BxUnit*) -> string {
  if (u->b == (BinInfo*)0) {
    return s_empty();
  }
  return u->b->name;
}

// The OS a unit's import guards see: "linux" for riscv*-linux, "none" for a
// freestanding triple or a board image.
fn bx_unit_os(u: BxUnit*) -> string {
  return target_os(u->target);
}

// A kind the target cannot build stops the command.
fn bx_check_kind(b: BinInfo*, target: string) {
  if (s_eq(b->kind, "shared") && target_is_riscv(target)) {
    fail_hint("bin " + b->name + " is a shared library, and " + target + " builds static executables and objects only", "build it with -t linux or -t windows");
  }
  if (s_eq(b->kind, "object") && target_is_bare(target)) {
    fail_hint("bin " + b->name + " is an object, and " + target + " writes board images only", "build it with -t riscv32-linux or -t riscv64-linux, whose objects link the same way");
  }
}

// A board image: an exe or flat bin for riscv32-none or riscv64-none.
fn bx_is_image(u: BxUnit*) -> bool {
  return u->b != (BinInfo*)0 && (s_eq(u->b->kind, "exe") || s_eq(u->b->kind, "flat")) && target_is_bare(u->target);
}

fn bx_unit_gen(u: BxUnit*) -> string {
  if (u->cmp == (CmpOut*)0) {
    return s_empty();
  }
  return u->cmp->gen_dir;
}

// The hooks mbuild.mettle defines ("pre_build", "post_build").
fn bx_has_hook(p: Project*, name: string) -> bool {
  if (slen(p->mbfile) == 0 || p->opts->no_hooks) {
    return false;
  }
  if (g_bx_info == (MbfInfo*)0) {
    g_bx_info = cfg_info(p);
  }
  return sl_has(g_bx_info->hooks, name) || sl_has(g_bx_info->hooks, "hook_" + name);
}

// Runs hook_NAME once per (target, profile) of the command (13.7);
// cfg_run_hook prints the Running line and the failure.
fn bx_hook(s: BxSess*, name: string, target: string, out_dir: string, bins: StrList*, built: StrList*) {
  var p: Project* = s->p;
  if (!bx_has_hook(p, name)) {
    return;
  }
  var key: string = name + " " + target + " " + s->profile;
  if (sl_has(s->hooks_run, key)) {
    return;
  }
  sl_push(s->hooks_run, key);
  var h: CfgHook* = new CfgHook;
  h->name = name;
  h->target = target;
  h->profile = s->profile;
  h->out_dir = out_dir;
  h->bins = bins;
  h->built = built;
  var rc: int32 = cfg_run_hook(p, h);
  free(h);
  if (rc != 0) {
    exit_with(1);
  }
}

fn bx_unit_out_dir(s: BxSess*, target: string) -> string {
  return s->p->root + "/build/" + target + "/" + s->profile;
}

// The bins of the units for one target.
fn bx_unit_bins(us: BxUnits*, target: string) -> StrList* {
  var l: StrList* = sl_new();
  var i: int64 = 0;
  while (i < us->n) {
    var u: BxUnit* = us->items[i];
    if (s_eq(u->target, target) && u->b != (BinInfo*)0) {
      sl_add_uniq(l, u->b->name);
    }
    i = i + 1;
  }
  return l;
}

// The targets of the units, in order.
fn bx_unit_targets(us: BxUnits*) -> StrList* {
  var l: StrList* = sl_new();
  var i: int64 = 0;
  while (i < us->n) {
    sl_add_uniq(l, us->items[i]->target);
    i = i + 1;
  }
  return l;
}

fn bx_pre_hooks(s: BxSess*, us: BxUnits*) {
  if (!bx_has_hook(s->p, "pre_build")) {
    return;
  }
  var ts: StrList* = bx_unit_targets(us);
  var i: int64 = 0;
  while (i < ts->len) {
    var t: string = sl_get(ts, i);
    bx_hook(s, "pre_build", t, bx_unit_out_dir(s, t), bx_unit_bins(us, t), sl_new());
    i = i + 1;
  }
  free(ts);
}

// built: "target bin" of every unit that was compiled.
fn bx_post_hooks(s: BxSess*, us: BxUnits*, built: StrList*) {
  if (!bx_has_hook(s->p, "post_build")) {
    return;
  }
  var ts: StrList* = bx_unit_targets(us);
  var i: int64 = 0;
  while (i < ts->len) {
    var t: string = sl_get(ts, i);
    var mine: StrList* = sl_new();
    var k: int64 = 0;
    while (k < built->len) {
      if (s_starts(sl_get(built, k), t + " ")) {
        sl_push(mine, s_from(sl_get(built, k), slen(t) + 1));
      }
      k = k + 1;
    }
    bx_hook(s, "post_build", t, bx_unit_out_dir(s, t), bx_unit_bins(us, t), mine);
    i = i + 1;
  }
  free(ts);
}

fn bx_unit_ctx(s: BxSess*, u: BxUnit*) -> GraphCtx* {
  var c: GraphCtx* = graph_ctx_new(bx_unit_os(u), u->m->stdlib_dir);
  var gen: string = bx_unit_gen(u);
  if (slen(gen) > 0) {
    sl_push(c->includes, gen);
  }
  sl_push(c->includes, s->ds->include_dir);
  c->cwd = s->p->root;
  return c;
}

fn bx_graphs(s: BxSess*, us: BxUnits*) {
  var i: int64 = 0;
  while (i < us->n) {
    var u: BxUnit* = us->items[i];
    var c: GraphCtx* = bx_unit_ctx(s, u);
    u->g = graph_build(c, u->entry);
    free(c);
    i = i + 1;
  }
}

fn bx_first_component(imp: string) -> string {
  var cut: int64 = 0;
  while (cut < slen(imp) && s_byte(imp, cut) != 47 && s_byte(imp, cut) != 92) {
    cut = cut + 1;
  }
  return s_sub(imp, 0, cut);
}

// The selected dependency an import names by its first component, -1.
fn bx_dep_of_import(ds: DepState*, imp: string) -> int64 {
  var first: string = bx_first_component(imp);
  if (slen(first) >= slen(imp)) {
    return -1;
  }
  var i: int64 = 0;
  while (i < ds->n) {
    if (s_eq(ds->mods[i].module, first)) {
      return i;
    }
    i = i + 1;
  }
  return -1;
}

// What follows the dependency's name in the import ("" for the package itself).
fn bx_rest_in_dep(dm: DepModule*, imp: string) -> string {
  if (slen(imp) <= slen(dm->module) + 1) {
    return s_empty();
  }
  return s_from(imp, slen(dm->module) + 1);
}

// The package an unresolved import may name (14.5): "NAME/FILE" with a
// valid, unreserved package name that is no component and no directory next
// to the importing file; "" otherwise.
fn bx_import_package(s: BxSess*, from: string, imp: string) -> string {
  var first: string = bx_first_component(imp);
  if (slen(first) >= slen(imp) || !man_is_package_name(first)) {
    return s_empty();
  }
  if (s_eq(first, "std") || s_eq(first, "mbuild") || sl_has(s->comps, first)) {
    return s_empty();
  }
  if (fs_is_dir(p_join(p_dir(from), first))) {
    return s_empty();
  }
  return first;
}

// Packages named by imports that did not resolve and that are not selected
// already (an import into a selected package is a wrong file name).
fn bx_missing_packages(s: BxSess*, us: BxUnits*) -> StrList* {
  var names: StrList* = sl_new();
  var i: int64 = 0;
  while (i < us->n) {
    var g: Graph* = us->items[i]->g;
    var k: int64 = 0;
    while (k < g->missing->len) {
      var imp: string = sl_get(g->missing, k);
      if (s_eq(sl_get(g->missing_kinds, k), "import") && bx_dep_of_import(s->ds, imp) < 0) {
        var name: string = bx_import_package(s, sl_get(g->missing_from, k), imp);
        if (slen(name) > 0) {
          sl_add_uniq(names, name);
        }
      }
      k = k + 1;
    }
    i = i + 1;
  }
  sl_sort(names);
  return names;
}

// The .mettle files (stems) directly in dir.
fn bx_mettle_stems(dir: string) -> StrList* {
  var stems: StrList* = sl_new();
  var files: StrList* = sl_new();
  var dirs: StrList* = sl_new();
  if (sys_list_dir(dir, files, dirs)) {
    sl_sort(files);
    var i: int64 = 0;
    while (i < files->len) {
      var f: string = sl_get(files, i);
      if (s_ends(f, ".mettle")) {
        sl_push(stems, s_sub(f, 0, slen(f) - 7));
      }
      i = i + 1;
    }
  }
  free(files);
  free(dirs);
  return stems;
}

fn bx_dir_is_empty(dir: string) -> bool {
  var files: StrList* = sl_new();
  var dirs: StrList* = sl_new();
  var listed: bool = sys_list_dir(dir, files, dirs);
  var empty: bool = !listed || files->len + dirs->len == 0;
  free(files);
  free(dirs);
  return empty;
}

// Whether the manifest m, or a package it requires (through ds), declares
// the dependency target; seen guards cycles.
fn bx_reaches(ds: DepState*, m: Manifest*, target: string, seen: StrList*) -> bool {
  var i: int64 = 0;
  while (i < m->ndeps) {
    var d: DepSpec* = man_dep(m, i);
    i = i + 1;
    if (s_eq(d->key, target)) {
      return true;
    }
    if (sl_has(seen, d->key)) {
      continue;
    }
    sl_push(seen, d->key);
    var k: int64 = 0;
    while (k < ds->n) {
      var dm: DepModule* = &ds->mods[k];
      k = k + 1;
      if (s_eq(dm->module, d->key) && dm->man != (Manifest*)0 && bx_reaches(ds, dm->man, target, seen)) {
        return true;
      }
    }
  }
  return false;
}

// An import of a package that is in the resolved graph but that the importing
// package (the project or one of its path packages) does not declare: says
// how it got there and what to add. False when the case does not apply.
fn bx_report_undeclared(s: BxSess*, loc: string, file: string, imp: string, dm: DepModule*) -> bool {
  var ds: DepState* = s->ds;
  var owner: string = s->p->man->name;
  var owner_dir: string = s->p->root;
  var owner_man: Manifest* = s->p->man;
  var at: int64 = bx_dep_of_file(ds, file);
  if (at >= 0) {
    if (!ds->mods[at].is_path) {
      return false;
    }
    owner = ds->mods[at].module;
    owner_dir = ds->mods[at].dir;
    owner_man = ds->mods[at].man;
  } else if (!s->p->has_manifest) {
    return false;
  }
  if (owner_man == (Manifest*)0 || s_eq(owner, dm->module) || man_dep_find(owner_man, dm->module) != (DepSpec*)0) {
    return false;
  }
  if (slen(owner) == 0) {
    owner = p_base(owner_dir);
  }
  var via: string = s_empty();
  var i: int64 = 0;
  while (i < owner_man->ndeps && slen(via) == 0) {
    var d: DepSpec* = man_dep(owner_man, i);
    i = i + 1;
    var seen: StrList* = sl_new();
    sl_push(seen, d->key);
    var k: int64 = 0;
    while (k < ds->n && slen(via) == 0) {
      var vm: DepModule* = &ds->mods[k];
      k = k + 1;
      if (s_eq(vm->module, d->key) && vm->man != (Manifest*)0 && bx_reaches(ds, vm->man, dm->module, seen)) {
        via = d->key;
      }
    }
    free(seen);
  }
  var what: string = "";
  var call: string = "";
  if (dm->is_path || slen(dm->version) == 0) {
    var rel: string = dx_rel(owner_dir, dm->dir);
    if (s_starts(rel, "./")) {
      rel = s_from(rel, 2);
    }
    what = "path " + rel;
    call = "mb_dep_path(\"" + dm->module + "\", \"" + rel + "\");";
  } else {
    what = dm->version;
    call = "mb_dep(\"" + dm->module + "\", \"" + dm->version + "\");";
  }
  error_msg(loc + ": " + dm->module + " is imported here but isn't a dependency of " + owner);
  if (slen(via) > 0) {
    err_line("  " + cyan("note") + ": it reaches " + owner + " through " + via + " (" + what + ")");
  }
  err_line("  " + cyan("help") + ": add to fn deps(): " + call);
  return true;
}

// An import into a selected dependency that names no file: says what is
// there instead.
fn bx_report_bad_file(loc: string, imp: string, dm: DepModule*) {
  var rest: string = bx_rest_in_dep(dm, imp);
  var ver: string = dm->version;
  if (dm->is_path) {
    ver = "path " + bx_show(dm->dir);
  }
  var who: string = dm->module + " (" + ver + ")";
  var top: string = man_import_dir(dm->man, dm->dir);
  var target: string = top;
  if (slen(rest) > 0) {
    target = top + "/" + rest;
  }
  if (!fs_is_dir(dm->dir) || bx_dir_is_empty(dm->dir)) {
    error_msg(loc + ": cannot find `" + imp + "`: the copy of " + who + " is missing or empty");
    err_line("  " + cyan("help") + ": the copy in " + bx_show(dm->dir) + " looks damaged; run `mbuild fetch --force`");
    return;
  }
  var base: string = imp;
  if (s_ends(base, "/")) {
    base = s_sub(base, 0, slen(base) - 1);
  }
  if (fs_is_dir(target)) {
    var inside: StrList* = bx_mettle_stems(target);
    var what: string = "the package directory";
    if (slen(rest) > 0) {
      what = "a directory";
    }
    error_msg(loc + ": cannot import `" + imp + "`: it is " + what + " of " + who + ", not a file");
    if (inside->len > 0) {
      err_line("  " + cyan("help") + ": import one of its files, e.g. `import \"" + base + "/" + sl_get(inside, 0) + "\";` (files: " + sl_join(inside, ".mettle, ") + ".mettle)");
    } else {
      err_line("  " + cyan("help") + ": it holds no .mettle file; import a file below it");
    }
    free(inside);
    return;
  }
  var sub: string = p_dir(rest);
  var file: string = p_base(rest);
  var dir: string = top;
  var prefix: string = s_sub(base, 0, slen(base) - slen(file));
  var wanted: string = rest + ".mettle";
  if (s_ends(file, ".mettle")) {
    file = s_sub(file, 0, slen(file) - 7);
    wanted = rest;
  }
  if (slen(sub) > 0 && !s_eq(sub, ".")) {
    dir = top + "/" + sub;
  }
  error_msg(loc + ": cannot find `" + imp + "`: " + who + " has no file '" + wanted + "'");
  if (!fs_is_dir(dir)) {
    err_line("  " + cyan("help") + ": " + who + " has no directory '" + sub + "'");
    return;
  }
  var stems: StrList* = bx_mettle_stems(dir);
  if (stems->len == 0) {
    err_line("  " + cyan("help") + ": there is no .mettle file in " + bx_show(dir));
    free(stems);
    return;
  }
  var sug: string = man_suggest(file, stems);
  if (slen(sug) > 0) {
    err_line("  " + cyan("help") + ": did you mean `" + prefix + sug + "`?");
  }
  err_line("  " + cyan("note") + ": the .mettle files there: " + sl_join(stems, ".mettle, ") + ".mettle");
  free(stems);
}

// Components, the pre-build hook, then every unit's graph. Missing packages
// are added (unless --locked/--offline; one no registry has is left to the
// compiler's E0006); an import into a selected package that names no file
// stops the command with file:line. bin_for_files names the gen dir of
// units without a bin ("test").
fn bx_prepare(s: BxSess*, us: BxUnits*, bin_for_files: string) {
  var p: Project* = s->p;
  bx_components(s, us, bin_for_files);
  bx_pre_hooks(s, us);
  bx_graphs(s, us);
  var missing: StrList* = bx_missing_packages(s, us);
  if (missing->len > 0 && !p->opts->locked && !p->opts->offline) {
    if (deps_add_missing(p, missing)) {
      bx_reload(p);
      s->ds = bx_deps(p);
      bx_sess_comps(s);
      bx_components(s, us, bin_for_files);
      bx_graphs(s, us);
      free(missing);
      missing = bx_missing_packages(s, us);
    }
  }
  var shown: StrList* = sl_new();
  var bad_files: int64 = 0;
  var i: int64 = 0;
  while (i < us->n) {
    var g: Graph* = us->items[i]->g;
    var k: int64 = 0;
    while (k < g->missing->len) {
      var imp: string = sl_get(g->missing, k);
      var loc: string = bx_show(sl_get(g->missing_from, k)) + ":" + sl_get(g->missing_lines, k);
      var at: int64 = bx_dep_of_import(s->ds, imp);
      if (s_eq(sl_get(g->missing_kinds, k), "import") && at >= 0 && !sl_has(shown, loc + imp)) {
        sl_push(shown, loc + imp);
        if (!bx_report_undeclared(s, loc, sl_get(g->missing_from, k), imp, &s->ds->mods[at])) {
          bx_report_bad_file(loc, imp, &s->ds->mods[at]);
        }
        bad_files = bad_files + 1;
      }
      k = k + 1;
    }
    i = i + 1;
  }
  free(shown);
  if (bad_files > 0) {
    exit_with(1);
  }
  if (missing->len > 0 && (p->opts->locked || p->opts->offline)) {
    var why: string = " (--locked stops mbuild from adding them)";
    if (!p->opts->locked) {
      why = " (--offline stops mbuild from adding them)";
    }
    fail_hint("missing dependencies" + why, "run `mbuild get " + sl_join(missing, "` / `mbuild get ") + "`");
  }
  free(missing);
}

// ---------------------------------------------------------------------------
// Compiling
// ---------------------------------------------------------------------------

// -I for the unit's gen dir (when it has one), then for .mbuild/deps.
fn bx_add_include(c: Cmd*, p: Project*, ds: DepState*, gen: string) {
  if (slen(gen) > 0) {
    cmd_arg(c, "-I");
    cmd_path(c, bx_rel(p, gen));
  }
  cmd_arg(c, "-I");
  cmd_path(c, bx_rel(p, ds->include_dir));
}

// A manifest message names the file by its absolute path: show it from the root.
fn bx_unroot(p: Project*, msg: string) -> string {
  var pre: string = p->root + "/";
  return s_replace(msg, pre, "");
}

// The build settings of one compile (12.12); problems stop the command.
fn bx_settings_of(p: Project*, prof: string, bin: string, target: string) -> Settings* {
  var q: SettingsQuery* = new SettingsQuery;
  q->profile = prof;
  q->bin = bin;
  q->target = target;
  q->sets = p->opts->sets;
  var mode: string = bx_pgo_mode(p);
  if (slen(mode) > 0) {
    q->sets = sl_copy(p->opts->sets);
    if (s_eq(mode, "gen")) {
      sl_push(q->sets, "pgo=instrument");
    } else {
      sl_push(q->sets, "pgo=use");
    }
    sl_push(q->sets, "pgo-file=" + bx_pgo_file(p, bin, target));
  }
  var st: Settings* = man_settings(p->man, q);
  free(q);
  if (slen(st->error) > 0) {
    fail(bx_unroot(p, st->error));
  }
  if (g_bx_seen_warn == (StrList*)0) {
    g_bx_seen_warn = sl_new();
  }
  var i: int64 = 0;
  while (i < st->warnings->len) {
    var w: string = bx_unroot(p, sl_get(st->warnings, i));
    if (!sl_has(g_bx_seen_warn, w)) {
      sl_push(g_bx_seen_warn, w);
      warn(w);
    }
    i = i + 1;
  }
  return st;
}

// --pgo-gen: "gen", --pgo-use[=FILE]: "use", else "".
fn bx_pgo_mode(p: Project*) -> string {
  var mode: string = s_empty();
  var i: int64 = 0;
  while (i < p->opts->rest->len) {
    var a: string = sl_get(p->opts->rest, i);
    if (s_eq(a, "--pgo-gen")) {
      if (s_eq(mode, "use")) {
        fail("--pgo-gen and --pgo-use don't go together: --pgo-gen builds the program that records the profile, --pgo-use the one that reads it");
      }
      mode = "gen";
    } else if (s_eq(a, "--pgo-use") || s_starts(a, "--pgo-use=")) {
      if (s_eq(mode, "gen")) {
        fail("--pgo-gen and --pgo-use don't go together: --pgo-gen builds the program that records the profile, --pgo-use the one that reads it");
      }
      mode = "use";
    }
    i = i + 1;
  }
  return mode;
}

// The profile of a bin on a target: --pgo-use=FILE (from the working
// directory), else .mbuild/pgo/<bin>-<target>.prof.
fn bx_pgo_file(p: Project*, bin: string, target: string) -> string {
  var i: int64 = 0;
  while (i < p->opts->rest->len) {
    var a: string = sl_get(p->opts->rest, i);
    if (s_starts(a, "--pgo-use=") && slen(a) > 10) {
      return p_clean(p_join(bx_cwd(), bx_slash(s_from(a, 10))));
    }
    i = i + 1;
  }
  var name: string = bin;
  if (slen(name) == 0) {
    name = p->man->name;
  }
  return p->state_dir + "/pgo/" + bx_safe_name(name) + "-" + target + ".prof";
}

// The typed key behind a flag that v0.17.0 lacks, "" for any other flag.
fn bx_typed_key(flag: string) -> string {
  if (s_eq(flag, "--check-overflow")) { return "check-overflow"; }
  if (s_eq(flag, "--check-proofs")) { return "check-proofs"; }
  if (s_eq(flag, "--check-effects")) { return "check-effects"; }
  if (s_eq(flag, "--check-deadlines")) { return "check-deadlines"; }
  if (s_eq(flag, "--check-tasks")) { return "check-tasks"; }
  if (s_eq(flag, "--assume-no-signed-overflow")) { return "assume-no-signed-overflow"; }
  if (s_eq(flag, "--pgo-gen") || s_starts(flag, "--pgo-use=")) { return "pgo"; }
  return s_empty();
}

fn bx_typed_on(st: Settings*, flag: string) -> bool {
  if (s_eq(flag, "--check-overflow")) { return st->check_overflow; }
  if (s_eq(flag, "--check-proofs")) { return st->check_proofs; }
  if (s_eq(flag, "--check-effects")) { return st->check_effects; }
  if (s_eq(flag, "--check-deadlines")) { return st->check_deadlines; }
  if (s_eq(flag, "--check-tasks")) { return st->check_tasks; }
  if (s_eq(flag, "--assume-no-signed-overflow")) { return st->assume_nso; }
  if (s_eq(flag, "--pgo-gen")) { return s_eq(st->pgo, "instrument"); }
  if (s_starts(flag, "--pgo-use=")) { return s_eq(st->pgo, "use"); }
  return false;
}

fn bx_inherits(m: Manifest*, name: string) -> string {
  var sec: string = "profile." + name;
  var v: string = "";
  if (m->local != (Manifest*)0) {
    v = toml_str(m->local->doc, sec, "inherits");
  }
  if (slen(v) == 0) {
    v = toml_str(m->doc, sec, "inherits");
  }
  if (slen(v) == 0 && !s_eq(name, "debug") && !s_eq(name, "release")) {
    v = "debug";
  }
  return v;
}

// The profile and its ancestors, child first.
fn bx_profile_chain(m: Manifest*, prof: string) -> StrList* {
  var chain: StrList* = sl_new();
  var name: string = prof;
  while (slen(name) > 0 && !sl_has(chain, name) && chain->len < 32) {
    sl_push(chain, name);
    name = bx_inherits(m, name);
  }
  return chain;
}

// Where a typed key of this compile is set: "--set", "[bin.X]", "[profile.X]".
fn bx_key_where(p: Project*, prof: string, bin: string, key: string) -> string {
  var i: int64 = 0;
  while (i < p->opts->sets->len) {
    if (s_starts(sl_get(p->opts->sets, i), key + "=")) {
      return "--set";
    }
    i = i + 1;
  }
  var m: Manifest* = p->man;
  if (slen(bin) > 0 && toml_has(m->doc, "bin." + bin, key)) {
    return "[bin." + bin + "]";
  }
  var chain: StrList* = bx_profile_chain(m, prof);
  var found: string = "[profile." + prof + "]";
  i = 0;
  while (i < chain->len) {
    var sec: string = "profile." + sl_get(chain, i);
    if (m->local != (Manifest*)0 && toml_has(m->local->doc, sec, key)) {
      found = "mbuild.local.mettle (" + sec + ")";
      break;
    }
    if (toml_has(m->doc, sec, key)) {
      found = "[" + sec + "]";
      break;
    }
    i = i + 1;
  }
  free(chain);
  return found;
}

// file:line of the raw flags list holding flag, or "--flag".
fn bx_raw_where(p: Project*, prof: string, bin: string, flag: string) -> string {
  if (sl_has(p->opts->flags, flag)) {
    return "--flag";
  }
  var m: Manifest* = p->man;
  var secs: StrList* = sl_of("build");
  if (slen(bin) > 0) {
    sl_push(secs, "bin." + bin);
  }
  var chain: StrList* = bx_profile_chain(m, prof);
  var i: int64 = 0;
  while (i < chain->len) {
    sl_push(secs, "profile." + sl_get(chain, i));
    i = i + 1;
  }
  free(chain);
  var found: string = "mbuild.mettle";
  i = 0;
  while (i < secs->len) {
    var sec: string = sl_get(secs, i);
    i = i + 1;
    if (m->local != (Manifest*)0 && sl_has(toml_list(m->local->doc, sec, "flags"), flag)) {
      found = "mbuild.local.mettle";
      break;
    }
    if (sl_has(toml_list(m->doc, sec, "flags"), flag)) {
      found = "mbuild.mettle";
      break;
    }
  }
  free(secs);
  return found;
}

// Probes the flags v0.17.0 lacks and every raw flag (once per compiler and
// flag set in a command); an unsupported one stops the command.
fn bx_check_support(s: BxSess*, u: BxUnit*, st: Settings*, flags: StrList*, bin: string) {
  var p: Project* = s->p;
  var m: Mettle* = u->m;
  var target: string = u->target;
  var probe: StrList* = sl_new();
  var i: int64 = 0;
  while (i < flags->len) {
    var f: string = sl_get(flags, i);
    if (slen(bx_typed_key(f)) > 0 && bx_typed_on(st, f)) {
      sl_push(probe, f);
    }
    i = i + 1;
  }
  sl_extend(probe, st->flags);
  sl_extend(probe, p->opts->flags);
  if (probe->len == 0) {
    free(probe);
    return;
  }
  if (g_bx_probed == (StrList*)0) {
    g_bx_probed = sl_new();
  }
  var memo: string = m->id + "|" + sl_join(probe, " ");
  if (sl_has(g_bx_probed, memo)) {
    free(probe);
    return;
  }
  sl_push(g_bx_probed, memo);
  var bad: StrList* = tc_unsupported(m, probe);
  free(probe);
  if (bad->len == 0) {
    free(bad);
    return;
  }
  var ver: string = tc_version(m);
  if (slen(ver) == 0) {
    ver = "version unknown";
  }
  i = 0;
  while (i < bad->len) {
    var f: string = sl_get(bad, i);
    i = i + 1;
    var key: string = bx_typed_key(f);
    if (slen(key) > 0 && bx_typed_on(st, f)) {
      var val: string = "true";
      var off: string = key + " = false";
      if (s_eq(key, "pgo")) {
        val = "\"" + st->pgo + "\"";
        off = "pgo = \"off\"";
      }
      var origin: string = bx_key_where(p, s->profile, bin, key);
      var what: string = origin + " " + key + " = " + val;
      if (s_eq(origin, "--set")) {
        what = "--set " + key + "=" + s_replace(val, "\"", "");
      }
      var fname: string = f;
      if (s_starts(f, "--pgo-use=")) {
        fname = "--pgo-use";
      }
      error_msg(what + " needs a Mettle compiler that has " + fname + "; the " + target + " compiler (" + m->path + ", " + ver + ") does not");
      err_line("  " + cyan("help") + ": install a newer compiler (mbuild toolchain install), or set " + off);
    } else {
      error_msg("flags: the " + target + " compiler does not accept " + f + " (" + bx_raw_where(p, s->profile, bin, f) + ")");
    }
  }
  free(bad);
  exit_with(1);
}

// Adds the compile flags of one bin (0: a file that is no bin) for session
// target ti: typed settings, raw flags, then --flag. Answers the settings.
fn bx_add_flags(c: Cmd*, s: BxSess*, u: BxUnit*) -> Settings* {
  var p: Project* = s->p;
  var bin: string = bx_unit_bin(u);
  var st: Settings* = bx_settings_of(p, s->profile, bin, u->target);
  var flags: StrList* = man_settings_flags(st, u->target);
  sl_extend(flags, p->opts->flags);
  if (u->ti < 0) {
    var kept: StrList* = cmp_freestanding_flags(flags);
    free(flags);
    flags = kept;
  } else if (target_is_riscv(u->target)) {
    var rv_kept: StrList* = bx_riscv_flags(flags);
    free(flags);
    flags = rv_kept;
  }
  var unit_label: string = "bin " + bin;
  if (slen(bin) == 0) {
    unit_label = bx_rel(p, u->file);
  }
  var target_why: string = cmp_target_problem(unit_label, u->target, st);
  if (slen(target_why) > 0) {
    fail(target_why);
  }
  if (bx_is_image(u)) {
    bx_check_board(p, u->m, unit_label, u->target, st);
  }
  bx_check_support(s, u, st, flags, bin);
  if (s_eq(st->pgo, "use") && !fs_is_file(p_join(p->root, st->pgo_file))) {
    fail_hint("pgo-file = \"" + bx_show(p_join(p->root, st->pgo_file)) + "\" does not exist", "record it: mbuild run -p " + s->profile + " --pgo-gen (or mbuild pgo does every step)");
  }
  if (p->man->prelude) {
    cmd_arg(c, "--prelude");
  }
  cmd_args(c, flags);
  free(flags);
  return st;
}

// flags without -s (no crash report on RISC-V, the compiler notes it on
// every compile) and --check-effects (refused: no runtime for the stack).
fn bx_riscv_flags(flags: StrList*) -> StrList* {
  var out: StrList* = sl_new();
  var i: int64 = 0;
  while (i < flags->len) {
    var f: string = sl_get(flags, i);
    if (s_eq(f, "-s") || s_eq(f, "--stack-trace") || s_eq(f, "--check-effects")) {
      verbose("dropping " + f + " for a RISC-V target");
    } else {
      sl_push(out, f);
    }
    i = i + 1;
  }
  return out;
}

// A board image needs a board the compiler has.
fn bx_check_board(p: Project*, m: Mettle*, label: string, target: string, st: Settings*) {
  var boards: StrList* = tc_boards(m);
  var choices: string = sl_join(boards, ", ");
  if (boards->len == 0) {
    choices = "see mettle help riscv";
  }
  if (slen(st->board) == 0) {
    fail_hint(label + ": a " + target + " image needs a board (the compiler's boards: " + choices + ")", "mb_set(\"board\", \"qemu-virt\") after mb_on(\"" + target + "\") in a profile, or after mb_for_bin");
  }
  if (boards->len > 0 && !sl_has(boards, st->board)) {
    var hint: string = "the compiler's boards: " + choices;
    var sug: string = man_suggest(st->board, boards);
    if (slen(sug) > 0) {
      hint = "did you mean `" + sug + "`? " + hint;
    }
    fail_hint(label + ": board = \"" + st->board + "\" is not a board of this compiler (" + m->path + ")", hint);
  }
}

// The recorded profile a pgo = "use" build reads is an input of it.
fn bx_hash_pgo(h: Hasher*, p: Project*, st: Settings*) {
  if (s_eq(st->pgo, "use")) {
    h_str(h, fs_hash_file(p_join(p->root, st->pgo_file)));
  }
}

// An argument as it goes into a fingerprint: the project root (in either
// its own or its wine Z: spelling) replaced by "@root", backslashes as '/'.
fn bx_arg_key(p: Project*, a: string) -> string {
  var k: string = bx_slash(a);
  var root: string = bx_slash(p->root);
  k = s_replace(k, root, "@root");
  if (slen(root) > 3 && s_byte(root, 1) == 58 && (s_byte(root, 0) == 90 || s_byte(root, 0) == 122)) {
    k = s_replace(k, s_from(root, 2), "@root");
  }
  return k;
}

// The compiler's identity without its location: file name, size and
// modification time (whole seconds since 1970, from either host's clock).
fn bx_compiler_key(m: Mettle*) -> string {
  var parts: StrList* = s_split(m->id, 124);
  var n: int64 = parts->len;
  if (n < 3) {
    free(parts);
    return m->id;
  }
  var real: string = sl_get(parts, 0);
  var k: int64 = 1;
  while (k < n - 2) {
    real = real + "|" + sl_get(parts, k);
    k = k + 1;
  }
  var size: string = sl_get(parts, n - 2);
  var mtime: int64 = s_to_int(sl_get(parts, n - 1));
  free(parts);
  var secs: int64 = mtime / 1000000000;
  if (s_eq(sys_os(), "windows")) {
    secs = (mtime - 116444736000000000) / 10000000;
  }
  return s_lower(p_base(bx_slash(real))) + "|" + size + "|" + s_int(secs);
}

// The compiler argv (not the program that runs it, not the environment:
// both differ between a Linux host and wine for the same build).
fn bx_hash_cmd(h: Hasher*, p: Project*, m: Mettle*, c: Cmd*) {
  h_str(h, bx_compiler_key(m));
  var i: int64 = 0;
  if (m->via_wine) {
    i = 1;
  }
  while (i < c->args->len) {
    h_str(h, bx_arg_key(p, sl_get(c->args, i)));
    i = i + 1;
  }
}

fn bx_locale_utf8() -> bool {
  var loc: string = env_get("LC_ALL");
  if (slen(loc) == 0) {
    loc = env_get("LC_CTYPE");
  }
  if (slen(loc) == 0) {
    loc = env_get("LANG");
  }
  var low: string = s_lower(loc);
  return s_contains(low, "utf-8") || s_contains(low, "utf8");
}

// Compiler diagnostics are captured, so the compiler never sees a terminal:
// pass on mbuild's colour decision and whether the terminal shows Unicode.
fn bx_diag_env(c: Cmd*) {
  if (g_color) {
    cmd_env(c, "CLICOLOR_FORCE", "1");
  } else {
    cmd_env(c, "NO_COLOR", "1");
  }
  var uni: bool = false;
  if (s_eq(sys_os(), "windows")) {
    uni = s_eq(env_get("MBUILD_UNICODE"), "1");
  } else {
    uni = (g_color || sys_isatty(2)) && bx_locale_utf8();
  }
  if (uni) {
    cmd_env(c, "METTLE_DIAG_UNICODE", "1");
  }
}

// text without ANSI escape sequences (ESC [ ... final byte).
fn bx_strip_ansi(text: string) -> string {
  if (s_find_byte(text, 27) < 0) {
    return text;
  }
  var b: Buf* = buf_new();
  var i: int64 = 0;
  var n: int64 = slen(text);
  while (i < n) {
    var c: int32 = s_byte(text, i);
    if (c == 27 && i + 1 < n && s_byte(text, i + 1) == 91) {
      i = i + 2;
      while (i < n && !(s_byte(text, i) >= 64 && s_byte(text, i) <= 126)) {
        i = i + 1;
      }
      i = i + 1;
    } else {
      buf_addb(b, c);
      i = i + 1;
    }
  }
  return buf_take(b);
}

// The output of a bin by kind (15.7): <bin><ext>, lib<bin>.so / <bin>.dll,
// <bin>.o / <bin>.obj, <bin>.bin.
fn bx_out_name(b: BinInfo*, target: string) -> string {
  if (s_eq(b->kind, "shared")) {
    if (s_eq(target, "windows")) {
      return b->name + ".dll";
    }
    return "lib" + b->name + ".so";
  }
  if (s_eq(b->kind, "flat") || (s_eq(b->kind, "exe") && target_is_bare(target))) {
    return b->name + ".bin";
  }
  if (s_eq(b->kind, "object") || s_ends(target, "-none")) {
    if (s_eq(target, "windows") || s_contains(b->triple, "-windows")) {
      return b->name + ".obj";
    }
    return b->name + ".o";
  }
  return b->name + target_exe_ext(target);
}

fn bx_out_path(t: TargetCtx*, b: BinInfo*) -> string {
  return t->out_dir + "/" + bx_out_name(b, t->target);
}

// The files a board image writes, by extension: outputs, else bin and elf.
fn bx_image_outputs(st: Settings*) -> StrList* {
  if (slen(st->outputs) == 0) {
    var dflt: StrList* = sl_of("bin");
    sl_push(dflt, "elf");
    return dflt;
  }
  return man_outputs(st->outputs);
}

// The image file the compiler writes first: the first output that is not elf.
fn bx_image_main(st: Settings*) -> string {
  var outs: StrList* = bx_image_outputs(st);
  defer free(outs);
  var i: int64 = 0;
  while (i < outs->len) {
    if (!s_eq(sl_get(outs, i), "elf")) {
      return sl_get(outs, i);
    }
    i = i + 1;
  }
  return "bin";
}

fn bx_remove_intermediates(out: string) {
  sys_remove_file(out + ".o");
  sys_remove_file(out + ".obj");
  var ext: string = p_ext(out);
  if (s_eq(ext, ".exe") || s_eq(ext, ".so") || s_eq(ext, ".dll")) {
    var stem: string = s_sub(out, 0, slen(out) - slen(ext));
    sys_remove_file(stem + ".o");
    sys_remove_file(stem + ".obj");
  }
}

fn bx_stamp_ok(p: Project*, stamp: string, fp: string) -> bool {
  if (p->opts->force) {
    return false;
  }
  var rd: FsRead = fs_read(stamp);
  return rd.ok && s_eq(s_trim(rd.data), fp);
}

fn bx_label(s: BxSess*, b: BinInfo*, t: TargetCtx*) -> string {
  if (s->tests) {
    return "test " + b->name + " (" + t->target + ", " + t->profile + ")";
  }
  if (slen(s->dep) > 0) {
    return s->dep + "/" + b->name + " (" + t->target + ", " + t->profile + ")";
  }
  return b->name + " (" + t->target + ", " + t->profile + ")";
}

fn bx_copy_beside(nl: NatLink*, t: TargetCtx*) {
  var i: int64 = 0;
  while (i < nl->copy_files->len) {
    var f: string = sl_get(nl->copy_files, i);
    var dst: string = t->out_dir + "/" + p_base(f);
    if (fs_copy_if_changed(f, dst)) {
      verbose("copied " + f + " -> " + dst);
    }
    i = i + 1;
  }
}

// Recorded when a test program (by its compile fingerprint) passed.
fn bx_test_pass_stamp(p: Project*, fp: string) -> string {
  return p->state_dir + "/stamps/test-bin-" + fp;
}

// One (bin, target) compile.
struct BxJob {
  elf: string;      // a board image's ELF file, else ""
  extra: StrList*;  // a board image's other flat files (uf2, hex)
  b: BinInfo*;
  t: TargetCtx*;
  nl: NatLink*;
  u: BxUnit*;
  c: Cmd*;
  outp: string;
  stamp: string;
  fp: string;
  state: int32;     // 0 = to compile, 1 = fresh, 2 = cannot start, 3 = test passed before
  g: Graph*;
  ok: bool;         // built (or fresh)
  pass: string;     // a test program's pass stamp, "" when not cached
}

// The compiler arguments that make the output of the unit's bin kind.
fn bx_kind_args(c: Cmd*, p: Project*, u: BxUnit*, j: BxJob*) {
  var b: BinInfo* = u->b;
  var outp: string = j->outp;
  var file: string = bx_rel(p, u->entry);
  if (bx_is_image(u)) {
    cmd_path(c, file);
    cmd_arg(c, "--target");
    cmd_arg(c, u->target);
    cmd_arg(c, "--emit-flat");
    cmd_path(c, bx_rel(p, outp));
    if (slen(j->elf) > 0) {
      cmd_arg(c, "--emit-elf");
      cmd_path(c, bx_rel(p, j->elf));
    }
    return;
  }
  if (s_eq(b->kind, "flat")) {
    cmd_path(c, file);
    cmd_arg(c, "--target");
    cmd_arg(c, b->triple);
    cmd_arg(c, "--emit-flat");
    cmd_path(c, bx_rel(p, outp));
    return;
  }
  if (s_eq(b->kind, "object") || u->ti < 0) {
    cmd_path(c, file);
    if (slen(b->triple) > 0) {
      cmd_arg(c, "--target");
      cmd_arg(c, b->triple);
    } else if (target_is_riscv(u->target)) {
      cmd_arg(c, "--target");
      cmd_arg(c, u->target);
    }
    cmd_arg(c, "-o");
    cmd_path(c, bx_rel(p, outp));
    return;
  }
  cmd_arg(c, "--build");
  if (s_eq(b->kind, "shared")) {
    cmd_arg(c, "--shared");
    cmd_arg(c, "--soname");
    cmd_arg(c, p_base(outp));
  }
  cmd_path(c, file);
  if (target_is_riscv(u->target)) {
    cmd_arg(c, "--target");
    cmd_arg(c, u->target);
  }
  cmd_arg(c, "-o");
  cmd_path(c, bx_rel(p, outp));
}

// c writing its flat image to outp instead, without --emit-elf.
fn bx_cmd_reflat(c: Cmd*, outp: string) -> Cmd* {
  var d: Cmd* = cmd_new(c->tool);
  var i: int64 = 0;
  while (i < c->args->len) {
    var a: string = sl_get(c->args, i);
    if (s_eq(a, "--emit-elf")) {
      i = i + 2;
    } else if (s_eq(a, "--emit-flat")) {
      cmd_arg(d, a);
      cmd_path(d, outp);
      i = i + 2;
    } else {
      if (cmd_is_path(c, i)) {
        cmd_path(d, a);
      } else {
        cmd_arg(d, a);
      }
      i = i + 1;
    }
  }
  sl_extend(d->env, c->env);
  d->cwd = c->cwd;
  return d;
}

// Every file the job writes is there.
fn bx_job_files(j: BxJob*) -> bool {
  if (!fs_is_file(j->outp) || (slen(j->elf) > 0 && !fs_is_file(j->elf))) {
    return false;
  }
  var i: int64 = 0;
  while (i < j->extra->len) {
    if (!fs_is_file(sl_get(j->extra, i))) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

// Prepares the compile of one unit; a Fresh output is reported and
// finished here.
fn bx_plan(s: BxSess*, u: BxUnit*, t: TargetCtx*, nl: NatLink*) -> BxJob* {
  var p: Project* = s->p;
  var b: BinInfo* = u->b;
  var m: Mettle* = u->m;
  var g: Graph* = u->g;
  var j: BxJob* = new BxJob;
  j->b = b;
  j->t = t;
  j->nl = nl;
  j->u = u;
  j->g = g;
  j->outp = bx_out_path(t, b);
  j->elf = s_empty();
  j->extra = sl_new();
  var c: Cmd* = tc_cmd(m);
  j->c = c;
  var st: Settings* = bx_add_flags(c, s, u);
  if (bx_is_image(u)) {
    var base: string = t->out_dir + "/" + b->name;
    j->outp = base + "." + bx_image_main(st);
    var outs: StrList* = bx_image_outputs(st);
    var oi: int64 = 0;
    while (oi < outs->len) {
      var ext: string = sl_get(outs, oi);
      if (s_eq(ext, "elf")) {
        j->elf = base + ".elf";
      } else if (!s_eq(base + "." + ext, j->outp)) {
        sl_push(j->extra, base + "." + ext);
      }
      oi = oi + 1;
    }
    free(outs);
  }
  bx_add_include(c, p, s->ds, bx_unit_gen(u));
  if (s->tests) {
    // a native @test copy: -I the original's directory
    cmd_args(c, b->flags);
  }
  cmd_args(c, nl->mettle_args);
  bx_kind_args(c, p, u, j);
  sl_extend(c->env, nl->env);
  bx_diag_env(c);
  c->cwd = p->root;

  var h: Hasher = h_new();
  h_str(&h, "mbuild-build-v3");
  bx_hash_cmd(&h, p, m, c);
  h_str(&h, t->target);
  h_str(&h, t->profile);
  h_str(&h, b->name);
  graph_fingerprint(g, &h);
  h_str(&h, nl->fingerprint);
  bx_hash_pgo(&h, p, st);
  free(st);
  var xh: int64 = 0;
  while (xh < j->extra->len) {
    h_str(&h, p_base(sl_get(j->extra, xh)));
    xh = xh + 1;
  }
  j->fp = h_hex(&h);
  var tag: string = "";
  if (s->tests) {
    tag = "test-bin-";
  }
  j->stamp = p->state_dir + "/stamps/" + tag + t->target + "-" + t->profile + "-" + b->name + ".stamp";

  j->ok = false;
  j->pass = s_empty();
  if (s->tests) {
    var key: string = bt_key_of(b->name);
    if (slen(key) > 0) {
      var hp: Hasher = h_new();
      h_str(&hp, j->fp);
      h_str(&hp, key);
      j->pass = bx_test_pass_stamp(p, h_hex(&hp));
    }
  }
  if (slen(j->pass) > 0 && fs_is_file(j->outp) && bx_stamp_ok(p, j->pass, j->fp)) {
    j->state = 3;
    j->ok = true;
    return j;
  }
  if (bx_job_files(j) && bx_stamp_ok(p, j->stamp, j->fp)) {
    j->ok = true;
    if (s->tests) {
      verbose("Fresh " + bx_label(s, b, t));
    } else {
      status("Fresh", bx_label(s, b, t));
    }
    bx_copy_beside(nl, t);
    j->state = 1;
    return j;
  }
  if (!g->ok) {
    error_msg("cannot read " + bx_show(u->entry) + " (the main file of bin `" + b->name + "`)");
    j->state = 2;
    return j;
  }
  fs_mkdirs(t->out_dir);
  sys_remove_file(j->stamp);
  j->state = 0;
  return j;
}

// After the compiler ran: its output, the stamp. 0 on success.
fn bx_finish(s: BxSess*, j: BxJob*, code: int32, output: string) -> int32 {
  var p: Project* = s->p;
  var b: BinInfo* = j->b;
  var t: TargetCtx* = j->t;
  bx_print_block(bx_compiler_output(output));
  if (!s_eq(b->kind, "object") && j->u->ti >= 0) {
    bx_remove_intermediates(j->outp);
  }
  if (code != 0) {
    if (j->u->ti >= 0) {
      nat_explain_failure(p, s->ds, t, bx_strip_ansi(output));
    }
    bx_explain_clash(s->ds, j->g, bx_strip_ansi(output));
    error_msg("could not compile " + b->name + " (" + t->target + ", " + t->profile + ")");
    return 1;
  }
  if (!fs_is_file(j->outp)) {
    error_msg("the compiler succeeded but " + bx_show(j->outp) + " is missing");
    return 1;
  }
  var xi: int64 = 0;
  while (xi < j->extra->len) {
    var xp: string = sl_get(j->extra, xi);
    var xc: Cmd* = bx_cmd_reflat(j->c, bx_rel(p, xp));
    var xcap: Captured = proc_capture_all(xc);
    free(xc);
    bx_print_block(bx_compiler_output(xcap.out));
    if (xcap.code != 0 || !fs_is_file(xp)) {
      error_msg("could not write " + bx_show(xp) + " (" + t->target + ", " + t->profile + ")");
      return 1;
    }
    xi = xi + 1;
  }
  bx_copy_beside(j->nl, t);
  if (s->tests) {
    var warns: StrList* = trn_warnings(bx_strip_ansi(output));
    fs_write(j->outp + ".warnings", sl_join(warns, "\n"));
    free(warns);
  }
  fs_write(j->stamp, j->fp + "\n");
  j->ok = true;
  return 0;
}

fn bx_parallel(p: Project*) -> int64 {
  if (p->opts->jobs > 0) {
    return p->opts->jobs;
  }
  return proc_jobs();
}

// bx_run_jobs' state for the pool's events.
struct BxRun {
  s: BxSess*;
  jobs: BxJob**;
  n: int64;
  done: int32*;   // exit code once ended, else -1
  logs: StrList*;
  next: int64;    // the first job not yet finished in plan order
  rc: int32;
}

// A compile starts (code -1) or ends: ended ones are finished in plan order;
// after a failure no new compile starts.
fn bx_job_event(arg: rawptr, i: int64, code: int32) -> bool {
  var r: BxRun* = (BxRun*)arg;
  if (code < 0) {
    var j: BxJob* = r->jobs[i];
    status("Compiling", bx_label(r->s, j->b, j->t));
    verbose(cmd_display(j->c));
    return true;
  }
  r->done[i] = code;
  while (r->next < r->n && r->done[r->next] >= 0) {
    var logp: string = sl_get(r->logs, r->next);
    var rd: FsRead = fs_read(logp);
    var text: string = "";
    if (rd.ok) {
      text = rd.data;
    }
    sys_remove_file(logp);
    if (bx_finish(r->s, r->jobs[r->next], r->done[r->next], text) != 0) {
      r->rc = 1;
    }
    r->next = r->next + 1;
  }
  return r->rc == 0;
}

// Runs the compiles, at most -j at a time; each compiler's output is printed
// once it is done, in plan order. After a failure no new compile starts.
fn bx_run_jobs(s: BxSess*, jobs: BxJob**, n: int64) -> int32 {
  var p: Project* = s->p;
  var par: int64 = bx_parallel(p);
  if (par <= 1 || n <= 1) {
    var i: int64 = 0;
    while (i < n) {
      var j: BxJob* = jobs[i];
      status("Compiling", bx_label(s, j->b, j->t));
      var cap: Captured = proc_capture_all(j->c);
      if (bx_finish(s, j, cap.code, cap.out) != 0) {
        return 1;
      }
      i = i + 1;
    }
    return 0;
  }
  var r: BxRun;
  r.s = s;
  r.jobs = jobs;
  r.n = n;
  r.done = (int32*)malloc((n + 1) * 4);
  r.logs = sl_new();
  r.next = 0;
  r.rc = 0;
  var tmp: string = p->state_dir + "/tmp";
  fs_mkdirs(tmp);
  var cmds: Cmd** = (Cmd**)malloc((n + 1) * 8);
  var k: int64 = 0;
  while (k < n) {
    r.done[k] = -1;
    cmds[k] = jobs[k]->c;
    sl_push(r.logs, tmp + "/compile-" + jobs[k]->t->target + "-" + jobs[k]->t->profile + "-" + jobs[k]->b->name + ".log");
    k = k + 1;
  }
  var codes: int32* = sys_run_jobs(cmds, n, r.logs, par, (rawptr)&r, &bx_job_event);
  free(codes);
  free(cmds);
  free(r.done);
  free(r.logs);
  return r.rc;
}

fn bx_tctx_new(s: BxSess*, target: string, m: Mettle*) -> TargetCtx* {
  var t: TargetCtx* = targetctx_new(s->p, target, s->profile);
  t->out_dir = s->app->root + "/build/" + target + "/" + s->app_profile;
  if (s->tests) {
    t->out_dir = s->app->state_dir + "/test-bins/" + target + "/" + s->app_profile;
  }
  // A dependency's bins share the app's native cache: its C builds once.
  t->cache_dir = s->app->state_dir + "/cache/" + target;
  t->app = s->app;
  t->app_profile = s->app_profile;
  t->compiler_stdlib_dir = m->stdlib_dir;
  t->compiler_runtime_dir = m->runtime_dir;
  return t;
}

fn bx_targetctx(s: BxSess*, ti: int64) -> TargetCtx* {
  return bx_tctx_new(s, sl_get(s->targets, ti), s->mettles[ti]);
}

// The TargetCtx of every session target, then one per freestanding triple
// (index targets->len + k, in unit order).
fn bx_unit_tctx(s: BxSess*, u: BxUnit*, ctxs: TargetCtx**, nls: NatLink**) -> int64 {
  if (u->ti >= 0) {
    return u->ti;
  }
  var k: int64 = s->targets->len;
  while (ctxs[k] != (TargetCtx*)0) {
    if (s_eq(ctxs[k]->target, u->target)) {
      return k;
    }
    k = k + 1;
  }
  var t: TargetCtx* = bx_tctx_new(s, u->target, u->m);
  ctxs[k] = t;
  nls[k] = natlink_empty();
  return k;
}

// C code and C libraries stop a RISC-V build: mbuild has no RISC-V C toolchain.
fn bx_rv_no_native(s: BxSess*, target: string) {
  var who: string = s_empty();
  if (bx_has_native(s->p->man)) {
    who = "this project";
  }
  var i: int64 = 0;
  while (slen(who) == 0 && i < s->ds->n) {
    if (s->ds->mods[i].man != (Manifest*)0 && bx_has_native(s->ds->mods[i].man)) {
      who = "dependency " + s->ds->mods[i].module;
    }
    i = i + 1;
  }
  if (slen(who) > 0) {
    fail_hint(who + " has C code or C libraries ([c], [link]), and mbuild builds C for linux and windows only, not " + target, "build it with -t linux or -t windows");
  }
}

fn bx_has_native(m: Manifest*) -> bool {
  var keys: StrList* = sl_of("c.sources");
  defer free(keys);
  sl_push(keys, "c.libs");
  sl_push(keys, "link.libs");
  sl_push(keys, "link.pkgconfig");
  var i: int64 = 0;
  while (i < keys->len) {
    var l: StrList* = man_os_list(m, sl_get(keys, i), "linux");
    var n: int64 = l->len;
    free(l);
    if (n > 0) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

// Builds every unit and the dependencies' bins (mb_dep_bin), then runs the
// post-build hooks. 0 on success.
fn bx_build_units(s: BxSess*, us: BxUnits*) -> int32 {
  var t0: int64 = sys_now_ms();
  bx_prepare(s, us, s_empty());
  var dep_bins: BxDepBins* = bx_dep_bins_prepare(s);
  g_bx_dep_bins = dep_bins;
  var built: StrList* = sl_new();
  if (bx_compile_units(s, us, built) != 0 || bx_dep_bins_build(dep_bins) != 0) {
    return 1;
  }
  bx_post_hooks(s, us, built);
  free(built);
  status("Finished", "in " + bx_secs(sys_now_ms() - t0));
  return 0;
}

// Compiles the prepared units (Fresh ones are only reported); built gets
// "target bin" for each one compiled. 0 on success.
fn bx_compile_units(s: BxSess*, us: BxUnits*, built: StrList*) -> int32 {
  var nt: int64 = s->targets->len + us->n + 1;
  var ctxs: TargetCtx** = (TargetCtx**)malloc(nt * 8);
  var nls: NatLink** = (NatLink**)malloc(nt * 8);
  g_bx_tctxs = ctxs;
  g_bx_nls = nls;
  var k: int64 = 0;
  while (k < nt) {
    ctxs[k] = (TargetCtx*)0;
    nls[k] = (NatLink*)0;
    k = k + 1;
  }
  var ti: int64 = 0;
  while (ti < s->targets->len) {
    ctxs[ti] = bx_targetctx(s, ti);
    s->cur_t = ctxs[ti];
    if (target_is_riscv(ctxs[ti]->target)) {
      bx_rv_no_native(s, ctxs[ti]->target);
      nls[ti] = natlink_empty();
    } else {
      nls[ti] = nat_prepare(s->p, s->ds, ctxs[ti]);
    }
    s->cur_nl = nls[ti];
    ti = ti + 1;
  }
  var jobs: BxJob** = (BxJob**)malloc((us->n + 1) * 8);
  var n: int64 = 0;
  var i: int64 = 0;
  while (i < us->n) {
    var u: BxUnit* = us->items[i];
    var at: int64 = bx_unit_tctx(s, u, ctxs, nls);
    var j: BxJob* = bx_plan(s, u, ctxs[at], nls[at]);
    u->job = j;
    if (j->state == 2) {
      return 1;
    }
    if (j->state == 0) {
      jobs[n] = j;
      n = n + 1;
    }
    i = i + 1;
  }
  if (bx_run_jobs(s, jobs, n) != 0) {
    return 1;
  }
  i = 0;
  while (i < n) {
    sl_push(built, jobs[i]->t->target + " " + jobs[i]->b->name);
    i = i + 1;
  }
  free(jobs);
  return 0;
}

// ---------------------------------------------------------------------------
// Dependency bins (mb_dep_bin)
// ---------------------------------------------------------------------------

// The dependency as a project of its own: its directory and manifest, its
// state under .mbuild/dep-bins/NAME, no hooks.
fn bx_dep_project(p: Project*, dm: DepModule*) -> Project* {
  var q: Project* = new Project;
  q->opts = p->opts;
  q->root = dm->dir;
  q->state_dir = p->state_dir + "/dep-bins/" + dm->module;
  q->mbfile = s_empty();
  q->legacy_toml = false;
  q->man = dm->man;
  if (q->man == (Manifest*)0) {
    q->man = man_empty(dm->dir, dm->module);
  }
  q->has_manifest = true;
  return q;
}

// The profile a dependency builds with: the project's, else the nearest
// ancestor it knows (debug or release at the latest).
fn bx_dep_profile(p: Project*, q: Project*, prof: string) -> string {
  var chain: StrList* = bx_profile_chain(p->man, prof);
  var i: int64 = 0;
  while (i < chain->len) {
    if (man_has_profile(q->man, sl_get(chain, i))) {
      var found: string = sl_get(chain, i);
      free(chain);
      return found;
    }
    i = i + 1;
  }
  free(chain);
  return "debug";
}

// The bins of dep the project names, checked against the dependency's bins.
fn bx_dep_binset(s: BxSess*, q: Project*, dep: string) -> BinSet* {
  var all: BinSet* = build_bins(q);
  var known: StrList* = bx_bin_names(all);
  var mine: StrList* = bx_bin_names(build_bins(s->p));
  var names: StrList* = man_dep_bins(s->p->man, dep);
  defer free(names);
  var i: int64 = 0;
  while (i < names->len) {
    var nm: string = sl_get(names, i);
    var call: string = "mb_dep_bin(\"" + dep + "\", \"" + nm + "\")";
    i = i + 1;
    if (known->len == 0) {
      fail(call + ": " + dep + " has no bins");
    }
    if (!sl_has(known, nm)) {
      var hint: string = dep + "'s bins are: " + sl_join(known, ", ");
      var sug: string = man_suggest(nm, known);
      if (slen(sug) > 0) {
        hint = "did you mean `" + sug + "`? " + hint;
      }
      fail_hint(call + ": " + dep + " has no bin `" + nm + "`", hint);
    }
    if (sl_has(mine, nm)) {
      fail(call + ": this project has a bin `" + nm + "` too, and both would build to the same file");
    }
  }
  free(known);
  free(mine);
  return bx_select_from(q, all, names);
}

// One dependency's bins to build: its session and units.
struct BxDepBins {
  s: BxSess*;
  us: BxUnits*;
}

// The bins mb_dep_bin names, checked and prepared for the session's targets:
// each dependency as a project with its own manifest, building into this
// project's output directories. Ends with a zero entry.
fn bx_dep_bins_prepare(s: BxSess*) -> BxDepBins* {
  var p: Project* = s->p;
  var deps: StrList* = sl_new();
  defer free(deps);
  var i: int64 = 0;
  while (i < p->man->dep_bins->len) {
    var e: string = sl_get(p->man->dep_bins, i);
    sl_add_uniq(deps, s_sub(e, 0, s_find_byte(e, 61)));
    i = i + 1;
  }
  var all: BxDepBins* = (BxDepBins*)malloc((deps->len + 1) * sizeof(BxDepBins));
  i = 0;
  while (i < deps->len) {
    var dep: string = sl_get(deps, i);
    var at: int64 = 0;
    while (at < s->ds->n && !s_eq(s->ds->mods[at].module, dep)) {
      at = at + 1;
    }
    if (at >= s->ds->n) {
      fail(dep + " is not in the build (mb_dep_bin)");
    }
    var q: Project* = bx_dep_project(p, &s->ds->mods[at]);
    var bs: BinSet* = bx_dep_binset(s, q, dep);
    var ds: BxSess* = new BxSess;
    ds->p = q;
    ds->ds = s->ds;
    ds->targets = s->targets;
    ds->mettles = s->mettles;
    ds->host_m = s->host_m;
    ds->profile = bx_dep_profile(p, q, s->profile);
    ds->hooks_run = sl_new();
    ds->dep = dep;
    ds->app = p;
    ds->app_profile = s->profile;
    ds->comps = bx_comp_names(q, s->ds);
    ds->has_cmp = ds->comps->len > 0;
    var us: BxUnits* = bx_bin_units(ds, bs);
    bx_components(ds, us, s_empty());
    bx_graphs(ds, us);
    all[i].s = ds;
    all[i].us = us;
    i = i + 1;
  }
  all[i].s = (BxSess*)0;
  all[i].us = (BxUnits*)0;
  return all;
}

fn bx_dep_bins_build(all: BxDepBins*) -> int32 {
  var i: int64 = 0;
  while (all[i].s != (BxSess*)0) {
    var built: StrList* = sl_new();
    var rc: int32 = bx_compile_units(all[i].s, all[i].us, built);
    free(built);
    if (rc != 0) {
      return 1;
    }
    i = i + 1;
  }
  return 0;
}

fn bx_build_all(s: BxSess*, bs: BinSet*) -> int32 {
  return bx_build_units(s, bx_bin_units(s, bs));
}

// ---------------------------------------------------------------------------
// Commands
// ---------------------------------------------------------------------------

export fn build_cmd_build(p: Project*) -> int32 {
  var lib: BinSet* = bx_lib_set(p);
  if (lib->n > 0) {
    if (!g_quiet) {
      say("library: nothing to link (package `" + p->man->name + "` has no bins); checking it");
    }
    return bx_check_set(p, bx_select_from(p, lib, bx_positional(p->opts->rest)));
  }
  var bs: BinSet* = bx_select_bins(p, bx_positional(p->opts->rest));
  var s: BxSess* = bx_sess(p, build_targets(p));
  g_bx_sess = s;
  return bx_build_all(s, bs);
}

fn bx_runnable(b: BinInfo*) -> bool {
  return (s_eq(b->kind, "exe") && !bx_freestanding(b)) || bx_rv_image_bin(b);
}

// A bin declared as a RISC-V board image (its own riscv*-none triple).
fn bx_rv_image_bin(b: BinInfo*) -> bool {
  return target_is_bare(b->triple) && (s_eq(b->kind, "exe") || s_eq(b->kind, "flat"));
}

// The one bin `run` / `live` starts: named, the only runnable one, or the
// one named after the package.
fn bx_run_bin(p: Project*, cmd: string) -> BinSet* {
  var names: StrList* = bx_positional(p->opts->rest);
  defer free(names);
  var all: BinSet* = build_bins(p);
  if (all->n == 0) {
    if (bx_lib_set(p)->n > 0) {
      fail_hint("package `" + p->man->name + "` is a library: it has no program to run", "add src/main.mettle with fn main (or mb_bin in mbuild.mettle) to make one; `mbuild check` and `mbuild test` work on libraries");
    }
    bx_no_bins(p);
  }
  var pick: StrList* = sl_new();
  defer free(pick);
  if (names->len > 0) {
    sl_push(pick, sl_get(names, 0));
    if (names->len > 1) {
      fail_hint("`mbuild " + cmd + "` takes one bin", "pass program arguments after `--`: mbuild " + cmd + " " + sl_get(names, 0) + " -- ARGS");
    }
  } else if (all->n > 1) {
    var known: StrList* = sl_new();
    defer free(known);
    var i: int64 = 0;
    while (i < all->n) {
      if (bx_runnable(&all->items[i])) {
        sl_push(known, all->items[i].name);
      }
      i = i + 1;
    }
    if (known->len == 1) {
      sl_push(pick, sl_get(known, 0));
    } else if (sl_has(known, p->man->name)) {
      sl_push(pick, p->man->name);
    } else {
      fail_hint("this project has several bins", "name one: mbuild " + cmd + " " + sl_join(known, " | "));
    }
  }
  var bs: BinSet* = bx_select_bins(p, pick);
  var b: BinInfo* = &bs->items[0];
  if (bx_freestanding(b) && !bx_rv_image_bin(b)) {
    fail_hint("bin " + b->name + " is freestanding (" + b->triple + "): mbuild cannot run it", "write a project command that starts your emulator: fn cmd_qemu");
  }
  if (!s_eq(b->kind, "exe") && !bx_rv_image_bin(b)) {
    fail("bin " + b->name + " is a " + b->kind + " bin, not a program: mbuild " + cmd + " needs kind exe");
  }
  return bs;
}

// One target for `run`: -t, else the host when [build] targets has it.
fn bx_run_targets(p: Project*) -> StrList* {
  var targets: StrList* = build_targets(p);
  if (targets->len > 1) {
    if (p->opts->targets->len > 0) {
      fail_hint("`mbuild run` runs one target", "pass one -t, such as -t linux or -t riscv64-linux");
    }
    var host: string = sys_os();
    if (!sl_has(targets, host)) {
      host = sl_get(targets, 0);
    }
    targets = sl_of(host);
  }
  return targets;
}

export fn build_cmd_run(p: Project*) -> int32 {
  bx_timeout_ms(p, false);
  var bs: BinSet* = bx_run_bin(p, "run");
  var services: bool = p->man->nservices > 0 && !sl_has(p->opts->rest, "--no-services");
  var svc_bins: StrList* = sl_new();
  defer free(svc_bins);
  if (services) {
    // the project's bins a service names are built with the app
    var progs: StrList* = svc_programs(p->man);
    var all: BinSet* = build_bins(p);
    var names: StrList* = sl_of(bs->items[0].name);
    var i: int64 = 0;
    while (i < all->n) {
      if (sl_has(progs, all->items[i].name)) {
        sl_push(svc_bins, all->items[i].name);
        sl_add_uniq(names, all->items[i].name);
      }
      i = i + 1;
    }
    i = 0;
    while (i < p->man->dep_bins->len) {
      var e: string = sl_get(p->man->dep_bins, i);
      sl_push(svc_bins, s_from(e, s_find_byte(e, 61) + 1));
      i = i + 1;
    }
    if (names->len > 1) {
      bs = bx_select_bins(p, names);
    }
    free(names);
    free(progs);
  }
  var s: BxSess* = bx_sess(p, bx_run_targets(p));
  g_bx_sess = s;
  if (bx_build_all(s, bs) != 0) {
    return 1;
  }
  var t: TargetCtx* = bx_targetctx(s, 0);
  g_bx_t = t;
  var outp: string = bx_out_path(t, &bs->items[0]);
  var c: Cmd* = bx_emu_cmd(s, &bs->items[0], t, &outp);
  if (c == (Cmd*)0) {
    c = tc_run_program_cmd(t->target, outp);
  }
  if (c == (Cmd*)0) {
    fail_hint("cannot run a " + t->target + " program on this " + sys_os() + " host", "the binary is at " + bx_show(outp));
  }
  cmd_args(c, p->opts->passthrough);
  var run_target: string = bx_run_target(&bs->items[0], t);
  var board: bool = target_is_bare(run_target);
  var st: Settings* = bx_settings_of(p, s->profile, bs->items[0].name, run_target);
  // a --pgo-gen program records its profile: at exit into METTLE_PROFILE_OUT,
  // on a board on its console, which tools/riscv-pgo-capture.py turns into one
  var prof_out: string = s_empty();
  if (s_eq(st->pgo, "instrument") && slen(st->pgo_file) > 0) {
    prof_out = p_join(p->root, st->pgo_file);
    if (env_set("METTLE_PROFILE_OUT") && !board) {
      prof_out = env_get("METTLE_PROFILE_OUT");
    }
    fs_mkdirs(p_dir(prof_out));
    sys_remove_file(prof_out);
    if (!board) {
      cmd_env(c, "METTLE_PROFILE_OUT", prof_out);
    }
  }
  free(st);
  if (services) {
    return svc_run(p, t->out_dir, target_exe_ext(t->target), svc_bins, c, bx_show(outp));
  }
  var emu: bool = target_is_riscv(run_target);
  var ms: int64 = bx_timeout_ms(p, emu);
  var how: string = s_empty();
  if (emu) {
    how = " (" + p_base(c->tool.path) + ")";
  }
  var shown: string = bx_show(outp);
  status("Running", shown + how);
  var timed_out: bool = false;
  var rc: int32 = 0;
  if (board && slen(prof_out) > 0) {
    var cap: Captured;
    if (ms > 0) {
      cap = proc_capture_timeout(c, ms, &timed_out);
    } else {
      cap = proc_capture_all(c);
    }
    print(cap.out);
    flush_out();
    rc = cap.code;
    if (!timed_out) {
      var console: string = prof_out + ".console";
      fs_write(console, cap.out);
      rv_pgo_capture(bx_host_mettle(s), console, prof_out);
    }
  } else if (ms <= 0) {
    rc = proc_run(c);
  } else {
    rc = proc_run_timeout(c, ms, &timed_out);
  }
  if (timed_out) {
    error_msg(shown + " was stopped after " + bx_secs(ms) + " (--timeout " + s_int(ms / 1000) + ")");
  }
  if (slen(prof_out) > 0 && !timed_out) {
    if (!fs_is_file(prof_out)) {
      fail_hint("the run wrote no profile to " + bx_show(prof_out), "a --pgo-gen program writes it when main returns; the compiler must count blocks on " + run_target);
    }
    status("Profiled", bx_show(prof_out) + "; build with --pgo-use to use it");
  }
  return rc;
}

// mbuild pgo [collect] [BIN]: build counting (--pgo-gen), run it to record
// the profile, then build with it (--pgo-use); collect stops after the run.
// Both builds use one profile (release unless -p), so the blocks match.
export fn build_cmd_pgo(p: Project*) -> int32 {
  var rest: StrList* = sl_new();
  var collect: bool = false;
  var i: int64 = 0;
  while (i < p->opts->rest->len) {
    var a: string = sl_get(p->opts->rest, i);
    if (s_eq(a, "collect") && !collect) {
      collect = true;
    } else if (s_eq(a, "--pgo-gen") || s_eq(a, "--pgo-use") || s_starts(a, "--pgo-use=")) {
      fail("mbuild pgo passes --pgo-gen and --pgo-use itself");
    } else {
      sl_push(rest, a);
    }
    i = i + 1;
  }
  if (s_eq(p->opts->profile, "debug") && !p->opts->release) {
    p->opts->release = true;
  }
  p->opts->rest = rest;
  p->opts->targets = bx_run_targets(p);
  p->opts->rest = sl_copy(rest);
  sl_push(p->opts->rest, "--pgo-gen");
  var rc: int32 = build_cmd_run(p);
  if (collect) {
    return rc;
  }
  if (rc != 0) {
    note("the training run exited with {rc}; its profile is used");
  }
  p->opts->rest = sl_copy(rest);
  sl_push(p->opts->rest, "--pgo-use");
  p->opts->passthrough = sl_new();
  return build_cmd_build(p);
}

// mbuild flash [BIN]: the bin's UF2 image, built and copied to the board's
// drive (an RP2350 in BOOTSEL mode mounts as a drive named RP2350).
export fn build_cmd_flash(p: Project*) -> int32 {
  var bs: BinSet* = bx_run_bin(p, "flash");
  var b: BinInfo* = &bs->items[0];
  var target: string = bx_flash_target(p, b);
  var st: Settings* = bx_settings_of(p, build_profile(p), b->name, target);
  if (slen(st->board) == 0) {
    fail_hint("bin " + b->name + ": mbuild flash needs a board, and " + target + " has none set", "mb_set(\"board\", \"pico2\") after mb_on(\"" + target + "\") in a profile, or after mb_for_bin");
  }
  if (!s_eq(st->board, "pico2")) {
    fail_hint("board " + st->board + " has no UF2 drive mbuild can copy to (only pico2 has, today)", "write a project command that flashes it, such as fn cmd_upload in mbuild.mettle (docs/project.md), and run mbuild upload");
  }
  var outs: StrList* = bx_image_outputs(st);
  if (!sl_has(outs, "uf2")) {
    var with_uf2: string = sl_join(outs, ", ") + ", uf2";
    p->opts->sets = sl_copy(p->opts->sets);
    sl_push(p->opts->sets, "outputs=" + with_uf2);
  }
  free(outs);
  free(st);
  var drive: string = bx_flash_drive();
  var s: BxSess* = bx_sess(p, sl_of(target));
  g_bx_sess = s;
  if (bx_build_all(s, bs) != 0) {
    return 1;
  }
  var t: TargetCtx* = bx_targetctx(s, 0);
  g_bx_t = t;
  var dir: string = t->out_dir;
  if (bx_rv_image_bin(b)) {
    dir = p_dir(t->out_dir);
    dir = p_dir(dir) + "/" + target + "/" + p_base(t->out_dir);
  }
  var image: string = dir + "/" + b->name + ".uf2";
  var dest: string = drive + "/" + b->name + ".uf2";
  status("Flashing", bx_show(image) + " to " + drive);
  if (!fs_copy(image, dest)) {
    fail_hint("could not copy " + bx_show(image) + " to " + dest, "is the drive still mounted and writable? hold BOOTSEL while plugging the board in, then run mbuild flash again");
  }
  sys_sync();
  status("Flashed", b->name + " (" + s_int(sys_stat(image).size) + " bytes); the board restarts into it");
  return 0;
}

// The board target `flash` builds: the bin's own triple, one -t, else the
// first board target of mb_targets, else riscv32-none.
fn bx_flash_target(p: Project*, b: BinInfo*) -> string {
  if (bx_rv_image_bin(b)) {
    return b->triple;
  }
  var l: StrList* = sl_new();
  defer free(l);
  var i: int64 = 0;
  while (i < p->opts->targets->len) {
    bx_add_target(p, l, sl_get(p->opts->targets, i));
    i = i + 1;
  }
  if (l->len > 1) {
    fail_hint("`mbuild flash` flashes one target", "pass one -t, such as -t riscv32-none");
  }
  if (l->len == 1) {
    if (!target_is_bare(sl_get(l, 0))) {
      fail_hint("mbuild flash writes a board image, and " + sl_get(l, 0) + " is not a board target", "use -t riscv32-none");
    }
    return sl_get(l, 0);
  }
  i = 0;
  while (i < p->man->targets->len) {
    if (target_is_bare(sl_get(p->man->targets, i))) {
      return sl_get(p->man->targets, i);
    }
    i = i + 1;
  }
  return "riscv32-none";
}

// The mounted RP2350 drive: MBUILD_FLASH_DIR, else a directory named
// RP2350 (or whose INFO_UF2.TXT names it) under /run/media/$USER,
// /media/$USER or /mnt. Fails when there's none.
fn bx_flash_drive() -> string {
  var given: string = env_get("MBUILD_FLASH_DIR");
  var looked: string = s_empty();
  if (slen(given) > 0) {
    if (fs_is_file(given + "/INFO_UF2.TXT")) {
      return given;
    }
    looked = "MBUILD_FLASH_DIR=" + given + " has no INFO_UF2.TXT";
  } else {
    var user: string = env_get("USER");
    var bases: StrList* = sl_new();
    defer free(bases);
    if (slen(user) > 0) {
      sl_push(bases, "/run/media/" + user);
      sl_push(bases, "/media/" + user);
    }
    sl_push(bases, "/mnt");
    var i: int64 = 0;
    while (i < bases->len) {
      var base: string = sl_get(bases, i);
      if (fs_is_file(base + "/RP2350/INFO_UF2.TXT")) {
        return base + "/RP2350";
      }
      var files: StrList* = sl_new();
      defer free(files);
      var dirs: StrList* = sl_new();
      defer free(dirs);
      if (sys_list_dir(base, files, dirs)) {
        sl_sort(dirs);
        var k: int64 = 0;
        while (k < dirs->len) {
          var d: string = base + "/" + sl_get(dirs, k);
          var rd: FsRead = fs_read(d + "/INFO_UF2.TXT");
          if (rd.ok && s_contains(rd.data, "RP2350")) {
            return d;
          }
          k = k + 1;
        }
      }
      i = i + 1;
    }
    looked = "looked in " + sl_join(bases, ", ");
  }
  fail_hint("no RP2350 drive is mounted (" + looked + ")", "hold BOOTSEL while plugging the board in, then run mbuild flash again (or set MBUILD_FLASH_DIR to the drive)");
  return s_empty();
}

// The target a bin runs as: its own riscv*-none triple, else the session's.
fn bx_run_target(b: BinInfo*, t: TargetCtx*) -> string {
  if (bx_rv_image_bin(b)) {
    return b->triple;
  }
  return t->target;
}

// --timeout SECS in ms; else 30 s for a program under an emulator, else 0 (none).
fn bx_timeout_ms(p: Project*, emulated: bool) -> int64 {
  var i: int64 = 0;
  while (i < p->opts->rest->len) {
    var a: string = sl_get(p->opts->rest, i);
    if (s_starts(a, "--timeout=")) {
      var v: string = s_from(a, 10);
      var n: int64 = s_to_int(v);
      if (n <= 0 && !s_eq(v, "0")) {
        fail("--timeout needs a number of seconds, not `" + v + "`");
      }
      return n * 1000;
    }
    i = i + 1;
  }
  if (emulated) {
    return 30000;
  }
  return 0;
}

// The emulator command of a RISC-V bin, else 0 (it runs natively or through
// wine). *outp becomes the file the emulator loads.
fn bx_emu_cmd(s: BxSess*, b: BinInfo*, t: TargetCtx*, outp: string*) -> Cmd* {
  var target: string = bx_run_target(b, t);
  if (!target_is_riscv(target)) {
    return (Cmd*)0;
  }
  if (!target_is_bare(target)) {
    return rv_program_cmd(target, *outp);
  }
  var dir: string = t->out_dir;
  if (bx_rv_image_bin(b)) {
    dir = p_dir(t->out_dir);
    dir = p_dir(dir) + "/" + target + "/" + p_base(t->out_dir);
  }
  var st: Settings* = bx_settings_of(s->p, s->profile, b->name, target);
  defer free(st);
  var outs: StrList* = bx_image_outputs(st);
  defer free(outs);
  var base: string = dir + "/" + b->name;
  var c: Cmd* = rv_image_cmd(s->p, bx_host_mettle(s), target, base, outs, st);
  *outp = base + "." + bx_image_main(st);
  if (sl_has(outs, "bin")) {
    *outp = base + ".bin";
  }
  return c;
}

// mbuild live [BIN] [-p PROFILE] [-- args]: `mettle live` with the build's
// setup, host target only (15.4).
export fn build_cmd_live(p: Project*) -> int32 {
  var bs: BinSet* = bx_run_bin(p, "live");
  var lv: LiveSess* = lv_open(p, bs->items[0].name);
  defer free(lv);
  if (p->opts->targets->len > 0 && !(p->opts->targets->len == 1 && (s_eq(sl_get(p->opts->targets, 0), sys_os()) || s_eq(sl_get(p->opts->targets, 0), "host")))) {
    fail("mbuild live runs on the host target only (" + sys_os() + ")");
  }
  var s: BxSess* = bx_sess(p, sl_of(sys_os()));
  g_bx_sess = s;
  var us: BxUnits* = bx_bin_units(s, bs);
  g_bx_units = us;
  bx_prepare(s, us, s_empty());
  var u: BxUnit* = us->items[0];
  var t: TargetCtx* = bx_targetctx(s, 0);
  g_bx_t = t;
  var nl: NatLink* = nat_prepare(p, s->ds, t);
  s->cur_nl = nl;
  t->out_dir = t->out_dir + "/live";
  fs_mkdirs(t->out_dir);
  bx_copy_beside(nl, t);
  var outp: string = t->out_dir + "/" + u->b->name + target_exe_ext(t->target);
  if (bx_has_hook(p, "post_build")) {
    // `mettle live` builds and starts in one step: build first so the hook
    // runs between (it then builds again, unchanged).
    var fc: Cmd* = bx_live_cmd(s, u, nl, outp, true);
    defer free(fc);
    var fr: Captured = proc_capture_all(fc);
    print(fr.out);
    if (fr.code != 0) {
      if (!lv_errors(lv, "build-error", fr.out)) {
        lv_emit(lv, "build-error", "could not build " + u->b->name);
      }
      return 1;
    }
    lv_emit(lv, "built", s_empty());
    lv->built = true;
    var bins: StrList* = sl_of(u->b->name);
    bx_hook(s, "post_build", t->target, t->out_dir, bins, bins);
  }
  var c: Cmd* = bx_live_cmd(s, u, nl, outp, false);
  defer free(c);
  lv_env(lv, c->env);
  var chk_obj: string = p->state_dir + "/tmp/live-check-" + s_replace_byte(u->b->name, 47, 95) + ".o";
  fs_mkdirs(p->state_dir + "/tmp");
  var chk: Cmd* = bx_check_cmd(s, u, chk_obj);
  defer free(chk);
  lv_track(lv, outp, chk, chk_obj);
  status("Live", bx_label(s, u->b, t));
  return lv_run(lv, c);
}

// The command of `mettle live`, or (first) of the build it starts with.
fn bx_live_cmd(s: BxSess*, u: BxUnit*, nl: NatLink*, outp: string, first: bool) -> Cmd* {
  var p: Project* = s->p;
  var c: Cmd* = tc_cmd(u->m);
  if (first) {
    cmd_arg(c, "--build");
    cmd_arg(c, "--live");
  } else {
    cmd_arg(c, "live");
  }
  cmd_path(c, bx_rel(p, u->entry));
  var st: Settings* = bx_add_flags(c, s, u);
  free(st);
  bx_add_include(c, p, s->ds, bx_unit_gen(u));
  cmd_args(c, nl->mettle_args);
  cmd_arg(c, "-o");
  cmd_path(c, bx_rel(p, outp));
  if (!first && p->opts->passthrough->len > 0) {
    cmd_arg(c, "--");
    cmd_args(c, p->opts->passthrough);
  }
  sl_extend(c->env, nl->env);
  c->cwd = p->root;
  verbose(cmd_display(c));
  return c;
}

// What `mbuild shell` needs of the bin's build: its compiler with the
// build's flags and -I (no input, no -o), and the project files it is made of.
export struct ShellBuild {
  p: Project*;
  m: Mettle*;
  base: Cmd*;          // cwd is the root
  exe: string;         // build/<host>/<profile>/shell/BIN
  entry: string;       // the bin's entry, absolute
  files: StrList*;     // its sources inside the project, absolute
  label: string;       // "app (linux, debug)"
  deps: StrList*;      // directories of the resolved packages
  dep_names: StrList*; // their package names
  graph: StrList*;     // every file of its import graph, absolute
  includes: StrList*;  // the -I directories, absolute
}

export fn build_shell_open(p: Project*) -> ShellBuild* {
  var bs: BinSet* = bx_run_bin(p, "shell");
  if (p->opts->targets->len > 0 && !(p->opts->targets->len == 1 && (s_eq(sl_get(p->opts->targets, 0), sys_os()) || s_eq(sl_get(p->opts->targets, 0), "host")))) {
    fail("mbuild shell runs on the host target only (" + sys_os() + ")");
  }
  var s: BxSess* = bx_sess(p, sl_of(sys_os()));
  g_bx_sess = s;
  var us: BxUnits* = bx_bin_units(s, bs);
  g_bx_units = us;
  bx_prepare(s, us, s_empty());
  var u: BxUnit* = us->items[0];
  if (!s_eq(u->entry, u->file)) {
    fail_hint("mbuild shell can't build " + u->b->name + " yet: it goes through a generated entry (rules or components)", "mbuild live works on it");
  }
  var t: TargetCtx* = bx_targetctx(s, 0);
  g_bx_t = t;
  var nl: NatLink* = nat_prepare(p, s->ds, t);
  s->cur_nl = nl;
  t->out_dir = t->out_dir + "/shell";
  fs_mkdirs(t->out_dir);
  bx_copy_beside(nl, t);
  var sb: ShellBuild* = new ShellBuild;
  sb->p = p;
  sb->m = u->m;
  sb->exe = t->out_dir + "/" + u->b->name + target_exe_ext(t->target);
  sb->entry = u->file;
  sb->label = bx_label(s, u->b, t);
  sb->files = sl_new();
  var i: int64 = 0;
  while (i < u->g->files->len) {
    var f: string = sl_get(u->g->files, i);
    if (p_has_prefix_dir(f, p->root) && !p_has_prefix_dir(f, p->state_dir) && !p_has_prefix_dir(f, p->root + "/build")) {
      sl_push(sb->files, f);
    }
    i = i + 1;
  }
  sb->graph = sl_copy(u->g->files);
  sb->deps = sl_new();
  sb->dep_names = sl_new();
  i = 0;
  while (i < s->ds->n) {
    sl_push(sb->deps, s->ds->mods[i].dir);
    sl_push(sb->dep_names, s->ds->mods[i].module);
    i = i + 1;
  }
  sb->includes = sl_new();
  if (slen(bx_unit_gen(u)) > 0) {
    sl_push(sb->includes, bx_unit_gen(u));
  }
  sl_push(sb->includes, s->ds->include_dir);
  var c: Cmd* = tc_cmd(u->m);
  var st: Settings* = bx_add_flags(c, s, u);
  free(st);
  bx_add_include(c, p, s->ds, bx_unit_gen(u));
  cmd_args(c, nl->mettle_args);
  sl_extend(c->env, nl->env);
  c->cwd = p->root;
  sb->base = c;
  return sb;
}

fn bx_walk_owned(root: string, rel: string, skip: StrList*, found: StrList*) {
  var dir: string = root;
  if (slen(rel) > 0) {
    dir = root + "/" + rel;
  }
  var files: StrList* = sl_new();
  var dirs: StrList* = sl_new();
  if (sys_list_dir(dir, files, dirs)) {
    var i: int64 = 0;
    while (i < files->len) {
      var f: string = sl_get(files, i);
      if (s_ends(f, ".mettle")) {
        if (slen(rel) > 0) {
          f = rel + "/" + f;
        }
        sl_push(found, f);
      }
      i = i + 1;
    }
    i = 0;
    while (i < dirs->len) {
      var d: string = sl_get(dirs, i);
      i = i + 1;
      if (s_starts(d, ".") || s_eq(d, "build")) {
        continue;
      }
      var sub: string = d;
      if (slen(rel) > 0) {
        sub = rel + "/" + d;
      }
      var abs: string = root + "/" + sub;
      if (fs_is_file(abs + "/mbuild.mettle") || fs_is_file(abs + "/mbuild.toml") || sl_has(skip, abs)) {
        continue;
      }
      bx_walk_owned(root, sub, skip, found);
    }
  }
  free(files);
  free(dirs);
}

// Absolute directories of the root's local path packages.
fn bx_path_pkg_dirs(p: Project*) -> StrList* {
  var l: StrList* = sl_new();
  var i: int64 = 0;
  while (i < p->man->ndeps) {
    var d: DepSpec* = man_dep(p->man, i);
    if (slen(d->path) > 0) {
      sl_push(l, p_clean(p_join(p->root, bx_slash(d->path))));
    }
    i = i + 1;
  }
  return l;
}

// The project's own .mettle files, relative to the root and sorted: not in
// dot directories, build/ directories, nested projects (a directory with its
// own mbuild.mettle) or local path packages.
fn bx_owned_files(p: Project*) -> StrList* {
  var found: StrList* = sl_new();
  var skip: StrList* = bx_path_pkg_dirs(p);
  bx_walk_owned(p->root, "", skip, found);
  free(skip);
  sl_sort(found);
  return found;
}

// Test programs: mb_test_bin, else tests/<name>_test.mettle files with fn
// main; then every main file an mb_test_glob matches, named by its stem.
fn bx_test_bins(p: Project*) -> BinSet* {
  var bs: BinSet* = bx_test_bins_declared(p);
  if (p->man->test_globs->len == 0) {
    return bs;
  }
  var all: StrList* = bx_owned_files(p);
  defer free(all);
  var i: int64 = 0;
  while (i < all->len) {
    var rel: string = sl_get(all, i);
    i = i + 1;
    var g: int64 = 0;
    var hit: bool = false;
    while (g < p->man->test_globs->len && !hit) {
      hit = lv_glob_match(sl_get(p->man->test_globs, g), rel);
      g = g + 1;
    }
    if (!hit) {
      continue;
    }
    var rd: FsRead = fs_read(p->root + "/" + rel);
    if (!rd.ok || !scan_source(rd.data)->has_main) {
      continue;
    }
    var name: string = bx_safe_name(p_stem(rel));
    var k: int64 = 0;
    while (k < bs->n) {
      if (s_eq(bs->items[k].name, name) && !s_eq(bs->items[k].main, rel)) {
        fail_hint("two test programs are named " + name + ": " + bs->items[k].main + " and " + rel, "give one of them another name with mb_test_bin");
      }
      k = k + 1;
    }
    bx_binset_push(bs, name, rel);
  }
  return bs;
}

fn bx_test_bins_declared(p: Project*) -> BinSet* {
  var bs: BinSet* = new BinSet;
  bs->items = (BinInfo*)0;
  bs->n = 0;
  bs->root = p->root;
  var decl: StrList* = p->man->test_bins;
  if (decl->len > 0) {
    var i: int64 = 0;
    while (i < decl->len) {
      var e: string = sl_get(decl, i);
      var eq: int64 = s_find_byte(e, 61);
      var mainp: string = s_from(e, eq + 1);
      if (!fs_is_file(p->root + "/" + mainp)) {
        fail("mb_test_bin(\"" + s_sub(e, 0, eq) + "\", ...): " + mainp + " does not exist");
      }
      bx_binset_push(bs, s_sub(e, 0, eq), mainp);
      i = i + 1;
    }
    return bs;
  }
  var files: StrList* = sl_new();
  defer free(files);
  var dirs: StrList* = sl_new();
  defer free(dirs);
  if (sys_list_dir(p->root + "/tests", files, dirs)) {
    sl_sort(files);
    var k: int64 = 0;
    while (k < files->len) {
      var f: string = sl_get(files, k);
      if (s_ends(f, "_test.mettle") && slen(f) > 12) {
        var rd: FsRead = fs_read(p->root + "/tests/" + f);
        if (rd.ok && scan_source(rd.data)->has_main) {
          var rel: string = "tests/" + f;
          bx_binset_push(bs, bx_safe_name(s_sub(f, 0, slen(f) - 12)), rel);
        }
      }
      k = k + 1;
    }
  }
  return bs;
}

// Files with @test functions, but the main files of test programs.
fn bx_test_files(p: Project*, progs: BinSet*, files: StrList*) {
  var all: StrList* = bx_owned_files(p);
  defer free(all);
  var i: int64 = 0;
  while (i < all->len) {
    var rel: string = sl_get(all, i);
    var abs: string = p->root + "/" + rel;
    var rd: FsRead = fs_read(abs);
    if (rd.ok && scan_source(rd.data)->has_tests && bx_bin_of_entry(progs, abs) == (BinInfo*)0) {
      sl_push(files, abs);
    }
    i = i + 1;
  }
}

// The bin whose main file is `file`, 0 when none.
fn bx_bin_of_entry(bs: BinSet*, file: string) -> BinInfo* {
  var i: int64 = 0;
  while (i < bs->n) {
    if (s_eq(p_clean(bs->items[i].entry), p_clean(file))) {
      return &bs->items[i];
    }
    i = i + 1;
  }
  return (BinInfo*)0;
}

// c without the flags in names (space-separated) and their values.
fn bx_drop_valued(c: Cmd*, names: string) {
  var drop: StrList* = s_split(names, 32);
  defer free(drop);
  var args: StrList* = c->args;
  var kinds: StrList* = c->kinds;
  c->args = sl_new();
  c->kinds = sl_new();
  var i: int64 = 0;
  while (i < args->len) {
    if (sl_has(drop, sl_get(args, i))) {
      i = i + 2;
    } else {
      sl_push(c->args, sl_get(args, i));
      sl_push(c->kinds, sl_get(kinds, i));
      i = i + 1;
    }
  }
  free(args);
  free(kinds);
}

// A pico2 program never exits: a test program passes when its console
// prints exit-on-uart (default PASS), which stops rvsim. That string, after
// adding it and a 10 s until-ms when unset to c; "" for other targets.
fn bx_console_pass(s: BxSess*, b: BinInfo*, t: TargetCtx*, c: Cmd*) -> string {
  var target: string = bx_run_target(b, t);
  if (!target_is_bare(target)) {
    return s_empty();
  }
  var st: Settings* = bx_settings_of(s->p, s->profile, b->name, target);
  defer free(st);
  if (!s_eq(st->board, "pico2")) {
    return s_empty();
  }
  var want: string = st->exit_on_uart;
  if (slen(want) == 0) {
    want = "PASS";
    cmd_arg(c, "--exit-on-uart");
    cmd_arg(c, want);
  }
  if (slen(st->rvsim_until_ms) == 0) {
    cmd_arg(c, "--until-ms");
    cmd_arg(c, "10000");
  }
  return want;
}

fn bx_no_test_bins(p: Project*) -> BinSet* {
  var none: BinSet* = new BinSet;
  none->items = (BinInfo*)0;
  none->n = 0;
  none->root = p->root;
  return none;
}

// The test programs whose names contain s ("" = all).
fn bx_filter_bins(p: Project*, all: BinSet*, s: string) -> BinSet* {
  var names: StrList* = sl_new();
  defer free(names);
  var i: int64 = 0;
  while (i < all->n) {
    if (slen(s) == 0 || s_contains(all->items[i].name, s)) {
      sl_push(names, all->items[i].name);
    }
    i = i + 1;
  }
  if (names->len == all->n) {
    return all;
  }
  if (names->len == 0) {
    return bx_no_test_bins(p);
  }
  return bx_select_from(p, all, names);
}

// The default set without what mb_test_exclude names (programs by name,
// @test files by their path from the root).
fn bx_drop_excluded(p: Project*, progs: BinSet*, files: StrList*) -> BinSet* {
  var ex: StrList* = p->man->test_exclude;
  if (ex->len == 0) {
    return progs;
  }
  var keep: StrList* = sl_new();
  defer free(keep);
  var i: int64 = 0;
  while (i < files->len) {
    if (!sl_has(ex, p_rel(p->root, sl_get(files, i)))) {
      sl_push(keep, sl_get(files, i));
    }
    i = i + 1;
  }
  files->len = 0;
  sl_extend(files, keep);
  var names: StrList* = sl_new();
  defer free(names);
  i = 0;
  while (i < progs->n) {
    if (!sl_has(ex, progs->items[i].name)) {
      sl_push(names, progs->items[i].name);
    }
    i = i + 1;
  }
  if (names->len == progs->n) {
    return progs;
  }
  if (names->len == 0) {
    return bx_no_test_bins(p);
  }
  return bx_select_from(p, progs, names);
}

// The matrix: -t, else mb_test_targets, else the host; all and host
// expanded, TARGET:BOARD kept.
fn bx_mx_entries(p: Project*) -> StrList* {
  var src: StrList* = p->opts->targets;
  if (src->len == 0) {
    src = p->man->test_targets;
  }
  var l: StrList* = sl_new();
  var i: int64 = 0;
  while (i < src->len) {
    var e: string = sl_get(src, i);
    var colon: int64 = s_find_byte(e, 58);
    if (colon > 0) {
      if (!man_test_target(e)) {
        fail_hint("`" + e + "` is not a board target with its board", "a board target names its board after a colon: riscv32-none:pico2");
      }
      sl_add_uniq(l, e);
    } else {
      bx_add_target(p, l, e);
    }
    i = i + 1;
  }
  if (l->len == 0) {
    sl_push(l, sys_os());
  }
  return l;
}

// ---------------------------------------------------------------------------
// mbuild test (16.1): a plan of tests x cells x repeats, run by trn_exec
// ---------------------------------------------------------------------------

const BT_FILE: int32 = 0;   // an @test file, in the interpreter
const BT_PROG: int32 = 1;   // a test program
const BT_CMD: int32 = 2;    // a command test

struct BtTest {
  name: string;
  kind: int32;
  file: string;       // BT_FILE: absolute
  b: BinInfo*;        // BT_PROG
  cmdline: string;    // BT_CMD
  c0: int64;          // its cells: plan cells [c0, c0 + nc)
  nc: int64;
  repeat: int64;
  runs: int64;        // planned, and ended so far
  ended: int64;
  printed: bool;
  hold: bool;         // printed later: native runs, cross-cell check, bless
  native: string;     // its native setting
  golden: string;     // its golden setting: files, files,stdout, off
  gdir: string;       // its golden directory, absolute, and as shown
  gshown: string;
  keep_first: bool;   // each cell's first run is kept for the cross check or bless
}

// One (test, cell).
struct BtCell {
  t: int64;
  spec: string;       // "linux/debug", "riscv32-none:pico2/release"
  target: string;
  board: string;
  profile: string;
  skip: string;       // why it cannot run here
  pre: string;        // why it failed before running (compile, warning)
  cmd: Cmd*;          // what each run runs, 0 when nothing runs
  console: string;
  emulated: bool;
  stamp: string;      // its pass stamp, "" when it is not cached
  fp: string;
  cached: bool;
  runs: int64;
  failed: int64;
  timeouts: int64;
  first: TrnRun*;     // its first failed run, and why
  why: string;
  checks: int64;
  ms: int64;
  native_all: bool;   // an @test file with native=always: no interpreter run
}

struct BtPlan {
  p: Project*;
  tests: BtTest**;
  nt: int64;
  cells: BtCell**;
  ncells: int64;
  runs: TrnRun**;
  nr: int64;
  next_print: int64;
  nocache: bool;
  keep: bool;
  excluded: int64;
  filter: string;
  nspecs: int64;
  run_base: int64;    // trn_exec's run 0 is runs[run_base]
  native_from: int64; // runs from here on are native @test runs
  bless: bool;        // --bless: write the golden files instead of comparing
  only: string;       // --only S
}

// Names a cached test program's pass stamp includes: "name\tkey" (0 = no cache).
var g_bt_keys: StrList* = (StrList*)0;
var g_bt_plan: BtPlan* = (BtPlan*)0;

fn bt_rest_value(p: Project*, flag: string) -> string {
  var i: int64 = 0;
  while (i < p->opts->rest->len) {
    var a: string = sl_get(p->opts->rest, i);
    if (s_starts(a, flag + "=")) {
      return s_from(a, slen(flag) + 1);
    }
    i = i + 1;
  }
  return s_empty();
}

// A test's setting with the command line's overrides.
fn bt_get(p: Project*, name: string, key: string) -> string {
  if (s_eq(key, "warnings") && sl_has(p->opts->rest, "--deny-warnings")) {
    return "error";
  }
  if (s_eq(key, "repeat")) {
    var r: string = bt_rest_value(p, "--repeat");
    if (slen(r) > 0) {
      return r;
    }
  }
  return man_test_get(p->man, name, key);
}

// Every setting of the test and its environment, for its pass stamp.
fn bt_settings_key(p: Project*, name: string) -> string {
  var h: Hasher = h_new();
  h_str(&h, "mbuild-test-v4");
  var keys: StrList* = man_test_keys();
  defer free(keys);
  var i: int64 = 0;
  while (i < keys->len) {
    h_str(&h, sl_get(keys, i) + "=" + bt_get(p, name, sl_get(keys, i)));
    i = i + 1;
  }
  var env: StrList* = man_test_env(p->man, name);
  h_str(&h, sl_join(env, "\n"));
  free(env);
  h_str(&h, gld_hash(p_join(p->root, bt_golden_dir(p, name))));
  return h_hex(&h);
}

// A test's golden directory, from the root.
fn bt_golden_dir(p: Project*, name: string) -> string {
  var d: string = bt_get(p, name, "golden-dir");
  if (slen(d) == 0) {
    d = "tests/golden/" + name;
  }
  return d;
}

// The cells of a test: --matrix=CSV, else -r / -p, else its matrix
// setting; a cell without a target runs on each default target (-t, else
// mb_test_targets, else the host).
fn bt_cells_of(p: Project*, name: string, dflt_targets: StrList*) -> StrList* {
  var spec: string = bt_rest_value(p, "--matrix");
  if (slen(spec) == 0 && p->opts->release) {
    spec = "release";
  } else if (slen(spec) == 0 && !s_eq(p->opts->profile, "debug") && slen(p->opts->profile) > 0) {
    spec = p->opts->profile;
  } else if (slen(spec) == 0) {
    spec = man_test_get(p->man, name, "matrix");
  }
  var out: StrList* = sl_new();
  var parts: StrList* = s_split(spec, 44);
  defer free(parts);
  var i: int64 = 0;
  while (i < parts->len) {
    var cell: string = s_trim(sl_get(parts, i));
    i = i + 1;
    if (slen(cell) == 0) {
      continue;
    }
    var slash: int64 = s_find_byte(cell, 47);
    if (slash >= 0) {
      var tg: string = s_sub(cell, 0, slash);
      if (s_eq(tg, "host")) {
        tg = sys_os();
      }
      sl_add_uniq(out, tg + "/" + s_from(cell, slash + 1));
    } else {
      var k: int64 = 0;
      while (k < dflt_targets->len) {
        sl_add_uniq(out, sl_get(dflt_targets, k) + "/" + cell);
        k = k + 1;
      }
    }
  }
  return out;
}

fn bt_add_test(pl: BtPlan*, name: string, kind: int32) -> BtTest* {
  var t: BtTest* = new BtTest;
  t->name = name;
  t->kind = kind;
  t->file = s_empty();
  t->b = (BinInfo*)0;
  t->cmdline = s_empty();
  t->c0 = 0;
  t->nc = 0;
  t->repeat = 1;
  t->runs = 0;
  t->ended = 0;
  t->printed = false;
  pl->tests = (BtTest**)realloc(pl->tests, (pl->nt + 1) * 8);
  pl->tests[pl->nt] = t;
  pl->nt = pl->nt + 1;
  return t;
}

// The tests to run: the names given (test programs, command tests, @test
// files), else every test but the excluded ones, --filter applied.
fn bt_select(pl: BtPlan*) {
  var p: Project* = pl->p;
  var progs: BinSet* = bx_test_bins(p);
  var prog_names: StrList* = bx_bin_names(progs);
  defer free(prog_names);
  var cmd_names: StrList* = sl_new();
  defer free(cmd_names);
  var i: int64 = 0;
  while (i < p->man->test_cmds->len) {
    var e: string = sl_get(p->man->test_cmds, i);
    sl_push(cmd_names, s_sub(e, 0, s_find_byte(e, 61)));
    i = i + 1;
  }
  var given: StrList* = bx_positional(p->opts->rest);
  defer free(given);
  if (given->len > 0) {
    var cwd: string = bx_cwd();
    i = 0;
    while (i < given->len) {
      var arg: string = sl_get(given, i);
      i = i + 1;
      var a: string = p_clean(p_join(cwd, bx_slash(arg)));
      if (sl_has(prog_names, arg)) {
        var t: BtTest* = bt_add_test(pl, arg, BT_PROG);
        t->b = &progs->items[sl_index(prog_names, arg)];
      } else if (sl_has(cmd_names, arg)) {
        var ct: BtTest* = bt_add_test(pl, arg, BT_CMD);
        var ce: string = sl_get(p->man->test_cmds, sl_index(cmd_names, arg));
        ct->cmdline = s_from(ce, s_find_byte(ce, 61) + 1);
      } else if (fs_is_file(a)) {
        var ft: BtTest* = bt_add_test(pl, bx_rel(p, a), BT_FILE);
        ft->file = a;
      } else {
        var all: StrList* = sl_copy(prog_names);
        defer free(all);
        sl_extend(all, cmd_names);
        if (all->len > 0) {
          fail_hint("no test `" + arg + "`", "the tests are: " + sl_join(all, ", ") + "; or name an @test file");
        }
        fail("no such test file: " + arg);
      }
    }
    return;
  }
  var ex: StrList* = p->man->test_exclude;
  var f: string = p->opts->filter;
  var files: StrList* = sl_new();
  defer free(files);
  bx_test_files(p, progs, files);
  i = 0;
  while (i < files->len) {
    var rel: string = bx_rel(p, sl_get(files, i));
    if (sl_has(ex, rel)) {
      pl->excluded = pl->excluded + 1;
    } else {
      var ft2: BtTest* = bt_add_test(pl, rel, BT_FILE);
      ft2->file = sl_get(files, i);
    }
    i = i + 1;
  }
  i = 0;
  while (i < progs->n) {
    var nm: string = progs->items[i].name;
    if (sl_has(ex, nm)) {
      pl->excluded = pl->excluded + 1;
    } else if (slen(f) == 0 || s_contains(nm, f)) {
      var pt: BtTest* = bt_add_test(pl, nm, BT_PROG);
      pt->b = &progs->items[i];
    }
    i = i + 1;
  }
  i = 0;
  while (i < cmd_names->len) {
    var cn: string = sl_get(cmd_names, i);
    if (sl_has(ex, cn)) {
      pl->excluded = pl->excluded + 1;
    } else if (slen(f) == 0 || s_contains(cn, f)) {
      var ct2: BtTest* = bt_add_test(pl, cn, BT_CMD);
      var ce2: string = sl_get(p->man->test_cmds, i);
      ct2->cmdline = s_from(ce2, s_find_byte(ce2, 61) + 1);
    }
    i = i + 1;
  }
  var named: StrList* = man_test_named(p->man);
  i = 0;
  while (i < named->len) {
    var w: string = sl_get(named, i);
    if (!sl_has(prog_names, w) && !sl_has(cmd_names, w) && !fs_is_file(p->root + "/" + w)) {
      warn("mb_test_set names no test `" + w + "`");
    }
    i = i + 1;
  }
  free(named);
}

fn bt_add_cell(pl: BtPlan*, t: int64, spec: string) {
  var c: BtCell* = new BtCell;
  memset((rawptr)c, 0, (int64)sizeof(BtCell));
  c->t = t;
  c->spec = spec;
  var slash: int64 = s_rfind_byte(spec, 47);
  c->target = s_sub(spec, 0, slash);
  c->profile = s_from(spec, slash + 1);
  c->board = s_empty();
  var colon: int64 = s_find_byte(c->target, 58);
  if (colon > 0) {
    c->board = s_from(c->target, colon + 1);
    c->target = s_sub(c->target, 0, colon);
  }
  c->skip = s_empty();
  c->pre = s_empty();
  c->console = s_empty();
  c->stamp = s_empty();
  c->fp = s_empty();
  c->why = s_empty();
  pl->cells = (BtCell**)realloc(pl->cells, (pl->ncells + 1) * 8);
  pl->cells[pl->ncells] = c;
  pl->ncells = pl->ncells + 1;
}

// Why the cell's target cannot run a test program here, "" when it can.
fn bt_cannot_run(p: Project*, target: string, prog: string) -> string {
  if (target_is_riscv(target)) {
    var q: SettingsQuery* = new SettingsQuery;
    q->profile = build_profile(p);
    q->bin = prog;
    q->target = target;
    q->sets = p->opts->sets;
    var st: Settings* = man_settings(p->man, q);
    free(q);
    var why: string = s_empty();
    if (slen(st->error) > 0) {
      why = bx_unroot(p, st->error);
    } else {
      why = rv_runner_missing(tc_select(p, target), target, st);
    }
    free(st);
    return why;
  }
  if (!s_eq(target, sys_os()) && tc_run_program_cmd(target, "x") == (Cmd*)0) {
    return "cannot run a " + target + " program on this " + sys_os() + " host";
  }
  return s_empty();
}

// The interpreter command of an @test file in the cell's session.
fn bt_file_cell(s: BxSess*, u: BxUnit*, c: BtCell*, name: string) {
  var p: Project* = s->p;
  bx_unit_cmp(s, u, "test-" + bx_safe_name(name));
  var cmd: Cmd* = tc_cmd(u->m);
  cmd_arg(cmd, "test");
  cmd_path(cmd, bx_rel(p, u->entry));
  bx_add_include(cmd, p, s->ds, bx_unit_gen(u));
  var st: Settings* = bx_add_flags(cmd, s, u);
  free(st);
  if (target_is_riscv(c->target)) {
    // the interpreter runs @test functions on the host
    bx_drop_valued(cmd, "--board --isa --abi --objective");
  }
  if (slen(p->opts->filter) > 0) {
    cmd_arg(cmd, "--filter=" + p->opts->filter);
  }
  bx_diag_env(cmd);
  var h: Hasher = h_new();
  h_str(&h, "mbuild-test-v4");
  bx_hash_cmd(&h, p, u->m, cmd);
  h_str(&h, c->spec);
  graph_fingerprint(u->g, &h);
  h_str(&h, bt_settings_key(p, name));
  c->fp = h_hex(&h);
  c->cmd = cmd;
}

// A command test's words: the first resolved against the cell's test
// programs and bins (out dirs), then a path or PATH.
fn bt_cmd_cell(p: Project*, c: BtCell*, cmdline: string, progs_dir: string, bins_dir: string, progs: StrList*, bins: StrList*) {
  var w: SvcWords = svc_split(cmdline);
  if (!w.ok || w.words->len == 0) {
    c->pre = "cannot split `" + cmdline + "` into words";
    return;
  }
  var prog: string = sl_get(w.words, 0);
  var t: Tool = tool_none();
  var ext: string = target_exe_ext(c->target);
  if (sl_has(progs, prog)) {
    t.path = progs_dir + "/" + prog + ext;
  } else if (sl_has(bins, prog)) {
    t.path = bins_dir + "/" + prog + ext;
  } else if (s_find_byte(prog, 47) >= 0 || s_find_byte(prog, 92) >= 0) {
    t.path = p_join(p->root, prog);
  } else {
    t = sys_find_tool(prog);
  }
  if (!tool_found(t)) {
    c->pre = "cannot find `" + prog + "`";
    return;
  }
  var cmd: Cmd* = cmd_new(t);
  var k: int64 = 1;
  while (k < w.words->len) {
    cmd_arg(cmd, sl_get(w.words, k));
    k = k + 1;
  }
  c->cmd = cmd;
}

// The prefix of a test program's pass stamp, so bx_plan can skip one that
// passed with the same build and settings ("" = no cache).
fn bt_key_of(name: string) -> string {
  if (g_bt_keys == (StrList*)0) {
    return s_empty();
  }
  var i: int64 = 0;
  while (i < g_bt_keys->len) {
    var e: string = sl_get(g_bt_keys, i);
    var tab: int64 = s_find_byte(e, 9);
    if (s_eq(s_sub(e, 0, tab), name)) {
      return s_from(e, tab + 1);
    }
    i = i + 1;
  }
  return s_empty();
}

// Builds what the cells with this spec need and sets their commands.
fn bt_spec(pl: BtPlan*, spec: string) {
  var p: Project* = pl->p;
  var mine: StrList* = sl_new();      // indexes of the cells, as text
  defer free(mine);
  var first: BtCell* = (BtCell*)0;
  var i: int64 = 0;
  while (i < pl->ncells) {
    if (s_eq(pl->cells[i]->spec, spec)) {
      sl_push(mine, s_int(i));
      if (first == (BtCell*)0) {
        first = pl->cells[i];
      }
    }
    i = i + 1;
  }
  var target: string = first->target;
  if (!target_valid(target)) {
    var dummy: StrList* = sl_new();
    bx_add_target(p, dummy, target);
    free(dummy);
  }
  if (!tc_available(p, target)) {
    bt_skip_all(pl, mine, "no Mettle compiler for " + target);
    return;
  }
  var saved_sets: StrList* = p->opts->sets;
  var saved_prof: string = p->opts->profile;
  var saved_rel: bool = p->opts->release;
  p->opts->profile = first->profile;
  p->opts->release = false;
  if (slen(first->board) > 0) {
    p->opts->sets = sl_copy(saved_sets);
    sl_push(p->opts->sets, "board=" + first->board);
  }
  if (pl->nspecs > 1) {
    status("Testing", spec);
  }
  // the programs this spec builds: test programs, and those command tests start
  var prog_names: StrList* = sl_new();
  defer free(prog_names);
  var bin_names: StrList* = sl_new();
  defer free(bin_names);
  var proj_bins: StrList* = bx_bin_names(build_bins(p));
  defer free(proj_bins);
  var dep_bins: StrList* = sl_new();
  defer free(dep_bins);
  var di: int64 = 0;
  while (di < p->man->dep_bins->len) {
    var de: string = sl_get(p->man->dep_bins, di);
    sl_push(dep_bins, s_from(de, s_find_byte(de, 61) + 1));
    di = di + 1;
  }
  var all_progs: BinSet* = bx_test_bins(p);
  var all_prog_names: StrList* = bx_bin_names(all_progs);
  defer free(all_prog_names);
  var why_run: string = s_empty();
  i = 0;
  while (i < mine->len) {
    var c: BtCell* = pl->cells[s_to_int(sl_get(mine, i))];
    var t: BtTest* = pl->tests[c->t];
    if (t->kind == BT_FILE && target_is_bare(target)) {
      c->skip = "@test functions run on hosted targets";
    } else if (t->kind == BT_PROG) {
      sl_add_uniq(prog_names, t->name);
    } else if (t->kind == BT_CMD) {
      bt_first_word(t->cmdline, all_prog_names, proj_bins, dep_bins, prog_names, bin_names);
    }
    if (slen(c->skip) == 0) {
      // the programs of its fixtures
      var svs: StrList* = s_split(bt_get(p, t->name, "services"), 44);
      var q: int64 = 0;
      while (q < svs->len) {
        var sv: ServiceSpec* = man_service(p->man, s_trim(sl_get(svs, q)));
        if (sv != (ServiceSpec*)0) {
          bt_first_word(sv->cmd, all_prog_names, proj_bins, dep_bins, prog_names, bin_names);
        }
        q = q + 1;
      }
      free(svs);
    }
    i = i + 1;
  }
  if (prog_names->len > 0) {
    why_run = bt_cannot_run(p, target, sl_get(prog_names, 0));
  } else if (bin_names->len > 0) {
    why_run = bt_cannot_run(p, target, sl_get(bin_names, 0));
  }
  var progs_dir: string = p->state_dir + "/test-bins/" + target + "/" + first->profile;
  var bins_dir: string = p->root + "/build/" + target + "/" + first->profile;
  var built: StrList* = sl_new();
  defer free(built);
  var s: BxSess* = bx_sess(p, sl_of(target));
  g_bx_sess = s;
  // project bins a command test starts: a normal build
  if (bin_names->len > 0 && slen(why_run) == 0) {
    var bus: BxUnits* = bx_bin_units(s, bx_select_bins(p, bin_names));
    g_bx_units = bus;
    if (bx_build_units(s, bus) != 0) {
      bt_pre_all(pl, mine, "its programs did not build");
    }
  }
  s->tests = true;
  var us: BxUnits* = (BxUnits*)0;
  if (prog_names->len > 0 && slen(why_run) == 0) {
    us = bx_bin_units(s, bx_select_from(p, all_progs, prog_names));
    g_bx_units = us;
    bx_prepare(s, us, s_empty());
    bx_compile_units(s, us, built);
  }
  // @test files: one unit each, prepared together
  var fus: BxUnits* = bx_units_new();
  var fcells: StrList* = sl_new();
  defer free(fcells);
  var bins: BinSet* = build_bins(p);
  i = 0;
  while (i < mine->len) {
    var fc: BtCell* = pl->cells[s_to_int(sl_get(mine, i))];
    var ft: BtTest* = pl->tests[fc->t];
    if (ft->kind == BT_FILE && slen(fc->skip) == 0) {
      bx_unit_add(fus, bx_bin_of_entry(bins, ft->file), ft->file, 0, target, s->mettles[0]);
      sl_push(fcells, sl_get(mine, i));
    }
    i = i + 1;
  }
  if (fus->n > 0) {
    g_bx_units = fus;
    bx_prepare(s, fus, "test");
  }
  i = 0;
  while (i < mine->len) {
    var c2: BtCell* = pl->cells[s_to_int(sl_get(mine, i))];
    var t2: BtTest* = pl->tests[c2->t];
    i = i + 1;
    if (slen(c2->skip) > 0 || slen(c2->pre) > 0) {
      continue;
    }
    if (t2->kind == BT_FILE) {
      var at: int64 = bt_unit_at(fcells, pl, c2);
      bt_file_cell(s, fus->items[at], c2, t2->name);
      if (s_eq(t2->native, "always")) {
        c2->native_all = true;
        c2->cmd = (Cmd*)0;
      } else {
        bt_cache(pl, c2);
      }
      continue;
    }
    if (slen(why_run) > 0) {
      c2->skip = why_run;
      continue;
    }
    if (t2->kind == BT_PROG) {
      bt_prog_cell(pl, s, us, c2, t2);
    } else {
      bt_cmd_cell(p, c2, t2->cmdline, progs_dir, bins_dir, all_prog_names, bin_names);
      var w2: SvcWords = svc_split(t2->cmdline);
      if (slen(c2->pre) == 0 && w2.ok && sl_has(prog_names, sl_get(w2.words, 0)) && us != (BxUnits*)0 && !bt_unit_ok(us, sl_get(w2.words, 0))) {
        c2->pre = sl_get(w2.words, 0) + " did not compile";
      }
    }
  }
  p->opts->sets = saved_sets;
  p->opts->profile = saved_prof;
  p->opts->release = saved_rel;
}

// The first word of cmdline into progs or bins when it names a test program
// or a bin of this project or of mb_dep_bin.
fn bt_first_word(cmdline: string, all_progs: StrList*, proj_bins: StrList*, dep_bins: StrList*, progs: StrList*, bins: StrList*) {
  var w: SvcWords = svc_split(cmdline);
  if (w.ok && w.words->len > 0) {
    var w0: string = sl_get(w.words, 0);
    if (sl_has(all_progs, w0)) {
      sl_add_uniq(progs, w0);
    } else if (sl_has(proj_bins, w0) || sl_has(dep_bins, w0)) {
      sl_add_uniq(bins, w0);
    }
  }
  free(w.words);
}

// The unit of an @test file cell, by its place in fcells.
fn bt_unit_at(fcells: StrList*, pl: BtPlan*, c: BtCell*) -> int64 {
  var i: int64 = 0;
  while (i < fcells->len) {
    if (pl->cells[s_to_int(sl_get(fcells, i))] == c) {
      return i;
    }
    i = i + 1;
  }
  return 0;
}

fn bt_unit_of(us: BxUnits*, name: string) -> BxUnit* {
  var i: int64 = 0;
  while (i < us->n) {
    if (s_eq(us->items[i]->b->name, name)) {
      return us->items[i];
    }
    i = i + 1;
  }
  return (BxUnit*)0;
}

fn bt_unit_ok(us: BxUnits*, name: string) -> bool {
  var u: BxUnit* = bt_unit_of(us, name);
  return u != (BxUnit*)0 && u->job != (BxJob*)0 && u->job->ok;
}

fn bt_skip_all(pl: BtPlan*, mine: StrList*, why: string) {
  var i: int64 = 0;
  while (i < mine->len) {
    pl->cells[s_to_int(sl_get(mine, i))]->skip = why;
    i = i + 1;
  }
}

fn bt_pre_all(pl: BtPlan*, mine: StrList*, why: string) {
  var i: int64 = 0;
  while (i < mine->len) {
    var c: BtCell* = pl->cells[s_to_int(sl_get(mine, i))];
    if (pl->tests[c->t]->kind == BT_CMD) {
      c->pre = why;
    }
    i = i + 1;
  }
}

// A cell's pass stamp, and whether it holds.
fn bt_cache(pl: BtPlan*, c: BtCell*) {
  if (pl->nocache || pl->tests[c->t]->kind == BT_CMD || slen(c->fp) == 0) {
    return;
  }
  c->stamp = pl->p->state_dir + "/stamps/test-" + c->fp;
  c->cached = bx_stamp_ok(pl->p, c->stamp, c->fp);
}

// A test program's cell: compiled, warnings allowed, its command.
fn bt_prog_cell(pl: BtPlan*, s: BxSess*, us: BxUnits*, c: BtCell*, t: BtTest*) {
  var p: Project* = pl->p;
  var u: BxUnit* = bt_unit_of(us, t->name);
  if (u == (BxUnit*)0 || u->job == (BxJob*)0 || !u->job->ok) {
    c->pre = "did not compile";
    return;
  }
  var j: BxJob* = u->job;
  var wr: FsRead = fs_read(j->outp + ".warnings");
  var warns: StrList* = s_lines(wr.data);
  c->pre = trn_denied(warns, bt_get(p, t->name, "warnings"));
  free(warns);
  if (slen(c->pre) > 0) {
    return;
  }
  c->stamp = j->pass;
  c->fp = j->fp;
  c->cached = j->state == 3;
  if (s_eq(bt_get(p, t->name, "run"), "false")) {
    return;
  }
  var run_at: string = j->outp;
  var cmd: Cmd* = bx_emu_cmd(s, j->b, j->t, &run_at);
  c->emulated = cmd != (Cmd*)0;
  if (cmd == (Cmd*)0) {
    cmd = tc_run_program_cmd(j->t->target, j->outp);
  }
  if (cmd == (Cmd*)0) {
    c->skip = "cannot run a " + j->t->target + " program on this " + sys_os() + " host";
    return;
  }
  c->console = bx_console_pass(s, j->b, j->t, cmd);
  c->cmd = cmd;
}

// The per-run timeout: --timeout, else the test's setting, else 30 s
// under an emulator, else 600 s.
fn bt_timeout_ms(p: Project*, name: string, emulated: bool) -> int64 {
  var cli: string = bt_rest_value(p, "--timeout");
  if (slen(cli) > 0) {
    return bx_timeout_ms(p, emulated);
  }
  if (!man_test_has(p->man, name, "timeout") && emulated) {
    return 30000;
  }
  return s_to_int(man_test_get(p->man, name, "timeout")) * 1000;
}

fn bt_run_dir(p: Project*, c: BtCell*, name: string, k: int64) -> string {
  var cell: string = s_replace_byte(s_replace_byte(c->spec, 47, 45), 58, 45);
  return p->state_dir + "/test-run/" + cell + "/" + bx_safe_name(name) + "/" + s_int(k);
}

// The runs of every cell that runs.
fn bt_runs(pl: BtPlan*) {
  var p: Project* = pl->p;
  var i: int64 = 0;
  while (i < pl->ncells) {
    var c: BtCell* = pl->cells[i];
    var t: BtTest* = pl->tests[c->t];
    i = i + 1;
    if (slen(c->skip) > 0 || slen(c->pre) > 0 || c->cached || c->cmd == (Cmd*)0) {
      continue;
    }
    var args: SvcWords = svc_split(bt_get(p, t->name, "args"));
    var serial: bool = s_eq(bt_get(p, t->name, "serial"), "true");
    var cwd_tmp: bool = s_eq(bt_get(p, t->name, "cwd"), "tmp");
    var env: StrList* = man_test_env(p->man, t->name);
    defer free(env);
    var ms: int64 = bt_timeout_ms(p, t->name, c->emulated);
    var svs: StrList* = bt_svc_names(p, t->name);
    var k: int64 = 1;
    while (k <= t->repeat) {
      var r: TrnRun* = trn_run_new(c->t, i - 1, k);
      r->dir = bt_run_dir(p, c, t->name, k);
      var vars: StrList* = sl_of("MBUILD_ROOT=" + p->root);
      sl_push(vars, "MBUILD_TEST_TMP=" + r->dir + "/tmp");
      sl_push(vars, "MBUILD_TEST_OUT=" + r->dir + "/out");
      if (svs->len > 0) {
        bt_fixtures(p, c, r, svs, vars);
      }
      var cmd: Cmd* = cmd_new(c->cmd->tool);
      cmd_args(cmd, svc_expand_all(sl_copy(c->cmd->args), vars));
      if (t->kind == BT_PROG && args.ok) {
        cmd_args(cmd, svc_expand_all(sl_copy(args.words), vars));
      }
      sl_extend(cmd->env, c->cmd->env);
      svc_port_env(cmd->env, vars);
      free(vars);
      r->cmd = cmd;
      r->timeout_ms = ms;
      r->serial = serial;
      r->console = c->console;
      trn_prepare(r, p->root, t->name, c->spec, cwd_tmp, env);
      if (k == 1) {
        verbose(cmd_display(cmd));
      }
      pl->runs = (TrnRun**)realloc(pl->runs, (pl->nr + 1) * 8);
      pl->runs[pl->nr] = r;
      pl->nr = pl->nr + 1;
      c->runs = c->runs + 1;
      t->runs = t->runs + 1;
      k = k + 1;
    }
    free(svs);
  }
}

// The services a test names.
fn bt_svc_names(p: Project*, name: string) -> StrList* {
  var l: StrList* = sl_new();
  var parts: StrList* = s_split(bt_get(p, name, "services"), 44);
  var i: int64 = 0;
  while (i < parts->len) {
    var sv: string = s_trim(sl_get(parts, i));
    if (slen(sv) > 0) {
      sl_push(l, sv);
    }
    i = i + 1;
  }
  free(parts);
  return l;
}

// A run's fixtures: ports (auto ones from the pool, into vars), words
// expanded, programs resolved in the cell, cwd the run's tmp/.
fn bt_fixtures(p: Project*, c: BtCell*, r: TrnRun*, svs: StrList*, vars: StrList*) {
  var m: Manifest* = p->man;
  var ports: StrList* = svc_ports_for(p, m, svs, vars);
  defer free(ports);
  var progs: StrList* = bx_bin_names(bx_test_bins(p));
  defer free(progs);
  var bins: StrList* = bx_bin_names(build_bins(p));
  defer free(bins);
  var ext: string = target_exe_ext(c->target);
  r->svcs = (TrnSvc*)malloc((m->nservices + 1) * sizeof(TrnSvc));
  r->nsvcs = 0;
  var i: int64 = 0;
  while (i < m->nservices) {
    var spec: ServiceSpec* = &m->services[i];
    i = i + 1;
    if (!sl_has(svs, spec->name)) {
      continue;
    }
    var sv: TrnSvc* = &r->svcs[r->nsvcs];
    r->nsvcs = r->nsvcs + 1;
    sv->name = spec->name;
    sv->port = s_to_int(sl_get(ports, i - 1));
    sv->check_port = !spec->auto_port;
    sv->wait_ms = spec->wait_ms;
    sv->log = r->dir + "/service-" + spec->name + ".log";
    sv->cmd = (Cmd*)0;
    var w: SvcWords = svc_split(spec->cmd);
    var words: StrList* = svc_expand_all(w.words, vars);
    sv->prog = sl_get(words, 0);
    var t: Tool = tool_none();
    if (sl_has(progs, sv->prog)) {
      t.path = p->state_dir + "/test-bins/" + c->target + "/" + c->profile + "/" + sv->prog + ext;
    } else if (sl_has(bins, sv->prog) || bt_is_dep_bin(m, sv->prog)) {
      t.path = p->root + "/build/" + c->target + "/" + c->profile + "/" + sv->prog + ext;
    } else if (s_find_byte(sv->prog, 47) >= 0 || s_find_byte(sv->prog, 92) >= 0) {
      t.path = p_join(p->root, sv->prog);
    } else {
      t = sys_find_tool(sv->prog);
    }
    if (tool_found(t)) {
      var sc: Cmd* = cmd_new(t);
      var k: int64 = 1;
      while (k < words->len) {
        cmd_arg(sc, sl_get(words, k));
        k = k + 1;
      }
      sc->cwd = r->dir + "/tmp";
      sl_extend(sc->env, spec->env);
      sl_extend(sc->env, vars);
      sv->cmd = sc;
    }
    free(words);
  }
}

fn bt_is_dep_bin(m: Manifest*, name: string) -> bool {
  var i: int64 = 0;
  while (i < m->dep_bins->len) {
    var e: string = sl_get(m->dep_bins, i);
    if (s_eq(s_from(e, s_find_byte(e, 61) + 1), name)) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

// Why a run failed, "" when it passed; its checks.
fn bt_judge(pl: BtPlan*, r: TrnRun*, checks: int64*) -> string {
  var p: Project* = pl->p;
  var t: BtTest* = pl->tests[r->test];
  var why: string = trn_exit_why(r);
  if (t->kind == BT_FILE && r->native) {
    *checks = tnv_passed(r->out);
    if (slen(why) > 0) {
      why = "natively: " + why;
    }
    return why;
  }
  if (t->kind == BT_FILE) {
    var skipped: StrList* = sl_new();
    *checks = trn_interp(r->out + r->err, skipped);
    free(skipped);
    if (slen(why) == 0) {
      var w: StrList* = trn_warnings(r->out + r->err);
      why = trn_denied(w, bt_get(p, t->name, "warnings"));
      free(w);
    }
  } else {
    *checks = trn_checks(r->out, bt_get(p, t->name, "checks"));
  }
  if (slen(why) == 0 && !pl->bless && !s_eq(t->golden, "off") && fs_is_dir(t->gdir)) {
    why = gld_compare(t->gdir, t->gshown, r->dir + "/out", r->out, s_contains(t->golden, "stdout"), bt_get(p, t->name, "png-tolerance"));
  }
  return why;
}

// The cells of a test as its line shows them: profiles alone when every
// cell is on the host.
fn bt_cells_label(pl: BtPlan*, t: BtTest*) -> string {
  var host: bool = true;
  var k: int64 = 0;
  while (k < t->nc) {
    var c: BtCell* = pl->cells[t->c0 + k];
    if (!s_eq(c->target, sys_os()) || slen(c->board) > 0) {
      host = false;
    }
    k = k + 1;
  }
  var l: StrList* = sl_new();
  defer free(l);
  k = 0;
  while (k < t->nc) {
    var c2: BtCell* = pl->cells[t->c0 + k];
    if (host) {
      sl_push(l, c2->profile);
    } else {
      sl_push(l, c2->spec);
    }
    k = k + 1;
  }
  return sl_join(l, ", ");
}

fn bt_checks_text(n: int64) -> string {
  if (n == 1) {
    return "1 check";
  }
  return s_int(n) + " checks";
}

// "test NAME (CELLS) ... ok  0.3s  42 checks"
fn bt_print(pl: BtPlan*, t: BtTest*) {
  t->printed = true;
  var runs: int64 = 0;
  var failed: int64 = 0;
  var timeouts: int64 = 0;
  var cached: int64 = 0;
  var skipped: int64 = 0;
  var checks: int64 = 0;
  var ms: int64 = 0;
  var skip_why: string = s_empty();
  var to_ms: int64 = 0;
  var k: int64 = 0;
  while (k < t->nc) {
    var c: BtCell* = pl->cells[t->c0 + k];
    k = k + 1;
    if (slen(c->skip) > 0) {
      skipped = skipped + 1;
      skip_why = c->skip;
      continue;
    }
    if (slen(c->pre) > 0) {
      failed = failed + 1;
      runs = runs + 1;
      continue;
    }
    if (c->cached) {
      cached = cached + 1;
    }
    runs = runs + c->runs;
    failed = failed + c->failed;
    timeouts = timeouts + c->timeouts;
    ms = ms + c->ms;
    if (checks == 0) {
      checks = c->checks;
    }
    if (c->timeouts > 0 && c->first != (TrnRun*)0) {
      to_ms = c->first->timeout_ms;
    }
  }
  var head: string = "test " + t->name + " (" + bt_cells_label(pl, t) + ") ... ";
  if (skipped == t->nc) {
    say(head + yellow("skipped") + " (" + skip_why + ")");
    return;
  }
  if (failed > 0) {
    var word: string = red("FAILED");
    if (timeouts == failed) {
      word = red("TIMEOUT") + " " + trn_secs(to_ms);
    } else if (t->repeat > 1) {
      word = word + " " + s_int(failed) + "/" + s_int(runs);
    }
    say(head + word);
    bt_print_skips(pl, t, skipped);
    return;
  }
  if (g_quiet) {
    return;
  }
  var line: string = head + green("ok");
  if (cached == t->nc - skipped) {
    line = line + " " + dim("(cached)");
  } else {
    line = line + "  " + trn_secs(ms);
  }
  if (checks > 0) {
    line = line + "  " + bt_checks_text(checks);
  }
  say(line);
  bt_print_skips(pl, t, skipped);
}

// "    riscv64-linux/debug skipped: why" under a test that ran elsewhere.
fn bt_print_skips(pl: BtPlan*, t: BtTest*, skipped: int64) {
  if (skipped == 0 || skipped == t->nc) {
    return;
  }
  var k: int64 = 0;
  while (k < t->nc) {
    var c: BtCell* = pl->cells[t->c0 + k];
    if (slen(c->skip) > 0) {
      say("    " + c->spec + " " + yellow("skipped") + ": " + c->skip);
    }
    k = k + 1;
  }
}

// Prints the tests whose runs all ended, in plan order.
fn bt_print_ready(pl: BtPlan*) {
  while (pl->next_print < pl->nt) {
    var t: BtTest* = pl->tests[pl->next_print];
    if (t->ended < t->runs || t->hold) {
      return;
    }
    bt_print(pl, t);
    flush_out();
    pl->next_print = pl->next_print + 1;
  }
}

fn bt_ended(arg: rawptr, i: int64) -> bool {
  var pl: BtPlan* = (BtPlan*)arg;
  var r: TrnRun* = pl->runs[pl->run_base + i];
  var c: BtCell* = pl->cells[r->cell];
  var t: BtTest* = pl->tests[r->test];
  var checks: int64 = 0;
  var why: string = bt_judge(pl, r, &checks);
  c->ms = c->ms + r->ms;
  if (pl->native_from > 0 && pl->run_base + i >= pl->native_from) {
    if (r->k == 1) {
      c->checks = c->checks + checks;
    }
  } else if (c->checks == 0) {
    c->checks = checks;
  }
  if (slen(why) > 0) {
    c->failed = c->failed + 1;
    if (r->timed_out) {
      c->timeouts = c->timeouts + 1;
    }
    if (c->first == (TrnRun*)0) {
      c->first = r;
      c->why = why;
    }
  } else if (!pl->keep && !(t->keep_first && r->k == 1 && !r->native)) {
    sys_remove_tree(r->dir);
  }
  var q: int64 = 0;
  while (q < r->nsvcs) {
    if (!r->svcs[q].check_port && r->svcs[q].port > 0) {
      svc_port_release(r->svcs[q].port);
    }
    q = q + 1;
  }
  t->ended = t->ended + 1;
  bt_print_ready(pl);
  return true;
}

// Each failed cell once: why, the end of its output, the kept directory.
fn bt_failures(pl: BtPlan*) {
  var p: Project* = pl->p;
  var n: int64 = 0;
  var i: int64 = 0;
  while (i < pl->ncells) {
    var c: BtCell* = pl->cells[i];
    var t: BtTest* = pl->tests[c->t];
    i = i + 1;
    if (slen(c->pre) == 0 && c->first == (TrnRun*)0) {
      continue;
    }
    if (n == 0) {
      say("");
      say("failures:");
    }
    n = n + 1;
    say("");
    if (slen(c->pre) > 0) {
      say("---- " + t->name + " (" + c->spec + "): " + c->pre);
      continue;
    }
    var r: TrnRun* = c->first;
    var head: string = "---- " + t->name + " (" + c->spec;
    if (t->repeat > 1) {
      head = head + ", run " + s_int(r->k);
    }
    head = head + "): " + c->why;
    if (c->failed > 1) {
      head = head + " (" + s_int(c->failed) + " of " + s_int(c->runs) + " runs failed)";
    }
    say(head);
    if (slen(s_trim(r->out)) > 0) {
      say("stdout:");
      print(trn_tail(r->out, 40, "  "));
    }
    if (slen(s_trim(r->err)) > 0) {
      say("stderr:");
      print(trn_tail(r->err, 40, "  "));
    }
    if (slen(r->svc_why) > 0 && r->nsvcs_up > 0) {
      var sv: TrnSvc* = &r->svcs[r->nsvcs_up - 1];
      var lr: FsRead = fs_read(sv->log);
      say("service " + sv->name + " (" + bx_show(sv->log) + "):");
      print(trn_tail(lr.data, 20, "  "));
    }
    say("kept: " + bx_show(r->dir));
  }
  flush_out();
}

// Stamps the cells that passed and could be cached.
fn bt_stamp(pl: BtPlan*) {
  var i: int64 = 0;
  while (i < pl->ncells) {
    var c: BtCell* = pl->cells[i];
    i = i + 1;
    if (c->failed == 0 && c->runs > 0 && !pl->keep) {
      sys_remove_tree(p_dir(bt_run_dir(pl->p, c, pl->tests[c->t]->name, 1)));
    }
    if (!pl->nocache && slen(c->stamp) > 0 && !c->cached && slen(c->skip) == 0 && slen(c->pre) == 0 && c->failed == 0) {
      fs_mkdirs(p_dir(c->stamp));
      fs_write(c->stamp, c->fp + "\n");
    }
  }
}

// Outputs of tests that are gone: test-bins files and stamps, run dirs.
fn bt_clean_stale(p: Project*) {
  var names: StrList* = bx_bin_names(bx_test_bins(p));
  defer free(names);
  var safe: StrList* = sl_new();
  defer free(safe);
  var i: int64 = 0;
  while (i < names->len) {
    sl_push(safe, bx_safe_name(sl_get(names, i)));
    i = i + 1;
  }
  var cmds: StrList* = p->man->test_cmds;
  i = 0;
  while (i < cmds->len) {
    var e: string = sl_get(cmds, i);
    sl_push(safe, s_sub(e, 0, s_find_byte(e, 61)));
    i = i + 1;
  }
  var files: StrList* = sl_new();
  bx_test_files(p, bx_test_bins(p), files);
  i = 0;
  while (i < files->len) {
    sl_push(safe, bx_safe_name(bx_rel(p, sl_get(files, i))));
    sl_push(names, bt_native_name(bx_rel(p, sl_get(files, i))));
    i = i + 1;
  }
  free(files);
  // .mbuild/test-bins/<target>/<profile>/<name>[.exe, .warnings, ...]
  var tb: string = p->state_dir + "/test-bins";
  var tf: StrList* = sl_new();
  defer free(tf);
  var tds: StrList* = sl_new();
  defer free(tds);
  sys_list_dir(tb, tf, tds);
  var a: int64 = 0;
  while (a < tds->len) {
    var pf: StrList* = sl_new();
    defer free(pf);
    var pds: StrList* = sl_new();
    defer free(pds);
    sys_list_dir(tb + "/" + sl_get(tds, a), pf, pds);
    var b: int64 = 0;
    while (b < pds->len) {
      var dir: string = tb + "/" + sl_get(tds, a) + "/" + sl_get(pds, b);
      var fl: StrList* = sl_new();
      defer free(fl);
      var dl: StrList* = sl_new();
      defer free(dl);
      sys_list_dir(dir, fl, dl);
      var f: int64 = 0;
      while (f < fl->len) {
        var fname: string = sl_get(fl, f);
        var dot: int64 = s_find_byte(fname, 46);
        var stem: string = fname;
        if (dot > 0) {
          stem = s_sub(fname, 0, dot);
        }
        if (!sl_has(names, stem) && !sl_has(names, fname) && !s_starts(fname, "lib")) {
          sys_remove_file(dir + "/" + fname);
        }
        f = f + 1;
      }
      b = b + 1;
    }
    a = a + 1;
  }
  // .mbuild/stamps/test-bin-<target>-<profile>-<name>.stamp
  var sf: StrList* = sl_new();
  defer free(sf);
  var sd: StrList* = sl_new();
  defer free(sd);
  sys_list_dir(p->state_dir + "/stamps", sf, sd);
  i = 0;
  while (i < sf->len) {
    var st: string = sl_get(sf, i);
    i = i + 1;
    if (!s_starts(st, "test-bin-") || !s_ends(st, ".stamp")) {
      continue;
    }
    var mid: string = s_sub(st, 9, slen(st) - 6);
    var keep: bool = false;
    var q: int64 = 0;
    while (q < names->len && !keep) {
      keep = s_ends(mid, "-" + sl_get(names, q));
      q = q + 1;
    }
    if (!keep) {
      sys_remove_file(p->state_dir + "/stamps/" + st);
    }
  }
  // .mbuild/test-run/<cell>/<name>/
  var rf: StrList* = sl_new();
  defer free(rf);
  var rd: StrList* = sl_new();
  defer free(rd);
  sys_list_dir(p->state_dir + "/test-run", rf, rd);
  i = 0;
  while (i < rd->len) {
    var cd: string = p->state_dir + "/test-run/" + sl_get(rd, i);
    var nf: StrList* = sl_new();
    defer free(nf);
    var nd: StrList* = sl_new();
    defer free(nd);
    sys_list_dir(cd, nf, nd);
    var j: int64 = 0;
    while (j < nd->len) {
      if (!sl_has(safe, sl_get(nd, j))) {
        sys_remove_tree(cd + "/" + sl_get(nd, j));
      }
      j = j + 1;
    }
    i = i + 1;
  }
}


// ---------------------------------------------------------------------------
// @test files natively (testnative): what the interpreter skipped, or every
// test with native=always, as a program per file and cell
// ---------------------------------------------------------------------------

fn bt_native_name(rel: string) -> string {
  var stem: string = rel;
  if (s_ends(stem, ".mettle")) {
    stem = s_sub(stem, 0, slen(stem) - 7);
  }
  return bx_safe_name(stem) + "__mbt";
}

// The tests a file cell runs natively: "name\t1" entries, none when it
// needs no native run.
fn bt_native_tests(pl: BtPlan*, c: BtCell*, text: string) -> StrList* {
  var t: BtTest* = pl->tests[c->t];
  var all: StrList* = tnv_tests(text);
  if (c->native_all) {
    if (slen(pl->filter) == 0) {
      return all;
    }
    var keep: StrList* = sl_new();
    var i: int64 = 0;
    while (i < all->len) {
      if (s_contains(sl_get(all, i), pl->filter)) {
        sl_push(keep, sl_get(all, i));
      }
      i = i + 1;
    }
    free(all);
    return keep;
  }
  var skipped: StrList* = sl_new();
  defer free(skipped);
  if (!s_eq(t->native, "never")) {
    var k: int64 = 0;
    while (k < pl->nr) {
      var r: TrnRun* = pl->runs[k];
      if (r->cell >= 0 && pl->cells[r->cell] == c && r->k == 1 && !r->native) {
        trn_interp(r->out + r->err, skipped);
        break;
      }
      k = k + 1;
    }
  }
  var picked: StrList* = tnv_pick(all, skipped);
  free(all);
  return picked;
}

// Writes the copies of one spec's file cells, builds them, adds their runs.
fn bt_native_spec(pl: BtPlan*, spec: string) {
  var p: Project* = pl->p;
  var cells: StrList* = sl_new();
  defer free(cells);
  var bs: BinSet* = bx_no_test_bins(p);
  var first: BtCell* = (BtCell*)0;
  var i: int64 = 0;
  while (i < pl->ncells) {
    var c: BtCell* = pl->cells[i];
    var t: BtTest* = pl->tests[c->t];
    i = i + 1;
    if (t->kind != BT_FILE || !s_eq(c->spec, spec) || slen(c->skip) > 0 || slen(c->pre) > 0 || c->cached) {
      continue;
    }
    var rd: FsRead = fs_read(t->file);
    var tests: StrList* = bt_native_tests(pl, c, rd.data);
    if (tests->len == 0) {
      free(tests);
      continue;
    }
    var name: string = bt_native_name(t->name);
    var rel: string = ".mbuild/test-native/" + p_dir(t->name);
    if (s_eq(p_dir(t->name), ".") || slen(p_dir(t->name)) == 0) {
      rel = ".mbuild/test-native";
    }
    var main: string = rel + "/" + p_base(name) + ".mettle";
    fs_mkdirs(p->root + "/" + rel);
    fs_write_if_changed(p->root + "/" + main, tnv_source(rd.data, tests));
    free(tests);
    bx_binset_push(bs, name, main);
    var b: BinInfo* = &bs->items[bs->n - 1];
    sl_push(b->flags, "-I");
    sl_push(b->flags, bx_rel(p, p_dir(t->file)));
    sl_push(cells, s_int(i - 1));
    if (first == (BtCell*)0) {
      first = c;
    }
  }
  if (cells->len == 0) {
    return;
  }
  var saved_sets: StrList* = p->opts->sets;
  var saved_prof: string = p->opts->profile;
  var saved_rel: bool = p->opts->release;
  p->opts->profile = first->profile;
  p->opts->release = false;
  if (slen(first->board) > 0) {
    p->opts->sets = sl_copy(saved_sets);
    sl_push(p->opts->sets, "board=" + first->board);
  }
  var s: BxSess* = bx_sess(p, sl_of(first->target));
  g_bx_sess = s;
  s->tests = true;
  var us: BxUnits* = bx_bin_units(s, bs);
  g_bx_units = us;
  bx_prepare(s, us, s_empty());
  // the copy's graph misses its relative imports: always rebuilt
  i = 0;
  while (i < bs->n) {
    sys_remove_file(p->state_dir + "/stamps/test-bin-" + first->target + "-" + first->profile + "-" + bs->items[i].name + ".stamp");
    i = i + 1;
  }
  var built: StrList* = sl_new();
  defer free(built);
  bx_compile_units(s, us, built);
  i = 0;
  while (i < cells->len) {
    var c2: BtCell* = pl->cells[s_to_int(sl_get(cells, i))];
    var t2: BtTest* = pl->tests[c2->t];
    var u: BxUnit* = bt_unit_of(us, bs->items[i].name);
    i = i + 1;
    if (u == (BxUnit*)0 || u->job == (BxJob*)0 || !u->job->ok) {
      c2->pre = "natively: did not compile";
      continue;
    }
    var j: BxJob* = u->job;
    var run_at: string = j->outp;
    var cmd: Cmd* = bx_emu_cmd(s, j->b, j->t, &run_at);
    if (cmd == (Cmd*)0) {
      cmd = tc_run_program_cmd(j->t->target, j->outp);
    }
    if (cmd == (Cmd*)0) {
      c2->skip = "cannot run a " + j->t->target + " program on this " + sys_os() + " host";
      continue;
    }
    var env: StrList* = man_test_env(p->man, t2->name);
    var cwd_tmp: bool = s_eq(bt_get(p, t2->name, "cwd"), "tmp");
    var k: int64 = 1;
    while (k <= t2->repeat) {
      var r: TrnRun* = trn_run_new(c2->t, s_to_int(sl_get(cells, i - 1)), k);
      var rc: Cmd* = cmd_new(cmd->tool);
      cmd_args(rc, cmd->args);
      sl_extend(rc->env, cmd->env);
      r->cmd = rc;
      r->native = true;
      r->dir = bt_run_dir(p, c2, t2->name, k) + "-native";
      r->timeout_ms = bt_timeout_ms(p, t2->name, false);
      r->serial = s_eq(bt_get(p, t2->name, "serial"), "true");
      trn_prepare(r, p->root, t2->name, c2->spec, cwd_tmp, env);
      if (k == 1) {
        verbose(cmd_display(rc));
      }
      pl->runs = (TrnRun**)realloc(pl->runs, (pl->nr + 1) * 8);
      pl->runs[pl->nr] = r;
      pl->nr = pl->nr + 1;
      c2->runs = c2->runs + 1;
      t2->runs = t2->runs + 1;
      k = k + 1;
    }
    free(env);
  }
  p->opts->sets = saved_sets;
  p->opts->profile = saved_prof;
  p->opts->release = saved_rel;
}

// After the interpreter's runs: the native ones. trn_exec's code.
fn bt_native(pl: BtPlan*) -> int32 {
  var from: int64 = pl->nr;
  var specs: StrList* = sl_new();
  defer free(specs);
  var i: int64 = 0;
  while (i < pl->ncells) {
    if (pl->tests[pl->cells[i]->t]->kind == BT_FILE) {
      sl_add_uniq(specs, pl->cells[i]->spec);
    }
    i = i + 1;
  }
  i = 0;
  while (i < specs->len) {
    bt_native_spec(pl, sl_get(specs, i));
    i = i + 1;
  }
  i = 0;
  while (i < pl->nt) {
    if (!pl->tests[i]->keep_first) {
      pl->tests[i]->hold = false;
    }
    i = i + 1;
  }
  if (pl->nr == from) {
    return 0;
  }
  pl->native_from = from;
  pl->run_base = from;
  return trn_exec(&pl->runs[from], pl->nr - from, bx_parallel(pl->p), (rawptr)pl, &bt_ended);
}

// The first run of cell ci (not a native one), 0 when it did not run.
fn bt_first_run(pl: BtPlan*, ci: int64) -> TrnRun* {
  var i: int64 = 0;
  while (i < pl->nr) {
    var r: TrnRun* = pl->runs[i];
    if (r->cell == ci && r->k == 1 && !r->native) {
      return r;
    }
    i = i + 1;
  }
  return (TrnRun*)0;
}

// Whether every cell of t that ran passed.
fn bt_all_passed(pl: BtPlan*, t: BtTest*) -> bool {
  var k: int64 = 0;
  while (k < t->nc) {
    var c: BtCell* = pl->cells[t->c0 + k];
    if (slen(c->pre) > 0 || c->failed > 0) {
      return false;
    }
    k = k + 1;
  }
  return true;
}

// golden-cross: once every cell passed, each cell's outputs byte-identical
// to the first cell's.
fn bt_cross(pl: BtPlan*) {
  var i: int64 = 0;
  while (i < pl->nt) {
    var t: BtTest* = pl->tests[i];
    i = i + 1;
    if (!t->keep_first || t->nc < 2 || !s_eq(bt_get(pl->p, t->name, "golden-cross"), "true") || !bt_all_passed(pl, t)) {
      continue;
    }
    var base: TrnRun* = (TrnRun*)0;
    var base_spec: string = s_empty();
    var k: int64 = 0;
    while (k < t->nc) {
      var r: TrnRun* = bt_first_run(pl, t->c0 + k);
      var c: BtCell* = pl->cells[t->c0 + k];
      k = k + 1;
      if (r == (TrnRun*)0) {
        continue;
      }
      if (base == (TrnRun*)0) {
        base = r;
        base_spec = c->spec;
        continue;
      }
      var d: string = gld_cross(base->dir + "/out", base->out, r->dir + "/out", r->out, s_contains(t->golden, "stdout"));
      if (slen(d) > 0) {
        c->failed = c->failed + 1;
        c->first = r;
        c->why = "not as in " + base_spec + ": " + d;
      }
    }
  }
}

// --bless: each test that passed gets its first cell's outputs as goldens.
fn bt_bless(pl: BtPlan*) {
  if (!pl->bless) {
    return;
  }
  var i: int64 = 0;
  while (i < pl->nt) {
    var t: BtTest* = pl->tests[i];
    i = i + 1;
    if (s_eq(t->golden, "off") || !bt_all_passed(pl, t)) {
      continue;
    }
    var k: int64 = 0;
    while (k < t->nc) {
      var r: TrnRun* = bt_first_run(pl, t->c0 + k);
      k = k + 1;
      if (r != (TrnRun*)0) {
        gld_bless(t->gdir, t->gshown, r->dir + "/out", r->out, s_contains(t->golden, "stdout"), pl->only);
        break;
      }
    }
  }
}

// mbuild test [NAME | FILE]...: every test in every cell of its matrix,
// repeated, in parallel; a line per test, the failures, one result.
export fn build_cmd_test(p: Project*) -> int32 {
  var t0: int64 = sys_now_ms();
  bx_timeout_ms(p, false);
  var pl: BtPlan* = new BtPlan;
  memset((rawptr)pl, 0, (int64)sizeof(BtPlan));
  g_bt_plan = pl;
  pl->p = p;
  pl->keep = sl_has(p->opts->rest, "--keep");
  pl->bless = sl_has(p->opts->rest, "--bless");
  pl->only = bt_rest_value(p, "--only");
  if (slen(pl->only) > 0 && !pl->bless) {
    fail("--only goes with --bless: mbuild test NAME --bless --only S");
  }
  pl->filter = p->opts->filter;
  var mx: string = bt_rest_value(p, "--matrix");
  if (slen(mx) > 0) {
    var why: string = man_test_check("*", "matrix", mx);
    if (slen(why) > 0) {
      fail("--matrix=" + mx + ": " + why);
    }
  }
  var rep: string = bt_rest_value(p, "--repeat");
  if (slen(rep) > 0 && slen(man_test_check("*", "repeat", rep)) > 0) {
    fail("--repeat needs a count from 1 to 100000, not `" + rep + "`");
  }
  bt_select(pl);
  if (pl->nt == 0) {
    status("Finished", "no tests (no function is marked @test and there are no test programs)");
    return 0;
  }
  var dflt: StrList* = bx_mx_entries(p);
  defer free(dflt);
  pl->nocache = p->opts->force || pl->bless;
  g_bt_keys = sl_new();
  var i: int64 = 0;
  while (i < pl->nt) {
    var t: BtTest* = pl->tests[i];
    t->repeat = s_to_int(bt_get(p, t->name, "repeat"));
    t->native = bt_get(p, t->name, "native");
    t->hold = t->kind == BT_FILE && !s_eq(t->native, "never");
    t->golden = bt_get(p, t->name, "golden");
    t->gshown = bt_golden_dir(p, t->name);
    t->gdir = p_join(p->root, t->gshown);
    var cells: StrList* = bt_cells_of(p, t->name, dflt);
    t->c0 = pl->ncells;
    t->nc = cells->len;
    var k: int64 = 0;
    while (k < cells->len) {
      bt_add_cell(pl, i, sl_get(cells, k));
      k = k + 1;
    }
    free(cells);
    t->keep_first = !s_eq(t->golden, "off") && (pl->bless || (t->nc > 1 && s_eq(bt_get(p, t->name, "golden-cross"), "true")));
    if (t->keep_first) {
      t->hold = true;
    }
    if (t->kind == BT_PROG && !p->opts->force && !pl->bless && t->repeat == 1) {
      sl_push(g_bt_keys, t->name + "\t" + bt_settings_key(p, t->name));
    }
    i = i + 1;
  }
  // build, cell spec by cell spec, in the order they first appear
  var specs: StrList* = sl_new();
  defer free(specs);
  i = 0;
  while (i < pl->ncells) {
    sl_add_uniq(specs, pl->cells[i]->spec);
    i = i + 1;
  }
  pl->nspecs = specs->len;
  i = 0;
  while (i < specs->len) {
    bt_spec(pl, sl_get(specs, i));
    i = i + 1;
  }
  bt_runs(pl);
  var rc: int32 = trn_exec(pl->runs, pl->nr, bx_parallel(p), (rawptr)pl, &bt_ended);
  if (rc != 130) {
    rc = bt_native(pl);
  }
  svc_ports_release_all();
  if (rc != 130) {
    bt_cross(pl);
  }
  var u: int64 = 0;
  while (u < pl->nt) {
    pl->tests[u]->hold = false;
    u = u + 1;
  }
  bt_print_ready(pl);
  if (rc != 130) {
    bt_bless(pl);
  }
  if (rc == 130) {
    say("test result: " + red("INTERRUPTED"));
    return 130;
  }
  bt_stamp(pl);
  bt_failures(pl);
  var passed: int64 = 0;
  var cached: int64 = 0;
  var skipped: int64 = 0;
  var checks: int64 = 0;
  i = 0;
  while (i < pl->nt) {
    var t2: BtTest* = pl->tests[i];
    var ok: bool = true;
    var all_skip: bool = true;
    var all_cached: bool = true;
    var k2: int64 = 0;
    while (k2 < t2->nc) {
      var c: BtCell* = pl->cells[t2->c0 + k2];
      if (slen(c->skip) > 0) {
        skipped = skipped + 1;
      } else {
        all_skip = false;
        if (slen(c->pre) > 0 || c->failed > 0) {
          ok = false;
        }
        if (!c->cached) {
          all_cached = false;
        }
      }
      k2 = k2 + 1;
    }
    k2 = 0;
    while (k2 < t2->nc) {
      if (pl->cells[t2->c0 + k2]->checks > 0) {
        checks = checks + pl->cells[t2->c0 + k2]->checks;
        break;
      }
      k2 = k2 + 1;
    }
    if (ok && !all_skip) {
      passed = passed + 1;
      if (all_cached) {
        cached = cached + 1;
      }
    }
    i = i + 1;
  }
  var failed: int64 = 0;
  i = 0;
  while (i < pl->nt) {
    var t3: BtTest* = pl->tests[i];
    var k3: int64 = 0;
    var bad: bool = false;
    while (k3 < t3->nc) {
      var c3: BtCell* = pl->cells[t3->c0 + k3];
      if (slen(c3->skip) == 0 && (slen(c3->pre) > 0 || c3->failed > 0)) {
        bad = true;
      }
      k3 = k3 + 1;
    }
    if (bad) {
      failed = failed + 1;
    }
    i = i + 1;
  }
  var line: string = s_int(passed) + " passed, " + s_int(failed) + " failed";
  if (cached > 0) {
    line = line + ", " + s_int(cached) + " cached";
  }
  if (skipped > 0) {
    line = line + ", " + s_int(skipped) + " skipped";
  }
  if (pl->excluded > 0) {
    line = line + ", " + s_int(pl->excluded) + " excluded";
  }
  if (checks > 0) {
    line = line + ", " + bt_checks_text(checks);
  }
  line = line + " (" + trn_secs(sys_now_ms() - t0) + ")";
  if (bt_no_names(p)) {
    bt_clean_stale(p);
  }
  if (failed > 0) {
    say("");
    say("test result: " + red("FAILED") + ". " + line);
    return 1;
  }
  say("test result: " + green("ok") + ". " + line);
  return 0;
}

fn bt_no_names(p: Project*) -> bool {
  var l: StrList* = bx_positional(p->opts->rest);
  var none: bool = l->len == 0;
  free(l);
  return none;
}

export fn build_cmd_check(p: Project*) -> int32 {
  var lib: BinSet* = bx_lib_set(p);
  if (lib->n > 0) {
    return bx_check_set(p, bx_select_from(p, lib, bx_positional(p->opts->rest)));
  }
  return bx_check_set(p, bx_select_bins(p, bx_positional(p->opts->rest)));
}

// --target and the output of a compile only checked: an object, or for a
// board target the flat image it can only write.
fn bx_scratch_out(c: Cmd*, p: Project*, u: BxUnit*, out: string) {
  if (u->ti < 0 || target_is_riscv(u->target)) {
    cmd_arg(c, "--target");
    cmd_arg(c, u->target);
  }
  if (target_is_bare(u->target)) {
    cmd_arg(c, "--emit-flat");
  } else {
    cmd_arg(c, "-o");
  }
  cmd_path(c, bx_rel(p, out));
}

// The compiler's check of u's entry: an object at obj (to be deleted).
fn bx_check_cmd(s: BxSess*, u: BxUnit*, obj: string) -> Cmd* {
  var p: Project* = s->p;
  var c: Cmd* = tc_cmd(u->m);
  cmd_path(c, bx_rel(p, u->entry));
  bx_scratch_out(c, p, u, obj);
  bx_add_include(c, p, s->ds, bx_unit_gen(u));
  var st: Settings* = bx_add_flags(c, s, u);
  free(st);
  bx_diag_env(c);
  c->cwd = p->root;
  return c;
}

// Compiles each entry in bs to an object (deleted afterwards).
fn bx_check_set(p: Project*, bs: BinSet*) -> int32 {
  var t0: int64 = sys_now_ms();
  var s: BxSess* = bx_sess(p, build_targets(p));
  g_bx_sess = s;
  var us: BxUnits* = bx_bin_units(s, bs);
  g_bx_units = us;
  bx_prepare(s, us, s_empty());
  var bad: int32 = 0;
  var i: int64 = 0;
  while (i < us->n) {
    var u: BxUnit* = us->items[i];
    var b: BinInfo* = u->b;
    var obj: string = p->state_dir + "/tmp/check-" + s_replace_byte(b->name, 47, 95) + ".o";
    fs_mkdirs(p->state_dir + "/tmp");
    var c: Cmd* = bx_check_cmd(s, u, obj);
    defer free(c);
    status("Checking", b->name + " (" + u->target + ")");
    var cap: Captured = proc_capture_all(c);
    bx_print_block(bx_compiler_output(cap.out));
    sys_remove_file(obj);
    sys_remove_file(obj + ".o");
    sys_remove_file(obj + ".obj");
    if (cap.code != 0) {
      bx_explain_clash(s->ds, u->g, bx_strip_ansi(cap.out));
      error_msg("`" + b->name + "` (" + u->target + ") has errors");
      bad = 1;
    }
    i = i + 1;
  }
  if (bad == 0) {
    status("Finished", "in " + bx_secs(sys_now_ms() - t0));
  }
  return bad;
}

fn bx_remove(p: Project*, path: string) {
  if (fs_exists(path)) {
    if (!sys_remove_tree(path)) {
      error_msg("could not remove " + bx_show(path));
      return;
    }
    status("Removed", bx_rel(p, path));
  }
}

export fn build_cmd_clean(p: Project*) -> int32 {
  bx_remove(p, p->root + "/build");
  if (bx_has_arg(p->opts->rest, "--all")) {
    bx_remove(p, p->state_dir);
  } else {
    bx_remove(p, p->state_dir + "/cache");
    bx_remove(p, p->state_dir + "/stamps");
    bx_remove(p, p->state_dir + "/tmp");
    bx_remove(p, p->state_dir + "/dep-bins");
    bx_remove(p, p->state_dir + "/test-bins");
  }
  return 0;
}

// The value of a `--name=VALUE` command flag in rest (the last one), taken
// out of rest; "" when absent.
fn bx_take_opt(p: Project*, name: string) -> string {
  var v: string = s_empty();
  var l: StrList* = bx_take_opts(p, name);
  if (l->len > 0) {
    v = sl_get(l, l->len - 1);
  }
  free(l);
  return v;
}

// Every value of a repeatable `--name=VALUE` command flag, in order.
fn bx_take_opts(p: Project*, name: string) -> StrList* {
  var vals: StrList* = sl_new();
  var pre: string = name + "=";
  var i: int64 = 0;
  while (i < p->opts->rest->len) {
    var a: string = sl_get(p->opts->rest, i);
    if (s_starts(a, pre)) {
      sl_push(vals, s_from(a, slen(pre)));
      sl_remove_at(p->opts->rest, i);
    } else {
      i = i + 1;
    }
  }
  return vals;
}

// The skeleton of 13.10 in dir: mbuild.mettle, src/main.mettle (unless a
// main file exists) and the .gitignore lines.
fn bx_init_files(dir: string, name: string, dry: bool) {
  var verb: string = "Created";
  var upd: string = "Updated";
  if (dry) {
    verb = "Would create";
    upd = "Would update";
  }
  if (!dry && !fs_write(dir + "/mbuild.mettle", mbf_init_text(name))) {
    fail("cannot write " + dir + "/mbuild.mettle");
  }
  status(verb, "mbuild.mettle (package `" + name + "`)");
  if (fs_exists(dir + "/main.mettle") || fs_exists(dir + "/src/main.mettle")) {
    note("kept the existing main file");
  } else {
    var src: Buf* = buf_new();
    buf_line(src, "import \"std/io\";");
    buf_line(src, "");
    buf_line(src, "fn main() -> int32 {{");
    buf_line(src, "  print(\"Hello from " + name + "!\\n\");");
    buf_line(src, "  return 0;");
    buf_line(src, "}");
    var mtext: string = buf_take(src);
    if (!dry && !fs_write(dir + "/src/main.mettle", mtext)) {
      fail("cannot write src/main.mettle");
    }
    status(verb, "src/main.mettle");
  }
  var gi: string = dir + "/.gitignore";
  var cur: FsRead = fs_read(gi);
  var text: string = "";
  if (cur.ok) {
    text = cur.data;
  }
  var lines: StrList* = s_lines(text);
  defer free(lines);
  var add: Buf* = buf_new();
  if (slen(text) > 0 && !s_ends(text, "\n")) {
    buf_line(add, "");
  }
  var want: StrList* = s_split("/build/ /.mbuild/ /mettle.deps /mbuild.local.mettle", 32);
  defer free(want);
  var changed: bool = false;
  var i: int64 = 0;
  while (i < want->len) {
    var w: string = sl_get(want, i);
    var bare: string = s_from(w, 1);
    var nosl: string = w;
    if (s_ends(w, "/")) {
      nosl = s_sub(w, 0, slen(w) - 1);
    }
    if (!sl_has(lines, w) && !sl_has(lines, bare) && !sl_has(lines, nosl)) {
      buf_line(add, w);
      changed = true;
    }
    i = i + 1;
  }
  if (changed) {
    var gnew: string = text + buf_take(add);
    if (!dry) {
      fs_write(gi, gnew);
    }
    status(upd, ".gitignore");
  }
}

fn bx_check_pkg_name(name: string) {
  if (!man_is_package_name(name) || s_eq(name, "std") || s_eq(name, "mbuild")) {
    fail_hint("`" + name + "` is not a package name", "package names are lower case letters, digits and '_', starting with a letter (not std or mbuild)");
  }
}

// mbuild init [NAME] [--package] | init --from PKG[@V]: in the working directory.
export fn build_cmd_init(opts: Options*) -> int32 {
  var dir: string = p_clean(bx_cwd());
  var p0: Project* = new Project;
  p0->opts = opts;
  var from: string = bx_take_opt(p0, "--from");
  var ini_opts: StrList* = bx_take_opts(p0, "--opt");
  var registry: string = bx_take_opt(p0, "--registry");
  var package: bool = bx_take_flag(p0, "--package");
  var agent_rules: bool = bx_take_flag(p0, "--agent-rules");
  var yes: bool = bx_take_flag(p0, "--yes");
  var dry: bool = bx_take_flag(p0, "--dry-run");
  free(p0);
  var args: StrList* = bx_positional(opts->rest);
  defer free(args);
  var name: string = bx_pkg_name(p_base(dir));
  if (args->len > 0) {
    name = sl_get(args, 0);
  }
  bx_check_pkg_name(name);
  var have: bool = fs_exists(dir + "/mbuild.mettle");
  var legacy: bool = !have && fs_is_file(dir + "/mbuild.toml");
  if (slen(from) > 0) {
    if (legacy) {
      fail("mbuild.toml is no longer read; write mbuild.mettle (mbuild init)");
    }
    if (!have && !dry) {
      bx_init_files(dir, name, false);
    }
    var p: Project* = build_find(opts);
    bx_refuse_legacy(p);
    if (dry) {
      // evaluating mbuild.mettle compiles a driver: keep it out of the project
      var dk: string = hash_string(p->root);
      p->state_dir = fs_temp_dir() + "/init-dry-" + s_sub(dk, 0, 12);
    }
    if (slen(p->mbfile) > 0) {
      bx_load_manifest(p);
    }
    g_bx_proj = p;
    var r: IniRequest* = new IniRequest;
    g_bx_ini = r;
    r->from = from;
    r->name = s_empty();
    r->opts = ini_opts;
    r->registry = registry;
    r->existing = true;
    r->yes = yes;
    r->dry_run = dry;
    r->force = opts->force;
    return ini_run(p, r);
  }
  if (have) {
    fail_hint("mbuild.mettle already exists in " + dir, "this is already a project; edit mbuild.mettle instead");
  }
  bx_init_files(dir, name, dry);
  if (legacy) {
    note("mbuild.toml is no longer read and can be deleted");
  }
  if (dry) {
    if (fs_is_file(dir + "/mettle.deps")) {
      status("Would update", "mbuild.mettle (dependencies from mettle.deps)");
    }
    if (package) {
      return ini_scaffold_package(dir, name, agent_rules, true);
    }
    return 0;
  }
  if (fs_is_file(dir + "/mettle.deps")) {
    var pd: Project* = build_open(opts);
    g_bx_proj = pd;
    deps_adopt_mettle_deps(pd, true);
  }
  if (package) {
    var rc: int32 = ini_scaffold_package(dir, name, agent_rules, false);
    if (rc != 0) {
      return rc;
    }
  }
  if (!g_quiet) {
    say("");
    say("  next: " + bold("mbuild run"));
  }
  return 0;
}

// mbuild new NAME --from PKG[@V] [--opt K=V]... [--yes] [--dry-run] [--force]
export fn build_cmd_new(p: Project*) -> int32 {
  var from: string = bx_take_opt(p, "--from");
  var r: IniRequest* = new IniRequest;
  g_bx_ini = r;
  r->opts = bx_take_opts(p, "--opt");
  r->registry = bx_take_opt(p, "--registry");
  r->yes = bx_take_flag(p, "--yes");
  r->dry_run = bx_take_flag(p, "--dry-run");
  r->force = p->opts->force;
  r->existing = false;
  var args: StrList* = bx_positional(p->opts->rest);
  defer free(args);
  if (args->len != 1 || slen(from) == 0) {
    fail_hint("mbuild new takes a name and --from", "mbuild new NAME --from PKG[@VERSION]");
  }
  r->name = sl_get(args, 0);
  bx_check_pkg_name(r->name);
  r->from = from;
  return ini_run(p, r);
}

// The first bin (or library file) for the host target with its gen dir,
// for the compiler shortcuts (15.6). 0 when the project has none.
fn bx_tool_unit(p: Project*) -> BxUnit* {
  var bs: BinSet* = build_bins(p);
  if (bs->n == 0) {
    bs = bx_lib_set(p);
  }
  if (bs->n == 0) {
    return (BxUnit*)0;
  }
  var s: BxSess* = bx_sess(p, bx_targets_or_host(p));
  g_bx_sess = s;
  var us: BxUnits* = bx_units_new();
  g_bx_units = us;
  bx_unit_add(us, &bs->items[0], bs->items[0].entry, 0, sl_get(s->targets, 0), s->mettles[0]);
  bx_unit_cmp(s, us->items[0], s_empty());
  return us->items[0];
}

fn bx_one_mettle(p: Project*) -> Mettle* {
  var targets: StrList* = bx_targets_or_host(p);
  defer free(targets);
  return bx_mettle(p, sl_get(targets, 0));
}

// mbuild mettle [-t T] -- ARGS, with the gen dir of the first bin.
export fn build_cmd_mettle(p: Project*) -> int32 {
  var u: BxUnit* = (BxUnit*)0;
  if (p->has_manifest) {
    u = bx_tool_unit(p);
  }
  var m: Mettle* = (Mettle*)0;
  var c: Cmd* = (Cmd*)0;
  if (u != (BxUnit*)0) {
    m = u->m;
    c = tc_cmd(m);
    var gen: string = bx_unit_gen(u);
    if (slen(gen) > 0) {
      cmd_arg(c, "-I");
      cmd_path(c, bx_rel(p, gen));
    }
  } else {
    m = bx_one_mettle(p);
    c = tc_cmd(m);
  }
  defer free(c);
  cmd_args(c, p->opts->rest);
  cmd_args(c, p->opts->passthrough);
  c->cwd = p->root;
  return proc_run(c);
}

// mbuild trace FN [args] / mbuild why A B: on the first bin's main file.
export fn build_cmd_trace(p: Project*, sub: string) -> int32 {
  if (p->opts->rest->len == 0) {
    if (s_eq(sub, "why")) {
      fail_hint("`mbuild why` needs two names", "mbuild why A B");
    }
    fail_hint("`mbuild trace` needs a function name", "mbuild trace FN [args...]");
  }
  var u: BxUnit* = bx_tool_unit(p);
  if (u == (BxUnit*)0) {
    bx_no_bins(p);
  }
  var c: Cmd* = tc_cmd(u->m);
  defer free(c);
  cmd_arg(c, sub);
  cmd_path(c, bx_rel(p, u->file));
  cmd_args(c, p->opts->rest);
  cmd_args(c, p->opts->passthrough);
  bx_add_include(c, p, g_bx_sess->ds, bx_unit_gen(u));
  c->cwd = p->root;
  return proc_run(c);
}

export fn build_cmd_explain(p: Project*) -> int32 {
  if (p->opts->rest->len == 0) {
    fail_hint("`mbuild explain` needs a code", "mbuild explain E0003 (or `mbuild explain list`)");
  }
  var m: Mettle* = bx_one_mettle(p);
  var c: Cmd* = tc_cmd(m);
  defer free(c);
  cmd_arg(c, "explain");
  cmd_args(c, p->opts->rest);
  return proc_run(c);
}

fn bx_doctor_tool(label: string, name: string, env_override: string) -> bool {
  var t: Tool = proc_tool(name, env_override);
  if (tool_found(t)) {
    var kind: string = "";
    if (t.unix) {
      kind = " (host program)";
    }
    var i: int64 = 0;
    while (g_bx_tools != (StrList*)0 && slen(env_override) > 0 && i < g_bx_tools->len) {
      if (s_starts(sl_get(g_bx_tools, i), env_override + "=")) {
        kind = kind + " ([tools], " + s_from(sl_get(g_bx_tools, i), slen(env_override) + 1) + ")";
      }
      i = i + 1;
    }
    say("  " + s_pad_right(label, 12) + green("found") + "  " + t.path + kind);
    return true;
  }
  say("  " + s_pad_right(label, 12) + yellow("missing"));
  return false;
}

export fn build_cmd_doctor(p: Project*) -> int32 {
  var rc: int32 = 0;
  var host: string = sys_os();
  if (sys_is_wine()) {
    host = host + " (under wine)";
  }
  say(bold("mbuild") + " " + build_version_text);
  say("  host      " + host);
  if (p->has_manifest) {
    say("  project   " + p->man->name + " (" + bx_show(p->root) + ")");
  } else {
    say("  project   none (zero-config in " + bx_show(p->root) + ")");
  }
  say("  home      " + fs_mbuild_home());
  say(bold("tools"));
  bx_doctor_tool("curl", "curl", "MBUILD_CURL");
  bx_doctor_tool("tar", "tar", "");
  if (s_eq(sys_os(), "linux")) {
    bx_doctor_tool("cc", "cc", "CC");
  }
  if (!bx_doctor_tool("cc windows", "x86_64-w64-mingw32-gcc", "CC_WINDOWS") && s_eq(sys_os(), "windows")) {
    bx_doctor_tool("cc windows", "gcc", "");
  }
  bx_doctor_tool("pkg-config", "pkg-config", "PKG_CONFIG");
  if (s_eq(sys_os(), "linux")) {
    bx_doctor_tool("wine", "wine", "MBUILD_WINE");
  }
  var targets: StrList* = build_targets(p);
  defer free(targets);
  say(bold("compilers"));
  var mettles: Mettle** = (Mettle**)malloc((targets->len + 1) * 8);
  defer free(mettles);
  var i: int64 = 0;
  while (i < targets->len) {
    var target: string = sl_get(targets, i);
    var m: Mettle* = bx_mettle(p, target);
    mettles[i] = m;
    var ver: string = tc_version(m);
    if (slen(ver) == 0) {
      ver = "version unknown";
    }
    var how: string = "";
    if (m->via_wine) {
      how = ", via wine";
    }
    say("  " + s_pad_right(target, 10) + m->path + " (" + ver + how + "; " + m->source + ")");
    if (slen(m->stdlib_dir) > 0) {
      say("  " + s_pad_right("", 10) + "stdlib " + m->stdlib_dir);
    }
    i = i + 1;
  }
  var ds: DepState* = bx_deps(p);
  say(bold("native"));
  var prof: string = build_profile(p);
  i = 0;
  while (i < targets->len) {
    var t: TargetCtx* = targetctx_new(p, sl_get(targets, i), prof);
    g_bx_t = t;
    t->compiler_stdlib_dir = mettles[i]->stdlib_dir;
    t->compiler_runtime_dir = mettles[i]->runtime_dir;
    if (nat_doctor(p, ds, t) != 0) {
      rc = 1;
    }
    i = i + 1;
  }
  return rc;
}

// The package one import of a root-owned file counts for, "" when it names
// none: "NAME/FILE" of a selected package -> NAME; a file inside a local
// path package -> its name; an unselected "NAME/FILE" that is no component
// and no directory next to the file -> NAME (14.5).
fn bx_used_key(ds: DepState*, comps: StrList*, pdirs: StrList*, ctxs: GraphCtx**, file: string, imp: string) -> string {
  var at: int64 = bx_dep_of_import(ds, imp);
  if (at >= 0) {
    return ds->mods[at].module;
  }
  var i: int64 = 0;
  var oi: int64 = 0;
  while (oi < 2) {
    var res: string = graph_resolve(ctxs[oi], file, imp);
    if (slen(res) > 0) {
      i = 0;
      while (i < ds->n) {
        if (ds->mods[i].is_path && slen(sl_get(pdirs, i)) > 0 && p_has_prefix_dir(res, sl_get(pdirs, i))) {
          return ds->mods[i].module;
        }
        i = i + 1;
      }
      return s_empty();
    }
    oi = oi + 1;
  }
  var first: string = bx_first_component(imp);
  if (slen(first) < slen(imp) && man_is_package_name(first) && !s_eq(first, "std") && !s_eq(first, "mbuild") && !sl_has(comps, first) && !fs_is_dir(p_join(p_dir(file), first))) {
    return first;
  }
  return s_empty();
}

// Modules the project's own files import directly (for `mbuild tidy`).
// Root-owned files are those bx_owned_files lists: dependencies, build
// outputs, nested projects and path packages do not count, so a module only
// a dependency imports is not "used" by the root.
export fn build_used_modules(p: Project*, ds: DepState*) -> StrList* {
  var used: StrList* = sl_new();
  var comps: StrList* = bx_comp_names(p, ds);
  var pdirs: StrList* = sl_new();
  var i: int64 = 0;
  while (i < ds->n) {
    var canon: string = "";
    if (ds->mods[i].is_path) {
      canon = bx_slash(sys_realpath(ds->mods[i].dir));
      if (slen(canon) == 0) {
        canon = ds->mods[i].dir;
      }
    }
    sl_push(pdirs, canon);
    i = i + 1;
  }
  var ctxs: GraphCtx** = (GraphCtx**)malloc(16);
  ctxs[0] = graph_ctx_new("linux", s_empty());
  ctxs[1] = graph_ctx_new("windows", s_empty());
  var ci: int64 = 0;
  while (ci < 2) {
    sl_push(ctxs[ci]->includes, ds->include_dir);
    ctxs[ci]->cwd = p->root;
    ci = ci + 1;
  }
  var files: StrList* = bx_owned_files(p);
  var fi: int64 = 0;
  while (fi < files->len) {
    var file: string = bx_slash(p->root + "/" + sl_get(files, fi));
    var canon_file: string = bx_slash(sys_realpath(file));
    if (slen(canon_file) == 0) {
      canon_file = file;
    }
    var rd: FsRead = fs_read(file);
    if (rd.ok) {
      var sr: ScanResult* = scan_source(rd.data);
      var k: int64 = 0;
      while (k < sr->nimports) {
        var key: string = bx_used_key(ds, comps, pdirs, ctxs, canon_file, scan_import(sr, k)->path);
        if (slen(key) > 0) {
          sl_add_uniq(used, key);
        }
        k = k + 1;
      }
      free(sr);
    }
    fi = fi + 1;
  }
  free(files);
  free(ctxs[0]);
  free(ctxs[1]);
  free(ctxs);
  free(pdirs);
  free(comps);
  sl_sort(used);
  return used;
}

// ---------------------------------------------------------------------------
// Owners of files, compiler diagnostics, name clashes
// ---------------------------------------------------------------------------

// The selected module whose directory holds file (longest match), -1.
fn bx_dep_of_file(ds: DepState*, file: string) -> int64 {
  var best: int64 = -1;
  var best_len: int64 = -1;
  var i: int64 = 0;
  while (i < ds->n) {
    var dm: DepModule* = &ds->mods[i];
    var d1: string = dm->dir;
    if (slen(d1) > best_len && slen(d1) > 0 && p_has_prefix_dir(file, d1)) {
      best = i;
      best_len = slen(d1);
    }
    if (!dm->is_path) {
      var d2: string = ds->include_dir + "/" + dm->module;
      if (slen(d2) > best_len && p_has_prefix_dir(file, d2)) {
        best = i;
        best_len = slen(d2);
      }
    }
    i = i + 1;
  }
  return best;
}

// file relative to the package that owns it (the project root for its own).
fn bx_owner_rel(ds: DepState*, file: string) -> string {
  var at: int64 = bx_dep_of_file(ds, file);
  var root: string = p_dir(p_dir(ds->include_dir));
  if (at < 0) {
    if (p_has_prefix_dir(file, root)) {
      return p_rel(root, file);
    }
    return file;
  }
  var dm: DepModule* = &ds->mods[at];
  if (slen(dm->dir) > 0 && p_has_prefix_dir(file, dm->dir)) {
    return p_rel(dm->dir, file);
  }
  return p_rel(ds->include_dir + "/" + dm->module, file);
}

export fn build_owner_of(ds: DepState*, file: string) -> string {
  var f: string = bx_slash(file);
  var at: int64 = bx_dep_of_file(ds, f);
  if (at >= 0) {
    var dm: DepModule* = &ds->mods[at];
    if (dm->is_path) {
      return "path package " + dm->module;
    }
    if (slen(dm->version) == 0) {
      return dm->module;
    }
    return dm->module + " " + dm->version;
  }
  var root: string = p_dir(p_dir(ds->include_dir));
  if (p_has_prefix_dir(f, root) && !p_has_prefix_dir(f, root + "/.mbuild")) {
    return "this project";
  }
  if (g_bx_sess != (BxSess*)0) {
    var i: int64 = 0;
    while (i < g_bx_sess->targets->len) {
      var sdir: string = g_bx_sess->mettles[i]->stdlib_dir;
      if (slen(sdir) > 0 && p_has_prefix_dir(f, bx_slash(sdir))) {
        return "the standard library";
      }
      i = i + 1;
    }
  }
  return s_empty();
}

// A JSON string or number field of one diagnostic line ("" when absent).
fn bx_json_field(line: string, key: string) -> string {
  var pat: string = "\"" + key + "\":";
  var at: int64 = s_find(line, pat);
  if (at < 0) {
    return s_empty();
  }
  var n: int64 = slen(line);
  var i: int64 = at + slen(pat);
  while (i < n && s_byte(line, i) == 32) {
    i = i + 1;
  }
  if (i >= n) {
    return s_empty();
  }
  if (s_byte(line, i) != 34) {
    var j: int64 = i;
    while (j < n && s_byte(line, j) != 44 && s_byte(line, j) != 125) {
      j = j + 1;
    }
    return s_trim(s_sub(line, i, j));
  }
  var b: Buf* = buf_new();
  i = i + 1;
  while (i < n) {
    var c: int32 = s_byte(line, i);
    if (c == 92 && i + 1 < n) {
      var e: int32 = s_byte(line, i + 1);
      if (e == 110) {
        buf_addb(b, 10);
      } else if (e == 116) {
        buf_addb(b, 9);
      } else {
        buf_addb(b, e);
      }
      i = i + 2;
    } else if (c == 34) {
      break;
    } else {
      buf_addb(b, c);
      i = i + 1;
    }
  }
  return buf_take(b);
}

// The first `most` errors of --error-format=json output, as
// "file:line: message (code)", the file prefixed by its owner when it is
// not this project's.
fn bx_diag_lines(p: Project*, ds: DepState*, text: string, most: int64) -> StrList* {
  var res: StrList* = sl_new();
  var lines: StrList* = s_lines(text);
  var i: int64 = 0;
  while (i < lines->len && res->len < most) {
    var line: string = s_trim(sl_get(lines, i));
    i = i + 1;
    if (!s_starts(line, "{{") || !s_eq(bx_json_field(line, "severity"), "error")) {
      continue;
    }
    var file: string = bx_slash(bx_json_field(line, "file"));
    var shown: string = file;
    if (slen(file) > 0) {
      var abs: string = file;
      if (!p_is_abs(file)) {
        abs = p_clean(p_join(p->root, file));
      }
      var owner: string = build_owner_of(ds, abs);
      shown = bx_owner_rel(ds, abs);
      if (slen(owner) > 0 && !s_eq(owner, "this project")) {
        shown = owner + ": " + shown;
      }
    }
    var msg: string = shown + ":" + bx_json_field(line, "line") + ": " + bx_json_field(line, "message");
    var code: string = bx_json_field(line, "code");
    if (slen(code) > 0) {
      msg = msg + " (" + code + ")";
    }
    sl_push(res, msg);
  }
  free(lines);
  return res;
}

// The name of a duplicate declaration the compiler reported, "".
fn bx_clash_name(text: string) -> string {
  var lines: StrList* = s_lines(text);
  var found: string = "";
  var i: int64 = 0;
  while (i < lines->len && slen(found) == 0) {
    var line: string = sl_get(lines, i);
    i = i + 1;
    if (!s_contains(line, "Duplicate declaration") && !s_contains(line, "does not match existing declaration")) {
      continue;
    }
    var q1: int64 = s_find_byte(line, 39);
    if (q1 < 0) {
      continue;
    }
    var rest: string = s_from(line, q1 + 1);
    var q2: int64 = s_find_byte(rest, 39);
    if (q2 > 0) {
      found = s_dup(s_sub(rest, 0, q2));
    }
  }
  free(lines);
  return found;
}

// "github.com/x/y v1.0.0" -> "github.com/x/y"; "path package k" -> "k".
fn bx_owner_label(owner: string) -> string {
  if (s_starts(owner, "path package ")) {
    return s_from(owner, 13);
  }
  if (s_starts(owner, "this project") || s_starts(owner, "the standard library")) {
    return owner;
  }
  var sp: int64 = s_find_byte(owner, 32);
  if (sp > 0) {
    return s_sub(owner, 0, sp);
  }
  return owner;
}

// After a failed compile: a name two packages export explains a duplicate
// declaration (plain imports share one namespace).
fn bx_explain_clash(ds: DepState*, g: Graph*, text: string) {
  if (g == (Graph*)0) {
    return;
  }
  var name: string = bx_clash_name(text);
  if (slen(name) == 0) {
    return;
  }
  var files: StrList* = sl_new();
  var lines: StrList* = sl_new();
  var owners: StrList* = sl_new();
  var i: int64 = 0;
  while (i < g->files->len) {
    var f: string = sl_get(g->files, i);
    i = i + 1;
    var rd: FsRead = fs_read(f);
    if (!rd.ok) {
      continue;
    }
    var el: ExportList* = scan_exports(rd.data);
    var k: int64 = 0;
    while (k < el->n) {
      var it: ExportItem* = scan_export(el, k);
      if (s_eq(it->name, name)) {
        sl_push(files, f);
        sl_push(lines, s_int(it->line));
        sl_push(owners, build_owner_of(ds, f));
        break;
      }
      k = k + 1;
    }
    free(el);
  }
  var a: int64 = 0;
  i = 0;
  while (i < files->len) {
    if (s_contains(text, sl_get(files, i))) {
      a = i;
      break;
    }
    i = i + 1;
  }
  var b: int64 = -1;
  i = 0;
  while (i < files->len && b < 0) {
    if (!s_eq(sl_get(owners, i), sl_get(owners, a))) {
      b = i;
    }
    i = i + 1;
  }
  if (b >= 0) {
    var la: string = bx_owner_label(sl_get(owners, a));
    var lb: string = bx_owner_label(sl_get(owners, b));
    var ra: string = bx_owner_rel(ds, sl_get(files, a));
    var rb: string = bx_owner_rel(ds, sl_get(files, b));
    err_line("  " + cyan("note") + ": `" + name + "` is exported by both " + la + " (" + ra + ":" + sl_get(lines, a) + ") and " + lb + " (" + rb + ":" + sl_get(lines, b) + "); plain imports share one namespace");
    var lo: string = lb;
    var ro: string = rb;
    if (s_eq(lb, "this project") || s_eq(lb, "the standard library")) {
      lo = la;
      ro = ra;
    }
    var stem: string = ro;
    if (s_ends(stem, ".mettle")) {
      stem = s_sub(stem, 0, slen(stem) - 7);
    }
    var imp: string = stem;
    if (!s_eq(lo, "this project") && !s_eq(lo, "the standard library")) {
      imp = lo + "/" + stem;
    }
    err_line("  " + cyan("help") + ": import one of them under a name: import \"" + imp + "\" as " + p_base(stem) + ";");
  }
  free(files);
  free(lines);
  free(owners);
}

// ---------------------------------------------------------------------------
// Verification (12.13)
// ---------------------------------------------------------------------------

struct BxVerify {
  ok: bool;
  errors: StrList*;
}

fn bx_first_error(v: BxVerify*) -> string {
  if (v->errors->len > 0) {
    return sl_get(v->errors, 0);
  }
  return "does not build";
}

// Type-checks every bin (or library file) for every target with the
// current dependencies; with_test also runs `mbuild test`.
fn bx_verify(p: Project*, with_test: bool) -> BxVerify* {
  var v: BxVerify* = new BxVerify;
  v->ok = true;
  v->errors = sl_new();
  var lib: bool = false;
  var bs: BinSet* = bx_lib_set(p);
  if (bs->n > 0) {
    lib = true;
  } else {
    bs = build_bins(p);
  }
  if (bs->n == 0) {
    verbose("nothing to verify: this project has no bins and no library files");
    return v;
  }
  var targets: StrList* = build_targets(p);
  var quiet: bool = g_quiet;
  g_quiet = true;
  var s: BxSess* = bx_sess_x(p, targets, false);
  g_quiet = quiet;
  g_bx_sess = s;
  if (!g_bx_verify_said) {
    g_bx_verify_said = true;
    var what: string = "{bs->n} bins";
    if (lib) {
      what = "{bs->n} files";
      if (bs->n == 1) {
        what = "1 file";
      }
    } else if (bs->n == 1) {
      what = "1 bin";
    }
    status("Verifying", what + " for " + sl_join(targets, ", "));
  }
  var ti: int64 = 0;
  while (ti < targets->len) {
    var e: string = deps_mettle_check(p, s->ds, s->mettles[ti]);
    if (slen(e) > 0) {
      v->ok = false;
      var nl: int64 = s_find_byte(e, 10);
      if (nl > 0) {
        e = s_sub(e, 0, nl);
      }
      sl_add_uniq(v->errors, e);
    }
    ti = ti + 1;
  }
  if (!v->ok) {
    return v;
  }
  var us: BxUnits* = bx_bin_units(s, bs);
  g_bx_units = us;
  bx_components(s, us, s_empty());
  bx_pre_hooks(s, us);
  var n: int64 = us->n;
  var cmds: Cmd** = (Cmd**)malloc((n + 1) * 8);
  var logs: StrList* = sl_new();
  var objs: StrList* = sl_new();
  var tmp: string = p->state_dir + "/tmp";
  fs_mkdirs(tmp);
  var k: int64 = 0;
  while (k < n) {
    var u: BxUnit* = us->items[k];
    var stem: string = tmp + "/verify-" + u->target + "-" + s_replace_byte(u->b->name, 47, 95);
    var c: Cmd* = tc_cmd(u->m);
    cmd_path(c, bx_rel(p, u->entry));
    var vobj: string = stem + ".o";
    bx_scratch_out(c, p, u, vobj);
    bx_add_include(c, p, s->ds, bx_unit_gen(u));
    var st: Settings* = bx_add_flags(c, s, u);
    free(st);
    cmd_arg(c, "--error-format=json");
    cmd_env(c, "NO_COLOR", "1");
    c->cwd = p->root;
    cmds[k] = c;
    sl_push(logs, stem + ".log");
    sl_push(objs, stem + ".o");
    k = k + 1;
  }
  var codes: int32* = proc_run_jobs(cmds, n, logs, bx_parallel(p));
  k = 0;
  while (k < n) {
    var rd: FsRead = fs_read(sl_get(logs, k));
    var text: string = "";
    if (rd.ok) {
      text = rd.data;
    }
    sys_remove_file(sl_get(logs, k));
    var obj: string = sl_get(objs, k);
    sys_remove_file(obj);
    sys_remove_file(obj + ".o");
    sys_remove_file(obj + ".obj");
    if (codes[k] != 0) {
      v->ok = false;
      var errs: StrList* = bx_diag_lines(p, s->ds, text, 3);
      if (errs->len == 0) {
        var u2: BxUnit* = us->items[k];
        sl_push(errs, "could not compile " + u2->b->name + " (" + u2->target + "): " + s_trim(text));
      }
      sl_extend_uniq(v->errors, errs);
      free(errs);
    }
    free(cmds[k]);
    k = k + 1;
  }
  free(codes);
  free(cmds);
  free(logs);
  free(objs);
  if (v->ok && with_test) {
    var rest: StrList* = p->opts->rest;
    p->opts->rest = sl_new();
    var filter: string = p->opts->filter;
    p->opts->filter = s_empty();
    var rc: int32 = build_cmd_test(p);
    free(p->opts->rest);
    p->opts->rest = rest;
    p->opts->filter = filter;
    if (rc != 0) {
      v->ok = false;
      sl_push(v->errors, "the tests fail (mbuild test)");
    }
  }
  return v;
}

fn bx_say_verified() {
  if (!g_quiet) {
    say(green(s_pad_left("Verified", 12)));
    flush_out();
  }
}

fn bx_free_verify(v: BxVerify*) {
  free(v->errors);
  free(v);
}

// Takes every `name` out of the positional arguments; true when present.
fn bx_take_flag(p: Project*, name: string) -> bool {
  var found: bool = false;
  var at: int64 = sl_index(p->opts->rest, name);
  while (at >= 0) {
    sl_remove_at(p->opts->rest, at);
    found = true;
    at = sl_index(p->opts->rest, name);
  }
  return found;
}

// "name version" for each package in mbuild.lock.
fn bx_lock_map(p: Project*) -> StrList* {
  var l: StrList* = sl_new();
  var r: FsRead = fs_read(p->root + "/mbuild.lock");
  if (!r.ok) {
    return l;
  }
  var lines: StrList* = s_lines(r.data);
  var i: int64 = 0;
  while (i < lines->len) {
    var line: string = sl_get(lines, i);
    i = i + 1;
    if (s_starts(line, "#")) {
      continue;
    }
    var f: StrList* = s_fields(line);
    if (f->len >= 2 && man_is_package_name(sl_get(f, 0))) {
      sl_push(l, sl_get(f, 0) + " " + sl_get(f, 1));
    }
    free(f);
  }
  free(lines);
  return l;
}

fn bx_lock_ver(l: StrList*, module: string) -> string {
  var pre: string = module + " ";
  var i: int64 = 0;
  while (i < l->len) {
    if (s_starts(sl_get(l, i), pre)) {
      return s_from(sl_get(l, i), slen(pre));
    }
    i = i + 1;
  }
  return s_empty();
}

// True when mbuild.mettle, mbuild.lock or the local lock differ from the snapshot.
fn bx_snap_changed(s: DepSnap*) -> bool {
  var i: int64 = 0;
  while (i < s->files->len) {
    var r: FsRead = fs_read(sl_get(s->files, i));
    var was: bool = s_eq(sl_get(s->present, i), "1");
    if (r.ok != was || (r.ok && !s_eq(r.data, sl_get(s->texts, i)))) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

fn bx_restore(p: Project*, snap: DepSnap*) {
  deps_restore(p, snap);
  bx_reload(p);
}

fn bx_say_restored() {
  err_line("  Restored mbuild.mettle and mbuild.lock");
}

fn bx_print_errors(v: BxVerify*) {
  var i: int64 = 0;
  while (i < v->errors->len) {
    err_line("    " + sl_get(v->errors, i));
    i = i + 1;
  }
}

// The API changes of module between two versions, "" when none or unknown.
fn bx_api(p: Project*, module: string, from: string, to: string, added: bool) -> string {
  if (!sv_is(from) || !sv_is(to) || s_eq(from, to)) {
    return s_empty();
  }
  var q: ApiQuery* = new ApiQuery;
  q->module = module;
  q->from_version = from;
  q->to_version = to;
  q->files = (StrList*)0;
  q->with_added = added;
  var rep: string = deps_api_report(p, q);
  free(q);
  return rep;
}

fn bx_print_api(text: string) {
  if (slen(text) == 0) {
    return;
  }
  print_err(text);
  if (!s_ends(text, "\n")) {
    print_err("\n");
  }
}

fn bx_help(text: string) {
  err_line("  " + cyan("help") + ": " + text);
  flush_out();
}

// The package names of get's arguments (NAME[@VERSION]).
fn bx_get_modules(p: Project*) -> StrList* {
  var names: StrList* = sl_new();
  var i: int64 = 0;
  while (i < p->opts->rest->len) {
    var arg: string = sl_get(p->opts->rest, i);
    i = i + 1;
    var at: int64 = s_find_byte(arg, 64);
    var name: string = arg;
    if (at > 0) {
      name = s_sub(arg, 0, at);
    }
    sl_push(names, name);
  }
  return names;
}

export fn build_cmd_get(p: Project*) -> int32 {
  var no_verify: bool = bx_take_flag(p, "--no-verify");
  var with_test: bool = bx_take_flag(p, "--test");
  var names: StrList* = bx_get_modules(p);
  var args: string = sl_join(p->opts->rest, " ");
  var before: StrList* = bx_lock_map(p);
  var snap: DepSnap* = deps_snapshot(p);
  g_bx_snap = snap;
  var rc: int32 = deps_cmd_get(p);
  if (rc != 0 || no_verify || !bx_snap_changed(snap)) {
    return rc;
  }
  bx_reload(p);
  var v: BxVerify* = bx_verify(p, with_test);
  if (v->ok) {
    bx_say_verified();
    bx_free_verify(v);
    return 0;
  }
  var after: StrList* = bx_lock_map(p);
  var heads: StrList* = sl_new();
  var i: int64 = 0;
  while (i < names->len) {
    var nv: string = bx_lock_ver(after, sl_get(names, i));
    if (slen(nv) > 0) {
      sl_push(heads, sl_get(names, i) + " " + nv);
    } else {
      sl_push(heads, sl_get(names, i));
    }
    i = i + 1;
  }
  var verb: string = " breaks";
  if (heads->len > 1) {
    verb = " break";
  }
  error_msg(sl_join(heads, ", ") + verb + " this project:");
  bx_print_errors(v);
  i = 0;
  while (i < names->len) {
    var module: string = sl_get(names, i);
    bx_print_api(bx_api(p, module, bx_lock_ver(before, module), bx_lock_ver(after, module), false));
    i = i + 1;
  }
  bx_restore(p, snap);
  bx_say_restored();
  if (names->len == 1) {
    var m1: string = sl_get(names, 0);
    var ov: string = bx_lock_ver(before, m1);
    var nv1: string = bx_lock_ver(after, m1);
    var take: string = "take it and fix the code: `mbuild get " + m1 + "@" + nv1 + " --no-verify`";
    if (slen(ov) > 0 && !s_eq(ov, nv1)) {
      bx_help("stay on " + ov + " (`mbuild get " + m1 + "@" + ov + "`), or " + take);
    } else {
      bx_help(take);
    }
  } else {
    bx_help("take them and fix the code: `mbuild get " + args + " --no-verify`");
  }
  bx_free_verify(v);
  free(names);
  free(heads);
  free(before);
  free(after);
  return 1;
}

// remove and tidy: verify the result, roll back when it breaks the project.
fn bx_verify_or_restore(p: Project*, snap: DepSnap*, with_test: bool, what: string, again: string) -> int32 {
  if (!bx_snap_changed(snap)) {
    return 0;
  }
  bx_reload(p);
  var v: BxVerify* = bx_verify(p, with_test);
  if (v->ok) {
    bx_say_verified();
    bx_free_verify(v);
    return 0;
  }
  error_msg(what + " breaks this project:");
  bx_print_errors(v);
  bx_restore(p, snap);
  bx_say_restored();
  bx_help("fix the code first, or run it anyway and fix the code afterwards: `" + again + " --no-verify`");
  bx_free_verify(v);
  return 1;
}

export fn build_cmd_remove(p: Project*) -> int32 {
  var no_verify: bool = bx_take_flag(p, "--no-verify");
  var with_test: bool = bx_take_flag(p, "--test");
  var args: string = sl_join(p->opts->rest, " ");
  var snap: DepSnap* = deps_snapshot(p);
  g_bx_snap = snap;
  var rc: int32 = deps_cmd_remove(p);
  if (rc != 0 || no_verify) {
    return rc;
  }
  return bx_verify_or_restore(p, snap, with_test, "removing " + args, "mbuild remove " + args);
}

export fn build_cmd_tidy(p: Project*) -> int32 {
  var no_verify: bool = bx_take_flag(p, "--no-verify");
  var with_test: bool = bx_take_flag(p, "--test");
  var snap: DepSnap* = deps_snapshot(p);
  g_bx_snap = snap;
  var ds: DepState* = bx_deps(p);
  var rc: int32 = deps_cmd_tidy(p, build_used_modules(p, ds));
  if (rc != 0 || no_verify) {
    return rc;
  }
  return bx_verify_or_restore(p, snap, with_test, "mbuild tidy", "mbuild tidy");
}

// ---------------------------------------------------------------------------
// mbuild update (12.13)
// ---------------------------------------------------------------------------

fn bx_say_newer(plan: UpdatePlan*) {
  var k: int64 = 0;
  while (k < plan->lines_mods->len) {
    var m: string = sl_get(plan->lines_mods, k);
    var v: string = sl_get(plan->lines_vers, k);
    status("Newer", m + " " + v + " is a new compatibility line (" + sv_line(v) + "): `mbuild update --major " + m + "`");
    k = k + 1;
  }
}

// A trial: its edit is undone, so it prints nothing (the kept one prints once).
fn bx_apply_one(p: Project*, module: string, version: string) {
  var mods: StrList* = sl_of(module);
  var vers: StrList* = sl_of(version);
  var quiet_was: bool = g_quiet;
  g_quiet = true;
  g_bx_ds = deps_apply(p, mods, vers);
  g_quiet = quiet_was;
  free(mods);
  free(vers);
  bx_reload(p);
}

// The versions an update of plan entry i tries, newest first.
fn bx_cands(plan: UpdatePlan*, i: int64) -> StrList* {
  var c: string = sl_get(plan->cands, i);
  if (slen(s_trim(c)) == 0) {
    return sl_of(sl_get(plan->tos, i));
  }
  return s_fields(c);
}

export fn build_cmd_update(p: Project*) -> int32 {
  var req: UpdateReq* = new UpdateReq;
  g_bx_req = req;
  req->modules = sl_new();
  req->all = false;
  req->major = false;
  var dry: bool = false;
  var no_verify: bool = false;
  var with_test: bool = false;
  var ai: int64 = 0;
  while (ai < p->opts->rest->len) {
    var arg: string = sl_get(p->opts->rest, ai);
    ai = ai + 1;
    if (s_eq(arg, "--all")) {
      req->all = true;
    } else if (s_eq(arg, "--major")) {
      req->major = true;
    } else if (s_eq(arg, "--dry-run")) {
      dry = true;
    } else if (s_eq(arg, "--no-verify")) {
      no_verify = true;
    } else if (s_eq(arg, "--test")) {
      with_test = true;
    } else {
      sl_push(req->modules, arg);
    }
  }
  if (req->all && req->modules->len > 0) {
    error_msg("mbuild update --all takes no module names");
    return 2;
  }
  if (p->opts->locked) {
    fail_hint("mbuild update would change mbuild.mettle, and --locked forbids it", "run it without --locked");
  }
  var plan: UpdatePlan* = deps_plan_update(p, req);
  g_bx_plan = plan;
  var n: int64 = plan->mods->len;
  var nlines: int64 = plan->lines_mods->len;
  var i: int64 = 0;
  if (dry) {
    while (i < n) {
      status("Would update", sl_get(plan->mods, i) + " " + sl_get(plan->froms, i) + " -> " + sl_get(plan->tos, i));
      i = i + 1;
    }
    i = 0;
    while (i < n) {
      bx_print_api(bx_api(p, sl_get(plan->mods, i), sl_get(plan->froms, i), sl_get(plan->tos, i), true));
      i = i + 1;
    }
    bx_say_newer(plan);
    if (n == 0 && nlines == 0) {
      status("Checked", "dependencies are up to date");
    }
    return 0;
  }
  if (n == 0) {
    bx_say_newer(plan);
    if (nlines == 0) {
      status("Checked", "dependencies are up to date");
    }
    return 0;
  }
  if (req->major) {
    while (i < n) {
      if (s_eq(sl_get(plan->kinds, i), "major")) {
        bx_print_api(bx_api(p, sl_get(plan->mods, i), sl_get(plan->froms, i), sl_get(plan->tos, i), true));
      }
      i = i + 1;
    }
  }
  var snap: DepSnap* = deps_snapshot(p);
  g_bx_snap = snap;
  g_bx_ds = deps_apply(p, plan->mods, plan->tos);
  bx_reload(p);
  var chosen: StrList* = sl_copy(plan->tos);
  var held_v: StrList* = sl_new();
  var held_e: StrList* = sl_new();
  i = 0;
  while (i < n) {
    sl_push(held_v, s_empty());
    sl_push(held_e, s_empty());
    i = i + 1;
  }
  if (!no_verify) {
    var v: BxVerify* = bx_verify(p, with_test);
    if (!v->ok && req->major) {
      error_msg("the update breaks this project:");
      bx_print_errors(v);
      bx_restore(p, snap);
      bx_say_restored();
      i = 0;
      while (i < n) {
        if (s_eq(sl_get(plan->kinds, i), "major")) {
          bx_help("take it and fix the code: `mbuild update --major " + sl_get(plan->mods, i) + " --no-verify`");
        }
        i = i + 1;
      }
      bx_free_verify(v);
      return 1;
    }
    if (!v->ok) {
      var first: string = bx_first_error(v);
      bx_restore(p, snap);
      i = 0;
      while (i < n) {
        var module: string = sl_get(plan->mods, i);
        var cands: StrList* = bx_cands(plan, i);
        var k: int64 = 0;
        var upto: int64 = 3;
        if (n == 1) {
          sl_set(held_v, 0, sl_get(plan->tos, 0));
          sl_set(held_e, 0, first);
          k = 1;
        }
        sl_set(chosen, i, s_empty());
        while (k < cands->len && k < upto) {
          var cand: string = sl_get(cands, k);
          k = k + 1;
          bx_apply_one(p, module, cand);
          var vv: BxVerify* = bx_verify(p, with_test);
          var passed: bool = vv->ok;
          if (passed) {
            sl_set(chosen, i, cand);
          } else if (slen(sl_get(held_v, i)) == 0) {
            sl_set(held_v, i, cand);
            sl_set(held_e, i, bx_first_error(vv));
          }
          bx_free_verify(vv);
          bx_restore(p, snap);
          if (passed) {
            break;
          }
        }
        free(cands);
        i = i + 1;
      }
      var mods2: StrList* = sl_new();
      var vers2: StrList* = sl_new();
      i = 0;
      while (i < n) {
        if (slen(sl_get(chosen, i)) > 0) {
          sl_push(mods2, sl_get(plan->mods, i));
          sl_push(vers2, sl_get(chosen, i));
        }
        i = i + 1;
      }
      if (mods2->len > 0) {
        g_bx_ds = deps_apply(p, mods2, vers2);
        bx_reload(p);
        if (mods2->len > 1) {
          var vt: BxVerify* = bx_verify(p, with_test);
          if (!vt->ok) {
            bx_restore(p, snap);
            i = 0;
            while (i < n) {
              if (slen(sl_get(chosen, i)) > 0) {
                sl_set(held_v, i, sl_get(chosen, i));
                sl_set(held_e, i, "fails only together with others");
                sl_set(chosen, i, s_empty());
              }
              i = i + 1;
            }
          }
          bx_free_verify(vt);
        }
      }
      free(mods2);
      free(vers2);
    }
    bx_free_verify(v);
  }
  var updated: int64 = 0;
  var held: int64 = 0;
  i = 0;
  while (i < n) {
    if (slen(sl_get(chosen, i)) > 0) {
      status("Updated", sl_get(plan->mods, i) + " " + sl_get(plan->froms, i) + " -> " + sl_get(chosen, i));
      updated = updated + 1;
    }
    i = i + 1;
  }
  i = 0;
  while (i < n) {
    if (slen(sl_get(held_v, i)) > 0) {
      status_warn("Held", sl_get(plan->mods, i) + " " + sl_get(held_v, i) + ": " + sl_get(held_e, i));
      held = held + 1;
    }
    i = i + 1;
  }
  bx_say_newer(plan);
  var summ: string = "{updated} updated, {held} held back";
  if (nlines == 1) {
    summ = summ + ", 1 new line available";
  } else if (nlines > 1) {
    summ = summ + ", {nlines} new lines available";
  }
  status("Summary", summ);
  free(chosen);
  free(held_v);
  free(held_e);
  if (updated == 0 && held > 0) {
    return 1;
  }
  return 0;
}

// ---------------------------------------------------------------------------
// mbuild profiles (12.12)
// ---------------------------------------------------------------------------

fn bx_val_text(v: TomlValue*, key: string) -> string {
  if (v->kind == 3) {
    if (s_eq(v->text, "true")) {
      return key;
    }
    return key + "=false";
  }
  if (v->kind == 4) {
    return key + "=[" + sl_join(v->items, ", ") + "]";
  }
  return key + "=" + v->text;
}

// The keys of one section with where they are set ("inherits" and "main"
// left out): the mb_set line of mbuild.mettle when mbf_locate finds it.
fn bx_section_keys(p: Project*, doc: Toml*, sec: string, file: string, parts: StrList*) {
  var text: string = "";
  if (s_eq(file, "mbuild.mettle")) {
    var rd: FsRead = fs_read(p->mbfile);
    if (rd.ok) {
      text = rd.data;
    }
  }
  var keys: StrList* = toml_keys(doc, sec);
  var i: int64 = 0;
  while (i < keys->len) {
    var key: string = sl_get(keys, i);
    i = i + 1;
    if (s_eq(key, "inherits") || s_eq(key, "main")) {
      continue;
    }
    var v: TomlValue* = toml_get(doc, sec, key);
    var at_line: string = file;
    var line: int64 = 0;
    if (slen(text) > 0) {
      line = mbf_locate(text, "mb_set", key, sec);
    }
    if (line > 0) {
      at_line = file + ":" + s_int(line);
    }
    sl_push(parts, bx_val_text(v, key) + " (" + at_line + ")");
  }
  free(keys);
}

fn bx_flags_text(p: Project*, prof: string, bin: string, target: string) -> string {
  var st: Settings* = bx_settings_of(p, prof, bin, target);
  var fl: StrList* = man_settings_flags(st, target);
  sl_extend(fl, p->opts->flags);
  var txt: string = "-> " + sl_join(fl, " ");
  free(fl);
  free(st);
  return s_trim(txt);
}

// mbuild services
export fn build_cmd_services(p: Project*) -> int32 {
  return svc_cmd_list(p);
}

export fn build_cmd_profiles(p: Project*) -> int32 {
  var m: Manifest* = p->man;
  var names: StrList* = man_profile_names(m);
  var targets: StrList* = build_targets(p);
  var target: string = sl_get(targets, 0);
  var bs: BinSet* = build_bins(p);
  var lefts: StrList* = sl_new();
  var rights: StrList* = sl_new();
  var w: int64 = 0;
  var i: int64 = 0;
  while (i < names->len) {
    if (slen(sl_get(names, i)) > w) {
      w = slen(sl_get(names, i));
    }
    i = i + 1;
  }
  i = 0;
  while (i < names->len) {
    var name: string = sl_get(names, i);
    i = i + 1;
    var sec: string = "profile." + name;
    var parts: StrList* = sl_new();
    var head: string = "";
    // The built-in setting, unless the project sets that key itself.
    var bkey: string = "";
    if (s_eq(name, "debug")) {
      bkey = "stack-trace";
    } else if (s_eq(name, "release")) {
      bkey = "optimize";
    } else {
      head = "inherits " + bx_inherits(m, name);
    }
    if (slen(bkey) > 0 && !toml_has(m->doc, sec, bkey) && (m->local == (Manifest*)0 || !toml_has(m->local->doc, sec, bkey))) {
      if (s_eq(bkey, "optimize")) {
        sl_push(parts, "optimize=full");
      } else {
        sl_push(parts, bkey);
      }
    }
    bx_section_keys(p, m->doc, sec, "mbuild.mettle", parts);
    if (m->local != (Manifest*)0) {
      bx_section_keys(p, m->local->doc, sec, "mbuild.local.mettle", parts);
    }
    var desc: string = sl_join(parts, ", ");
    if (slen(head) > 0 && slen(desc) > 0) {
      desc = head + "; " + desc;
    } else if (slen(head) > 0) {
      desc = head;
    }
    free(parts);
    var ftext: string = bx_flags_text(p, name, "", target);
    sl_push(lefts, s_pad_right(name, w + 2) + desc);
    sl_push(rights, ftext);
    var bi: int64 = 0;
    while (bi < bs->n) {
      var bname: string = bs->items[bi].name;
      bi = bi + 1;
      var bparts: StrList* = sl_new();
      bx_section_keys(p, m->doc, "bin." + bname, "mbuild.mettle", bparts);
      var btext: string = bx_flags_text(p, name, bname, target);
      if (bparts->len > 0 && !s_eq(btext, ftext)) {
        sl_push(lefts, "  bin " + bname + ": " + sl_join(bparts, ", "));
        sl_push(rights, btext);
      }
      free(bparts);
    }
  }
  var lw: int64 = 0;
  i = 0;
  while (i < lefts->len) {
    if (slen(sl_get(lefts, i)) > lw) {
      lw = slen(sl_get(lefts, i));
    }
    i = i + 1;
  }
  i = 0;
  while (i < lefts->len) {
    say(s_pad_right(sl_get(lefts, i), lw + 2) + sl_get(rights, i));
    i = i + 1;
  }
  free(names);
  free(targets);
  free(lefts);
  free(rights);
  return 0;
}

// ---------------------------------------------------------------------------
// fetch, components, use, agents
// ---------------------------------------------------------------------------

export fn build_cmd_fetch(p: Project*) -> int32 {
  return deps_cmd_fetch(p);
}

// mbuild components [--check]: --check stays in rest for cmp_cmd_components.
export fn build_cmd_components(p: Project*) -> int32 {
  return cmp_cmd_components(p, bx_deps(p));
}

// mbuild use NAME=IMPL | NAME
export fn build_cmd_use(p: Project*) -> int32 {
  if (!p->has_manifest) {
    fail_hint("no mbuild.mettle here", "run `mbuild init` first");
  }
  return cmp_cmd_use(p);
}

// mbuild agents [NAME] [--all]
export fn build_cmd_agents(p: Project*) -> int32 {
  var ds: DepState* = deps_ensure(p);
  g_bx_ds = ds;
  return agt_cmd_agents(p, ds);
}

// ---------------------------------------------------------------------------
// Help and project commands (13.6)
// ---------------------------------------------------------------------------

struct BxCmd {
  name: string;
  group: string;
  summary: string;
  usage: string;
  doc: string;
  ex: StrList*;
  ex_why: StrList*;
  flags: StrList*;
  flag_why: StrList*;
  notes: StrList*;
}

var g_bx_cmds: BxCmd* = (BxCmd*)0;
var g_bx_ncmds: int64 = 0;
var g_bx_group: string = "";

fn bx_group(name: string) {
  g_bx_group = name;
}

fn bx_def(name: string, summary: string, usage: string, doc: string) {
  g_bx_cmds = (BxCmd*)realloc(g_bx_cmds, (g_bx_ncmds + 1) * sizeof(BxCmd));
  var c: BxCmd* = &g_bx_cmds[g_bx_ncmds];
  c->name = name;
  c->group = g_bx_group;
  c->summary = summary;
  c->usage = usage;
  c->doc = doc;
  c->ex = sl_new();
  c->ex_why = sl_new();
  c->flags = sl_new();
  c->flag_why = sl_new();
  c->notes = sl_new();
  g_bx_ncmds = g_bx_ncmds + 1;
}

// An example invocation of the last command, with a short comment or "".
fn bx_ex(line: string, why: string) {
  sl_push(g_bx_cmds[g_bx_ncmds - 1].ex, line);
  sl_push(g_bx_cmds[g_bx_ncmds - 1].ex_why, why);
}

fn bx_fl(flag: string, why: string) {
  sl_push(g_bx_cmds[g_bx_ncmds - 1].flags, flag);
  sl_push(g_bx_cmds[g_bx_ncmds - 1].flag_why, why);
}

fn bx_note(text: string) {
  sl_push(g_bx_cmds[g_bx_ncmds - 1].notes, text);
}

fn bx_init_cmds() {
  if (g_bx_ncmds > 0) {
    return;
  }
  bx_group("build");
  bx_def("init", "start a project here", "mbuild init [NAME] [--package [--agent-rules]] [--from PKG[@V]]", "project.md");
  bx_ex("mbuild init", "package named after the folder");
  bx_ex("mbuild init --package", "one others can depend on");
  bx_ex("mbuild init --from webfw", "add a package's starter files");
  bx_fl("--package", "also write init.rules and a template");
  bx_fl("--agent-rules", "with --package, also write an AGENT.rules");
  bx_fl("--from PKG[@V]", "add PKG's starter files to this project");
  bx_fl("--opt K=V", "answer one of its options (repeatable)");
  bx_fl("--yes", "take the defaults, don't ask");
  bx_fl("--dry-run", "show what it would write");
  bx_note("writes mbuild.mettle, a hello world src/main.mettle unless there's a main file, and the .gitignore lines.");
  bx_note("lines of an existing mettle.deps become dependencies.");
  bx_def("new", "start a project from a package", "mbuild new NAME --from PKG[@V]", "packages.md");
  bx_ex("mbuild new blog --from webfw", "");
  bx_ex("mbuild new blog --from ../webfw --yes", "a path; every option at its default");
  bx_fl("--from PKG[@V]", "a registry package or a path, with an init.rules");
  bx_fl("--opt K=V", "answer one of its options (repeatable)");
  bx_fl("--yes", "take the defaults, don't ask");
  bx_fl("--dry-run", "show what it would write");
  bx_fl("--force", "write into a non-empty NAME/");
  bx_def("build", "build the programs", "mbuild build [BINS...] [-t T] [-r | -p PROFILE]", "project.md");
  bx_ex("mbuild build", "");
  bx_ex("mbuild build -r", "release");
  bx_ex("mbuild build -t all", "the mb_targets targets, else linux and windows");
  bx_ex("mbuild build -t riscv32-none", "a board image: build/riscv32-none/debug/NAME.bin and .elf");
  bx_ex("mbuild build server", "one bin");
  bx_fl("-t T", "linux, windows, riscv64-linux, riscv32-linux, riscv64-none, riscv32-none, all or host (repeatable)");
  bx_fl("-r, -p NAME", "the release profile, or another one");
  bx_fl("--set KEY=VALUE", "a typed build setting (repeatable)");
  bx_fl("--flag ARG", "a raw compiler flag (repeatable)");
  bx_fl("--use NAME=IMPL", "a component impl (repeatable)");
  bx_fl("--no-hooks", "skip hook_pre_build and hook_post_build");
  bx_fl("--force", "rebuild what's fresh too");
  bx_fl("--pgo-gen, --pgo-use[=FILE]", "build counting, or with the recorded profile (default .mbuild/pgo/BIN-TARGET.prof; see mbuild help pgo)");
  bx_note("output goes to build/<target>/<profile>/.");
  bx_note("riscv64-none and riscv32-none need a board (mb_set(\"board\", ...) after mb_on); outputs picks the files: bin, uf2 (pico2), elf, hex.");
  bx_note("imports of packages that aren't dependencies yet get added, unless --locked or --offline.");
  bx_note("a package with no bins (a library) is type-checked instead.");
  bx_def("run", "build and run a program", "mbuild run [BIN] [-t T] [-r | -p PROFILE] [-- ARGS...]", "project.md");
  bx_ex("mbuild run", "");
  bx_ex("mbuild run -- --port 8080", "args after -- go to the program");
  bx_ex("mbuild run -t windows", "through wine");
  bx_ex("mbuild run -t riscv64-linux", "under qemu-riscv64");
  bx_ex("mbuild run -t riscv32-none", "a board image: qemu-virt on qemu-system, pico2 on rvsim");
  bx_fl("-t T", "one target (default: the host)");
  bx_fl("-r, -p NAME", "the release profile, or another one");
  bx_fl("--timeout SECS", "stop the program after SECS (default 30 under an emulator, else none)");
  bx_fl("--no-services", "don't start the mb_service processes");
  bx_fl("--pgo-gen", "build counting and record .mbuild/pgo/BIN-TARGET.prof (see mbuild help pgo)");
  bx_note("the exit code is the program's; 124 when --timeout stopped it.");
  bx_note("riscv*-linux runs on qemu-riscv64 / qemu-riscv32 from MBUILD_QEMU_USER_DIR, ~/.local/opt/qemu-user/bin or PATH. board pico2 runs on rvsim (PATH, MBUILD_RVSIM, else built once into $MBUILD_HOME/tools from the compiler's Mettle checkout).");
  bx_note("mb_service processes start first, in order, each waited for on its port; they stop when the program exits. output in .mbuild/logs/NAME.log.");
  bx_def("live", "run a program and patch it as you edit", "mbuild live [BIN] [-p PROFILE] [--preview SIDE] [-- ARGS...]", "project.md");
  bx_ex("mbuild live", "");
  bx_ex("mbuild live --preview right", "MBUILD_PREVIEW=right for the program");
  bx_ex("mbuild use render=gl", "in another terminal: switch a component");
  bx_fl("--preview SIDE", "left, right, top, bottom or off: MBUILD_PREVIEW for the program (default: mb_preview)");
  bx_note("saved files patch the running program at its next `quiesce;`. host target only.");
  bx_note("events go to .mbuild/live/BIN.events, one line each: changed PATH, removed PATH (the mb_watch files, polled every 150 ms), patched NAME, patch-error MSG, built, build-error MSG, paused, resumed, exited CODE. the program reads them with mblive_next (import \"mbuild/live\"); MBUILD_LIVE_EVENTS names the file.");
  bx_def("shell", "a shell inside the running program", "mbuild shell [BIN] [-p PROFILE] [--plain] [--local] [--stream] [--preview SIDE] [-- ARGS...]", "project.md");
  bx_ex("mbuild shell", "build, start, then type at the prompt");
  bx_ex("mbuild shell --plain", "the line shell, also what a pipe gets");
  bx_ex("mbuild shell --local", "no program: each input runs on its own");
  bx_fl("--plain", "the line shell on a terminal too");
  bx_fl("--local", "evaluate in a small program that imports the project's code");
  bx_fl("--stream", "line shell: show the program's output above the prompt (it is held by default)");
  bx_fl("--preview SIDE", "MBUILD_PREVIEW for the program, as for mbuild live");
  bx_note("on a terminal it is full screen (mbuild-shell, beside mbuild): ctrl+p pause/resume, ctrl+n step, ctrl+o stream output, / commands (/inspect EXPR, /code, /watch, /log), tab completes, ctrl+d quits.");
  bx_note("the program calls `shell_point();` (import \"mbuild/shell\") next to its `quiesce;`; elsewhere it is an empty function.");
  bx_note("inputs: an expression prints its value, a statement runs, `fn NAME(...) {{...}` redefines NAME; `edit NAME`, `undo [NAME]`, `r`, `pause`, `resume`, `step`, `pause when EXPR`, `watch EXPR`, `status`, `h NAME`, `i EXPR`, `:log`, `:q`. type `help` at the prompt.");
  bx_note("it writes the same events as mbuild live (paused and resumed too) for mbuild/live.");
  bx_note("a pause holds the thread calling shell_point(), between ticks; inputs and patches still run. other threads keep running. globals and functions are in scope, locals are not. Linux only.");
  bx_def("test", "run the tests: @test files, test programs, command tests", "mbuild test [NAMES | FILES...] [--matrix=CELLS] [--repeat N] [--bless [--only S]]", "project.md");
  bx_ex("mbuild test", "every test in every cell of its matrix (default: debug on the host)");
  bx_ex("mbuild test parse --repeat 50", "one test 50 times; it passes when every run does");
  bx_ex("mbuild test --matrix=debug,release", "every test built and run both ways");
  bx_ex("mbuild test -t host,riscv64-linux,riscv32-none:pico2", "the same tests on three targets");
  bx_ex("mbuild test src/lex.mettle", "one @test file");
  bx_fl("--matrix=CELLS", "the cells instead of each test's matrix setting: PROFILE or TARGET/PROFILE, comma-separated");
  bx_fl("-r, -p P", "short for --matrix=release, --matrix=P");
  bx_fl("-t T", "the targets a cell without one runs on (default: mb_test_targets, else the host)");
  bx_fl("--repeat N", "runs per cell; a test passes when all of them do");
  bx_fl("--timeout SECS", "per run (default: the timeout setting, 600; 30 under an emulator)");
  bx_fl("--deny-warnings", "fail a test whose build warns (the warnings setting = error)");
  bx_fl("--filter S", "only tests whose names contain S");
  bx_fl("-j N", "N runs at once (serial tests run alone, after the rest)");
  bx_fl("-q", "show failed tests only");
  bx_fl("--keep", "keep the run directories of passing runs too (.mbuild/test-run/CELL/NAME/K)");
  bx_fl("--force", "run cached tests too");
  bx_fl("--bless", "write each passing test's outputs (out/, stdout with golden = files,stdout) as its golden files");
  bx_fl("--only S", "with --bless: only golden paths containing S");
  bx_note("a test is an @test file (run in the compiler's interpreter), a test program (mb_test_bin, tests/NAME_test.mettle with fn main, mb_test_glob) or a command test (mb_test_cmd); it passes on exit 0. mb_test_set(name, key, value) sets matrix, timeout, repeat, serial, cwd, warnings, checks, args, run and more (docs/project.md).");
  bx_note("each run gets its own directory: TMPDIR (MBUILD_TEST_TMP), MBUILD_TEST_OUT, stdout and stderr; it runs in a process group of its own, which a timeout stops whole.");
  bx_note("golden files: what a run writes to $MBUILD_TEST_OUT must match tests/golden/NAME (the golden-dir setting) byte for byte, PNG files pixel for pixel within png-tolerance; with several cells, each cell's outputs must match the first's (golden-cross).");
  bx_note("a passing (test, cell) is cached until its build or settings change; --repeat above 1 never is.");
  bx_note("a pico2 test program can't exit: it passes when its console prints exit-on-uart (default PASS; call pico2_init() first), within rvsim-until-ms (default 10000).");
  bx_def("flash", "copy a board image to the board", "mbuild flash [BIN] [-t T] [-r | -p PROFILE]", "platforms.md");
  bx_ex("mbuild flash", "build the UF2 and copy it to the Pico 2's drive");
  bx_ex("mbuild flash -r blink", "");
  bx_fl("-t T", "the board target (default: the bin's triple, else mb_targets' board target, else riscv32-none)");
  bx_note("for board pico2: hold BOOTSEL while plugging the board in; its drive (label RP2350) is found under /run/media/$USER, /media/$USER or /mnt, or MBUILD_FLASH_DIR names it. mbuild writes NAME.uf2 there and syncs; the board restarts into it.");
  bx_note("other boards have no drive: flash them from a project command (fn cmd_upload).");
  bx_def("pgo", "build with a profile of a real run", "mbuild pgo [collect] [BIN] [-t T] [-p PROFILE] [-- ARGS...]", "platforms.md");
  bx_ex("mbuild pgo", "build counting, run it, build release with its profile");
