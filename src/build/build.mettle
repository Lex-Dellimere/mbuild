  bx_ex("mbuild info .", "this project the same way; also the name of an mb_dep_path dependency");
  bx_fl("--readme", "print README.md as is (without one: the exported functions)");
  bx_fl("--offline", "use the download cache");
  bx_note("top to bottom: `NAME VERSION` (marked yanked when it is), the description, the first paragraph of the README.md after its title, then License, Source, Authors,");
  bx_note("Registry, Docs (the registry's page for the package, Mettle registries only), Versions (newest first, yanked ones marked), Path (. or a path dependency),");
  bx_note("Dependencies (what that version requires), and Functions: every exported fn, file by file, as `fn name(params) -> type`, with the `//` or `///` lines directly above it.");
  bx_note("VERSION is the newest stable one that isn't yanked; `@v1.2.0` or `@1.2.0` picks one, `@v1` the newest in that line.");
  bx_note("the archive is fetched and checked like `get` does, or read from the download cache with --offline; a path package is read from its directory.");
  bx_note("with no compiler, the project's own registries are skipped (a note says so); `.` and path dependencies need mbuild.mettle read.");
  bx_def("get", "add or upgrade a dependency", "mbuild get NAME[@VERSION]... [--test] [--no-verify]", "dependencies.md");
