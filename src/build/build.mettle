}

fn bx_find_cmd(name: string) -> BxCmd* {
  bx_init_cmds();
  var i: int64 = 0;
  while (i < g_bx_ncmds) {
    if (s_eq(g_bx_cmds[i].name, name)) {
      return &g_bx_cmds[i];
    }
    i = i + 1;
  }
  return (BxCmd*)0;
}

// True when name is a built-in command (they shadow project commands).
export fn build_is_builtin(name: string) -> bool {
  return bx_find_cmd(name) != (BxCmd*)0;
}

// "    a    why" rows, the whys lined up; a row with no why gets no padding.
fn bx_say_rows(indent: string, left: StrList*, right: StrList*, prefix: string) {
  var w: int64 = 0;
  var i: int64 = 0;
  while (i < left->len) {
    if (slen(sl_get(left, i)) > w) {
      w = slen(sl_get(left, i));
    }
    i = i + 1;
  }
  i = 0;
  while (i < left->len) {
    var r: string = sl_get(right, i);
    if (slen(r) == 0) {
      say(indent + sl_get(left, i));
    } else {
      say(indent + s_pad_right(sl_get(left, i), w + 2) + prefix + r);
    }
    i = i + 1;
  }
}

// The global flags and what they do.
fn bx_global_rows(l: StrList*, r: StrList*) {
  sl_push(l, "-v, --verbose");   sl_push(r, "print every command mbuild runs");
  sl_push(l, "-q, --quiet");     sl_push(r, "only errors and program output");
  sl_push(l, "--color WHEN");    sl_push(r, "auto (default), always or never");
  sl_push(l, "-t, --target T");  sl_push(r, "linux, windows, all or host (repeatable)");
  sl_push(l, "-r, --release");   sl_push(r, "the release profile");
  sl_push(l, "-p, --profile NAME"); sl_push(r, "another profile");
  sl_push(l, "-j, --jobs N");    sl_push(r, "parallel compiles");
  sl_push(l, "--force");         sl_push(r, "ignore every up-to-date stamp");
  sl_push(l, "--offline");       sl_push(r, "never touch the network");
  sl_push(l, "--locked");        sl_push(r, "fail rather than change mbuild.mettle or mbuild.lock");
  sl_push(l, "--mettle PATH");   sl_push(r, "the compiler for the host target");
  sl_push(l, "--set KEY=VALUE"); sl_push(r, "a typed build setting (repeatable)");
  sl_push(l, "--flag ARG");      sl_push(r, "a raw compiler flag (repeatable)");
  sl_push(l, "--use NAME=IMPL"); sl_push(r, "a component impl (repeatable)");
  sl_push(l, "--no-hooks");      sl_push(r, "skip hook_pre_build and hook_post_build");
}

fn bx_global_help() {
  var l: StrList* = sl_new();
  var r: StrList* = sl_new();
  bx_global_rows(l, r);
  say(bold("flags") + " - for every command");
  say("");
  bx_say_rows("  ", l, r, "");
  free(l);
  free(r);
}

// mbuild.mettle's commands, scanned (nothing is compiled); 0 when none.
fn bx_project_info(p: Project*) -> MbfInfo* {
  if (p == (Project*)0 || slen(p->mbfile) == 0) {
    return (MbfInfo*)0;
  }
  if (g_bx_info == (MbfInfo*)0) {
    g_bx_info = cfg_info(p);
  }
  return g_bx_info;
}

// The project command `name` (cmd_gen_docs answers gen-docs and gen_docs), 0.
fn bx_project_cmd(info: MbfInfo*, name: string) -> MbfCommand* {
  if (info == (MbfInfo*)0) {
    return (MbfCommand*)0;
  }
  var dashed: string = s_replace_byte(name, 95, 45);
  var fname: string = "cmd_" + name;
  var i: int64 = 0;
  while (i < info->ncommands) {
    var c: MbfCommand* = &info->commands[i];
    if (s_eq(c->name, name) || s_eq(c->name, dashed) || s_eq(c->fn_name, fname)) {
      return c;
    }
    i = i + 1;
  }
  return (MbfCommand*)0;
}

var g_bx_sug_proj: bool = false;

// The closest built-in or project command to name, "" when none is close;
// on a tie the project's command wins (helo: hello, not help).
fn bx_suggest(info: MbfInfo*, name: string) -> string {
  bx_init_cmds();
  var cands: StrList* = sl_new();
  var i: int64 = 0;
  while (info != (MbfInfo*)0 && i < info->ncommands) {
    if (!build_is_builtin(info->commands[i].name)) {
      sl_add_uniq(cands, info->commands[i].name);
    }
    i = i + 1;
  }
  var nproj: int64 = cands->len;
  i = 0;
  while (i < g_bx_ncmds) {
    sl_push(cands, g_bx_cmds[i].name);
    i = i + 1;
  }
  var sug: string = man_suggest(name, cands);
  g_bx_sug_proj = slen(sug) > 0 && sl_index(cands, sug) < nproj;
  free(cands);
  return sug;
}

// error: no command named x + a suggestion over built-ins and project commands.
fn bx_unknown_cmd(info: MbfInfo*, name: string) {
  var sug: string = bx_suggest(info, name);
  var msg: string = "no command named " + name;
  if (slen(sug) == 0) {
    fail_hint(msg, "run `mbuild help` for the commands");
  }
  if (g_bx_sug_proj) {
    fail_hint(msg, "did you mean " + sug + "? (mbuild.mettle)");
  }
  fail_hint(msg, "did you mean " + sug + "?");
}

// mbuild help X with no command X.
fn bx_unknown_topic(info: MbfInfo*, name: string) {
  var sug: string = bx_suggest(info, name);
  error_msg("no command named " + name);
  if (slen(sug) > 0) {
    var tag: string = "";
    if (g_bx_sug_proj) {
      tag = " (mbuild.mettle)";
    }
    err_line("  " + cyan("help") + ": did you mean " + sug + "?" + tag);
  }
  err_line("  " + cyan("help") + ": run `mbuild help` for the list");
  exit_with(1);
}

fn bx_say_cmd_help(c: BxCmd*) {
  say(bold(c->name) + " - " + c->summary);
  say("");
  say("  usage: " + c->usage);
  if (c->ex->len > 0) {
    say("");
    say("  " + bold("Common:"));
    bx_say_rows("    ", c->ex, c->ex_why, "# ");
  }
  if (c->flags->len > 0) {
    say("");
    say("  " + bold("Flags:"));
    bx_say_rows("    ", c->flags, c->flag_why, "");
  }
  if (c->notes->len > 0) {
    say("");
    say("  " + bold("Notes:"));
    var i: int64 = 0;
    while (i < c->notes->len) {
      say("    " + sl_get(c->notes, i));
      i = i + 1;
    }
  }
  if (slen(c->doc) > 0) {
    say("Doc: docs/" + c->doc);
  }
}

fn bx_say_project_cmd_help(pc: MbfCommand*) {
  var summ: string = pc->summary;
  if (slen(summ) == 0) {
    summ = "a command from mbuild.mettle";
  }
  say(bold(pc->name) + " - " + summ);
  say("");
  say("  usage: mbuild " + pc->name + " [ARGS...]");
  var lines: StrList* = s_split(pc->help, 10);
  var i: int64 = 1;
  while (i < lines->len && slen(s_trim(sl_get(lines, i))) == 0) {
    i = i + 1;
  }
  if (i < lines->len) {
    say("");
    while (i < lines->len) {
      var ln: string = sl_get(lines, i);
      if (slen(ln) == 0) {
        say("");
      } else {
        say("  " + ln);
      }
      i = i + 1;
    }
  }
  free(lines);
  say("From: mbuild.mettle:" + s_int(pc->line) + " (fn " + pc->fn_name + ")");
}

// mbuild help [topic]. p may be unloaded (build_find): help compiles nothing.
export fn build_help(p: Project*, topic: string) -> int32 {
  bx_init_cmds();
  var info: MbfInfo* = bx_project_info(p);
  if (info != (MbfInfo*)0 && !info->ok) {
    warn("mbuild.mettle: " + info->err);
    info = (MbfInfo*)0;
  }
  if (slen(topic) > 0) {
    var c: BxCmd* = bx_find_cmd(topic);
    if (c != (BxCmd*)0) {
      bx_say_cmd_help(c);
      return 0;
    }
    if (s_eq(topic, "flags")) {
      bx_global_help();
      return 0;
    }
    var pc: MbfCommand* = bx_project_cmd(info, topic);
    if (pc == (MbfCommand*)0) {
      bx_unknown_topic(info, topic);
    }
    bx_say_project_cmd_help(pc);
    return 0;
  }
  var nproj: int64 = 0;
  if (info != (MbfInfo*)0) {
    nproj = info->ncommands;
  }
  var w: int64 = 0;
  var i: int64 = 0;
  while (i < g_bx_ncmds) {
    if (slen(g_bx_cmds[i].name) > w) {
      w = slen(g_bx_cmds[i].name);
    }
    i = i + 1;
  }
  i = 0;
  while (i < nproj) {
    if (slen(info->commands[i].name) > w) {
      w = slen(info->commands[i].name);
    }
    i = i + 1;
  }
  w = w + 2;
  say(bold("mbuild") + " " + build_version_text + " - build tool and package manager for Mettle");
  say("");
  say("usage: mbuild COMMAND [args]");
  var group: string = "";
  i = 0;
  while (i < g_bx_ncmds) {
    var bc: BxCmd* = &g_bx_cmds[i];
    if (!s_eq(bc->group, group)) {
      group = bc->group;
      say("");
      say(bold(group + ":"));
    }
    say("  " + s_pad_right(bc->name, w) + bc->summary);
    i = i + 1;
  }
  if (nproj > 0) {
    say("");
    say(bold("this project (mbuild.mettle):"));
    i = 0;
    while (i < nproj) {
      var c2: MbfCommand* = &info->commands[i];
      var summ: string = c2->summary;
      if (build_is_builtin(c2->name)) {
        summ = "(shadowed by the built-in " + c2->name + "; rename " + c2->fn_name + ")";
      }
      if (slen(summ) == 0) {
        say("  " + c2->name);
      } else {
        say("  " + s_pad_right(c2->name, w) + summ);
      }
      i = i + 1;
    }
  }
  say("");
  say("run `mbuild help COMMAND` for details");
  say("flags: -v -q -t T -r -p NAME --offline --locked -j N --force (`mbuild help flags`)");
  return 0;
}

// mbuild NAME [args]: cmd_NAME of mbuild.mettle, args untouched (13.6).
// p comes from build_find: the configuration is loaded only for a command
// that exists.
export fn build_cmd_project(p: Project*, name: string) -> int32 {
  bx_refuse_legacy(p);
  var info: MbfInfo* = bx_project_info(p);
  if (info != (MbfInfo*)0 && !info->ok) {
    fail(info->err);
  }
  var c: MbfCommand* = bx_project_cmd(info, name);
  if (c == (MbfCommand*)0) {
    bx_unknown_cmd(info, name);
  }
  bx_load_manifest(p);
  return cfg_run_command(p, c->name, p->opts->rest);
}

// ---------------------------------------------------------------------------
// Shell completion
// ---------------------------------------------------------------------------

// mbuild completion bash|zsh|fish
export fn build_cmd_completion(o: Options*) -> int32 {
  var shell: string = s_empty();
  var n: int64 = 0;
  var i: int64 = 0;
  while (i < o->rest->len) {
    if (!s_starts(sl_get(o->rest, i), "-")) {
      shell = sl_get(o->rest, i);
      n = n + 1;
    }
    i = i + 1;
  }
  if (n != 1) {
    fail_hint("mbuild completion takes a shell: bash, zsh or fish", "mbuild completion bash > ~/.local/share/bash-completion/completions/mbuild");
  }
  bx_init_cmds();
  var sp: CmpSpec* = new CmpSpec;
  defer free(sp);
  sp->cmds = sl_new();
  sp->flags = sl_new();
  sp->globals = sl_new();
  var rl: StrList* = sl_new();
  defer free(rl);
  var rr: StrList* = sl_new();
  defer free(rr);
  bx_global_rows(rl, rr);
  i = 0;
  while (i < rl->len) {
    cmp_flags_in(sl_get(rl, i), sp->globals);
    i = i + 1;
  }
  cmp_flags_in("-h --help -V --version", sp->globals);
  i = 0;
  while (i < g_bx_ncmds) {
    var c: BxCmd* = &g_bx_cmds[i];
    var fl: StrList* = sl_new();
    cmp_flags_in(c->usage, fl);
    var f: int64 = 0;
    while (f < c->flags->len) {
      cmp_flags_in(sl_get(c->flags, f), fl);
      f = f + 1;
    }
    var own: StrList* = sl_new();
    f = 0;
    while (f < fl->len) {
      if (!sl_has(sp->globals, sl_get(fl, f))) {
        sl_push(own, sl_get(fl, f));
      }
      f = f + 1;
    }
    sl_push(sp->cmds, c->name);
    sl_push(sp->flags, sl_join(own, " "));
    free(fl);
    free(own);
    i = i + 1;
  }
  var text: string = cmp_script(shell, sp);
  if (slen(text) == 0) {
    fail_hint("no completion script for " + shell, "bash, zsh and fish are supported");
  }
  print(text);
  return 0;
}

// The package names in the cached indexes of every registry.
fn bx_complete_packages(p: Project*, out: StrList*) {
  var regs: RegList* = reg_list(p);
  defer free(regs);
  var r: int64 = 0;
  while (r < regs->names->len) {
    var all: RegAll* = reg_all(p, sl_get(regs->names, r), false);
    r = r + 1;
    var k: int64 = 0;
    while (all->ok && k < all->n) {
      sl_add_uniq(out, all->ixs[k]->name);
      k = k + 1;
    }
  }
}

// The candidates of one kind (build_complete).
fn bx_complete_kind(p: Project*, kind: string, out: StrList*) {
  bx_init_cmds();
  if (s_eq(kind, "targets")) {
    sl_push(out, "linux");
    sl_push(out, "windows");
    sl_push(out, "all");
    sl_push(out, "host");
    return;
  }
  var in_project: bool = slen(p->mbfile) > 0;
  if (s_eq(kind, "commands")) {
    var i: int64 = 0;
    while (i < g_bx_ncmds) {
      sl_push(out, g_bx_cmds[i].name);
      i = i + 1;
    }
    var info: MbfInfo* = bx_project_info(p);
    i = 0;
    while (info != (MbfInfo*)0 && info->ok && i < info->ncommands) {
      sl_add_uniq(out, info->commands[i].name);
      i = i + 1;
    }
    return;
  }
  // the registries of mbuild.mettle, when it can be evaluated
  if (in_project && (!s_eq(kind, "packages") || tc_available(p, sys_os()))) {
    bx_load_manifest(p);
  }
  if (s_eq(kind, "packages")) {
    bx_complete_packages(p, out);
    return;
  }
  if (!in_project) {
    return;
  }
  var m: Manifest* = p->man;
  var j: int64 = 0;
  if (s_eq(kind, "bins") || s_eq(kind, "tests")) {
    var bs: BinSet* = build_bins(p);
    if (s_eq(kind, "tests")) {
      bs = bx_test_bins(p);
    }
    while (j < bs->n) {
      sl_push(out, bs->items[j].name);
      j = j + 1;
    }
  } else if (s_eq(kind, "deps")) {
    while (j < m->ndeps) {
      sl_push(out, m->deps[j].key);
      j = j + 1;
    }
  } else if (s_eq(kind, "components")) {
    while (j < m->ncomps) {
      sl_push(out, m->comps[j].name);
      j = j + 1;
    }
  } else if (s_eq(kind, "profiles")) {
    sl_extend(out, man_profile_names(m));
  }
}

// mbuild __complete KIND [PREFIX]: the candidates of KIND (commands, bins,
// tests, deps, packages, components, profiles, targets) starting with PREFIX,
// one per line, for the completion scripts. Quiet and offline; a project that
// can't be read gives nothing.
export fn build_complete(p: Project*) -> int32 {
  g_quiet = true;
  p->opts->offline = true;
  var args: StrList* = p->opts->rest;
  if (args->len == 0) {
    return 1;
  }
  var prefix: string = s_empty();
  if (args->len > 1) {
    prefix = sl_get(args, 1);
  }
  var out: StrList* = sl_new();
  defer free(out);
  bx_complete_kind(p, sl_get(args, 0), out);
  var i: int64 = 0;
  while (i < out->len) {
    if (s_starts(sl_get(out, i), prefix)) {
      say(sl_get(out, i));
    }
    i = i + 1;
  }
  return 0;
}

// ---------------------------------------------------------------------------
// Registries: publish, yank, registry init (14.7)
// ---------------------------------------------------------------------------

// A directory argument as an absolute path ('/' separators).
fn bx_abs_dir(arg: string) -> string {
  var d: string = bx_slash(arg);
  if (!p_is_abs(d)) {
    d = p_join(bx_cwd(), d);
  }
  return p_clean(d);
}

// The registry directory of --to DIR, else of --registry NAME (default
// "default") when it has a path or file:// URL.
fn bx_registry_dir(p: Project*, to: string, registry: string) -> string {
  if (slen(to) > 0) {
    var td: string = bx_abs_dir(to);
    var tw: string = reg_write_refusal(p, p_base(td), td);
    if (slen(tw) > 0) {
      fail(tw);
    }
    return td;
  }
  var name: string = registry;
  if (slen(name) == 0) {
    name = "default";
  }
  var dir: string = reg_dir_of(p, name);
  var why: string = reg_write_refusal(p, name, dir);
  if (slen(why) > 0) {
    fail(why);
  }
  if (slen(dir) == 0) {
    fail("registry " + name + " is served over https; publish into a local copy of it with --to DIR and upload that");
  }
  return dir;
}

// The versions in the index of name in a registry directory, yanked ones too.
fn bx_index_versions(dir: string, name: string) -> StrList* {
  var vers: StrList* = sl_new();
  var rd: FsRead = fs_read(dir + "/index/" + name);
  if (!rd.ok) {
    return vers;
  }
  var lines: StrList* = s_lines(rd.data);
  var i: int64 = 0;
  while (i < lines->len) {
    var f: StrList* = s_fields(sl_get(lines, i));
    i = i + 1;
    if (f->len > 0 && !s_starts(sl_get(f, 0), "#") && sv_is(sl_get(f, 0))) {
      sl_push(vers, sv_canonical(sl_get(f, 0)));
    }
    free(f);
  }
  free(lines);
  return vers;
}

fn bx_size_text(n: int64) -> string {
  if (n < 1024) {
    return "{n} B";
  }
  var tenths: int64 = n * 10 / 1024;
  if (tenths < 10240) {
    var whole: int64 = tenths / 10;
    var frac: int64 = tenths % 10;
    return "{whole}.{frac} KB";
  }
  var mt: int64 = n * 10 / (1024 * 1024);
  var mw: int64 = mt / 10;
  var mf: int64 = mt % 10;
  return "{mw}.{mf} MB";
}

fn bx_pub_walk(root: string, rel: string, out: StrList*) {
  var dir: string = root;
  if (slen(rel) > 0) {
    dir = root + "/" + rel;
  }
  var files: StrList* = sl_new();
  var dirs: StrList* = sl_new();
  if (sys_list_dir(dir, files, dirs)) {
    var i: int64 = 0;
    while (i < files->len) {
      var f: string = sl_get(files, i);
      i = i + 1;
      if (s_starts(f, ".")) {
        continue;
      }
      if (slen(rel) == 0 && (s_eq(f, "mbuild.lock") || s_eq(f, "mbuild.local.mettle") || s_eq(f, "mettle.deps"))) {
        continue;
      }
      if (slen(rel) > 0) {
        f = rel + "/" + f;
      }
      sl_push(out, f);
    }
    i = 0;
    while (i < dirs->len) {
      var d: string = sl_get(dirs, i);
      i = i + 1;
      if (s_starts(d, ".")) {
        continue;
      }
      if (slen(rel) == 0 && (s_eq(d, "build") || s_eq(d, "vendor") || s_eq(d, "dist"))) {
        continue;
      }
      var sub: string = d;
      if (slen(rel) > 0) {
        sub = rel + "/" + d;
      }
      // a nested package is published on its own
      var nested: string = root + "/" + sub + "/mbuild.mettle";
      if (fs_is_file(nested)) {
        continue;
      }
      bx_pub_walk(root, sub, out);
    }
  }
  free(files);
  free(dirs);
}

// The files a publish packs (14.7 step 6), sorted, relative to the root.
fn bx_pub_files(p: Project*) -> StrList* {
  var out: StrList* = sl_new();
  var inc: StrList* = p->man->include;
  if (inc != (StrList*)0 && inc->len > 0) {
    var i: int64 = 0;
    while (i < inc->len) {
      var rel: string = p_clean(bx_slash(sl_get(inc, i)));
      i = i + 1;
      var abs: string = p->root + "/" + rel;
      if (fs_is_dir(abs)) {
        var below: StrList* = sl_new();
        bx_pub_walk(abs, "", below);
        var k: int64 = 0;
        while (k < below->len) {
          sl_add_uniq(out, rel + "/" + sl_get(below, k));
          k = k + 1;
        }
        free(below);
      } else if (fs_is_file(abs)) {
        sl_add_uniq(out, rel);
      } else {
        fail("[package] include names " + rel + ", which does not exist");
      }
    }
  } else {
    bx_pub_walk(p->root, "", out);
  }
  sl_add_uniq(out, "mbuild.mettle");
  sl_add_uniq(out, "init.rules");
  sl_add_uniq(out, "AGENT.rules");
  sl_sort(out);
  if (out->len > 10000) {
    fail("this package has " + s_int(out->len) + " files; a package holds at most 10000 (narrow it with mb_publish_include)");
  }
  var j: int64 = 0;
  while (j < out->len) {
    var f: string = p->root + "/" + sl_get(out, j);
    if (sys_is_link(f)) {
      fail(sl_get(out, j) + " is a link; packages hold regular files only");
    }
    if (sys_stat(f).size > 16 * 1024 * 1024) {
      fail(sl_get(out, j) + " is over 16 MB; leave it out with mb_publish_include");
    }
    j = j + 1;
  }
  return out;
}

fn bx_pub_section_kept(sec: string) -> bool {
  return s_eq(sec, "package") || s_eq(sec, "dependencies") || s_starts(sec, "dependencies.") || s_eq(sec, "c") || s_starts(sec, "c.") || s_eq(sec, "link") || s_starts(sec, "link.") || s_starts(sec, "component.");
}

fn bx_pub_package_key(key: string) -> bool {
  return s_eq(key, "name") || s_eq(key, "version") || s_eq(key, "description") || s_eq(key, "license") || s_eq(key, "repository") || s_eq(key, "authors") || s_eq(key, "mettle") || s_eq(key, "import-root");
}

// The emitted TOML reduced to what users read (14.7 step 7).
fn bx_pub_manifest(p: Project*) -> string {
  var lines: StrList* = s_lines(cfg_manifest_text(p));
  var b: Buf* = buf_new();
  var sec: string = "";
  var i: int64 = 0;
  while (i < lines->len) {
    var line: string = sl_get(lines, i);
    i = i + 1;
    var t: string = s_trim(line);
    if (s_starts(t, "[") && s_ends(t, "]")) {
      sec = s_trim(s_sub(t, 1, slen(t) - 1));
      if (bx_pub_section_kept(sec)) {
        buf_line(b, line);
      }
      continue;
    }
    if (!bx_pub_section_kept(sec)) {
      continue;
    }
    if (s_eq(sec, "package") && slen(t) > 0 && !s_starts(t, "#")) {
      var eq: int64 = s_find_byte(t, 61);
      if (eq > 0 && !bx_pub_package_key(s_trim(s_sub(t, 0, eq)))) {
        continue;
      }
    }
    buf_line(b, line);
  }
  free(lines);
  return buf_take(b);
}

// mbuild publish [--to DIR] [--registry NAME] [--dry-run] [--allow-breaking] [--no-verify]
export fn build_cmd_publish(p: Project*) -> int32 {
  var to: string = bx_take_opt(p, "--to");
  var registry: string = bx_take_opt(p, "--registry");
  var dry: bool = bx_take_flag(p, "--dry-run");
  var allow: bool = bx_take_flag(p, "--allow-breaking");
  var no_verify: bool = bx_take_flag(p, "--no-verify");
  var m: Manifest* = p->man;
  if (!p->has_manifest) {
    fail_hint("no mbuild.mettle here: nothing to publish", "run `mbuild init --package` to make a package");
  }
  if (slen(m->name) == 0 || !sv_is(m->version)) {
    fail_hint("a published package needs a name and a version", "mb_package(\"name\", \"0.1.0\") in mbuild.mettle");
  }
  var name: string = m->name;
  var version: string = sv_canonical(m->version);
  var dir: string = bx_registry_dir(p, to, registry);
  if (!fs_is_file(dir + "/registry.toml")) {
    fail_hint(dir + " is not a registry (no registry.toml)", "make one with `mbuild registry init " + bx_show(dir) + "`");
  }
  var vers: StrList* = bx_index_versions(dir, name);
  if (sl_has(vers, version)) {
    fail(name + " " + version + " is already in " + bx_show(dir) + "; publish a new version");
  }
  var newest: string = "";
  var i: int64 = 0;
  while (i < vers->len) {
    var v: string = sl_get(vers, i);
    if (s_eq(sv_line(v), sv_line(version)) && sv_cmp(v, version) > 0 && (slen(newest) == 0 || sv_cmp(v, newest) > 0)) {
      newest = v;
    }
    i = i + 1;
  }
  if (slen(newest) > 0) {
    warn("publishing " + version + " after " + newest);
  }
  var leaves: StrList* = sl_of("init.rules");
  sl_push(leaves, "AGENT.rules");
  i = 0;
  while (i < leaves->len) {
    if (!fs_is_file(p->root + "/" + sl_get(leaves, i))) {
      fail(name + " cannot be published without " + sl_get(leaves, i) + " (mbuild init --package writes one)");
    }
    i = i + 1;
  }
  free(leaves);
  var ierr: string = ini_check_package(p, p->root);
  if (slen(ierr) > 0) {
    fail(ierr);
  }
  i = 0;
  while (i < m->ndeps) {
    var d: DepSpec* = man_dep(m, i);
    if (slen(d->path) > 0) {
      fail_hint("dependency " + d->key + " is a path package (" + d->path + "): users of " + name + " cannot resolve it", "publish " + d->key + " too and depend on a version");
    }
    i = i + 1;
  }
  if (m->nreplaces > 0) {
    warn("mbuild.mettle replaces dependencies; users of " + name + " ignore that");
  }
  if (!allow) {
    var rep: string = deps_api_breaks(p, name, version, dir);
    if (slen(rep) > 0) {
      bx_fail_text(rep);
    }
  }
  if (!no_verify) {
    var v: BxVerify* = bx_verify(p, false);
    if (!v->ok) {
      error_msg(name + " " + version + " does not build:");
      bx_print_errors(v);
      bx_help("fix it, or publish anyway with --no-verify");
      return 1;
    }
  }
  var files: StrList* = bx_pub_files(p);
  var manifest: string = bx_pub_manifest(p);
  var stage: string = p->state_dir + "/tmp/publish";
  sys_remove_tree(stage);
  var total: int64 = 0;
  i = 0;
  while (i < files->len) {
    var rel: string = sl_get(files, i);
    var src: string = p->root + "/" + rel;
    var dst: string = stage + "/" + rel;
    fs_mkdirs(p_dir(dst));
    if (s_eq(rel, "AGENT.rules")) {
      var rd: FsRead = fs_read(src);
      if (!rd.ok || !fs_write(dst, agt_strip_block(rd.data))) {
        fail("cannot stage " + rel);
      }
    } else if (!fs_copy(src, dst)) {
      fail("cannot stage " + rel);
    }
    total = total + sys_stat(dst).size;
    i = i + 1;
  }
  fs_write(p->state_dir + "/tmp/publish.list", sl_join(files, "\n") + "\n");
  var nfiles: string = s_int(files->len) + " files";
  if (files->len == 1) {
    nfiles = "1 file";
  }
  status("Packaging", name + " " + version + " (" + nfiles + ", " + bx_size_text(total) + ")");
  if (dry) {
    say("");
    say("files:");
    i = 0;
    while (i < files->len) {
      say("  " + sl_get(files, i));
      i = i + 1;
    }
    say("");
    say("manifest:");
    print(manifest);
    return 0;
  }
  var r: RegPublish* = new RegPublish;
  r->dir = dir;
  r->name = name;
  r->version = version;
  r->root = stage;
  r->files = files;
  r->manifest_text = manifest;
  r->dry_run = false;
  var err: string = reg_publish(r);
  free(r);
  if (slen(err) > 0) {
    fail(err);
  }
  var sha: string = sha_file(dir + "/pkg/" + name + "/" + name + "-" + version + ".tar.gz");
  if (slen(sha) > 8) {
    sha = s_sub(sha, 0, 8);
  }
  status("Published", name + " " + version + " to " + dir + " (sha256 " + sha + ")");
  if (!g_quiet) {
    say("  next: upload " + dir + " to the host that serves it");
  }
  return 0;
}

// mbuild yank NAME@VERSION --to DIR [--undo]
export fn build_cmd_yank(p: Project*) -> int32 {
  var to: string = bx_take_opt(p, "--to");
  var registry: string = bx_take_opt(p, "--registry");
  var undo: bool = bx_take_flag(p, "--undo");
  var args: StrList* = bx_positional(p->opts->rest);
  defer free(args);
  var at: int64 = -1;
  if (args->len == 1) {
    at = s_find_byte(sl_get(args, 0), 64);
  }
  if (at <= 0) {
    fail_hint("mbuild yank takes NAME@VERSION", "mbuild yank strutil@v1.1.1 --to DIR");
  }
  var arg: string = sl_get(args, 0);
  var name: string = s_sub(arg, 0, at);
  var version: string = s_from(arg, at + 1);
  if (!sv_is(version)) {
    fail("`" + version + "` is not a version (v1.2.3)");
  }
  version = sv_canonical(version);
  var dir: string = bx_registry_dir(p, to, registry);
  var err: string = reg_yank(dir, name, version, undo);
  if (slen(err) > 0) {
    fail(err);
  }
  if (undo) {
    status("Unyanked", name + " " + version + " in " + dir);
  } else {
    status("Yanked", name + " " + version + " in " + dir);
  }
  return 0;
}

// mbuild registry init DIR [--name NAME]
export fn build_cmd_registry(p: Project*) -> int32 {
  var name: string = bx_take_opt(p, "--name");
  var args: StrList* = bx_positional(p->opts->rest);
  defer free(args);
  if (args->len != 2 || !s_eq(sl_get(args, 0), "init")) {
    fail_hint("mbuild registry takes `init DIR`", "mbuild registry init DIR [--name NAME]");
  }
  var dir: string = bx_abs_dir(sl_get(args, 1));
  if (slen(name) == 0) {
    name = p_base(dir);
  }
  var err: string = reg_init_dir(dir, name);
  if (slen(err) > 0) {
    fail(err);
  }
  status("Created", "registry " + name + " in " + dir);
  return 0;
}
