  bx_fl("-t T", "one target (default: the host)");
  bx_fl("-p NAME", "the profile of both builds (default release)");
  bx_note("the steps by hand: mbuild build -r --pgo-gen; mbuild run -r --pgo-gen (records the profile); mbuild build -r --pgo-use (or --pgo-use=FILE).");
  bx_note("the profile is .mbuild/pgo/BIN-TARGET.prof. a Linux program writes it at exit (METTLE_PROFILE_OUT); a board prints it on its console and mbuild turns the capture into it with tools/riscv-pgo-capture.py of the compiler's Mettle checkout (python3).");
  bx_def("check", "type-check without linking", "mbuild check [BINS...] [-t T]", "project.md");
  bx_ex("mbuild check", "");
  bx_ex("mbuild check -t all", "");
  bx_note("in a library each top-level and src/ .mettle file is checked.");
  bx_def("clean", "remove build outputs", "mbuild clean [--all]", "incremental.md");
  bx_ex("mbuild clean", "build/ and .mbuild/{{cache,stamps,tmp}");
  bx_ex("mbuild clean --all", "all of .mbuild/ too");
  bx_group("dependencies");
  bx_def("search", "find packages in the registries", "mbuild search [TEXT]", "dependencies.md");
  bx_ex("mbuild search", "every package");
  bx_ex("mbuild search json", "by name, description or exported function");
  bx_fl("-q", "names only");
  bx_note("one block per package, sorted by name: `NAME VERSION  DESCRIPTION`, then `fns:` the exported function names of that version (`fns: unknown (why)` when its archive can't be read).");
  bx_note("VERSION is the newest that isn't yanked; the same name in two registries is shown for each, with `(registry NAME)`.");
  bx_note("TEXT matches the name, the description or a function name, in any case.");
  bx_note("to learn one package from a hit: `mbuild info NAME` gives its signatures, comments and README.");
  bx_note("with no compiler to read mbuild.mettle, the project's own registries are skipped (a note says so) and MBUILD_REGISTRY or the default is searched.");
  bx_def("info", "show a package: README, versions, dependencies and API", "mbuild info PKG[@VERSION] [--readme]", "dependencies.md");
  bx_ex("mbuild info hmac", "the newest version: description, README intro, versions, every function");
