// deps: the requirement graph, minimal version selection, mbuild.lock, the
// checkouts under .mbuild/deps and the managed mettle.deps block
// (DESIGN.md sections 6 and 9).
//
// deps_ensure has a fast path that starts no git command: when
// .mbuild/deps.stamp records the current lock (its hash) and the current
// requirements (a hash over mbuild.toml's and the path packages'
// [dependencies]), and every locked module's checkout holds its commit.
// Otherwise it resolves: it walks every requirement reachable from the root,
// reading each visited (module, version)'s mbuild.toml from the module's
// mirror, and selects per module the highest semantic version seen. The lock
// pins "latest", branches and tags to commits; only get/update move a pin.
//
// Every package gets its own managed mettle.deps block (the root, each
// checkout, each path package): the hosts plus that package's own aliases,
// so an alias is visible only to the package that declares it.

import "std/mem";
import "base";
import "path";
import "fs";
import "toml";
import "semver";
import "manifest";
import "project";
import "git";
import "scan";
import "api";
import "toolchain";
import "sys_linux" if linux;
import "sys_windows" if windows;

// ---------------------------------------------------------------------------
// Small containers
// ---------------------------------------------------------------------------

// One requirement: `from` requires module at spec.
struct DxReq {
  module: string;
  spec: string;
  url: string;
  from: string;      // "mbuild.toml", "github.com/a/b v1.0.0", "path package x"
  root: bool;        // stated by the root manifest itself
  label: string;     // the version it resolved to (tag, branch, commit as written)
  commit: string;    // the full commit
  fresh: bool;       // "latest" resolved now (not from the lock)
}

// One module of the graph and the versions of it that were visited.
struct DxMod {
  module: string;
  url: string;
  reqs: DxReqs*;
  labels: StrList*;     // visited versions
  commits: StrList*;    // parallel
  checked: StrList*;    // commits known to be in the mirror
  sel: int64;           // selected index into labels, -1 when nothing live requires it
  mans: DxMans*;        // the manifest of each visited version (parallel to labels)
  rep: ReplaceSpec*;    // its [replace] entry (version / url), 0 when none
  rep_req: DxReq*;      // the requirement the replacement stands for
}

// A [replace] { path = ... } module: a link to a local directory.
struct DxRPath {
  module: string;
  rel: string;
  dir: string;          // absolute, cleaned
  man: Manifest*;
  local: bool;          // from mbuild.local.toml
  reqs: DxReqs*;        // what required it (shown by `why`)
}

// A local { path = ... } package.
struct DxPath {
  key: string;
  module: string;
  rel: string;          // the path as written
  dir: string;          // absolute
  man: Manifest*;       // 0 when it has no mbuild.toml
}

struct DxLock {
  exists: bool;
  text: string;
  mods: StrList*;
  vers: StrList*;
  commits: StrList*;
  reqs: string;
}

struct DxCx {
  p: Project*;
  lock: DxLock*;
  unpin: StrList*;      // modules whose lock pins are ignored
  mods: DxMods*;
  paths: DxPaths*;
  queue: DxReqs*;
  reqs_hash: string;
  rpaths: DxRPaths*;
  hints: StrList*;      // "module line": `latest` resolves inside that line
  local_names: StrList*;  // modules replaced by mbuild.local.toml
  published: StrList*;  // names the root block of mettle.deps publishes
}

struct DxRPaths {
  items: DxRPath**;
  len: int64;
  cap: int64;
}

fn drp_new() -> DxRPaths* {
  var l: DxRPaths* = new DxRPaths;
  l->items = (DxRPath**)0;
  l->len = 0;
  l->cap = 0;
  return l;
}

fn drp_push(l: DxRPaths*, v: DxRPath*) {
  if (l->len >= l->cap) {
    var nc: int64 = l->cap * 2;
    if (nc < 8) { nc = 8; }
    l->items = (DxRPath**)realloc(l->items, nc * 8);
    l->cap = nc;
  }
  l->items[l->len] = v;
  l->len = l->len + 1;
}

// Typed pointer lists (the memory analyser follows typed stores).
struct DxReqs {
  items: DxReq**;
  len: int64;
  cap: int64;
}

fn drq_new() -> DxReqs* {
  var l: DxReqs* = new DxReqs;
  l->items = (DxReq**)0;
  l->len = 0;
  l->cap = 0;
  return l;
}

fn drq_push(l: DxReqs*, v: DxReq*) {
  if (l->len >= l->cap) {
    var nc: int64 = l->cap * 2;
    if (nc < 8) { nc = 8; }
    l->items = (DxReq**)realloc(l->items, nc * 8);
    l->cap = nc;
  }
  l->items[l->len] = v;
  l->len = l->len + 1;
}

struct DxMods {
  items: DxMod**;
  len: int64;
  cap: int64;
}

fn dmo_new() -> DxMods* {
  var l: DxMods* = new DxMods;
  l->items = (DxMod**)0;
  l->len = 0;
  l->cap = 0;
  return l;
}

fn dmo_push(l: DxMods*, v: DxMod*) {
  if (l->len >= l->cap) {
    var nc: int64 = l->cap * 2;
    if (nc < 8) { nc = 8; }
    l->items = (DxMod**)realloc(l->items, nc * 8);
    l->cap = nc;
  }
  l->items[l->len] = v;
  l->len = l->len + 1;
}

struct DxPaths {
  items: DxPath**;
  len: int64;
  cap: int64;
}

fn dpa_new() -> DxPaths* {
  var l: DxPaths* = new DxPaths;
  l->items = (DxPath**)0;
  l->len = 0;
  l->cap = 0;
  return l;
}

fn dpa_push(l: DxPaths*, v: DxPath*) {
  if (l->len >= l->cap) {
    var nc: int64 = l->cap * 2;
    if (nc < 8) { nc = 8; }
    l->items = (DxPath**)realloc(l->items, nc * 8);
    l->cap = nc;
  }
  l->items[l->len] = v;
  l->len = l->len + 1;
}

struct DxMans {
  items: Manifest**;
  len: int64;
  cap: int64;
}

fn dma_new() -> DxMans* {
  var l: DxMans* = new DxMans;
  l->items = (Manifest**)0;
  l->len = 0;
  l->cap = 0;
  return l;
}

fn dma_push(l: DxMans*, v: Manifest*) {
  if (l->len >= l->cap) {
    var nc: int64 = l->cap * 2;
    if (nc < 8) { nc = 8; }
    l->items = (Manifest**)realloc(l->items, nc * 8);
    l->cap = nc;
  }
  l->items[l->len] = v;
  l->len = l->len + 1;
}

// Messages already printed ("module version"), and modules fetched by this
// process, as newline-framed sets.
var g_dx_said: string;
var g_dx_fetched: string;
var g_dx_forced: string;

// mbuild update: refresh the mirror of every unpinned module.
var g_dx_refresh: bool = false;
// mbuild update --all: dx_ensure stops before changing anything when a
// module the root does not require has a newer tag in its major version,
// and lists those (module, version) here instead.
var g_dx_raise_all: bool = false;
var g_dx_raise_mods: StrList* = 0;
var g_dx_raise_vers: StrList* = 0;

// A snapshot of mbuild.toml / mbuild.lock / .mbuild/local.lock taken by the
// commands that edit them: an error that stops the process writes it back.
var g_dx_guard: DepSnap* = 0;
// URLs of submodule mirrors fetched by this process (git_checkout_tree).
var g_dx_sub_fetched: StrList* = 0;
var g_dx_net_warned: bool = false;
var g_dx_net_down: bool = false;
var g_dx_local_noted: bool = false;
var g_dx_md_checked: bool = false;

fn dx_snap_take(p: Project*) -> DepSnap* {
  var s: DepSnap* = new DepSnap;
  s->files = sl_new();
  s->texts = sl_new();
  s->present = sl_new();
  sl_push(s->files, p->root + "/mbuild.toml");
  sl_push(s->files, p->root + "/mbuild.lock");
  sl_push(s->files, p->state_dir + "/local.lock");
  var i: int64 = 0;
  while (i < s->files->len) {
    var r: FsRead = fs_read(sl_get(s->files, i));
    if (r.ok) {
      sl_push(s->texts, r.data);
      sl_push(s->present, "1");
    } else {
      sl_push(s->texts, s_empty());
      sl_push(s->present, "0");
    }
    i = i + 1;
  }
  return s;
}

// Writes the snapshot back; true when a file changed.
fn dx_snap_write(s: DepSnap*) -> bool {
  var changed: bool = false;
  var i: int64 = 0;
  while (i < s->files->len) {
    var file: string = sl_get(s->files, i);
    var r: FsRead = fs_read(file);
    if (s_eq(sl_get(s->present, i), "1")) {
      if (!r.ok || !s_eq(r.data, sl_get(s->texts, i))) {
        fs_write(file, sl_get(s->texts, i));
        changed = true;
      }
    } else if (r.ok) {
      sys_remove_file(file);
      changed = true;
    }
    i = i + 1;
  }
  return changed;
}

fn dx_arm(p: Project*) {
  if (g_dx_guard == (DepSnap*)0) {
    g_dx_guard = dx_snap_take(p);
  }
}

fn dx_disarm() {
  g_dx_guard = (DepSnap*)0;
}

fn dx_guard_restore() {
  if (g_dx_guard == (DepSnap*)0) {
    return;
  }
  var s: DepSnap* = g_dx_guard;
  g_dx_guard = (DepSnap*)0;
  if (dx_snap_write(s)) {
    sys_remove_file(p_dir(sl_get(s->files, 2)) + "/deps.stamp");
    err_line("  Restored mbuild.toml and mbuild.lock");
  }
}

fn dx_fail(msg: string) {
  error_msg(msg);
  dx_guard_restore();
  exit_with(1);
}

fn dx_fail_hint(msg: string, hint: string) {
  error_msg(msg);
  err_line("  " + cyan("help") + ": " + hint);
  dx_guard_restore();
  exit_with(1);
}

fn dx_help(hint: string) {
  err_line("  " + cyan("help") + ": " + hint);
}

fn dx_set_has(set: string, item: string) -> bool {
  return s_contains("\n" + set, "\n" + item + "\n");
}

fn dx_announce(verb: string, module: string, version_text: string, key: string) {
  if (dx_set_has(g_dx_said, module + " " + key)) {
    return;
  }
  g_dx_said = g_dx_said + module + " " + key + "\n";
  status(verb, module + " " + version_text);
}

// ---------------------------------------------------------------------------
// Paths and files
// ---------------------------------------------------------------------------

fn dx_deps_dir(p: Project*) -> string {
  return p->state_dir + "/deps";
}

fn dx_lock_path(p: Project*) -> string {
  return p->root + "/mbuild.lock";
}

fn dx_stamp_path(p: Project*) -> string {
  return p->state_dir + "/deps.stamp";
}

fn dx_manifest_path(p: Project*) -> string {
  return p->root + "/mbuild.toml";
}

// target relative to base ("./x", "../x"), or target when on another drive.
fn dx_rel(base: string, target: string) -> string {
  var b: string = p_clean(base);
  var t: string = p_clean(target);
  if (p_has_prefix_dir(t, b)) {
    var inside: string = p_rel(b, t);
    if (s_eq(inside, ".")) {
      return ".";
    }
    return "./" + inside;
  }
  var bp: StrList* = s_split(b, 47);
  var tp: StrList* = s_split(t, 47);
  if (bp->len == 0 || tp->len == 0 || !s_eq(s_lower(sl_get(bp, 0)), s_lower(sl_get(tp, 0)))) {
    free(bp);
    free(tp);
    return t;
  }
  var common: int64 = 0;
  while (common < bp->len && common < tp->len && s_eq(sl_get(bp, common), sl_get(tp, common))) {
    common = common + 1;
  }
  var parts: StrList* = sl_new();
  var i: int64 = common;
  while (i < bp->len) {
    if (slen(sl_get(bp, i)) > 0) {
      sl_push(parts, "..");
    }
    i = i + 1;
  }
  i = common;
  while (i < tp->len) {
    sl_push(parts, sl_get(tp, i));
    i = i + 1;
  }
  var joined: string = sl_join(parts, "/");
  free(bp);
  free(tp);
  free(parts);
  return joined;
}

fn dx_parse_manifest(text: string, dir: string, label: string) -> Manifest* {
  var doc: Toml* = toml_parse(text, label);
  var m: Manifest* = man_parse(doc, dir);
  if (slen(m->error) > 0) {
    warn(m->error);
  }
  return m;
}

// The mbuild.toml in dir, 0 when there is none.
fn dx_read_manifest(dir: string) -> Manifest* {
  var r: FsRead = fs_read(dir + "/mbuild.toml");
  if (!r.ok) {
    return (Manifest*)0;
  }
  return dx_parse_manifest(r.data, dir, dir + "/mbuild.toml");
}

// ---------------------------------------------------------------------------
// The lock
// ---------------------------------------------------------------------------

fn dx_local_lock_path(p: Project*) -> string {
  return p->state_dir + "/local.lock";
}

fn dx_is_marker(t: string) -> bool {
  return s_starts(t, "<<<<<<<") || s_starts(t, "=======") || s_starts(t, ">>>>>>>") || s_starts(t, "|||||||");
}

// The lock this command reads: .mbuild/local.lock while mbuild.local.toml
// replaces modules (when it exists), else mbuild.lock. A lock with merge
// conflict markers is repaired: every module line of both sides, the higher
// version of a module listed twice, and a stale requirements line.
fn dx_lock_read_file(p: Project*, file: string) -> DxLock* {
  var l: DxLock* = new DxLock;
  l->exists = false;
  l->text = s_empty();
  l->mods = sl_new();
  l->vers = sl_new();
  l->commits = sl_new();
  l->reqs = s_empty();
  var r: FsRead = fs_read(file);
  if (!r.ok) {
    return l;
  }
  l->exists = true;
  l->text = r.data;
  var lines: StrList* = s_lines(r.data);
  var conflicted: bool = false;
  var i: int64 = 0;
  while (i < lines->len) {
    if (dx_is_marker(sl_get(lines, i))) {
      conflicted = true;
    }
    i = i + 1;
  }
  if (conflicted) {
    if (p->opts->locked) {
      dx_fail_hint(p_base(file) + " has merge conflict markers", "run any mbuild command without --locked to repair it, then commit");
    }
    if (!dx_set_has(g_dx_said, "repaired " + file)) {
      g_dx_said = g_dx_said + "repaired " + file + "\n";
      status("Repaired", "merge conflict in " + p_base(file));
    }
  }
  var base_side: bool = false;
  i = 0;
  while (i < lines->len) {
    var t: string = s_trim(sl_get(lines, i));
    i = i + 1;
    if (s_starts(t, "|||||||")) {
      base_side = true;
      continue;
    }
    if (s_starts(t, "=======") || s_starts(t, "<<<<<<<") || s_starts(t, ">>>>>>>")) {
      base_side = false;
      continue;
    }
    if (base_side) {
      continue;
    }
    if (s_starts(t, "# requirements ")) {
      if (!conflicted) {
        l->reqs = s_trim(s_from(t, slen("# requirements ")));
      }
    } else if (slen(t) > 0 && !s_starts(t, "#")) {
      var f: StrList* = s_fields(t);
      if (f->len >= 3) {
        var at: int64 = sl_index(l->mods, sl_get(f, 0));
        if (at < 0) {
          sl_push(l->mods, sl_get(f, 0));
          sl_push(l->vers, sl_get(f, 1));
          sl_push(l->commits, s_lower(sl_get(f, 2)));
        } else if (sv_is(sl_get(f, 1)) && sv_is(sl_get(l->vers, at)) && sv_cmp(sl_get(f, 1), sl_get(l->vers, at)) > 0) {
          sl_set(l->vers, at, sl_get(f, 1));
          sl_set(l->commits, at, s_lower(sl_get(f, 2)));
        }
      }
      free(f);
    }
  }
  free(lines);
  return l;
}

fn dx_lock_read(p: Project*) -> DxLock* {
  if (dx_local_replaced(p)->len > 0 && fs_is_file(dx_local_lock_path(p))) {
    return dx_lock_read_file(p, dx_local_lock_path(p));
  }
  return dx_lock_read_file(p, dx_lock_path(p));
}

// mbuild.local.toml, merged into p->man once (build may have done it).
fn dx_load_local(p: Project*) {
  if (p->man->local != (Manifest*)0) {
    return;
  }
  var file: string = p->root + "/mbuild.local.toml";
  var r: FsRead = fs_read(file);
  if (!r.ok) {
    return;
  }
  var lm: Manifest* = man_parse_local(toml_parse(r.data, file), p->root);
  if (slen(lm->error) > 0) {
    dx_fail(lm->error);
  }
  man_merge_local(p->man, lm);
}

// The modules mbuild.local.toml replaces.
fn dx_local_replaced(p: Project*) -> StrList* {
  dx_load_local(p);
  var names: StrList* = sl_new();
  var i: int64 = 0;
  while (i < p->man->nreplaces) {
    if (p->man->replaces[i].local) {
      sl_add_uniq(names, p->man->replaces[i].module);
    }
    i = i + 1;
  }
  return names;
}

struct DxLockArgs {
  mods: StrList*;
  vers: StrList*;
  commits: StrList*;
  reqs: string;
}

fn dx_lock_render(a: DxLockArgs*) -> string {
  var order: StrList* = sl_copy(a->mods);
  sl_sort(order);
  var b: Buf* = buf_new();
  buf_line(b, "# mbuild.lock: generated by mbuild. Commit it.");
  buf_line(b, "# requirements " + a->reqs);
  buf_line(b, "# module version commit");
  var i: int64 = 0;
  while (i < order->len) {
    var at: int64 = sl_index(a->mods, sl_get(order, i));
    buf_line(b, sl_get(a->mods, at) + " " + sl_get(a->vers, at) + " " + sl_get(a->commits, at));
    i = i + 1;
  }
  free(order);
  return buf_take(b);
}

fn dx_short(commit: string) -> string {
  return s_sub(commit, 0, 7);
}

// Announces what changes between two locks.
fn dx_lock_diff(old: DxLock*, a: DxLockArgs*) {
  var i: int64 = 0;
  while (i < a->mods->len) {
    var m: string = sl_get(a->mods, i);
    var v: string = sl_get(a->vers, i);
    var c: string = sl_get(a->commits, i);
    var at: int64 = sl_index(old->mods, m);
    if (at < 0) {
      dx_announce("Adding", m, v, v);
    } else if (!s_eq(sl_get(old->vers, at), v)) {
      dx_announce("Updating", m, sl_get(old->vers, at) + " -> " + v, v);
    } else if (!s_eq(sl_get(old->commits, at), c)) {
      var how: string = "";
      if (sv_is(v)) {
        how = "tag moved upstream: ";
      }
      dx_announce("Updating", m, v + " (" + how + dx_short(sl_get(old->commits, at)) + " -> " + dx_short(c) + ")", v + "@" + c);
    }
    i = i + 1;
  }
  i = 0;
  while (i < old->mods->len) {
    var om: string = sl_get(old->mods, i);
    if (!sl_has(a->mods, om)) {
      dx_announce("Removing", om, sl_get(old->vers, i), "-");
    }
    i = i + 1;
  }
}

// ---------------------------------------------------------------------------
// Context, path packages, requirement hash
// ---------------------------------------------------------------------------

fn dx_cx_new(p: Project*) -> DxCx* {
  var cx: DxCx* = new DxCx;
  cx->p = p;
  cx->local_names = dx_local_replaced(p);
  cx->rpaths = drp_new();
  cx->hints = sl_new();
  cx->published = sl_new();
  cx->lock = dx_lock_read(p);
  cx->unpin = sl_new();
  cx->mods = dmo_new();
  cx->paths = dpa_new();
  cx->queue = drq_new();
  cx->reqs_hash = s_empty();
  return cx;
}

fn dx_path_at(cx: DxCx*, i: int64) -> DxPath* {
  return cx->paths->items[i];
}

fn dx_mod_at(cx: DxCx*, i: int64) -> DxMod* {
  return cx->mods->items[i];
}

fn dx_req_at(l: DxReqs*, i: int64) -> DxReq* {
  return l->items[i];
}

// Every local path package reachable from the root (nested ones relative to
// the package that names them).
fn dx_collect_paths(cx: DxCx*) {
  var mans: DxMans* = dma_new();
  dma_push(mans, cx->p->man);
  var mi: int64 = 0;
  while (mi < mans->len) {
    var m: Manifest* = mans->items[mi];
    var i: int64 = 0;
    while (i < m->ndeps) {
      var d: DepSpec* = man_dep(m, i);
      if (slen(d->path) > 0) {
        var dir: string = p_clean(p_join(m->dir, d->path));
        var seen: bool = false;
        var k: int64 = 0;
        while (k < cx->paths->len) {
          if (s_eq(dx_path_at(cx, k)->dir, dir)) {
            seen = true;
          }
          k = k + 1;
        }
        if (!seen) {
          var pp: DxPath* = new DxPath;
          pp->key = d->key;
          pp->module = d->module;
          pp->rel = d->path;
          pp->dir = dir;
          pp->man = dx_read_manifest(dir);
          if (!fs_is_dir(dir)) {
            dx_fail_hint("path dependency '" + d->key + "' points at " + dir + ", which does not exist", "fix `path` in " + m->dir + "/mbuild.toml");
          }
          dpa_push(cx->paths, pp);
          if (pp->man != (Manifest*)0) {
            dma_push(mans, pp->man);
          }
        }
      }
      i = i + 1;
    }
    mi = mi + 1;
  }
  free(mans->items);
  free(mans);
  dx_collect_rpaths(cx);
}

// The root's [replace] { path = ... } entries (mbuild.local.toml's first).
fn dx_collect_rpaths(cx: DxCx*) {
  var m: Manifest* = cx->p->man;
  var i: int64 = 0;
  while (i < m->nreplaces) {
    var rs: ReplaceSpec* = &m->replaces[i];
    i = i + 1;
    if (slen(rs->path) == 0 || man_replace_find(m, rs->module) != rs) {
      continue;
    }
    var dir: string = p_clean(p_join(cx->p->root, rs->path));
    if (!fs_is_dir(dir)) {
      var src: string = "mbuild.toml";
      if (rs->local) {
        src = "mbuild.local.toml";
      }
      dx_fail_hint("[replace] " + rs->module + ": " + rs->path + " does not exist", "fix the path in " + src + ", or remove the replacement");
    }
    var rp: DxRPath* = new DxRPath;
    rp->module = rs->module;
    rp->rel = rs->path;
    rp->dir = dir;
    rp->man = dx_read_manifest(dir);
    rp->local = rs->local;
    rp->reqs = drq_new();
    drp_push(cx->rpaths, rp);
  }
}

fn dx_rpath_find(cx: DxCx*, module: string) -> DxRPath* {
  var i: int64 = 0;
  while (i < cx->rpaths->len) {
    if (s_eq(cx->rpaths->items[i]->module, module)) {
      return cx->rpaths->items[i];
    }
    i = i + 1;
  }
  return (DxRPath*)0;
}

fn dx_hash_manifest(h: Hasher*, m: Manifest*) {
  h_str(h, m->module);
  var i: int64 = 0;
  while (i < m->ndeps) {
    var d: DepSpec* = man_dep(m, i);
    h_str(h, d->key);
    h_str(h, d->module);
    h_str(h, d->version);
    h_str(h, d->path);
    h_str(h, d->url);
    // Round-2 inputs join only when present, so existing hashes stay.
    if (slen(d->subs_mode) > 0) {
      h_str(h, "submodules " + d->subs_mode);
      if (d->subs != (StrList*)0) {
        h_str(h, sl_join(d->subs, ","));
      }
    }
    i = i + 1;
  }
}

fn dx_hash_subs(h: Hasher*, m: Manifest*) {
  if (slen(m->subs_mode) > 0 && !s_eq(m->subs_mode, "all")) {
    h_str(h, "package submodules " + m->subs_mode);
    if (m->subs != (StrList*)0) {
      h_str(h, sl_join(m->subs, ","));
    }
  }
}

fn dx_hash_replace(h: Hasher*, rs: ReplaceSpec*) {
  h_str(h, "replace");
  h_str(h, rs->module);
  h_str(h, rs->path);
  h_str(h, rs->url);
  h_str(h, rs->version);
}

fn dx_compute_reqs_hash(cx: DxCx*) -> string {
  var h: Hasher = h_new();
  h_str(&h, "mbuild-requirements-1");
  dx_hash_manifest(&h, cx->p->man);
  var i: int64 = 0;
  while (i < cx->paths->len) {
    var pp: DxPath* = dx_path_at(cx, i);
    h_str(&h, "path");
    h_str(&h, pp->key);
    h_str(&h, pp->rel);
    if (pp->man != (Manifest*)0) {
      dx_hash_manifest(&h, pp->man);
      dx_hash_subs(&h, pp->man);
    }
    i = i + 1;
  }
  var m: Manifest* = cx->p->man;
  i = 0;
  while (i < m->nreplaces) {
    if (!m->replaces[i].local) {
      dx_hash_replace(&h, &m->replaces[i]);
    }
    i = i + 1;
  }
  return h_hex(&h);
}

// The stamp's view of mbuild.local.toml's replacements.
fn dx_local_hash(p: Project*) -> string {
  var h: Hasher = h_new();
  var any: bool = false;
  var i: int64 = 0;
  while (i < p->man->nreplaces) {
    if (p->man->replaces[i].local) {
      dx_hash_replace(&h, &p->man->replaces[i]);
      any = true;
    }
    i = i + 1;
  }
  if (!any) {
    return "-";
  }
  return h_hex(&h);
}

// The root's own module, or a path package's: never fetched.
fn dx_is_local_module(cx: DxCx*, module: string) -> bool {
  if (slen(cx->p->man->module) > 0 && s_eq(cx->p->man->module, module)) {
    return true;
  }
  if (dx_rpath_find(cx, module) != (DxRPath*)0) {
    return true;
  }
  var i: int64 = 0;
  while (i < cx->paths->len) {
    var pp: DxPath* = dx_path_at(cx, i);
    if (s_eq(pp->module, module)) {
      return true;
    }
    if (pp->man != (Manifest*)0 && s_eq(pp->man->module, module)) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

fn dx_mod_find(cx: DxCx*, module: string) -> DxMod* {
  var i: int64 = 0;
  while (i < cx->mods->len) {
    var m: DxMod* = dx_mod_at(cx, i);
    if (s_eq(m->module, module)) {
      return m;
    }
    i = i + 1;
  }
  return (DxMod*)0;
}

fn dx_mod_get(cx: DxCx*, module: string, req_url: string) -> DxMod* {
  var m: DxMod* = dx_mod_find(cx, module);
  if (m == (DxMod*)0) {
    m = new DxMod;
    m->module = module;
    m->url = req_url;
    m->reqs = drq_new();
    m->labels = sl_new();
    m->commits = sl_new();
    m->checked = sl_new();
    m->sel = -1;
    m->mans = dma_new();
    m->rep = (ReplaceSpec*)0;
    m->rep_req = (DxReq*)0;
    dmo_push(cx->mods, m);
  }
  return m;
}

// ---------------------------------------------------------------------------
// Mirrors and versions
// ---------------------------------------------------------------------------

// The mirror this module is fetched into (keyed by its URL).
fn dx_mdir(m: DxMod*) -> string {
  return git_mirror_dir(m->module, m->url);
}

fn dx_offline(cx: DxCx*) -> bool {
  return cx->p->opts->offline;
}

fn dx_first_from(m: DxMod*) -> string {
  if (m->reqs->len > 0) {
    return dx_req_at(m->reqs, 0)->from;
  }
  return "mbuild.toml";
}

// What a failed git command ran into (git_failure_kind, plus git's words
// for a local repository that is not there).
fn dx_failure_kind(output: string) -> string {
  var kind: string = git_failure_kind(output);
  if (s_eq(kind, "other") && s_contains(output, "does not appear to be a git repository")) {
    return "gone";
  }
  return kind;
}

// The part of git's output that says what went wrong, for "(git: ...)".
fn dx_git_reason(output: string) -> string {
  var needles: StrList* = sl_of("Could not resolve host");
  sl_push(needles, "Failed to connect");
  sl_push(needles, "Connection timed out");
  sl_push(needles, "Network is unreachable");
  sl_push(needles, "Connection refused");
  sl_push(needles, "Temporary failure in name resolution");
  sl_push(needles, "Repository not found");
  sl_push(needles, "Authentication failed");
  sl_push(needles, "could not read Username");
  sl_push(needles, "Permission denied (publickey)");
  sl_push(needles, "terminal prompts disabled");
  var reason: string = "";
  var i: int64 = 0;
  while (i < needles->len && slen(reason) == 0) {
    var at: int64 = s_find(output, sl_get(needles, i));
    if (at >= 0) {
      var rest: string = s_from(output, at);
      var nl: int64 = s_find_byte(rest, 10);
      if (nl >= 0) {
        rest = s_sub(rest, 0, nl);
      }
      reason = s_trim(rest);
      while (s_ends(reason, ".")) {
        reason = s_sub(reason, 0, slen(reason) - 1);
      }
    }
    i = i + 1;
  }
  free(needles);
  if (slen(reason) == 0) {
    var sum: string = git_summary(output);
    var nl2: int64 = s_find_byte(sum, 10);
    if (nl2 >= 0) {
      sum = s_sub(sum, 0, nl2);
    }
    reason = s_trim(sum);
    if (s_starts(reason, "fatal: ")) {
      reason = s_from(reason, 7);
    }
  }
  return reason;
}

fn dx_fork_help(module: string) -> string {
  return "replace it with a fork ([replace] \"" + module + "\" = {{ url = \"...\" }) or vendor it (mbuild vendor)";
}

// Module paths mbuild knows: (module, where) pairs for typo suggestions.
fn dx_known_modules(cx: DxCx*, mods: StrList*, wheres: StrList*) {
  var i: int64 = 0;
  while (i < cx->p->man->ndeps) {
    var d: DepSpec* = man_dep(cx->p->man, i);
    if (slen(d->module) > 0 && !sl_has(mods, d->module)) {
      sl_push(mods, d->module);
      sl_push(wheres, "in mbuild.toml");
    }
    i = i + 1;
  }
  i = 0;
  while (i < cx->lock->mods->len) {
    if (!sl_has(mods, sl_get(cx->lock->mods, i))) {
      sl_push(mods, sl_get(cx->lock->mods, i));
      sl_push(wheres, "in mbuild.lock");
    }
    i = i + 1;
  }
  i = 0;
  while (i < cx->mods->len) {
    if (!sl_has(mods, dx_mod_at(cx, i)->module)) {
      sl_push(mods, dx_mod_at(cx, i)->module);
      sl_push(wheres, "in the dependency graph");
    }
    i = i + 1;
  }
  // Mirrors: $MBUILD_HOME/git/<host>/<owner>/<repo>[@hash].git
  var gdir: string = fs_mbuild_home() + "/git";
  var hf: StrList* = sl_new();
  var hosts: StrList* = sl_new();
  if (sys_list_dir(gdir, hf, hosts)) {
    var a: int64 = 0;
    while (a < hosts->len) {
      var host: string = sl_get(hosts, a);
      a = a + 1;
      if (s_eq(host, "sub") || s_eq(host, "tmp")) {
        continue;
      }
      var of: StrList* = sl_new();
      var owners: StrList* = sl_new();
      if (sys_list_dir(gdir + "/" + host, of, owners)) {
        var b: int64 = 0;
        while (b < owners->len) {
          var rf: StrList* = sl_new();
          var repos: StrList* = sl_new();
          if (sys_list_dir(gdir + "/" + host + "/" + sl_get(owners, b), rf, repos)) {
            var c: int64 = 0;
            while (c < repos->len) {
              var repo: string = sl_get(repos, c);
              c = c + 1;
              if (!s_ends(repo, ".git")) {
                continue;
              }
              repo = s_sub(repo, 0, slen(repo) - 4);
              var at: int64 = s_find_byte(repo, 64);
              if (at >= 0) {
                repo = s_sub(repo, 0, at);
              }
              var mod: string = host + "/" + sl_get(owners, b) + "/" + repo;
              if (!sl_has(mods, mod)) {
                sl_push(mods, mod);
                sl_push(wheres, "downloaded before");
              }
            }
          }
          free(rf);
          free(repos);
          b = b + 1;
        }
      }
      free(of);
      free(owners);
    }
  }
  free(hf);
  free(hosts);
}

fn dx_after_first_slash(s: string) -> string {
  var at: int64 = s_find_byte(s, 47);
  if (at < 0) {
    return s;
  }
  return s_from(s, at + 1);
}

// "did you mean github.com/demo/strutil? (in mbuild.lock)", or "".
fn dx_suggest_module(cx: DxCx*, module: string) -> string {
  var mods: StrList* = sl_new();
  var wheres: StrList* = sl_new();
  dx_known_modules(cx, mods, wheres);
  var best: int64 = -1;
  var i: int64 = 0;
  while (i < mods->len && best < 0) {
    var c: string = sl_get(mods, i);
    if (!s_eq(c, module) && s_eq(s_lower(c), s_lower(module))) {
      best = i;
    }
    i = i + 1;
  }
  if (best < 0) {
    var best_d: int64 = 4;
    i = 0;
    while (i < mods->len) {
      var c2: string = sl_get(mods, i);
      var d: int64 = man_edit_distance(module, c2);
      if (d > 0 && d < best_d) {
        best_d = d;
        best = i;
      }
      i = i + 1;
    }
  }
  if (best < 0) {
    var tail: string = dx_after_first_slash(module);
    var leaf: string = p_base(module);
    i = 0;
    while (i < mods->len && best < 0) {
      var c3: string = sl_get(mods, i);
      if (!s_eq(c3, module) && (s_eq(dx_after_first_slash(c3), tail) || s_eq(p_base(c3), leaf))) {
        best = i;
      }
      i = i + 1;
    }
  }
  var said: string = "";
  if (best >= 0) {
    said = "did you mean " + sl_get(mods, best) + "? (" + sl_get(wheres, best) + ")";
  }
  free(mods);
  free(wheres);
  return said;
}

fn dx_fail_repo(cx: DxCx*, m: DxMod*, output: string) {
  var u: string = git_url(m->module, m->url);
  var kind: string = dx_failure_kind(output);
  var gitlines: string = "\n  git: " + s_replace(git_summary(output), "\n", "\n  git: ");
  if (s_eq(kind, "network")) {
    dx_fail_hint("cannot download " + m->module + " (required by " + dx_first_from(m) + "): the network is unavailable\n  git: " + dx_git_reason(output), "connect and retry; builds of already-fetched dependencies work with --offline");
  }
  var hint: string = "";
  if (slen(m->url) > 0) {
    hint = "the requirement sets url = " + toml_quote(m->url) + "; check that this repository exists and can be read without a password";
  } else if (slen(env_get("MBUILD_GIT_BASE")) > 0) {
    hint = "MBUILD_GIT_BASE=" + env_get("MBUILD_GIT_BASE") + " is set, so mbuild looked for the repository at " + u + "; unset it, or add the repository there";
  } else {
    hint = "check the module path; for a repository elsewhere write " + toml_quote(m->module) + " = {{ version = \"...\", url = \"https://host/repo.git\" } in [dependencies], or set MBUILD_GIT_BASE to a directory or URL holding <module> repositories";
  }
  error_msg("cannot download " + m->module + " (required by " + dx_first_from(m) + ") from " + u + gitlines);
  if (s_eq(kind, "gone") || (s_eq(kind, "auth") && s_starts(m->module, "github.com/"))) {
    var sug: string = dx_suggest_module(cx, m->module);
    if (slen(sug) > 0) {
      dx_help(sug);
    }
  }
  dx_help(hint);
  if (sl_has(cx->lock->mods, m->module)) {
    dx_help(dx_fork_help(m->module));
  }
  dx_guard_restore();
  exit_with(1);
}

fn dx_fetch(cx: DxCx*, m: DxMod*) {
  status("Fetching", m->module);
  var r: Captured = git_fetch(m->module, m->url);
  g_dx_fetched = g_dx_fetched + dx_mdir(m) + "\n";
  if (r.code == 0) {
    return;
  }
  var kind: string = dx_failure_kind(r.out);
  var u: string = git_url(m->module, m->url);
  if (s_eq(kind, "network")) {
    g_dx_net_down = true;
    var msg: string = "network unavailable (git: " + dx_git_reason(r.out) + "); using the cached mirror of " + m->module;
    if (g_dx_net_warned) {
      verbose(msg);
    } else {
      g_dx_net_warned = true;
      warn(msg);
    }
  } else if (s_eq(kind, "gone") || s_eq(kind, "auth")) {
    warn(m->module + " is no longer available from " + u + " (git: " + dx_git_reason(r.out) + "); building from the cached mirror");
    dx_help(dx_fork_help(m->module));
  } else {
    warn("could not update the mirror of " + m->module + " from " + u + "; using what it has\n  git: " + git_summary(r.out));
  }
}

fn dx_can_fetch(cx: DxCx*, m: DxMod*) -> bool {
  return !dx_offline(cx) && !dx_set_has(g_dx_fetched, dx_mdir(m));
}

// Makes sure the mirror exists; with fresh, also brings it up to date once
// per run (unless --offline).
fn dx_mirror(cx: DxCx*, m: DxMod*, fresh: bool) {
  if (!git_has_mirror(dx_mdir(m))) {
    if (dx_offline(cx)) {
      dx_fail_hint(m->module + " (required by " + dx_first_from(m) + ") is not downloaded and --offline forbids fetching it", "run `mbuild fetch` once while online, or drop --offline");
    }
    status("Fetching", m->module);
    var r: Captured = git_clone_mirror(m->module, m->url);
    if (r.code != 0) {
      dx_fail_repo(cx, m, r.out);
    }
    g_dx_fetched = g_dx_fetched + dx_mdir(m) + "\n";
    return;
  }
  if (fresh && dx_can_fetch(cx, m)) {
    dx_fetch(cx, m);
  }
}

fn dx_offline_hint(cx: DxCx*) -> string {
  if (dx_offline(cx)) {
    return " (--offline: the mirror was not updated; run `mbuild fetch` online first)";
  }
  if (g_dx_net_down) {
    return " (the network is unavailable, so the cached mirror was used; run with --offline to skip network attempts)";
  }
  return "";
}

// Makes sure commit is in the mirror: a ref fetch, then a fetch of the commit
// itself (a commit no ref reaches any more).
fn dx_need_commit(cx: DxCx*, m: DxMod*, commit: string, label: string) {
  dx_mirror(cx, m, false);
  if (sl_has(m->checked, commit)) {
    return;
  }
  if (slen(git_rev(dx_mdir(m), commit)) == 0) {
    if (dx_can_fetch(cx, m)) {
      dx_fetch(cx, m);
    }
    if (slen(git_rev(dx_mdir(m), commit)) == 0 && !dx_offline(cx)) {
      var fc: Captured = git_fetch_commit(dx_mdir(m), commit);
      if (fc.code != 0) {
        verbose("git fetch origin " + commit + " failed: " + git_summary(fc.out));
      }
    }
    if (slen(git_rev(dx_mdir(m), commit)) == 0) {
      if (dx_offline(cx)) {
        dx_fail_hint("commit " + commit + " of " + m->module + " (pinned in mbuild.lock) is not in the repository at " + git_url(m->module, m->url) + dx_offline_hint(cx), "run `mbuild update " + m->module + "` to pin a commit that exists");
      }
      dx_fail_hint("commit " + dx_short(commit) + " of " + m->module + " (pinned in mbuild.lock as " + label + ") is no longer in " + git_url(m->module, m->url) + "\n  the tag was moved or the history was rewritten upstream, and no mirror on this machine has it", "run `mbuild update " + m->module + "` to pin what the repository has now (review the change), or vendor dependencies (`mbuild vendor`) to keep exact copies");
    }
  }
  sl_push(m->checked, commit);
}

// Tags that are semantic versions, sorted by precedence (lowest first).
fn dx_semver_tags(tags: StrList*) -> StrList* {
  var vs: StrList* = sl_new();
  var i: int64 = 0;
  while (i < tags->len) {
    if (sv_is(sl_get(tags, i))) {
      sl_push(vs, sl_get(tags, i));
    }
    i = i + 1;
  }
  var a: int64 = 1;
  while (a < vs->len) {
    var cur: string = sl_get(vs, a);
    var j: int64 = a - 1;
    while (j >= 0 && sv_cmp(sl_get(vs, j), cur) > 0) {
      sl_set(vs, j + 1, sl_get(vs, j));
      j = j - 1;
    }
    sl_set(vs, j + 1, cur);
    a = a + 1;
  }
  return vs;
}

// "available versions: v1.0.0, v1.1.0; branches: main" for error messages.
fn dx_available(mirror: string) -> string {
  var tags: StrList* = git_tags(mirror);
  var vs: StrList* = dx_semver_tags(tags);
  var branches: StrList* = git_branches(mirror);
  var b: string = "";
  if (vs->len > 0) {
    b = "available versions: " + sl_join(vs, ", ");
  } else {
    b = "the repository has no version tags";
  }
  free(vs);
  if (branches->len > 0) {
    b = b + "; branches: " + sl_join(branches, ", ");
  }
  var other: StrList* = sl_new();
  var i: int64 = 0;
  while (i < tags->len) {
    if (!sv_is(sl_get(tags, i))) {
      sl_push(other, sl_get(tags, i));
    }
    i = i + 1;
  }
  if (other->len > 0) {
    b = b + "; other tags: " + sl_join(other, ", ");
  }
  free(other);
  return b;
}

// Number of numeric components written: "v1" 1, "v1.2" 2, "v1.2.3" 3.
fn dx_version_parts(spec: string) -> int64 {
  var s: string = spec;
  if (s_starts(s, "v")) {
    s = s_from(s, 1);
  }
  var cut: int64 = s_find_byte(s, 45);
  var plus: int64 = s_find_byte(s, 43);
  if (plus >= 0 && (cut < 0 || plus < cut)) {
    cut = plus;
  }
  if (cut >= 0) {
    s = s_sub(s, 0, cut);
  }
  var parts: StrList* = s_split(s, 46);
  var n: int64 = parts->len;
  free(parts);
  return n;
}

fn dx_is_partial(spec: string) -> bool {
  return sv_is(spec) && dx_version_parts(spec) < 3 && s_find_byte(spec, 45) < 0;
}

// The tag naming exactly this version ("v1.0.0" also matches tag "1.0.0").
fn dx_find_tag(tags: StrList*, spec: string) -> string {
  if (sl_has(tags, spec)) {
    return spec;
  }
  var want: string = sv_canonical(spec);
  if (slen(want) == 0) {
    return s_empty();
  }
  var i: int64 = 0;
  while (i < tags->len) {
    if (s_eq(sv_canonical(sl_get(tags, i)), want)) {
      return sl_get(tags, i);
    }
    i = i + 1;
  }
  return s_empty();
}

// Tags matching a partial version ("v1" -> v1.x.y, "v1.2" -> v1.2.y).
fn dx_matching_tags(tags: StrList*, spec: string) -> StrList* {
  var want: SemVer = sv_parse(spec);
  var parts: int64 = dx_version_parts(spec);
  var found: StrList* = sl_new();
  var i: int64 = 0;
  while (i < tags->len) {
    var v: SemVer = sv_parse(sl_get(tags, i));
    if (v.ok && v.major == want.major && (parts < 2 || v.minor == want.minor)) {
      sl_push(found, sl_get(tags, i));
    }
    i = i + 1;
  }
  return found;
}

// For a minimum written as a partial version: the lowest matching tag.
fn dx_lowest(tags: StrList*) -> string {
  var vs: StrList* = dx_semver_tags(tags);
  var found: string = s_empty();
  var i: int64 = 0;
  while (i < vs->len && slen(found) == 0) {
    if (slen(sv_parse(sl_get(vs, i)).pre) == 0) {
      found = sl_get(vs, i);
    }
    i = i + 1;
  }
  if (slen(found) == 0 && vs->len > 0) {
    found = sl_get(vs, 0);
  }
  free(vs);
  return found;
}

fn dx_is_hex_id(s: string) -> bool {
  if (slen(s) < 7 || slen(s) > 40) {
    return false;
  }
  var i: int64 = 0;
  while (i < slen(s)) {
    if (!is_hex_b(s_byte(s, i))) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

// A branch, a non-version tag or a commit: its full commit, "" when unknown.
fn dx_rev_named(mirror: string, spec: string) -> string {
  var c: string = git_rev(mirror, "refs/heads/" + spec);
  if (slen(c) == 0) {
    c = git_rev(mirror, "refs/tags/" + spec);
  }
  if (slen(c) == 0 && dx_is_hex_id(spec)) {
    c = git_rev(mirror, spec);
  }
  return c;
}

// Fills r->label / r->commit for "latest": the highest version tag (stable
// first), else the head of the default branch.
fn dx_pick_latest(cx: DxCx*, m: DxMod*, r: DxReq*) {
  var tags: StrList* = git_tags(dx_mdir(m));
  var hint: string = dx_hint_line(cx, m->module);
  if (slen(hint) > 0) {
    var in_line: StrList* = sl_new();
    var k: int64 = 0;
    while (k < tags->len) {
      if (s_eq(sv_line(sl_get(tags, k)), hint)) {
        sl_push(in_line, sl_get(tags, k));
      }
      k = k + 1;
    }
    if (in_line->len > 0) {
      tags = in_line;
    }
  }
  r->fresh = true;
  var best: string = sv_max(tags);
  if (slen(best) > 0) {
    r->label = best;
    r->commit = git_rev(dx_mdir(m), "refs/tags/" + best);
  } else {
    var branch: string = git_default_branch(dx_mdir(m));
    if (slen(branch) == 0) {
      dx_fail_hint(m->module + " has no version tags and no default branch", "require a branch or a commit explicitly");
    }
    r->label = branch;
    r->commit = git_rev(dx_mdir(m), "refs/heads/" + branch);
  }
  if (slen(r->commit) == 0) {
    dx_fail(m->module + ": cannot resolve " + r->label + " in its mirror " + dx_mdir(m));
  }
  sl_add_uniq(m->checked, r->commit);
}

// Resolves a version tag requirement; partial versions mean the lowest
// matching tag (for a minimum) or the highest (for `get`).
fn dx_pick_tag(cx: DxCx*, m: DxMod*, r: DxReq*, highest: bool) {
  var spec: string = r->spec;
  var tag: string = "";
  var round: int64 = 0;
  while (round < 2) {
    var tags: StrList* = git_tags(dx_mdir(m));
    if (dx_is_partial(spec)) {
      var hits: StrList* = dx_matching_tags(tags, spec);
      if (highest) {
        tag = sv_max(hits);
      } else {
        tag = dx_lowest(hits);
      }
      free(hits);
    } else {
      tag = dx_find_tag(tags, spec);
    }
    if (slen(tag) > 0 || round == 1 || !dx_can_fetch(cx, m)) {
      break;
    }
    dx_fetch(cx, m);
    round = round + 1;
  }
  if (slen(tag) == 0) {
    dx_fail_hint(m->module + " has no version " + spec + " (required by " + r->from + ")" + dx_offline_hint(cx), dx_available(dx_mdir(m)));
  }
  r->label = tag;
  r->commit = git_rev(dx_mdir(m), "refs/tags/" + tag);
  if (slen(r->commit) == 0) {
    dx_fail(m->module + ": tag " + tag + " does not name a commit");
  }
  sl_add_uniq(m->checked, r->commit);
}

fn dx_pick_named(cx: DxCx*, m: DxMod*, r: DxReq*) {
  var c: string = dx_rev_named(dx_mdir(m), r->spec);
  if (slen(c) == 0 && dx_can_fetch(cx, m)) {
    dx_fetch(cx, m);
    c = dx_rev_named(dx_mdir(m), r->spec);
  }
  if (slen(c) == 0) {
    dx_fail_hint(m->module + " has no version, branch or commit '" + r->spec + "' (required by " + r->from + ")" + dx_offline_hint(cx), dx_available(dx_mdir(m)));
  }
  r->label = r->spec;
  r->commit = c;
  sl_add_uniq(m->checked, c);
}

// A locked version tag that now names another commit upstream: the lock
// keeps its commit (only `mbuild update` takes the new one), with a warning.
fn dx_check_moved(cx: DxCx*, m: DxMod*, tag: string, locked: string) {
  var key: string = "moved " + m->module + " " + tag;
  if (!sv_is(tag) || dx_set_has(g_dx_said, key)) {
    return;
  }
  g_dx_said = g_dx_said + key + "\n";
  var now: string = git_rev(dx_mdir(m), "refs/tags/" + tag);
  if (slen(now) == 0 || s_eq(now, locked)) {
    return;
  }
  warn("tag " + tag + " of " + m->module + " moved upstream (" + dx_short(locked) + " -> " + dx_short(now) + "); keeping " + dx_short(locked) + "; run `mbuild update " + m->module + "` to take " + dx_short(now));
}

// Resolves one requirement to (label, commit), the lock first.
fn dx_resolve_req(cx: DxCx*, m: DxMod*, r: DxReq*) {
  var spec: string = r->spec;
  var li: int64 = -1;
  if (!sl_has(cx->unpin, m->module)) {
    li = sl_index(cx->lock->mods, m->module);
  }
  var lv: string = "";
  var lc: string = "";
  if (li < 0 && g_dx_refresh) {
    dx_mirror(cx, m, true);
  }
  if (li >= 0) {
    lv = sl_get(cx->lock->vers, li);
    lc = sl_get(cx->lock->commits, li);
  }
  if (s_eq(spec, "latest")) {
    if (li >= 0) {
      r->label = lv;
      r->commit = lc;
      dx_need_commit(cx, m, lc, lv);
      dx_check_moved(cx, m, lv, lc);
      return;
    }
    dx_mirror(cx, m, true);
    dx_pick_latest(cx, m, r);
    return;
  }
  if (sv_is(spec)) {
    if (li >= 0 && sv_is(lv) && (s_eq(lv, spec) || (!dx_is_partial(spec) && s_eq(sv_canonical(lv), sv_canonical(spec))))) {
      r->label = lv;
      r->commit = lc;
      dx_need_commit(cx, m, lc, lv);
      dx_check_moved(cx, m, lv, lc);
      return;
    }
    dx_mirror(cx, m, false);
    dx_pick_tag(cx, m, r, false);
    return;
  }
  if (li >= 0 && s_eq(lv, spec)) {
    r->label = lv;
    r->commit = lc;
    dx_need_commit(cx, m, lc, lv);
    return;
  }
  dx_mirror(cx, m, true);
  dx_pick_named(cx, m, r);
}

// ---------------------------------------------------------------------------
// The graph walk and selection
// ---------------------------------------------------------------------------

fn dx_hint_line(cx: DxCx*, module: string) -> string {
  var i: int64 = 0;
  while (i < cx->hints->len) {
    var h: string = sl_get(cx->hints, i);
    if (s_starts(h, module + " ")) {
      return s_from(h, slen(module) + 1);
    }
    i = i + 1;
  }
  return s_empty();
}

fn dx_enqueue(cx: DxCx*, m: Manifest*, from: string, root: bool) {
  if (!root && m->nreplaces > 0) {
    verbose(from + ": ignoring [replace] (only the project's own replacements apply)");
  }
  var i: int64 = 0;
  while (i < m->ndeps) {
    var d: DepSpec* = man_dep(m, i);
    if (!root && slen(d->subs_mode) > 0) {
      verbose(from + ": ignoring `submodules` of " + d->key + " (only the project's own mbuild.toml chooses submodules)");
    }
    if (slen(d->path) > 0) {
      if (!root && !s_starts(from, "path package")) {
        verbose(from + ": ignoring path dependency '" + d->key + "' (path dependencies only apply to local packages)");
      }
    } else if (slen(d->module) > 0) {
      var r: DxReq* = new DxReq;
      r->module = d->module;
      r->spec = d->version;
      r->url = d->url;
      r->from = from;
      r->root = root;
      r->label = s_empty();
      r->commit = s_empty();
      r->fresh = false;
      drq_push(cx->queue, r);
    }
    i = i + 1;
  }
}

// The manifest of one visited version, read from the mirror; 0 when none.
fn dx_node_manifest(cx: DxCx*, m: DxMod*, label: string, commit: string) -> Manifest* {
  var g: GitShow* = git_show(dx_mdir(m), commit, "mbuild.toml");
  if (!g->ok) {
    dx_fail("cannot read mbuild.toml of " + m->module + " " + label + ":\n  git: " + git_summary(g->text));
  }
  if (!g->found) {
    return (Manifest*)0;
  }
  return dx_parse_manifest(g->text, dx_deps_dir(cx->p) + "/" + m->module, m->module + "@" + label + "/mbuild.toml");
}

// Records a resolved version of m (once) and queues its requirements.
fn dx_visit(cx: DxCx*, m: DxMod*, r: DxReq*) {
  if (sl_index(m->labels, r->label) >= 0) {
    return;
  }
  sl_push(m->labels, r->label);
  sl_push(m->commits, r->commit);
  var nm: Manifest* = dx_node_manifest(cx, m, r->label, r->commit);
  dma_push(m->mans, nm);
  if (nm != (Manifest*)0) {
    dx_enqueue(cx, nm, m->module + " " + r->label, false);
  }
}

fn dx_walk_once(cx: DxCx*) {
  cx->mods = dmo_new();
  cx->queue = drq_new();
  var k: int64 = 0;
  while (k < cx->rpaths->len) {
    cx->rpaths->items[k]->reqs = drq_new();
    k = k + 1;
  }
  dx_enqueue(cx, cx->p->man, "mbuild.toml", true);
  var i: int64 = 0;
  while (i < cx->paths->len) {
    var pp: DxPath* = dx_path_at(cx, i);
    if (pp->man != (Manifest*)0) {
      dx_enqueue(cx, pp->man, "path package " + pp->key, false);
    }
    i = i + 1;
  }
  i = 0;
  while (i < cx->rpaths->len) {
    var rp: DxRPath* = cx->rpaths->items[i];
    if (rp->man != (Manifest*)0) {
      dx_enqueue(cx, rp->man, rp->module + " (replaced)", false);
    }
    i = i + 1;
  }
  var qi: int64 = 0;
  while (qi < cx->queue->len) {
    var r: DxReq* = dx_req_at(cx->queue, qi);
    qi = qi + 1;
    if (dx_is_local_module(cx, r->module)) {
      var lp: DxRPath* = dx_rpath_find(cx, r->module);
      if (lp != (DxRPath*)0) {
        drq_push(lp->reqs, r);
      }
      continue;
    }
    var m: DxMod* = dx_mod_get(cx, r->module, r->url);
    var rep: ReplaceSpec* = man_replace_find(cx->p->man, r->module);
    if (rep != (ReplaceSpec*)0 && slen(rep->path) == 0) {
      m->rep = rep;
      if (slen(rep->url) > 0) {
        m->url = rep->url;
      }
    }
    var rep_url: bool = m->rep != (ReplaceSpec*)0 && slen(m->rep->url) > 0;
    if (slen(r->url) > 0 && !rep_url && (r->root || slen(m->url) == 0)) {
      m->url = r->url;
    }
    drq_push(m->reqs, r);
    if (m->rep != (ReplaceSpec*)0 && slen(m->rep->version) > 0) {
      // Selected exactly as replaced: the requirement itself is not resolved.
      if (m->rep_req == (DxReq*)0) {
        var rr: DxReq* = new DxReq;
        rr->module = m->module;
        rr->spec = m->rep->version;
        rr->url = m->url;
        rr->from = "mbuild.toml";
        if (m->rep->local) {
          rr->from = "mbuild.local.toml";
        }
        rr->root = true;
        rr->label = s_empty();
        rr->commit = s_empty();
        rr->fresh = false;
        m->rep_req = rr;
        dx_resolve_req(cx, m, rr);
        dx_visit(cx, m, rr);
      }
      continue;
    }
    dx_resolve_req(cx, m, r);
    dx_visit(cx, m, r);
  }
}

// A requirement counts when its requirer is in the build: the root, a path
// package, a replacement, or the selected version of a module.
fn dx_live(cx: DxCx*, r: DxReq*) -> bool {
  if (r->root || s_starts(r->from, "path package ")) {
    return true;
  }
  var sp: int64 = s_find_byte(r->from, 32);
  if (sp < 0) {
    return true;
  }
  var owner: DxMod* = dx_mod_find(cx, s_sub(r->from, 0, sp));
  if (owner == (DxMod*)0) {
    return true;
  }
  if (owner->sel < 0) {
    return false;
  }
  return s_eq(sl_get(owner->labels, owner->sel), s_from(r->from, sp + 1));
}

// The selected index for m from its live requirements, -1 when none is live.
fn dx_pick(cx: DxCx*, m: DxMod*) -> int64 {
  var rootr: DxReq* = (DxReq*)0;
  var first: DxReq* = (DxReq*)0;
  var best: string = "";
  var i: int64 = 0;
  while (i < m->reqs->len) {
    var r: DxReq* = dx_req_at(m->reqs, i);
    i = i + 1;
    if (!dx_live(cx, r)) {
      continue;
    }
    if (first == (DxReq*)0) {
      first = r;
    }
    if (r->root && rootr == (DxReq*)0) {
      rootr = r;
    }
    if (sv_is(r->label) && (slen(best) == 0 || sv_cmp(r->label, best) > 0)) {
      best = r->label;
    }
  }
  if (first == (DxReq*)0) {
    return -1;
  }
  if (m->rep_req != (DxReq*)0) {
    return sl_index(m->labels, m->rep_req->label);
  }
  if (rootr != (DxReq*)0 && !sv_is(rootr->label)) {
    return sl_index(m->labels, rootr->label);
  }
  if (slen(best) > 0) {
    return sl_index(m->labels, best);
  }
  if (rootr != (DxReq*)0) {
    return sl_index(m->labels, rootr->label);
  }
  return sl_index(m->labels, first->label);
}

// Selection to a fixed point: a module whose selected version changes can
// drop or bring back the requirements of the versions it no longer selects.
fn dx_select_all(cx: DxCx*) {
  var i: int64 = 0;
  while (i < cx->mods->len) {
    dx_mod_at(cx, i)->sel = -1;
    i = i + 1;
  }
  var round: int64 = 0;
  var moved: bool = true;
  while (moved && round < 10) {
    moved = false;
    i = 0;
    while (i < cx->mods->len) {
      var m: DxMod* = dx_mod_at(cx, i);
      var s: int64 = dx_pick(cx, m);
      if (s != m->sel) {
        m->sel = s;
        moved = true;
      }
      i = i + 1;
    }
    round = round + 1;
  }
}

// `latest` stated by the root and resolved now: when the module's other live
// requirements all name one line, take the newest tag in that line instead
// (so `latest` never makes a conflict). True when a hint was added.
fn dx_latest_hints(cx: DxCx*) -> bool {
  var added: bool = false;
  var i: int64 = 0;
  while (i < cx->mods->len) {
    var m: DxMod* = dx_mod_at(cx, i);
    i = i + 1;
    var lat: DxReq* = (DxReq*)0;
    var other: string = "";
    var mixed: bool = false;
    var k: int64 = 0;
    while (k < m->reqs->len) {
      var r: DxReq* = dx_req_at(m->reqs, k);
      k = k + 1;
      if (!dx_live(cx, r)) {
        continue;
      }
      if (r->root && r->fresh && s_eq(r->spec, "latest")) {
        lat = r;
      } else if (sv_is(r->label)) {
        var ln: string = sv_line(r->label);
        if (slen(other) == 0) {
          other = ln;
        } else if (!s_eq(other, ln)) {
          mixed = true;
        }
      }
    }
    if (lat == (DxReq*)0 || slen(other) == 0 || mixed || !sv_is(lat->label) || s_eq(sv_line(lat->label), other)) {
      continue;
    }
    if (slen(dx_hint_line(cx, m->module)) == 0) {
      sl_push(cx->hints, m->module + " " + other);
      added = true;
    }
  }
  return added;
}

fn dx_walk(cx: DxCx*) {
  var round: int64 = 0;
  while (true) {
    dx_walk_once(cx);
    dx_select_all(cx);
    round = round + 1;
    if (round >= 3 || !dx_latest_hints(cx)) {
      break;
    }
  }
}

// "mbuild.toml -> github.com/demo/old v1.0.0" for a requirement's `from`:
// each requiring node followed back through the first requirement that
// introduced its version.
fn dx_chain(cx: DxCx*, from: string) -> string {
  var parts: StrList* = sl_of(from);
  var cur: string = from;
  var hops: int64 = 0;
  while (hops < 32) {
    hops = hops + 1;
    if (s_eq(cur, "mbuild.toml") || s_eq(cur, "mbuild.local.toml")) {
      break;
    }
    if (s_starts(cur, "path package ") || s_ends(cur, " (replaced)")) {
      sl_push(parts, "mbuild.toml");
      break;
    }
    var sp: int64 = s_find_byte(cur, 32);
    if (sp < 0) {
      break;
    }
    var m: DxMod* = dx_mod_find(cx, s_sub(cur, 0, sp));
    if (m == (DxMod*)0) {
      break;
    }
    var ver: string = s_from(cur, sp + 1);
    var via: DxReq* = (DxReq*)0;
    if (m->rep_req != (DxReq*)0 && s_eq(m->rep_req->label, ver)) {
      via = m->rep_req;
    }
    var i: int64 = 0;
    while (i < m->reqs->len && via == (DxReq*)0) {
      if (s_eq(dx_req_at(m->reqs, i)->label, ver)) {
        via = dx_req_at(m->reqs, i);
      }
      i = i + 1;
    }
    if (via == (DxReq*)0 || sl_has(parts, via->from)) {
      break;
    }
    sl_push(parts, via->from);
    cur = via->from;
  }
  var b: Buf* = buf_new();
  var j: int64 = parts->len - 1;
  while (j >= 0) {
    buf_add(b, sl_get(parts, j));
    if (j > 0) {
      buf_add(b, " -> ");
    }
    j = j - 1;
  }
  free(parts);
  return buf_take(b);
}

fn dx_live_reqs(cx: DxCx*, m: DxMod*) -> DxReqs* {
  var l: DxReqs* = drq_new();
  var i: int64 = 0;
  while (i < m->reqs->len) {
    if (dx_live(cx, dx_req_at(m->reqs, i))) {
      drq_push(l, dx_req_at(m->reqs, i));
    }
    i = i + 1;
  }
  return l;
}

// Insertion sort of "version<TAB>text" entries by version, then text.
fn dx_sort_by_version(l: StrList*) {
  var a: int64 = 1;
  while (a < l->len) {
    var cur: string = sl_get(l, a);
    var j: int64 = a - 1;
    while (j >= 0 && dx_vt_cmp(sl_get(l, j), cur) > 0) {
      sl_set(l, j + 1, sl_get(l, j));
      j = j - 1;
    }
    sl_set(l, j + 1, cur);
    a = a + 1;
  }
}

fn dx_vt_cmp(x: string, y: string) -> int32 {
  var tx: int64 = s_find_byte(x, 9);
  var ty: int64 = s_find_byte(y, 9);
  var c: int32 = sv_cmp(s_sub(x, 0, tx), s_sub(y, 0, ty));
  if (c != 0) {
    return c;
  }
  return s_cmp(x, y);
}

// For a requirer "R V" on a losing line: R's newest tag after V (at most 20
// looked at) whose mbuild.toml requires the module in the winning line.
fn dx_upgrade_help(cx: DxCx*, module: string, from: string, win: string) -> string {
  var sp: int64 = s_find_byte(from, 32);
  if (sp < 0) {
    return s_empty();
  }
  var rm: DxMod* = dx_mod_find(cx, s_sub(from, 0, sp));
  var ver: string = s_from(from, sp + 1);
  if (rm == (DxMod*)0 || !sv_is(ver) || !git_has_mirror(dx_mdir(rm))) {
    return s_empty();
  }
  var vs: StrList* = dx_semver_tags(git_tags(dx_mdir(rm)));
  var found: string = "";
  var looked: int64 = 0;
  var i: int64 = vs->len - 1;
  while (i >= 0 && looked < 20 && slen(found) == 0) {
    var t: string = sl_get(vs, i);
    i = i - 1;
    if (sv_cmp(t, ver) <= 0) {
      break;
    }
    looked = looked + 1;
    var c: string = git_rev(dx_mdir(rm), "refs/tags/" + t);
    if (slen(c) == 0) {
      continue;
    }
    var g: GitShow* = git_show(dx_mdir(rm), c, "mbuild.toml");
    if (!g->ok || !g->found) {
      continue;
    }
    var nm: Manifest* = man_parse(toml_parse(g->text, rm->module + "@" + t + "/mbuild.toml"), dx_deps_dir(cx->p) + "/" + rm->module);
    var d: DepSpec* = man_dep_find(nm, module);
    if (d != (DepSpec*)0 && slen(d->path) == 0 && sv_is(d->version) && s_eq(sv_line(d->version), win)) {
      found = rm->module + " " + t + " requires " + module + " " + d->version + ": run `mbuild get " + rm->module + "@" + t + "`";
    }
  }
  free(vs);
  return found;
}

fn dx_conflict_lines(cx: DxCx*, m: DxMod*, vers: DxReqs*) {
  var rows: StrList* = sl_new();
  var highest: string = "";
  var i: int64 = 0;
  while (i < vers->len) {
    var r: DxReq* = dx_req_at(vers, i);
    if (slen(highest) == 0 || sv_cmp(r->label, highest) > 0) {
      highest = r->label;
    }
    sl_add_uniq(rows, r->label + "\t" + r->label + " (line " + sv_line(r->label) + ") by " + dx_chain(cx, r->from));
    i = i + 1;
  }
  dx_sort_by_version(rows);
  var shown: StrList* = sl_new();
  i = 0;
  while (i < rows->len) {
    var row: string = sl_get(rows, i);
    sl_push(shown, s_from(row, s_find_byte(row, 9) + 1));
    i = i + 1;
  }
  var win: string = sv_line(highest);
  error_msg(m->module + " is required at incompatible versions:\n    " + sl_join(shown, "\n    ") + "\n  a program holds one version of a module: two lines would declare the same exported names twice");
  var done: StrList* = sl_new();
  i = 0;
  while (i < vers->len) {
    var r2: DxReq* = dx_req_at(vers, i);
    i = i + 1;
    if (r2->root || s_eq(sv_line(r2->label), win) || sl_has(done, r2->from)) {
      continue;
    }
    sl_push(done, r2->from);
    var h: string = dx_upgrade_help(cx, m->module, r2->from, win);
    if (slen(h) > 0) {
      dx_help(h);
    }
  }
  dx_help("or choose one version for the whole build in mbuild.toml (you take responsibility for the others):");
  err_line("          [replace]");
  err_line("          \"" + m->module + "\" = {{ version = \"" + highest + "\" }");
  free(rows);
  free(shown);
  free(done);
  dx_guard_restore();
  exit_with(1);
}

fn dx_req_desc(cx: DxCx*, r: DxReq*) -> string {
  if (sv_is(r->label)) {
    return r->label + " (line " + sv_line(r->label) + ") by " + dx_chain(cx, r->from);
  }
  return r->label + " (" + dx_short(r->commit) + ") by " + dx_chain(cx, r->from);
}

// Checks the selection of m against its live requirements (12.3).
fn dx_check_select(cx: DxCx*, m: DxMod*) {
  var live: DxReqs* = dx_live_reqs(cx, m);
  var chosen: string = sl_get(m->labels, m->sel);
  var c: string = sl_get(m->commits, m->sel);
  var i: int64 = 0;
  if (m->rep_req != (DxReq*)0) {
    while (i < live->len) {
      var lr: DxReq* = dx_req_at(live, i);
      verbose(m->module + " is replaced (" + chosen + "); ignoring " + dx_chain(cx, lr->from) + " requires " + lr->spec);
      i = i + 1;
    }
    free(live);
    return;
  }
  var rootr: DxReq* = (DxReq*)0;
  var vers: DxReqs* = drq_new();
  var nons: DxReqs* = drq_new();
  i = 0;
  while (i < live->len) {
    var r: DxReq* = dx_req_at(live, i);
    if (r->root && rootr == (DxReq*)0) {
      rootr = r;
    }
    if (sv_is(r->label)) {
      drq_push(vers, r);
    } else {
      drq_push(nons, r);
    }
    i = i + 1;
  }
  if (rootr != (DxReq*)0 && !sv_is(rootr->label)) {
    var rows: StrList* = sl_new();
    var differs: bool = false;
    i = 0;
    while (i < live->len) {
      var r2: DxReq* = dx_req_at(live, i);
      sl_add_uniq(rows, dx_chain(cx, r2->from) + " requires " + r2->spec);
      if (!s_eq(r2->commit, c)) {
        differs = true;
      }
      i = i + 1;
    }
    if (differs) {
      warn("conflicting requirements for " + m->module + ":\n    " + sl_join(rows, "\n    ") + "\n  using " + chosen);
    }
    free(rows);
    free(live);
    free(vers);
    free(nons);
    return;
  }
  var lines: StrList* = sl_new();
  i = 0;
  while (i < vers->len) {
    sl_add_uniq(lines, sv_line(dx_req_at(vers, i)->label));
    i = i + 1;
  }
  if (lines->len > 1) {
    dx_conflict_lines(cx, m, vers);
  }
  var commits: StrList* = sl_new();
  i = 0;
  while (i < nons->len) {
    sl_add_uniq(commits, dx_req_at(nons, i)->commit);
    i = i + 1;
  }
  if (nons->len > 0 && (vers->len > 0 || commits->len > 1)) {
    var rows2: StrList* = sl_new();
    i = 0;
    while (i < live->len) {
      sl_add_uniq(rows2, dx_req_desc(cx, dx_req_at(live, i)));
      i = i + 1;
    }
    var listed: string = sl_join(rows2, "\n    ");
    free(rows2);
    dx_fail_hint(m->module + " is required at versions that cannot be combined:\n    " + listed + "\n  a branch or commit and other versions do not order: mbuild cannot choose between them", "pin it in your mbuild.toml: `mbuild get " + m->module + "@VERSION` (the project's own requirement decides)");
  }
  free(lines);
  free(commits);
  free(live);
  free(vers);
  free(nons);
}

fn dx_sort_mods(cx: DxCx*) {
  var l: DxMods* = cx->mods;
  var a: int64 = 1;
  while (a < l->len) {
    var cur: DxMod* = l->items[a];
    var j: int64 = a - 1;
    while (j >= 0 && s_cmp(l->items[j]->module, cur->module) > 0) {
      l->items[j + 1] = l->items[j];
      j = j - 1;
    }
    l->items[j + 1] = cur;
    a = a + 1;
  }
}

// ---------------------------------------------------------------------------
// Checkouts, mettle.deps, the DepState
// ---------------------------------------------------------------------------

// The submodules to check out in m: the root's dependency field, else the
// package's own [package] submodules. 0 for all, an empty list for none.
fn dx_sub_select(cx: DxCx*, m: DxMod*) -> StrList* {
  var d: DepSpec* = man_dep_find(cx->p->man, m->module);
  var mode: string = "";
  var list: StrList* = (StrList*)0;
  if (d != (DepSpec*)0 && slen(d->path) == 0 && slen(d->subs_mode) > 0) {
    mode = d->subs_mode;
    list = d->subs;
  } else if (m->sel >= 0 && m->sel < m->mans->len && m->mans->items[m->sel] != (Manifest*)0) {
    var nm: Manifest* = m->mans->items[m->sel];
    mode = nm->subs_mode;
    list = nm->subs;
  }
  if (s_eq(mode, "none")) {
    return sl_new();
  }
  if (s_eq(mode, "list")) {
    if (list == (StrList*)0) {
      return sl_new();
    }
    return list;
  }
  return (StrList*)0;
}

fn dx_sub_key(sel: StrList*) -> string {
  if (sel == (StrList*)0) {
    return "all";
  }
  if (sel->len == 0) {
    return "none";
  }
  return "list:" + sl_join(sel, ",");
}

fn dx_subs_file(p: Project*) -> string {
  return p->state_dir + "/deps.subs";
}

// The submodule selection each checkout was made with ("module key" lines).
fn dx_subs_recorded(p: Project*, module: string) -> string {
  var r: FsRead = fs_read(dx_subs_file(p));
  if (!r.ok) {
    return s_empty();
  }
  var lines: StrList* = s_lines(r.data);
  var found: string = "";
  var i: int64 = 0;
  while (i < lines->len) {
    var l: string = sl_get(lines, i);
    if (s_starts(l, module + " ")) {
      found = s_from(l, slen(module) + 1);
    }
    i = i + 1;
  }
  free(lines);
  return found;
}

fn dx_subs_record(p: Project*, mods: StrList*, keys: StrList*) {
  var b: Buf* = buf_new();
  var i: int64 = 0;
  while (i < mods->len) {
    buf_line(b, sl_get(mods, i) + " " + sl_get(keys, i));
    i = i + 1;
  }
  fs_mkdirs(p->state_dir);
  fs_write_if_changed(dx_subs_file(p), buf_take(b));
}

// The top-level submodule paths a checkout's marker lists.
fn dx_marker_subs(dest: string) -> StrList* {
  var all: StrList* = sl_new();
  var r: FsRead = fs_read(dest + "/.mbuild-commit");
  if (r.ok) {
    var lines: StrList* = s_lines(r.data);
    var i: int64 = 0;
    while (i < lines->len) {
      var f: StrList* = s_fields(sl_get(lines, i));
      if (f->len >= 3 && s_eq(sl_get(f, 0), "sub")) {
        sl_push(all, sl_get(f, 1));
      }
      free(f);
      i = i + 1;
    }
    free(lines);
  }
  var top: StrList* = sl_new();
  var a: int64 = 0;
  while (a < all->len) {
    var path: string = sl_get(all, a);
    var nested: bool = false;
    var k: int64 = 0;
    while (k < all->len) {
      if (k != a && s_starts(path, sl_get(all, k) + "/")) {
        nested = true;
      }
      k = k + 1;
    }
    if (!nested) {
      sl_push(top, path);
    }
    a = a + 1;
  }
  free(all);
  return top;
}

// Checks out the selected version of m with its submodules (12.7); returns
// the selection key it used.
fn dx_materialise(cx: DxCx*, m: DxMod*) -> string {
  var label: string = sl_get(m->labels, m->sel);
  var commit: string = sl_get(m->commits, m->sel);
  var dest: string = dx_deps_dir(cx->p) + "/" + m->module;
  var sel: StrList* = dx_sub_select(cx, m);
  var key: string = dx_sub_key(sel);
  if (sys_is_link(dest)) {
    // It was a local replacement (or the project itself): the link goes,
    // its target stays.
    verbose("removing the link " + dest);
    sys_remove_link(dest);
  }
  var force: bool = cx->p->opts->force && !dx_set_has(g_dx_forced, dest);
  if (s_eq(git_checkout_commit(dest), commit) && git_marker_complete(dest) && s_eq(dx_subs_recorded(cx->p, m->module), key) && !force) {
    return key;
  }
  if (force) {
    // --force: check out and clean again, restoring edited or deleted files.
    g_dx_forced = g_dx_forced + dest + "\n";
    sys_remove_file(dest + "/.mbuild-commit");
  }
  dx_need_commit(cx, m, commit, label);
  verbose("checkout " + m->module + " " + label + " (" + commit + ") into " + dest);
  if (g_dx_sub_fetched == (StrList*)0) {
    g_dx_sub_fetched = sl_new();
  }
  var t: GitTree* = new GitTree;
  t->mirror = dx_mdir(m);
  t->url = git_url(m->module, m->url);
  t->commit = commit;
  t->dest = dest;
  t->offline = dx_offline(cx);
  t->fetched = g_dx_sub_fetched;
  t->select = sel;
  t->label = m->module + " " + label;
  var e: string = git_checkout_tree(t);
  free(t);
  if (slen(e) > 0) {
    if (s_starts(e, "submodule") || s_starts(e, "cannot ")) {
      dx_fail(e);
    }
    dx_fail("cannot check out " + m->module + " " + label + " into " + dest + ":\n  " + git_summary(e));
  }
  return key;
}

// Links .mbuild/deps/<module> to target (an absolute directory).
fn dx_link(dest: string, target: string) {
  if (!sys_is_link(dest) && fs_exists(dest)) {
    verbose("removing the checkout " + dest + " (now a link to " + target + ")");
    sys_remove_tree(dest);
  }
  fs_mkdirs(p_dir(dest));
  verbose("link " + dest + " -> " + target);
  if (!sys_make_link(target, dest)) {
    dx_fail("cannot make the link " + dest + " -> " + target);
  }
}

// The links .mbuild/deps should hold: path replacements and, for a project
// with [package] module, the project itself ("module" and "target" lists).
fn dx_wanted_links(cx: DxCx*, mods: StrList*, targets: StrList*) {
  var i: int64 = 0;
  while (i < cx->rpaths->len) {
    sl_push(mods, cx->rpaths->items[i]->module);
    sl_push(targets, cx->rpaths->items[i]->dir);
    i = i + 1;
  }
  var own: string = cx->p->man->module;
  if (slen(own) > 0 && man_is_remote_module(own) && !sl_has(mods, own)) {
    sl_push(mods, own);
    sl_push(targets, cx->p->root);
  }
}

// Removes checkouts (host/owner/repo with a .mbuild-commit) no longer
// selected, and links no longer wanted. Never enters a link.
fn dx_prune(p: Project*, selected: StrList*, links: StrList*) {
  var root: string = dx_deps_dir(p);
  var hf: StrList* = sl_new();
  var hosts: StrList* = sl_new();
  if (!sys_list_dir(root, hf, hosts)) {
    free(hf);
    free(hosts);
    return;
  }
  var a: int64 = 0;
  while (a < hosts->len) {
    var hdir: string = root + "/" + sl_get(hosts, a);
    var of: StrList* = sl_new();
    var owners: StrList* = sl_new();
    if (sys_list_dir(hdir, of, owners)) {
      var b: int64 = 0;
      while (b < owners->len) {
        var odir: string = hdir + "/" + sl_get(owners, b);
        var rf: StrList* = sl_new();
        var repos: StrList* = sl_new();
        if (sys_list_dir(odir, rf, repos)) {
          var names: StrList* = sl_copy(repos);
          sl_extend(names, rf);
          var c: int64 = 0;
          while (c < names->len) {
            var module: string = sl_get(hosts, a) + "/" + sl_get(owners, b) + "/" + sl_get(names, c);
            var dir: string = odir + "/" + sl_get(names, c);
            var is_dir: bool = c < repos->len;
            c = c + 1;
            if (sys_is_link(dir)) {
              if (!sl_has(links, module)) {
                verbose("removing the link " + dir);
                sys_remove_link(dir);
              }
            } else if (is_dir && !sl_has(selected, module) && fs_is_file(dir + "/.mbuild-commit")) {
              verbose("removing unused checkout " + dir);
              sys_remove_tree(dir);
            }
          }
          free(names);
        }
        free(rf);
        free(repos);
        b = b + 1;
      }
    }
    free(of);
    free(owners);
    a = a + 1;
  }
  free(hf);
  free(hosts);
}

fn dx_first_component(s: string) -> string {
  var at: int64 = s_find_byte(s, 47);
  if (at < 0) {
    return s;
  }
  return s_sub(s, 0, at);
}

fn dx_add_aliases(keys: StrList*, mods: StrList*, m: Manifest*) {
  if (m == (Manifest*)0) {
    return;
  }
  var i: int64 = 0;
  while (i < m->ndeps) {
    var d: DepSpec* = man_dep(m, i);
    if (slen(d->path) == 0 && slen(d->module) > 0 && !s_eq(d->key, d->module) && !sl_has(keys, d->key)) {
      sl_push(keys, d->key);
      sl_push(mods, d->module);
    }
    i = i + 1;
  }
}

fn dx_block_begin() -> string {
  return "# >>> mbuild: generated, edits inside this block are overwritten";
}

// Replaces (or adds, or drops) the managed block of dir/mettle.deps; lines
// outside the block are the user's and are kept. Written only on change.
fn dx_write_mettle_deps(dir: string, lines: StrList*) {
  var file: string = dir + "/mettle.deps";
  var r: FsRead = fs_read(file);
  var b: Buf* = buf_new();
  var block: Buf* = buf_new();
  if (lines->len > 0) {
    buf_line(block, dx_block_begin());
    var k: int64 = 0;
    while (k < lines->len) {
      buf_line(block, sl_get(lines, k));
      k = k + 1;
    }
    buf_line(block, "# <<< mbuild");
  }
  var block_text: string = buf_take(block);
  var placed: bool = false;
  var user: bool = false;
  if (r.ok) {
    var old: StrList* = s_lines(r.data);
    var inside: bool = false;
    var i: int64 = 0;
    while (i < old->len) {
      var l: string = sl_get(old, i);
      var t: string = s_trim(l);
      if (inside) {
        if (s_starts(t, "# <<< mbuild")) {
          inside = false;
        }
      } else if (s_starts(t, "# >>> mbuild")) {
        inside = true;
        if (!placed) {
          buf_add(b, block_text);
          placed = true;
        }
      } else {
        buf_line(b, l);
        if (slen(t) > 0) {
          user = true;
        }
      }
      i = i + 1;
    }
    free(old);
  }
  if (!placed) {
    buf_add(b, block_text);
  }
  var text: string = buf_take(b);
  if (!r.ok) {
    if (lines->len > 0) {
      fs_write(file, text);
    }
    return;
  }
  if (lines->len == 0 && !user) {
    sys_remove_file(file);
    return;
  }
  fs_write_if_changed(file, text);
}

// What one package's mettle.deps block publishes to that package's own
// files (the compiler takes the nearest mettle.deps first).
struct DxBlock {
  cx: DxCx*;
  dir: string;          // the package directory (the file goes here)
  man: Manifest*;       // its manifest, 0 when it has none
  mods: StrList*;       // the selected modules
  hosts: StrList*;      // their first components
  is_root: bool;        // the root: also its path packages, with warnings
  local: bool;          // root or a path package: path dependencies apply
}

fn dx_path_by_dir(cx: DxCx*, dir: string) -> DxPath* {
  var i: int64 = 0;
  while (i < cx->paths->len) {
    if (s_eq(dx_path_at(cx, i)->dir, dir)) {
      return dx_path_at(cx, i);
    }
    i = i + 1;
  }
  return (DxPath*)0;
}

// Host lines (pointing at the root's .mbuild/deps), then the package's own
// aliases (to the selected module's checkout), then its path packages.
fn dx_block_write(bl: DxBlock*) {
  var p: Project* = bl->cx->p;
  var deps: string = dx_deps_dir(p);
  var lines: StrList* = sl_new();
  var used: StrList* = sl_new();
  var i: int64 = 0;
  while (i < bl->hosts->len) {
    var host: string = sl_get(bl->hosts, i);
    sl_push(lines, host + "=" + dx_rel(bl->dir, deps + "/" + host));
    sl_push(used, host);
    i = i + 1;
  }
  var m: Manifest* = bl->man;
  if (m != (Manifest*)0) {
    i = 0;
    while (i < m->ndeps) {
      var d: DepSpec* = man_dep(m, i);
      i = i + 1;
      if (slen(d->path) == 0 && slen(d->module) > 0 && !s_eq(d->key, d->module) && sl_has(bl->mods, d->module) && !sl_has(used, d->key)) {
        sl_push(lines, d->key + "=" + dx_rel(bl->dir, deps + "/" + d->module));
        sl_push(used, d->key);
      }
    }
    i = 0;
    while (i < m->ndeps && bl->local) {
      var pd: DepSpec* = man_dep(m, i);
      i = i + 1;
      if (slen(pd->path) == 0) {
        continue;
      }
      var pp: DxPath* = dx_path_by_dir(bl->cx, p_clean(p_join(m->dir, pd->path)));
      if (pp == (DxPath*)0) {
        continue;
      }
      if (man_is_remote_module(pd->key)) {
        if (bl->is_root) {
          warn("path dependency '" + pd->key + "' cannot be published in mettle.deps (it matches only the first path component); give it a plain key such as " + p_base(pp->dir) + " = {{ path = " + toml_quote(pp->rel) + " }");
        }
      } else if (sl_has(used, pd->key)) {
        if (bl->is_root) {
          warn("path dependency '" + pd->key + "' uses a name that is already published in mettle.deps");
        }
      } else {
        sl_push(lines, pd->key + "=" + dx_rel(bl->dir, pp->dir));
        sl_push(used, pd->key);
      }
    }
  }
  dx_write_mettle_deps(bl->dir, lines);
  if (bl->is_root) {
    sl_extend(bl->cx->published, used);
  }
  free(lines);
  free(used);
}

// The DepState for the selected modules (already checked out) and the path
// packages; also publishes them in mettle.deps files: the root's (hosts,
// root aliases, root path packages), and one in every checkout and every
// path package with the hosts and that package's own aliases, so an alias is
// visible only to the files of the package that declares it.
fn dx_replaced_kind(rs: ReplaceSpec*) -> string {
  if (rs == (ReplaceSpec*)0) {
    return s_empty();
  }
  if (slen(rs->path) > 0) {
    return "path";
  }
  if (slen(rs->version) > 0) {
    return "version";
  }
  return "url";
}

fn dx_finish(cx: DxCx*, mods: StrList*, vers: StrList*, commits: StrList*) -> DepState* {
  var p: Project* = cx->p;
  var ds: DepState* = depstate_empty(dx_deps_dir(p));
  var akeys: StrList* = sl_new();
  var amods: StrList* = sl_new();
  dx_add_aliases(akeys, amods, p->man);
  var i: int64 = 0;
  while (i < cx->paths->len) {
    dx_add_aliases(akeys, amods, dx_path_at(cx, i)->man);
    i = i + 1;
  }
  var dmans: DxMans* = dma_new();
  i = 0;
  while (i < mods->len) {
    var man: Manifest* = dx_read_manifest(dx_deps_dir(p) + "/" + sl_get(mods, i));
    dma_push(dmans, man);
    i = i + 1;
  }
  i = 0;
  while (i < mods->len) {
    dx_add_aliases(akeys, amods, dmans->items[i]);
    i = i + 1;
  }
  i = 0;
  while (i < cx->rpaths->len) {
    dx_add_aliases(akeys, amods, cx->rpaths->items[i]->man);
    i = i + 1;
  }
  var hosts: StrList* = sl_new();
  i = 0;
  while (i < mods->len) {
    var module: string = sl_get(mods, i);
    var dm: DepModule;
    dm.module = module;
    dm.version = sl_get(vers, i);
    dm.commit = sl_get(commits, i);
    dm.dir = dx_deps_dir(p) + "/" + module;
    dm.alias = s_empty();
    var ai: int64 = sl_index(amods, module);
    if (ai >= 0) {
      dm.alias = sl_get(akeys, ai);
    }
    dm.is_path = false;
    dm.man = dmans->items[i];
    dm.replaced = dx_replaced_kind(man_replace_find(p->man, module));
    dm.submodules = dx_marker_subs(dm.dir);
    depstate_add(ds, dm);
    sl_add_uniq(hosts, dx_first_component(module));
    i = i + 1;
  }
  i = 0;
  while (i < cx->rpaths->len) {
    var rp: DxRPath* = cx->rpaths->items[i];
    var rm: DepModule;
    rm.module = rp->module;
    rm.version = s_empty();
    rm.commit = s_empty();
    rm.dir = rp->dir;
    rm.alias = s_empty();
    var ri: int64 = sl_index(amods, rp->module);
    if (ri >= 0) {
      rm.alias = sl_get(akeys, ri);
    }
    rm.is_path = false;
    rm.man = rp->man;
    rm.replaced = "path";
    rm.submodules = sl_new();
    depstate_add(ds, rm);
    sl_add_uniq(hosts, dx_first_component(rp->module));
    i = i + 1;
  }
  var own: string = p->man->module;
  if (slen(own) > 0 && man_is_remote_module(own)) {
    sl_add_uniq(hosts, dx_first_component(own));
  }
  sl_sort(hosts);
  i = 0;
  while (i < cx->paths->len) {
    var pp: DxPath* = dx_path_at(cx, i);
    var pm: DepModule;
    pm.module = pp->key;
    pm.version = s_empty();
    pm.commit = s_empty();
    pm.dir = pp->dir;
    pm.alias = pp->key;
    pm.is_path = true;
    pm.man = pp->man;
    pm.replaced = s_empty();
    pm.submodules = sl_new();
    depstate_add(ds, pm);
    i = i + 1;
  }
  var bl: DxBlock* = new DxBlock;
  bl->cx = cx;
  bl->mods = mods;
  bl->hosts = hosts;
  bl->dir = p->root;
  bl->man = p->man;
  bl->is_root = true;
  bl->local = true;
  dx_block_write(bl);
  bl->is_root = false;
  i = 0;
  while (i < cx->paths->len) {
    var lp: DxPath* = dx_path_at(cx, i);
    if (!s_eq(lp->dir, p->root)) {
      bl->dir = lp->dir;
      bl->man = lp->man;
      dx_block_write(bl);
    }
    i = i + 1;
  }
  bl->local = false;
  i = 0;
  while (i < mods->len) {
    var cdir: string = dx_deps_dir(p) + "/" + sl_get(mods, i);
    if (fs_is_dir(cdir)) {
      bl->dir = cdir;
      bl->man = dmans->items[i];
      dx_block_write(bl);
    }
    i = i + 1;
  }
  i = 0;
  while (i < cx->rpaths->len) {
    var xp: DxRPath* = cx->rpaths->items[i];
    if (!s_eq(xp->dir, p->root)) {
      bl->dir = xp->dir;
      bl->man = xp->man;
      dx_block_write(bl);
    }
    i = i + 1;
  }
  free(bl);
  free(akeys);
  free(amods);
  free(dmans);
  free(hosts);
  if (!g_dx_md_checked) {
    g_dx_md_checked = true;
    dx_check_user_lines(cx);
  }
  return ds;
}

// The lines of the root mettle.deps outside mbuild's block: warnings once
// per command (12.9).
fn dx_check_user_lines(cx: DxCx*) {
  var r: FsRead = fs_read(cx->p->root + "/mettle.deps");
  if (!r.ok) {
    return;
  }
  var lines: StrList* = s_lines(r.data);
  var inside: bool = false;
  var noted: bool = false;
  var before_block: bool = true;
  var i: int64 = 0;
  while (i < lines->len) {
    var t: string = s_trim(sl_get(lines, i));
    var n: int64 = i + 1;
    i = i + 1;
    if (inside) {
      if (s_starts(t, "# <<< mbuild")) {
        inside = false;
      }
      continue;
    }
    if (s_starts(t, "# >>> mbuild")) {
      inside = true;
      before_block = false;
      continue;
    }
    var eq: int64 = s_find_byte(t, 61);
    if (slen(t) == 0 || s_starts(t, "#") || eq <= 0) {
      continue;
    }
    var name: string = s_trim(s_sub(t, 0, eq));
    var dir: string = s_trim(s_from(t, eq + 1));
    if (!cx->p->has_manifest) {
      if (!noted) {
        noted = true;
        note("mettle.deps names packages mbuild does not manage; `mbuild init` turns them into [dependencies]");
      }
      continue;
    }
    if (before_block && sl_has(cx->published, name)) {
      warn("mettle.deps:" + s_int(n) + ": `" + t + "` shadows mbuild's entry for " + name + "; remove it");
      continue;
    }
    warn("mettle.deps:" + s_int(n) + ": `" + t + "` is not managed by mbuild (its dependencies and C code are ignored)");
    if (s_find_byte(name, 46) < 0) {
      dx_help("run `mbuild tidy` to move it into mbuild.toml as " + name + " = {{ path = " + toml_quote(dir) + " }");
    }
  }
  free(lines);
}

fn dx_stamp_text(cx: DxCx*) -> string {
  return "mbuild-deps-2\nlock " + hash_string(cx->lock->text) + "\nreqs " + cx->reqs_hash + "\nlocal " + dx_local_hash(cx->p) + "\n";
}

// Zero git commands: the stamp matches, every checkout holds its commit with
// its submodules, and the wanted links are there.
fn dx_fast(cx: DxCx*) -> DepState* {
  var st: FsRead = fs_read(dx_stamp_path(cx->p));
  if (!st.ok || !s_eq(st.data, dx_stamp_text(cx))) {
    return (DepState*)0;
  }
  var i: int64 = 0;
  while (i < cx->lock->mods->len) {
    var dest: string = dx_deps_dir(cx->p) + "/" + sl_get(cx->lock->mods, i);
    if (!s_eq(git_checkout_commit(dest), sl_get(cx->lock->commits, i)) || !git_marker_complete(dest)) {
      return (DepState*)0;
    }
    i = i + 1;
  }
  var lmods: StrList* = sl_new();
  var ltargets: StrList* = sl_new();
  dx_wanted_links(cx, lmods, ltargets);
  i = 0;
  while (i < lmods->len) {
    if (!sys_is_link(dx_deps_dir(cx->p) + "/" + sl_get(lmods, i))) {
      free(lmods);
      free(ltargets);
      return (DepState*)0;
    }
    i = i + 1;
  }
  free(lmods);
  free(ltargets);
  verbose("dependencies: mbuild.lock unchanged, checkouts current");
  return dx_finish(cx, cx->lock->mods, cx->lock->vers, cx->lock->commits);
}

// update --all: every selected module the root does not require whose
// selected tag has a newer one in its compatibility line goes to
// g_dx_raise_mods / g_dx_raise_vers. True when there is one.
fn dx_find_raises(cx: DxCx*) -> bool {
  g_dx_raise_mods = sl_new();
  g_dx_raise_vers = sl_new();
  var i: int64 = 0;
  while (i < cx->mods->len) {
    var m: DxMod* = dx_mod_at(cx, i);
    i = i + 1;
    if (m->sel < 0) {
      continue;
    }
    var rooted: bool = false;
    var k: int64 = 0;
    while (k < m->reqs->len) {
      if (dx_req_at(m->reqs, k)->root) {
        rooted = true;
      }
      k = k + 1;
    }
    var label: string = sl_get(m->labels, m->sel);
    if (rooted || !sv_is(label)) {
      continue;
    }
    dx_mirror(cx, m, true);
    var newer: string = dx_newest_in_line(git_tags(dx_mdir(m)), label);
    if (slen(newer) > 0) {
      sl_push(g_dx_raise_mods, m->module);
      sl_push(g_dx_raise_vers, newer);
      dx_announce("Updating", m->module, label + " -> " + newer + " (now required in mbuild.toml)", newer);
    }
  }
  return g_dx_raise_mods->len > 0;
}

// The whole of deps_ensure. unpin: modules whose lock pins are ignored;
// slow: skip the fast path (fetch, update).
fn dx_ensure(p: Project*, unpin: StrList*, slow: bool) -> DepState* {
  var cx: DxCx* = dx_cx_new(p);
  sl_extend(cx->unpin, unpin);
  dx_collect_paths(cx);
  cx->reqs_hash = dx_compute_reqs_hash(cx);
  var local: bool = cx->local_names->len > 0;
  if (local && !g_dx_local_noted) {
    g_dx_local_noted = true;
    note("using replacements from mbuild.local.toml (" + sl_join(cx->local_names, ", ") + "); mbuild.lock is left as it is");
  }
  if (!slow && !p->opts->force) {
    var fast: DepState* = dx_fast(cx);
    if (fast != (DepState*)0) {
      return fast;
    }
  }
  var has_reqs: bool = cx->lock->mods->len > 0;
  var k: int64 = 0;
  while (k < p->man->ndeps) {
    if (slen(man_dep(p->man, k)->path) == 0) {
      has_reqs = true;
    }
    k = k + 1;
  }
  k = 0;
  while (k < cx->paths->len) {
    var pm: Manifest* = dx_path_at(cx, k)->man;
    if (pm != (Manifest*)0 && pm->ndeps > 0) {
      has_reqs = true;
    }
    k = k + 1;
  }
  if (has_reqs) {
    status("Resolving", "dependencies");
  }
  dx_walk(cx);
  dx_sort_mods(cx);
  var a: DxLockArgs* = new DxLockArgs;
  a->mods = sl_new();
  a->vers = sl_new();
  a->commits = sl_new();
  a->reqs = cx->reqs_hash;
  var i: int64 = 0;
  while (i < cx->mods->len) {
    var m: DxMod* = dx_mod_at(cx, i);
    i = i + 1;
    if (m->sel < 0) {
      continue;
    }
    dx_check_select(cx, m);
    sl_push(a->mods, m->module);
    sl_push(a->vers, sl_get(m->labels, m->sel));
    sl_push(a->commits, sl_get(m->commits, m->sel));
  }
  if (g_dx_raise_all && dx_find_raises(cx)) {
    return (DepState*)0;
  }
  var text: string = dx_lock_render(a);
  var changed: bool = !s_eq(text, cx->lock->text) && (cx->lock->exists || a->mods->len > 0);
  if (changed && p->opts->locked && !local) {
    var what: string = "mbuild.lock is missing";
    if (cx->lock->exists) {
      what = "mbuild.lock is out of date";
    }
    dx_fail_hint(what + " and --locked forbids changing it", "run the command without --locked (for example `mbuild fetch`) and commit the new mbuild.lock");
  }
  dx_lock_diff(cx->lock, a);
  var keys: StrList* = sl_new();
  i = 0;
  while (i < cx->mods->len) {
    var mm: DxMod* = dx_mod_at(cx, i);
    i = i + 1;
    if (mm->sel >= 0) {
      sl_push(keys, dx_materialise(cx, mm));
    }
  }
  dx_subs_record(p, a->mods, keys);
  free(keys);
  var lmods: StrList* = sl_new();
  var ltargets: StrList* = sl_new();
  dx_wanted_links(cx, lmods, ltargets);
  i = 0;
  while (i < lmods->len) {
    dx_link(dx_deps_dir(p) + "/" + sl_get(lmods, i), sl_get(ltargets, i));
    i = i + 1;
  }
  dx_prune(p, a->mods, lmods);
  free(lmods);
  free(ltargets);
  var lock_file: string = dx_lock_path(p);
  if (local) {
    lock_file = dx_local_lock_path(p);
    changed = !s_eq(text, cx->lock->text) || !fs_is_file(lock_file);
  }
  if (changed) {
    fs_mkdirs(p_dir(lock_file));
    if (!fs_write(lock_file, text)) {
      dx_fail("cannot write " + lock_file);
    }
    cx->lock->text = text;
  }
  var ds: DepState* = dx_finish(cx, a->mods, a->vers, a->commits);
  fs_write(dx_stamp_path(p), dx_stamp_text(cx));
  free(a);
  return ds;
}

export fn deps_ensure(p: Project*) -> DepState* {
  return dx_ensure(p, sl_new(), false);
}

// ---------------------------------------------------------------------------
// Editing mbuild.toml
// ---------------------------------------------------------------------------

fn dx_manifest_text(p: Project*) -> string {
  var r: FsRead = fs_read(dx_manifest_path(p));
  if (!r.ok) {
    dx_fail_hint("no mbuild.toml in " + p->root, "run `mbuild init` first");
  }
  return r.data;
}

// Writes the new manifest text and reloads p->man from it.
fn dx_save_manifest(p: Project*, text: string) {
  var file: string = dx_manifest_path(p);
  var doc: Toml* = toml_parse(text, file);
  var m: Manifest* = man_parse(doc, p->root);
  if (slen(m->error) > 0) {
    dx_fail("mbuild produced an invalid mbuild.toml (" + m->error + "); the file was not changed");
  }
  if (!fs_write(file, text)) {
    dx_fail("cannot write " + file);
  }
  p->man = m;
  p->has_manifest = true;
}

// kinds: "1" string (quoted again), "2"/"3"/"4" integer, bool, array (raw
// TOML text, kept as written).
fn dx_inline_literal(names: StrList*, values: StrList*, kinds: StrList*) -> string {
  var parts: StrList* = sl_new();
  var i: int64 = 0;
  while (i < names->len) {
    var kind: string = sl_get(kinds, i);
    var lit: string = toml_quote(sl_get(values, i));
    if (s_eq(kind, "2") || s_eq(kind, "3") || s_eq(kind, "4")) {
      lit = sl_get(values, i);
    }
    sl_push(parts, toml_key_literal(sl_get(names, i)) + " = " + lit);
    i = i + 1;
  }
  var lit: string = "{{ " + sl_join(parts, ", ") + " }";
  free(parts);
  return lit;
}

// Sets the version of a requirement (d) or adds `"module" = "spec"` (d == 0).
fn dx_text_set_version(text: string, d: DepSpec*, spec_and_module: StrList*) -> string {
  var spec: string = sl_get(spec_and_module, 0);
  var module: string = sl_get(spec_and_module, 1);
  if (d == (DepSpec*)0) {
    return toml_set_in_text(text, "dependencies", module, toml_quote(spec));
  }
  var doc: Toml* = toml_parse(text, "mbuild.toml");
  var v: TomlValue* = toml_get(doc, "dependencies", d->key);
  if (v == (TomlValue*)0) {
    return toml_set_in_text(text, "dependencies." + d->key, "version", toml_quote(spec));
  }
  if (v->kind == 1) {
    return toml_set_in_text(text, "dependencies", d->key, toml_quote(spec));
  }
  var names: StrList* = sl_new();
  var values: StrList* = sl_new();
  var kinds: StrList* = sl_new();
  var found: bool = false;
  var i: int64 = 0;
  while (i < v->fields->len) {
    var f: string = sl_get(v->fields, i);
    sl_push(names, f);
    if (s_eq(f, "version")) {
      sl_push(values, spec);
      sl_push(kinds, "1");
      found = true;
    } else {
      sl_push(values, sl_get(v->field_values, i));
      sl_push(kinds, sl_get(v->field_kinds, i));
    }
    i = i + 1;
  }
  if (!found) {
    sl_push(names, "version");
    sl_push(values, spec);
    sl_push(kinds, "1");
  }
  var edited: string = toml_set_in_text(text, "dependencies", d->key, dx_inline_literal(names, values, kinds));
  free(names);
  free(values);
  free(kinds);
  return edited;
}

fn dx_text_remove(text: string, key: string) -> string {
  var doc: Toml* = toml_parse(text, "mbuild.toml");
  if (toml_get(doc, "dependencies", key) != (TomlValue*)0) {
    return toml_remove_in_text(text, "dependencies", key);
  }
  var sec: string = "dependencies." + key;
  var keys: StrList* = toml_keys(doc, sec);
  var t: string = text;
  var i: int64 = 0;
  while (i < keys->len) {
    t = toml_remove_in_text(t, sec, sl_get(keys, i));
    i = i + 1;
  }
  free(keys);
  var header: string = "[" + toml_section_literal(sec) + "]";
  var lines: StrList* = s_split(t, 10);
  var kept: StrList* = sl_new();
  i = 0;
  while (i < lines->len) {
    if (!s_eq(s_trim(sl_get(lines, i)), header)) {
      sl_push(kept, sl_get(lines, i));
    }
    i = i + 1;
  }
  var joined: string = sl_join(kept, "\n");
  free(lines);
  free(kept);
  return joined;
}

fn dx_refuse_locked(p: Project*, what: string) {
  if (p->opts->locked) {
    dx_fail_hint(what + " would change mbuild.toml, and --locked forbids it", "run it without --locked");
  }
}

// The concrete version `want` names for a module, as written into
// mbuild.toml: a tag, a branch name or the commit as given.
fn dx_pick_for_get(cx: DxCx*, m: DxMod*, want: string) -> string {
  dx_mirror(cx, m, true);
  var r: DxReq* = new DxReq;
  r->module = m->module;
  r->spec = want;
  r->url = m->url;
  r->from = "the command line";
  r->root = true;
  if (s_eq(want, "latest")) {
    dx_pick_latest(cx, m, r);
  } else if (sv_is(want)) {
    dx_pick_tag(cx, m, r, true);
  } else {
    dx_pick_named(cx, m, r);
  }
  var label: string = r->label;
  free(r);
  return label;
}

// ---------------------------------------------------------------------------
// Commands
// ---------------------------------------------------------------------------

// Adds `"module" = version` to the manifest text for an imported module
// that the root does not require: at the version already selected in
// mbuild.lock when the module is there (a direct import of a transitive
// module never moves it), else at the latest version.
fn dx_add_import(cx: DxCx*, module: string, text: string) -> string {
  var label: string = "";
  var li: int64 = sl_index(cx->lock->mods, module);
  if (li >= 0) {
    label = sl_get(cx->lock->vers, li);
  } else {
    var m: DxMod* = dx_mod_get(cx, module, "");
    var r: DxReq* = new DxReq;
    r->from = "an import in this project";
    drq_push(m->reqs, r);
    label = dx_pick_for_get(cx, m, "latest");
  }
  var pair: StrList* = sl_of(label);
  sl_push(pair, module);
  var edited: string = dx_text_set_version(text, (DepSpec*)0, pair);
  free(pair);
  if (li >= 0) {
    dx_announce("Adding", module, label + " (already selected)", label);
  } else {
    dx_announce("Adding", module, label, label);
  }
  return edited;
}

// A remote module the root manifest does not require (under any key) and
// that is not local: an import of it must be added.
fn dx_needs_adding(cx: DxCx*, m: Manifest*, module: string) -> bool {
  return man_is_remote_module(module) && man_dep_find(m, module) == (DepSpec*)0 && !dx_is_local_module(cx, module);
}

export fn deps_add_missing(p: Project*, modules: StrList*) -> bool {
  var cx: DxCx* = dx_cx_new(p);
  defer free(cx);
  dx_collect_paths(cx);
  var text: string = "";
  var added: bool = false;
  var done: StrList* = sl_new();
  defer free(done);
  var i: int64 = 0;
  while (i < modules->len) {
    var module: string = sl_get(modules, i);
    i = i + 1;
    if (!dx_needs_adding(cx, p->man, module) || sl_has(done, module)) {
      continue;
    }
    sl_push(done, module);
    if (p->opts->locked) {
      dx_fail_hint(module + " is imported but not required in mbuild.toml, and --locked forbids adding it", "run `mbuild get " + module + "` (or build once without --locked) and commit mbuild.toml and mbuild.lock");
    }
    if (!added) {
      text = dx_manifest_text(p);
    }
    text = dx_add_import(cx, module, text);
    added = true;
  }
  if (added) {
    dx_save_manifest(p, text);
  }
  return added;
}

// Splits a `get` argument into [module or key, version]. Accepts repository
// URLs as well: https://host/x/y, http://..., ssh://git@host/x/y,
// git@host:x/y, with or without a trailing .git or /; all give host/x/y.
fn dx_get_arg(arg: string) -> StrList* {
  var s: string = s_trim(arg);
  var had_scheme: bool = false;
  var sch: int64 = s_find(s, "://");
  if (sch >= 0) {
    s = s_from(s, sch + 3);
    had_scheme = true;
  }
  var at: int64 = s_find_byte(s, 64);
  var slash: int64 = s_find_byte(s, 47);
  var colon: int64 = s_find_byte(s, 58);
  if (at >= 0 && (slash < 0 || at < slash)) {
    if (had_scheme || (colon > at && (slash < 0 || colon < slash))) {
      s = s_from(s, at + 1);
    }
  }
  var want: string = "latest";
  var vat: int64 = s_rfind_byte(s, 64);
  if (vat >= 0) {
    if (vat + 1 < slen(s)) {
      want = s_from(s, vat + 1);
    }
    s = s_sub(s, 0, vat);
  }
  colon = s_find_byte(s, 58);
  slash = s_find_byte(s, 47);
  if (colon > 0 && (slash < 0 || colon < slash)) {
    var host: string = s_sub(s, 0, colon);
    var rest: string = s_from(s, colon + 1);
    var rs: int64 = s_find_byte(rest, 47);
    if (had_scheme && rs > 0 && s_is_int(s_sub(rest, 0, rs))) {
      rest = s_from(rest, rs + 1);
    }
    s = host + "/" + rest;
  }
  while (s_ends(s, "/")) {
    s = s_sub(s, 0, slen(s) - 1);
  }
  if (s_ends(s, ".git") && slen(s) > 4) {
    s = s_sub(s, 0, slen(s) - 4);
  }
  while (s_ends(s, "/")) {
    s = s_sub(s, 0, slen(s) - 1);
  }
  var parts: StrList* = sl_of(s);
  sl_push(parts, want);
  return parts;
}

export fn deps_cmd_get(p: Project*) -> int32 {
  var args: StrList* = p->opts->rest;
  if (args->len == 0) {
    error_msg("usage: mbuild get MODULE[@VERSION]...  (VERSION: latest, v1.2.3, v1, a branch or a commit)");
    return 2;
  }
  dx_refuse_locked(p, "mbuild get");
  var text: string = dx_manifest_text(p);
  var cx: DxCx* = dx_cx_new(p);
  defer free(cx);
  dx_collect_paths(cx);
  var unpin: StrList* = sl_new();
  defer free(unpin);
  var i: int64 = 0;
  while (i < args->len) {
    var arg: string = sl_get(args, i);
    i = i + 1;
    var split: StrList* = dx_get_arg(arg);
    var name: string = sl_get(split, 0);
    var want: string = sl_get(split, 1);
    free(split);
    var d: DepSpec* = man_dep_find(p->man, name);
    var module: string = name;
    var req_url: string = "";
    if (d != (DepSpec*)0) {
      if (slen(d->path) > 0) {
        error_msg("'" + name + "' is a local path dependency; edit its path in mbuild.toml instead");
        return 1;
      }
      module = d->module;
      req_url = d->url;
    } else if (!man_is_remote_module(name)) {
      error_msg("'" + name + "' is not a module path (expected host/owner/repo, e.g. github.com/someone/json) or a dependency of this project");
      return 1;
    }
    if (dx_rpath_find(cx, module) != (DxRPath*)0) {
      error_msg(module + " is replaced by a local path in [replace]; remove the replacement to choose a version");
      return 1;
    }
    if (dx_is_local_module(cx, module)) {
      error_msg(module + " is this project or one of its path packages");
      return 1;
    }
    var m: DxMod* = dx_mod_get(cx, module, req_url);
    var r: DxReq* = new DxReq;
    r->from = "the command line";
    drq_push(m->reqs, r);
    var label: string = dx_pick_for_get(cx, m, want);
    var old: string = "";
    if (d != (DepSpec*)0) {
      old = d->version;
    }
    if (!s_eq(old, label)) {
      var pair: StrList* = sl_of(label);
      sl_push(pair, module);
      text = dx_text_set_version(text, d, pair);
      free(pair);
      if (d == (DepSpec*)0) {
        dx_announce("Adding", module, label, label);
      } else {
        dx_announce("Updating", module, old + " -> " + label, label);
      }
    }
    sl_push(unpin, module);
  }
  dx_arm(p);
  dx_save_manifest(p, text);
  dx_ensure(p, unpin, false);
  dx_disarm();
  return 0;
}

export fn deps_cmd_remove(p: Project*) -> int32 {
  var args: StrList* = p->opts->rest;
  if (args->len == 0) {
    error_msg("usage: mbuild remove MODULE...  (a module path or a dependency key)");
    return 2;
  }
  dx_refuse_locked(p, "mbuild remove");
  var text: string = dx_manifest_text(p);
  var i: int64 = 0;
  while (i < args->len) {
    var name: string = sl_get(args, i);
    i = i + 1;
    var d: DepSpec* = man_dep_find(p->man, name);
    if (d == (DepSpec*)0) {
      error_msg(name + " is not in [dependencies] of " + dx_manifest_path(p));
      return 1;
    }
    var key: string = d->key;
    var module: string = d->module;
    text = dx_text_remove(text, key);
    if (slen(module) == 0) {
      module = key;
    }
    dx_announce("Removing", module, "from mbuild.toml", "-");
    dx_arm(p);
    dx_save_manifest(p, text);
  }
  dx_ensure(p, sl_new(), false);
  dx_disarm();
  return 0;
}

// The newest tag in cur's compatibility line (pre-releases only when cur is
// one), "" when none is newer.
fn dx_newest_in_line(tags: StrList*, cur: string) -> string {
  var cv: SemVer = sv_parse(cur);
  var line: string = sv_line(cur);
  var best: string = "";
  var i: int64 = 0;
  while (i < tags->len) {
    var t: string = sl_get(tags, i);
    var v: SemVer = sv_parse(t);
    if (v.ok && s_eq(sv_line(t), line) && (slen(v.pre) == 0 || slen(cv.pre) > 0)) {
      if (slen(best) == 0 || sv_cmp(t, best) > 0) {
        best = t;
      }
    }
    i = i + 1;
  }
  if (slen(best) > 0 && sv_cmp(best, cur) > 0) {
    return best;
  }
  return s_empty();
}

// The newest stable tag of any line, "" when there is none.
fn dx_newest_stable(tags: StrList*) -> string {
  var best: string = "";
  var i: int64 = 0;
  while (i < tags->len) {
    var t: string = sl_get(tags, i);
    var v: SemVer = sv_parse(t);
    if (v.ok && slen(v.pre) == 0 && (slen(best) == 0 || sv_cmp(t, best) > 0)) {
      best = t;
    }
    i = i + 1;
  }
  return best;
}

// Tags after `from` up to `to` (inclusive), newest first, space-separated;
// pre-releases only when `from` is one; in from's line unless cross.
fn dx_candidates(tags: StrList*, from: string, to: string, cross: bool) -> string {
  var vs: StrList* = dx_semver_tags(tags);
  var pre_ok: bool = slen(sv_parse(from).pre) > 0;
  var picked: StrList* = sl_new();
  var i: int64 = vs->len - 1;
  while (i >= 0) {
    var t: string = sl_get(vs, i);
    i = i - 1;
    if (sv_cmp(t, from) <= 0 || sv_cmp(t, to) > 0) {
      continue;
    }
    if (slen(sv_parse(t).pre) > 0 && !pre_ok && !s_eq(t, to)) {
      continue;
    }
    if (!cross && !s_eq(sv_line(t), sv_line(from))) {
      continue;
    }
    sl_push(picked, t);
  }
  var joined: string = sl_join(picked, " ");
  free(vs);
  free(picked);
  return joined;
}

export fn deps_cmd_update(p: Project*) -> int32 {
  var req: UpdateReq* = new UpdateReq;
  req->modules = sl_new();
  req->all = false;
  req->major = false;
  var ai: int64 = 0;
  while (ai < p->opts->rest->len) {
    var arg: string = sl_get(p->opts->rest, ai);
    ai = ai + 1;
    if (s_eq(arg, "--all")) {
      req->all = true;
    } else if (s_eq(arg, "--major")) {
      req->major = true;
    } else {
      sl_push(req->modules, arg);
    }
  }
  if (req->all && req->modules->len > 0) {
    error_msg("mbuild update --all takes no module names");
    free(req);
    return 2;
  }
  dx_refuse_locked(p, "mbuild update");
  var plan: UpdatePlan* = deps_plan_update(p, req);
  var before: FsRead = fs_read(dx_lock_path(p));
  if (plan->mods->len > 0) {
    var vers: StrList* = sl_new();
    var i: int64 = 0;
    while (i < plan->tos->len) {
      sl_push(vers, sl_get(plan->tos, i));
      i = i + 1;
    }
    dx_apply(p, plan->mods, vers, false);
    free(vers);
  }
  var k: int64 = 0;
  while (k < plan->lines_mods->len) {
    var v: string = sl_get(plan->lines_vers, k);
    status("Newer", sl_get(plan->lines_mods, k) + " " + v + " is a new compatibility line (" + sv_line(v) + "): `mbuild update --major " + sl_get(plan->lines_mods, k) + "`");
    k = k + 1;
  }
  var after: FsRead = fs_read(dx_lock_path(p));
  var same: bool = (before.ok == after.ok) && (!after.ok || s_eq(after.data, before.data));
  if (plan->mods->len == 0 && plan->lines_mods->len == 0 && same) {
    status("Checked", "dependencies are up to date");
  }
  free(plan);
  free(req);
  return 0;
}

// used_modules: the keys imported directly by the root package's own files:
// alias keys, path package keys and remote module paths. Requirements
// (aliases and path packages included) nothing there imports are removed;
// imported remote modules the root does not require are added, at the
// version already selected when the module is in the graph.
export fn deps_cmd_tidy(p: Project*, used_modules: StrList*) -> int32 {
  dx_refuse_locked(p, "mbuild tidy");
  dx_arm(p);
  var adopted: StrList* = dx_adopt(p, true);
  var cx: DxCx* = dx_cx_new(p);
  defer free(cx);
  dx_collect_paths(cx);
  var text: string = dx_manifest_text(p);
  var changed: bool = false;
  var i: int64 = 0;
  while (i < p->man->ndeps) {
    var d: DepSpec* = man_dep(p->man, i);
    i = i + 1;
    var used: bool = sl_has(used_modules, d->key) || sl_has(adopted, d->key);
    if (slen(d->path) > 0 && slen(d->module) > 0 && sl_has(used_modules, d->module)) {
      used = true;
    }
    if (!used) {
      text = dx_text_remove(text, d->key);
      var shown: string = d->module;
      if (slen(shown) == 0 || !s_eq(d->key, d->module)) {
        shown = d->key;
      }
      dx_announce("Removing", shown, "(not imported)", "-");
      changed = true;
    }
  }
  var kept: Manifest* = dx_parse_manifest(text, p->root, dx_manifest_path(p));
  var done: StrList* = sl_new();
  defer free(done);
  i = 0;
  while (i < used_modules->len) {
    var module: string = sl_get(used_modules, i);
    i = i + 1;
    if (!dx_needs_adding(cx, kept, module) || sl_has(done, module)) {
      continue;
    }
    sl_push(done, module);
    text = dx_add_import(cx, module, text);
    changed = true;
  }
  if (changed) {
    dx_save_manifest(p, text);
  }
  dx_ensure(p, sl_new(), false);
  dx_disarm();
  return 0;
}

// The libraries of one section family ("c" or "link": the section and its
// .linux / .windows variants), `key` lists merged. linked: a section exists.
fn dx_section_libs(m: Manifest*, family: string, key: string, libs: StrList*) -> bool {
  var secs: StrList* = sl_of(family);
  sl_push(secs, family + ".linux");
  sl_push(secs, family + ".windows");
  var linked: bool = false;
  var i: int64 = 0;
  while (i < secs->len) {
    if (toml_has_section(m->doc, sl_get(secs, i))) {
      linked = true;
    }
    sl_extend_uniq(libs, toml_list(m->doc, sl_get(secs, i), key));
    i = i + 1;
  }
  free(secs);
  return linked;
}

// " [native: C; c libs: m; link libs: raylib; pkgconfig: gtk+-3.0]", or "".
fn dx_native_note(m: Manifest*) -> string {
  if (m == (Manifest*)0) {
    return "";
  }
  var parts: StrList* = sl_new();
  if (man_has_c(m)) {
    sl_push(parts, "C");
    var clibs: StrList* = sl_new();
    dx_section_libs(m, "c", "libs", clibs);
    if (clibs->len > 0) {
      sl_push(parts, "c libs: " + sl_join(clibs, ", "));
    }
    free(clibs);
  }
  var libs: StrList* = sl_new();
  var linked: bool = dx_section_libs(m, "link", "libs", libs);
  var pkgs: StrList* = sl_new();
  dx_section_libs(m, "link", "pkgconfig", pkgs);
  if (libs->len > 0) {
    sl_push(parts, "link libs: " + sl_join(libs, ", "));
  }
  if (pkgs->len > 0) {
    sl_push(parts, "pkgconfig: " + sl_join(pkgs, ", "));
  }
  if (linked && libs->len == 0 && pkgs->len == 0) {
    sl_push(parts, "links");
  }
  free(libs);
  free(pkgs);
  var note_text: string = "";
  if (parts->len > 0) {
    note_text = " " + yellow("[native: " + sl_join(parts, "; ") + "]");
  }
  free(parts);
  return note_text;
}

fn dx_ds_find(ds: DepState*, d: DepSpec*) -> int64 {
  var i: int64 = 0;
  while (i < ds->n) {
    var dm: DepModule* = &ds->mods[i];
    if (slen(d->path) > 0) {
      if (dm->is_path && s_eq(dm->module, d->key)) {
        return i;
      }
    } else if (!dm->is_path && s_eq(dm->module, d->module)) {
      return i;
    }
    i = i + 1;
  }
  return -1;
}

fn dx_describe(p: Project*, dm: DepModule*) -> string {
  if (dm->is_path) {
    return dm->module + " " + dim("(path " + dx_rel(p->root, dm->dir) + ")");
  }
  var rs: ReplaceSpec* = man_replace_find(p->man, dm->module);
  if (rs != (ReplaceSpec*)0 && slen(dm->replaced) > 0) {
    var tail: string = " (replaced)";
    if (rs->local) {
      tail = " (replaced) (local)";
    }
    if (slen(rs->path) > 0) {
      return dm->module + " => " + rs->path + dim(tail);
    }
    if (slen(rs->url) > 0) {
      return dm->module + " => " + rs->url + " " + dm->version + dim(tail);
    }
    return dm->module + " => " + dm->version + dim(tail);
  }
  var s: string = dm->module + " " + dm->version;
  if (!sv_is(dm->version) || slen(dm->version) == 40) {
    s = s + " " + dim("(" + dx_short(dm->commit) + ")");
  }
  return s;
}

fn dx_subs_note(dm: DepModule*) -> string {
  if (dm->submodules == (StrList*)0 || dm->submodules->len == 0) {
    return "";
  }
  return " [submodules: " + sl_join(dm->submodules, ", ") + "]";
}

struct DxTree {
  p: Project*;
  ds: DepState*;
  seen: StrList*;
}

fn dx_tree(t: DxTree*, m: Manifest*, prefix: string) {
  var i: int64 = 0;
  while (i < m->ndeps) {
    var d: DepSpec* = man_dep(m, i);
    var last: bool = i == m->ndeps - 1;
    i = i + 1;
    var branch: string = "|-- ";
    var cont: string = "|   ";
    if (last) {
      branch = "`-- ";
      cont = "    ";
    }
    var at: int64 = dx_ds_find(t->ds, d);
    if (at < 0) {
      say(prefix + branch + d->key + " " + d->version + " " + dim("(not selected)"));
      continue;
    }
    var dm: DepModule* = &t->ds->mods[at];
    var line: string = dx_describe(t->p, dm);
    if (slen(d->module) > 0 && !s_eq(d->key, d->module)) {
      line = d->key + " -> " + line;
    }
    if (slen(d->path) == 0 && !s_eq(d->version, dm->version) && !s_eq(d->version, "latest")) {
      line = line + " " + dim("(requires " + d->version + ")");
    }
    line = line + dx_subs_note(dm) + dx_native_note(dm->man);
    var id: string = dm->module + "@" + dm->version;
    var expand: bool = dm->man != (Manifest*)0 && dm->man->ndeps > 0;
    if (expand && sl_has(t->seen, id)) {
      line = line + " " + dim("(*)");
      expand = false;
    }
    say(prefix + branch + line);
    if (expand) {
      sl_push(t->seen, id);
      dx_tree(t, dm->man, prefix + cont);
    }
  }
}

export fn deps_cmd_list(p: Project*) -> int32 {
  var ds: DepState* = deps_ensure(p);
  if (sl_has(p->opts->rest, "--tree")) {
    var t: DxTree* = new DxTree;
    defer free(t);
    t->p = p;
    t->ds = ds;
    t->seen = sl_new();
    var title: string = bold(p->man->name);
    if (slen(p->man->version) > 0) {
      title = title + " " + p->man->version;
    }
    say(title + dx_native_note(p->man));
    dx_tree(t, p->man, "");
    return 0;
  }
  if (ds->n == 0) {
    say("no dependencies");
    return 0;
  }
  var i: int64 = 0;
  while (i < ds->n) {
    var dm: DepModule* = &ds->mods[i];
    var line: string = dx_describe(p, dm);
    if (slen(dm->alias) > 0 && !dm->is_path) {
      line = line + " " + dim("(as " + dm->alias + ")");
    }
    say(line + dx_subs_note(dm) + dx_native_note(dm->man));
    i = i + 1;
  }
  var need: StrList* = deps_mettle_minimum(ds);
  if (need->len >= 2) {
    var who: string = sl_get(need, 1);
    var sp: int64 = s_find_byte(who, 32);
    if (sp > 0) {
      who = s_sub(who, 0, sp);
    }
    say("Mettle >= " + sl_get(need, 0) + " (" + who + ")");
  }
  free(need);
  return 0;
}

export fn deps_cmd_fetch(p: Project*) -> int32 {
  var ds: DepState* = dx_ensure(p, sl_new(), true);
  var n: int64 = 0;
  var i: int64 = 0;
  while (i < ds->n) {
    if (!ds->mods[i].is_path) {
      n = n + 1;
    }
    i = i + 1;
  }
  status("Fetched", "{n} module(s); builds can now run with --offline");
  return 0;
}

// ---------------------------------------------------------------------------
// Round 2 interface (DESIGN.md 12.20). STUBS added by the orchestrator so
// build.mettle can compile against them; the dependency agent replaces each
// body and keeps these signatures.
// ---------------------------------------------------------------------------

export struct DepSnap {
  files: StrList*;
  texts: StrList*;
  present: StrList*;
}

export struct UpdateReq {
  modules: StrList*;
  all: bool;
  major: bool;
}

export struct UpdatePlan {
  mods: StrList*;
  froms: StrList*;
  tos: StrList*;
  kinds: StrList*;
  cands: StrList*;
  lines_mods: StrList*;
  lines_vers: StrList*;
}

export struct ApiQuery {
  module: string;
  from_version: string;
  to_version: string;
  files: StrList*;      // the files whose uses are listed (0 or empty: the project's files importing the module)
  with_added: bool;     // also list `added` entries (default: only what breaks callers)
}

// ---------------------------------------------------------------------------
// The resolved graph without checkouts (why, outdated, plans)
// ---------------------------------------------------------------------------

fn dx_graph(p: Project*) -> DxCx* {
  var cx: DxCx* = dx_cx_new(p);
  dx_collect_paths(cx);
  cx->reqs_hash = dx_compute_reqs_hash(cx);
  dx_walk(cx);
  dx_sort_mods(cx);
  return cx;
}

// The module a command-line name means: a dependency key, a module path or
// a module in the lock; "" when it is none of them.
fn dx_name_module(cx: DxCx*, name: string) -> string {
  var d: DepSpec* = man_dep_find(cx->p->man, name);
  if (d != (DepSpec*)0) {
    if (slen(d->module) > 0) {
      return d->module;
    }
    return d->key;
  }
  if (sl_has(cx->lock->mods, name) || man_is_remote_module(name)) {
    return name;
  }
  return s_empty();
}

// Import prefixes that name module inside a package with manifest m.
fn dx_import_prefixes(m: Manifest*, module: string) -> StrList* {
  var l: StrList* = sl_of(module + "/");
  if (m != (Manifest*)0) {
    var i: int64 = 0;
    while (i < m->ndeps) {
      var d: DepSpec* = man_dep(m, i);
      if (s_eq(d->module, module) && !s_eq(d->key, module)) {
        sl_add_uniq(l, d->key + "/");
      }
      i = i + 1;
    }
  }
  return l;
}

// "<label>file:line" for each import of the prefixes in the .mettle files
// under dir; with abs, the absolute paths of the importing files instead.
fn dx_import_hits(dir: string, prefixes: StrList*, label: string, hits: StrList*, abs: bool) {
  var skip: StrList* = sl_of("build");
  var files: StrList* = fs_walk(dir, ".mettle", skip);
  var i: int64 = 0;
  while (i < files->len) {
    var rel: string = sl_get(files, i);
    i = i + 1;
    var r: FsRead = fs_read(dir + "/" + rel);
    if (!r.ok) {
      continue;
    }
    var sr: ScanResult* = scan_source(r.data);
    var k: int64 = 0;
    while (k < sr->nimports) {
      var ip: string = scan_import(sr, k)->path;
      var ln: int64 = scan_import(sr, k)->line;
      k = k + 1;
      var j: int64 = 0;
      var hit: bool = false;
      while (j < prefixes->len) {
        if (s_starts(ip, sl_get(prefixes, j))) {
          hit = true;
        }
        j = j + 1;
      }
      if (hit) {
        if (abs) {
          sl_add_uniq(hits, dir + "/" + rel);
        } else {
          sl_add_uniq(hits, label + rel + ":" + s_int(ln));
        }
      }
    }
    free(sr);
  }
  free(skip);
  free(files);
}

// The project's own files (root and path packages) that import module.
fn dx_files_importing(p: Project*, cx: DxCx*, module: string) -> StrList* {
  var hits: StrList* = sl_new();
  dx_import_hits(p->root, dx_import_prefixes(p->man, module), "", hits, true);
  var i: int64 = 0;
  while (i < cx->paths->len) {
    var pp: DxPath* = dx_path_at(cx, i);
    if (!p_has_prefix_dir(pp->dir, p->root)) {
      dx_import_hits(pp->dir, dx_import_prefixes(pp->man, module), "", hits, true);
    }
    i = i + 1;
  }
  return hits;
}

// ---------------------------------------------------------------------------
// mbuild why MODULE (12.4)
// ---------------------------------------------------------------------------

export fn deps_cmd_why(p: Project*) -> int32 {
  if (p->opts->rest->len != 1) {
    error_msg("usage: mbuild why MODULE  (with two arguments, `mbuild why A B` asks the compiler)");
    return 2;
  }
  var name: string = sl_get(p->opts->rest, 0);
  var ds: DepState* = deps_ensure(p);
  var cx: DxCx* = dx_graph(p);
  defer free(cx);
  var module: string = dx_name_module(cx, name);
  if (slen(module) == 0) {
    error_msg("'" + name + "' is not a dependency of this project (with two arguments, `mbuild why A B` asks the compiler)");
    return 1;
  }
  var m: DxMod* = dx_mod_find(cx, module);
  var rp: DxRPath* = dx_rpath_find(cx, module);
  var pathdep: DepSpec* = man_dep_find(p->man, name);
  if (pathdep != (DepSpec*)0 && slen(pathdep->path) > 0) {
    say(pathdep->key + " (path " + pathdep->path + ", required by mbuild.toml)");
    return 0;
  }
  if ((m == (DxMod*)0 || m->sel < 0) && rp == (DxRPath*)0) {
    error_msg(module + " is not in the build");
    return 1;
  }
  var reqs: DxReqs* = drq_new();
  var head: string = "";
  var reason: string = "";
  var rs: ReplaceSpec* = man_replace_find(p->man, module);
  if (rp != (DxRPath*)0) {
    head = module + " => " + rp->rel;
    reqs = rp->reqs;
  } else {
    head = module + " " + sl_get(m->labels, m->sel);
    reqs = dx_live_reqs(cx, m);
  }
  var rows: StrList* = sl_new();
  var i: int64 = 0;
  var rootpin: bool = false;
  while (i < reqs->len) {
    var r: DxReq* = dx_req_at(reqs, i);
    sl_add_uniq(rows, dx_chain(cx, r->from) + " requires " + r->spec);
    if (r->root && !sv_is(r->label) && slen(r->label) > 0) {
      rootpin = true;
    }
    i = i + 1;
  }
  if (rs != (ReplaceSpec*)0 && (rp != (DxRPath*)0 || (m != (DxMod*)0 && m->rep_req != (DxReq*)0) || slen(rs->url) > 0)) {
    reason = "replaced in mbuild.toml";
    if (rs->local) {
      reason = "replaced in mbuild.local.toml";
    }
  } else if (rootpin) {
    reason = "pinned by mbuild.toml";
  } else if (rows->len == 1) {
    reason = "the only requirement";
  } else {
    reason = "the highest of the versions required";
  }
  say(head + " (selected: " + reason + ")");
  say("  required by:");
  i = 0;
  while (i < rows->len) {
    say("    " + sl_get(rows, i));
    i = i + 1;
  }
  var hits: StrList* = sl_new();
  dx_import_hits(p->root, dx_import_prefixes(p->man, module), "", hits, false);
  i = 0;
  while (i < cx->paths->len) {
    var pp: DxPath* = dx_path_at(cx, i);
    if (!p_has_prefix_dir(pp->dir, p->root)) {
      dx_import_hits(pp->dir, dx_import_prefixes(pp->man, module), "path package " + pp->key + ": ", hits, false);
    }
    i = i + 1;
  }
  i = 0;
  while (i < ds->n) {
    var dm: DepModule* = &ds->mods[i];
    i = i + 1;
    if (dm->is_path || s_eq(dm->module, module)) {
      continue;
    }
    var label: string = dm->module + " " + dm->version + ": ";
    if (s_eq(dm->replaced, "path")) {
      label = dm->module + " (replaced): ";
    }
    dx_import_hits(dm->dir, dx_import_prefixes(dm->man, module), label, hits, false);
  }
  say("  imported by:");
  if (hits->len == 0) {
    say("    (not imported by any file: `mbuild tidy` would drop the requirement)");
  }
  i = 0;
  while (i < hits->len) {
    say("    " + sl_get(hits, i));
    i = i + 1;
  }
  free(hits);
  free(rows);
  return 0;
}

// ---------------------------------------------------------------------------
// mbuild outdated [-v] [MODULE] (12.13)
// ---------------------------------------------------------------------------

fn dx_outdated_row(cx: DxCx*, m: DxMod*, cells: StrList*, newer: StrList*) {
  var label: string = sl_get(m->labels, m->sel);
  var commit: string = sl_get(m->commits, m->sel);
  var tags: StrList* = git_tags(dx_mdir(m));
  var current: string = label;
  var compat: string = "-";
  var latest: string = "-";
  if (sv_is(label)) {
    var c: string = dx_newest_in_line(tags, label);
    if (slen(c) > 0) {
      compat = c;
    }
    var st: string = dx_newest_stable(tags);
    var top: string = sv_max(tags);
    if (slen(st) > 0 && sv_cmp(st, label) > 0 && !s_eq(sv_line(st), sv_line(label))) {
      latest = st + " (new line)";
    } else if (slen(top) > 0 && slen(sv_parse(top).pre) > 0 && sv_cmp(top, label) > 0 && (slen(st) == 0 || sv_cmp(top, st) > 0) && !s_eq(top, compat)) {
      latest = top + " (pre)";
    }
    var vs: StrList* = dx_semver_tags(tags);
    var i: int64 = vs->len - 1;
    while (i >= 0) {
      if (sv_cmp(sl_get(vs, i), label) > 0) {
        sl_push(newer, sl_get(vs, i));
      }
      i = i - 1;
    }
    free(vs);
  } else {
    current = label + " " + dx_short(commit);
    var head: string = git_rev(dx_mdir(m), "refs/heads/" + label);
    if (slen(head) > 0 && !s_eq(head, commit)) {
      compat = label + " " + dx_short(head);
    }
  }
  var by: string = "";
  var live: DxReqs* = dx_live_reqs(cx, m);
  var i2: int64 = 0;
  while (i2 < live->len) {
    var r: DxReq* = dx_req_at(live, i2);
    if (r->root) {
      by = "mbuild.toml";
    } else if (slen(by) == 0) {
      by = r->from;
    }
    i2 = i2 + 1;
  }
  free(live);
  if (slen(by) == 0) {
    by = "-";
  }
  sl_push(cells, m->module);
  sl_push(cells, current);
  sl_push(cells, compat);
  sl_push(cells, latest);
  sl_push(cells, by);
}

export fn deps_cmd_outdated(p: Project*) -> int32 {
  var only: string = "";
  if (p->opts->rest->len > 0) {
    only = sl_get(p->opts->rest, 0);
  }
  deps_ensure(p);
  var cx: DxCx* = dx_graph(p);
  defer free(cx);
  if (slen(only) > 0) {
    var named: string = dx_name_module(cx, only);
    if (slen(named) == 0 || dx_mod_find(cx, named) == (DxMod*)0) {
      error_msg(only + " is not in the build");
      return 1;
    }
    only = named;
  }
  var cells: StrList* = sl_of("MODULE");
  sl_push(cells, "CURRENT");
  sl_push(cells, "COMPATIBLE");
  sl_push(cells, "LATEST");
  sl_push(cells, "REQUIRED BY");
  var extra: StrList* = sl_of("");
  var i: int64 = 0;
  while (i < cx->mods->len) {
    var m: DxMod* = dx_mod_at(cx, i);
    i = i + 1;
    if (m->sel < 0 || (slen(only) > 0 && !s_eq(m->module, only))) {
      continue;
    }
    dx_mirror(cx, m, true);
    var newer: StrList* = sl_new();
    dx_outdated_row(cx, m, cells, newer);
    var b: Buf* = buf_new();
    if (p->opts->verbose) {
      var k: int64 = 0;
      while (k < newer->len && k < 5) {
        buf_line(b, "    " + sl_get(newer, k) + " " + git_tag_subject(dx_mdir(m), sl_get(newer, k)));
        k = k + 1;
      }
    }
    if (slen(only) > 0) {
      var n: int64 = cells->len;
      var to: string = sl_get(cells, n - 2);
      if (s_eq(to, "-")) {
        to = sl_get(cells, n - 3);
      }
      var sp: int64 = s_find_byte(to, 32);
      if (sp > 0) {
        to = s_sub(to, 0, sp);
      }
      var from: string = sl_get(m->labels, m->sel);
      if (!s_eq(to, "-") && sv_is(from) && sv_is(to)) {
        var q: ApiQuery* = new ApiQuery;
        q->module = m->module;
        q->from_version = from;
        q->to_version = to;
        q->files = (StrList*)0;
        q->with_added = true;
        var rep: string = deps_api_report(p, q);
        free(q);
        if (slen(rep) > 0) {
          buf_line(b, rep);
        }
      }
    }
    sl_push(extra, buf_take(b));
    free(newer);
  }
  var widths: int64* = (int64*)malloc(5 * 8);
  var c: int64 = 0;
  while (c < 5) {
    widths[c] = 0;
    c = c + 1;
  }
  i = 0;
  while (i < cells->len) {
    if (slen(sl_get(cells, i)) > widths[i % 5]) {
      widths[i % 5] = slen(sl_get(cells, i));
    }
    i = i + 1;
  }
  var row: int64 = 0;
  while (row * 5 < cells->len) {
    var b2: Buf* = buf_new();
    c = 0;
    while (c < 5) {
      var cell: string = sl_get(cells, row * 5 + c);
      if (c < 4) {
        buf_add(b2, s_pad_right(cell, widths[c] + 2));
      } else {
        buf_add(b2, cell);
      }
      c = c + 1;
    }
    say(s_trim(buf_take(b2)));
    var ex: string = sl_get(extra, row);
    if (slen(ex) > 0) {
      print(ex);
    }
    row = row + 1;
  }
  free(widths);
  free(cells);
  free(extra);
  if (p->opts->offline) {
    say("(--offline: mirrors not refreshed)");
  }
  return 0;
}

export fn deps_cmd_vendor(p: Project*) -> int32 {
  error_msg("mbuild vendor is not implemented yet (DESIGN.md 12.16)");
  return 1;
}

// ---------------------------------------------------------------------------
// mettle.deps adoption (12.9)
// ---------------------------------------------------------------------------

// Moves plain `name=dir` lines of the root mettle.deps into [dependencies];
// answers the keys adopted (with write false: the keys it would adopt).
fn dx_adopt(p: Project*, write: bool) -> StrList* {
  var adopted: StrList* = sl_new();
  var file: string = p->root + "/mettle.deps";
  var r: FsRead = fs_read(file);
  if (!r.ok || !p->has_manifest) {
    return adopted;
  }
  var lines: StrList* = s_lines(r.data);
  var kept: StrList* = sl_new();
  var text: string = dx_manifest_text(p);
  var inside: bool = false;
  var i: int64 = 0;
  while (i < lines->len) {
    var l: string = sl_get(lines, i);
    var t: string = s_trim(l);
    var n: int64 = i + 1;
    i = i + 1;
    var eq: int64 = s_find_byte(t, 61);
    var keep: bool = true;
    if (inside) {
      if (s_starts(t, "# <<< mbuild")) {
        inside = false;
      }
    } else if (s_starts(t, "# >>> mbuild")) {
      inside = true;
    } else if (slen(t) > 0 && !s_starts(t, "#") && eq > 0) {
      var name: string = s_trim(s_sub(t, 0, eq));
      var dir: string = s_trim(s_from(t, eq + 1));
      var abs: string = dir;
      if (!p_is_abs(dir)) {
        abs = p_join(p->root, dir);
      }
      abs = p_clean(abs);
      var where_at: string = "mettle.deps:" + s_int(n) + ": `" + t + "`";
      if (s_find_byte(name, 46) >= 0) {
        if (write) {
          warn(where_at + " cannot be a path dependency key; it stays in mettle.deps");
        }
      } else if (man_dep_find(p->man, name) != (DepSpec*)0) {
        if (write) {
          warn(where_at + ": " + name + " is already declared in mbuild.toml; remove the line");
        }
      } else if (!fs_is_dir(abs)) {
        if (write) {
          warn(where_at + ": " + abs + " does not exist; it stays in mettle.deps");
        }
      } else if (!p_has_prefix_dir(abs, p->state_dir)) {
        keep = false;
        sl_push(adopted, name);
        var lit: string = "{{ path = " + toml_quote(dir) + " }";
        text = toml_set_in_text(text, "dependencies", name, lit);
        if (write) {
          status("Adopted", name + " = " + lit + " from mettle.deps");
        }
      }
    }
    if (keep) {
      sl_push(kept, l);
    }
  }
  if (write && adopted->len > 0) {
    dx_refuse_locked(p, "adopting mettle.deps lines");
    dx_save_manifest(p, text);
    var joined: string = sl_join(kept, "\n");
    if (s_ends(r.data, "\n")) {
      joined = joined + "\n";
    }
    fs_write(file, joined);
  }
  free(lines);
  free(kept);
  return adopted;
}

export fn deps_adopt_mettle_deps(p: Project*, write: bool) -> int32 {
  var l: StrList* = dx_adopt(p, write);
  var n: int64 = l->len;
  free(l);
  return (int32)n;
}

// ---------------------------------------------------------------------------
// Snapshot, restore, update plans (12.13; build drives verification)
// ---------------------------------------------------------------------------

export fn deps_snapshot(p: Project*) -> DepSnap* {
  return dx_snap_take(p);
}

// Writes the snapshot back and checks the old commits out again (no
// network: the mirrors hold them). Prints nothing.
export fn deps_restore(p: Project*, s: DepSnap*) {
  var armed: DepSnap* = g_dx_guard;
  g_dx_guard = (DepSnap*)0;
  dx_snap_write(s);
  sys_remove_file(dx_stamp_path(p));
  var r: FsRead = fs_read(dx_manifest_path(p));
  if (r.ok) {
    var m: Manifest* = man_parse(toml_parse(r.data, dx_manifest_path(p)), p->root);
    if (slen(m->error) == 0) {
      p->man = m;
    }
  }
  var quiet: bool = g_quiet;
  g_quiet = true;
  dx_ensure(p, sl_new(), false);
  g_quiet = quiet;
  g_dx_guard = armed;
}

fn dx_plan_push(u: UpdatePlan*, module: string, from: string, to: string, kind: string, cands: string) {
  sl_push(u->mods, module);
  sl_push(u->froms, from);
  sl_push(u->tos, to);
  sl_push(u->kinds, kind);
  sl_push(u->cands, cands);
}

export fn deps_plan_update(p: Project*, r: UpdateReq*) -> UpdatePlan* {
  var u: UpdatePlan* = new UpdatePlan;
  u->mods = sl_new();
  u->froms = sl_new();
  u->tos = sl_new();
  u->kinds = sl_new();
  u->cands = sl_new();
  u->lines_mods = sl_new();
  u->lines_vers = sl_new();
  var cx: DxCx* = dx_cx_new(p);
  dx_collect_paths(cx);
  var only: StrList* = sl_new();
  var i: int64 = 0;
  if (r->modules != (StrList*)0) {
    while (i < r->modules->len) {
      var name: string = sl_get(r->modules, i);
      var d: DepSpec* = man_dep_find(p->man, name);
      if (d != (DepSpec*)0 && slen(d->module) > 0) {
        sl_push(only, d->module);
      } else if (sl_has(cx->lock->mods, name)) {
        sl_push(only, name);
      } else {
        dx_fail(name + " is neither a dependency in mbuild.toml nor a module in mbuild.lock");
      }
      i = i + 1;
    }
  }
  // (module, spec, url) of everything the plan looks at.
  var mods: StrList* = sl_new();
  var specs: StrList* = sl_new();
  var urls: StrList* = sl_new();
  i = 0;
  while (i < p->man->ndeps) {
    var dep: DepSpec* = man_dep(p->man, i);
    i = i + 1;
    if (slen(dep->path) > 0 || slen(dep->module) == 0 || dx_is_local_module(cx, dep->module) || sl_has(mods, dep->module)) {
      continue;
    }
    if (only->len > 0 && !sl_has(only, dep->module)) {
      continue;
    }
    sl_push(mods, dep->module);
    sl_push(specs, dep->version);
    sl_push(urls, dep->url);
  }
  i = 0;
  while (i < cx->lock->mods->len) {
    var lm: string = sl_get(cx->lock->mods, i);
    i = i + 1;
    if (sl_has(mods, lm) || dx_is_local_module(cx, lm)) {
      continue;
    }
    if ((only->len > 0 && sl_has(only, lm)) || (only->len == 0 && r->all)) {
      sl_push(mods, lm);
      sl_push(specs, sl_get(cx->lock->vers, i - 1));
      sl_push(urls, s_empty());
    }
  }
  i = 0;
  while (i < mods->len) {
    var module: string = sl_get(mods, i);
    var spec: string = sl_get(specs, i);
    var m: DxMod* = dx_mod_get(cx, module, sl_get(urls, i));
    var rs: ReplaceSpec* = man_replace_find(p->man, module);
    if (rs != (ReplaceSpec*)0 && slen(rs->url) > 0) {
      m->url = rs->url;
    }
    i = i + 1;
    var rq: DxReq* = new DxReq;
    rq->from = "mbuild.toml";
    drq_push(m->reqs, rq);
    dx_mirror(cx, m, true);
    var tags: StrList* = git_tags(dx_mdir(m));
    var li: int64 = sl_index(cx->lock->mods, module);
    var lv: string = "";
    var lc: string = "";
    if (li >= 0) {
      lv = sl_get(cx->lock->vers, li);
      lc = sl_get(cx->lock->commits, li);
    }
    var direct: bool = man_dep_find(p->man, module) != (DepSpec*)0;
    if (sv_is(spec) && !dx_is_partial(spec)) {
      var cur: string = spec;
      if (sv_is(lv) && sv_cmp(lv, spec) > 0) {
        cur = lv;
      }
      var target: string = "";
      if (r->major) {
        target = dx_newest_stable(tags);
        if (slen(target) > 0 && sv_cmp(target, cur) <= 0) {
          target = s_empty();
        }
      } else {
        target = dx_newest_in_line(tags, cur);
      }
      if (!direct && !r->all) {
        // A named transitive module: only its pin moves (a moved tag).
        target = s_empty();
      }
      if (slen(target) > 0) {
        var kind: string = "compatible";
        if (!s_eq(sv_line(target), sv_line(cur))) {
          kind = "major";
        }
        dx_plan_push(u, module, cur, target, kind, dx_candidates(tags, cur, target, r->major));
      } else if (slen(lc) > 0 && sv_is(lv)) {
        var now: string = git_rev(dx_mdir(m), "refs/tags/" + lv);
        if (slen(now) > 0 && !s_eq(now, lc)) {
          dx_plan_push(u, module, lv + " " + dx_short(lc), lv + " " + dx_short(now), "pin", s_empty());
        }
      }
      var base: string = cur;
      if (slen(target) > 0) {
        base = target;
      }
      var st: string = dx_newest_stable(tags);
      if (!r->major && slen(st) > 0 && sv_cmp(st, base) > 0 && !s_eq(sv_line(st), sv_line(base))) {
        sl_push(u->lines_mods, module);
        sl_push(u->lines_vers, st);
      }
    } else if (s_eq(spec, "latest") || (!sv_is(spec) && !dx_is_hex_id(spec))) {
      var req: DxReq* = new DxReq;
      req->module = module;
      req->spec = spec;
      req->url = m->url;
      req->from = "mbuild.toml";
      req->root = true;
      req->label = s_empty();
      req->commit = s_empty();
      req->fresh = false;
      if (s_eq(spec, "latest")) {
        dx_pick_latest(cx, m, req);
      } else {
        dx_pick_named(cx, m, req);
      }
      if (slen(lc) > 0 && !s_eq(req->commit, lc)) {
        dx_plan_push(u, module, lv + " " + dx_short(lc), req->label + " " + dx_short(req->commit), "pin", s_empty());
      }
      free(req);
    }
  }
  free(only);
  free(mods);
  free(specs);
  free(urls);
  free(cx);
  return u;
}

// get/update: set each module's version in mbuild.toml (adding transitive
// ones), unpin them, resolve. vers may carry "label short" (pins): the
// first field counts.
fn dx_apply(p: Project*, mods: StrList*, vers: StrList*, quiet: bool) -> DepState* {
  dx_arm(p);
  var text: string = dx_manifest_text(p);
  var lock: DxLock* = dx_lock_read(p);
  var edited: bool = false;
  var unpin: StrList* = sl_new();
  var i: int64 = 0;
  while (i < mods->len) {
    var module: string = sl_get(mods, i);
    var ver: string = sl_get(vers, i);
    i = i + 1;
    var sp: int64 = s_find_byte(ver, 32);
    if (sp > 0) {
      ver = s_sub(ver, 0, sp);
    }
    var d: DepSpec* = man_dep_find(p->man, module);
    var pair: StrList* = sl_of(ver);
    sl_push(pair, module);
    if (d == (DepSpec*)0) {
      var li: int64 = sl_index(lock->mods, module);
      if (sv_is(ver) && (li < 0 || !s_eq(sl_get(lock->vers, li), ver))) {
        text = dx_text_set_version(text, d, pair);
        edited = true;
      }
    } else if (slen(d->path) == 0 && sv_is(ver) && !s_eq(d->version, ver)) {
      text = dx_text_set_version(text, d, pair);
      edited = true;
    }
    free(pair);
    sl_push(unpin, module);
  }
  if (edited) {
    dx_save_manifest(p, text);
  }
  var quiet_was: bool = g_quiet;
  if (quiet) {
    g_quiet = true;
  }
  var refresh_was: bool = g_dx_refresh;
  g_dx_refresh = true;
  var ds: DepState* = dx_ensure(p, unpin, true);
  free(unpin);
  g_dx_refresh = refresh_was;
  g_quiet = quiet_was;
  dx_disarm();
  return ds;
}

// Prints no status lines (build prints the summary); warnings still show.
// An error that stops resolution writes the files back first.
export fn deps_apply(p: Project*, mods: StrList*, vers: StrList*) -> DepState* {
  return dx_apply(p, mods, vers, true);
}

// ---------------------------------------------------------------------------
// API report (12.13)
// ---------------------------------------------------------------------------

fn dx_mod_url(p: Project*, module: string) -> string {
  var rs: ReplaceSpec* = man_replace_find(p->man, module);
  if (rs != (ReplaceSpec*)0 && slen(rs->url) > 0) {
    return rs->url;
  }
  var d: DepSpec* = man_dep_find(p->man, module);
  if (d != (DepSpec*)0) {
    return d->url;
  }
  return s_empty();
}

// The exported surface of module at version: the existing checkout when it
// is that commit, else a temporary checkout. 0 when the version is unknown.
fn dx_surface(p: Project*, module: string, version: string) -> ApiSurface* {
  var mirror: string = git_mirror_dir(module, dx_mod_url(p, module));
  if (!git_has_mirror(mirror)) {
    return (ApiSurface*)0;
  }
  var commit: string = git_rev(mirror, "refs/tags/" + version);
  if (slen(commit) == 0) {
    commit = dx_rev_named(mirror, version);
  }
  if (slen(commit) == 0) {
    return (ApiSurface*)0;
  }
  var cur: string = dx_deps_dir(p) + "/" + module;
  if (s_eq(git_checkout_commit(cur), commit) && !sys_is_link(cur)) {
    return api_surface_dir(cur);
  }
  var tmp: string = p->state_dir + "/tmp/api/" + module + "@" + version;
  var e: string = git_checkout(mirror, commit, tmp);
  if (slen(e) > 0) {
    verbose("cannot check out " + module + " " + version + " for its API: " + git_summary(e));
    sys_remove_tree(tmp);
    return (ApiSurface*)0;
  }
  var surf: ApiSurface* = api_surface_dir(tmp);
  sys_remove_tree(tmp);
  return surf;
}

export fn deps_api_report(p: Project*, q: ApiQuery*) -> string {
  var old: ApiSurface* = dx_surface(p, q->module, q->from_version);
  var cur: ApiSurface* = dx_surface(p, q->module, q->to_version);
  if (old == (ApiSurface*)0 || cur == (ApiSurface*)0) {
    return s_empty();
  }
  var d: ApiDiff* = api_diff(old, cur);
  var breaking: ApiDiff* = api_breaking(d);
  if (!q->with_added) {
    d = breaking;
  }
  if (d->what->len == 0) {
    return s_empty();
  }
  var files: StrList* = q->files;
  if (files == (StrList*)0 || files->len == 0) {
    var cx: DxCx* = dx_cx_new(p);
    dx_collect_paths(cx);
    files = dx_files_importing(p, cx, q->module);
    free(cx);
  }
  var uses: StrList* = sl_new();
  var i: int64 = 0;
  while (i < files->len) {
    var f: string = sl_get(files, i);
    i = i + 1;
    var abs: string = f;
    if (!p_is_abs(f)) {
      abs = p_join(p->root, f);
    }
    var shown: string = abs;
    if (p_has_prefix_dir(abs, p->root)) {
      shown = p_rel(p->root, abs);
    }
    var r: FsRead = fs_read(abs);
    if (!r.ok) {
      continue;
    }
    var found: StrList* = scan_uses(r.data, d->names);
    var k: int64 = 0;
    while (k < found->len) {
      var u: string = sl_get(found, k);
      var sp: int64 = s_rfind_byte(u, 32);
      if (sp > 0) {
        sl_push(uses, s_sub(u, 0, sp) + " " + shown + ":" + s_from(u, sp + 1));
      }
      k = k + 1;
    }
    free(found);
  }
  var header: string = "  API changes from " + q->from_version + " to " + q->to_version;
  if (breaking->what->len > 0 && s_eq(sv_line(q->from_version), sv_line(q->to_version)) && slen(sv_line(q->to_version)) > 0) {
    header = header + " (inside line " + sv_line(q->to_version) + ", which should not break)";
  }
  var report: string = header + ":\n" + api_render(d, uses);
  free(uses);
  return report;
}

// ---------------------------------------------------------------------------
// Mettle version requirements (12.11)
// ---------------------------------------------------------------------------

// The highest [package] mettle among the selected packages:
// ["v0.99.0", "github.com/demo/needs v1.0.0"], or empty.
export fn deps_mettle_minimum(ds: DepState*) -> StrList* {
  var need: string = "";
  var who: string = "";
  var i: int64 = 0;
  while (i < ds->n) {
    var dm: DepModule* = &ds->mods[i];
    i = i + 1;
    if (dm->man == (Manifest*)0 || !sv_is(dm->man->mettle_min)) {
      continue;
    }
    if (slen(need) == 0 || sv_cmp(dm->man->mettle_min, need) > 0) {
      need = dm->man->mettle_min;
      who = dm->module;
      if (slen(dm->version) > 0) {
        who = dm->module + " " + dm->version;
      }
    }
  }
  var l: StrList* = sl_new();
  if (slen(need) > 0) {
    sl_push(l, need);
    sl_push(l, who);
  }
  return l;
}

// For who = "MODULE VERSION": ", or require MODULE vX, the newest version
// that supports Mettle HAVE" (the newest stable tag before VERSION, at most 20
// looked at, whose [package] mettle is absent or <= have), or "".
export fn deps_mettle_fallback(p: Project*, who: string, have: string) -> string {
  var sp: int64 = s_find_byte(who, 32);
  if (sp < 0 || !sv_is(have)) {
    return s_empty();
  }
  var module: string = s_sub(who, 0, sp);
  var version: string = s_from(who, sp + 1);
  var mirror: string = git_mirror_dir(module, dx_mod_url(p, module));
  if (!sv_is(version) || !git_has_mirror(mirror)) {
    return s_empty();
  }
  var vs: StrList* = dx_semver_tags(git_tags(mirror));
  var found: string = "";
  var looked: int64 = 0;
  var i: int64 = vs->len - 1;
  while (i >= 0 && looked < 20 && slen(found) == 0) {
    var t: string = sl_get(vs, i);
    i = i - 1;
    if (sv_cmp(t, version) >= 0 || slen(sv_parse(t).pre) > 0) {
      continue;
    }
    looked = looked + 1;
    var c: string = git_rev(mirror, "refs/tags/" + t);
    var g: GitShow* = git_show(mirror, c, "mbuild.toml");
    if (!g->ok) {
      continue;
    }
    var need: string = "";
    if (g->found) {
      var nm: Manifest* = man_parse(toml_parse(g->text, module + "@" + t + "/mbuild.toml"), p->root);
      need = nm->mettle_min;
    }
    if (!sv_is(need) || sv_cmp(need, have) <= 0) {
      found = t;
    }
  }
  free(vs);
  if (slen(found) == 0) {
    return s_empty();
  }
  return ", or require " + module + " " + found + ", the newest version that supports Mettle " + have;
}

// The whole 12.11 check for one compiler: "" or the error text (without
// "error: "), the project's own [package] mettle included.
export fn deps_mettle_check(p: Project*, ds: DepState*, m: Mettle*) -> string {
  var l: StrList* = deps_mettle_minimum(ds);
  var need: string = "";
  var who: string = "";
  if (l->len >= 2) {
    need = sl_get(l, 0);
    who = sl_get(l, 1);
  }
  free(l);
  if (sv_is(p->man->mettle_min) && (slen(need) == 0 || sv_cmp(p->man->mettle_min, need) > 0)) {
    need = p->man->mettle_min;
    who = p->man->name;
    if (slen(who) == 0) {
      who = "this project";
    }
  }
  if (slen(need) == 0) {
    return s_empty();
  }
  var e: string = tc_require_minimum(m, need, who);
  if (slen(e) == 0) {
    return e;
  }
  return e + deps_mettle_fallback(p, who, tc_version(m));
}
