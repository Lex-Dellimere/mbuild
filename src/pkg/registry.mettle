// registry: package registries (DESIGN.md 13): the search order, the index,
// manifests and archives in the download cache, extraction, publishing.
//
// A registry is a static tree of one of two kinds: mbuild's own (index/<name>,
// pkg/<name>/<name>-<v>.toml and .tar.gz) or the Mettle project's (13.9:
// v1/index.json, v1/archives/*.tar holding a mettle.package). Remote ones (http, https) are read with curl, local ones (a path
// or file://) with fs_*; either way every file goes through the cache at
// $MBUILD_HOME/registry/<name>@<hash12(url)>/, so --offline behaves the same
// for both. Everything but an index is immutable once published.

import "std/io";
import "std/mem";
import "../core/base";
import "../core/path";
import "../core/fs";
import "../core/proc";
import "../core/sha256";
import "../core/sys_linux" if linux;
import "../core/sys_windows" if windows;
import "../model/toml";
import "../model/semver";
import "../model/manifest";
import "../model/project";

// The registry named `default` when neither MBUILD_REGISTRY nor the project
// names one. To be decided (DESIGN.md 16).
const REG_DEFAULT_URL: string = "";

export struct RegVersion {
  version: string;
  sha: string;
  manifest_sha: string;
  yanked: bool;
  archive: string;  // json kind: the archive path relative to v1/
}

export struct RegIndex {
  name: string;
  registry: string;
  url: string;
  kind: string;     // "mbuild" | "json"
  found: bool;
  ok: bool;
  err: string;
  versions: RegVersion*;
  n: int64;
}

export struct RegList {
  names: StrList*;
  urls: StrList*;
}

export struct RegPublish {
  dir: string;
  name: string;
  version: string;
  root: string;
  files: StrList*;
  manifest_text: string;
  dry_run: bool;
}

var g_rgx_err: string;
var g_rgx_kind: string;
// Per command: the cached path of every index fetched (or found missing),
// registries warned about.
var g_rgx_fetched: StrList* = (StrList*)0;
var g_rgx_warned: StrList* = (StrList*)0;
var g_rgx_seq: int64 = 0;
// Per command: "<cache dir> <kind>" of every registry probed.
var g_rgx_kinds: StrList* = (StrList*)0;

fn rgx_set(kind: string, msg: string) {
  g_rgx_kind = kind;
  g_rgx_err = msg;
}

fn rgx_clear() {
  g_rgx_kind = s_empty();
  g_rgx_err = s_empty();
}

// True the first time key is seen in this command.
fn rgx_once(key: string) -> bool {
  if (g_rgx_warned == (StrList*)0) {
    g_rgx_warned = sl_new();
  }
  if (sl_has(g_rgx_warned, key)) {
    return false;
  }
  sl_push(g_rgx_warned, key);
  return true;
}

fn rgx_sl_free(l: StrList*) {
  free(l->items);
  free(l);
}

fn rgx_cmd_free(c: Cmd*) {
  rgx_sl_free(c->args);
  rgx_sl_free(c->kinds);
  rgx_sl_free(c->env);
  free(c);
}

fn rgx_short(hex: string) -> string {
  return "sha256:" + s_sub(hex, 0, 16) + "...";
}

fn rgx_bare_sha(s: string) -> string {
  if (s_starts(s, "sha256:")) {
    return s_from(s, 7);
  }
  return s;
}

// ---------------------------------------------------------------------------
// Registries and their URLs
// ---------------------------------------------------------------------------

fn rgx_env_name(name: string) -> string {
  var b: Buf* = buf_new();
  buf_add(b, "MBUILD_REGISTRY_");
  var i: int64 = 0;
  while (i < slen(name)) {
    var c: int32 = s_byte(name, i);
    if (c >= 97 && c <= 122) {
      c = c - 32;
    } else if (c == 45) {
      c = 95;
    }
    buf_addb(b, c);
    i = i + 1;
  }
  return buf_take(b);
}

// $MBUILD_REGISTRY_<NAME>, then mbuild.local.mettle, then mbuild.mettle
// (`declared`), then for default $MBUILD_REGISTRY and REG_DEFAULT_URL.
fn rgx_url_of(p: Project*, name: string, declared: string) -> string {
  var ev: string = env_get(rgx_env_name(name));
  if (slen(ev) > 0) {
    return ev;
  }
  if (p->man->local != (Manifest*)0) {
    var lr: RegSpec* = man_reg_find(p->man->local, name);
    if (lr != (RegSpec*)0 && slen(lr->url) > 0) {
      return lr->url;
    }
  }
  if (slen(declared) > 0) {
    return declared;
  }
  if (s_eq(name, "default")) {
    var dv: string = env_get("MBUILD_REGISTRY");
    if (slen(dv) > 0) {
      return dv;
    }
    return REG_DEFAULT_URL;
  }
  return s_empty();
}

export fn reg_list(p: Project*) -> RegList* {
  var l: RegList* = new RegList;
  l->names = sl_new();
  l->urls = sl_new();
  var i: int64 = 0;
  while (i < p->man->nregs) {
    var r: RegSpec* = &p->man->regs[i];
    if (!sl_has(l->names, r->name)) {
      sl_push(l->names, r->name);
      sl_push(l->urls, rgx_url_of(p, r->name, r->url));
    }
    i = i + 1;
  }
  if (!sl_has(l->names, "default")) {
    sl_push(l->names, "default");
    sl_push(l->urls, rgx_url_of(p, "default", s_empty()));
  }
  return l;
}

fn rgx_is_remote(url: string) -> bool {
  return s_starts(url, "https://") || s_starts(url, "http://");
}

// The directory of a path or file:// URL (relative paths against the root).
fn rgx_local_dir(p: Project*, url: string) -> string {
  var d: string = url;
  if (s_starts(d, "file://")) {
    d = s_from(d, 7);
    // file:///C:/x
    if (slen(d) >= 3 && s_byte(d, 0) == 47 && s_byte(d, 2) == 58) {
      d = s_from(d, 1);
    }
  }
  d = s_replace_byte(d, 92, 47);
  if (!p_is_abs(d)) {
    d = p_join(p->root, d);
  }
  return p_clean(d);
}

fn rgx_trim_slash(url: string) -> string {
  var u: string = url;
  while (slen(u) > 1 && s_byte(u, slen(u) - 1) == 47) {
    u = s_sub(u, 0, slen(u) - 1);
  }
  return u;
}

// The URL of registry `name`, "" (with the error set) when it has none.
fn rgx_lookup(p: Project*, name: string) -> string {
  var l: RegList* = reg_list(p);
  var at: int64 = sl_index(l->names, name);
  var url: string = s_empty();
  if (at >= 0) {
    url = sl_get(l->urls, at);
  }
  rgx_sl_free(l->names);
  rgx_sl_free(l->urls);
  free(l);
  if (at < 0) {
    rgx_set("other", "unknown registry " + name + "\n  help: declare it in mbuild.mettle: mb_registry(\"" + name + "\", \"https://...\")");
    return s_empty();
  }
  if (slen(url) == 0) {
    if (s_eq(name, "default")) {
      rgx_set("other", "no default registry is configured\n  help: set MBUILD_REGISTRY, or declare one in mbuild.mettle: mb_registry(\"name\", \"https://...\")");
    } else {
      rgx_set("other", "registry " + name + " has no url");
    }
    return s_empty();
  }
  return rgx_trim_slash(url);
}

export fn reg_dir_of(p: Project*, registry: string) -> string {
  var url: string = rgx_lookup(p, registry);
  if (slen(url) == 0 || rgx_is_remote(url)) {
    return s_empty();
  }
  return rgx_local_dir(p, url);
}

fn rgx_cache_dir(registry: string, url: string) -> string {
  var h: string = sha_string(url);
  return fs_mbuild_home() + "/registry/" + registry + "@" + s_sub(h, 0, 12);
}

// ---------------------------------------------------------------------------
// Getting one file into the cache
// ---------------------------------------------------------------------------

fn rgx_host_tool(name: string, env_override: string) -> Tool {
  var ev: string = env_get(env_override);
  if (slen(ev) > 0) {
    return sys_find_tool(ev);
  }
  if (!sys_is_wine()) {
    return sys_find_tool(name);
  }
  var unix_path: string = env_get("MBUILD_UNIX_PATH");
  if (slen(unix_path) == 0) {
    unix_path = sys_unix_path_default();
  }
  var dirs: StrList* = s_split(unix_path, 58);
  var i: int64 = 0;
  while (i < dirs->len) {
    var d: string = sl_get(dirs, i);
    if (slen(d) > 0) {
      var t: Tool = sys_find_tool(p_join(d, name));
      if (tool_found(t) && t.unix) {
        rgx_sl_free(dirs);
        return t;
      }
    }
    i = i + 1;
  }
  rgx_sl_free(dirs);
  return tool_none();
}

// "Could not resolve host: x" from curl's "curl: (6) Could not resolve host: x".
fn rgx_curl_message(out: string) -> string {
  var lines: StrList* = s_lines(out);
  var i: int64 = 0;
  while (i < lines->len) {
    var ln: string = s_trim(sl_get(lines, i));
    if (s_starts(ln, "curl: (")) {
      var close: int64 = s_find(ln, ") ");
      if (close > 0) {
        rgx_sl_free(lines);
        return s_from(ln, close + 2);
      }
    }
    i = i + 1;
  }
  rgx_sl_free(lines);
  return s_trim(out);
}

fn rgx_curl_kind(code: int32) -> string {
  if (code == 22 || code == 37) {
    return "missing";
  }
  if (code == 6 || code == 7 || code == 28 || code == 35 || code == 52 || code == 56) {
    return "network";
  }
  return "other";
}

fn rgx_tmp_name(dest: string) -> string {
  g_rgx_seq = g_rgx_seq + 1;
  var tag: string = hash_string(dest + "{sys_now_ms()}-{g_rgx_seq}");
  return dest + ".tmp-" + s_sub(tag, 0, 8);
}

// Copies or downloads `rel` of the registry at url to dest (temp + rename).
// False with the error and kind set; the message names the source.
fn rgx_get(p: Project*, registry: string, url: string, rel: string, dest: string) -> bool {
  rgx_clear();
  if (!fs_mkdirs(p_dir(dest))) {
    rgx_set("other", "cannot create " + p_dir(dest));
    return false;
  }
  var tmp: string = rgx_tmp_name(dest);
  if (!rgx_is_remote(url)) {
    var dir: string = rgx_local_dir(p, url);
    var src: string = dir + "/" + rel;
    if (!fs_is_dir(dir)) {
      rgx_set("other", "registry " + registry + " is not reachable: " + dir + " is not a directory");
      return false;
    }
    if (!fs_is_file(src)) {
      rgx_set("missing", src + " does not exist");
      return false;
    }
    verbose("copy " + src);
    if (!fs_copy(src, tmp)) {
      rgx_set("other", "cannot copy " + src + " to " + tmp);
      return false;
    }
  } else {
    if (s_starts(url, "http://") && rgx_once("http " + registry)) {
      warn("registry " + registry + " uses http://; locked builds are still checked against mbuild.lock, new versions are not");
    }
    var curl: Tool = rgx_host_tool("curl", "MBUILD_CURL");
    if (!tool_found(curl)) {
      rgx_set("other", "cannot find `curl` (needed to download from registry " + registry + ")\n  help: install curl and put it on PATH, or set MBUILD_CURL to its path");
      return false;
    }
    var c: Cmd* = cmd_new(curl);
    cmd_arg(c, "-fsSL");
    cmd_arg(c, "--retry");
    cmd_arg(c, "2");
    cmd_arg(c, "--netrc-optional");
    cmd_arg(c, "-o");
    cmd_path(c, tmp);
    cmd_arg(c, url + "/" + rel);
    var r: Captured = proc_capture_all(c);
    rgx_cmd_free(c);
    if (r.code != 0) {
      sys_remove_file(tmp);
      rgx_set(rgx_curl_kind(r.code), "curl: " + rgx_curl_message(r.out) + " (" + url + "/" + rel + ")");
      return false;
    }
  }
  if (!sys_rename(tmp, dest)) {
    sys_remove_file(tmp);
    rgx_set("other", "cannot write " + dest);
    return false;
  }
  return true;
}

// ---------------------------------------------------------------------------
// The index
// ---------------------------------------------------------------------------

fn rgx_index_new(name: string, registry: string, url: string) -> RegIndex* {
  var ix: RegIndex* = new RegIndex;
  ix->name = name;
  ix->registry = registry;
  ix->url = url;
  ix->kind = "mbuild";
  ix->found = false;
  ix->ok = false;
  ix->err = s_empty();
  ix->versions = (RegVersion*)0;
  ix->n = 0;
  return ix;
}

fn rgx_index_fail(ix: RegIndex*) -> RegIndex* {
  ix->ok = false;
  ix->err = g_rgx_err;
  return ix;
}

fn rgx_parse_index(ix: RegIndex*, text: string) {
  var lines: StrList* = s_lines(text);
  var i: int64 = 0;
  while (i < lines->len) {
    var f: StrList* = s_fields(sl_get(lines, i));
    if (f->len > 0 && !s_starts(sl_get(f, 0), "#") && sv_is(sl_get(f, 0))) {
      var v: RegVersion;
      v.version = sl_get(f, 0);
      v.sha = s_empty();
      v.manifest_sha = s_empty();
      v.yanked = false;
      v.archive = s_empty();
      var k: int64 = 1;
      while (k < f->len) {
        var w: string = sl_get(f, k);
        if (s_starts(w, "sha256=")) {
          v.sha = s_from(w, 7);
        } else if (s_starts(w, "manifest=")) {
          v.manifest_sha = s_from(w, 9);
        } else if (s_eq(w, "yanked")) {
          v.yanked = true;
        }
        k = k + 1;
      }
      ix->versions = (RegVersion*)realloc(ix->versions, (ix->n + 1) * sizeof(RegVersion));
      ix->versions[ix->n] = v;
      ix->n = ix->n + 1;
    }
    rgx_sl_free(f);
    i = i + 1;
  }
  rgx_sl_free(lines);
}

fn rgx_offline_msg(what: string) -> string {
  return what + " is not in the download cache and --offline forbids fetching it\n  help: run mbuild fetch once while online";
}

export fn reg_index(p: Project*, registry: string, name: string, refresh: bool) -> RegIndex* {
  rgx_clear();
  var url: string = rgx_lookup(p, registry);
  if (slen(url) == 0) {
    return rgx_index_fail(rgx_index_new(name, registry, url));
  }
  return rgx_index(p, registry, url, name, refresh);
}

// The index of name in the registry directory dir (publish --to DIR), which
// need not be one of the project's registries; named after the directory.
export fn reg_index_dir(p: Project*, dir: string, name: string, refresh: bool) -> RegIndex* {
  rgx_clear();
  return rgx_index(p, p_base(dir), dir, name, refresh);
}

fn rgx_index(p: Project*, registry: string, url: string, name: string, refresh: bool) -> RegIndex* {
  var ix: RegIndex* = rgx_index_new(name, registry, url);
  if (g_rgx_fetched == (StrList*)0) {
    g_rgx_fetched = sl_new();
  }
  var kind: string = rgx_kind(p, registry, url);
  if (slen(kind) == 0) {
    return rgx_index_fail(ix);
  }
  ix->kind = kind;
  if (s_eq(kind, "json")) {
    return rgx_index_json(p, ix, refresh);
  }
  var cached: string = rgx_cache_dir(registry, url) + "/index/" + name;
  var have: bool = fs_is_file(cached);
  var key: string = cached;
  var fetch: bool = (refresh || !have) && !sl_has(g_rgx_fetched, key);
  if (fetch && p->opts->offline) {
    if (!have) {
      ix->ok = true;
      rgx_set("missing", rgx_offline_msg("the index of " + name + " from registry " + registry));
      ix->err = g_rgx_err;
      return ix;
    }
    fetch = false;
  }
  if (fetch) {
    if (g_verbose) {
      status("Updating", "index of " + name + " (" + registry + ")");
    }
    if (!rgx_get(p, registry, url, "index/" + name, cached)) {
      if (s_eq(g_rgx_kind, "missing")) {
        sl_push(g_rgx_fetched, key);
        ix->ok = true;
        ix->err = g_rgx_err;
        return ix;
      }
      if (!have) {
        return rgx_index_fail(ix);
      }
      if (rgx_once("unreachable " + registry)) {
        warn("registry " + registry + " is unreachable (" + g_rgx_err + "); using the cached index");
      }
      rgx_clear();
    }
    sl_push(g_rgx_fetched, key);
  } else if (!have) {
    // Already asked in this command and the registry had none.
    ix->ok = true;
    rgx_set("missing", "registry " + registry + " has no package named " + name);
    ix->err = g_rgx_err;
    return ix;
  }
  var r: FsRead = fs_read(cached);
  if (!r.ok) {
    rgx_set("other", "cannot read " + cached);
    return rgx_index_fail(ix);
  }
  rgx_parse_index(ix, r.data);
  ix->found = true;
  ix->ok = true;
  return ix;
}

export fn reg_find(p: Project*, name: string, pinned: string, refresh: bool) -> RegIndex* {
  if (slen(pinned) > 0) {
    return reg_index(p, pinned, name, refresh);
  }
  var l: RegList* = reg_list(p);
  var offline_miss: string = s_empty();
  var i: int64 = 0;
  while (i < l->names->len) {
    var ix: RegIndex* = reg_index(p, sl_get(l->names, i), name, refresh);
    if (!ix->ok || ix->found) {
      rgx_sl_free(l->names);
      rgx_sl_free(l->urls);
      free(l);
      return ix;
    }
    if (s_contains(ix->err, "--offline") && slen(offline_miss) == 0) {
      offline_miss = ix->err;
    }
    i = i + 1;
  }
  var none: RegIndex* = rgx_index_new(name, s_empty(), s_empty());
  none->ok = true;
  if (slen(offline_miss) > 0) {
    rgx_set("missing", offline_miss);
  } else {
    rgx_set("missing", "no registry has a package named " + name + " (searched " + sl_join(l->names, ", ") + ")");
  }
  rgx_sl_free(l->names);
  rgx_sl_free(l->urls);
  free(l);
  none->err = g_rgx_err;
  return none;
}

export fn reg_version(ix: RegIndex*, version: string) -> RegVersion* {
  var i: int64 = 0;
  while (i < ix->n) {
    var v: string = ix->versions[i].version;
    if (s_eq(v, version) || (sv_is(version) && sv_cmp(v, version) == 0)) {
      return &ix->versions[i];
    }
    i = i + 1;
  }
  return (RegVersion*)0;
}

// ---------------------------------------------------------------------------
// The Mettle registry (13.9): v1/index.json, plain tar archives
// ---------------------------------------------------------------------------

// "json" when the registry has v1/index.json, else "mbuild"; "" with the
// error set when it cannot be reached. Probed once and kept in the cache.
fn rgx_kind(p: Project*, registry: string, url: string) -> string {
  var cache: string = rgx_cache_dir(registry, url);
  if (g_rgx_kinds == (StrList*)0) {
    g_rgx_kinds = sl_new();
  }
  var i: int64 = 0;
  while (i < g_rgx_kinds->len) {
    var f: StrList* = s_fields(sl_get(g_rgx_kinds, i));
    if (f->len == 2 && s_eq(sl_get(f, 0), cache)) {
      var known: string = sl_get(f, 1);
      rgx_sl_free(f);
      return known;
    }
    rgx_sl_free(f);
    i = i + 1;
  }
  var kind: string = rgx_kind_probe(p, registry, url, cache);
  if (slen(kind) > 0) {
    sl_push(g_rgx_kinds, cache + " " + kind);
  }
  return kind;
}

fn rgx_kind_probe(p: Project*, registry: string, url: string, cache: string) -> string {
  var kf: string = cache + "/kind";
  var r: FsRead = fs_read(kf);
  if (r.ok) {
    var t: string = s_trim(r.data);
    if (s_eq(t, "json") || s_eq(t, "mbuild")) {
      return t;
    }
  }
  var idx: string = cache + "/v1/index.json";
  if (fs_is_file(idx)) {
    return "json";
  }
  if (p->opts->offline) {
    return "mbuild";
  }
  if (rgx_get(p, registry, url, "v1/index.json", idx)) {
    sl_push(g_rgx_fetched, idx);
    fs_write(kf, "json\n");
    return "json";
  }
  if (s_eq(g_rgx_kind, "missing")) {
    rgx_clear();
    fs_write(kf, "mbuild\n");
    return "mbuild";
  }
  if (fs_is_dir(cache + "/index")) {
    // An mbuild registry cached before kinds were probed.
    rgx_clear();
    return "mbuild";
  }
  return s_empty();
}

// A minimal JSON reader, enough for v1/index.json.
struct RgjVal {
  kind: int32;     // 0 null, 1 bool, 2 number, 3 string, 4 array, 5 object
  text: string;    // "true"/"false", the number as written, the decoded string
  keys: StrList*;  // object keys, parallel to vals
  vals: RgjVal**;
  n: int64;
}

struct RgjP {
  s: string;
  i: int64;
  err: string;
  depth: int64;
}

fn rgj_new(kind: int32) -> RgjVal* {
  var v: RgjVal* = new RgjVal;
  v->kind = kind;
  v->text = s_empty();
  v->keys = sl_new();
  v->vals = (RgjVal**)0;
  v->n = 0;
  return v;
}

fn rgj_push(v: RgjVal*, item: RgjVal*) {
  v->vals = (RgjVal**)realloc(v->vals, (v->n + 1) * 8);
  v->vals[v->n] = item;
  v->n = v->n + 1;
}

fn rgj_fail(q: RgjP*, msg: string) {
  if (slen(q->err) == 0) {
    q->err = msg + " at byte " + s_int(q->i);
  }
}

fn rgj_ws(q: RgjP*) {
  while (q->i < slen(q->s)) {
    var c: int32 = s_byte(q->s, q->i);
    if (c != 32 && c != 9 && c != 10 && c != 13) {
      return;
    }
    q->i = q->i + 1;
  }
}

fn rgj_at(q: RgjP*) -> int32 {
  if (q->i >= slen(q->s)) {
    return -1;
  }
  return s_byte(q->s, q->i);
}

fn rgj_hex4(q: RgjP*) -> int64 {
  if (q->i + 4 > slen(q->s)) {
    return -1;
  }
  var v: int64 = 0;
  var k: int64 = 0;
  while (k < 4) {
    var c: int32 = s_byte(q->s, q->i + k);
    var d: int32 = -1;
    if (c >= 48 && c <= 57) {
      d = c - 48;
    } else if (c >= 97 && c <= 102) {
      d = c - 87;
    } else if (c >= 65 && c <= 70) {
      d = c - 55;
    }
    if (d < 0) {
      return -1;
    }
    v = v * 16 + (int64)d;
    k = k + 1;
  }
  q->i = q->i + 4;
  return v;
}

fn rgj_utf8(b: Buf*, cp: int64) {
  if (cp < 128) {
    buf_addb(b, (int32)cp);
  } else if (cp < 2048) {
    buf_addb(b, (int32)(192 + cp / 64));
    buf_addb(b, (int32)(128 + cp % 64));
  } else if (cp < 65536) {
    buf_addb(b, (int32)(224 + cp / 4096));
    buf_addb(b, (int32)(128 + (cp / 64) % 64));
    buf_addb(b, (int32)(128 + cp % 64));
  } else {
    buf_addb(b, (int32)(240 + cp / 262144));
    buf_addb(b, (int32)(128 + (cp / 4096) % 64));
    buf_addb(b, (int32)(128 + (cp / 64) % 64));
    buf_addb(b, (int32)(128 + cp % 64));
  }
}

// At the opening quote; the decoded string (the error set on failure).
fn rgj_string(q: RgjP*) -> string {
  var b: Buf* = buf_new();
  q->i = q->i + 1;
  while (true) {
    var c: int32 = rgj_at(q);
    if (c < 0) {
      rgj_fail(q, "unterminated string");
      break;
    }
    q->i = q->i + 1;
    if (c == 34) {
      break;
    }
    if (c < 32) {
      rgj_fail(q, "control character in a string");
      break;
    }
    if (c != 92) {
      buf_addb(b, c);
      continue;
    }
    var e: int32 = rgj_at(q);
    q->i = q->i + 1;
    if (e == 34 || e == 92 || e == 47) {
      buf_addb(b, e);
    } else if (e == 98) {
      buf_addb(b, 8);
    } else if (e == 102) {
      buf_addb(b, 12);
    } else if (e == 110) {
      buf_addb(b, 10);
    } else if (e == 114) {
      buf_addb(b, 13);
    } else if (e == 116) {
      buf_addb(b, 9);
    } else if (e == 117) {
      var cp: int64 = rgj_hex4(q);
      if (cp >= 55296 && cp < 56320 && rgj_at(q) == 92) {
        q->i = q->i + 2;
        var lo: int64 = rgj_hex4(q);
        if (lo < 56320 || lo >= 57344) {
          cp = -1;
        } else {
          cp = 65536 + (cp - 55296) * 1024 + (lo - 56320);
        }
      }
      if (cp < 0) {
        rgj_fail(q, "bad \\u escape");
        break;
      }
      rgj_utf8(b, cp);
    } else {
      rgj_fail(q, "bad escape");
      break;
    }
  }
  return buf_take(b);
}

fn rgj_word(q: RgjP*, word: string) -> bool {
  var n: int64 = slen(word);
  if (q->i + n > slen(q->s) || !s_eq(s_sub(q->s, q->i, q->i + n), word)) {
    return false;
  }
  q->i = q->i + n;
  return true;
}

// One value; 0 with the error set on failure.
fn rgj_value(q: RgjP*) -> RgjVal* {
  rgj_ws(q);
  var c: int32 = rgj_at(q);
  if (c < 0) {
    rgj_fail(q, "unexpected end");
    return (RgjVal*)0;
  }
  if (c == 123 || c == 91) {
    if (q->depth >= 64) {
      rgj_fail(q, "nested too deeply");
      return (RgjVal*)0;
    }
    var close: int32 = 93;
    var v: RgjVal* = rgj_new(4);
    if (c == 123) {
      close = 125;
      v->kind = 5;
    }
    q->i = q->i + 1;
    q->depth = q->depth + 1;
    rgj_ws(q);
    if (rgj_at(q) == close) {
      q->i = q->i + 1;
      q->depth = q->depth - 1;
      return v;
    }
    while (true) {
      if (v->kind == 5) {
        rgj_ws(q);
        if (rgj_at(q) != 34) {
          rgj_fail(q, "expected a key");
          return (RgjVal*)0;
        }
        var key: string = rgj_string(q);
        rgj_ws(q);
        if (slen(q->err) > 0 || rgj_at(q) != 58) {
          rgj_fail(q, "expected ':'");
          return (RgjVal*)0;
        }
        q->i = q->i + 1;
        sl_push(v->keys, key);
      }
      var item: RgjVal* = rgj_value(q);
      if (item == (RgjVal*)0) {
        return (RgjVal*)0;
      }
      rgj_push(v, item);
      rgj_ws(q);
      var d: int32 = rgj_at(q);
      q->i = q->i + 1;
      if (d == close) {
        break;
      }
      if (d != 44) {
        q->i = q->i - 1;
        rgj_fail(q, "expected ',' or a closing bracket");
        return (RgjVal*)0;
      }
    }
    q->depth = q->depth - 1;
    return v;
  }
  if (c == 34) {
    var sv: RgjVal* = rgj_new(3);
    sv->text = rgj_string(q);
    if (slen(q->err) > 0) {
      return (RgjVal*)0;
    }
    return sv;
  }
  if (rgj_word(q, "true") || rgj_word(q, "false")) {
    var bv: RgjVal* = rgj_new(1);
    bv->text = "false";
    if (c == 116) {
      bv->text = "true";
    }
    return bv;
  }
  if (rgj_word(q, "null")) {
    return rgj_new(0);
  }
  if (c == 45 || (c >= 48 && c <= 57)) {
    var start: int64 = q->i;
    while (true) {
      var k: int32 = rgj_at(q);
      if (!(k == 45 || k == 43 || k == 46 || k == 101 || k == 69 || (k >= 48 && k <= 57))) {
        break;
      }
      q->i = q->i + 1;
    }
    var nv: RgjVal* = rgj_new(2);
    nv->text = s_dup(s_sub(q->s, start, q->i));
    return nv;
  }
  rgj_fail(q, "unexpected character");
  return (RgjVal*)0;
}

fn rgj_get(v: RgjVal*, key: string) -> RgjVal* {
  if (v == (RgjVal*)0 || v->kind != 5) {
    return (RgjVal*)0;
  }
  var i: int64 = 0;
  while (i < v->n) {
    if (s_eq(sl_get(v->keys, i), key)) {
      return v->vals[i];
    }
    i = i + 1;
  }
  return (RgjVal*)0;
}

fn rgj_str(v: RgjVal*, key: string) -> string {
  var g: RgjVal* = rgj_get(v, key);
  if (g == (RgjVal*)0 || g->kind != 3) {
    return s_empty();
  }
  return g->text;
}

// Fills ix from index.json text; false with the error set.
fn rgx_parse_json_index(ix: RegIndex*, text: string) -> bool {
  var q: RgjP* = new RgjP;
  defer free(q);
  q->s = text;
  q->i = 0;
  q->err = s_empty();
  q->depth = 0;
  var root: RgjVal* = rgj_value(q);
  rgj_ws(q);
  if (root != (RgjVal*)0 && q->i < slen(text)) {
    rgj_fail(q, "trailing data");
  }
  var where_at: string = "registry " + ix->registry + ": " + ix->url + "/v1/index.json";
  if (slen(q->err) > 0) {
    rgx_set("other", where_at + " is not valid JSON (" + q->err + ")");
    return false;
  }
  var fmt: RgjVal* = rgj_get(root, "format");
  var pkgs: RgjVal* = rgj_get(root, "packages");
  if (fmt == (RgjVal*)0 || !s_eq(fmt->text, "1") || pkgs == (RgjVal*)0 || pkgs->kind != 4) {
    rgx_set("other", where_at + " is not a format 1 index\n  help: a newer mbuild may read it");
    return false;
  }
  var i: int64 = 0;
  while (i < pkgs->n) {
    var pk: RgjVal* = pkgs->vals[i];
    i = i + 1;
    if (!s_eq(rgj_str(pk, "name"), ix->name)) {
      continue;
    }
    ix->found = true;
    var vers: RgjVal* = rgj_get(pk, "versions");
    if (vers == (RgjVal*)0 || vers->kind != 4) {
      continue;
    }
    var k: int64 = 0;
    while (k < vers->n) {
      var e: RgjVal* = vers->vals[k];
      k = k + 1;
      var vs: string = "v" + rgj_str(e, "version");
      if (!sv_is(vs)) {
        continue;
      }
      var v: RegVersion;
      v.version = vs;
      v.sha = s_lower(rgj_str(e, "sha256"));
      v.manifest_sha = s_empty();
      var y: RgjVal* = rgj_get(e, "yanked");
      v.yanked = y != (RgjVal*)0 && s_eq(y->text, "true");
      v.archive = rgj_str(e, "archive");
      ix->versions = (RegVersion*)realloc(ix->versions, (ix->n + 1) * sizeof(RegVersion));
      ix->versions[ix->n] = v;
      ix->n = ix->n + 1;
    }
  }
  return true;
}

// Like rgx_index for a json registry: one v1/index.json for every package.
fn rgx_index_json(p: Project*, ix: RegIndex*, refresh: bool) -> RegIndex* {
  var cached: string = rgx_cache_dir(ix->registry, ix->url) + "/v1/index.json";
  var have: bool = fs_is_file(cached);
  var fetch: bool = (refresh || !have) && !sl_has(g_rgx_fetched, cached);
  if (fetch && p->opts->offline) {
    if (!have) {
      ix->ok = true;
      rgx_set("missing", rgx_offline_msg("the index of registry " + ix->registry));
      ix->err = g_rgx_err;
      return ix;
    }
    fetch = false;
  }
  if (fetch) {
    if (g_verbose) {
      status("Updating", "index of registry " + ix->registry);
    }
    if (!rgx_get(p, ix->registry, ix->url, "v1/index.json", cached)) {
      if (!have) {
        return rgx_index_fail(ix);
      }
      if (rgx_once("unreachable " + ix->registry)) {
        warn("registry " + ix->registry + " is unreachable (" + g_rgx_err + "); using the cached index");
      }
      rgx_clear();
    }
    sl_push(g_rgx_fetched, cached);
  }
  var r: FsRead = fs_read(cached);
  if (!r.ok) {
    rgx_set("other", "cannot read " + cached);
    return rgx_index_fail(ix);
  }
  if (!rgx_parse_json_index(ix, r.data)) {
    return rgx_index_fail(ix);
  }
  ix->ok = true;
  if (!ix->found) {
    rgx_set("missing", "registry " + ix->registry + " has no package named " + ix->name);
    ix->err = g_rgx_err;
  }
  return ix;
}

// The NUL-terminated text of a tar header field.
fn rgx_tar_field(data: string, at: int64, n: int64) -> string {
  var k: int64 = 0;
  while (k < n && at + k < slen(data) && s_byte(data, at + k) != 0) {
    k = k + 1;
  }
  return s_sub(data, at, at + k);
}

fn rgx_tar_octal(data: string, at: int64, n: int64) -> int64 {
  var v: int64 = 0;
  var k: int64 = 0;
  while (k < n) {
    var c: int32 = s_byte(data, at + k);
    if (c >= 48 && c <= 55) {
      v = v * 8 + (int64)(c - 48);
    } else if (c != 32 || v > 0) {
      break;
    }
    k = k + 1;
  }
  return v;
}

// The regular member `name` of an uncompressed tar in data; "" when absent.
fn rgx_tar_member(data: string, name: string) -> string {
  var off: int64 = 0;
  while (off + 512 <= slen(data) && s_byte(data, off) != 0) {
    var nm: string = rgx_tar_field(data, off, 100);
    if (s_eq(rgx_tar_field(data, off + 257, 5), "ustar")) {
      var pre: string = rgx_tar_field(data, off + 345, 155);
      if (slen(pre) > 0) {
        nm = pre + "/" + nm;
      }
    }
    if (s_starts(nm, "./")) {
      nm = s_from(nm, 2);
    }
    var size: int64 = rgx_tar_octal(data, off + 124, 12);
    var kind: int32 = s_byte(data, off + 156);
    var body: int64 = off + 512;
    if ((kind == 48 || kind == 0) && s_eq(nm, name) && body + size <= slen(data)) {
      return s_dup(s_sub(data, body, body + size));
    }
    off = body + ((size + 511) / 512) * 512;
  }
  return s_empty();
}

// mbuild's manifest (TOML) for a mettle.package; "" with the error set.
fn rgx_package_toml(ix: RegIndex*, v: RegVersion*, text: string) -> string {
  var label: string = rgx_label(ix, v->version) + " (registry " + ix->registry + ") mettle.package";
  var pkg: Buf* = buf_new();
  var deps: Buf* = buf_new();
  buf_line(deps, "[dependencies]");
  var name: string = s_empty();
  var version: string = s_empty();
  var lines: StrList* = s_lines(text);
  defer rgx_sl_free(lines);
  var i: int64 = 0;
  var bad: string = s_empty();
  while (i < lines->len && slen(bad) == 0) {
    var t: string = s_trim(sl_get(lines, i));
    i = i + 1;
    if (slen(t) == 0 || s_starts(t, "#")) {
      continue;
    }
    var eq: int64 = s_find_byte(t, 61);
    if (eq <= 0) {
      bad = label + ":" + s_int(i) + ": expected `key = value`";
      continue;
    }
    var k: string = s_trim(s_sub(t, 0, eq));
    var val: string = s_trim(s_from(t, eq + 1));
    if (s_eq(k, "name")) {
      name = val;
    } else if (s_eq(k, "version")) {
      version = "v" + val;
    } else if (s_eq(k, "description") || s_eq(k, "license")) {
      buf_line(pkg, k + " = " + toml_quote(val));
    } else if (s_eq(k, "source")) {
      buf_line(pkg, "repository = " + toml_quote(val));
    } else if (s_eq(k, "compiler")) {
      var cv: string = "v" + val;
      if (!sv_is(cv)) {
        bad = label + ":" + s_int(i) + ": compiler `" + val + "` is not a version";
        continue;
      }
      buf_line(pkg, "mettle = " + toml_quote(cv));
    } else if (s_eq(k, "require")) {
      var f: StrList* = s_fields(val);
      var dv: string = s_empty();
      if (f->len == 2) {
        dv = "v" + sl_get(f, 1);
      }
      if (f->len != 2 || !man_is_package_name(sl_get(f, 0)) || !sv_is(dv)) {
        bad = label + ":" + s_int(i) + ": expected `require = NAME VERSION`";
      } else {
        buf_line(deps, sl_get(f, 0) + " = {{ version = " + toml_quote(dv) + ", registry = " + toml_quote(ix->registry) + " }");
      }
      rgx_sl_free(f);
    }
  }
  var out: Buf* = buf_new();
  buf_line(out, "[package]");
  buf_line(out, "name = " + toml_quote(name));
  buf_line(out, "version = " + toml_quote(version));
  buf_add(out, buf_take(pkg));
  buf_add(out, buf_take(deps));
  var toml: string = buf_take(out);
  if (slen(bad) == 0 && !s_eq(name, ix->name)) {
    bad = "registry " + ix->registry + ": " + rgx_label(ix, v->version) + " is package `" + name + "`, not `" + ix->name + "`\n  help: the registry entry is broken; a package can only be published under the name it declares";
  }
  if (slen(bad) == 0 && (!sv_is(version) || sv_cmp(version, v->version) != 0)) {
    bad = "registry " + ix->registry + ": " + rgx_label(ix, v->version) + " says it is version `" + version + "` in its mettle.package\n  help: the registry entry is broken";
  }
  if (slen(bad) > 0) {
    rgx_set("other", bad);
    return s_empty();
  }
  return toml;
}

// The cached archive of a json-registry version, fetched when missing.
fn rgx_archive_json(p: Project*, ix: RegIndex*, v: RegVersion*) -> string {
  var why: string = rgx_bad_name(v->archive);
  if (slen(v->archive) == 0) {
    why = "is empty";
  }
  if (slen(why) > 0) {
    rgx_set("other", "registry " + ix->registry + ": the archive path `" + v->archive + "` of " + rgx_label(ix, v->version) + " " + why);
    return s_empty();
  }
  var rel: string = "v1/" + v->archive;
  return rgx_cached(p, ix, v, rel, v->sha, true);
}

// The manifest of a json-registry version: its archive's mettle.package.
fn rgx_manifest_json(p: Project*, ix: RegIndex*, v: RegVersion*) -> Manifest* {
  var path: string = rgx_archive_json(p, ix, v);
  if (slen(path) == 0) {
    return (Manifest*)0;
  }
  var r: FsRead = fs_read(path);
  if (!r.ok) {
    rgx_set("other", "cannot read " + path);
    return (Manifest*)0;
  }
  var text: string = rgx_tar_member(r.data, "mettle.package");
  if (slen(text) == 0) {
    rgx_set("other", "registry " + ix->registry + ": " + rgx_label(ix, v->version) + " has no mettle.package (" + path + ")");
    return (Manifest*)0;
  }
  var toml: string = rgx_package_toml(ix, v, text);
  if (slen(toml) == 0) {
    return (Manifest*)0;
  }
  var doc: Toml* = toml_parse(toml, rgx_label(ix, v->version) + " (registry " + ix->registry + ")");
  var m: Manifest* = man_parse(doc, p->state_dir + "/deps/" + ix->name);
  if (slen(m->error) > 0) {
    rgx_set("other", m->error);
    return (Manifest*)0;
  }
  return m;
}

// Why publish or yank cannot write to registry `name` (dir: its directory,
// "" when remote); "" when they can.
export fn reg_write_refusal(p: Project*, name: string, dir: string) -> string {
  var json: bool = false;
  if (slen(dir) > 0) {
    json = fs_is_file(dir + "/v1/index.json");
  } else {
    var url: string = rgx_lookup(p, name);
    if (slen(url) > 0) {
      if (g_rgx_fetched == (StrList*)0) {
        g_rgx_fetched = sl_new();
      }
      json = s_eq(rgx_kind(p, name, url), "json");
    }
    rgx_clear();
  }
  if (json) {
    return "registry " + name + " is a Mettle registry, published by the Mettle repository's website/registry.py; mbuild cannot write to it";
  }
  return s_empty();
}

// ---------------------------------------------------------------------------
// Manifests and archives
// ---------------------------------------------------------------------------

fn rgx_label(ix: RegIndex*, version: string) -> string {
  return ix->name + " " + version;
}

fn rgx_mismatch(ix: RegIndex*, version: string, want: string, got: string, src: string) -> string {
  return rgx_label(ix, version) + " from registry " + ix->registry + " does not match its index\n    " + s_pad_right("index", 14) + rgx_short(want) + "\n    " + s_pad_right("registry", 14) + rgx_short(got) + " (" + src + ")\n  a published version never changes; the registry or the download was tampered with";
}

fn rgx_source(p: Project*, ix: RegIndex*, rel: string) -> string {
  if (rgx_is_remote(ix->url)) {
    return ix->url + "/" + rel;
  }
  return rgx_local_dir(p, ix->url) + "/" + rel;
}

// The cached file `rel` of version v, fetched when missing, checked against
// want (hex); a cached copy that does not match is fetched again.
fn rgx_cached(p: Project*, ix: RegIndex*, v: RegVersion*, rel: string, want: string, announce: bool) -> string {
  rgx_clear();
  var path: string = rgx_cache_dir(ix->registry, ix->url) + "/" + rel;
  if (fs_is_file(path)) {
    var have: string = sha_file(path);
    if (s_eq(have, want)) {
      return path;
    }
    if (p->opts->offline) {
      rgx_set("other", rgx_mismatch(ix, v->version, want, have, path));
      return s_empty();
    }
    sys_remove_file(path);
  }
  if (p->opts->offline) {
    rgx_set("other", rgx_offline_msg(rgx_label(ix, v->version)));
    return s_empty();
  }
  if (announce) {
    status("Fetching", rgx_label(ix, v->version) + " (" + ix->registry + ")");
  }
  if (!rgx_get(p, ix->registry, ix->url, rel, path)) {
    g_rgx_err = "cannot fetch " + rgx_label(ix, v->version) + " from registry " + ix->registry + ": " + g_rgx_err;
    return s_empty();
  }
  var got: string = sha_file(path);
  if (!s_eq(got, want)) {
    sys_remove_file(path);
    rgx_set("other", rgx_mismatch(ix, v->version, want, got, rgx_source(p, ix, rel)));
    return s_empty();
  }
  return path;
}

fn rgx_version_of(ix: RegIndex*, version: string) -> RegVersion* {
  var v: RegVersion* = reg_version(ix, version);
  if (v == (RegVersion*)0) {
    rgx_set("missing", "registry " + ix->registry + " has no " + rgx_label(ix, version));
  }
  return v;
}

export fn reg_manifest(p: Project*, ix: RegIndex*, version: string) -> Manifest* {
  rgx_clear();
  var v: RegVersion* = rgx_version_of(ix, version);
  if (v == (RegVersion*)0) {
    return (Manifest*)0;
  }
  if (s_eq(ix->kind, "json")) {
    return rgx_manifest_json(p, ix, v);
  }
  var rel: string = "pkg/" + ix->name + "/" + ix->name + "-" + v->version + ".toml";
  var path: string = rgx_cached(p, ix, v, rel, v->manifest_sha, false);
  if (slen(path) == 0) {
    return (Manifest*)0;
  }
  var r: FsRead = fs_read(path);
  if (!r.ok) {
    rgx_set("other", "cannot read " + path);
    return (Manifest*)0;
  }
  var doc: Toml* = toml_parse(r.data, rgx_label(ix, v->version) + " (registry " + ix->registry + ")");
  var m: Manifest* = man_parse(doc, p->state_dir + "/deps/" + ix->name);
  if (slen(m->error) > 0) {
    rgx_set("other", m->error);
    return (Manifest*)0;
  }
  if (slen(m->name) > 0 && !s_eq(m->name, ix->name)) {
    rgx_set("other", "registry " + ix->registry + ": " + rgx_label(ix, v->version) + " is package `" + m->name + "`, not `" + ix->name + "`\n  help: the registry entry is broken; a package can only be published under the name it declares");
    return (Manifest*)0;
  }
  return m;
}

export fn reg_fetch(p: Project*, ix: RegIndex*, version: string) -> string {
  rgx_clear();
  var v: RegVersion* = rgx_version_of(ix, version);
  if (v == (RegVersion*)0) {
    return s_empty();
  }
  if (s_eq(ix->kind, "json")) {
    return rgx_archive_json(p, ix, v);
  }
  var rel: string = "pkg/" + ix->name + "/" + ix->name + "-" + v->version + ".tar.gz";
  return rgx_cached(p, ix, v, rel, v->sha, true);
}

// ---------------------------------------------------------------------------
// Extraction
// ---------------------------------------------------------------------------

fn rgx_tar() -> Tool {
  if (s_eq(sys_os(), "windows") && !sys_is_wine() && slen(env_get("MBUILD_TAR")) == 0) {
    return sys_find_tool("tar");
  }
  return rgx_host_tool("tar", "MBUILD_TAR");
}

fn rgx_tar_list(tar: Tool, archive: string, flags: string) -> Captured {
  var c: Cmd* = cmd_new(tar);
  cmd_arg(c, flags);
  cmd_path(c, archive);
  var r: Captured = proc_capture(c);
  rgx_cmd_free(c);
  return r;
}

fn rgx_nonblank(text: string) -> StrList* {
  var out: StrList* = sl_new();
  var lines: StrList* = s_lines(text);
  var i: int64 = 0;
  while (i < lines->len) {
    var ln: string = sl_get(lines, i);
    if (slen(s_trim(ln)) > 0) {
      sl_push(out, ln);
    }
    i = i + 1;
  }
  rgx_sl_free(lines);
  return out;
}

// "" when the member name stays inside the package directory.
fn rgx_bad_name(name: string) -> string {
  if (s_starts(name, "/") || (slen(name) >= 2 && s_byte(name, 1) == 58)) {
    return "is an absolute path";
  }
  if (s_find_byte(name, 92) >= 0 || s_find_byte(name, 58) >= 0) {
    return "contains a backslash or a colon";
  }
  var parts: StrList* = s_split(name, 47);
  defer rgx_sl_free(parts);
  var i: int64 = 0;
  while (i < parts->len) {
    if (s_eq(sl_get(parts, i), "..")) {
      return "leaves the package directory";
    }
    i = i + 1;
  }
  return s_empty();
}

// "" when every member is a plain file or directory with a safe name.
fn rgx_gz(archive: string) -> bool {
  return s_ends(archive, ".gz") || s_ends(archive, ".tgz");
}

fn rgx_check_members(tar: Tool, archive: string) -> string {
  var z: string = "";
  if (rgx_gz(archive)) {
    z = "z";
  }
  var fv: string = "-t" + z + "vf";
  var fl: string = "-t" + z + "f";
  var lv: Captured = rgx_tar_list(tar, archive, fv);
  var ln: Captured = rgx_tar_list(tar, archive, fl);
  if (lv.code != 0 || ln.code != 0) {
    return "cannot list " + archive + " (tar exit " + s_int((int64)ln.code) + ")";
  }
  var long_lines: StrList* = rgx_nonblank(lv.out);
  var names: StrList* = rgx_nonblank(ln.out);
  defer rgx_sl_free(long_lines);
  defer rgx_sl_free(names);
  if (long_lines->len != names->len) {
    return p_base(archive) + ": the two listings of the archive disagree; refusing to extract it";
  }
  var i: int64 = 0;
  while (i < names->len) {
    var name: string = sl_get(names, i);
    var kind: int32 = s_byte(sl_get(long_lines, i), 0);
    if (kind != 45 && kind != 100) {
      return p_base(archive) + ": member `" + name + "` is not a regular file or directory; refusing to extract it";
    }
    var why: string = rgx_bad_name(name);
    if (slen(why) > 0) {
      return p_base(archive) + ": member `" + name + "` " + why + "; refusing to extract it";
    }
    i = i + 1;
  }
  return s_empty();
}

export fn reg_extract(archive: string, sha: string, dest: string, marker: string) -> string {
  var want: string = rgx_bare_sha(sha);
  if (slen(want) > 0) {
    var got: string = sha_file(archive);
    if (!s_eq(got, want)) {
      return archive + " does not match its checksum\n    expected      " + rgx_short(want) + "\n    found         " + rgx_short(got) + "\n  a published version never changes; the download cache was changed";
    }
  }
  var tar: Tool = rgx_tar();
  if (!tool_found(tar)) {
    return "cannot find `tar` (needed to unpack " + p_base(archive) + ")\n  help: install tar and put it on PATH, or set MBUILD_TAR to its path";
  }
  var bad: string = rgx_check_members(tar, archive);
  if (slen(bad) > 0) {
    return bad;
  }
  var tmp: string = p_clean(p_dir(dest) + "/../tmp/x-" + p_base(dest));
  sys_remove_tree(tmp);
  if (!fs_mkdirs(tmp)) {
    return "cannot create " + tmp;
  }
  var c: Cmd* = cmd_new(tar);
  if (rgx_gz(archive)) {
    cmd_arg(c, "-xzf");
  } else {
    cmd_arg(c, "-xf");
  }
  cmd_path(c, archive);
  cmd_arg(c, "-C");
  cmd_path(c, tmp);
  var r: Captured = proc_capture_all(c);
  rgx_cmd_free(c);
  if (r.code != 0) {
    sys_remove_tree(tmp);
    return "cannot unpack " + archive + ": " + s_trim(r.out);
  }
  if (!fs_write(tmp + "/.mbuild-pkg", marker + "\n")) {
    sys_remove_tree(tmp);
    return "cannot write " + tmp + "/.mbuild-pkg";
  }
  if (fs_exists(dest)) {
    sys_remove_tree(dest);
  }
  if (!fs_mkdirs(p_dir(dest)) || !sys_rename(tmp, dest)) {
    sys_remove_tree(tmp);
    return "cannot move " + tmp + " to " + dest;
  }
  return s_empty();
}

export fn reg_marker(dest: string) -> string {
  var r: FsRead = fs_read(dest + "/.mbuild-pkg");
  if (!r.ok) {
    return s_empty();
  }
  var lines: StrList* = s_lines(r.data);
  var first: string = s_empty();
  if (lines->len > 0) {
    first = s_trim(sl_get(lines, 0));
  }
  rgx_sl_free(lines);
  return first;
}

export fn reg_error() -> string {
  return g_rgx_err;
}

export fn reg_failure_kind() -> string {
  return g_rgx_kind;
}

// ---------------------------------------------------------------------------
// Writing a local registry
// ---------------------------------------------------------------------------

fn rgx_is_registry(dir: string) -> bool {
  return fs_is_file(dir + "/registry.toml");
}

fn rgx_not_registry(dir: string) -> string {
  return dir + " is not a registry (it has no registry.toml)\n  help: create one with mbuild registry init " + dir;
}

export fn reg_init_dir(dir: string, name: string) -> string {
  if (rgx_is_registry(dir)) {
    return dir + " is already a registry";
  }
  var n: string = name;
  if (slen(n) == 0) {
    n = p_base(p_clean(dir));
  }
  if (!fs_mkdirs(dir + "/index") || !fs_mkdirs(dir + "/pkg")) {
    return "cannot create " + dir;
  }
  if (!fs_write(dir + "/registry.toml", "[registry]\nformat = 1\nname = " + toml_quote(n) + "\n")) {
    return "cannot write " + dir + "/registry.toml";
  }
  return s_empty();
}

// The index line of version, -1 when absent.
fn rgx_find_line(lines: StrList*, version: string) -> int64 {
  var i: int64 = 0;
  while (i < lines->len) {
    var f: StrList* = s_fields(sl_get(lines, i));
    var hit: bool = f->len > 0 && (s_eq(sl_get(f, 0), version) || (sv_is(sl_get(f, 0)) && sv_cmp(sl_get(f, 0), version) == 0));
    rgx_sl_free(f);
    if (hit) {
      return i;
    }
    i = i + 1;
  }
  return -1;
}

fn rgx_join_lines(lines: StrList*) -> string {
  var b: Buf* = buf_new();
  var i: int64 = 0;
  while (i < lines->len) {
    buf_line(b, sl_get(lines, i));
    i = i + 1;
  }
  return buf_take(b);
}

fn rgx_index_lines(dir: string, name: string) -> StrList* {
  var r: FsRead = fs_read(dir + "/index/" + name);
  if (!r.ok) {
    return sl_of("# mbuild index " + name);
  }
  return s_lines(r.data);
}

export fn reg_publish(r: RegPublish*) -> string {
  if (!sv_is(r->version)) {
    return r->name + ": '" + r->version + "' is not a semantic version";
  }
  if (!rgx_is_registry(r->dir)) {
    return rgx_not_registry(r->dir);
  }
  var lines: StrList* = rgx_index_lines(r->dir, r->name);
  defer rgx_sl_free(lines);
  if (rgx_find_line(lines, r->version) >= 0) {
    return r->name + " " + r->version + " is already published in " + r->dir + "\n  help: a published version never changes; publish a new version";
  }
  var files: StrList* = sl_copy(r->files);
  defer rgx_sl_free(files);
  sl_sort(files);
  if (files->len == 0) {
    return r->name + " " + r->version + ": no files to publish";
  }
  if (r->dry_run) {
    var i: int64 = 0;
    while (i < files->len) {
      say(sl_get(files, i));
      i = i + 1;
    }
    say("");
    print(r->manifest_text);
    flush_out();
    return s_empty();
  }
  var tar: Tool = rgx_tar();
  if (!tool_found(tar)) {
    return "cannot find `tar` (needed to pack " + r->name + ")\n  help: install tar and put it on PATH, or set MBUILD_TAR to its path";
  }
  var list: string = r->root + ".list";
  var archive: string = r->root + ".tar.gz";
  if (!fs_write(list, rgx_join_lines(files))) {
    return "cannot write " + list;
  }
  var c: Cmd* = cmd_new(tar);
  cmd_arg(c, "-czf");
  cmd_path(c, archive);
  cmd_arg(c, "-C");
  cmd_path(c, r->root);
  cmd_arg(c, "-T");
  cmd_path(c, list);
  var tr: Captured = proc_capture_all(c);
  rgx_cmd_free(c);
  if (tr.code != 0) {
    return "cannot pack " + r->name + " " + r->version + ": " + s_trim(tr.out);
  }
  var a_sha: string = sha_file(archive);
  var m_sha: string = sha_string(r->manifest_text);
  var base: string = r->dir + "/pkg/" + r->name + "/" + r->name + "-" + r->version;
  if (!fs_copy(archive, base + ".tar.gz")) {
    return "cannot write " + base + ".tar.gz";
  }
  if (!fs_write(base + ".toml", r->manifest_text)) {
    return "cannot write " + base + ".toml";
  }
  sl_push(lines, r->version + " sha256=" + a_sha + " manifest=" + m_sha);
  if (!fs_write(r->dir + "/index/" + r->name, rgx_join_lines(lines))) {
    return "cannot write " + r->dir + "/index/" + r->name;
  }
  sys_remove_file(archive);
  sys_remove_file(list);
  return s_empty();
}

export fn reg_yank(dir: string, name: string, version: string, undo: bool) -> string {
  if (!rgx_is_registry(dir)) {
    return rgx_not_registry(dir);
  }
  var r: FsRead = fs_read(dir + "/index/" + name);
  if (!r.ok) {
    return dir + " has no package named " + name;
  }
  var lines: StrList* = s_lines(r.data);
  defer rgx_sl_free(lines);
  var at: int64 = rgx_find_line(lines, version);
  if (at < 0) {
    return dir + " has no " + name + " " + version;
  }
  var f: StrList* = s_fields(sl_get(lines, at));
  defer rgx_sl_free(f);
  var kept: StrList* = sl_new();
  defer rgx_sl_free(kept);
  var i: int64 = 0;
  while (i < f->len) {
    if (!s_eq(sl_get(f, i), "yanked")) {
      sl_push(kept, sl_get(f, i));
    }
    i = i + 1;
  }
  if (!undo) {
    sl_push(kept, "yanked");
  }
  sl_set(lines, at, sl_join(kept, " "));
  if (!fs_write(dir + "/index/" + name, rgx_join_lines(lines))) {
    return "cannot write " + dir + "/index/" + name;
  }
  return s_empty();
}
