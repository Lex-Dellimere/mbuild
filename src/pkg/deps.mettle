// deps: the requirement graph, minimal version selection, mbuild.lock, the
// packages under .mbuild/deps and the managed mettle.deps blocks
//.
//
// deps_ensure has a fast path that asks no registry: when .mbuild/deps.stamp
// records the current lock (its hash) and the current requirements (a hash
// over the root's and the path packages' dependencies and the root's
// [replace]), and every locked package's directory carries the marker of its
// version and checksum. Otherwise it resolves: it walks every requirement
// reachable from the root, reading each visited (package, version)'s
// manifest from the registry, and selects per package the highest version
// required inside one compatibility line. The lock pins "latest" and every
// checksum; only get/update move a pin.
//
// Every package gets its own managed mettle.deps block (the root, each
// package directory, each path package) naming the packages it declares.

import "std/mem";
import "../core/base";
import "../core/path";
import "../core/fs";
import "../model/toml";
import "../model/semver";
import "../model/manifest";
import "../model/project";
import "registry";
import "../config/config";
import "../config/mbfile";
import "../build/scan";
import "api";
import "../build/toolchain";
import "../core/sys_linux" if linux;
import "../core/sys_windows" if windows;

// ---------------------------------------------------------------------------
// Small containers
// ---------------------------------------------------------------------------

// One requirement: `from` requires module at spec.
struct DxReq {
  module: string;
  spec: string;
  from: string;      // "mbuild.mettle", "textfmt v0.1.0", "path package x"
  root: bool;        // stated by the root manifest itself
  label: string;     // the version it resolved to
  fresh: bool;       // "latest" resolved now (not from the lock)
}

// One package of the graph and the versions of it that were visited.
struct DxMod {
  module: string;
  reqs: DxReqs*;
  labels: StrList*;     // visited versions
  sel: int64;           // selected index into labels, -1 when nothing live requires it
  mans: DxMans*;        // the manifest of each visited version (parallel to labels)
  rep: ReplaceSpec*;    // its [replace] { version = ... } entry, 0 when none
  rep_req: DxReq*;      // the requirement the replacement stands for
  ix: RegIndex*;        // its registry index, 0 until needed
}

// A [replace] { path = ... } package: a link to a local directory.
struct DxRPath {
  module: string;
  rel: string;
  dir: string;          // absolute, cleaned
  man: Manifest*;
  local: bool;          // from mbuild.local.mettle
  reqs: DxReqs*;        // what required it (shown by `why`)
}

// A local { path = ... } package.
struct DxPath {
  key: string;
  rel: string;          // the path as written
  dir: string;          // absolute
  man: Manifest*;       // 0 when it has no mbuild.mettle
}

struct DxLock {
  exists: bool;
  text: string;
  mods: StrList*;
  vers: StrList*;
  regs: StrList*;
  shas: StrList*;
  reqs: string;
}

struct DxCx {
  p: Project*;
  lock: DxLock*;
  unpin: StrList*;      // packages whose lock pins are ignored
  mods: DxMods*;
  paths: DxPaths*;
  queue: DxReqs*;
  reqs_hash: string;
  rpaths: DxRPaths*;
  hints: StrList*;      // "package line": `latest` resolves inside that line
  local_names: StrList*;  // packages replaced by mbuild.local.mettle
  published: StrList*;  // names the root block of mettle.deps publishes
  deps_root: string;    // where registry packages are: .mbuild/deps or vendor
}

struct DxRPaths {
  items: DxRPath**;
  len: int64;
  cap: int64;
}

fn drp_new() -> DxRPaths* {
  var l: DxRPaths* = new DxRPaths;
  l->items = (DxRPath**)0;
  l->len = 0;
  l->cap = 0;
  return l;
}

fn drp_push(l: DxRPaths*, v: DxRPath*) {
  if (l->len >= l->cap) {
    var nc: int64 = l->cap * 2;
    if (nc < 8) { nc = 8; }
    l->items = (DxRPath**)realloc(l->items, nc * 8);
    l->cap = nc;
  }
  l->items[l->len] = v;
  l->len = l->len + 1;
}

// Typed pointer lists (the memory analyser follows typed stores).
struct DxReqs {
  items: DxReq**;
  len: int64;
  cap: int64;
}

fn drq_new() -> DxReqs* {
  var l: DxReqs* = new DxReqs;
  l->items = (DxReq**)0;
  l->len = 0;
  l->cap = 0;
  return l;
}

fn drq_push(l: DxReqs*, v: DxReq*) {
  if (l->len >= l->cap) {
    var nc: int64 = l->cap * 2;
    if (nc < 8) { nc = 8; }
    l->items = (DxReq**)realloc(l->items, nc * 8);
    l->cap = nc;
  }
  l->items[l->len] = v;
  l->len = l->len + 1;
}

struct DxMods {
  items: DxMod**;
  len: int64;
  cap: int64;
}

fn dmo_new() -> DxMods* {
  var l: DxMods* = new DxMods;
  l->items = (DxMod**)0;
  l->len = 0;
  l->cap = 0;
  return l;
}

fn dmo_push(l: DxMods*, v: DxMod*) {
  if (l->len >= l->cap) {
    var nc: int64 = l->cap * 2;
    if (nc < 8) { nc = 8; }
    l->items = (DxMod**)realloc(l->items, nc * 8);
    l->cap = nc;
  }
  l->items[l->len] = v;
  l->len = l->len + 1;
}

struct DxPaths {
  items: DxPath**;
  len: int64;
  cap: int64;
}

fn dpa_new() -> DxPaths* {
  var l: DxPaths* = new DxPaths;
  l->items = (DxPath**)0;
  l->len = 0;
  l->cap = 0;
  return l;
}

fn dpa_push(l: DxPaths*, v: DxPath*) {
  if (l->len >= l->cap) {
    var nc: int64 = l->cap * 2;
    if (nc < 8) { nc = 8; }
    l->items = (DxPath**)realloc(l->items, nc * 8);
    l->cap = nc;
  }
  l->items[l->len] = v;
  l->len = l->len + 1;
}

struct DxMans {
  items: Manifest**;
  len: int64;
  cap: int64;
}

fn dma_new() -> DxMans* {
  var l: DxMans* = new DxMans;
  l->items = (Manifest**)0;
  l->len = 0;
  l->cap = 0;
  return l;
}

fn dma_push(l: DxMans*, v: Manifest*) {
  if (l->len >= l->cap) {
    var nc: int64 = l->cap * 2;
    if (nc < 8) { nc = 8; }
    l->items = (Manifest**)realloc(l->items, nc * 8);
    l->cap = nc;
  }
  l->items[l->len] = v;
  l->len = l->len + 1;
}

// Messages already printed, as a newline-framed set.
var g_dx_said: string;
var g_dx_forced: string;

// mbuild update / fetch: refresh the index of every package resolved.
var g_dx_refresh: bool = false;
// Packages whose index was refreshed by this process (once per command).
var g_dx_refreshed: StrList* = 0;
// mbuild update --all: dx_ensure stops before changing anything when a
// package the root does not require has a newer version in its line, and
// lists those (package, version) here instead.
var g_dx_raise_all: bool = false;
var g_dx_raise_mods: StrList* = 0;
var g_dx_raise_vers: StrList* = 0;

// A snapshot of mbuild.mettle, mbuild.local.mettle, mbuild.lock and
// .mbuild/local.lock taken by the commands that edit them: an error that
// stops the process writes it back.
var g_dx_guard: DepSnap* = 0;
var g_dx_local_noted: bool = false;
var g_dx_md_checked: bool = false;
// Auto-add lookups of this process, found or not.
var g_dx_looked: StrList* = 0;
// Resolve from the registry even when vendor/ exists (vendor, get, ...).
var g_dx_no_vendor: bool = false;
// Indexes are kept for the whole command (registry.mettle may cache them).
var g_dx_last_ix: RegIndex* = 0;

fn dx_mbfile_path(p: Project*) -> string {
  if (slen(p->mbfile) > 0) {
    return p->mbfile;
  }
  return p->root + "/mbuild.mettle";
}

fn dx_snap_take(p: Project*) -> DepSnap* {
  var s: DepSnap* = new DepSnap;
  s->files = sl_new();
  s->texts = sl_new();
  s->present = sl_new();
  sl_push(s->files, dx_mbfile_path(p));
  sl_push(s->files, p->root + "/mbuild.local.mettle");
  sl_push(s->files, p->root + "/mbuild.lock");
  sl_push(s->files, p->state_dir + "/local.lock");
  var i: int64 = 0;
  while (i < s->files->len) {
    var r: FsRead = fs_read(sl_get(s->files, i));
    if (r.ok) {
      sl_push(s->texts, r.data);
      sl_push(s->present, "1");
    } else {
      sl_push(s->texts, s_empty());
      sl_push(s->present, "0");
    }
    i = i + 1;
  }
  return s;
}

// Writes the snapshot back; true when a file changed.
fn dx_snap_write(s: DepSnap*) -> bool {
  var changed: bool = false;
  var i: int64 = 0;
  while (i < s->files->len) {
    var file: string = sl_get(s->files, i);
    var r: FsRead = fs_read(file);
    if (s_eq(sl_get(s->present, i), "1")) {
      if (!r.ok || !s_eq(r.data, sl_get(s->texts, i))) {
        fs_write(file, sl_get(s->texts, i));
        changed = true;
      }
    } else if (r.ok) {
      sys_remove_file(file);
      changed = true;
    }
    i = i + 1;
  }
  return changed;
}

fn dx_arm(p: Project*) {
  if (g_dx_guard == (DepSnap*)0) {
    g_dx_guard = dx_snap_take(p);
  }
}

fn dx_disarm() {
  g_dx_guard = (DepSnap*)0;
}

fn dx_guard_restore() {
  if (g_dx_guard == (DepSnap*)0) {
    return;
  }
  var s: DepSnap* = g_dx_guard;
  g_dx_guard = (DepSnap*)0;
  if (dx_snap_write(s)) {
    sys_remove_file(p_dir(sl_get(s->files, 3)) + "/deps.stamp");
    err_line("  Restored mbuild.mettle and mbuild.lock");
  }
}

fn dx_fail(msg: string) {
  error_msg(msg);
  dx_guard_restore();
  exit_with(1);
}

fn dx_fail_hint(msg: string, hint: string) {
  error_msg(msg);
  err_line("  " + cyan("help") + ": " + hint);
  dx_guard_restore();
  exit_with(1);
}

fn dx_help(hint: string) {
  err_line("  " + cyan("help") + ": " + hint);
}

fn dx_set_has(set: string, item: string) -> bool {
  return s_contains("\n" + set, "\n" + item + "\n");
}

// True the first time key is seen by this process.
fn dx_once(key: string) -> bool {
  if (dx_set_has(g_dx_said, key)) {
    return false;
  }
  g_dx_said = g_dx_said + key + "\n";
  return true;
}

fn dx_announce(verb: string, module: string, version_text: string, key: string) {
  if (dx_once(module + " " + key)) {
    status(verb, module + " " + version_text);
  }
}

// ---------------------------------------------------------------------------
// Paths and files
// ---------------------------------------------------------------------------

fn dx_deps_dir(p: Project*) -> string {
  return p->state_dir + "/deps";
}

fn dx_lock_path(p: Project*) -> string {
  return p->root + "/mbuild.lock";
}

fn dx_stamp_path(p: Project*) -> string {
  return p->state_dir + "/deps.stamp";
}

fn dx_vendor_dir(p: Project*) -> string {
  return p->root + "/vendor";
}

// target relative to base ("./x", "../x"), or target when on another drive.
export fn dx_rel(base: string, target: string) -> string {
  var b: string = p_clean(base);
  var t: string = p_clean(target);
  if (p_has_prefix_dir(t, b)) {
    var inside: string = p_rel(b, t);
    if (s_eq(inside, ".")) {
      return ".";
    }
    return "./" + inside;
  }
  var bp: StrList* = s_split(b, 47);
  var tp: StrList* = s_split(t, 47);
  if (bp->len == 0 || tp->len == 0 || !s_eq(s_lower(sl_get(bp, 0)), s_lower(sl_get(tp, 0)))) {
    free(bp);
    free(tp);
    return t;
  }
  var common: int64 = 0;
  while (common < bp->len && common < tp->len && s_eq(sl_get(bp, common), sl_get(tp, common))) {
    common = common + 1;
  }
  var parts: StrList* = sl_new();
  var i: int64 = common;
  while (i < bp->len) {
    if (slen(sl_get(bp, i)) > 0) {
      sl_push(parts, "..");
    }
    i = i + 1;
  }
  i = common;
  while (i < tp->len) {
    sl_push(parts, sl_get(tp, i));
    i = i + 1;
  }
  var joined: string = sl_join(parts, "/");
  free(bp);
  free(tp);
  free(parts);
  return joined;
}

fn dx_parse_manifest(text: string, dir: string, label: string) -> Manifest* {
  var doc: Toml* = toml_parse(text, label);
  var m: Manifest* = man_parse(doc, dir);
  if (slen(m->error) > 0) {
    warn(m->error);
  }
  return m;
}

// The configuration of a path package or path replacement (13.9); 0 when it
// has no mbuild.mettle.
fn dx_local_manifest(p: Project*, dir: string, key: string) -> Manifest* {
  if (!fs_is_file(dir + "/mbuild.mettle")) {
    if (fs_is_file(dir + "/mbuild.toml")) {
      dx_fail(dx_rel(p->root, dir) + " has mbuild.toml, which is no longer read; it needs an mbuild.mettle");
    }
    return (Manifest*)0;
  }
  return cfg_load_dir(p, dir, key);
}

// ---------------------------------------------------------------------------
// The lock
// ---------------------------------------------------------------------------

fn dx_local_lock_path(p: Project*) -> string {
  return p->state_dir + "/local.lock";
}

fn dx_is_marker(t: string) -> bool {
  return s_starts(t, "<<<<<<<") || s_starts(t, "=======") || s_starts(t, ">>>>>>>") || s_starts(t, "|||||||");
}

fn dx_is_commit(s: string) -> bool {
  if (slen(s) != 40) {
    return false;
  }
  var i: int64 = 0;
  while (i < 40) {
    if (!is_hex_b(s_byte(s, i))) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

fn dx_lock_new() -> DxLock* {
  var l: DxLock* = new DxLock;
  l->exists = false;
  l->text = s_empty();
  l->mods = sl_new();
  l->vers = sl_new();
  l->regs = sl_new();
  l->shas = sl_new();
  l->reqs = s_empty();
  return l;
}

// A git-era lock ("module version commit"): its pins are dropped.
fn dx_git_era(lines: StrList*) -> bool {
  var i: int64 = 0;
  while (i < lines->len) {
    var t: string = s_trim(sl_get(lines, i));
    i = i + 1;
    if (s_eq(t, "# module version commit")) {
      return true;
    }
    if (slen(t) > 0 && !s_starts(t, "#")) {
      var f: StrList* = s_fields(t);
      var old: bool = f->len == 3 && dx_is_commit(sl_get(f, 2));
      free(f);
      if (old) {
        return true;
      }
    }
  }
  return false;
}

// The lock this command reads: .mbuild/local.lock while mbuild.local.mettle
// replaces packages (when it exists), else mbuild.lock. A lock with merge
// conflict markers is repaired: every package line of both sides, the
// higher version of a package listed twice, and a stale requirements line.
fn dx_lock_read_file(p: Project*, file: string) -> DxLock* {
  var l: DxLock* = dx_lock_new();
  var r: FsRead = fs_read(file);
  if (!r.ok) {
    return l;
  }
  l->exists = true;
  l->text = r.data;
  var lines: StrList* = s_lines(r.data);
  if (dx_git_era(lines)) {
    free(lines);
    if (p->opts->locked) {
      dx_fail_hint(p_base(file) + " is from the git era and --locked forbids re-resolving it", "run mbuild once without --locked");
    }
    if (dx_once("git era " + file)) {
      note(p_base(file) + " is from the git era and is re-resolved");
    }
    return l;
  }
  var conflicted: bool = false;
  var i: int64 = 0;
  while (i < lines->len) {
    if (dx_is_marker(sl_get(lines, i))) {
      conflicted = true;
    }
    i = i + 1;
  }
  if (conflicted) {
    if (p->opts->locked) {
      dx_fail_hint(p_base(file) + " has merge conflict markers", "run any mbuild command without --locked to repair it, then commit");
    }
    if (dx_once("repaired " + file)) {
      status("Repaired", "merge conflict in " + p_base(file));
    }
  }
  var base_side: bool = false;
  i = 0;
  while (i < lines->len) {
    var t: string = s_trim(sl_get(lines, i));
    i = i + 1;
    if (s_starts(t, "|||||||")) {
      base_side = true;
      continue;
    }
    if (s_starts(t, "=======") || s_starts(t, "<<<<<<<") || s_starts(t, ">>>>>>>")) {
      base_side = false;
      continue;
    }
    if (base_side) {
      continue;
    }
    if (s_starts(t, "# requirements ")) {
      if (!conflicted) {
        l->reqs = s_trim(s_from(t, slen("# requirements ")));
      }
    } else if (slen(t) > 0 && !s_starts(t, "#")) {
      var f: StrList* = s_fields(t);
      if (f->len >= 4) {
        var at: int64 = sl_index(l->mods, sl_get(f, 0));
        if (at < 0) {
          sl_push(l->mods, sl_get(f, 0));
          sl_push(l->vers, sl_get(f, 1));
          sl_push(l->regs, sl_get(f, 2));
          sl_push(l->shas, s_lower(sl_get(f, 3)));
        } else if (sv_is(sl_get(f, 1)) && sv_is(sl_get(l->vers, at)) && sv_cmp(sl_get(f, 1), sl_get(l->vers, at)) > 0) {
          sl_set(l->vers, at, sl_get(f, 1));
          sl_set(l->regs, at, sl_get(f, 2));
          sl_set(l->shas, at, s_lower(sl_get(f, 3)));
        }
      }
      free(f);
    }
  }
  free(lines);
  return l;
}

fn dx_lock_read(p: Project*) -> DxLock* {
  if (dx_local_replaced(p)->len > 0 && fs_is_file(dx_local_lock_path(p))) {
    return dx_lock_read_file(p, dx_local_lock_path(p));
  }
  return dx_lock_read_file(p, dx_lock_path(p));
}

// The packages mbuild.local.mettle replaces.
fn dx_local_replaced(p: Project*) -> StrList* {
  var names: StrList* = sl_new();
  var i: int64 = 0;
  while (i < p->man->nreplaces) {
    if (p->man->replaces[i].local) {
      sl_add_uniq(names, p->man->replaces[i].module);
    }
    i = i + 1;
  }
  return names;
}

struct DxLockArgs {
  mods: StrList*;
  vers: StrList*;
  regs: StrList*;
  shas: StrList*;
  reqs: string;
}

fn dx_args_new(reqs: string) -> DxLockArgs* {
  var a: DxLockArgs* = new DxLockArgs;
  a->mods = sl_new();
  a->vers = sl_new();
  a->regs = sl_new();
  a->shas = sl_new();
  a->reqs = reqs;
  return a;
}

fn dx_lock_render(a: DxLockArgs*) -> string {
  var order: StrList* = sl_copy(a->mods);
  sl_sort(order);
  var b: Buf* = buf_new();
  buf_line(b, "# mbuild.lock: generated by mbuild. Commit it.");
  buf_line(b, "# format 3");
  buf_line(b, "# requirements " + a->reqs);
  var i: int64 = 0;
  while (i < order->len) {
    var at: int64 = sl_index(a->mods, sl_get(order, i));
    buf_line(b, sl_get(a->mods, at) + " " + sl_get(a->vers, at) + " " + sl_get(a->regs, at) + " " + sl_get(a->shas, at));
    i = i + 1;
  }
  free(order);
  return buf_take(b);
}

// Announces what changes between two locks.
fn dx_lock_diff(old: DxLock*, a: DxLockArgs*) {
  var i: int64 = 0;
  while (i < a->mods->len) {
    var m: string = sl_get(a->mods, i);
    var v: string = sl_get(a->vers, i);
    var at: int64 = sl_index(old->mods, m);
    if (at < 0) {
      dx_announce("Adding", m, v + " (registry " + sl_get(a->regs, i) + ")", v);
    } else if (!s_eq(sl_get(old->vers, at), v)) {
      dx_announce("Updating", m, sl_get(old->vers, at) + " -> " + v, v);
    }
    i = i + 1;
  }
  i = 0;
  while (i < old->mods->len) {
    var om: string = sl_get(old->mods, i);
    if (!sl_has(a->mods, om)) {
      dx_announce("Removing", om, sl_get(old->vers, i), "-");
    }
    i = i + 1;
  }
}

// ---------------------------------------------------------------------------
// Context, path packages, requirement hash
// ---------------------------------------------------------------------------

fn dx_cx_new(p: Project*) -> DxCx* {
  var cx: DxCx* = new DxCx;
  cx->p = p;
  cx->local_names = dx_local_replaced(p);
  cx->rpaths = drp_new();
  cx->hints = sl_new();
  cx->published = sl_new();
  cx->lock = dx_lock_read(p);
  cx->unpin = sl_new();
  cx->mods = dmo_new();
  cx->paths = dpa_new();
  cx->queue = drq_new();
  cx->reqs_hash = s_empty();
  cx->deps_root = dx_deps_dir(p);
  return cx;
}

fn dx_path_at(cx: DxCx*, i: int64) -> DxPath* {
  return cx->paths->items[i];
}

fn dx_mod_at(cx: DxCx*, i: int64) -> DxMod* {
  return cx->mods->items[i];
}

fn dx_req_at(l: DxReqs*, i: int64) -> DxReq* {
  return l->items[i];
}

// A path package's declared name must be the key it is imported by
// (directory names never matter). file_dir is the directory of the
// mbuild.mettle that names it; "" for mbuild.local.mettle.
fn dx_check_name(p: Project*, m: Manifest*, key: string, rel: string, call: string, file_dir: string) {
  if (slen(m->name) == 0 || s_eq(m->name, key)) {
    return;
  }
  var file: string = "mbuild.local.mettle";
  if (slen(file_dir) > 0) {
    file = dx_rel(p->root, file_dir) + "/mbuild.mettle";
    if (s_starts(file, "./")) {
      file = s_from(file, 2);
    }
  }
  var msg: string = rel + " is package `" + m->name + "`, not `" + key + "`";
  if (s_eq(call, "mb_dep_path")) {
    dx_fail_hint(msg, "in " + file + ": " + call + "(\"" + m->name + "\", \"" + rel + "\");");
  }
  dx_fail_hint(msg, "in " + file + ": point " + call + "(\"" + key + "\", ...) at a package named " + key + ", or remove the replacement");
}

// Every local path package reachable from the root (nested ones relative to
// the package that names them).
fn dx_collect_paths(cx: DxCx*) {
  var mans: DxMans* = dma_new();
  dma_push(mans, cx->p->man);
  var mi: int64 = 0;
  while (mi < mans->len) {
    var m: Manifest* = mans->items[mi];
    var i: int64 = 0;
    while (i < m->ndeps) {
      var d: DepSpec* = man_dep(m, i);
      if (slen(d->path) > 0) {
        var dir: string = p_clean(p_join(m->dir, d->path));
        var seen: bool = false;
        var k: int64 = 0;
        while (k < cx->paths->len) {
          if (s_eq(dx_path_at(cx, k)->dir, dir)) {
            seen = true;
          }
          k = k + 1;
        }
        if (!seen) {
          if (!fs_is_dir(dir)) {
            dx_fail_hint("path dependency '" + d->key + "' points at " + dir + ", which does not exist", "fix mb_dep_path(\"" + d->key + "\", ...) in " + m->dir + "/mbuild.mettle");
          }
          var pp: DxPath* = new DxPath;
          pp->key = d->key;
          pp->rel = d->path;
          pp->dir = dir;
          pp->man = dx_local_manifest(cx->p, dir, d->key);
          if (pp->man != (Manifest*)0) {
            dx_check_name(cx->p, pp->man, d->key, d->path, "mb_dep_path", m->dir);
          }
          dpa_push(cx->paths, pp);
          if (pp->man != (Manifest*)0) {
            dma_push(mans, pp->man);
          }
        }
      }
      i = i + 1;
    }
    mi = mi + 1;
  }
  free(mans->items);
  free(mans);
  dx_collect_rpaths(cx);
}

// The root's [replace] { path = ... } entries (mbuild.local.mettle's first).
fn dx_collect_rpaths(cx: DxCx*) {
  var m: Manifest* = cx->p->man;
  var i: int64 = 0;
  while (i < m->nreplaces) {
    var rs: ReplaceSpec* = &m->replaces[i];
    i = i + 1;
    if (slen(rs->path) == 0 || man_replace_find(m, rs->module) != rs) {
      continue;
    }
    var dir: string = p_clean(p_join(cx->p->root, rs->path));
    if (!fs_is_dir(dir)) {
      var src: string = "mbuild.mettle";
      if (rs->local) {
        src = "mbuild.local.mettle";
      }
      dx_fail_hint("[replace] " + rs->module + ": " + rs->path + " does not exist", "fix the path in " + src + ", or remove the replacement");
    }
    var rp: DxRPath* = new DxRPath;
    rp->module = rs->module;
    rp->rel = rs->path;
    rp->dir = dir;
    rp->man = dx_local_manifest(cx->p, dir, rs->module);
    if (rp->man != (Manifest*)0) {
      if (rs->local) {
        dx_check_name(cx->p, rp->man, rs->module, rs->path, "mb_replace_path", "");
      } else {
        dx_check_name(cx->p, rp->man, rs->module, rs->path, "mb_replace_path", cx->p->root);
      }
    }
    rp->local = rs->local;
    rp->reqs = drq_new();
    drp_push(cx->rpaths, rp);
  }
}

fn dx_rpath_find(cx: DxCx*, module: string) -> DxRPath* {
  var i: int64 = 0;
  while (i < cx->rpaths->len) {
    if (s_eq(cx->rpaths->items[i]->module, module)) {
      return cx->rpaths->items[i];
    }
    i = i + 1;
  }
  return (DxRPath*)0;
}

fn dx_hash_manifest(h: Hasher*, m: Manifest*) {
  h_str(h, m->name);
  if (slen(m->import_root) > 0) {
    h_str(h, "import-root " + m->import_root);
  }
  var i: int64 = 0;
  while (i < m->ndeps) {
    var d: DepSpec* = man_dep(m, i);
    h_str(h, d->key);
    h_str(h, d->version);
    h_str(h, d->path);
    h_str(h, d->registry);
    i = i + 1;
  }
}

fn dx_hash_replace(h: Hasher*, rs: ReplaceSpec*) {
  h_str(h, "replace");
  h_str(h, rs->module);
  h_str(h, rs->path);
  h_str(h, rs->version);
}

fn dx_compute_reqs_hash(cx: DxCx*) -> string {
  var h: Hasher = h_new();
  h_str(&h, "mbuild-requirements-3");
  dx_hash_manifest(&h, cx->p->man);
  var i: int64 = 0;
  while (i < cx->paths->len) {
    var pp: DxPath* = dx_path_at(cx, i);
    h_str(&h, "path");
    h_str(&h, pp->key);
    h_str(&h, pp->rel);
    if (pp->man != (Manifest*)0) {
      dx_hash_manifest(&h, pp->man);
    }
    i = i + 1;
  }
  var m: Manifest* = cx->p->man;
  i = 0;
  while (i < m->nreplaces) {
    if (!m->replaces[i].local) {
      dx_hash_replace(&h, &m->replaces[i]);
    }
    i = i + 1;
  }
  return h_hex(&h);
}

// The stamp's view of mbuild.local.mettle's replacements.
fn dx_local_hash(p: Project*) -> string {
  var h: Hasher = h_new();
  var any: bool = false;
  var i: int64 = 0;
  while (i < p->man->nreplaces) {
    if (p->man->replaces[i].local) {
      dx_hash_replace(&h, &p->man->replaces[i]);
      any = true;
    }
    i = i + 1;
  }
  if (!any) {
    return "-";
  }
  return h_hex(&h);
}

// The root itself, a path package or a path replacement: never fetched.
fn dx_is_local_module(cx: DxCx*, module: string) -> bool {
  if (cx->p->has_manifest && s_eq(cx->p->man->name, module)) {
    return true;
  }
  if (dx_rpath_find(cx, module) != (DxRPath*)0) {
    return true;
  }
  var i: int64 = 0;
  while (i < cx->paths->len) {
    var pp: DxPath* = dx_path_at(cx, i);
    if (s_eq(pp->key, module)) {
      return true;
    }
    if (pp->man != (Manifest*)0 && s_eq(pp->man->name, module)) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

fn dx_mod_find(cx: DxCx*, module: string) -> DxMod* {
  var i: int64 = 0;
  while (i < cx->mods->len) {
    var m: DxMod* = dx_mod_at(cx, i);
    if (s_eq(m->module, module)) {
      return m;
    }
    i = i + 1;
  }
  return (DxMod*)0;
}

fn dx_mod_get(cx: DxCx*, module: string) -> DxMod* {
  var m: DxMod* = dx_mod_find(cx, module);
  if (m == (DxMod*)0) {
    m = new DxMod;
    m->module = module;
    m->reqs = drq_new();
    m->labels = sl_new();
    m->sel = -1;
    m->mans = dma_new();
    m->rep = (ReplaceSpec*)0;
    m->rep_req = (DxReq*)0;
    m->ix = (RegIndex*)0;
    dmo_push(cx->mods, m);
  }
  return m;
}

fn dx_first_from(m: DxMod*) -> string {
  if (m->reqs->len > 0) {
    return dx_req_at(m->reqs, 0)->from;
  }
  return "mbuild.mettle";
}

// ---------------------------------------------------------------------------
// Registries and versions
// ---------------------------------------------------------------------------

fn dx_reg_names(p: Project*) -> string {
  var l: RegList* = reg_list(p);
  var s: string = sl_join(l->names, ", ");
  free(l);
  return s;
}

fn dx_ix_err(ix: RegIndex*) -> string {
  if (slen(ix->err) > 0) {
    return ix->err;
  }
  return reg_error();
}

// The registry a package is pinned to: the root's mb_dep_from, else the
// lock's; "" for the search order.
fn dx_pinned(cx: DxCx*, module: string) -> string {
  var d: DepSpec* = man_dep_find(cx->p->man, module);
  if (d != (DepSpec*)0 && slen(d->path) == 0 && slen(d->registry) > 0) {
    return d->registry;
  }
  var li: int64 = sl_index(cx->lock->mods, module);
  if (li >= 0) {
    return sl_get(cx->lock->regs, li);
  }
  return s_empty();
}

// Package names mbuild knows, with where it knows them from (typo help).
fn dx_known_names(cx: DxCx*, names: StrList*, wheres: StrList*) {
  var i: int64 = 0;
  while (i < cx->p->man->ndeps) {
    var d: DepSpec* = man_dep(cx->p->man, i);
    if (!sl_has(names, d->key)) {
      sl_push(names, d->key);
      sl_push(wheres, "in mbuild.mettle");
    }
    i = i + 1;
  }
  i = 0;
  while (i < cx->lock->mods->len) {
    if (!sl_has(names, sl_get(cx->lock->mods, i))) {
      sl_push(names, sl_get(cx->lock->mods, i));
      sl_push(wheres, "in mbuild.lock");
    }
    i = i + 1;
  }
  i = 0;
  while (i < cx->mods->len) {
    if (!sl_has(names, dx_mod_at(cx, i)->module)) {
      sl_push(names, dx_mod_at(cx, i)->module);
      sl_push(wheres, "in the dependency graph");
    }
    i = i + 1;
  }
  // The cached indexes: $MBUILD_HOME/registry/<registry>@<hash>/index/<name>
  var rdir: string = fs_mbuild_home() + "/registry";
  var rf: StrList* = sl_new();
  var regs: StrList* = sl_new();
  if (sys_list_dir(rdir, rf, regs)) {
    var a: int64 = 0;
    while (a < regs->len) {
      var files: StrList* = sl_new();
      var dirs: StrList* = sl_new();
      if (sys_list_dir(rdir + "/" + sl_get(regs, a) + "/index", files, dirs)) {
        var b: int64 = 0;
        while (b < files->len) {
          var n: string = sl_get(files, b);
          if (man_is_package_name(n) && !sl_has(names, n)) {
            sl_push(names, n);
            sl_push(wheres, "in a cached registry index");
          }
          b = b + 1;
        }
      }
      free(files);
      free(dirs);
      a = a + 1;
    }
  }
  free(rf);
  free(regs);
}

// "did you mean strutil? (in mbuild.lock)", or "".
fn dx_suggest(cx: DxCx*, module: string) -> string {
  var names: StrList* = sl_new();
  var wheres: StrList* = sl_new();
  dx_known_names(cx, names, wheres);
  var best: int64 = -1;
  var best_d: int64 = 3;
  var i: int64 = 0;
  while (i < names->len) {
    var d: int64 = man_edit_distance(module, sl_get(names, i));
    if (d > 0 && d < best_d) {
      best_d = d;
      best = i;
    }
    i = i + 1;
  }
  var said: string = "";
  if (best >= 0) {
    said = "did you mean " + sl_get(names, best) + "? (" + sl_get(wheres, best) + ")";
  }
  free(names);
  free(wheres);
  return said;
}

fn dx_fail_missing(cx: DxCx*, module: string, from: string, pin: string) {
  var msg: string = "no registry has a package named " + module + " (required by " + from + "; searched " + dx_reg_names(cx->p) + ")";
  if (slen(pin) > 0) {
    msg = "registry " + pin + " has no package named " + module + " (required by " + from + ")";
  }
  error_msg(msg);
  var sug: string = dx_suggest(cx, module);
  if (slen(sug) > 0) {
    dx_help(sug);
  }
  dx_guard_restore();
  exit_with(1);
}

// The index of m's package: from its pinned registry, else the first in
// search order that has it. refresh asks the registry again, once per
// command and package; a package not in any cached index is asked for too.
fn dx_index(cx: DxCx*, m: DxMod*, refresh: bool) -> RegIndex* {
  if (g_dx_refreshed == (StrList*)0) {
    g_dx_refreshed = sl_new();
  }
  var done: bool = sl_has(g_dx_refreshed, m->module);
  var fresh: bool = (refresh || g_dx_refresh) && !done;
  if (m->ix != (RegIndex*)0 && !fresh) {
    return m->ix;
  }
  var pin: string = dx_pinned(cx, m->module);
  var ix: RegIndex* = reg_find(cx->p, m->module, pin, fresh);
  if (ix->ok && !ix->found && !fresh && !done) {
    fresh = true;
    ix = reg_find(cx->p, m->module, pin, true);
  }
  if (fresh) {
    sl_add_uniq(g_dx_refreshed, m->module);
  }
  if (!ix->ok) {
    dx_fail(dx_ix_err(ix));
  }
  if (!ix->found && s_contains(ix->err, "--offline")) {
    dx_fail(ix->err);
  }
  if (!ix->found) {
    dx_fail_missing(cx, m->module, dx_first_from(m), pin);
  }
  m->ix = ix;
  return ix;
}

fn dx_sort_versions(vs: StrList*) {
  var a: int64 = 1;
  while (a < vs->len) {
    var cur: string = sl_get(vs, a);
    var j: int64 = a - 1;
    while (j >= 0 && sv_cmp(sl_get(vs, j), cur) > 0) {
      sl_set(vs, j + 1, sl_get(vs, j));
      j = j - 1;
    }
    sl_set(vs, j + 1, cur);
    a = a + 1;
  }
}

// The versions in ix, lowest first; yanked ones only with yanked_too.
fn dx_versions(ix: RegIndex*, yanked_too: bool) -> StrList* {
  var vs: StrList* = sl_new();
  var i: int64 = 0;
  while (i < ix->n) {
    var rv: RegVersion* = &ix->versions[i];
    if (sv_is(rv->version) && (yanked_too || !rv->yanked)) {
      sl_push(vs, rv->version);
    }
    i = i + 1;
  }
  dx_sort_versions(vs);
  return vs;
}

// The index entry of version ("v1.0" finds "v1.0.0"); 0 when absent.
fn dx_find_version(ix: RegIndex*, version: string) -> RegVersion* {
  var rv: RegVersion* = reg_version(ix, version);
  if (rv != (RegVersion*)0) {
    return rv;
  }
  var want: string = sv_canonical(version);
  if (slen(want) == 0) {
    return (RegVersion*)0;
  }
  var i: int64 = 0;
  while (i < ix->n) {
    if (s_eq(sv_canonical(ix->versions[i].version), want)) {
      return &ix->versions[i];
    }
    i = i + 1;
  }
  return (RegVersion*)0;
}

// "sha256:<hex>" for an index entry.
fn dx_sha(rv: RegVersion*) -> string {
  var s: string = s_lower(rv->sha);
  if (s_starts(s, "sha256:")) {
    return s;
  }
  return "sha256:" + s;
}

fn dx_short_sha(s: string) -> string {
  if (slen(s) <= 23) {
    return s;
  }
  return s_sub(s, 0, 23) + "...";
}

fn dx_archive_url(ix: RegIndex*, name: string, version: string) -> string {
  var base: string = ix->url;
  while (s_ends(base, "/")) {
    base = s_sub(base, 0, slen(base) - 1);
  }
  return base + "/pkg/" + name + "/" + name + "-" + version + ".tar.gz";
}

// "available versions: v1.0.0, v1.1.0" for error messages.
fn dx_available(ix: RegIndex*) -> string {
  var vs: StrList* = dx_versions(ix, false);
  var b: string = "registry " + ix->registry + " has no versions of " + ix->name;
  if (vs->len > 0) {
    b = "available versions: " + sl_join(vs, ", ");
  }
  free(vs);
  return b;
}

// Number of numeric components written: "v1" 1, "v1.2" 2, "v1.2.3" 3.
fn dx_version_parts(spec: string) -> int64 {
  var s: string = spec;
  if (s_starts(s, "v")) {
    s = s_from(s, 1);
  }
  var cut: int64 = s_find_byte(s, 45);
  var plus: int64 = s_find_byte(s, 43);
  if (plus >= 0 && (cut < 0 || plus < cut)) {
    cut = plus;
  }
  if (cut >= 0) {
    s = s_sub(s, 0, cut);
  }
  var parts: StrList* = s_split(s, 46);
  var n: int64 = parts->len;
  free(parts);
  return n;
}

fn dx_is_partial(spec: string) -> bool {
  return sv_is(spec) && dx_version_parts(spec) < 3 && s_find_byte(spec, 45) < 0;
}

// Versions matching a partial version ("v1" -> v1.x.y, "v1.2" -> v1.2.y):
// stable ones, or with pre the pre-releases, which only a full version selects.
fn dx_matching(vs: StrList*, spec: string, pre: bool) -> StrList* {
  var want: SemVer = sv_parse(spec);
  var parts: int64 = dx_version_parts(spec);
  var found: StrList* = sl_new();
  var i: int64 = 0;
  while (i < vs->len) {
    var v: SemVer = sv_parse(sl_get(vs, i));
    if (v.ok && v.major == want.major && (parts < 2 || v.minor == want.minor) && (slen(v.pre) > 0) == pre) {
      sl_push(found, sl_get(vs, i));
    }
    i = i + 1;
  }
  return found;
}

// Whether a locked version satisfies a spec as written.
fn dx_spec_matches(spec: string, locked: string) -> bool {
  if (dx_is_partial(spec)) {
    var one: StrList* = sl_of(locked);
    var hits: StrList* = dx_matching(one, spec, false);
    var ok: bool = hits->len > 0;
    free(one);
    free(hits);
    return ok;
  }
  return s_eq(sv_canonical(locked), sv_canonical(spec));
}

// The newest version in cur's compatibility line (pre-releases only when cur
// is one), "" when none is newer.
fn dx_newest_in_line(vs: StrList*, cur: string) -> string {
  var cv: SemVer = sv_parse(cur);
  var line: string = sv_line(cur);
  var best: string = "";
  var i: int64 = 0;
  while (i < vs->len) {
    var t: string = sl_get(vs, i);
    var v: SemVer = sv_parse(t);
    if (v.ok && s_eq(sv_line(t), line) && (slen(v.pre) == 0 || slen(cv.pre) > 0)) {
      if (slen(best) == 0 || sv_cmp(t, best) > 0) {
        best = t;
      }
    }
    i = i + 1;
  }
  if (slen(best) > 0 && sv_cmp(best, cur) > 0) {
    return best;
  }
  return s_empty();
}

// The newest stable version of any line, "" when there is none.
fn dx_newest_stable(vs: StrList*) -> string {
  var best: string = "";
  var i: int64 = 0;
  while (i < vs->len) {
    var t: string = sl_get(vs, i);
    var v: SemVer = sv_parse(t);
    if (v.ok && slen(v.pre) == 0 && (slen(best) == 0 || sv_cmp(t, best) > 0)) {
      best = t;
    }
    i = i + 1;
  }
  return best;
}

// Versions after `from` up to `to` (inclusive), newest first, space-separated;
// pre-releases only when `from` is one; in from's line unless cross.
fn dx_candidates(vs: StrList*, from: string, to: string, cross: bool) -> string {
  var pre_ok: bool = slen(sv_parse(from).pre) > 0;
  var picked: StrList* = sl_new();
  var i: int64 = vs->len - 1;
  while (i >= 0) {
    var t: string = sl_get(vs, i);
    i = i - 1;
    if (sv_cmp(t, from) <= 0 || sv_cmp(t, to) > 0) {
      continue;
    }
    if (slen(sv_parse(t).pre) > 0 && !pre_ok && !s_eq(t, to)) {
      continue;
    }
    if (!cross && !s_eq(sv_line(t), sv_line(from))) {
      continue;
    }
    sl_push(picked, t);
  }
  var joined: string = sl_join(picked, " ");
  free(picked);
  return joined;
}

// The error of 14.4 for an index entry that is not the locked checksum.
fn dx_check_sha(module: string, version: string, locked: string, ix: RegIndex*, rv: RegVersion*) {
  var have: string = dx_sha(rv);
  if (s_eq(s_lower(locked), have)) {
    return;
  }
  error_msg(module + " " + version + " from registry " + ix->registry + " does not match mbuild.lock\n    mbuild.lock   " + dx_short_sha(locked) + "\n    registry      " + dx_short_sha(have) + " (" + dx_archive_url(ix, module, version) + ")\n  a published version never changes; the registry or the download was tampered with");
  dx_help("if you trust the new bytes, delete the " + module + " line from mbuild.lock and build again (review the change first)");
  dx_guard_restore();
  exit_with(1);
}

// Takes the locked version of m, checked against the index.
fn dx_take_locked(cx: DxCx*, m: DxMod*, r: DxReq*, li: int64) {
  var lv: string = sl_get(cx->lock->vers, li);
  var ix: RegIndex* = dx_index(cx, m, false);
  var rv: RegVersion* = dx_find_version(ix, lv);
  if (rv == (RegVersion*)0) {
    ix = dx_index(cx, m, true);
    rv = dx_find_version(ix, lv);
  }
  if (rv == (RegVersion*)0) {
    dx_fail_hint(m->module + " " + lv + " (pinned in mbuild.lock) is not in registry " + ix->registry, "run `mbuild update " + m->module + "` to select a version it has");
  }
  dx_check_sha(m->module, lv, sl_get(cx->lock->shas, li), ix, rv);
  if (rv->yanked && dx_once("yanked " + m->module + " " + lv)) {
    var off: string = "mbuild update " + m->module + " moves off it";
    if (slen(dx_after_yanked(ix, lv)) == 0) {
      off = "no later version of line " + sv_line(lv) + " exists";
      var back: string = dx_before_yanked(ix, lv);
      if (slen(back) > 0) {
        off = off + "; `mbuild get " + m->module + "@" + back + "` moves back to " + back;
      }
    }
    warn(m->module + " " + lv + " is yanked in registry " + ix->registry + "; " + off);
  }
  r->label = lv;
}

// `latest`: the newest stable version (in the hint line when one is given),
// else the newest pre-release; yanked versions never.
fn dx_pick_latest(cx: DxCx*, m: DxMod*, hint: string) -> string {
  var ix: RegIndex* = dx_index(cx, m, true);
  var vs: StrList* = dx_versions(ix, false);
  if (slen(hint) > 0) {
    var in_line: StrList* = sl_new();
    var k: int64 = 0;
    while (k < vs->len) {
      if (s_eq(sv_line(sl_get(vs, k)), hint)) {
        sl_push(in_line, sl_get(vs, k));
      }
      k = k + 1;
    }
    if (in_line->len > 0) {
      vs = in_line;
    }
  }
  var best: string = sv_max(vs);
  free(vs);
  if (slen(best) == 0) {
    dx_fail_hint(m->module + " has no version that can be selected in registry " + ix->registry + " (required by " + dx_first_from(m) + ")", dx_available(ix));
  }
  return best;
}

// The first version after a yanked one in its line, "" when none.
fn dx_after_yanked(ix: RegIndex*, yanked: string) -> string {
  var vs: StrList* = dx_versions(ix, false);
  var found: string = "";
  var i: int64 = 0;
  while (i < vs->len && slen(found) == 0) {
    var v: string = sl_get(vs, i);
    if (sv_cmp(v, yanked) > 0 && s_eq(sv_line(v), sv_line(yanked))) {
      found = v;
    }
    i = i + 1;
  }
  free(vs);
  return found;
}

// The newest version before a yanked one in its line, "" when none.
fn dx_before_yanked(ix: RegIndex*, yanked: string) -> string {
  var vs: StrList* = dx_versions(ix, false);
  var found: string = "";
  var i: int64 = 0;
  while (i < vs->len) {
    var v: string = sl_get(vs, i);
    if (sv_cmp(v, yanked) < 0 && s_eq(sv_line(v), sv_line(yanked))) {
      found = v;
    }
    i = i + 1;
  }
  free(vs);
  return found;
}

// A version requirement: the version itself (a minimum), the newest
// matching a partial one; a yanked version moves to the next in its line.
fn dx_pick_version(cx: DxCx*, m: DxMod*, spec: string, from: string) -> string {
  var label: string = "";
  var yanked: bool = false;
  var ix: RegIndex* = (RegIndex*)0;
  var round: int64 = 0;
  while (round < 2 && slen(label) == 0) {
    ix = dx_index(cx, m, round == 1);
    if (dx_is_partial(spec)) {
      var vs: StrList* = dx_versions(ix, false);
      var hits: StrList* = dx_matching(vs, spec, false);
      label = sv_max(hits);
      free(vs);
      free(hits);
    } else {
      var rv: RegVersion* = dx_find_version(ix, spec);
      if (rv != (RegVersion*)0 && !rv->yanked) {
        label = rv->version;
      } else if (rv != (RegVersion*)0) {
        yanked = true;
        label = dx_after_yanked(ix, rv->version);
      }
    }
    round = round + 1;
  }
  if (slen(label) == 0) {
    if (yanked) {
      dx_fail_hint(m->module + " " + spec + " is yanked in registry " + ix->registry + " and no later version of line " + sv_line(spec) + " exists (required by " + from + ")", dx_available(ix));
    }
    if (dx_is_partial(spec)) {
      var vs: StrList* = dx_versions(ix, false);
      var pres: StrList* = dx_matching(vs, spec, true);
      var shown: string = sl_join(pres, ", ");
      var newest: string = sv_max(pres);
      free(vs);
      free(pres);
      if (slen(newest) > 0) {
        dx_fail_hint(m->module + " has no stable version " + spec + " (required by " + from + "); its pre-releases: " + shown, "a pre-release is selected only by its full version, e.g. " + m->module + "@" + newest);
      }
    }
    dx_fail_hint(m->module + " has no version " + spec + " (required by " + from + ")", dx_available(ix));
  }
  if (yanked && dx_once("yanked " + m->module + " " + spec)) {
    warn(m->module + " " + spec + " is yanked in registry " + ix->registry + "; using " + label);
  }
  return label;
}

// Resolves one requirement to a version, the lock first.
fn dx_resolve_req(cx: DxCx*, m: DxMod*, r: DxReq*) {
  var spec: string = r->spec;
  if (!s_eq(spec, "latest") && !sv_is(spec)) {
    var who: string = "";
    if (!r->root) {
      who = " (required by " + r->from + ")";
    }
    dx_fail(m->module + " = " + toml_quote(spec) + ": registry packages have versions only (v1.2.0, v1, latest)" + who);
  }
  var li: int64 = -1;
  if (!sl_has(cx->unpin, m->module)) {
    li = sl_index(cx->lock->mods, m->module);
  }
  var d: DepSpec* = man_dep_find(cx->p->man, m->module);
  if (li >= 0 && d != (DepSpec*)0 && slen(d->registry) > 0 && !s_eq(d->registry, sl_get(cx->lock->regs, li))) {
    li = -1;
  }
  if (s_eq(spec, "latest")) {
    if (li >= 0) {
      dx_take_locked(cx, m, r, li);
      return;
    }
    r->fresh = true;
    r->label = dx_pick_latest(cx, m, dx_hint_line(cx, m->module));
    return;
  }
  if (li >= 0 && sv_is(sl_get(cx->lock->vers, li)) && dx_spec_matches(spec, sl_get(cx->lock->vers, li))) {
    dx_take_locked(cx, m, r, li);
    return;
  }
  r->label = dx_pick_version(cx, m, spec, r->from);
}

// ---------------------------------------------------------------------------
// The graph walk and selection
// ---------------------------------------------------------------------------

fn dx_hint_line(cx: DxCx*, module: string) -> string {
  var i: int64 = 0;
  while (i < cx->hints->len) {
    var h: string = sl_get(cx->hints, i);
    if (s_starts(h, module + " ")) {
      return s_from(h, slen(module) + 1);
    }
    i = i + 1;
  }
  return s_empty();
}

fn dx_req_new(module: string, spec: string, from: string, root: bool) -> DxReq* {
  var r: DxReq* = new DxReq;
  r->module = module;
  r->spec = spec;
  r->from = from;
  r->root = root;
  r->label = s_empty();
  r->fresh = false;
  return r;
}

fn dx_enqueue(cx: DxCx*, m: Manifest*, from: string, root: bool) {
  if (!root && m->nreplaces > 0) {
    verbose(from + ": ignoring [replace] (only the project's own replacements apply)");
  }
  var i: int64 = 0;
  while (i < m->ndeps) {
    var d: DepSpec* = man_dep(m, i);
    if (slen(d->path) > 0) {
      if (!root && !s_starts(from, "path package")) {
        verbose(from + ": ignoring path dependency '" + d->key + "' (path dependencies only apply to local packages)");
      }
    } else {
      drq_push(cx->queue, dx_req_new(d->key, d->version, from, root));
    }
    i = i + 1;
  }
}

// The manifest of one visited version, from the registry.
fn dx_node_manifest(cx: DxCx*, m: DxMod*, version: string) -> Manifest* {
  var nm: Manifest* = reg_manifest(cx->p, dx_index(cx, m, false), version);
  if (nm == (Manifest*)0) {
    dx_fail(reg_error());
  }
  return nm;
}

// Records a resolved version of m (once) and queues its requirements.
fn dx_visit(cx: DxCx*, m: DxMod*, r: DxReq*) {
  if (sl_index(m->labels, r->label) >= 0) {
    return;
  }
  sl_push(m->labels, r->label);
  var nm: Manifest* = dx_node_manifest(cx, m, r->label);
  dma_push(m->mans, nm);
  dx_enqueue(cx, nm, m->module + " " + r->label, false);
}

fn dx_walk_once(cx: DxCx*) {
  cx->mods = dmo_new();
  cx->queue = drq_new();
  var k: int64 = 0;
  while (k < cx->rpaths->len) {
    cx->rpaths->items[k]->reqs = drq_new();
    k = k + 1;
  }
  dx_enqueue(cx, cx->p->man, "mbuild.mettle", true);
  var i: int64 = 0;
  while (i < cx->paths->len) {
    var pp: DxPath* = dx_path_at(cx, i);
    if (pp->man != (Manifest*)0) {
      dx_enqueue(cx, pp->man, "path package " + pp->key, false);
    }
    i = i + 1;
  }
  i = 0;
  while (i < cx->rpaths->len) {
    var rp: DxRPath* = cx->rpaths->items[i];
    if (rp->man != (Manifest*)0) {
      dx_enqueue(cx, rp->man, rp->module + " (replaced)", false);
    }
    i = i + 1;
  }
  var qi: int64 = 0;
  while (qi < cx->queue->len) {
    var r: DxReq* = dx_req_at(cx->queue, qi);
    qi = qi + 1;
    if (dx_is_local_module(cx, r->module)) {
      var lp: DxRPath* = dx_rpath_find(cx, r->module);
      if (lp != (DxRPath*)0) {
        drq_push(lp->reqs, r);
      }
      continue;
    }
    var m: DxMod* = dx_mod_get(cx, r->module);
    var rep: ReplaceSpec* = man_replace_find(cx->p->man, r->module);
    if (rep != (ReplaceSpec*)0 && slen(rep->path) == 0) {
      m->rep = rep;
    }
    drq_push(m->reqs, r);
    if (m->rep != (ReplaceSpec*)0 && slen(m->rep->version) > 0) {
      // Selected exactly as replaced: the requirement itself is not resolved.
      if (m->rep_req == (DxReq*)0) {
        var src: string = "mbuild.mettle";
        if (m->rep->local) {
          src = "mbuild.local.mettle";
        }
        var rr: DxReq* = dx_req_new(m->module, m->rep->version, src, true);
        m->rep_req = rr;
        dx_resolve_req(cx, m, rr);
        dx_visit(cx, m, rr);
      }
      continue;
    }
    dx_resolve_req(cx, m, r);
    dx_visit(cx, m, r);
  }
}

// A requirement counts when its requirer is in the build: the root, a path
// package, a replacement, or the selected version of a package.
fn dx_live(cx: DxCx*, r: DxReq*) -> bool {
  if (r->root || s_starts(r->from, "path package ")) {
    return true;
  }
  var sp: int64 = s_find_byte(r->from, 32);
  if (sp < 0) {
    return true;
  }
  var owner: DxMod* = dx_mod_find(cx, s_sub(r->from, 0, sp));
  if (owner == (DxMod*)0) {
    return true;
  }
  if (owner->sel < 0) {
    return false;
  }
  return s_eq(sl_get(owner->labels, owner->sel), s_from(r->from, sp + 1));
}

// The selected index for m from its live requirements, -1 when none is live.
fn dx_pick(cx: DxCx*, m: DxMod*) -> int64 {
  var any: bool = false;
  var best: string = "";
  var i: int64 = 0;
  while (i < m->reqs->len) {
    var r: DxReq* = dx_req_at(m->reqs, i);
    i = i + 1;
    if (!dx_live(cx, r)) {
      continue;
    }
    any = true;
    if (slen(best) == 0 || sv_cmp(r->label, best) > 0) {
      best = r->label;
    }
  }
  if (!any) {
    return -1;
  }
  if (m->rep_req != (DxReq*)0) {
    return sl_index(m->labels, m->rep_req->label);
  }
  return sl_index(m->labels, best);
}

// Selection to a fixed point: a package whose selected version changes can
// drop or bring back the requirements of the versions it no longer selects.
fn dx_select_all(cx: DxCx*) {
  var i: int64 = 0;
  while (i < cx->mods->len) {
    dx_mod_at(cx, i)->sel = -1;
    i = i + 1;
  }
  var round: int64 = 0;
  var moved: bool = true;
  while (moved && round < 10) {
    moved = false;
    i = 0;
    while (i < cx->mods->len) {
      var m: DxMod* = dx_mod_at(cx, i);
      var s: int64 = dx_pick(cx, m);
      if (s != m->sel) {
        m->sel = s;
        moved = true;
      }
      i = i + 1;
    }
    round = round + 1;
  }
}

// `latest` stated by the root and resolved now: when the package's other
// live requirements all name one line, take the newest version in that line
// instead (so `latest` never makes a conflict). True when a hint was added.
fn dx_latest_hints(cx: DxCx*) -> bool {
  var added: bool = false;
  var i: int64 = 0;
  while (i < cx->mods->len) {
    var m: DxMod* = dx_mod_at(cx, i);
    i = i + 1;
    var lat: DxReq* = (DxReq*)0;
    var other: string = "";
    var mixed: bool = false;
    var k: int64 = 0;
    while (k < m->reqs->len) {
      var r: DxReq* = dx_req_at(m->reqs, k);
      k = k + 1;
      if (!dx_live(cx, r)) {
        continue;
      }
      if (r->root && r->fresh && s_eq(r->spec, "latest")) {
        lat = r;
      } else if (sv_is(r->label)) {
        var ln: string = sv_line(r->label);
        if (slen(other) == 0) {
          other = ln;
        } else if (!s_eq(other, ln)) {
          mixed = true;
        }
      }
    }
    if (lat == (DxReq*)0 || slen(other) == 0 || mixed || !sv_is(lat->label) || s_eq(sv_line(lat->label), other)) {
      continue;
    }
    if (slen(dx_hint_line(cx, m->module)) == 0) {
      sl_push(cx->hints, m->module + " " + other);
      added = true;
    }
  }
  return added;
}

fn dx_walk(cx: DxCx*) {
  var round: int64 = 0;
  while (true) {
    dx_walk_once(cx);
    dx_select_all(cx);
    round = round + 1;
    if (round >= 3 || !dx_latest_hints(cx)) {
      break;
    }
  }
}

// "mbuild.mettle -> old v1.0.0" for a requirement's `from`: each requiring
// node followed back through the first requirement that introduced its
// version.
fn dx_chain(cx: DxCx*, from: string) -> string {
  var parts: StrList* = sl_of(from);
  var cur: string = from;
  var hops: int64 = 0;
  while (hops < 32) {
    hops = hops + 1;
    if (s_eq(cur, "mbuild.mettle") || s_eq(cur, "mbuild.local.mettle")) {
      break;
    }
    if (s_starts(cur, "path package ") || s_ends(cur, " (replaced)")) {
      sl_push(parts, "mbuild.mettle");
      break;
    }
    var sp: int64 = s_find_byte(cur, 32);
    if (sp < 0) {
      break;
    }
    var m: DxMod* = dx_mod_find(cx, s_sub(cur, 0, sp));
    if (m == (DxMod*)0) {
      break;
    }
    var ver: string = s_from(cur, sp + 1);
    var via: DxReq* = (DxReq*)0;
    if (m->rep_req != (DxReq*)0 && s_eq(m->rep_req->label, ver)) {
      via = m->rep_req;
    }
    var i: int64 = 0;
    while (i < m->reqs->len && via == (DxReq*)0) {
      if (s_eq(dx_req_at(m->reqs, i)->label, ver)) {
        via = dx_req_at(m->reqs, i);
      }
      i = i + 1;
    }
    if (via == (DxReq*)0 || sl_has(parts, via->from)) {
      break;
    }
    sl_push(parts, via->from);
    cur = via->from;
  }
  var b: Buf* = buf_new();
  var j: int64 = parts->len - 1;
  while (j >= 0) {
    buf_add(b, sl_get(parts, j));
    if (j > 0) {
      buf_add(b, " -> ");
    }
    j = j - 1;
  }
  free(parts);
  return buf_take(b);
}

fn dx_live_reqs(cx: DxCx*, m: DxMod*) -> DxReqs* {
  var l: DxReqs* = drq_new();
  var i: int64 = 0;
  while (i < m->reqs->len) {
    if (dx_live(cx, dx_req_at(m->reqs, i))) {
      drq_push(l, dx_req_at(m->reqs, i));
    }
    i = i + 1;
  }
  return l;
}

// Insertion sort of "version<TAB>text" entries by version, then text.
fn dx_sort_by_version(l: StrList*) {
  var a: int64 = 1;
  while (a < l->len) {
    var cur: string = sl_get(l, a);
    var j: int64 = a - 1;
    while (j >= 0 && dx_vt_cmp(sl_get(l, j), cur) > 0) {
      sl_set(l, j + 1, sl_get(l, j));
      j = j - 1;
    }
    sl_set(l, j + 1, cur);
    a = a + 1;
  }
}

fn dx_vt_cmp(x: string, y: string) -> int32 {
  var tx: int64 = s_find_byte(x, 9);
  var ty: int64 = s_find_byte(y, 9);
  var c: int32 = sv_cmp(s_sub(x, 0, tx), s_sub(y, 0, ty));
  if (c != 0) {
    return c;
  }
  return s_cmp(x, y);
}

// For a requirer "R V" on a losing line: R's newest version after V (at most
// 20 manifests read) that requires the package in the winning line.
fn dx_upgrade_help(cx: DxCx*, module: string, from: string, win: string) -> string {
  var sp: int64 = s_find_byte(from, 32);
  if (sp < 0) {
    return s_empty();
  }
  var rm: DxMod* = dx_mod_find(cx, s_sub(from, 0, sp));
  var ver: string = s_from(from, sp + 1);
  if (rm == (DxMod*)0 || !sv_is(ver)) {
    return s_empty();
  }
  var ix: RegIndex* = dx_index(cx, rm, false);
  var vs: StrList* = dx_versions(ix, false);
  var found: string = "";
  var looked: int64 = 0;
  var i: int64 = vs->len - 1;
  while (i >= 0 && looked < 20 && slen(found) == 0) {
    var t: string = sl_get(vs, i);
    i = i - 1;
    if (sv_cmp(t, ver) <= 0) {
      break;
    }
    looked = looked + 1;
    var nm: Manifest* = reg_manifest(cx->p, ix, t);
    if (nm == (Manifest*)0) {
      continue;
    }
    var d: DepSpec* = man_dep_find(nm, module);
    if (d != (DepSpec*)0 && slen(d->path) == 0 && sv_is(d->version) && s_eq(sv_line(d->version), win)) {
      found = rm->module + " " + t + " requires " + module + " " + d->version + ": run `mbuild get " + rm->module + "@" + t + "`";
    }
  }
  free(vs);
  return found;
}

fn dx_conflict_lines(cx: DxCx*, m: DxMod*, vers: DxReqs*) {
  var rows: StrList* = sl_new();
  var highest: string = "";
  var i: int64 = 0;
  while (i < vers->len) {
    var r: DxReq* = dx_req_at(vers, i);
    if (slen(highest) == 0 || sv_cmp(r->label, highest) > 0) {
      highest = r->label;
    }
    sl_add_uniq(rows, r->label + "\t" + r->label + " (line " + sv_line(r->label) + ") by " + dx_chain(cx, r->from));
    i = i + 1;
  }
  dx_sort_by_version(rows);
  var shown: StrList* = sl_new();
  i = 0;
  while (i < rows->len) {
    var row: string = sl_get(rows, i);
    sl_push(shown, s_from(row, s_find_byte(row, 9) + 1));
    i = i + 1;
  }
  var win: string = sv_line(highest);
  error_msg(m->module + " is required at incompatible versions:\n    " + sl_join(shown, "\n    ") + "\n  a program holds one version of a package: two lines would declare the same exported names twice");
  var done: StrList* = sl_new();
  i = 0;
  while (i < vers->len) {
    var r2: DxReq* = dx_req_at(vers, i);
    i = i + 1;
    if (r2->root || s_eq(sv_line(r2->label), win) || sl_has(done, r2->from)) {
      continue;
    }
    sl_push(done, r2->from);
    var h: string = dx_upgrade_help(cx, m->module, r2->from, win);
    if (slen(h) > 0) {
      dx_help(h);
    }
  }
  dx_help("or choose one version for the whole build in mbuild.mettle (you take responsibility for the others):");
  err_line("          mb_replace_version(\"" + m->module + "\", \"" + highest + "\");");
  free(rows);
  free(shown);
  free(done);
  dx_guard_restore();
  exit_with(1);
}

// Checks the selection of m against its live requirements (12.3).
fn dx_check_select(cx: DxCx*, m: DxMod*) {
  var live: DxReqs* = dx_live_reqs(cx, m);
  var i: int64 = 0;
  if (m->rep_req != (DxReq*)0) {
    var chosen: string = sl_get(m->labels, m->sel);
    while (i < live->len) {
      var lr: DxReq* = dx_req_at(live, i);
      verbose(m->module + " is replaced (" + chosen + "); ignoring " + dx_chain(cx, lr->from) + " requires " + lr->spec);
      i = i + 1;
    }
    free(live);
    return;
  }
  var lines: StrList* = sl_new();
  while (i < live->len) {
    sl_add_uniq(lines, sv_line(dx_req_at(live, i)->label));
    i = i + 1;
  }
  if (lines->len > 1) {
    dx_conflict_lines(cx, m, live);
  }
  free(lines);
  free(live);
}

fn dx_sort_mods(cx: DxCx*) {
  var l: DxMods* = cx->mods;
  var a: int64 = 1;
  while (a < l->len) {
    var cur: DxMod* = l->items[a];
    var j: int64 = a - 1;
    while (j >= 0 && s_cmp(l->items[j]->module, cur->module) > 0) {
      l->items[j + 1] = l->items[j];
      j = j - 1;
    }
    l->items[j + 1] = cur;
    a = a + 1;
  }
}

// ---------------------------------------------------------------------------
// Package directories, mettle.deps, the DepState
// ---------------------------------------------------------------------------

// The .mbuild-pkg line (14.4).
fn dx_marker_line(name: string, version: string, sha: string, registry: string) -> string {
  return name + " " + version + " " + sha + " " + registry;
}

fn dx_has_marker(dest: string, marker: string) -> bool {
  return !sys_is_link(dest) && s_eq(s_trim(reg_marker(dest)), marker);
}

// Extracts the selected version of a package into .mbuild/deps/<name>
// unless its marker already names it.
fn dx_materialise(cx: DxCx*, ix: RegIndex*, rv: RegVersion*) {
  var name: string = ix->name;
  var dest: string = dx_deps_dir(cx->p) + "/" + name;
  var marker: string = dx_marker_line(name, rv->version, dx_sha(rv), ix->registry);
  if (sys_is_link(dest)) {
    // It was a local replacement: the link goes, its target stays.
    verbose("removing the link " + dest);
    sys_remove_link(dest);
  }
  var force: bool = cx->p->opts->force && !dx_set_has(g_dx_forced, dest);
  if (dx_has_marker(dest, marker) && !force) {
    return;
  }
  if (force) {
    // --force: extract again, restoring edited or deleted files.
    g_dx_forced = g_dx_forced + dest + "\n";
  }
  var archive: string = reg_fetch(cx->p, ix, rv->version);
  if (slen(archive) == 0) {
    dx_fail(reg_error());
  }
  if (fs_exists(dest)) {
    sys_remove_tree(dest);
  }
  fs_mkdirs(dx_deps_dir(cx->p));
  verbose("extracting " + name + " " + rv->version + " into " + dest);
  var e: string = reg_extract(archive, rv->sha, dest, marker);
  if (slen(e) > 0) {
    dx_fail(e);
  }
}

// Links .mbuild/deps/<name> to target (an absolute directory).
fn dx_link(dest: string, target: string) {
  if (!sys_is_link(dest) && fs_exists(dest)) {
    verbose("removing " + dest + " (now a link to " + target + ")");
    sys_remove_tree(dest);
  }
  fs_mkdirs(p_dir(dest));
  verbose("link " + dest + " -> " + target);
  if (!sys_make_link(target, dest)) {
    dx_fail("cannot make the link " + dest + " -> " + target);
  }
}

fn dx_make_links(cx: DxCx*) {
  var i: int64 = 0;
  while (i < cx->rpaths->len) {
    var rp: DxRPath* = cx->rpaths->items[i];
    dx_link(dx_deps_dir(cx->p) + "/" + rp->module, rp->dir);
    i = i + 1;
  }
}

fn dx_links_present(cx: DxCx*) -> bool {
  var i: int64 = 0;
  while (i < cx->rpaths->len) {
    if (!sys_is_link(dx_deps_dir(cx->p) + "/" + cx->rpaths->items[i]->module)) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

// Removes package directories (with a .mbuild-pkg) no longer selected, and
// links no longer wanted. Never enters a link.
fn dx_prune(cx: DxCx*, selected: StrList*) {
  var root: string = dx_deps_dir(cx->p);
  var files: StrList* = sl_new();
  var dirs: StrList* = sl_new();
  if (!sys_list_dir(root, files, dirs)) {
    free(files);
    free(dirs);
    return;
  }
  var names: StrList* = sl_copy(dirs);
  sl_extend(names, files);
  var i: int64 = 0;
  while (i < names->len) {
    var name: string = sl_get(names, i);
    var dir: string = root + "/" + name;
    var is_dir: bool = i < dirs->len;
    i = i + 1;
    if (sys_is_link(dir)) {
      if (dx_rpath_find(cx, name) == (DxRPath*)0) {
        verbose("removing the link " + dir);
        sys_remove_link(dir);
      }
    } else if (is_dir && !sl_has(selected, name) && fs_is_file(dir + "/.mbuild-pkg")) {
      verbose("removing unused package " + dir);
      sys_remove_tree(dir);
    }
  }
  free(names);
  free(files);
  free(dirs);
}

fn dx_block_begin() -> string {
  return "# >>> mbuild: generated, edits inside this block are overwritten";
}

// Replaces (or adds, or drops) the managed block of dir/mettle.deps; lines
// outside the block are the user's and are kept. Written only on change.
fn dx_write_mettle_deps(dir: string, lines: StrList*) {
  var file: string = dir + "/mettle.deps";
  var r: FsRead = fs_read(file);
  var b: Buf* = buf_new();
  var block: Buf* = buf_new();
  if (lines->len > 0) {
    buf_line(block, dx_block_begin());
    var k: int64 = 0;
    while (k < lines->len) {
      buf_line(block, sl_get(lines, k));
      k = k + 1;
    }
    buf_line(block, "# <<< mbuild");
  }
  var block_text: string = buf_take(block);
  var placed: bool = false;
  var user: bool = false;
  if (r.ok) {
    var old: StrList* = s_lines(r.data);
    var inside: bool = false;
    var i: int64 = 0;
    while (i < old->len) {
      var l: string = sl_get(old, i);
      var t: string = s_trim(l);
      if (inside) {
        if (s_starts(t, "# <<< mbuild")) {
          inside = false;
        }
      } else if (s_starts(t, "# >>> mbuild")) {
        inside = true;
        if (!placed) {
          buf_add(b, block_text);
          placed = true;
        }
      } else {
        buf_line(b, l);
        if (slen(t) > 0) {
          user = true;
        }
      }
      i = i + 1;
    }
    free(old);
  }
  if (!placed) {
    buf_add(b, block_text);
  }
  var text: string = buf_take(b);
  if (!r.ok) {
    if (lines->len > 0) {
      fs_write(file, text);
    }
    return;
  }
  if (lines->len == 0 && !user) {
    sys_remove_file(file);
    return;
  }
  fs_write_if_changed(file, text);
}

// What one package's mettle.deps block publishes to that package's own
// files (the compiler takes the nearest mettle.deps first).
struct DxBlock {
  cx: DxCx*;
  dir: string;          // the package directory (the file goes here)
  man: Manifest*;       // its manifest, 0 when it has none
  selected: StrList*;   // the registry and replaced packages of the build
  is_root: bool;        // the root: also `mbuild=`, with warnings
  local: bool;          // root or a path package: path dependencies apply
  mods: StrList*;       // the selected registry packages
  mans: DxMans*;        // their manifests (parallel to mods)
}

fn dx_path_by_dir(cx: DxCx*, dir: string) -> DxPath* {
  var i: int64 = 0;
  while (i < cx->paths->len) {
    if (s_eq(dx_path_at(cx, i)->dir, dir)) {
      return dx_path_at(cx, i);
    }
    i = i + 1;
  }
  return (DxPath*)0;
}

// The directory the compiler should see for a selected package.
fn dx_pkg_dir(cx: DxCx*, name: string) -> string {
  if (dx_rpath_find(cx, name) != (DxRPath*)0) {
    return dx_deps_dir(cx->p) + "/" + name;
  }
  return cx->deps_root + "/" + name;
}

// The manifest of a selected package, 0 when it has none.
fn dx_block_man(bl: DxBlock*, name: string) -> Manifest* {
  var rp: DxRPath* = dx_rpath_find(bl->cx, name);
  if (rp != (DxRPath*)0) {
    return rp->man;
  }
  var at: int64 = sl_index(bl->mods, name);
  if (at < 0) {
    return (Manifest*)0;
  }
  return bl->mans->items[at];
}

// The packages the manifest declares (14.5), its path packages, itself
// (`name=.`) and, for the root, the mbuild API; each names the package's
// import root.
fn dx_block_write(bl: DxBlock*) {
  var cx: DxCx* = bl->cx;
  var p: Project* = cx->p;
  var lines: StrList* = sl_new();
  var used: StrList* = sl_new();
  var m: Manifest* = bl->man;
  if (m != (Manifest*)0) {
    var i: int64 = 0;
    while (i < m->ndeps) {
      var d: DepSpec* = man_dep(m, i);
      i = i + 1;
      if (slen(d->path) == 0 && sl_has(bl->selected, d->key) && !sl_has(used, d->key)) {
        sl_push(lines, d->key + "=" + dx_rel(bl->dir, man_import_dir(dx_block_man(bl, d->key), dx_pkg_dir(cx, d->key))));
        sl_push(used, d->key);
      }
    }
    i = 0;
    while (i < m->ndeps && bl->local) {
      var pd: DepSpec* = man_dep(m, i);
      i = i + 1;
      if (slen(pd->path) == 0) {
        continue;
      }
      var pp: DxPath* = dx_path_by_dir(cx, p_clean(p_join(m->dir, pd->path)));
      if (pp == (DxPath*)0) {
        continue;
      }
      if (sl_has(used, pd->key)) {
        if (bl->is_root) {
          warn("path dependency '" + pd->key + "' uses a name that is already published in mettle.deps");
        }
      } else {
        var to: string = man_import_dir(pp->man, pp->dir);
        if (!p_is_abs(pd->path)) {
          to = dx_rel(bl->dir, to);
        }
        sl_push(lines, pd->key + "=" + to);
        sl_push(used, pd->key);
      }
    }
    var own: bool = !bl->is_root || p->has_manifest;
    if (own && man_is_package_name(m->name) && !sl_has(used, m->name)) {
      sl_push(lines, m->name + "=" + dx_rel(bl->dir, man_import_dir(m, bl->dir)));
      sl_push(used, m->name);
    }
  }
  if (bl->is_root && slen(p->mbfile) > 0 && !sl_has(used, "mbuild")) {
    sl_push(lines, "mbuild=" + dx_rel(bl->dir, p->state_dir + "/api/mbuild"));
    sl_push(used, "mbuild");
  }
  dx_write_mettle_deps(bl->dir, lines);
  if (bl->is_root) {
    sl_extend(cx->published, used);
  }
  free(lines);
  free(used);
}

fn dx_replaced_kind(rs: ReplaceSpec*) -> string {
  if (rs == (ReplaceSpec*)0) {
    return s_empty();
  }
  if (slen(rs->path) > 0) {
    return "path";
  }
  return "version";
}

// The DepState for the selected packages (already in place) and the path
// packages; also writes the mettle.deps blocks: the root's, and one in every
// path package, package directory and path replacement.
fn dx_finish(cx: DxCx*, a: DxLockArgs*, mans: DxMans*) -> DepState* {
  var p: Project* = cx->p;
  var ds: DepState* = depstate_empty(dx_deps_dir(p));
  var selected: StrList* = sl_copy(a->mods);
  var i: int64 = 0;
  while (i < a->mods->len) {
    var name: string = sl_get(a->mods, i);
    var dm: DepModule;
    dm.module = name;
    dm.version = sl_get(a->vers, i);
    dm.dir = dx_pkg_dir(cx, name);
    dm.is_path = false;
    dm.man = mans->items[i];
    dm.replaced = dx_replaced_kind(man_replace_find(p->man, name));
    dm.checksum = sl_get(a->shas, i);
    dm.registry = sl_get(a->regs, i);
    depstate_add(ds, dm);
    i = i + 1;
  }
  i = 0;
  while (i < cx->rpaths->len) {
    var rp: DxRPath* = cx->rpaths->items[i];
    var rm: DepModule;
    rm.module = rp->module;
    rm.version = s_empty();
    rm.dir = rp->dir;
    rm.is_path = false;
    rm.man = rp->man;
    rm.replaced = "path";
    rm.checksum = s_empty();
    rm.registry = s_empty();
    depstate_add(ds, rm);
    sl_add_uniq(selected, rp->module);
    i = i + 1;
  }
  i = 0;
  while (i < cx->paths->len) {
    var pp: DxPath* = dx_path_at(cx, i);
    var pm: DepModule;
    pm.module = pp->key;
    pm.version = s_empty();
    pm.dir = pp->dir;
    pm.is_path = true;
    pm.man = pp->man;
    pm.replaced = s_empty();
    pm.checksum = s_empty();
    pm.registry = s_empty();
    depstate_add(ds, pm);
    i = i + 1;
  }
  var bl: DxBlock* = new DxBlock;
  bl->cx = cx;
  bl->selected = selected;
  bl->mods = a->mods;
  bl->mans = mans;
  bl->dir = p->root;
  bl->man = p->man;
  bl->is_root = true;
  bl->local = true;
  dx_block_write(bl);
  bl->is_root = false;
  i = 0;
  while (i < cx->paths->len) {
    var lp: DxPath* = dx_path_at(cx, i);
    if (!s_eq(lp->dir, p->root)) {
      bl->dir = lp->dir;
      bl->man = lp->man;
      dx_block_write(bl);
    }
    i = i + 1;
  }
  bl->local = false;
  i = 0;
  while (i < a->mods->len) {
    var cdir: string = dx_pkg_dir(cx, sl_get(a->mods, i));
    if (fs_is_dir(cdir) && !sys_is_link(cdir)) {
      bl->dir = cdir;
      bl->man = mans->items[i];
      dx_block_write(bl);
    }
    i = i + 1;
  }
  i = 0;
  while (i < cx->rpaths->len) {
    var xp: DxRPath* = cx->rpaths->items[i];
    if (!s_eq(xp->dir, p->root)) {
      bl->dir = xp->dir;
      bl->man = xp->man;
      dx_block_write(bl);
    }
    i = i + 1;
  }
  free(bl);
  free(selected);
  if (!g_dx_md_checked) {
    g_dx_md_checked = true;
    dx_check_user_lines(cx);
  }
  return ds;
}

// The lines of the root mettle.deps outside mbuild's block: warnings once
// per command (12.6).
fn dx_check_user_lines(cx: DxCx*) {
  var r: FsRead = fs_read(cx->p->root + "/mettle.deps");
  if (!r.ok) {
    return;
  }
  var lines: StrList* = s_lines(r.data);
  var inside: bool = false;
  var noted: bool = false;
  var before_block: bool = true;
  var i: int64 = 0;
  while (i < lines->len) {
    var t: string = s_trim(sl_get(lines, i));
    var n: int64 = i + 1;
    i = i + 1;
    if (inside) {
      if (s_starts(t, "# <<< mbuild")) {
        inside = false;
      }
      continue;
    }
    if (s_starts(t, "# >>> mbuild")) {
      inside = true;
      before_block = false;
      continue;
    }
    var eq: int64 = s_find_byte(t, 61);
    if (slen(t) == 0 || s_starts(t, "#") || eq <= 0) {
      continue;
    }
    var name: string = s_trim(s_sub(t, 0, eq));
    var dir: string = s_trim(s_from(t, eq + 1));
    if (!cx->p->has_manifest) {
      if (!noted) {
        noted = true;
        note("mettle.deps names packages mbuild does not manage; `mbuild init` turns them into dependencies in mbuild.mettle");
      }
      continue;
    }
    if (before_block && sl_has(cx->published, name)) {
      warn("mettle.deps:" + s_int(n) + ": " + t + " shadows mbuild's entry for " + name + "; remove it");
      continue;
    }
    warn("mettle.deps:" + s_int(n) + ": " + t + " is not managed by mbuild (its dependencies and C code are ignored)");
    if (man_is_package_name(name)) {
      dx_help("run mbuild tidy to move it into mbuild.mettle as mb_dep_path(\"" + name + "\", \"" + dir + "\");");
    }
  }
  free(lines);
}

fn dx_stamp_text(cx: DxCx*) -> string {
  return "mbuild-deps-3\nlock " + hash_string(cx->lock->text) + "\nreqs " + cx->reqs_hash + "\nlocal " + dx_local_hash(cx->p) + "\n";
}

// A manifest from the registry cache only (the fast path); 0 when missing.
fn dx_cached_manifest(cx: DxCx*, name: string, version: string, registry: string) -> Manifest* {
  var ix: RegIndex* = reg_index(cx->p, registry, name, false);
  g_dx_last_ix = ix;
  if (!ix->ok || !ix->found) {
    return (Manifest*)0;
  }
  return reg_manifest(cx->p, ix, version);
}

fn dx_lock_args(cx: DxCx*) -> DxLockArgs* {
  var a: DxLockArgs* = dx_args_new(cx->lock->reqs);
  sl_extend(a->mods, cx->lock->mods);
  sl_extend(a->vers, cx->lock->vers);
  sl_extend(a->regs, cx->lock->regs);
  sl_extend(a->shas, cx->lock->shas);
  return a;
}

// No registry: the stamp matches, every package directory carries the
// marker of its locked version, and the replacement links are there.
fn dx_fast(cx: DxCx*) -> DepState* {
  var st: FsRead = fs_read(dx_stamp_path(cx->p));
  if (!st.ok || !s_eq(st.data, dx_stamp_text(cx)) || !dx_links_present(cx)) {
    return (DepState*)0;
  }
  var a: DxLockArgs* = dx_lock_args(cx);
  var mans: DxMans* = dma_new();
  var i: int64 = 0;
  while (i < a->mods->len) {
    var name: string = sl_get(a->mods, i);
    var marker: string = dx_marker_line(name, sl_get(a->vers, i), sl_get(a->shas, i), sl_get(a->regs, i));
    var nm: Manifest* = (Manifest*)0;
    if (dx_has_marker(dx_deps_dir(cx->p) + "/" + name, marker)) {
      nm = dx_cached_manifest(cx, name, sl_get(a->vers, i), sl_get(a->regs, i));
    }
    if (nm == (Manifest*)0) {
      free(mans->items);
      free(mans);
      free(a);
      return (DepState*)0;
    }
    dma_push(mans, nm);
    i = i + 1;
  }
  verbose("dependencies: mbuild.lock unchanged, packages in place");
  var ds: DepState* = dx_finish(cx, a, mans);
  free(mans->items);
  free(mans);
  free(a);
  return ds;
}

// update --all: every selected package the root does not require whose
// selected version has a newer one in its line goes to g_dx_raise_mods /
// g_dx_raise_vers. True when there is one.
fn dx_find_raises(cx: DxCx*) -> bool {
  g_dx_raise_mods = sl_new();
  g_dx_raise_vers = sl_new();
  var i: int64 = 0;
  while (i < cx->mods->len) {
    var m: DxMod* = dx_mod_at(cx, i);
    i = i + 1;
    if (m->sel < 0) {
      continue;
    }
    var rooted: bool = false;
    var k: int64 = 0;
    while (k < m->reqs->len) {
      if (dx_req_at(m->reqs, k)->root) {
        rooted = true;
      }
      k = k + 1;
    }
    var label: string = sl_get(m->labels, m->sel);
    if (rooted) {
      continue;
    }
    var vs: StrList* = dx_versions(dx_index(cx, m, true), false);
    var newer: string = dx_newest_in_line(vs, label);
    free(vs);
    if (slen(newer) > 0) {
      sl_push(g_dx_raise_mods, m->module);
      sl_push(g_dx_raise_vers, newer);
      dx_announce("Updating", m->module, label + " -> " + newer + " (now required in mbuild.mettle)", newer);
    }
  }
  return g_dx_raise_mods->len > 0;
}

// vendor/ in place of the registry (14.5): its modules.txt must name the
// current lock. 0 when there is no vendor/.
fn dx_vendor_state(cx: DxCx*) -> DepState* {
  var p: Project* = cx->p;
  var vdir: string = dx_vendor_dir(p);
  var r: FsRead = fs_read(vdir + "/modules.txt");
  if (!r.ok) {
    return (DepState*)0;
  }
  var lines: StrList* = s_lines(r.data);
  var fresh: bool = lines->len > 0 && s_eq(s_trim(sl_get(lines, 0)), "# lock " + hash_string(cx->lock->text)) && s_eq(cx->lock->reqs, cx->reqs_hash);
  if (!fresh) {
    free(lines);
    dx_fail_hint("vendor/ is out of date with mbuild.lock", "run mbuild vendor (or delete vendor/)");
  }
  var a: DxLockArgs* = dx_args_new(cx->lock->reqs);
  var mans: DxMans* = dma_new();
  var i: int64 = 1;
  while (i < lines->len) {
    var f: StrList* = s_fields(sl_get(lines, i));
    i = i + 1;
    if (f->len < 3 || s_starts(sl_get(f, 0), "#")) {
      free(f);
      continue;
    }
    var name: string = sl_get(f, 0);
    var file: string = vdir + "/" + name + ".toml";
    var mr: FsRead = fs_read(file);
    if (!fs_is_dir(vdir + "/" + name) || !mr.ok) {
      dx_fail_hint("vendor/ is missing " + name, "run mbuild vendor (or delete vendor/)");
    }
    var li: int64 = sl_index(cx->lock->mods, name);
    var reg: string = "";
    if (li >= 0) {
      reg = sl_get(cx->lock->regs, li);
    }
    sl_push(a->mods, name);
    sl_push(a->vers, sl_get(f, 1));
    sl_push(a->shas, sl_get(f, 2));
    sl_push(a->regs, reg);
    dma_push(mans, dx_parse_manifest(mr.data, vdir + "/" + name, file));
    free(f);
  }
  free(lines);
  cx->deps_root = vdir;
  dx_make_links(cx);
  verbose("dependencies: from vendor/");
  var ds: DepState* = dx_finish(cx, a, mans);
  free(mans->items);
  free(mans);
  free(a);
  return ds;
}

// The whole of deps_ensure. unpin: packages whose lock pins are ignored;
// slow: skip the fast path (fetch, update).
fn dx_ensure(p: Project*, unpin: StrList*, slow: bool) -> DepState* {
  var cx: DxCx* = dx_cx_new(p);
  sl_extend(cx->unpin, unpin);
  dx_collect_paths(cx);
  cx->reqs_hash = dx_compute_reqs_hash(cx);
  var local: bool = cx->local_names->len > 0;
  if (local && !g_dx_local_noted) {
    g_dx_local_noted = true;
    note("using replacements from mbuild.local.mettle (" + sl_join(cx->local_names, ", ") + "); mbuild.lock is left as it is");
  }
  if (!g_dx_no_vendor) {
    var vds: DepState* = dx_vendor_state(cx);
    if (vds != (DepState*)0) {
      return vds;
    }
  }
  if (!slow && !p->opts->force) {
    var fast: DepState* = dx_fast(cx);
    if (fast != (DepState*)0) {
      return fast;
    }
  }
  var has_reqs: bool = cx->lock->mods->len > 0;
  var k: int64 = 0;
  while (k < p->man->ndeps) {
    if (slen(man_dep(p->man, k)->path) == 0) {
      has_reqs = true;
    }
    k = k + 1;
  }
  k = 0;
  while (k < cx->paths->len) {
    var pm: Manifest* = dx_path_at(cx, k)->man;
    if (pm != (Manifest*)0 && pm->ndeps > 0) {
      has_reqs = true;
    }
    k = k + 1;
  }
  if (has_reqs) {
    status("Resolving", "dependencies");
  }
  dx_walk(cx);
  dx_sort_mods(cx);
  var a: DxLockArgs* = dx_args_new(cx->reqs_hash);
  var mans: DxMans* = dma_new();
  var picked: DxMods* = dmo_new();
  var i: int64 = 0;
  while (i < cx->mods->len) {
    var m: DxMod* = dx_mod_at(cx, i);
    i = i + 1;
    if (m->sel < 0) {
      continue;
    }
    dx_check_select(cx, m);
    var label: string = sl_get(m->labels, m->sel);
    var rv: RegVersion* = dx_find_version(dx_index(cx, m, false), label);
    if (rv == (RegVersion*)0) {
      dx_fail(m->module + " " + label + " is not in the index of registry " + m->ix->registry);
    }
    sl_push(a->mods, m->module);
    sl_push(a->vers, label);
    sl_push(a->regs, m->ix->registry);
    sl_push(a->shas, dx_sha(rv));
    dma_push(mans, m->mans->items[m->sel]);
    dmo_push(picked, m);
  }
  if (g_dx_raise_all && dx_find_raises(cx)) {
    return (DepState*)0;
  }
  var text: string = dx_lock_render(a);
  var changed: bool = !s_eq(text, cx->lock->text) && (cx->lock->exists || a->mods->len > 0);
  if (changed && p->opts->locked && !local) {
    var what: string = "mbuild.lock is missing";
    if (cx->lock->exists) {
      what = "mbuild.lock is out of date";
    }
    dx_fail_hint(what + " and --locked forbids changing it", "run the command without --locked (for example `mbuild fetch`) and commit the new mbuild.lock");
  }
  dx_lock_diff(cx->lock, a);
  i = 0;
  while (i < picked->len) {
    var pm2: DxMod* = picked->items[i];
    dx_materialise(cx, pm2->ix, dx_find_version(pm2->ix, sl_get(a->vers, i)));
    i = i + 1;
  }
  free(picked->items);
  free(picked);
  dx_make_links(cx);
  dx_prune(cx, a->mods);
  var lock_file: string = dx_lock_path(p);
  if (local) {
    lock_file = dx_local_lock_path(p);
    changed = !s_eq(text, cx->lock->text) || !fs_is_file(lock_file);
  }
  if (changed) {
    fs_mkdirs(p_dir(lock_file));
    if (!fs_write(lock_file, text)) {
      dx_fail("cannot write " + lock_file);
    }
    cx->lock->text = text;
  }
  var ds: DepState* = dx_finish(cx, a, mans);
  fs_mkdirs(p->state_dir);
  fs_write(dx_stamp_path(p), dx_stamp_text(cx));
  free(mans->items);
  free(mans);
  free(a);
  return ds;
}

export fn deps_ensure(p: Project*) -> DepState* {
  return dx_ensure(p, sl_new(), false);
}

// ---------------------------------------------------------------------------
// Editing mbuild.mettle (through config.mettle)
// ---------------------------------------------------------------------------

fn dx_set_dep(p: Project*, name: string, version: string) {
  if (!cfg_set_dep(p, name, version)) {
    dx_fail("could not set " + name + " to " + version + " in mbuild.mettle");
  }
  p->has_manifest = true;
}

fn dx_remove_dep(p: Project*, name: string) {
  if (!cfg_remove_dep(p, name)) {
    dx_fail("could not remove " + name + " from mbuild.mettle");
  }
}

fn dx_need_mbfile(p: Project*) {
  if (!fs_is_file(dx_mbfile_path(p))) {
    dx_fail_hint("no mbuild.mettle in " + p->root, "run `mbuild init` first");
  }
}

fn dx_refuse_locked(p: Project*, what: string) {
  if (p->opts->locked) {
    dx_fail_hint(what + " would change mbuild.mettle, and --locked forbids it", "run it without --locked");
  }
}

// The concrete version `want` names for a package, as written into
// mbuild.mettle (the index is refreshed first).
fn dx_pick_for_get(cx: DxCx*, m: DxMod*, want: string) -> string {
  dx_index(cx, m, true);
  if (s_eq(want, "latest")) {
    return dx_pick_latest(cx, m, "");
  }
  if (!sv_is(want)) {
    dx_fail(m->module + "@" + want + ": registry packages have versions only (v1.2.0, v1, latest)");
  }
  return dx_pick_version(cx, m, want, "the command line");
}

// "note: vendor/ is out of date; run mbuild vendor" after an edit.
fn dx_vendor_note(p: Project*) {
  var r: FsRead = fs_read(dx_vendor_dir(p) + "/modules.txt");
  if (!r.ok) {
    return;
  }
  var lock: DxLock* = dx_lock_read(p);
  if (!s_starts(r.data, "# lock " + hash_string(lock->text) + "\n")) {
    note("vendor/ is out of date; run mbuild vendor");
  }
  free(lock);
}

// ---------------------------------------------------------------------------
// Commands
// ---------------------------------------------------------------------------

// A package name an import names that the manifest does not declare and
// that is not local or a component: an import of it must be added.
fn dx_needs_adding(cx: DxCx*, m: Manifest*, name: string) -> bool {
  if (!man_is_package_name(name) || s_eq(name, "std") || s_eq(name, "mbuild")) {
    return false;
  }
  return man_dep_find(m, name) == (DepSpec*)0 && !dx_is_local_module(cx, name) && man_comp_find(cx->p->man, name) == (CompSpec*)0;
}

// The local path package an import names that the manifest does not declare
// (it reaches the project through another package): 0 when none.
fn dx_undeclared_path(cx: DxCx*, m: Manifest*, name: string) -> DxPath* {
  if (!man_is_package_name(name) || man_dep_find(m, name) != (DepSpec*)0 || man_comp_find(cx->p->man, name) != (CompSpec*)0) {
    return (DxPath*)0;
  }
  if ((cx->p->has_manifest && s_eq(cx->p->man->name, name)) || dx_rpath_find(cx, name) != (DxRPath*)0) {
    return (DxPath*)0;
  }
  var i: int64 = 0;
  while (i < cx->paths->len) {
    var pp: DxPath* = dx_path_at(cx, i);
    if (s_eq(pp->key, name)) {
      return pp;
    }
    i = i + 1;
  }
  return (DxPath*)0;
}

// Declares an imported package: at the version mbuild.lock already selects
// (a direct import of a transitive package never moves it), else at the
// newest stable version. False when no registry has it.
fn dx_add_import(cx: DxCx*, name: string) -> bool {
  var p: Project* = cx->p;
  var label: string = "";
  var reg: string = "";
  var li: int64 = sl_index(cx->lock->mods, name);
  if (li >= 0) {
    label = sl_get(cx->lock->vers, li);
    reg = sl_get(cx->lock->regs, li);
  } else {
    var ix: RegIndex* = reg_find(p, name, "", !p->opts->offline);
    if (!ix->ok) {
      dx_fail(dx_ix_err(ix));
    }
    if (!ix->found) {
      note("no registry has a package named " + name + " (searched " + dx_reg_names(p) + ")");
      return false;
    }
    var m: DxMod* = dx_mod_get(cx, name);
    m->ix = ix;
    drq_push(m->reqs, dx_req_new(name, "latest", "an import in this project", true));
    label = dx_pick_latest(cx, m, "");
    reg = ix->registry;
  }
  dx_announce("Adding", name, label + " (registry " + reg + ")", label);
  dx_set_dep(p, name, label);
  return true;
}

export fn deps_add_missing(p: Project*, modules: StrList*) -> bool {
  var cx: DxCx* = dx_cx_new(p);
  defer free(cx);
  dx_collect_paths(cx);
  if (g_dx_looked == (StrList*)0) {
    g_dx_looked = sl_new();
  }
  var added: bool = false;
  var i: int64 = 0;
  while (i < modules->len) {
    var name: string = sl_get(modules, i);
    i = i + 1;
    if (!dx_needs_adding(cx, p->man, name) || sl_has(g_dx_looked, name)) {
      continue;
    }
    sl_push(g_dx_looked, name);
    if (p->opts->locked) {
      dx_fail_hint(name + " is imported but not required in mbuild.mettle, and --locked forbids adding it", "run `mbuild get " + name + "` (or build once without --locked) and commit mbuild.mettle and mbuild.lock");
    }
    if (dx_add_import(cx, name)) {
      added = true;
    }
  }
  return added;
}

export fn deps_cmd_get(p: Project*) -> int32 {
  var args: StrList* = p->opts->rest;
  if (args->len == 0) {
    error_msg("usage: mbuild get NAME[@VERSION]...  (VERSION: latest, v1.2.3, v1.2 or v1)");
    return 2;
  }
  dx_refuse_locked(p, "mbuild get");
  dx_need_mbfile(p);
  g_dx_no_vendor = true;
  var cx: DxCx* = dx_cx_new(p);
  defer free(cx);
  dx_collect_paths(cx);
  var names: StrList* = sl_new();
  var labels: StrList* = sl_new();
  var i: int64 = 0;
  while (i < args->len) {
    var arg: string = s_trim(sl_get(args, i));
    i = i + 1;
    var name: string = arg;
    var want: string = "latest";
    var at: int64 = s_rfind_byte(arg, 64);
    if (at >= 0) {
      name = s_sub(arg, 0, at);
      if (at + 1 < slen(arg)) {
        want = s_from(arg, at + 1);
      }
    }
    var d: DepSpec* = man_dep_find(p->man, name);
    if (d != (DepSpec*)0 && slen(d->path) > 0) {
      error_msg("'" + name + "' is a path dependency; edit its mb_dep_path in mbuild.mettle instead");
      return 1;
    }
    if (d == (DepSpec*)0 && !man_is_package_name(name)) {
      error_msg("'" + name + "' is not a package name (a lower-case letter, then lower-case letters, digits and '_')");
      return 1;
    }
    if (dx_rpath_find(cx, name) != (DxRPath*)0) {
      error_msg(name + " is replaced by a local path; remove the replacement to choose a version");
      return 1;
    }
    if (dx_is_local_module(cx, name)) {
      error_msg(name + " is this project or one of its path packages");
      return 1;
    }
    var m: DxMod* = dx_mod_get(cx, name);
    drq_push(m->reqs, dx_req_new(name, want, "the command line", true));
    sl_push(names, name);
    sl_push(labels, dx_pick_for_get(cx, m, want));
  }
  dx_arm(p);
  i = 0;
  while (i < names->len) {
    var n: string = sl_get(names, i);
    var label: string = sl_get(labels, i);
    i = i + 1;
    var od: DepSpec* = man_dep_find(p->man, n);
    if (od == (DepSpec*)0) {
      dx_announce("Adding", n, label, label);
      dx_set_dep(p, n, label);
    } else if (!s_eq(od->version, label)) {
      dx_announce("Updating", n, od->version + " -> " + label, label);
      dx_set_dep(p, n, label);
    }
  }
  dx_ensure(p, names, false);
  dx_disarm();
  dx_vendor_note(p);
  free(names);
  free(labels);
  return 0;
}

export fn deps_cmd_remove(p: Project*) -> int32 {
  var args: StrList* = p->opts->rest;
  if (args->len == 0) {
    error_msg("usage: mbuild remove NAME...");
    return 2;
  }
  dx_refuse_locked(p, "mbuild remove");
  dx_need_mbfile(p);
  g_dx_no_vendor = true;
  var i: int64 = 0;
  while (i < args->len) {
    var name: string = sl_get(args, i);
    i = i + 1;
    if (man_dep_find(p->man, name) == (DepSpec*)0) {
      error_msg(name + " is not a dependency in mbuild.mettle");
      return 1;
    }
    dx_announce("Removing", name, "from mbuild.mettle", "-");
    dx_arm(p);
    dx_remove_dep(p, name);
  }
  dx_ensure(p, sl_new(), false);
  dx_disarm();
  dx_vendor_note(p);
  return 0;
}

export fn deps_cmd_update(p: Project*) -> int32 {
  var req: UpdateReq* = new UpdateReq;
  req->modules = sl_new();
  req->all = false;
  req->major = false;
  var ai: int64 = 0;
  while (ai < p->opts->rest->len) {
    var arg: string = sl_get(p->opts->rest, ai);
    ai = ai + 1;
    if (s_eq(arg, "--all")) {
      req->all = true;
    } else if (s_eq(arg, "--major")) {
      req->major = true;
    } else {
      sl_push(req->modules, arg);
    }
  }
  if (req->all && req->modules->len > 0) {
    error_msg("mbuild update --all takes no package names");
    free(req);
    return 2;
  }
  dx_refuse_locked(p, "mbuild update");
  g_dx_no_vendor = true;
  var plan: UpdatePlan* = deps_plan_update(p, req);
  var before: FsRead = fs_read(dx_lock_path(p));
  if (plan->mods->len > 0) {
    dx_apply(p, plan->mods, plan->tos, false);
  }
  var k: int64 = 0;
  while (k < plan->lines_mods->len) {
    var v: string = sl_get(plan->lines_vers, k);
    status("Newer", sl_get(plan->lines_mods, k) + " " + v + " is a new compatibility line (" + sv_line(v) + "): `mbuild update --major " + sl_get(plan->lines_mods, k) + "`");
    k = k + 1;
  }
  var after: FsRead = fs_read(dx_lock_path(p));
  var same: bool = (before.ok == after.ok) && (!after.ok || s_eq(after.data, before.data));
  if (plan->mods->len == 0 && plan->lines_mods->len == 0 && same) {
    status("Checked", "dependencies are up to date");
  }
  dx_vendor_note(p);
  free(plan);
  free(req);
  return 0;
}

// used_modules: the package names imported directly by the root package's
// own files. Requirements (path packages included) nothing there imports
// are removed; imported packages the root does not declare are added, at
// the version already selected when the package is in the graph.
export fn deps_cmd_tidy(p: Project*, used_modules: StrList*) -> int32 {
  dx_refuse_locked(p, "mbuild tidy");
  dx_need_mbfile(p);
  cfg_move_deps(p);
  g_dx_no_vendor = true;
  dx_arm(p);
  var adopted: StrList* = dx_adopt(p, true);
  var drop: StrList* = sl_new();
  var i: int64 = 0;
  while (i < p->man->ndeps) {
    var d: DepSpec* = man_dep(p->man, i);
    i = i + 1;
    if (!sl_has(used_modules, d->key) && !sl_has(adopted, d->key)) {
      sl_push(drop, d->key);
    }
  }
  i = 0;
  while (i < drop->len) {
    var key: string = sl_get(drop, i);
    i = i + 1;
    dx_announce("Removing", key, "(not imported)", "-");
    dx_remove_dep(p, key);
  }
  var cx: DxCx* = dx_cx_new(p);
  defer free(cx);
  dx_collect_paths(cx);
  var done: StrList* = sl_new();
  var paths: StrList* = sl_new();
  i = 0;
  while (i < used_modules->len) {
    var name: string = sl_get(used_modules, i);
    i = i + 1;
    if (sl_has(done, name)) {
      continue;
    }
    var up: DxPath* = dx_undeclared_path(cx, p->man, name);
    if (up != (DxPath*)0) {
      sl_push(done, name);
      var rel: string = dx_rel(p->root, up->dir);
      if (s_starts(rel, "./")) {
        rel = s_from(rel, 2);
      }
      dx_announce("Adding", name, "(path " + rel + ")", "path " + name);
      sl_push(paths, name + "\n" + rel);
      continue;
    }
    if (!dx_needs_adding(cx, p->man, name)) {
      continue;
    }
    sl_push(done, name);
    dx_add_import(cx, name);
  }
  if (paths->len > 0) {
    dx_add_path_deps(p, paths);
  }
  free(paths);
  dx_ensure(p, sl_new(), false);
  dx_disarm();
  dx_vendor_note(p);
  free(drop);
  free(done);
  return 0;
}

// The libraries of one section family ("c" or "link": the section and its
// .linux / .windows variants), `key` lists merged. linked: a section exists.
fn dx_section_libs(m: Manifest*, family: string, key: string, libs: StrList*) -> bool {
  var secs: StrList* = sl_of(family);
  sl_push(secs, family + ".linux");
  sl_push(secs, family + ".windows");
  var linked: bool = false;
  var i: int64 = 0;
  while (i < secs->len) {
    if (toml_has_section(m->doc, sl_get(secs, i))) {
      linked = true;
    }
    sl_extend_uniq(libs, toml_list(m->doc, sl_get(secs, i), key));
    i = i + 1;
  }
  free(secs);
  return linked;
}

// " [native: C; c libs: m; link libs: raylib; pkgconfig: gtk+-3.0]", or "".
fn dx_native_note(m: Manifest*) -> string {
  if (m == (Manifest*)0) {
    return "";
  }
  var parts: StrList* = sl_new();
  if (man_has_c(m)) {
    sl_push(parts, "C");
    var clibs: StrList* = sl_new();
    dx_section_libs(m, "c", "libs", clibs);
    if (clibs->len > 0) {
      sl_push(parts, "c libs: " + sl_join(clibs, ", "));
    }
    free(clibs);
  }
  var libs: StrList* = sl_new();
  var linked: bool = dx_section_libs(m, "link", "libs", libs);
  var pkgs: StrList* = sl_new();
  dx_section_libs(m, "link", "pkgconfig", pkgs);
  if (libs->len > 0) {
    sl_push(parts, "link libs: " + sl_join(libs, ", "));
  }
  if (pkgs->len > 0) {
    sl_push(parts, "pkgconfig: " + sl_join(pkgs, ", "));
  }
  if (linked && libs->len == 0 && pkgs->len == 0) {
    sl_push(parts, "links");
  }
  free(libs);
  free(pkgs);
  var note_text: string = "";
  if (parts->len > 0) {
    note_text = " " + yellow("[native: " + sl_join(parts, "; ") + "]");
  }
  free(parts);
  return note_text;
}

fn dx_ds_find(ds: DepState*, d: DepSpec*) -> int64 {
  var i: int64 = 0;
  while (i < ds->n) {
    var dm: DepModule* = &ds->mods[i];
    if (s_eq(dm->module, d->key) && dm->is_path == (slen(d->path) > 0)) {
      return i;
    }
    i = i + 1;
  }
  return -1;
}

fn dx_describe(p: Project*, dm: DepModule*) -> string {
  if (dm->is_path) {
    return dm->module + " " + dim("(path " + dx_rel(p->root, dm->dir) + ")");
  }
  var rs: ReplaceSpec* = man_replace_find(p->man, dm->module);
  if (rs != (ReplaceSpec*)0 && slen(dm->replaced) > 0) {
    var tail: string = " (replaced)";
    if (rs->local) {
      tail = " (replaced) (local)";
    }
    if (slen(rs->path) > 0) {
      return dm->module + " => " + rs->path + dim(tail);
    }
    return dm->module + " => " + dm->version + dim(tail);
  }
  return dm->module + " " + dm->version + " " + dim("(" + dm->registry + ")");
}

struct DxTree {
  p: Project*;
  ds: DepState*;
  seen: StrList*;
}

fn dx_tree(t: DxTree*, m: Manifest*, prefix: string) {
  var i: int64 = 0;
  while (i < m->ndeps) {
    var d: DepSpec* = man_dep(m, i);
    var last: bool = i == m->ndeps - 1;
    i = i + 1;
    var branch: string = "|-- ";
    var cont: string = "|   ";
    if (last) {
      branch = "`-- ";
      cont = "    ";
    }
    var at: int64 = dx_ds_find(t->ds, d);
    if (at < 0) {
      say(prefix + branch + d->key + " " + d->version + " " + dim("(not selected)"));
      continue;
    }
    var dm: DepModule* = &t->ds->mods[at];
    var line: string = dx_describe(t->p, dm);
    if (slen(d->path) == 0 && !s_eq(d->version, dm->version) && !s_eq(d->version, "latest")) {
      line = line + " " + dim("(requires " + d->version + ")");
    }
    line = line + dx_native_note(dm->man);
    var id: string = dm->module + "@" + dm->version;
    var expand: bool = dm->man != (Manifest*)0 && dm->man->ndeps > 0;
    if (expand && sl_has(t->seen, id)) {
      line = line + " " + dim("(*)");
      expand = false;
    }
    say(prefix + branch + line);
    if (expand) {
      sl_push(t->seen, id);
      dx_tree(t, dm->man, prefix + cont);
    }
  }
}

export fn deps_cmd_list(p: Project*) -> int32 {
  var ds: DepState* = deps_ensure(p);
  if (sl_has(p->opts->rest, "--tree")) {
    var t: DxTree* = new DxTree;
    defer free(t);
    t->p = p;
    t->ds = ds;
    t->seen = sl_new();
    var title: string = bold(p->man->name);
    if (slen(p->man->version) > 0) {
      title = title + " " + p->man->version;
    }
    say(title + dx_native_note(p->man));
    dx_tree(t, p->man, "");
    return 0;
  }
  if (ds->n == 0) {
    say("no dependencies");
    return 0;
  }
  var i: int64 = 0;
  while (i < ds->n) {
    var dm: DepModule* = &ds->mods[i];
    var bins: StrList* = man_dep_bins(p->man, dm->module);
    var bins_note: string = "";
    if (bins->len > 0) {
      bins_note = " [bins built here: " + sl_join(bins, ", ") + "]";
    }
    free(bins);
    say(dx_describe(p, dm) + dx_native_note(dm->man) + bins_note);
    i = i + 1;
  }
  var need: StrList* = deps_mettle_minimum(ds);
  if (need->len >= 2) {
    var who: string = sl_get(need, 1);
    var sp: int64 = s_find_byte(who, 32);
    if (sp > 0) {
      who = s_sub(who, 0, sp);
    }
    say("Mettle >= " + sl_get(need, 0) + " (" + who + ")");
  }
  free(need);
  return 0;
}

// Indexes, manifests and archives for everything in the lock, so --offline
// builds work afterwards.
export fn deps_cmd_fetch(p: Project*) -> int32 {
  var refresh_was: bool = g_dx_refresh;
  g_dx_refresh = !p->opts->offline;
  var ds: DepState* = dx_ensure(p, sl_new(), true);
  g_dx_refresh = refresh_was;
  var n: int64 = 0;
  var i: int64 = 0;
  while (i < ds->n) {
    var dm: DepModule* = &ds->mods[i];
    i = i + 1;
    if (dm->is_path || slen(dm->registry) == 0) {
      continue;
    }
    var ix: RegIndex* = reg_index(p, dm->registry, dm->module, false);
    g_dx_last_ix = ix;
    if (!ix->ok || !ix->found || slen(reg_fetch(p, ix, dm->version)) == 0) {
      fail(reg_error());
    }
    n = n + 1;
  }
  status("Fetched", "{n} package(s); builds can now run with --offline");
  return 0;
}

// ---------------------------------------------------------------------------
// Interface types
// ---------------------------------------------------------------------------

export struct DepSnap {
  files: StrList*;
  texts: StrList*;
  present: StrList*;
}

export struct UpdateReq {
  modules: StrList*;
  all: bool;
  major: bool;
}

export struct UpdatePlan {
  mods: StrList*;
  froms: StrList*;
  tos: StrList*;
  kinds: StrList*;
  cands: StrList*;
  lines_mods: StrList*;
  lines_vers: StrList*;
}

export struct ApiQuery {
  module: string;
  from_version: string;
  to_version: string;
  files: StrList*;      // the files whose uses are listed (0 or empty: the project's files importing the package)
  with_added: bool;     // also list `added` entries (default: only what breaks callers)
}

// ---------------------------------------------------------------------------
// The resolved graph without extracting (why, outdated)
// ---------------------------------------------------------------------------

fn dx_graph(p: Project*) -> DxCx* {
  var cx: DxCx* = dx_cx_new(p);
  dx_collect_paths(cx);
  cx->reqs_hash = dx_compute_reqs_hash(cx);
  dx_walk(cx);
  dx_sort_mods(cx);
  return cx;
}

// The package a command-line name means: a dependency or a package in the
// lock; "" when it is neither.
fn dx_name_module(cx: DxCx*, name: string) -> string {
  if (man_dep_find(cx->p->man, name) != (DepSpec*)0 || sl_has(cx->lock->mods, name) || dx_mod_find(cx, name) != (DxMod*)0) {
    return name;
  }
  return s_empty();
}

// "<label>file:line" for each import of `name/...` in the .mettle files
// under dir; with abs, the absolute paths of the importing files instead.
fn dx_import_hits(dir: string, name: string, label: string, hits: StrList*, abs: bool) {
  var skip: StrList* = sl_of("build");
  sl_push(skip, "vendor");
  var files: StrList* = fs_walk(dir, ".mettle", skip);
  var prefix: string = name + "/";
  var i: int64 = 0;
  while (i < files->len) {
    var rel: string = sl_get(files, i);
    i = i + 1;
    var r: FsRead = fs_read(dir + "/" + rel);
    if (!r.ok) {
      continue;
    }
    var sr: ScanResult* = scan_source(r.data);
    var k: int64 = 0;
    while (k < sr->nimports) {
      var ip: string = scan_import(sr, k)->path;
      var ln: int64 = scan_import(sr, k)->line;
      k = k + 1;
      if (s_starts(ip, prefix)) {
        if (abs) {
          sl_add_uniq(hits, dir + "/" + rel);
        } else {
          sl_add_uniq(hits, label + rel + ":" + s_int(ln));
        }
      }
    }
    free(sr);
  }
  free(skip);
  free(files);
}

// The project's own files (root and path packages) that import name.
fn dx_files_importing(p: Project*, cx: DxCx*, name: string) -> StrList* {
  var hits: StrList* = sl_new();
  dx_import_hits(p->root, name, "", hits, true);
  var i: int64 = 0;
  while (i < cx->paths->len) {
    var pp: DxPath* = dx_path_at(cx, i);
    if (!p_has_prefix_dir(pp->dir, p->root)) {
      dx_import_hits(pp->dir, name, "", hits, true);
    }
    i = i + 1;
  }
  return hits;
}

// ---------------------------------------------------------------------------
// mbuild why NAME (12.4)
// ---------------------------------------------------------------------------

export fn deps_cmd_why(p: Project*) -> int32 {
  if (p->opts->rest->len != 1) {
    error_msg("usage: mbuild why NAME  (with two arguments, `mbuild why A B` asks the compiler)");
    return 2;
  }
  var name: string = sl_get(p->opts->rest, 0);
  var ds: DepState* = deps_ensure(p);
  var cx: DxCx* = dx_graph(p);
  defer free(cx);
  var pathdep: DepSpec* = man_dep_find(p->man, name);
  if (pathdep != (DepSpec*)0 && slen(pathdep->path) > 0) {
    say(pathdep->key + " (path " + pathdep->path + ", required by mbuild.mettle)");
    return 0;
  }
  var rp: DxRPath* = dx_rpath_find(cx, name);
  var module: string = dx_name_module(cx, name);
  if (slen(module) == 0 && rp == (DxRPath*)0) {
    error_msg("'" + name + "' is not a dependency of this project (with two arguments, `mbuild why A B` asks the compiler)");
    return 1;
  }
  module = name;
  var m: DxMod* = dx_mod_find(cx, module);
  if ((m == (DxMod*)0 || m->sel < 0) && rp == (DxRPath*)0) {
    error_msg(module + " is not in the build");
    return 1;
  }
  var reqs: DxReqs* = (DxReqs*)0;
  var head: string = "";
  var reason: string = "";
  var rs: ReplaceSpec* = man_replace_find(p->man, module);
  if (rp != (DxRPath*)0) {
    head = module + " => " + rp->rel;
    reqs = rp->reqs;
  } else {
    head = module + " " + sl_get(m->labels, m->sel);
    reqs = dx_live_reqs(cx, m);
  }
  var rows: StrList* = sl_new();
  var i: int64 = 0;
  var rootpin: bool = false;
  while (i < reqs->len) {
    var r: DxReq* = dx_req_at(reqs, i);
    sl_add_uniq(rows, dx_chain(cx, r->from) + " requires " + r->spec);
    if (r->root && s_eq(r->spec, "latest")) {
      rootpin = true;
    }
    i = i + 1;
  }
  if (rs != (ReplaceSpec*)0 && (rp != (DxRPath*)0 || (m != (DxMod*)0 && m->rep_req != (DxReq*)0))) {
    reason = "replaced in mbuild.mettle";
    if (rs->local) {
      reason = "replaced in mbuild.local.mettle";
    }
  } else if (rootpin) {
    reason = "pinned by mbuild.mettle";
  } else if (rows->len == 1) {
    reason = "the only requirement";
  } else {
    reason = "the highest of the versions required";
  }
  say(head + " (selected: " + reason + ")");
  say("  required by:");
  i = 0;
  while (i < rows->len) {
    say("    " + sl_get(rows, i));
    i = i + 1;
  }
  var hits: StrList* = sl_new();
  dx_import_hits(p->root, module, "", hits, false);
  i = 0;
  while (i < cx->paths->len) {
    var pp: DxPath* = dx_path_at(cx, i);
    if (!p_has_prefix_dir(pp->dir, p->root)) {
      dx_import_hits(pp->dir, module, "path package " + pp->key + ": ", hits, false);
    }
    i = i + 1;
  }
  i = 0;
  while (i < ds->n) {
    var dm: DepModule* = &ds->mods[i];
    i = i + 1;
    if (dm->is_path || s_eq(dm->module, module)) {
      continue;
    }
    var label: string = dm->module + " " + dm->version + ": ";
    if (s_eq(dm->replaced, "path")) {
      label = dm->module + " (replaced): ";
    }
    dx_import_hits(dm->dir, module, label, hits, false);
  }
  say("  imported by:");
  if (hits->len == 0) {
    say("    (not imported by any file: `mbuild tidy` would drop the requirement)");
  }
  i = 0;
  while (i < hits->len) {
    say("    " + sl_get(hits, i));
    i = i + 1;
  }
  free(hits);
  free(rows);
  return 0;
}

// ---------------------------------------------------------------------------
// mbuild outdated [-v] [NAME] (12.9)
// ---------------------------------------------------------------------------

fn dx_outdated_row(cx: DxCx*, m: DxMod*, cells: StrList*, newer: StrList*) {
  var label: string = sl_get(m->labels, m->sel);
  var vs: StrList* = dx_versions(dx_index(cx, m, !cx->p->opts->offline), false);
  var compat: string = "-";
  var latest: string = "-";
  var c: string = dx_newest_in_line(vs, label);
  if (slen(c) > 0) {
    compat = c;
  }
  var st: string = dx_newest_stable(vs);
  var top: string = sv_max(vs);
  if (vs->len > 0) {
    top = sl_get(vs, vs->len - 1);
  }
  if (slen(st) > 0 && sv_cmp(st, label) > 0 && !s_eq(sv_line(st), sv_line(label))) {
    latest = st + " (new line)";
  } else if (slen(top) > 0 && slen(sv_parse(top).pre) > 0 && sv_cmp(top, label) > 0 && (slen(st) == 0 || sv_cmp(top, st) > 0) && !s_eq(top, compat)) {
    latest = top + " (pre)";
  }
  var i: int64 = vs->len - 1;
  while (i >= 0) {
    if (sv_cmp(sl_get(vs, i), label) > 0) {
      sl_push(newer, sl_get(vs, i));
    }
    i = i - 1;
  }
  free(vs);
  var by: string = "";
  var live: DxReqs* = dx_live_reqs(cx, m);
  var i2: int64 = 0;
  while (i2 < live->len) {
    var r: DxReq* = dx_req_at(live, i2);
    if (r->root) {
      by = "mbuild.mettle";
    } else if (slen(by) == 0) {
      by = r->from;
    }
    i2 = i2 + 1;
  }
  free(live);
  if (slen(by) == 0) {
    by = "-";
  }
  sl_push(cells, m->module);
  sl_push(cells, label);
  sl_push(cells, compat);
  sl_push(cells, latest);
  sl_push(cells, by);
}

fn dx_meta(m: Manifest*, key: string) -> string {
  var i: int64 = 0;
  while (i < m->meta->len) {
    var kv: string = sl_get(m->meta, i);
    if (s_starts(kv, key + "=")) {
      return s_from(kv, slen(key) + 1);
    }
    i = i + 1;
  }
  return s_empty();
}

export fn deps_cmd_outdated(p: Project*) -> int32 {
  var only: string = "";
  if (p->opts->rest->len > 0) {
    only = sl_get(p->opts->rest, 0);
  }
  deps_ensure(p);
  var cx: DxCx* = dx_graph(p);
  defer free(cx);
  if (slen(only) > 0 && dx_mod_find(cx, only) == (DxMod*)0) {
    error_msg(only + " is not in the build");
    return 1;
  }
  var cells: StrList* = sl_of("NAME");
  sl_push(cells, "CURRENT");
  sl_push(cells, "COMPATIBLE");
  sl_push(cells, "LATEST");
  sl_push(cells, "REQUIRED BY");
  var extra: StrList* = sl_of("");
  var i: int64 = 0;
  while (i < cx->mods->len) {
    var m: DxMod* = dx_mod_at(cx, i);
    i = i + 1;
    if (m->sel < 0 || (slen(only) > 0 && !s_eq(m->module, only))) {
      continue;
    }
    var newer: StrList* = sl_new();
    dx_outdated_row(cx, m, cells, newer);
    var b: Buf* = buf_new();
    if (p->opts->verbose) {
      var k: int64 = 0;
      while (k < newer->len && k < 5) {
        var nm: Manifest* = reg_manifest(p, m->ix, sl_get(newer, k));
        var desc: string = "";
        if (nm != (Manifest*)0) {
          desc = dx_meta(nm, "description");
        }
        buf_line(b, "    " + sl_get(newer, k) + " " + desc);
        k = k + 1;
      }
    }
    if (slen(only) > 0) {
      var n: int64 = cells->len;
      var to: string = sl_get(cells, n - 2);
      if (s_eq(to, "-")) {
        to = sl_get(cells, n - 3);
      }
      var sp: int64 = s_find_byte(to, 32);
      if (sp > 0) {
        to = s_sub(to, 0, sp);
      }
      var from: string = sl_get(m->labels, m->sel);
      if (!s_eq(to, "-") && sv_is(from) && sv_is(to)) {
        var q: ApiQuery* = new ApiQuery;
        q->module = m->module;
        q->from_version = from;
        q->to_version = to;
        q->files = (StrList*)0;
        q->with_added = true;
        var rep: string = deps_api_report(p, q);
        free(q);
        if (slen(rep) > 0) {
          buf_line(b, rep);
        }
      }
    }
    sl_push(extra, buf_take(b));
    free(newer);
  }
  var widths: int64* = (int64*)malloc(5 * 8);
  var c: int64 = 0;
  while (c < 5) {
    widths[c] = 0;
    c = c + 1;
  }
  i = 0;
  while (i < cells->len) {
    if (slen(sl_get(cells, i)) > widths[i % 5]) {
      widths[i % 5] = slen(sl_get(cells, i));
    }
    i = i + 1;
  }
  var row: int64 = 0;
  while (row * 5 < cells->len) {
    var b2: Buf* = buf_new();
    c = 0;
    while (c < 5) {
      var cell: string = sl_get(cells, row * 5 + c);
      if (c < 4) {
        buf_add(b2, s_pad_right(cell, widths[c] + 2));
      } else {
        buf_add(b2, cell);
      }
      c = c + 1;
    }
    say(s_trim(buf_take(b2)));
    var ex: string = sl_get(extra, row);
    if (slen(ex) > 0) {
      print(ex);
    }
    row = row + 1;
  }
  free(widths);
  free(cells);
  free(extra);
  if (p->opts->offline) {
    say("(--offline: indexes not refreshed)");
  }
  return 0;
}

// ---------------------------------------------------------------------------
// mbuild vendor [--remove] (14.5)
// ---------------------------------------------------------------------------

fn dx_toml_scalar(kind: string, text: string) -> string {
  if (s_eq(kind, "1")) {
    return toml_quote(text);
  }
  return text;
}

fn dx_toml_value(v: TomlValue*) -> string {
  if (v->kind == 1) {
    return toml_quote(v->text);
  }
  var parts: StrList* = sl_new();
  var i: int64 = 0;
  var out_s: string = v->text;
  if (v->kind == 4) {
    while (i < v->items->len) {
      sl_push(parts, dx_toml_scalar(sl_get(v->item_kinds, i), sl_get(v->items, i)));
      i = i + 1;
    }
    out_s = "[" + sl_join(parts, ", ") + "]";
  } else if (v->kind == 5) {
    while (i < v->fields->len) {
      sl_push(parts, toml_key_literal(sl_get(v->fields, i)) + " = " + dx_toml_scalar(sl_get(v->field_kinds, i), sl_get(v->field_values, i)));
      i = i + 1;
    }
    out_s = "{{ " + sl_join(parts, ", ") + " }";
  }
  free(parts);
  return out_s;
}

fn dx_toml_section(b: Buf*, doc: Toml*, sec: string) {
  if (slen(sec) > 0) {
    buf_line(b, "[" + toml_section_literal(sec) + "]");
  }
  var i: int64 = 0;
  while (i < doc->n) {
    var e: TomlEntry* = doc->entries[i];
    if (s_eq(e->section, sec)) {
      buf_line(b, toml_key_literal(e->key) + " = " + dx_toml_value(e->value));
    }
    i = i + 1;
  }
}

// TOML text for a parsed document: vendor/<name>.toml keeps a registry
// manifest beside its package.
fn dx_toml_text(doc: Toml*) -> string {
  var b: Buf* = buf_new();
  dx_toml_section(b, doc, "");
  var s: int64 = 0;
  while (s < doc->sections->len) {
    dx_toml_section(b, doc, sl_get(doc->sections, s));
    s = s + 1;
  }
  return buf_take(b);
}

fn dx_copy_tree(from: string, to: string) -> bool {
  var files: StrList* = fs_walk(from, "", (StrList*)0);
  var ok: bool = true;
  var i: int64 = 0;
  while (i < files->len && ok) {
    var rel: string = sl_get(files, i);
    i = i + 1;
    var dst: string = to + "/" + rel;
    fs_mkdirs(p_dir(dst));
    ok = fs_copy(from + "/" + rel, dst);
  }
  free(files);
  return ok;
}

export fn deps_cmd_vendor(p: Project*) -> int32 {
  var vdir: string = dx_vendor_dir(p);
  if (sl_has(p->opts->rest, "--remove")) {
    if (fs_exists(vdir)) {
      sys_remove_tree(vdir);
      status("Removed", "vendor/");
    }
    return 0;
  }
  g_dx_no_vendor = true;
  var ds: DepState* = deps_ensure(p);
  g_dx_no_vendor = false;
  var lock: DxLock* = dx_lock_read(p);
  if (fs_exists(vdir)) {
    sys_remove_tree(vdir);
  }
  fs_mkdirs(vdir);
  var b: Buf* = buf_new();
  buf_line(b, "# lock " + hash_string(lock->text));
  var n: int64 = 0;
  var i: int64 = 0;
  while (i < ds->n) {
    var dm: DepModule* = &ds->mods[i];
    i = i + 1;
    if (dm->is_path) {
      continue;
    }
    if (s_eq(dm->replaced, "path")) {
      warn(dm->module + " is replaced by a local path and is not vendored");
      continue;
    }
    if (!dx_copy_tree(dm->dir, vdir + "/" + dm->module) || dm->man == (Manifest*)0 || !fs_write(vdir + "/" + dm->module + ".toml", dx_toml_text(dm->man->doc))) {
      error_msg("cannot copy " + dm->module + " into " + vdir);
      return 1;
    }
    buf_line(b, dm->module + " " + dm->version + " " + dm->checksum);
    n = n + 1;
  }
  fs_write(vdir + "/modules.txt", buf_take(b));
  free(lock);
  status("Vendored", "{n} package(s) into vendor/");
  return 0;
}

// ---------------------------------------------------------------------------
// mettle.deps adoption (12.6)
// ---------------------------------------------------------------------------

// Adds an `mb_dep_path("name", "dir");` line per pair ("name\ndir") where a
// new dependency goes (13.8).
fn dx_add_path_deps(p: Project*, pairs: StrList*) {
  var file: string = dx_mbfile_path(p);
  var r: FsRead = fs_read(file);
  if (!r.ok) {
    dx_fail("cannot read " + file);
  }
  var text: string = r.data;
  var i: int64 = 0;
  while (i < pairs->len) {
    var pair: string = sl_get(pairs, i);
    i = i + 1;
    var nl: int64 = s_find_byte(pair, 10);
    var e: MbfEdit = mbf_add_dep_path(text, s_sub(pair, 0, nl), s_from(pair, nl + 1));
    if (!e.ok) {
      dx_fail(file + ":" + s_int(e.line) + ": cannot add mb_dep_path(\"" + s_sub(pair, 0, nl) + "\", ...): " + e.why);
    }
    text = e.text;
  }
  if (!fs_write(file, text)) {
    dx_fail("cannot write " + file);
  }
  var m: Manifest* = cfg_load(p);
  if (m != (Manifest*)0) {
    p->man = m;
  }
}

// Moves plain `name=dir` lines of the root mettle.deps into mbuild.mettle;
// answers the names adopted (with write false: the names it would adopt).
fn dx_adopt(p: Project*, write: bool) -> StrList* {
  var adopted: StrList* = sl_new();
  var file: string = p->root + "/mettle.deps";
  var r: FsRead = fs_read(file);
  if (!r.ok || !p->has_manifest) {
    return adopted;
  }
  var lines: StrList* = s_lines(r.data);
  var kept: StrList* = sl_new();
  var calls: StrList* = sl_new();
  var inside: bool = false;
  var i: int64 = 0;
  while (i < lines->len) {
    var l: string = sl_get(lines, i);
    var t: string = s_trim(l);
    var n: int64 = i + 1;
    i = i + 1;
    var eq: int64 = s_find_byte(t, 61);
    var keep: bool = true;
    if (inside) {
      if (s_starts(t, "# <<< mbuild")) {
        inside = false;
      }
    } else if (s_starts(t, "# >>> mbuild")) {
      inside = true;
    } else if (slen(t) > 0 && !s_starts(t, "#") && eq > 0) {
      var name: string = s_trim(s_sub(t, 0, eq));
      var dir: string = s_trim(s_from(t, eq + 1));
      var abs: string = dir;
      if (!p_is_abs(dir)) {
        abs = p_join(p->root, dir);
      }
      abs = p_clean(abs);
      var where_at: string = "mettle.deps:" + s_int(n) + ": " + t;
      if (!man_is_package_name(name)) {
        if (write) {
          warn(where_at + ": " + name + " is not a package name; it stays in mettle.deps");
        }
      } else if (man_dep_find(p->man, name) != (DepSpec*)0) {
        if (write) {
          warn(where_at + ": " + name + " is already declared in mbuild.mettle; remove the line");
        }
      } else if (!fs_is_dir(abs)) {
        if (write) {
          warn(where_at + ": " + abs + " does not exist; it stays in mettle.deps");
        }
      } else if (!p_has_prefix_dir(abs, p->state_dir)) {
        keep = false;
        sl_push(adopted, name);
        sl_push(calls, name + "\n" + dir);
        if (write) {
          status("Adopted", name + " = " + dir + " from mettle.deps");
        }
      }
    }
    if (keep) {
      sl_push(kept, l);
    }
  }
  if (write && adopted->len > 0) {
    dx_refuse_locked(p, "adopting mettle.deps lines");
    dx_add_path_deps(p, calls);
    var joined: string = sl_join(kept, "\n");
    if (s_ends(r.data, "\n")) {
      joined = joined + "\n";
    }
    fs_write(file, joined);
  }
  free(lines);
  free(kept);
  free(calls);
  return adopted;
}

export fn deps_adopt_mettle_deps(p: Project*, write: bool) -> int32 {
  var l: StrList* = dx_adopt(p, write);
  var n: int64 = l->len;
  free(l);
  return (int32)n;
}

// ---------------------------------------------------------------------------
// Snapshot, restore, update plans (12.9; build drives verification)
// ---------------------------------------------------------------------------

export fn deps_snapshot(p: Project*) -> DepSnap* {
  return dx_snap_take(p);
}

// Writes the snapshot back and extracts the old versions again (from the
// download cache). Prints nothing.
export fn deps_restore(p: Project*, s: DepSnap*) {
  var armed: DepSnap* = g_dx_guard;
  g_dx_guard = (DepSnap*)0;
  dx_snap_write(s);
  sys_remove_file(dx_stamp_path(p));
  if (fs_is_file(dx_mbfile_path(p))) {
    var m: Manifest* = cfg_load(p);
    if (m != (Manifest*)0) {
      p->man = m;
    }
  }
  var quiet: bool = g_quiet;
  g_quiet = true;
  dx_ensure(p, sl_new(), false);
  g_quiet = quiet;
  g_dx_guard = armed;
}

fn dx_plan_push(u: UpdatePlan*, module: string, from: string, to: string, kind: string, cands: string) {
  sl_push(u->mods, module);
  sl_push(u->froms, from);
  sl_push(u->tos, to);
  sl_push(u->kinds, kind);
  sl_push(u->cands, cands);
}

fn dx_kind(from: string, to: string) -> string {
  if (s_eq(sv_line(from), sv_line(to))) {
    return "compatible";
  }
  return "major";
}

export fn deps_plan_update(p: Project*, r: UpdateReq*) -> UpdatePlan* {
  var u: UpdatePlan* = new UpdatePlan;
  u->mods = sl_new();
  u->froms = sl_new();
  u->tos = sl_new();
  u->kinds = sl_new();
  u->cands = sl_new();
  u->lines_mods = sl_new();
  u->lines_vers = sl_new();
  var cx: DxCx* = dx_cx_new(p);
  dx_collect_paths(cx);
  var only: StrList* = sl_new();
  var i: int64 = 0;
  if (r->modules != (StrList*)0) {
    while (i < r->modules->len) {
      var name: string = sl_get(r->modules, i);
      if (man_dep_find(p->man, name) == (DepSpec*)0 && !sl_has(cx->lock->mods, name)) {
        dx_fail(name + " is neither a dependency in mbuild.mettle nor a package in mbuild.lock");
      }
      sl_push(only, name);
      i = i + 1;
    }
  }
  // (package, spec) of everything the plan looks at.
  var mods: StrList* = sl_new();
  var specs: StrList* = sl_new();
  i = 0;
  while (i < p->man->ndeps) {
    var dep: DepSpec* = man_dep(p->man, i);
    i = i + 1;
    if (slen(dep->path) > 0 || dx_is_local_module(cx, dep->key) || sl_has(mods, dep->key)) {
      continue;
    }
    if (only->len > 0 && !sl_has(only, dep->key)) {
      continue;
    }
    sl_push(mods, dep->key);
    sl_push(specs, dep->version);
  }
  i = 0;
  while (i < cx->lock->mods->len) {
    var lm: string = sl_get(cx->lock->mods, i);
    i = i + 1;
    if (sl_has(mods, lm) || dx_is_local_module(cx, lm)) {
      continue;
    }
    if ((only->len > 0 && sl_has(only, lm)) || (only->len == 0 && r->all)) {
      sl_push(mods, lm);
      sl_push(specs, sl_get(cx->lock->vers, i - 1));
    }
  }
  i = 0;
  while (i < mods->len) {
    var module: string = sl_get(mods, i);
    var spec: string = sl_get(specs, i);
    i = i + 1;
    var m: DxMod* = dx_mod_get(cx, module);
    drq_push(m->reqs, dx_req_new(module, spec, "mbuild.mettle", true));
    var vs: StrList* = dx_versions(dx_index(cx, m, true), false);
    var li: int64 = sl_index(cx->lock->mods, module);
    var lv: string = "";
    if (li >= 0) {
      lv = sl_get(cx->lock->vers, li);
    }
    var direct: bool = man_dep_find(p->man, module) != (DepSpec*)0;
    if (sv_is(spec) && !dx_is_partial(spec)) {
      var cur: string = spec;
      if (sv_is(lv) && sv_cmp(lv, spec) > 0) {
        cur = lv;
      }
      var target: string = "";
      if (r->major) {
        target = dx_newest_stable(vs);
        if (slen(target) > 0 && sv_cmp(target, cur) <= 0) {
          target = s_empty();
        }
      } else {
        target = dx_newest_in_line(vs, cur);
      }
      if (!direct && !r->all) {
        // A named transitive package moves only with --all.
        target = s_empty();
      }
      if (slen(target) > 0) {
        dx_plan_push(u, module, cur, target, dx_kind(cur, target), dx_candidates(vs, cur, target, r->major));
      }
      var base: string = cur;
      if (slen(target) > 0) {
        base = target;
      }
      var st: string = dx_newest_stable(vs);
      if (!r->major && slen(st) > 0 && sv_cmp(st, base) > 0 && !s_eq(sv_line(st), sv_line(base))) {
        sl_push(u->lines_mods, module);
        sl_push(u->lines_vers, st);
      }
    } else if (s_eq(spec, "latest") && sv_is(lv)) {
      var newest: string = dx_newest_stable(vs);
      if (slen(newest) > 0 && sv_cmp(newest, lv) > 0) {
        dx_plan_push(u, module, lv, newest, dx_kind(lv, newest), dx_candidates(vs, lv, newest, true));
      }
    }
    free(vs);
  }
  free(only);
  free(mods);
  free(specs);
  free(cx);
  return u;
}

// get/update: set each package's version in mbuild.mettle (adding
// transitive ones; `latest` stays and is only unpinned), unpin them,
// resolve.
fn dx_apply(p: Project*, mods: StrList*, vers: StrList*, quiet: bool) -> DepState* {
  dx_arm(p);
  g_dx_no_vendor = true;
  var lock: DxLock* = dx_lock_read(p);
  var unpin: StrList* = sl_new();
  var i: int64 = 0;
  while (i < mods->len) {
    var module: string = sl_get(mods, i);
    var ver: string = sl_get(vers, i);
    i = i + 1;
    var sp: int64 = s_find_byte(ver, 32);
    if (sp > 0) {
      ver = s_sub(ver, 0, sp);
    }
    var d: DepSpec* = man_dep_find(p->man, module);
    if (d == (DepSpec*)0) {
      var li: int64 = sl_index(lock->mods, module);
      if (sv_is(ver) && (li < 0 || !s_eq(sl_get(lock->vers, li), ver))) {
        dx_set_dep(p, module, ver);
      }
    } else if (slen(d->path) == 0 && sv_is(ver) && !s_eq(d->version, "latest") && !s_eq(d->version, ver)) {
      dx_set_dep(p, module, ver);
    }
    sl_push(unpin, module);
  }
  free(lock);
  var quiet_was: bool = g_quiet;
  if (quiet) {
    g_quiet = true;
  }
  var refresh_was: bool = g_dx_refresh;
  g_dx_refresh = true;
  var ds: DepState* = dx_ensure(p, unpin, true);
  free(unpin);
  g_dx_refresh = refresh_was;
  g_quiet = quiet_was;
  dx_disarm();
  return ds;
}

// Prints no status lines (build prints the summary); warnings still show.
// An error that stops resolution writes the files back first.
export fn deps_apply(p: Project*, mods: StrList*, vers: StrList*) -> DepState* {
  return dx_apply(p, mods, vers, true);
}

// ---------------------------------------------------------------------------
// API reports (12.9, 14.5, 14.7)
// ---------------------------------------------------------------------------

// The exported surface of one version from its archive, extracted into
// .mbuild/tmp/api/<name>@<version>; 0 when it cannot be had.
fn dx_surface_ix(p: Project*, ix: RegIndex*, version: string) -> ApiSurface* {
  var rv: RegVersion* = dx_find_version(ix, version);
  if (rv == (RegVersion*)0) {
    return (ApiSurface*)0;
  }
  var archive: string = reg_fetch(p, ix, rv->version);
  if (slen(archive) == 0) {
    verbose(reg_error());
    return (ApiSurface*)0;
  }
  var tmp: string = p->state_dir + "/tmp/api/" + ix->name + "@" + rv->version;
  if (fs_exists(tmp)) {
    sys_remove_tree(tmp);
  }
  fs_mkdirs(p_dir(tmp));
  var e: string = reg_extract(archive, rv->sha, tmp, dx_marker_line(ix->name, rv->version, dx_sha(rv), ix->registry));
  if (slen(e) > 0) {
    verbose("cannot extract " + ix->name + " " + version + " for its API: " + e);
    sys_remove_tree(tmp);
    return (ApiSurface*)0;
  }
  var surf: ApiSurface* = api_surface_dir(man_import_dir(reg_manifest(p, ix, rv->version), tmp));
  sys_remove_tree(tmp);
  return surf;
}

// The surface of module at version: .mbuild/deps/<name> when it holds that
// version, else the archive. Both start at the version's import root.
fn dx_surface(p: Project*, module: string, version: string) -> ApiSurface* {
  var cur: string = dx_deps_dir(p) + "/" + module;
  var mk: StrList* = s_fields(reg_marker(cur));
  var here: bool = !sys_is_link(cur) && mk->len >= 2 && s_eq(sl_get(mk, 0), module) && s_eq(sl_get(mk, 1), version);
  free(mk);
  var cx: DxCx* = dx_cx_new(p);
  var pin: string = dx_pinned(cx, module);
  free(cx);
  var ix: RegIndex* = reg_find(p, module, pin, false);
  g_dx_last_ix = ix;
  if (!ix->ok || !ix->found) {
    if (here) {
      return api_surface_dir(cur);
    }
    return (ApiSurface*)0;
  }
  if (here) {
    return api_surface_dir(man_import_dir(reg_manifest(p, ix, version), cur));
  }
  return dx_surface_ix(p, ix, version);
}

export fn deps_api_report(p: Project*, q: ApiQuery*) -> string {
  var old: ApiSurface* = dx_surface(p, q->module, q->from_version);
  var cur: ApiSurface* = dx_surface(p, q->module, q->to_version);
  if (old == (ApiSurface*)0 || cur == (ApiSurface*)0) {
    return s_empty();
  }
  var d: ApiDiff* = api_diff(old, cur);
  var breaking: ApiDiff* = api_breaking(d);
  if (!q->with_added) {
    d = breaking;
  }
  if (d->what->len == 0) {
    return s_empty();
  }
  var files: StrList* = q->files;
  if (files == (StrList*)0 || files->len == 0) {
    var cx: DxCx* = dx_cx_new(p);
    dx_collect_paths(cx);
    files = dx_files_importing(p, cx, q->module);
    free(cx);
  }
  var uses: StrList* = sl_new();
  var i: int64 = 0;
  while (i < files->len) {
    var f: string = sl_get(files, i);
    i = i + 1;
    var abs: string = f;
    if (!p_is_abs(f)) {
      abs = p_join(p->root, f);
    }
    var shown: string = abs;
    if (p_has_prefix_dir(abs, p->root)) {
      shown = p_rel(p->root, abs);
    }
    var r: FsRead = fs_read(abs);
    if (!r.ok) {
      continue;
    }
    var found: StrList* = scan_uses(r.data, d->names);
    var k: int64 = 0;
    while (k < found->len) {
      var u: string = sl_get(found, k);
      var sp: int64 = s_rfind_byte(u, 32);
      if (sp > 0) {
        sl_push(uses, s_sub(u, 0, sp) + " " + shown + ":" + s_from(u, sp + 1));
      }
      k = k + 1;
    }
    free(found);
  }
  var header: string = "  API changes from " + q->from_version + " to " + q->to_version;
  if (breaking->what->len > 0 && s_eq(sv_line(q->from_version), sv_line(q->to_version)) && slen(sv_line(q->to_version)) > 0) {
    header = header + " (inside line " + sv_line(q->to_version) + ", which should not break)";
  }
  var report: string = header + ":\n" + api_render(d, uses);
  free(uses);
  return report;
}

// The first version of the next line: v1.4.2 -> v2.0.0, v0.3.1 -> v0.4.0.
fn dx_next_line(version: string) -> string {
  var v: SemVer = sv_parse(version);
  if (v.major == 0) {
    return "v0." + s_int(v.minor + 1) + ".0";
  }
  return "v" + s_int(v.major + 1) + ".0.0";
}

// publish step 4 (14.7): the project's surface against the newest earlier
// version of name in version's line, from the registry directory dir (""
// = the registry order). "" when nothing breaks (or there is no earlier
// version), else the error with its help line; added exports with only a
// patch bump are a warning.
export fn deps_api_breaks(p: Project*, name: string, version: string, dir: string) -> string {
  if (!sv_is(version)) {
    return s_empty();
  }
  // A registry directory needs no network: read it even with --offline.
  var offline: bool = p->opts->offline;
  if (slen(dir) > 0) {
    p->opts->offline = false;
  }
  var rep: string = dx_api_breaks(p, name, version, dir);
  p->opts->offline = offline;
  return rep;
}

fn dx_api_breaks(p: Project*, name: string, version: string, dir: string) -> string {
  var ix: RegIndex* = (RegIndex*)0;
  if (slen(dir) > 0) {
    ix = reg_index_dir(p, dir, name, true);
  } else {
    ix = reg_find(p, name, "", !p->opts->offline);
  }
  g_dx_last_ix = ix;
  if (ix->ok && !ix->found && s_contains(ix->err, "--offline")) {
    warn("skipped the API break check: the index of " + name + " is not cached and --offline forbids fetching it");
  }
  if (!ix->ok || !ix->found) {
    return s_empty();
  }
  // Yanked versions count: people may still depend on them.
  var vs: StrList* = dx_versions(ix, true);
  var prev: string = "";
  var i: int64 = 0;
  while (i < vs->len) {
    var v: string = sl_get(vs, i);
    if (sv_cmp(v, version) < 0 && s_eq(sv_line(v), sv_line(version))) {
      prev = v;
    }
    i = i + 1;
  }
  free(vs);
  if (slen(prev) == 0) {
    return s_empty();
  }
  var old: ApiSurface* = dx_surface_ix(p, ix, prev);
  if (old == (ApiSurface*)0) {
    warn("cannot compare the API with " + name + " " + prev + " (mbuild -v says why)");
    return s_empty();
  }
  var all: ApiDiff* = api_diff(old, api_surface_dir(man_import_dir(p->man, p->root)));
  var d: ApiDiff* = api_breaking(all);
  var n: int64 = d->what->len;
  var listed: string = api_render(d, sl_new());
  free(d);
  if (n == 0) {
    var a: SemVer = sv_parse(prev);
    var b: SemVer = sv_parse(version);
    if (all->what->len > 0 && a.major == b.major && a.minor == b.minor) {
      warn(name + " " + version + " adds exports with only a patch bump over " + prev + "; consider a minor version");
    }
    free(all);
    return s_empty();
  }
  free(all);
  var shown: string = prev;
  var rv: RegVersion* = dx_find_version(ix, prev);
  if (rv != (RegVersion*)0 && rv->yanked) {
    shown = prev + ", yanked";
  }
  return name + " " + version + " breaks the API of " + shown + " (inside line " + sv_line(version) + ", which should not break):\n" + listed + "\n  help: a breaking change needs a new line: publish " + dx_next_line(version) + " (or pass --allow-breaking)";
}

// ---------------------------------------------------------------------------
// Mettle version requirements (12.7)
// ---------------------------------------------------------------------------

// The highest [package] mettle among the selected packages:
// ["v0.99.0", "needs v1.0.0"], or empty.
export fn deps_mettle_minimum(ds: DepState*) -> StrList* {
  var need: string = "";
  var who: string = "";
  var i: int64 = 0;
  while (i < ds->n) {
    var dm: DepModule* = &ds->mods[i];
    i = i + 1;
    if (dm->man == (Manifest*)0 || !sv_is(dm->man->mettle_min)) {
      continue;
    }
    if (slen(need) == 0 || sv_cmp(dm->man->mettle_min, need) > 0) {
      need = dm->man->mettle_min;
      who = dm->module;
      if (slen(dm->version) > 0) {
        who = dm->module + " " + dm->version;
      }
    }
  }
  var l: StrList* = sl_new();
  if (slen(need) > 0) {
    sl_push(l, need);
    sl_push(l, who);
  }
  return l;
}

// For who = "NAME VERSION": ", or require NAME vX, the newest version that
// supports Mettle HAVE" (the newest stable version before VERSION, at most
// 20 manifests read, whose [package] mettle is absent or <= have), or "".
export fn deps_mettle_fallback(p: Project*, who: string, have: string) -> string {
  var sp: int64 = s_find_byte(who, 32);
  if (sp < 0 || !sv_is(have)) {
    return s_empty();
  }
  var module: string = s_sub(who, 0, sp);
  var version: string = s_from(who, sp + 1);
  if (!sv_is(version)) {
    return s_empty();
  }
  var cx: DxCx* = dx_cx_new(p);
  var pin: string = dx_pinned(cx, module);
  free(cx);
  var ix: RegIndex* = reg_find(p, module, pin, false);
  g_dx_last_ix = ix;
  if (!ix->ok || !ix->found) {
    return s_empty();
  }
  var vs: StrList* = dx_versions(ix, false);
  var found: string = "";
  var looked: int64 = 0;
  var i: int64 = vs->len - 1;
  while (i >= 0 && looked < 20 && slen(found) == 0) {
    var t: string = sl_get(vs, i);
    i = i - 1;
    if (sv_cmp(t, version) >= 0 || slen(sv_parse(t).pre) > 0) {
      continue;
    }
    looked = looked + 1;
    var nm: Manifest* = reg_manifest(p, ix, t);
    if (nm == (Manifest*)0) {
      continue;
    }
    if (!sv_is(nm->mettle_min) || sv_cmp(nm->mettle_min, have) <= 0) {
      found = t;
    }
  }
  free(vs);
  if (slen(found) == 0) {
    return s_empty();
  }
  return ", or require " + module + " " + found + ", the newest version that supports Mettle " + have;
}

// The whole 12.7 check for one compiler: "" or the error text (without
// "error: "), the project's own [package] mettle included.
export fn deps_mettle_check(p: Project*, ds: DepState*, m: Mettle*) -> string {
  var l: StrList* = deps_mettle_minimum(ds);
  var need: string = "";
  var who: string = "";
  if (l->len >= 2) {
    need = sl_get(l, 0);
    who = sl_get(l, 1);
  }
  free(l);
  if (sv_is(p->man->mettle_min) && (slen(need) == 0 || sv_cmp(p->man->mettle_min, need) > 0)) {
    need = p->man->mettle_min;
    who = p->man->name;
    if (slen(who) == 0) {
      who = "this project";
    }
  }
  if (slen(need) == 0) {
    return s_empty();
  }
  var e: string = tc_require_minimum(m, need, who);
  if (slen(e) == 0) {
    return e;
  }
  return e + deps_mettle_fallback(p, who, tc_version(m));
}
