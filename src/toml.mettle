// toml: the TOML subset mbuild.toml uses, and line-level edits of TOML text.
//
// Supported: comments, [tables] (dotted and quoted parts), bare / quoted /
// dotted keys, basic and literal strings, integers, booleans, arrays of
// strings / integers / booleans (multi-line, trailing comma, comments) and
// one-level inline tables (whose values may be scalars or such arrays).
// Rejected with "file:line: message": [[array
// tables]], multi-line strings, floats and dates, duplicate keys and tables.
//
// The v0.17.0 Linux compiler cannot call an exported function in which a
// string argument would start in the 6th integer register slot (a string
// takes 2 slots, a pointer 1, a returned struct over 16 bytes 1 hidden slot),
// so the lookups take no (doc, section, key, extra-string) form: defaults go
// through toml_value_str(toml_get(...), dflt), fields through toml_field(v, f).

import "base";
import "std/mem";

// kind: 1 string, 2 integer (text holds the digits, "-" kept), 3 bool (text
// "true"/"false"), 4 array (items, with item_kinds), 5 inline table (fields,
// field_values, field_kinds and field_vals in parallel). Kinds in the *_kinds
// lists are "1", "2" or "3", and "4" for an array field of an inline table,
// whose field_values text is the array as a TOML literal; field_vals holds
// every field's parsed value (toml_field_value).
export struct TomlValue {
  kind: int32;
  text: string;
  items: StrList*;
  fields: StrList*;
  field_values: StrList*;
  line: int64;
  item_kinds: StrList*;
  field_kinds: StrList*;
  field_vals: TomlValue**;
}

// One `key = value`. Offsets are byte offsets into the parsed text:
// line_start is the start of the key's line, val_start/val_end bound the value
// (a multi-line array spans lines; end_line is the line its `]` is on).
// prefix is the dotted-key text before the last key part as written
// ("linux." for `linux.libs = ...`).
export struct TomlEntry {
  section: string;
  key: string;
  value: TomlValue*;
  line: int64;
  end_line: int64;
  line_start: int64;
  val_start: int64;
  val_end: int64;
  prefix: string;
}

// A `[table]` header line: start of its line and the offset just past it.
export struct TomlHeader {
  name: string;
  line: int64;
  start: int64;
  end: int64;
}

export struct Toml {
  file: string;
  entries: TomlEntry**;
  n: int64;
  cap: int64;
  headers: TomlHeader**;
  nheaders: int64;
  hcap: int64;
  sections: StrList*;     // every section with a header or a key, first-seen order
  error: string;          // "" on success
  error_line: int64;
}

struct TmlP {
  text: string;
  pos: int64;
  line: int64;
  line_start: int64;
  file: string;
  doc: Toml*;
}

export fn toml_kind_name(kind: int32) -> string {
  if (kind == 1) { return "a string"; }
  if (kind == 2) { return "an integer"; }
  if (kind == 3) { return "a boolean"; }
  if (kind == 4) { return "an array"; }
  if (kind == 5) { return "an inline table"; }
  return "nothing";
}

fn tml_c(p: TmlP*) -> int32 {
  if (p->pos >= slen(p->text)) {
    return -1;
  }
  return s_byte(p->text, p->pos);
}

fn tml_c_at(p: TmlP*, k: int64) -> int32 {
  if (p->pos + k >= slen(p->text)) {
    return -1;
  }
  return s_byte(p->text, p->pos + k);
}

fn tml_failed(p: TmlP*) -> bool {
  return slen(p->doc->error) > 0;
}

fn tml_err(p: TmlP*, msg: string) {
  if (tml_failed(p)) {
    return;
  }
  p->doc->error = p->file + ":" + s_int(p->line) + ": " + msg;
  p->doc->error_line = p->line;
}

fn tml_is_bare(c: int32) -> bool {
  return is_ident_b(c) || c == 45;
}

fn tml_skip_ws(p: TmlP*) {
  while (tml_c(p) == 32 || tml_c(p) == 9) {
    p->pos = p->pos + 1;
  }
}

fn tml_skip_comment(p: TmlP*) {
  if (tml_c(p) != (int32)'#') {
    return;
  }
  while (tml_c(p) != -1 && tml_c(p) != 10) {
    p->pos = p->pos + 1;
  }
}

fn tml_newline(p: TmlP*) {
  p->pos = p->pos + 1;
  p->line = p->line + 1;
  p->line_start = p->pos;
}

// At a line end (after blanks and a comment): consume it. False otherwise.
fn tml_eol(p: TmlP*) -> bool {
  tml_skip_ws(p);
  tml_skip_comment(p);
  var c: int32 = tml_c(p);
  if (c == -1) {
    return true;
  }
  if (c == 13 && tml_c_at(p, 1) == 10) {
    p->pos = p->pos + 1;
    c = 10;
  }
  if (c == 10) {
    tml_newline(p);
    return true;
  }
  return false;
}

// Blanks, comments and newlines (inside arrays).
fn tml_skip_all(p: TmlP*) {
  while (true) {
    tml_skip_ws(p);
    tml_skip_comment(p);
    var c: int32 = tml_c(p);
    if (c == 13 && tml_c_at(p, 1) == 10) {
      p->pos = p->pos + 1;
      c = 10;
    }
    if (c != 10) {
      break;
    }
    tml_newline(p);
  }
}

fn tml_add_utf8(b: Buf*, cp: int64) {
  if (cp < 128) {
    buf_addb(b, (int32)cp);
  } else if (cp < 2048) {
    buf_addb(b, (int32)(192 + (cp >> 6)));
    buf_addb(b, (int32)(128 + (cp & 63)));
  } else if (cp < 65536) {
    buf_addb(b, (int32)(224 + (cp >> 12)));
    buf_addb(b, (int32)(128 + ((cp >> 6) & 63)));
    buf_addb(b, (int32)(128 + (cp & 63)));
  } else {
    buf_addb(b, (int32)(240 + (cp >> 18)));
    buf_addb(b, (int32)(128 + ((cp >> 12) & 63)));
    buf_addb(b, (int32)(128 + ((cp >> 6) & 63)));
    buf_addb(b, (int32)(128 + (cp & 63)));
  }
}

fn tml_hex_val(c: int32) -> int64 {
  if (is_digit_b(c)) { return (int64)(c - 48); }
  if (c >= 97 && c <= 102) { return (int64)(c - 87); }
  return (int64)(c - 55);
}

// A basic string, p at the opening quote.
fn tml_basic(p: TmlP*) -> string {
  if (tml_c_at(p, 1) == 34 && tml_c_at(p, 2) == 34) {
    tml_err(p, "multi-line strings are not supported");
    return s_empty();
  }
  p->pos = p->pos + 1;
  var b: Buf* = buf_new();
  while (true) {
    var c: int32 = tml_c(p);
    if (c == -1 || c == 10 || c == 13) {
      tml_err(p, "unterminated string");
      break;
    }
    if (c == 34) {
      p->pos = p->pos + 1;
      break;
    }
    if (c == 92) {
      var e: int32 = tml_c_at(p, 1);
      p->pos = p->pos + 2;
      if (e == 34) { buf_addb(b, 34); }
      else if (e == 92) { buf_addb(b, 92); }
      else if (e == (int32)'n') { buf_addb(b, 10); }
      else if (e == (int32)'t') { buf_addb(b, 9); }
      else if (e == (int32)'r') { buf_addb(b, 13); }
      else if (e == (int32)'b') { buf_addb(b, 8); }
      else if (e == (int32)'f') { buf_addb(b, 12); }
      else if (e == (int32)'u' || e == (int32)'U') {
        var digits: int64 = 4;
        if (e == (int32)'U') { digits = 8; }
        var cp: int64 = 0;
        var k: int64 = 0;
        while (k < digits) {
          var h: int32 = tml_c(p);
          if (!is_hex_b(h)) {
            tml_err(p, "invalid unicode escape in string");
            break;
          }
          cp = cp * 16 + tml_hex_val(h);
          p->pos = p->pos + 1;
          k = k + 1;
        }
        if (tml_failed(p)) {
          break;
        }
        tml_add_utf8(b, cp);
      } else {
        tml_err(p, "invalid escape in string");
        break;
      }
      continue;
    }
    buf_addb(b, c);
    p->pos = p->pos + 1;
  }
  return buf_take(b);
}

// A literal string, p at the opening apostrophe.
fn tml_literal(p: TmlP*) -> string {
  if (tml_c_at(p, 1) == 39 && tml_c_at(p, 2) == 39) {
    tml_err(p, "multi-line strings are not supported");
    return s_empty();
  }
  p->pos = p->pos + 1;
  var start: int64 = p->pos;
  while (true) {
    var c: int32 = tml_c(p);
    if (c == -1 || c == 10 || c == 13) {
      tml_err(p, "unterminated string");
      return s_empty();
    }
    if (c == 39) {
      break;
    }
    p->pos = p->pos + 1;
  }
  var s: string = s_dup(s_sub(p->text, start, p->pos));
  p->pos = p->pos + 1;
  return s;
}

fn tml_key_part(p: TmlP*) -> string {
  var c: int32 = tml_c(p);
  if (c == 34) {
    return tml_basic(p);
  }
  if (c == 39) {
    return tml_literal(p);
  }
  var start: int64 = p->pos;
  while (tml_is_bare(tml_c(p))) {
    p->pos = p->pos + 1;
  }
  if (p->pos == start) {
    tml_err(p, "expected a key");
    return s_empty();
  }
  return s_sub(p->text, start, p->pos);
}

// Dotted key parts; *last_start receives the offset of the final part.
fn tml_key_path(p: TmlP*, parts: StrList*, last_start: int64*) {
  while (true) {
    tml_skip_ws(p);
    *last_start = p->pos;
    sl_push(parts, tml_key_part(p));
    if (tml_failed(p)) {
      return;
    }
    tml_skip_ws(p);
    if (tml_c(p) != 46) {
      return;
    }
    p->pos = p->pos + 1;
  }
}

fn tml_new_value(kind: int32, line: int64) -> TomlValue* {
  var v: TomlValue* = new TomlValue;
  v->kind = kind;
  v->text = s_empty();
  v->items = sl_new();
  v->fields = sl_new();
  v->field_values = sl_new();
  v->item_kinds = sl_new();
  v->field_kinds = sl_new();
  v->field_vals = (TomlValue**)0;
  v->line = line;
  return v;
}

fn tml_value_ends(c: int32) -> bool {
  return c == -1 || c == 32 || c == 9 || c == 10 || c == 13 || c == 44 || c == 93 || c == 125 || c == 35;
}

// A string, integer or boolean.
fn tml_scalar(p: TmlP*) -> TomlValue* {
  var c: int32 = tml_c(p);
  var v: TomlValue* = tml_new_value(1, p->line);
  if (c == 34) {
    v->text = tml_basic(p);
    return v;
  }
  if (c == 39) {
    v->text = tml_literal(p);
    return v;
  }
  var start: int64 = p->pos;
  while (tml_is_bare(tml_c(p)) || tml_c(p) == 43 || tml_c(p) == 46 || tml_c(p) == 58) {
    p->pos = p->pos + 1;
  }
  var word: string = s_sub(p->text, start, p->pos);
  if (s_eq(word, "true") || s_eq(word, "false")) {
    v->kind = 3;
    v->text = word;
    return v;
  }
  var b: Buf* = buf_new();
  var i: int64 = 0;
  var ok: bool = slen(word) > 0 && tml_value_ends(tml_c(p));
  if (ok && (s_byte(word, 0) == 45 || s_byte(word, 0) == 43)) {
    if (s_byte(word, 0) == 45) {
      buf_addb(b, 45);
    }
    i = 1;
  }
  var digits: int64 = 0;
  while (ok && i < slen(word)) {
    var d: int32 = s_byte(word, i);
    var sep_ok: bool = d == 95 && digits > 0 && i + 1 < slen(word) && is_digit_b(s_byte(word, i + 1));
    if (is_digit_b(d)) {
      buf_addb(b, d);
      digits = digits + 1;
    } else if (!sep_ok) {
      ok = false;
    }
    i = i + 1;
  }
  var num: string = buf_take(b);
  if (!ok || digits == 0 || digits > 18) {
    if (slen(word) == 0) {
      tml_err(p, "expected a value");
    } else {
      tml_err(p, "unsupported value '" + word + "' (expected a string, integer, boolean, array or inline table)");
    }
    return v;
  }
  v->kind = 2;
  v->text = num;
  return v;
}

fn tml_kind_code(kind: int32) -> string {
  return s_int((int64)kind);
}

fn tml_array(p: TmlP*) -> TomlValue* {
  var v: TomlValue* = tml_new_value(4, p->line);
  p->pos = p->pos + 1;
  while (true) {
    tml_skip_all(p);
    var c: int32 = tml_c(p);
    if (c == -1) {
      tml_err(p, "unterminated array");
      return v;
    }
    if (c == 93) {
      p->pos = p->pos + 1;
      return v;
    }
    if (c == 91 || c == 123) {
      tml_err(p, "arrays may hold only strings, integers and booleans");
      return v;
    }
    var item: TomlValue* = tml_scalar(p);
    if (tml_failed(p)) {
      return v;
    }
    sl_push(v->items, item->text);
    sl_push(v->item_kinds, tml_kind_code(item->kind));
    tml_skip_all(p);
    c = tml_c(p);
    if (c == 44) {
      p->pos = p->pos + 1;
    } else if (c == 93) {
      p->pos = p->pos + 1;
      return v;
    } else if (c == -1) {
      tml_err(p, "unterminated array");
      return v;
    } else {
      tml_err(p, "expected ',' or ']' in array");
      return v;
    }
  }
  return v;
}

fn tml_add_field_val(v: TomlValue*, item: TomlValue*) {
  var n: int64 = v->fields->len;
  var grown: TomlValue** = (TomlValue**)malloc((n + 1) * 8);
  var i: int64 = 0;
  while (i < n) {
    grown[i] = v->field_vals[i];
    i = i + 1;
  }
  grown[n] = item;
  if (n > 0) {
    free(v->field_vals);
  }
  v->field_vals = grown;
}

fn tml_inline(p: TmlP*) -> TomlValue* {
  var v: TomlValue* = tml_new_value(5, p->line);
  p->pos = p->pos + 1;
  tml_skip_ws(p);
  if (tml_c(p) == 125) {
    p->pos = p->pos + 1;
    return v;
  }
  while (true) {
    tml_skip_ws(p);
    var c: int32 = tml_c(p);
    if (c == 125 && v->fields->len > 0) {
      p->pos = p->pos + 1;
      return v;
    }
    if (c == -1 || c == 10 || c == 13) {
      tml_err(p, "inline tables must close on the same line");
      return v;
    }
    var name: string = tml_key_part(p);
    if (tml_failed(p)) {
      return v;
    }
    tml_skip_ws(p);
    if (tml_c(p) == 46) {
      tml_err(p, "dotted keys are not supported in inline tables");
      return v;
    }
    if (tml_c(p) != 61) {
      tml_err(p, "expected '=' after '" + name + "' in inline table");
      return v;
    }
    p->pos = p->pos + 1;
    tml_skip_ws(p);
    c = tml_c(p);
    if (c == 123) {
      tml_err(p, "inline table values must be strings, integers, booleans or arrays");
      return v;
    }
    var item: TomlValue* = (TomlValue*)0;
    if (c == 91) {
      item = tml_array(p);
    } else {
      item = tml_scalar(p);
    }
    if (tml_failed(p)) {
      return v;
    }
    if (sl_has(v->fields, name)) {
      tml_err(p, "duplicate key '" + name + "' in inline table");
      return v;
    }
    tml_add_field_val(v, item);
    sl_push(v->fields, name);
    if (item->kind == 4) {
      sl_push(v->field_values, tml_array_literal(item));
    } else {
      sl_push(v->field_values, item->text);
    }
    sl_push(v->field_kinds, tml_kind_code(item->kind));
    tml_skip_ws(p);
    c = tml_c(p);
    if (c == 44) {
      p->pos = p->pos + 1;
    } else if (c == 125) {
      p->pos = p->pos + 1;
      return v;
    } else if (c == -1 || c == 10 || c == 13) {
      tml_err(p, "inline tables must close on the same line");
      return v;
    } else {
      tml_err(p, "expected ',' or '}' in inline table");
      return v;
    }
  }
  return v;
}

// An array value as TOML source text: ["a", 1, true].
fn tml_array_literal(v: TomlValue*) -> string {
  var b: Buf* = buf_new();
  buf_addb(b, 91);
  var i: int64 = 0;
  while (i < v->items->len) {
    if (i > 0) {
      buf_add(b, ", ");
    }
    if (s_eq(sl_get(v->item_kinds, i), "1")) {
      buf_add(b, toml_quote(sl_get(v->items, i)));
    } else {
      buf_add(b, sl_get(v->items, i));
    }
    i = i + 1;
  }
  buf_addb(b, 93);
  return buf_take(b);
}

fn tml_value(p: TmlP*) -> TomlValue* {
  var c: int32 = tml_c(p);
  if (c == 91) {
    return tml_array(p);
  }
  if (c == 123) {
    return tml_inline(p);
  }
  return tml_scalar(p);
}

fn tml_find(doc: Toml*, section: string, key: string) -> TomlEntry* {
  var i: int64 = 0;
  while (i < doc->n) {
    var e: TomlEntry* = doc->entries[i];
    if (s_eq(e->section, section) && s_eq(e->key, key)) {
      return e;
    }
    i = i + 1;
  }
  return (TomlEntry*)0;
}

fn tml_find_header(doc: Toml*, name: string) -> TomlHeader* {
  var i: int64 = 0;
  while (i < doc->nheaders) {
    var h: TomlHeader* = doc->headers[i];
    if (s_eq(h->name, name)) {
      return h;
    }
    i = i + 1;
  }
  return (TomlHeader*)0;
}

fn tml_add_entry(doc: Toml*, e: TomlEntry*) {
  if (doc->n >= doc->cap) {
    var nc: int64 = doc->cap * 2;
    if (nc < 16) { nc = 16; }
    doc->entries = (TomlEntry**)realloc(doc->entries, nc * 8);
    doc->cap = nc;
  }
  doc->entries[doc->n] = e;
  doc->n = doc->n + 1;
}

fn tml_add_header(doc: Toml*, h: TomlHeader*) {
  if (doc->nheaders >= doc->hcap) {
    var nc: int64 = doc->hcap * 2;
    if (nc < 16) { nc = 16; }
    doc->headers = (TomlHeader**)realloc(doc->headers, nc * 8);
    doc->hcap = nc;
  }
  doc->headers[doc->nheaders] = h;
  doc->nheaders = doc->nheaders + 1;
}

fn tml_join_parts(parts: StrList*, upto: int64) -> string {
  var b: Buf* = buf_new();
  var i: int64 = 0;
  while (i < upto) {
    if (i > 0) {
      buf_addb(b, 46);
    }
    buf_add(b, sl_get(parts, i));
    i = i + 1;
  }
  return buf_take(b);
}

fn tml_header(p: TmlP*, current: string) -> string {
  var parts: StrList* = sl_new();
  var r: string = tml_header_in(p, current, parts);
  free(parts);
  return r;
}

fn tml_header_in(p: TmlP*, current: string, parts: StrList*) -> string {
  var start: int64 = p->line_start;
  var line: int64 = p->line;
  if (tml_c_at(p, 1) == 91) {
    tml_err(p, "array tables ([[...]]) are not supported");
    return current;
  }
  p->pos = p->pos + 1;
  var last: int64 = 0;
  tml_key_path(p, parts, &last);
  if (tml_failed(p)) {
    return current;
  }
  if (tml_c(p) != 93) {
    tml_err(p, "expected ']' to close the table header");
    return current;
  }
  p->pos = p->pos + 1;
  var name: string = tml_join_parts(parts, parts->len);
  var prev: TomlHeader* = tml_find_header(p->doc, name);
  if (prev != (TomlHeader*)0) {
    tml_err(p, "duplicate table [" + name + "] (first declared on line " + s_int(prev->line) + ")");
    return current;
  }
  if (!tml_eol(p)) {
    tml_err(p, "expected the end of the line after the table header");
    return current;
  }
  var h: TomlHeader* = new TomlHeader;
  h->name = name;
  h->line = line;
  h->start = start;
  h->end = p->pos;
  tml_add_header(p->doc, h);
  sl_add_uniq(p->doc->sections, name);
  return name;
}

fn tml_keyval(p: TmlP*, current: string) {
  var line: int64 = p->line;
  var line_start: int64 = p->line_start;
  var key_start: int64 = p->pos;
  var parts: StrList* = sl_new();
  defer free(parts);
  var last: int64 = 0;
  tml_key_path(p, parts, &last);
  if (tml_failed(p)) {
    return;
  }
  if (tml_c(p) != 61) {
    tml_err(p, "expected '=' after the key");
    return;
  }
  p->pos = p->pos + 1;
  tml_skip_ws(p);
  var val_start: int64 = p->pos;
  var v: TomlValue* = tml_value(p);
  if (tml_failed(p)) {
    return;
  }
  v->line = line;
  var val_end: int64 = p->pos;
  var end_line: int64 = p->line;
  var section: string = current;
  if (parts->len > 1) {
    var sub: string = tml_join_parts(parts, parts->len - 1);
    if (slen(section) > 0) {
      section = section + "." + sub;
    } else {
      section = sub;
    }
  }
  var key: string = sl_get(parts, parts->len - 1);
  var prev: TomlEntry* = tml_find(p->doc, section, key);
  if (prev != (TomlEntry*)0) {
    p->line = line;
    tml_err(p, "duplicate key '" + key + "' (first set on line " + s_int(prev->line) + ")");
    return;
  }
  if (!tml_eol(p)) {
    tml_err(p, "expected the end of the line after the value");
    return;
  }
  var e: TomlEntry* = new TomlEntry;
  e->section = section;
  e->key = key;
  e->value = v;
  e->line = line;
  e->end_line = end_line;
  e->line_start = line_start;
  e->val_start = val_start;
  e->val_end = val_end;
  e->prefix = s_sub(p->text, key_start, last);
  tml_add_entry(p->doc, e);
  if (slen(section) > 0) {
    sl_add_uniq(p->doc->sections, section);
  }
}

export fn toml_parse(text: string, file: string) -> Toml* {
  var doc: Toml* = new Toml;
  doc->file = file;
  doc->entries = (TomlEntry**)0;
  doc->n = 0;
  doc->cap = 0;
  doc->headers = (TomlHeader**)0;
  doc->nheaders = 0;
  doc->hcap = 0;
  doc->sections = sl_new();
  doc->error = s_empty();
  doc->error_line = 0;
  var p: TmlP* = new TmlP;
  p->text = text;
  p->pos = 0;
  p->line = 1;
  p->line_start = 0;
  p->file = file;
  p->doc = doc;
  var current: string = s_empty();
  while (!tml_failed(p)) {
    tml_skip_ws(p);
    var c: int32 = tml_c(p);
    if (c == -1) {
      break;
    }
    if (c == 10 || c == 13 || c == 35) {
      if (!tml_eol(p)) {
        tml_err(p, "unexpected character");
      }
      continue;
    }
    if (c == 91) {
      current = tml_header(p, current);
    } else {
      tml_keyval(p, current);
    }
  }
  free(p);
  return doc;
}

export fn toml_get(doc: Toml*, section: string, key: string) -> TomlValue* {
  var e: TomlEntry* = tml_find(doc, section, key);
  if (e == (TomlEntry*)0) {
    return (TomlValue*)0;
  }
  return e->value;
}

export fn toml_entry(doc: Toml*, section: string, key: string) -> TomlEntry* {
  return tml_find(doc, section, key);
}

// The text of a string, integer or boolean; "" when absent or another kind.
// (No default parameter: see toml_value_str.)
export fn toml_str(doc: Toml*, section: string, key: string) -> string {
  return toml_value_str(toml_get(doc, section, key), s_empty());
}

// The text of a scalar value; dflt when v is 0 or not a scalar.
export fn toml_value_str(v: TomlValue*, dflt: string) -> string {
  if (v == (TomlValue*)0 || v->kind > 3) {
    return dflt;
  }
  return v->text;
}

export fn toml_has(doc: Toml*, section: string, key: string) -> bool {
  return toml_get(doc, section, key) != (TomlValue*)0;
}

export fn toml_bool(doc: Toml*, section: string, key: string, dflt: bool) -> bool {
  var v: TomlValue* = toml_get(doc, section, key);
  if (v == (TomlValue*)0 || v->kind != 3) {
    return dflt;
  }
  return s_eq(v->text, "true");
}

// Array items (a copy); a single string becomes a one-item list; else empty.
export fn toml_list(doc: Toml*, section: string, key: string) -> StrList* {
  var v: TomlValue* = toml_get(doc, section, key);
  if (v == (TomlValue*)0) {
    return sl_new();
  }
  if (v->kind == 4) {
    return sl_copy(v->items);
  }
  if (v->kind == 1) {
    return sl_of(v->text);
  }
  return sl_new();
}

export fn toml_keys(doc: Toml*, section: string) -> StrList* {
  var keys: StrList* = sl_new();
  var i: int64 = 0;
  while (i < doc->n) {
    var e: TomlEntry* = doc->entries[i];
    if (s_eq(e->section, section)) {
      sl_push(keys, e->key);
    }
    i = i + 1;
  }
  return keys;
}

export fn toml_sections(doc: Toml*, prefix: string) -> StrList* {
  var found: StrList* = sl_new();
  var i: int64 = 0;
  while (i < doc->sections->len) {
    var s: string = sl_get(doc->sections, i);
    if (s_starts(s, prefix)) {
      sl_push(found, s);
    }
    i = i + 1;
  }
  return found;
}

export fn toml_has_section(doc: Toml*, section: string) -> bool {
  return sl_has(doc->sections, section);
}

// An inline-table field's text; "" when v is 0, not a table, or lacks it.
export fn toml_field(v: TomlValue*, field: string) -> string {
  if (v == (TomlValue*)0 || v->kind != 5) {
    return s_empty();
  }
  var at: int64 = sl_index(v->fields, field);
  if (at < 0) {
    return s_empty();
  }
  return sl_get(v->field_values, at);
}

// The kind code ("1" string, "2" integer, "3" bool, "4" array) of an inline-table field; "" when absent.
export fn toml_field_kind(v: TomlValue*, field: string) -> string {
  if (v == (TomlValue*)0 || v->kind != 5) {
    return s_empty();
  }
  var at: int64 = sl_index(v->fields, field);
  if (at < 0) {
    return s_empty();
  }
  return sl_get(v->field_kinds, at);
}

// An inline-table field's parsed value; 0 when v is 0, not a table, or lacks it.
export fn toml_field_value(v: TomlValue*, field: string) -> TomlValue* {
  if (v == (TomlValue*)0 || v->kind != 5 || v->field_vals == (TomlValue**)0) {
    return (TomlValue*)0;
  }
  var at: int64 = sl_index(v->fields, field);
  if (at < 0) {
    return (TomlValue*)0;
  }
  return v->field_vals[at];
}

export fn toml_quote(s: string) -> string {
  var b: Buf* = buf_new();
  buf_addb(b, 34);
  var i: int64 = 0;
  while (i < slen(s)) {
    var c: int32 = s_byte(s, i);
    if (c == 34) {
      buf_add(b, "\\\"");
    } else if (c == 92) {
      buf_add(b, "\\\\");
    } else if (c == 10) {
      buf_add(b, "\\n");
    } else if (c == 9) {
      buf_add(b, "\\t");
    } else if (c == 13) {
      buf_add(b, "\\r");
    } else if (c < 32 || c == 127) {
      buf_add(b, "\\u00");
      buf_addb(b, hex_digit(c >> 4));
      buf_addb(b, hex_digit(c & 15));
    } else {
      buf_addb(b, c);
    }
    i = i + 1;
  }
  buf_addb(b, 34);
  return buf_take(b);
}

// A key as written in a file: bare when it can be, quoted otherwise.
export fn toml_key_literal(key: string) -> string {
  if (slen(key) == 0) {
    return toml_quote(key);
  }
  var i: int64 = 0;
  while (i < slen(key)) {
    if (!tml_is_bare(s_byte(key, i))) {
      return toml_quote(key);
    }
    i = i + 1;
  }
  return key;
}

// A table name for a header: each dot-separated part as a key literal.
export fn toml_section_literal(section: string) -> string {
  var parts: StrList* = s_split(section, 46);
  var b: Buf* = buf_new();
  var i: int64 = 0;
  while (i < parts->len) {
    if (i > 0) {
      buf_addb(b, 46);
    }
    buf_add(b, toml_key_literal(sl_get(parts, i)));
    i = i + 1;
  }
  free(parts);
  return buf_take(b);
}

fn tml_nl_of(text: string) -> string {
  if (s_contains(text, "\r\n")) {
    return "\r\n";
  }
  return "\n";
}

// Offset just past the newline that ends the line containing `from`.
fn tml_line_end(text: string, from: int64) -> int64 {
  var i: int64 = from;
  while (i < slen(text)) {
    if (s_byte(text, i) == 10) {
      return i + 1;
    }
    i = i + 1;
  }
  return slen(text);
}

fn tml_insert_line(text: string, at: int64, line: string, nl: string) -> string {
  var head: string = s_sub(text, 0, at);
  if (slen(head) > 0 && s_byte(head, slen(head) - 1) != 10) {
    head = head + nl;
  }
  return head + line + nl + s_from(text, at);
}

fn tml_indent_of(text: string, line_start: int64) -> string {
  var i: int64 = line_start;
  while (i < slen(text) && (s_byte(text, i) == 32 || s_byte(text, i) == 9)) {
    i = i + 1;
  }
  return s_sub(text, line_start, i);
}

// Sets section.key to value_literal (TOML source text such as "\"v1.0.0\"")
// without disturbing any other line. Text that does not parse is returned
// unchanged.
export fn toml_set_in_text(text: string, section: string, key: string, value_literal: string) -> string {
  var doc: Toml* = toml_parse(text, "<text>");
  if (slen(doc->error) > 0) {
    return text;
  }
  var nl: string = tml_nl_of(text);
  var e: TomlEntry* = tml_find(doc, section, key);
  if (e != (TomlEntry*)0) {
    return s_sub(text, 0, e->val_start) + value_literal + s_from(text, e->val_end);
  }
  var klit: string = toml_key_literal(key);
  var last: TomlEntry* = (TomlEntry*)0;
  var i: int64 = 0;
  while (i < doc->n) {
    if (s_eq(doc->entries[i]->section, section)) {
      last = doc->entries[i];
    }
    i = i + 1;
  }
  if (last != (TomlEntry*)0) {
    var at: int64 = tml_line_end(text, last->val_end);
    var ind: string = tml_indent_of(text, last->line_start);
    return tml_insert_line(text, at, ind + last->prefix + klit + " = " + value_literal, nl);
  }
  var h: TomlHeader* = tml_find_header(doc, section);
  if (h != (TomlHeader*)0) {
    return tml_insert_line(text, h->end, klit + " = " + value_literal, nl);
  }
  if (slen(section) == 0) {
    var top: int64 = slen(text);
    if (doc->nheaders > 0) {
      top = doc->headers[0]->start;
    }
    return tml_insert_line(text, top, klit + " = " + value_literal, nl);
  }
  var b: Buf* = buf_new();
  buf_add(b, text);
  if (slen(text) > 0) {
    if (s_byte(text, slen(text) - 1) != 10) {
      buf_add(b, nl);
    }
    buf_add(b, nl);
  }
  buf_add(b, "[" + toml_section_literal(section) + "]" + nl);
  buf_add(b, klit + " = " + value_literal + nl);
  return buf_take(b);
}

// Deletes section.key's line (through the closing `]` of a multi-line array).
// Absent keys and text that does not parse leave the text unchanged.
export fn toml_remove_in_text(text: string, section: string, key: string) -> string {
  var doc: Toml* = toml_parse(text, "<text>");
  if (slen(doc->error) > 0) {
    return text;
  }
  var e: TomlEntry* = tml_find(doc, section, key);
  if (e == (TomlEntry*)0) {
    return text;
  }
  var end: int64 = tml_line_end(text, e->val_end);
  return s_sub(text, 0, e->line_start) + s_from(text, end);
}
