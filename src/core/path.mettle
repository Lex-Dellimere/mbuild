// path: lexical path operations. Pure string code: nothing here touches the
// filesystem, so the answers are the same on every OS. Both `/` and `\` are
// separators on input; results use `/`.

import "base";
import "std/mem";

fn p_sl_free(l: StrList*) {
  free(l->items);
  free(l);
}

fn p_is_sep(c: int32) -> bool {
  return c == 47 || c == 92;
}

// "X:" at the start of p.
fn p_has_drive(p: string) -> bool {
  return slen(p) >= 2 && is_alpha_b(s_byte(p, 0)) && s_byte(p, 1) == 58;
}

export fn p_is_abs(p: string) -> bool {
  if (slen(p) == 0) {
    return false;
  }
  if (p_is_sep(s_byte(p, 0))) {
    return true;
  }
  return slen(p) >= 3 && p_has_drive(p) && p_is_sep(s_byte(p, 2));
}

export fn p_join(a: string, b: string) -> string {
  if (p_is_abs(b) || slen(a) == 0 || s_eq(a, ".")) {
    return b;
  }
  if (slen(b) == 0 || s_eq(b, ".")) {
    return a;
  }
  if (p_is_sep(s_byte(a, slen(a) - 1))) {
    return a + b;
  }
  return a + "/" + b;
}

// The root part of a path: "", "/", "//", "X:" or "X:/" (after `\` -> `/`).
fn p_root_len(p: string) -> int64 {
  if (s_starts(p, "//")) {
    return 2;
  }
  if (s_starts(p, "/")) {
    return 1;
  }
  if (p_has_drive(p)) {
    if (slen(p) >= 3 && s_byte(p, 2) == 47) {
      return 3;
    }
    return 2;
  }
  return 0;
}

export fn p_clean(p: string) -> string {
  var s: string = s_replace_byte(p, 92, 47);
  var rl: int64 = p_root_len(s);
  var root: string = s_sub(s, 0, rl);
  var rooted: bool = rl > 0 && s_byte(s, rl - 1) == 47;
  var parts: StrList* = s_split(s_from(s, rl), 47);
  var keep: StrList* = sl_new();
  var i: int64 = 0;
  while (i < parts->len) {
    var seg: string = sl_get(parts, i);
    if (slen(seg) == 0 || s_eq(seg, ".")) {
      i = i + 1;
      continue;
    }
    if (s_eq(seg, "..")) {
      if (keep->len > 0 && !s_eq(sl_get(keep, keep->len - 1), "..")) {
        keep->len = keep->len - 1;
      } else if (!rooted) {
        sl_push(keep, seg);
      }
      i = i + 1;
      continue;
    }
    sl_push(keep, seg);
    i = i + 1;
  }
  var body: string = sl_join(keep, "/");
  p_sl_free(parts);
  p_sl_free(keep);
  if (slen(root) == 0 && slen(body) == 0) {
    return ".";
  }
  return root + body;
}

fn p_strip_trailing(p: string) -> string {
  var n: int64 = slen(p);
  while (n > 1 && p_is_sep(s_byte(p, n - 1))) {
    if (n == 3 && p_has_drive(p)) {
      break;
    }
    n = n - 1;
  }
  return s_sub(p, 0, n);
}

fn p_last_sep(p: string) -> int64 {
  var i: int64 = slen(p) - 1;
  while (i >= 0) {
    if (p_is_sep(s_byte(p, i))) {
      return i;
    }
    i = i - 1;
  }
  return -1;
}

export fn p_dir(p: string) -> string {
  var s: string = p_strip_trailing(p);
  var at: int64 = p_last_sep(s);
  if (at < 0) {
    if (p_has_drive(s)) {
      return s_sub(s, 0, 2);
    }
    return ".";
  }
  if (at == 0) {
    return "/";
  }
  if (at == 2 && p_has_drive(s)) {
    return s_sub(s, 0, 3);
  }
  if (at == 1 && p_is_sep(s_byte(s, 0))) {
    return s_sub(s, 0, 2);
  }
  return s_sub(s, 0, at);
}

export fn p_base(p: string) -> string {
  var s: string = p_strip_trailing(p);
  if (slen(s) == 0) {
    return ".";
  }
  var at: int64 = p_last_sep(s);
  if (at == slen(s) - 1) {
    return s;
  }
  var b: string = s_from(s, at + 1);
  if (at < 0 && p_has_drive(b)) {
    b = s_from(b, 2);
  }
  return b;
}

// ".c" for "a/b.c"; "" when the last component has no dot. A leading dot
// (".gitignore") is a name, not an extension.
export fn p_ext(p: string) -> string {
  var b: string = p_base(p);
  var at: int64 = s_rfind_byte(b, 46);
  if (at <= 0) {
    return "";
  }
  return s_from(b, at);
}

export fn p_stem(p: string) -> string {
  var b: string = p_base(p);
  return s_sub(b, 0, slen(b) - slen(p_ext(b)));
}

export fn p_to_backslash(p: string) -> string {
  return s_replace_byte(p, 47, 92);
}

// p equals dir or lies below it (lexically, after cleaning both).
export fn p_has_prefix_dir(p: string, dir: string) -> bool {
  var cp: string = p_clean(p);
  var cd: string = p_clean(dir);
  if (s_eq(cd, ".")) {
    return !p_is_abs(cp) && !s_eq(cp, "..") && !s_starts(cp, "../");
  }
  if (s_eq(cp, cd)) {
    return true;
  }
  if (s_ends(cd, "/")) {
    return s_starts(cp, cd);
  }
  return s_starts(cp, cd + "/");
}

// target relative to base when it lies inside base, else target unchanged.
export fn p_rel(base: string, target: string) -> string {
  var cb: string = p_clean(base);
  var ct: string = p_clean(target);
  if (!p_has_prefix_dir(ct, cb)) {
    return target;
  }
  if (s_eq(ct, cb)) {
    return ".";
  }
  if (s_eq(cb, ".")) {
    return ct;
  }
  if (s_ends(cb, "/")) {
    return s_from(ct, slen(cb));
  }
  return s_from(ct, slen(cb) + 1);
}
