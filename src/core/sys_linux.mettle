// sys_linux: the platform layer on Linux. sys_windows exports the same API.
//
// Only names the v0.17.0 Linux runtime carries are used.
// What that runtime lacks (rename, rmdir, directory listing, fork) is done by
// host programs: `ls`, `rm`, `mv`. Child processes that run in the
// background (the -j pool, services) go through alph (third_party/alph): a
// node runs only while they do.
//
// The runtime's putenv only changes what this process's getenv answers; the
// children it starts get the environment the process started with. So every
// variable set with sys_setenv is also remembered here and exported again in
// front of each command that needs it.

import "std/io";
import "std/mem";
import "base";
import "../../third_party/alph/core/mailbox" if linux;
import "../../third_party/alph/core/node" if linux;
import "../../third_party/alph/work/limiter" if linux;

extern fn lx_popen(cmd: cstring, mode: cstring) -> cstring = "popen";
extern fn lx_pclose(fp: cstring) -> int32 = "pclose";
extern fn lx_run_process(program: cstring, argv: cstring*) -> int32 = "mettle_run_process";
extern fn lx_putenv(setting: cstring) -> int32 = "putenv";
extern fn lx_mkdir(path: cstring, mode: uint32) -> int32 = "mkdir";
extern fn lx_remove(path: cstring) -> int32 = "remove";
extern fn lx_access(path: cstring, mode: int32) -> int32 = "access";
extern fn lx_realpath(path: cstring, buf: cstring) -> cstring = "mettle_realpath";
extern fn lx_getcwd(buf: cstring, size: int32) -> int32 = "mettle_getcwd";
extern fn lx_exe_path(buf: cstring, size: uint64) -> int64 = "mettle_executable_path";
extern fn lx_is_dir(path: cstring) -> int32 = "mettle_path_is_directory";
extern fn lx_isatty(fd: int32) -> int32 = "isatty";
extern fn lx_stat(path: cstring, buf: rawptr) -> int32 = "stat";
extern fn lx_chmod(path: cstring, mode: uint32) -> int32 = "chmod";
extern fn lx_usleep(us: uint32) -> int32 = "usleep";
extern fn lx_clock_gettime(id: int32, ts: rawptr) -> int32 = "clock_gettime";

// "NAME=value" for every sys_setenv call, latest value per name.
var g_lx_env: StrList* = 0;

export fn sys_os() -> string {
  return "linux";
}

// The directories searched for programs when PATH is unset (colon-separated;
// sys_windows answers the same list for host programs under wine).
export fn sys_unix_path_default() -> string {
  return "/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin";
}

export fn sys_exe_ext() -> string {
  return "";
}

export fn sys_is_wine() -> bool {
  return false;
}

export fn sys_list_sep() -> int32 {
  return 58;
}

fn lx_env_list() -> StrList* {
  if (g_lx_env == 0) {
    g_lx_env = sl_new();
  }
  return g_lx_env;
}

export fn sys_setenv(name: string, value: string) {
  var entry: string = name + "=" + value;
  var l: StrList* = lx_env_list();
  var i: int64 = 0;
  var found: bool = false;
  while (i < l->len) {
    if (s_starts(sl_get(l, i), name + "=")) {
      sl_set(l, i, entry);
      found = true;
    }
    i = i + 1;
  }
  if (!found) {
    sl_push(l, entry);
  }
  // putenv keeps the pointer: the copy is never freed.
  lx_putenv(s_c(entry));
}

export fn sys_home() -> string {
  return env_get("HOME");
}

export fn sys_cwd() -> string {
  var buf: uint8* = (uint8*)malloc(4096);
  var r: string = ".";
  if (lx_getcwd((cstring)buf, 4096) == 0) {
    r = s_from_c((cstring)buf);
  }
  free(buf);
  return r;
}

export fn sys_self_exe() -> string {
  var buf: uint8* = (uint8*)malloc(4096);
  var n: int64 = lx_exe_path((cstring)buf, (uint64)4096);
  var r: string = "";
  if (n > 0) {
    r = s_dup(s_view(buf, n));
  }
  free(buf);
  return r;
}

export fn sys_realpath(p: string) -> string {
  var buf: uint8* = (uint8*)malloc(4096);
  var r: string = "";
  if (lx_realpath(s_c(p), (cstring)buf) != 0) {
    r = s_from_c((cstring)buf);
  }
  free(buf);
  return r;
}

export fn sys_now_ms() -> int64 {
  var ts: int64[2];
  ts[0] = 0;
  ts[1] = 0;
  lx_clock_gettime(1, (rawptr)&ts[0]);
  return ts[0] * 1000 + ts[1] / 1000000;
}

export fn sys_sleep_ms(ms: int64) {
  var left: int64 = ms;
  while (left > 0) {
    var step: int64 = left;
    if (step > 1000000) {
      step = 1000000;
    }
    lx_usleep((uint32)(step * 1000));
    left = left - step;
  }
}

export fn sys_isatty(fd: int32) -> bool {
  return lx_isatty(fd) != 0;
}

// stdin's termios before sys_term_raw (x86-64: 60 bytes).
var g_lx_term: uint8* = (uint8*)0;

// Keys one at a time without echo, Ctrl-C as a byte; output processing
// stays on. False when stdin is no terminal.
export fn sys_term_raw() -> bool {
  if (g_lx_term == (uint8*)0) {
    g_lx_term = (uint8*)malloc(64);
  }
  if (syscall(16, 0, 0x5401, g_lx_term) != 0) {   // ioctl TCGETS
    return false;
  }
  var t: uint8* = (uint8*)malloc(64);
  defer free(t);
  memcpy((rawptr)t, (rawptr)g_lx_term, 64);
  t[1] = t[1] & (uint8)0xFA;   // c_iflag: ICRNL, IXON off
  t[12] = t[12] & (uint8)0xF4; // c_lflag: ISIG, ICANON, ECHO off
  t[13] = t[13] & (uint8)0x7F; // IEXTEN off
  t[17 + 6] = (uint8)1;        // VMIN
  t[17 + 5] = (uint8)0;        // VTIME
  return syscall(16, 0, 0x5402, t) == 0;          // TCSETS
}

// stdin's termios kept for sys_term_cooked (before handing the terminal to a
// child that may leave it raw); false when stdin is no terminal.
export fn sys_term_save() -> bool {
  if (g_lx_term == (uint8*)0) {
    g_lx_term = (uint8*)malloc(64);
  }
  return syscall(16, 0, 0x5401, g_lx_term) == 0;  // ioctl TCGETS
}

export fn sys_term_cooked() {
  if (g_lx_term != (uint8*)0) {
    syscall(16, 0, 0x5402, g_lx_term);
  }
}

// True when stdin has input within ms.
export fn sys_stdin_ready(ms: int64) -> bool {
  var fds: int32[2];
  fds[0] = 0;
  fds[1] = 1;                                     // POLLIN
  return syscall(7, &fds[0], 1, ms) > 0 && ((fds[1] >> 16) & 0x19) != 0;
}

// A new FIFO at path, opened read-write and non-blocking (so writers never
// block on open and it never reads as ended); -1 when it can't be made.
export fn sys_fifo_open(path: string) -> int32 {
  syscall(87, s_c(path));                                  // unlink
  if (syscall(259, -100, s_c(path), 0x1180, 0) != 0) {     // mknodat S_IFIFO|0600
    return -1;
  }
  return (int32)syscall(257, -100, s_c(path), 0x80802, 0); // openat O_RDWR|O_NONBLOCK|O_CLOEXEC
}

// What fd has now, added to b; the number of bytes.
export fn sys_fd_drain(fd: int32, b: Buf*) -> int64 {
  var n: int64 = 0;
  while (fd >= 0) {
    buf_reserve(b, 4096);
    var got: int64 = syscall(0, fd, &b->data[b->len], 4096);
    if (got <= 0) {
      break;
    }
    b->len = b->len + got;
    n = n + got;
  }
  return n;
}

export fn sys_fd_close(fd: int32) {
  if (fd >= 0) {
    syscall(3, fd);
  }
}

// Within ms: 1 when stdin has input, 2 when fd has (-1: none), 3 both, 0 neither.
export fn sys_wait_input(fd: int32, ms: int64) -> int32 {
  var fds: int32[4];
  fds[0] = 0;
  fds[1] = 1;                                     // POLLIN
  fds[2] = fd;
  fds[3] = 1;
  var n: int64 = 1;
  if (fd >= 0) {
    n = 2;
  }
  if (syscall(7, &fds[0], n, ms) <= 0) {
    return 0;
  }
  var r: int32 = 0;
  if (((fds[1] >> 16) & 0x19) != 0) {
    r = r | 1;
  }
  if (fd >= 0 && ((fds[3] >> 16) & 0x19) != 0) {
    r = r | 2;
  }
  return r;
}

// One byte from stdin, unbuffered; -1 at its end or on an error, -2 when
// there is none yet (EAGAIN). An interrupted read (EINTR) is retried.
export fn sys_read_byte() -> int32 {
  var b: uint8[1];
  b[0] = (uint8)0;
  var n: int64 = syscall(0, 0, &b[0], 1);
  while (n == -4) {
    n = syscall(0, 0, &b[0], 1);
  }
  if (n == -11) {
    return -2;
  }
  if (n != 1) {
    return -1;
  }
  return (int32)b[0];
}

export fn sys_pid_alive(pid: int64) -> bool {
  return pid > 0 && syscall(62, pid, 0) == 0;
}

// SIGTERM.
export fn sys_kill(pid: int64) {
  if (pid > 0) {
    syscall(62, pid, 15);
  }
}

fn lx_rd32(p: uint8*, off: int64) -> int64 {
  var v: int64 = 0;
  var i: int64 = 3;
  while (i >= 0) {
    v = (v << 8) | (int64)p[off + i];
    i = i - 1;
  }
  return v;
}

fn lx_rd64(p: uint8*, off: int64) -> int64 {
  return (lx_rd32(p, off + 4) << 32) | lx_rd32(p, off);
}

export fn sys_stat(p: string) -> FileInfo {
  var fi: FileInfo;
  fi.exists = false;
  fi.is_dir = false;
  fi.size = 0;
  fi.mtime = 0;
  var buf: uint8* = (uint8*)malloc(256);
  memset(buf, 0, 256);
  if (lx_stat(s_c(p), (rawptr)buf) != 0) {
    free(buf);
    return fi;
  }
  var mode: int64 = lx_rd32(buf, 24);
  fi.exists = true;
  fi.is_dir = (mode & 61440) == 16384;
  fi.size = lx_rd64(buf, 48);
  fi.mtime = lx_rd64(buf, 88) * 1000000000 + lx_rd64(buf, 96);
  free(buf);
  return fi;
}

export fn sys_mkdir(p: string) -> bool {
  lx_mkdir(s_c(p), (uint32)511);
  return lx_is_dir(s_c(p)) != 0;
}

// Creates p and answers true only when this call created it (false when it
// already existed or could not be made): an atomic test-and-set for locks.
export fn sys_mkdir_new(p: string) -> bool {
  return lx_mkdir(s_c(p), (uint32)511) == 0;
}

// Runs argv (argv[0] is the program) directly, inheriting stdio. Consumes
// the list.
fn lx_exec(args: StrList*) -> int32 {
  flush_out();
  var argv: cstring* = (cstring*)malloc((args->len + 1) * 8);
  defer free(argv);
  var i: int64 = 0;
  while (i < args->len) {
    argv[i] = s_c(sl_get(args, i));
    i = i + 1;
  }
  argv[args->len] = 0;
  var code: int32 = lx_run_process(argv[0], argv);
  free(args->items);
  free(args);
  return code;
}

// Reads a popen stream to EOF and closes it. Returns the exit code.
fn lx_drain(fp: cstring, b: Buf*) -> int32 {
  while (true) {
    buf_reserve(b, 65536);
    var got: int64 = fread((cstring)&b->data[b->len], 1, 65535, fp);
    if (got <= 0) {
      break;
    }
    b->len = b->len + got;
  }
  return lx_decode_status(lx_pclose(fp));
}

fn lx_decode_status(st: int32) -> int32 {
  if (st < 0) {
    return 127;
  }
  if ((st & 127) != 0) {
    return 128 + (st & 127);
  }
  return (st >> 8) & 255;
}

// Runs a shell line and returns its standard output.
fn lx_shell_capture(line: string) -> Captured {
  var r: Captured;
  r.code = 127;
  r.out = "";
  flush_out();
  var fp: cstring = lx_popen(s_c(line), "r");
  if (fp == 0) {
    return r;
  }
  var b: Buf* = buf_new();
  r.code = lx_drain(fp, b);
  r.out = buf_take(b);
  return r;
}

export fn sys_list_dir(p: string, files: StrList*, dirs: StrList*) -> bool {
  if (lx_is_dir(s_c(p)) == 0) {
    return false;
  }
  var r: Captured = lx_shell_capture("LC_ALL=C exec ls -1Ap -- " + sh_quote(p) + " 2>/dev/null");
  if (r.code != 0) {
    return false;
  }
  var lines: StrList* = s_split(r.out, 10);
  var i: int64 = 0;
  while (i < lines->len) {
    var name: string = sl_get(lines, i);
    if (slen(name) > 0) {
      if (s_ends(name, "/")) {
        var d: string = s_sub(name, 0, slen(name) - 1);
        if (!s_eq(d, ".") && !s_eq(d, "..")) {
          sl_push(dirs, d);
        }
      } else {
        sl_push(files, name);
      }
    }
    i = i + 1;
  }
  free(lines->items);
  free(lines);
  return true;
}

export fn sys_remove_file(p: string) -> bool {
  if (lx_is_dir(s_c(p)) != 0) {
    return false;
  }
  return lx_remove(s_c(p)) == 0;
}

fn lx_exists(p: string) -> bool {
  return lx_access(s_c(p), 0) == 0;
}

export fn sys_remove_tree(p: string) -> bool {
  if (!lx_exists(p)) {
    return true;
  }
  var args: StrList* = sl_of("rm");
  sl_push(args, "-rf");
  sl_push(args, "--");
  sl_push(args, p);
  lx_exec(args);
  return !lx_exists(p);
}

// p without trailing slashes ("/" stays "/").
fn lx_trim_slash(p: string) -> string {
  var n: int64 = slen(p);
  while (n > 1 && s_byte(p, n - 1) == 47) {
    n = n - 1;
  }
  return s_sub(p, 0, n);
}

// A symbolic link to a directory: `ls -1Ap` lists it among the files of its
// parent (no trailing `/`) while stat, which follows links, sees a directory.
export fn sys_is_link(p: string) -> bool {
  var q: string = lx_trim_slash(p);
  if (slen(q) == 0 || lx_is_dir(s_c(q)) == 0) {
    return false;
  }
  var slash: int64 = s_rfind_byte(q, 47);
  var parent: string = ".";
  if (slash == 0) {
    parent = "/";
  } else if (slash > 0) {
    parent = s_sub(q, 0, slash);
  }
  var name: string = s_from(q, slash + 1);
  var files: StrList* = sl_new();
  var dirs: StrList* = sl_new();
  var found: bool = false;
  if (sys_list_dir(parent, files, dirs)) {
    found = sl_has(files, name);
  }
  free(files->items);
  free(files);
  free(dirs->items);
  free(dirs);
  return found;
}

// Makes link a symbolic link to target (an absolute path), replacing a link
// already there. A real directory at link is left alone (false).
export fn sys_make_link(target: string, link: string) -> bool {
  var q: string = lx_trim_slash(link);
  // lx_exists follows links: a dangling link is replaced too.
  if (lx_exists(q) && !sys_is_link(q)) {
    return false;
  }
  var rm: StrList* = sl_of("rm");
  sl_push(rm, "-f");
  sl_push(rm, "--");
  sl_push(rm, q);
  lx_exec(rm);
  var ln: StrList* = sl_of("ln");
  sl_push(ln, "-sn");
  sl_push(ln, "--");
  sl_push(ln, target);
  sl_push(ln, q);
  if (lx_exec(ln) != 0) {
    return false;
  }
  return sys_is_link(q);
}

// Removes p only when it is a link; the target is never touched.
export fn sys_remove_link(p: string) -> bool {
  var q: string = lx_trim_slash(p);
  if (!sys_is_link(q)) {
    return false;
  }
  var rm: StrList* = sl_of("rm");
  sl_push(rm, "-f");
  sl_push(rm, "--");
  sl_push(rm, q);
  lx_exec(rm);
  return !lx_exists(q);
}

export fn sys_rename(from: string, to: string) -> bool {
  var args: StrList* = sl_of("mv");
  sl_push(args, "-f");
  sl_push(args, "--");
  sl_push(args, from);
  sl_push(args, to);
  return lx_exec(args) == 0;
}

export fn sys_set_executable(p: string) {
  var buf: uint8* = (uint8*)malloc(256);
  defer free(buf);
  if (lx_stat(s_c(p), (rawptr)buf) != 0) {
    return;
  }
  var mode: int64 = lx_rd32(buf, 24) & 4095;
  // Execute for whoever may read it: r--r----- becomes r-xr-x---.
  mode = mode | ((mode & 292) >> 2) | 64;
  lx_chmod(s_c(p), (uint32)mode);
}

fn lx_is_exec_file(p: string) -> bool {
  var c: cstring = s_c(p);
  return lx_access(c, 1) == 0 && lx_is_dir(c) == 0;
}

export fn sys_find_tool(name: string) -> Tool {
  var t: Tool = tool_none();
  if (slen(name) == 0) {
    return t;
  }
  if (s_find_byte(name, 47) >= 0) {
    if (lx_is_exec_file(name)) {
      t.path = name;
    }
    return t;
  }
  var path_var: string = env_get("PATH");
  if (slen(path_var) == 0) {
    path_var = sys_unix_path_default();
  }
  var dirs: StrList* = s_split(path_var, 58);
  var i: int64 = 0;
  while (i < dirs->len) {
    var d: string = sl_get(dirs, i);
    if (slen(d) == 0) {
      d = ".";
    }
    var cand: string = d + "/" + name;
    if (s_ends(d, "/")) {
      cand = d + name;
    }
    if (lx_is_exec_file(cand)) {
      t.path = cand;
      break;
    }
    i = i + 1;
  }
  free(dirs->items);
  free(dirs);
  return t;
}

// `cd DIR || exit 127; export 'K=V'; ... exec 'prog' 'args'`: the command as
// one shell line, with this command's directory and environment.
fn lx_shell_line(c: Cmd*) -> string {
  var b: Buf* = buf_new();
  if (slen(c->cwd) > 0) {
    buf_add(b, "cd " + sh_quote(c->cwd) + " || exit 127; ");
  }
  var ov: StrList* = lx_env_list();
  var i: int64 = 0;
  while (i < ov->len) {
    buf_add(b, "export " + sh_quote(sl_get(ov, i)) + "; ");
    i = i + 1;
  }
  i = 0;
  while (i < c->env->len) {
    buf_add(b, "export " + sh_quote(sl_get(c->env, i)) + "; ");
    i = i + 1;
  }
  buf_add(b, "exec " + sh_quote(c->tool.path));
  i = 0;
  while (i < c->args->len) {
    buf_addb(b, 32);
    buf_add(b, sh_quote(sl_get(c->args, i)));
    i = i + 1;
  }
  return buf_take(b);
}

export fn sys_run(c: Cmd*) -> int32 {
  var args: StrList* = sl_new();
  if (slen(c->cwd) == 0 && c->env->len == 0 && lx_env_list()->len == 0) {
    sl_push(args, c->tool.path);
    sl_extend(args, c->args);
  } else {
    sl_push(args, "/bin/sh");
    sl_push(args, "-c");
    sl_push(args, lx_shell_line(c));
  }
  return lx_exec(args);
}

export fn sys_capture(c: Cmd*, merge_stderr: bool) -> Captured {
  var line: string = lx_shell_line(c);
  if (merge_stderr) {
    line = line + " 2>&1";
  }
  return lx_shell_capture(line);
}

export fn sys_host_path(p: string) -> string {
  return p;
}

// ---------------------------------------------------------------------------
// Child processes through alph: the -j pool here, services in
// build/services_linux.
// ---------------------------------------------------------------------------

// The environment a child gets: the one mbuild started with, then sys_setenv's, then extra.
fn lx_child_env(extra: StrList*) -> StrList* {
  var out: StrList* = sl_new();
  var fp: cstring = fopen("/proc/self/environ", "rb");
  if (fp != 0) {
    var b: Buf* = buf_new();
    while (true) {
      buf_reserve(b, 65536);
      var got: int64 = fread((cstring)&b->data[b->len], 1, 65535, fp);
      if (got <= 0) {
        break;
      }
      b->len = b->len + got;
    }
    fclose(fp);
    var all: string = buf_take(b);
    var start: int64 = 0;
    var i: int64 = 0;
    while (i < slen(all)) {
      if (s_byte(all, i) == 0) {
        if (i > start) {
          sl_push(out, s_sub(all, start, i));
        }
        start = i + 1;
      }
      i = i + 1;
    }
  }
  lx_env_merge(out, lx_env_list());
  lx_env_merge(out, extra);
  return out;
}

fn lx_env_merge(env: StrList*, kvs: StrList*) {
  var i: int64 = 0;
  while (i < kvs->len) {
    var kv: string = sl_get(kvs, i);
    var eq: int64 = s_find_byte(kv, 61);
    var key: string = s_sub(kv, 0, eq + 1);
    var k: int64 = 0;
    var found: bool = false;
    while (k < env->len) {
      if (s_starts(sl_get(env, k), key)) {
        sl_set(env, k, kv);
        found = true;
      }
      k = k + 1;
    }
    if (!found) {
      sl_push(env, kv);
    }
    i = i + 1;
  }
}

fn lx_cstrs(l: StrList*) -> cstring* {
  var a: cstring* = (cstring*)malloc((l->len + 1) * 8);
  var i: int64 = 0;
  while (i < l->len) {
    a[i] = s_c(sl_get(l, i));
    i = i + 1;
  }
  a[l->len] = 0;
  return a;
}

// Runs handler as one actor, with a copy of size bytes at state, on a node of its own
// until it halts, and answers the halt code. handles bounds the processes
// and connections it holds at once. sig_tag > 0: Ctrl-C comes to the actor
// as that tag instead of ending mbuild.
export fn sys_node_run(state: rawptr, size: int64, handles: int64, sig_tag: int64,
                       handler: fn(AlphCtx*, AlphMsg*) -> int64 with alloc, syscall, asm) -> int64 {
  var node: AlphNode* = new AlphNode;
  var cfg: AlphConfig;
  alph_config(&cfg);
  cfg.schedulers = 1;
  cfg.max_actors = 64;
  cfg.max_handles = handles + 64;
  cfg.mailbox_size = 2 * handles + 64;
  if (sig_tag > 0) {
    cfg.signals = 1 << ALPH_SIGINT;
  }
  flush_out();
  if (!alph_node_start(node, &cfg)) {
    fail("cannot start child processes (no threads or memory)");
  }
  var pid: int64 = alph_node_spawn_bytes(node, 0, state, size, handler);
  if (sig_tag > 0) {
    alph_node_signals(node, pid, sig_tag);
  }
  var code: int64 = alph_node_wait(node);
  flush_out();
  return code;
}

// Starts c owned by the calling actor: stdin /dev/null, stdout and stderr to
// log ("" = all three inherited), in a process group of its own unless
// keep_group. A process handle, or below 0 when nothing started.
export fn sys_proc_start(ctx: AlphCtx*, c: Cmd*, log: string, keep_group: bool) -> int64 {
  var args: StrList* = sl_new();
  defer free(args);
  sl_push(args, c->tool.path);
  sl_extend(args, c->args);
  var spec: AlphProcSpec;
  memset((rawptr)&spec, 0, (int64)sizeof(AlphProcSpec));
  spec.argv = lx_cstrs(args);
  spec.envp = lx_cstrs(lx_child_env(c->env));
  if (slen(c->cwd) > 0) {
    spec.cwd = s_c(c->cwd);
  }
  if (slen(log) > 0) {
    spec.log = s_c(log);
    spec.flags = ALPH_PROC_QUIET;
  }
  if (keep_group) {
    spec.flags = spec.flags | ALPH_PROC_KEEP_GROUP;
  }
  flush_out();
  var h: int64 = alph_proc_spawn(ctx, &spec);
  free(spec.argv);
  free(spec.envp);
  return h;
}

// The pool's actor: asks the limiter for one permit at a time and starts the
// next job when it is granted; a job's end gives its permit back.
struct LxPool {
  cmds: Cmd**;
  n: int64;
  logs: StrList*;
  parallel: int64;
  ev: fn(rawptr, int64, int32) -> bool with alloc, syscall, asm;
  arg: rawptr;
  codes: int32*;
  procs: int64*;    // process handle per running job, else 0
  permits: int64*;  // its permit's ref
  limiter: int64;
  asked: int64;     // ref of the acquire not yet granted, else 0
  upto: int64;
  running: int64;
  more: bool;
}

// A job has ended: its code, its permit back, and the hook.
fn lx_pool_ended(ctx: AlphCtx*, s: LxPool*, i: int64, code: int32) {
  s->codes[i] = code;
  alph_release(ctx, s->limiter, s->permits[i]);
  if (!s->ev(s->arg, i, code)) {
    s->more = false;
  }
}

// Asks for the next permit, or halts once nothing runs and nothing is left.
fn lx_pool_next(ctx: AlphCtx*, s: LxPool*) {
  if (!s->more && s->asked != 0) {
    alph_release(ctx, s->limiter, s->asked);
    s->asked = 0;
  }
  if (s->more && s->upto < s->n && s->asked == 0) {
    s->asked = alph_acquire(ctx, s->limiter);
  }
  if (s->running == 0 && s->asked <= 0) {
    alph_halt(ctx, 0);
  }
}

fn lx_pool(ctx: AlphCtx*, m: AlphMsg*) -> int64 {
  var s: LxPool* = (LxPool*)ctx->state;
  if (m->tag == ALPH_TAG_INIT) {
    alph_trap_exits(ctx, true);
    s->limiter = alph_spawn_limiter(ctx, s->parallel);
    lx_pool_next(ctx, s);
  } else if (m->tag == ALPH_TAG_GRANTED && m->ref == s->asked) {
    var i: int64 = s->upto;
    s->upto = s->upto + 1;
    s->permits[i] = s->asked;
    s->asked = 0;
    s->ev(s->arg, i, -1);
    var h: int64 = sys_proc_start(ctx, s->cmds[i], sl_get(s->logs, i), true);
    if (h > 0) {
      s->procs[i] = h;
      s->running = s->running + 1;
    } else {
      lx_pool_ended(ctx, s, i, 127);
    }
    lx_pool_next(ctx, s);
  } else if (m->tag == ALPH_TAG_PROC_EXIT) {
    var k: int64 = 0;
    while (k < s->upto) {
      if (s->procs[k] == m->ref) {
        s->procs[k] = 0;
        s->running = s->running - 1;
        lx_pool_ended(ctx, s, k, (int32)m->arg);
      }
      k = k + 1;
    }
    lx_pool_next(ctx, s);
  }
  return ALPH_CONTINUE;
}

// Runs cmds[0..n), at most parallel at a time, stdout and stderr of each to
// logs[i]. ev(arg, i, -1) as job i starts, ev(arg, i, code) as it ends (in
// the order they end), and false from the latter starts no more. Codes in
// command order, -1 for jobs never started.
export fn sys_run_jobs(cmds: Cmd**, n: int64, logs: StrList*, parallel: int64, arg: rawptr,
                       ev: fn(rawptr, int64, int32) -> bool with alloc, syscall, asm) -> int32* {
  var s: LxPool;
  memset((rawptr)&s, 0, (int64)sizeof(LxPool));
  s.cmds = cmds;
  s.n = n;
  s.logs = logs;
  s.parallel = parallel;
  s.ev = ev;
  s.arg = arg;
  s.codes = (int32*)malloc((n + 1) * 4);
  s.procs = (int64*)malloc((n + 1) * 8);
  s.permits = (int64*)malloc((n + 1) * 8);
  s.more = true;
  var k: int64 = 0;
  while (k < n) {
    s.codes[k] = -1;
    s.procs[k] = 0;
    k = k + 1;
  }
  if (n > 0) {
    sys_node_run((rawptr)&s, (int64)sizeof(LxPool), parallel, 0, &lx_pool);
  }
  free(s.procs);
  free(s.permits);
  return s.codes;
}

