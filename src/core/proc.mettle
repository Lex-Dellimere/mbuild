// proc: tool lookup with environment overrides, running and capturing
// commands, and a pool of parallel jobs.

import "std/mem";
import "base";
import "fs";
import "sys_linux" if linux;
import "sys_windows" if windows;

// The program named by the environment variable env_override (e.g.
// MBUILD_GIT) when that is set, else `name` searched on PATH.
export fn proc_tool(name: string, env_override: string) -> Tool {
  if (slen(env_override) > 0) {
    var v: string = env_get(env_override);
    if (slen(v) > 0) {
      return sys_find_tool(v);
    }
  }
  return sys_find_tool(name);
}

// Returns a pointer, not a Tool: v0.17.0 cannot compile a cross-module call
// that returns an aggregate through memory and takes six argument registers.
export fn proc_require(name: string, env_override: string, why: string) -> Tool* {
  var t: Tool* = new Tool;
  *t = proc_tool(name, env_override);
  if (!tool_found(*t)) {
    var hint: string = "install `" + name + "` and put it on PATH";
    if (slen(env_override) > 0) {
      hint = hint + ", or set " + env_override + " to its path";
      if (slen(env_get(env_override)) > 0) {
        fail_hint(env_override + "=" + env_get(env_override) + " does not name a program (needed " + why + ")", hint);
      }
    }
    fail_hint("cannot find `" + name + "` (needed " + why + ")", hint);
  }
  return t;
}

export fn proc_run(c: Cmd*) -> int32 {
  verbose(cmd_display(c));
  return sys_run(c);
}

export fn proc_capture(c: Cmd*) -> Captured {
  verbose(cmd_display(c));
  return sys_capture(c, false);
}

export fn proc_capture_all(c: Cmd*) -> Captured {
  verbose(cmd_display(c));
  return sys_capture(c, true);
}

// ---------------------------------------------------------------------------
// Downloads: https only (plain http just for this machine), through curl
// ---------------------------------------------------------------------------

// The host of an http(s) URL, lowercased, without port or brackets; "" when
// the authority holds credentials (user@host) or is empty.
fn procx_url_host(url: string) -> string {
  var at: int64 = s_find_byte(url, 58);
  if (at < 0 || !s_starts(s_from(url, at), "://")) {
    return s_empty();
  }
  var rest: string = s_from(url, at + 3);
  var end: int64 = 0;
  while (end < slen(rest)) {
    var c: int32 = s_byte(rest, end);
    if (c == 47 || c == 63 || c == 35) {
      break;
    }
    end = end + 1;
  }
  var auth: string = s_lower(s_sub(rest, 0, end));
  if (slen(auth) == 0 || s_find_byte(auth, 64) >= 0) {
    return s_empty();
  }
  if (s_starts(auth, "[")) {
    var close: int64 = s_find_byte(auth, 93);
    if (close < 0) {
      return s_empty();
    }
    return s_sub(auth, 1, close);
  }
  var colon: int64 = s_find_byte(auth, 58);
  if (colon >= 0) {
    return s_sub(auth, 0, colon);
  }
  return auth;
}

fn procx_is_loopback(url: string) -> bool {
  var h: string = procx_url_host(url);
  return s_eq(h, "localhost") || s_eq(h, "127.0.0.1") || s_eq(h, "::1");
}

// "" when mbuild may download from url, else why not (one line).
export fn net_url_refusal(url: string) -> string {
  var l: string = s_lower(url);
  if (s_starts(l, "https://")) {
    if (slen(procx_url_host(url)) == 0) {
      return url + " has no host, or carries credentials (put them in ~/.netrc)";
    }
    return s_empty();
  }
  if (s_starts(l, "http://")) {
    if (procx_is_loopback(url)) {
      return s_empty();
    }
    return "refusing " + url + ": downloads must use https:// (plain http is only allowed for localhost)";
  }
  return "refusing " + url + ": not an https:// URL";
}

// A curl command for url: fails on HTTP errors, follows redirects to https
// only, gives up on a stalled or endless transfer. The caller adds -o and the URL.
export fn net_curl_cmd(curl: Tool, url: string) -> Cmd* {
  var c: Cmd* = cmd_new(curl);
  cmd_arg(c, "-fsSL");
  cmd_arg(c, "--proto");
  if (s_starts(s_lower(url), "http://")) {
    cmd_arg(c, "=http,https");
  } else {
    cmd_arg(c, "=https");
  }
  cmd_arg(c, "--proto-redir");
  cmd_arg(c, "=https");
  cmd_arg(c, "--max-redirs");
  cmd_arg(c, "5");
  cmd_arg(c, "--connect-timeout");
  cmd_arg(c, "30");
  cmd_arg(c, "--max-time");
  cmd_arg(c, "900");
  cmd_arg(c, "--retry");
  cmd_arg(c, "2");
  return c;
}

// proc_run stopped after ms (0: no limit); *timed_out when it was.
export fn proc_run_timeout(c: Cmd*, ms: int64, timed_out: bool*) -> int32 {
  verbose(cmd_display(c));
  return sys_run_timeout(c, s_empty(), ms, timed_out);
}

// proc_capture_all stopped after ms (0: no limit), stdin from /dev/null.
export fn proc_capture_timeout(c: Cmd*, ms: int64, timed_out: bool*) -> Captured {
  verbose(cmd_display(c));
  var log: string = fs_temp_dir() + "/run-" + hash_string(sys_cwd() + "{sys_now_ms()}") + ".log";
  var r: Captured;
  r.code = sys_run_timeout(c, log, ms, timed_out);
  r.out = s_empty();
  var rd: FsRead = fs_read(log);
  if (rd.ok) {
    r.out = rd.data;
  }
  sys_remove_file(log);
  return r;
}

export fn proc_jobs() -> int64 {
  var n: int64 = s_to_int(s_trim(env_get("MBUILD_JOBS")));
  if (n > 0) {
    return n;
  }
  return 8;
}

fn procx_job(arg: rawptr, i: int64, code: int32) -> bool {
  if (code < 0) {
    var cmds: Cmd** = (Cmd**)arg;
    verbose(cmd_display(cmds[i]));
  }
  return true;
}

// Runs n commands, at most `parallel` at a time, each with stdout and stderr
// going to logs[i] (logs may be 0: then to files under fs_temp_dir()).
// Returns the exit codes, in command order.
export fn proc_run_jobs(cmds: Cmd**, n: int64, logs: StrList*, parallel: int64) -> int32* {
  var paths: StrList* = logs;
  if (logs == 0) {
    var tmp: string = fs_temp_dir();
    paths = sl_new();
    var i: int64 = 0;
    while (i < n) {
      sl_push(paths, tmp + "/job-" + hash_string(sys_cwd() + "{sys_now_ms()}-{i}") + ".log");
      i = i + 1;
    }
  }
  if (parallel < 1) {
    parallel = 1;
  }
  return sys_run_jobs(cmds, n, paths, parallel, (rawptr)cmds, &procx_job);
}
