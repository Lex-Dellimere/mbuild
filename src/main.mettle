// mbuild: the build tool and package manager for Mettle.
//
// Global flags may appear anywhere before `--`; everything after `--` is
// passed through (to the program for `run`, to the compiler for `mettle`).
// A project command (not a built-in) gets everything after its name as is.

import "std/io";
import "std/mem";
import "core/base";
import "model/manifest";
import "model/project";
import "build/build";
import "build/complete";
import "pkg/deps";
import "pkg/search";
import "pkg/info";
import "build/toolchain";
import "config/init";
import "config/config";
import "core/sys_linux" if linux;
import "core/sys_windows" if windows;

fn mx_flag_names() -> StrList* {
  return s_split("--verbose --quiet --color --offline --locked --jobs --target --release --profile --force --mettle --filter --all --tree --help --set --flag --use --no-hooks --major --dry-run --no-verify --test --remove --check --undo --yes --package --allow-breaking --to --registry --name --from --opt --no-services --home --local --no-compiler --readme", 32);
}

fn mx_bad_flag(a: string) {
  var name: string = a;
  var eq: int64 = s_find_byte(a, 61);
  if (eq > 0) {
    name = s_sub(a, 0, eq);
  }
  var sug: string = man_suggest(name, mx_flag_names());
  if (slen(sug) > 0) {
    fail_hint("unknown flag `" + name + "`", "did you mean `" + sug + "`?");
  }
  fail_hint("unknown flag `" + name + "`", "run `mbuild help flags` for the flags");
}

fn mx_set_color(when: string) {
  if (s_eq(when, "always")) {
    g_color = true;
  } else if (s_eq(when, "never")) {
    g_color = false;
  } else if (s_eq(when, "auto")) {
    g_color = sys_isatty(1) && !env_set("NO_COLOR");
  } else {
    fail_hint("--color takes auto, always or never, not `" + when + "`", "--color=never");
  }
}

fn mx_is_color_word(s: string) -> bool {
  return s_eq(s, "always") || s_eq(s, "never") || s_eq(s, "auto");
}

fn mx_add_targets(o: Options*, v: string) {
  var parts: StrList* = s_split(v, 44);
  defer free(parts);
  var i: int64 = 0;
  while (i < parts->len) {
    var t: string = s_trim(sl_get(parts, i));
    if (slen(t) > 0) {
      sl_push(o->targets, t);
    }
    i = i + 1;
  }
}

// Value-less command flags: they go to rest as written.
fn mx_is_cmd_flag(name: string) -> bool {
  var l: StrList* = s_split("--all --tree --major --dry-run --no-verify --test --remove --check --undo --yes --package --allow-breaking --no-services --local --no-compiler --readme", 32);
  var has: bool = sl_has(l, name);
  free(l);
  return has;
}

fn main(argc: int32, argv: cstring*) -> int32 {
  esc_init();
  ini_mbuild_version = build_version_text;
  var mc: string = env_get("MBUILD_COLOR");
  if (s_eq(mc, "always") || s_eq(mc, "never")) {
    mx_set_color(mc);
  } else {
    mx_set_color("auto");
  }
  var args: StrList* = sl_new();
  var ai: int32 = 1;
  while (ai < argc) {
    sl_push(args, s_from_c(argv[ai]));
    ai = ai + 1;
  }
  var o: Options* = options_new();
  var command: string = "";
  var want_help: bool = false;
  var i: int64 = 0;
  while (i < args->len) {
    var a: string = sl_get(args, i);
    i = i + 1;
    if (s_eq(a, "--")) {
      while (i < args->len) {
        sl_push(o->passthrough, sl_get(args, i));
        i = i + 1;
      }
      break;
    }
    if (!s_starts(a, "-") || s_eq(a, "-")) {
      if (slen(command) == 0) {
        command = a;
        if (!build_is_builtin(command)) {
          while (i < args->len) {
            sl_push(o->rest, sl_get(args, i));
            i = i + 1;
          }
        }
      } else {
        sl_push(o->rest, a);
      }
      continue;
    }
    // Flags, with "--name=value" or "--name value" (and "-x value").
    var name: string = a;
    var val: string = "";
    var has_val: bool = false;
    var eq: int64 = s_find_byte(a, 61);
    if (s_starts(a, "--") && eq > 0) {
      name = s_sub(a, 0, eq);
      val = s_from(a, eq + 1);
      has_val = true;
    }
    var takes: bool = cmp_takes_value(name);
    if (takes && !has_val) {
      if (s_eq(name, "--color")) {
        val = "always";
        if (i < args->len && mx_is_color_word(sl_get(args, i))) {
          val = sl_get(args, i);
          i = i + 1;
        }
      } else {
        if (i >= args->len) {
          fail("`" + name + "` needs a value");
        }
        val = sl_get(args, i);
        i = i + 1;
      }
    }
    if (s_eq(name, "-v") || s_eq(name, "--verbose")) {
      o->verbose = true;
      g_verbose = true;
    } else if (s_eq(name, "-q") || s_eq(name, "--quiet")) {
      o->quiet = true;
      g_quiet = true;
    } else if (s_eq(name, "--color")) {
      mx_set_color(val);
    } else if (s_eq(name, "--offline")) {
      o->offline = true;
    } else if (s_eq(name, "--locked")) {
      o->locked = true;
    } else if (s_eq(name, "-j") || s_eq(name, "--jobs")) {
      o->jobs = s_to_int(val);
      if (o->jobs <= 0) {
        fail("-j needs a positive number, not `" + val + "`");
      }
    } else if (s_eq(name, "-t") || s_eq(name, "--target")) {
      mx_add_targets(o, val);
    } else if (s_eq(name, "-r") || s_eq(name, "--release")) {
      o->release = true;
    } else if (s_eq(name, "-p") || s_eq(name, "--profile")) {
      o->profile = val;
    } else if (s_eq(name, "--force")) {
      o->force = true;
    } else if (s_eq(name, "--mettle")) {
      o->mettle = val;
    } else if (s_eq(name, "--filter")) {
      o->filter = val;
    } else if (s_eq(name, "--set")) {
      sl_push(o->sets, val);
    } else if (s_eq(name, "--flag")) {
      sl_push(o->flags, val);
    } else if (s_eq(name, "--use")) {
      sl_push(o->uses, val);
    } else if (s_eq(name, "--no-hooks")) {
      o->no_hooks = true;
    } else if (cmp_cmd_opt(name)) {
      sl_push(o->rest, name + "=" + val);
    } else if (mx_is_cmd_flag(name)) {
      sl_push(o->rest, name);
    } else if (s_eq(name, "-h") || s_eq(name, "--help")) {
      want_help = true;
    } else if (s_eq(name, "-V") || s_eq(name, "--version")) {
      if (slen(command) == 0) {
        command = "version";
      }
    } else {
      mx_bad_flag(a);
    }
  }
  if (o->jobs > 0) {
    sys_setenv("MBUILD_JOBS", s_int(o->jobs));
  }
  if (want_help || s_eq(command, "help")) {
    var topic: string = command;
    if (s_eq(command, "help")) {
      topic = "";
      if (o->rest->len > 0) {
        topic = sl_get(o->rest, 0);
      }
    }
    return build_help(build_find(o), topic);
  }
  if (slen(command) == 0) {
    return build_help(build_find(o), "");
  }
  var rc: int32 = mx_dispatch(command, o);
  exit_with(rc);
  return rc;
}

fn mx_positional_count(o: Options*) -> int64 {
  var n: int64 = 0;
  var i: int64 = 0;
  while (i < o->rest->len) {
    if (!s_starts(sl_get(o->rest, i), "-")) {
      n = n + 1;
    }
    i = i + 1;
  }
  return n;
}

fn mx_dispatch(command: string, o: Options*) -> int32 {
  if (s_eq(command, "tidy")) {
    cfg_quiet_misplaced();
  }
  if (s_eq(command, "version")) {
    var host: string = sys_os();
    if (sys_is_wine()) {
      host = host + ", under wine";
    }
    say("mbuild " + build_version_text + " (" + host + ")");
    return 0;
  }
  if (s_eq(command, "setup")) { return tc_cmd_setup(build_find(o)); }
  // The completion scripts stay clear of first-run setup and its output.
  if (s_eq(command, "completion")) { return build_cmd_completion(o); }
  if (s_eq(command, "__complete")) { return build_complete(build_find(o)); }
  tc_first_run();
  if (!build_is_builtin(command)) {
    return build_cmd_project(build_find(o), command);
  }
  // No project evaluation: a missing pinned toolchain must still install.
  if (s_eq(command, "toolchain")) { return tc_cmd_toolchain(build_find(o)); }
  if (s_eq(command, "init")) { return build_cmd_init(o); }
  if (s_eq(command, "new")) { return build_cmd_new(build_find(o)); }
  if (s_eq(command, "registry")) { return build_cmd_registry(build_find(o)); }
  if (s_eq(command, "yank")) { return build_cmd_yank(build_find(o)); }
  var soft: bool = s_eq(command, "search") || s_eq(command, "info");
  var p: Project* = (Project*)0;
  if (soft) {
    p = build_open_soft(o);
    if (build_registries_skipped(p) && !sl_has(o->rest, ".")) {
      note("no Mettle compiler to read mbuild.mettle with: its registries are skipped (using $MBUILD_REGISTRY or the default)");
    }
  } else {
    p = build_open(o);
  }
  if (s_eq(command, "build")) { return build_cmd_build(p); }
  if (s_eq(command, "run")) { return build_cmd_run(p); }
  if (s_eq(command, "live")) { return build_cmd_live(p); }
  if (s_eq(command, "test")) { return build_cmd_test(p); }
  if (s_eq(command, "check")) { return build_cmd_check(p); }
  if (s_eq(command, "clean")) { return build_cmd_clean(p); }
  if (s_eq(command, "mettle")) { return build_cmd_mettle(p); }
  if (s_eq(command, "trace")) { return build_cmd_trace(p, "trace"); }
  if (s_eq(command, "why")) {
    if (mx_positional_count(o) == 1) {
      return deps_cmd_why(p);
    }
    return build_cmd_trace(p, "why");
  }
  if (s_eq(command, "explain")) { return build_cmd_explain(p); }
  if (s_eq(command, "doctor")) { return build_cmd_doctor(p); }
  if (s_eq(command, "get")) { return build_cmd_get(p); }
  if (s_eq(command, "remove")) { return build_cmd_remove(p); }
  if (s_eq(command, "update")) { return build_cmd_update(p); }
  if (s_eq(command, "tidy")) { return build_cmd_tidy(p); }
  if (s_eq(command, "deps")) { return deps_cmd_list(p); }
  if (s_eq(command, "outdated")) { return deps_cmd_outdated(p); }
  if (s_eq(command, "search")) { return search_cmd(p); }
  if (s_eq(command, "info")) { return info_cmd(p); }
  if (s_eq(command, "vendor")) { return deps_cmd_vendor(p); }
  if (s_eq(command, "profiles")) { return build_cmd_profiles(p); }
  if (s_eq(command, "services")) { return build_cmd_services(p); }
  if (s_eq(command, "fetch")) { return build_cmd_fetch(p); }
  if (s_eq(command, "publish")) { return build_cmd_publish(p); }
  if (s_eq(command, "components")) { return build_cmd_components(p); }
  if (s_eq(command, "use")) { return build_cmd_use(p); }
  if (s_eq(command, "agents")) { return build_cmd_agents(p); }
  return build_help(p, command);
}
