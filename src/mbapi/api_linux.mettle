// mbuild/api_linux: the Linux half of mb_spawn and friends (raw x86-64
// syscalls). api.mettle passes nul-terminated strings and arrays.

// Starts path with argv and envp, output to log (stdin /dev/null); -1 when fork failed.
export fn mbi_sys_spawn(path: cstring, argv: cstring*, envp: cstring*, cmdline: cstring, extra: cstring*, cwd: cstring, log: cstring) -> int64 {
  var devnull: cstring = "/dev/null";
  var none: int64 = 0;
  var pid: int64 = syscall(57);
  if (pid == 0) {
    syscall(14, 2, &none, 0, 8);
    var fd: int64 = syscall(2, log, 577, 420);
    if (fd >= 0) {
      syscall(33, fd, 1);
      syscall(33, fd, 2);
    }
    var nul: int64 = syscall(2, devnull, 0, 0);
    if (nul >= 0) {
      syscall(33, nul, 0);
    }
    if (cwd != (cstring)0 && syscall(80, cwd) != 0) {
      syscall(231, 127);
    }
    syscall(59, path, argv, envp);
    syscall(231, 127);
  }
  if (pid < 0) {
    return -1;
  }
  return pid;
}

// Its exit code once it has exited, else -1.
export fn mbi_sys_poll(pid: int64) -> int32 {
  var st: int32 = 0;
  var r: int64 = syscall(61, pid, &st, 1, 0);
  while (r == -4) {
    r = syscall(61, pid, &st, 1, 0);
  }
  if (r == 0) {
    return -1;
  }
  if (r != pid) {
    return 127;
  }
  if ((st & 127) != 0) {
    return 128 + (st & 127);
  }
  return (st >> 8) & 255;
}

// SIGTERM (kill = false) or SIGKILL.
export fn mbi_sys_signal(pid: int64, kill: bool) {
  if (kill) {
    syscall(62, pid, 9);
  } else {
    syscall(62, pid, 15);
  }
}

export fn mbi_sys_port_open(port: int64) -> bool {
  var fd: int64 = syscall(41, 2, 524289, 0);
  if (fd < 0) {
    return false;
  }
  var a: int64[2];
  a[0] = 0;
  a[1] = 0;
  var b: uint8* = (uint8*)&a[0];
  b[0] = (uint8)2;
  b[2] = (uint8)((port >> 8) & 255);
  b[3] = (uint8)(port & 255);
  b[4] = (uint8)127;
  b[7] = (uint8)1;
  var r: int64 = syscall(42, fd, b, 16);
  syscall(3, fd);
  return r == 0;
}

export fn mbi_sys_sleep_ms(ms: int64) {
  var ts: int64[2];
  ts[0] = ms / 1000;
  ts[1] = (ms % 1000) * 1000000;
  syscall(35, &ts[0], 0);
}

export fn mbi_sys_now_ms() -> int64 {
  var ts: int64[2];
  ts[0] = 0;
  ts[1] = 0;
  syscall(228, 1, &ts[0]);
  return ts[0] * 1000 + ts[1] / 1000000;
}
