// project: the types the build, dependency and native modules share.
//
// build.mettle creates the Options and the Project; deps.mettle answers a
// DepState for it; native.mettle answers a NatLink for one target. Keeping the
// shapes here lets those modules be written and tested apart.

import "std/io";
import "std/mem";
import "base";
import "manifest";

// Command-line options shared by every command.
export struct Options {
  verbose: bool;
  quiet: bool;
  offline: bool;      // never touch the network
  locked: bool;       // fail rather than change mbuild.toml or mbuild.lock
  force: bool;        // ignore every stamp
  release: bool;
  jobs: int64;
  profile: string;    // "debug", "release" or a [profile.X] name
  targets: StrList*;  // "linux" / "windows"; empty = manifest default
  mettle: string;     // --mettle PATH for the host target, "" when absent
  filter: string;     // mbuild test --filter
  rest: StrList*;     // positional arguments after the command
  passthrough: StrList*;  // arguments after "--"
  sets: StrList*;     // --set KEY=VALUE, in order
  flags: StrList*;    // --flag=RAW, in order
}

export struct Project {
  root: string;          // absolute, '/' separators, no trailing slash
  man: Manifest*;        // never 0: a zero-config manifest when the file is absent
  has_manifest: bool;
  opts: Options*;
  state_dir: string;     // root + "/.mbuild"
}

// One selected dependency.
export struct DepModule {
  module: string;     // "github.com/x/y", or the alias key of a local path package
  version: string;    // "v1.2.0", a branch, a commit, or "" for a path package
  commit: string;     // full commit, "" for a path package
  dir: string;        // absolute directory holding its files
  alias: string;      // import alias published in mettle.deps, "" when none
  is_path: bool;      // a local { path = ... } package
  man: Manifest*;     // its mbuild.toml, 0 when it has none
  replaced: string;   // "" | "path" | "version" | "url" ([replace], DESIGN.md 12.5)
  submodules: StrList*;  // submodule paths checked out inside dir
}

export struct DepState {
  mods: DepModule*;
  n: int64;
  include_dir: string;   // absolute ".mbuild/deps", passed to the compiler as -I
}

// One (target, profile) build: where things go and which compiler builds it.
export struct TargetCtx {
  target: string;                // "linux" | "windows"
  profile: string;
  out_dir: string;               // absolute build/<target>/<profile>
  cache_dir: string;             // absolute .mbuild/cache/<target>
  compiler_runtime_dir: string;  // runtime objects of the selected Mettle compiler, "" if unknown
  compiler_stdlib_dir: string;
}

// What the native step contributes to one compile for one target.
export struct NatLink {
  mettle_args: StrList*;  // appended to the compiler argv (-L/-l/--rpath or --link-arg)
  env: StrList*;          // "NAME=value" for the compiler (WINEPATH / PATH additions)
  copy_files: StrList*;   // absolute paths to copy beside the produced binary
  fingerprint: string;    // hash over every native input and output
}

export fn options_new() -> Options* {
  var o: Options* = new Options;
  o->jobs = 0;
  o->profile = "debug";
  o->targets = sl_new();
  o->mettle = s_empty();
  o->filter = s_empty();
  o->rest = sl_new();
  o->passthrough = sl_new();
  o->sets = sl_new();
  o->flags = sl_new();
  return o;
}

export fn depstate_empty(include_dir: string) -> DepState* {
  var d: DepState* = new DepState;
  d->mods = (DepModule*)0;
  d->n = 0;
  d->include_dir = include_dir;
  return d;
}

export fn depstate_add(d: DepState*, m: DepModule) {
  d->mods = (DepModule*)realloc(d->mods, (d->n + 1) * sizeof(DepModule));
  d->mods[d->n] = m;
  d->n = d->n + 1;
}

export fn targetctx_new(p: Project*, target: string, profile: string) -> TargetCtx* {
  var t: TargetCtx* = new TargetCtx;
  t->target = target;
  t->profile = profile;
  t->out_dir = p->root + "/build/" + target + "/" + profile;
  t->cache_dir = p->state_dir + "/cache/" + target;
  t->compiler_runtime_dir = s_empty();
  t->compiler_stdlib_dir = s_empty();
  return t;
}

export fn natlink_empty() -> NatLink* {
  var l: NatLink* = new NatLink;
  l->mettle_args = sl_new();
  l->env = sl_new();
  l->copy_files = sl_new();
  l->fingerprint = s_empty();
  return l;
}

// "linux" -> "", "windows" -> ".exe"
export fn target_exe_ext(target: string) -> string {
  if (s_eq(target, "windows")) {
    return ".exe";
  }
  return s_empty();
}

export fn target_valid(target: string) -> bool {
  return s_eq(target, "linux") || s_eq(target, "windows");
}
