// semver: version parsing, precedence and selection.
//
// Accepted: [v]MAJOR[.MINOR[.PATCH]][-PRE][+BUILD]. Missing components are 0,
// build metadata is ignored, PRE is dot-separated [0-9A-Za-z-] identifiers.

import "base";

export struct SemVer {
  ok: bool;
  major: int64;
  minor: int64;
  patch: int64;
  pre: string;
}

fn svx_bad() -> SemVer {
  var v: SemVer;
  v.ok = false;
  v.major = 0;
  v.minor = 0;
  v.patch = 0;
  v.pre = s_empty();
  return v;
}

fn svx_ident_ok(s: string) -> bool {
  if (slen(s) == 0) {
    return false;
  }
  var i: int64 = 0;
  while (i < slen(s)) {
    var c: int32 = s_byte(s, i);
    if (!(is_alpha_b(c) || is_digit_b(c) || c == 45)) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

fn svx_idents_ok(s: string) -> bool {
  var parts: StrList* = s_split(s, 46);
  defer free(parts);
  var i: int64 = 0;
  while (i < parts->len) {
    if (!svx_ident_ok(sl_get(parts, i))) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

export fn sv_parse(text: string) -> SemVer {
  var s: string = s_trim(text);
  var v: SemVer = svx_bad();
  if (slen(s) > 0 && s_byte(s, 0) == (int32)'v') {
    s = s_from(s, 1);
  }
  var plus: int64 = s_find_byte(s, 43);
  if (plus >= 0) {
    if (!svx_idents_ok(s_from(s, plus + 1))) {
      return v;
    }
    s = s_sub(s, 0, plus);
  }
  var dash: int64 = s_find_byte(s, 45);
  var pre: string = s_empty();
  if (dash >= 0) {
    pre = s_from(s, dash + 1);
    if (!svx_idents_ok(pre)) {
      return v;
    }
    s = s_sub(s, 0, dash);
  }
  var nums: StrList* = s_split(s, 46);
  v = svx_from_nums(nums, pre);
  free(nums);
  return v;
}

fn svx_from_nums(nums: StrList*, pre: string) -> SemVer {
  var v: SemVer = svx_bad();
  if (nums->len < 1 || nums->len > 3) {
    return v;
  }
  var vals: int64[3];
  vals[0] = 0;
  vals[1] = 0;
  vals[2] = 0;
  var i: int64 = 0;
  while (i < nums->len) {
    var n: string = sl_get(nums, i);
    if (!s_is_int(n) || slen(n) > 18) {
      return v;
    }
    vals[i] = s_to_int(n);
    i = i + 1;
  }
  v.ok = true;
  v.major = vals[0];
  v.minor = vals[1];
  v.patch = vals[2];
  v.pre = pre;
  return v;
}

export fn sv_is(s: string) -> bool {
  var v: SemVer = sv_parse(s);
  return v.ok;
}

fn svx_num_cmp(a: int64, b: int64) -> int32 {
  if (a < b) { return -1; }
  if (a > b) { return 1; }
  return 0;
}

fn svx_strip_zeros(s: string) -> string {
  var i: int64 = 0;
  while (i + 1 < slen(s) && s_byte(s, i) == 48) {
    i = i + 1;
  }
  return s_from(s, i);
}

fn svx_ident_cmp(a: string, b: string) -> int32 {
  var an: bool = s_is_int(a);
  var bn: bool = s_is_int(b);
  if (an && bn) {
    var x: string = svx_strip_zeros(a);
    var y: string = svx_strip_zeros(b);
    if (slen(x) != slen(y)) {
      return svx_num_cmp(slen(x), slen(y));
    }
    return svx_sign(s_cmp(x, y));
  }
  if (an) { return -1; }
  if (bn) { return 1; }
  return svx_sign(s_cmp(a, b));
}

fn svx_sign(c: int32) -> int32 {
  if (c < 0) { return -1; }
  if (c > 0) { return 1; }
  return 0;
}

fn svx_pre_cmp(a: string, b: string) -> int32 {
  if (slen(a) == 0 && slen(b) == 0) { return 0; }
  if (slen(a) == 0) { return 1; }
  if (slen(b) == 0) { return -1; }
  var pa: StrList* = s_split(a, 46);
  defer free(pa);
  var pb: StrList* = s_split(b, 46);
  defer free(pb);
  var i: int64 = 0;
  while (i < pa->len && i < pb->len) {
    var c: int32 = svx_ident_cmp(sl_get(pa, i), sl_get(pb, i));
    if (c != 0) {
      return c;
    }
    i = i + 1;
  }
  return svx_num_cmp(pa->len, pb->len);
}

// Precedence of two parsed versions: -1, 0 or 1.
export fn sv_cmp_parsed(a: SemVer, b: SemVer) -> int32 {
  if (a.ok != b.ok) {
    if (a.ok) { return 1; }
    return -1;
  }
  var c: int32 = svx_num_cmp(a.major, b.major);
  if (c == 0) { c = svx_num_cmp(a.minor, b.minor); }
  if (c == 0) { c = svx_num_cmp(a.patch, b.patch); }
  if (c == 0) { c = svx_pre_cmp(a.pre, b.pre); }
  return c;
}

// Semver precedence of two version strings: -1, 0 or 1. Anything that is
// not a version sorts below every version (and lexically among itself).
export fn sv_cmp(a: string, b: string) -> int32 {
  var x: SemVer = sv_parse(a);
  var y: SemVer = sv_parse(b);
  if (!x.ok && !y.ok) {
    return svx_sign(s_cmp(a, b));
  }
  return sv_cmp_parsed(x, y);
}

// The highest stable version in the list, else the highest pre-release, else "".
export fn sv_max(list: StrList*) -> string {
  var best: string = s_empty();
  var best_pre: string = s_empty();
  var i: int64 = 0;
  while (i < list->len) {
    var s: string = sl_get(list, i);
    var v: SemVer = sv_parse(s);
    if (v.ok) {
      if (slen(v.pre) == 0) {
        if (slen(best) == 0 || sv_cmp(s, best) > 0) {
          best = s;
        }
      } else if (slen(best_pre) == 0 || sv_cmp(s, best_pre) > 0) {
        best_pre = s;
      }
    }
    i = i + 1;
  }
  if (slen(best) > 0) {
    return best;
  }
  return best_pre;
}

// The compatibility line: "v1.4.2" -> "v1", "v0.3.1" -> "v0.3" (in v0 a minor
// bump may break), "v2.0.0-rc.1" -> "v2"; "" when not a version.
export fn sv_line(s: string) -> string {
  var v: SemVer = sv_parse(s);
  if (!v.ok) {
    return s_empty();
  }
  if (v.major == 0) {
    return "v0." + s_int(v.minor);
  }
  return "v" + s_int(v.major);
}

// "1.2" -> "v1.2.0", "v1.0.0-rc.1+b5" -> "v1.0.0-rc.1"; "" when not a version.
export fn sv_canonical(s: string) -> string {
  var v: SemVer = sv_parse(s);
  if (!v.ok) {
    return s_empty();
  }
  var out_s: string = "v" + s_int(v.major) + "." + s_int(v.minor) + "." + s_int(v.patch);
  if (slen(v.pre) > 0) {
    out_s = out_s + "-" + v.pre;
  }
  return out_s;
}
