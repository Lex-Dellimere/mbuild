import "mbuild/api";

fn project() {
  mb_package("mbuild", "0.2.0");
  mb_targets("linux, windows");
  mb_bin("mbuild", "src/main.mettle");
  mb_profile("release");
  mb_set("optimize", "full");
}

fn deps() {
}

// install: build a release mbuild for this machine and copy it to --to DIR (default ~/.local/bin)
fn cmd_install(a: MbArgs*) -> int32 {
  var dir: string = mb_opt(a, "--to", mb_home() + "/.local/bin");
  if (mb_mbuild("build -r -t host") != 0) { return 1; }
  mb_mkdirs(dir);
  var dst: string = dir + "/mbuild" + mb_exe_ext();
  if (!mb_copy(mb_out("mbuild", mb_os(), "release"), dst)) { mb_fail("cannot copy to " + dst); }
  mb_say("installed " + dst);
  return 0;
}

// selfcheck: build mbuild and every test driver in debug and --release with zero warnings (tools/mcheck.sh)
fn cmd_selfcheck(a: MbArgs*) -> int32 {
  return mb_sh("sh tools/mcheck.sh src/main.mettle && sh tools/mcheck.sh --all-drivers");
}

// dist: release builds for every target, packed into dist/mbuild-VERSION-OS-x64.tar.gz
fn cmd_dist(a: MbArgs*) -> int32 {
  if (mb_mbuild("build -r -t all") != 0) { return 1; }
  mb_mkdirs("dist");
  var v: string = mb_version();
  var rc: int32 = mb_sh("tar -czf dist/mbuild-" + v + "-linux-x64.tar.gz -C build/linux/release mbuild");
  if (rc != 0) { return rc; }
  return mb_sh("tar -czf dist/mbuild-" + v + "-windows-x64.tar.gz -C build/windows/release mbuild.exe");
}
