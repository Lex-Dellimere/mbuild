import "mbuild/api";

fn project() {
  mb_package("mbuild", "0.2.0");
  mb_targets("linux, windows");
  mb_bin("mbuild", "src/main.mettle");
  mb_profile("release");
  mb_set("optimize", "full");
}

fn deps() {
}

// install: build a release mbuild, copy it to --to DIR (default ~/.local/bin), then run its setup (--home, --from, --no-compiler, --yes)
fn cmd_install(a: MbArgs*) -> int32 {
  var dir: string = mb_opt(a, "--to", mb_home() + "/.local/bin");
  if (mb_mbuild("build -r -t host") != 0) { return 1; }
  mb_mkdirs(dir);
  var dst: string = dir + "/mbuild" + mb_exe_ext();
  if (!mb_copy(mb_out("mbuild", mb_os(), "release"), dst)) { mb_fail("cannot copy to " + dst); }
  mb_say("installed " + dst);
  var c: MbCmd* = mb_cmd(dst);
  mb_cmd_arg(c, "setup");
  var home: string = mb_opt(a, "--home", "");
  if (home != "") { mb_cmd_arg(c, "--home"); mb_cmd_arg(c, home); }
  var from: string = mb_opt(a, "--from", "");
  if (from != "") { mb_cmd_arg(c, "--from"); mb_cmd_arg(c, from); }
  if (mb_flag(a, "--no-compiler")) { mb_cmd_arg(c, "--no-compiler"); }
  if (mb_flag(a, "--yes")) { mb_cmd_arg(c, "--yes"); }
  return mb_cmd_run(c);
}

// selfcheck: build mbuild and every test driver in debug and --release with zero warnings (tools/mcheck.sh)
fn cmd_selfcheck(a: MbArgs*) -> int32 {
  return mb_sh("sh tools/mcheck.sh src/main.mettle && sh tools/mcheck.sh --all-drivers");
}

// dist: release builds for every target, packed into dist/mbuild-VERSION-OS-x64.tar.gz
fn cmd_dist(a: MbArgs*) -> int32 {
  if (mb_mbuild("build -r -t all") != 0) { return 1; }
  mb_mkdirs("dist");
  var v: string = mb_version();
  var rc: int32 = mb_sh("tar -czf dist/mbuild-" + v + "-linux-x64.tar.gz -C build/linux/release mbuild");
  if (rc != 0) { return rc; }
  return mb_sh("tar -czf dist/mbuild-" + v + "-windows-x64.tar.gz -C build/windows/release mbuild.exe");
}

// vendor-alph: copy the alph modules mbuild uses from --from DIR (default ../alph) into third_party/alph, imports made relative
fn cmd_vendor_alph(a: MbArgs*) -> int32 {
  var src: string = mb_opt(a, "--from", "../alph");
  var mods: string = "core/node core/queue core/mailbox core/heap sys/atomic sys/clock sys/recover sys/thread sys/linux sys/fd work/limiter net/port";
  var line: string = "set -e; s=\"" + src + "\"; d=third_party/alph; c=$(git -C \"$s\" rev-parse --short HEAD); rm -rf $d; mkdir -p $d/core $d/sys $d/work $d/net; for f in " + mods + "; do sed -E 's#^import \"alph/([a-z]+/[a-z_]+)\";#import \"../\\1\";#' \"$s/src/$f.mettle\" >$d/$f.mettle; done; cp \"$s/LICENSE\" $d/LICENSE; echo \"alph (https://github.com/Lex-Dellimere/Alph) at $c, Apache-2.0 (LICENSE): the modules mbuild uses, imports made relative. refresh: mbuild vendor-alph --from DIR\" >$d/README";
  return mb_sh(line);
}
