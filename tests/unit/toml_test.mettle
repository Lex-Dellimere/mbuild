// pure_test: table-driven checks of toml, semver, scan and manifest.
//
//   tools/mcheck.sh tests/pure_test.mettle --run
//
// Mettle sources used as scanner input are written with ` for " and $ for
// an opening brace (see src_of)
// so that they stay readable inside string literals.

import "std/io";
import "../../src/core/base";
import "../../src/model/toml";
import "../../src/model/semver";
import "../../src/build/scan";
import "../../src/model/manifest";

var g_pass: int64 = 0;
var g_fail: int64 = 0;

fn t_ok(name: string, ok: bool) {
  if (ok) {
    g_pass = g_pass + 1;
    say("PASS " + name);
  } else {
    g_fail = g_fail + 1;
    say("FAIL " + name);
  }
}

fn t_eq(name: string, got: string, want: string) {
  if (s_eq(got, want)) {
    g_pass = g_pass + 1;
    say("PASS " + name);
  } else {
    g_fail = g_fail + 1;
    say("FAIL " + name);
    say("     got:  [" + got + "]");
    say("     want: [" + want + "]");
  }
}

fn t_int(name: string, got: int64, want: int64) {
  t_eq(name, s_int(got), s_int(want));
}

fn lines_of(l: StrList*) -> string {
  return sl_join(l, "\n");
}

// In scanner sources ` stands for " and $ for an opening brace.
fn src_of(s: string) -> string {
  return s_replace_byte(s_replace_byte(s, 96, 34), 36, 123);
}

// ---------------------------------------------------------------------------
// TOML
// ---------------------------------------------------------------------------

fn manifest_text() -> string {
  var l: StrList* = sl_new();
  sl_push(l, "[package]");
  sl_push(l, "name = \"app\"");
  sl_push(l, "version = \"0.1.0\"");
  sl_push(l, "module = \"github.com/someone/app\"      # optional: this package's import path");
  sl_push(l, "");
  sl_push(l, "[toolchain]");
  sl_push(l, "mettle = \"v0.17.0\"                 # optional pin; downloaded on demand");
  sl_push(l, "");
  sl_push(l, "[build]");
  sl_push(l, "targets = [\"linux\", \"windows\"]     # default for `mbuild build`; default: the host");
  sl_push(l, "flags = [\"--safe\"]                 # every compile");
  sl_push(l, "prelude = false                    # pass --prelude");
  sl_push(l, "");
  sl_push(l, "[profile.debug]                    # default profile");
  sl_push(l, "flags = []");
  sl_push(l, "[profile.release]                  # --release; default flags [\"--release\"]");
  sl_push(l, "flags = [\"--release\"]");
  sl_push(l, "");
  sl_push(l, "[bin.app]                          # optional: auto-detected when absent");
  sl_push(l, "main = \"src/main.mettle\"");
  sl_push(l, "flags = []");
  sl_push(l, "");
  sl_push(l, "[dependencies]");
  sl_push(l, "\"github.com/someone/json\" = \"v1.2.0\"            # minimum version (MVS)");
  sl_push(l, "\"github.com/someone/tool\" = \"latest\"            # pinned in the lock on first use");
  sl_push(l, "\"github.com/someone/edge\" = \"main\"              # branch or commit");
  sl_push(l, "json2 = {{ module = \"github.com/x/json\", version = \"v2.0.1\" }   # alias: import \"json2/...\"");
  sl_push(l, "mylib = {{ path = \"../mylib\" }                    # local package: import \"mylib/...\"");
  sl_push(l, "\"gitlab.com/y/z\" = {{ version = \"v1.0.0\", url = \"https://mirror/z.git\" }");
  sl_push(l, "");
  sl_push(l, "[c]                                 # C compiled into this package's shared library");
  sl_push(l, "sources = [\"csrc\"]                  # files, directories (all .c inside), or dir/*.c");
  sl_push(l, "include = [\"csrc/include\"]");
  sl_push(l, "cflags = [\"-O2\"]");
  sl_push(l, "libs = [\"m\"]                        # what the C code itself links against");
  sl_push(l, "[c.linux]                           # appended on that OS");
  sl_push(l, "[c.windows]");
  sl_push(l, "");
  sl_push(l, "[link]                              # libraries the package's externs bind directly");
  sl_push(l, "libs = [\"raylib\"]                   # linux: -lraylib; windows: raylib.dll");
  sl_push(l, "paths = [\"vendor/lib\"]              # search dirs; libraries found here ship beside the binary");
  sl_push(l, "pkgconfig = [\"raylib\"]              # linux: flags from pkg-config");
  sl_push(l, "[link.linux]");
  sl_push(l, "[link.windows]");
  var text: string = lines_of(l) + "\n";
  free(l);
  return text;
}

fn test_toml_parse() {
  var d: Toml* = toml_parse(manifest_text(), "mbuild.toml");
  t_eq("toml: example parses", d->error, "");
  t_eq("toml: string", toml_str(d, "package", "name"), "app");
  t_eq("toml: string with comment", toml_str(d, "package", "module"), "github.com/someone/app");
  t_eq("toml: absent string", toml_str(d, "package", "nope"), "");
  t_eq("toml: value_str default", toml_value_str(toml_get(d, "package", "nope"), "dflt"), "dflt");
  t_ok("toml: bool", toml_bool(d, "build", "prelude", true) == false);
  t_ok("toml: bool default", toml_bool(d, "build", "absent", true));
  t_eq("toml: list", sl_join(toml_list(d, "build", "targets"), ","), "linux,windows");
  t_int("toml: empty list", toml_list(d, "profile.debug", "flags")->len, 0);
  t_eq("toml: string as list", sl_join(toml_list(d, "package", "name"), ","), "app");
  t_eq("toml: keys in order", sl_join(toml_keys(d, "dependencies"), ","),
       "github.com/someone/json,github.com/someone/tool,github.com/someone/edge,json2,mylib,gitlab.com/y/z");
  t_eq("toml: sections by prefix", sl_join(toml_sections(d, "profile."), ","), "profile.debug,profile.release");
  t_eq("toml: inline field", toml_field(toml_get(d, "dependencies", "json2"), "module"), "github.com/x/json");
  t_eq("toml: inline missing field", toml_field(toml_get(d, "dependencies", "json2"), "path"), "");
  t_eq("toml: field of non-table", toml_field(toml_get(d, "package", "name"), "x"), "");
  t_ok("toml: has empty section", toml_has_section(d, "c.windows"));
  t_ok("toml: lacks section", !toml_has_section(d, "c.macos"));
  t_int("toml: value line", toml_get(d, "dependencies", "mylib")->line, 28);
  t_int("toml: kind array", (int64)toml_get(d, "c", "libs")->kind, 4);
  t_int("toml: kind inline", (int64)toml_get(d, "dependencies", "mylib")->kind, 5);

  var l: StrList* = sl_new();
  defer free(l);
  sl_push(l, "top = 1");
  sl_push(l, "[link]");
  sl_push(l, "linux.libs = [\"X11\"]");
  sl_push(l, "\"quoted key\" = 'C:\\path\\{{x}'");
  sl_push(l, "esc = \"a\\tb\\u0041\\\\\\\"\"");
  sl_push(l, "n = -12_345");
  sl_push(l, "arr = [  # comment");
  sl_push(l, "  \"a\",   # one");
  sl_push(l, "  # whole-line comment");
  sl_push(l, "  'b',");
  sl_push(l, "]");
  sl_push(l, "ints = [1, 2, 3]");
  sl_push(l, "bools = [true,false]");
  sl_push(l, "[dependencies.\"github.com/a/b\"]");
  sl_push(l, "version = \"v1\"");
  sl_push(l, "[ a . \"b.c\" . d ]");
  sl_push(l, "e = {{ x = 1, y = true, z = 'lit', }");
  sl_push(l, "empty = {{}");
  var e: Toml* = toml_parse(lines_of(l), "x.toml");
  t_eq("toml: syntax mix parses", e->error, "");
  t_eq("toml: top-level key", toml_str(e, "", "top"), "1");
  t_eq("toml: dotted key -> sub-section", sl_join(toml_list(e, "link.linux", "libs"), ","), "X11");
  t_ok("toml: dotted key section listed", toml_has_section(e, "link.linux"));
  t_eq("toml: quoted key + literal string", toml_str(e, "link", "quoted key"), "C:\\path\\{{x}");
  t_eq("toml: escapes", toml_str(e, "link", "esc"), "a\tbA\\\"");
  t_eq("toml: integer", toml_str(e, "link", "n"), "-12345");
  t_int("toml: integer kind", (int64)toml_get(e, "link", "n")->kind, 2);
  t_eq("toml: multi-line array", sl_join(toml_list(e, "link", "arr"), ","), "a,b");
  t_int("toml: multi-line array end line", toml_entry(e, "link", "arr")->end_line, 11);
  t_eq("toml: int array", sl_join(toml_list(e, "link", "ints"), ","), "1,2,3");
  t_eq("toml: int array kinds", sl_join(toml_get(e, "link", "ints")->item_kinds, ","), "2,2,2");
  t_eq("toml: bool array", sl_join(toml_list(e, "link", "bools"), ","), "true,false");
  t_eq("toml: quoted header part", toml_str(e, "dependencies.github.com/a/b", "version"), "v1");
  t_eq("toml: spaced dotted header", sl_join(toml_keys(e, "a.b.c.d"), ","), "e,empty");
  t_eq("toml: inline int/bool/lit", toml_field(toml_get(e, "a.b.c.d", "e"), "x") + toml_field(toml_get(e, "a.b.c.d", "e"), "y") + toml_field(toml_get(e, "a.b.c.d", "e"), "z"), "1truelit");
  t_eq("toml: inline field kind", toml_field_kind(toml_get(e, "a.b.c.d", "e"), "y"), "3");
  t_int("toml: empty inline", toml_get(e, "a.b.c.d", "empty")->fields->len, 0);

  var crlf: Toml* = toml_parse("[a]\r\nx = \"1\" # c\r\ny = [\r\n 2,\r\n]\r\n", "c.toml");
  t_eq("toml: CRLF parses", crlf->error + toml_str(crlf, "a", "x") + sl_join(toml_list(crlf, "a", "y"), ","), "12");
}

fn test_toml_errors() {
  var cases: StrList* = sl_new();
  defer free(cases);
  var want: StrList* = sl_new();
  defer free(want);
  sl_push(cases, "[a]\nx = 1\nx = 2\n");
  sl_push(want, "t.toml:3: duplicate key 'x' (first set on line 2)");
  sl_push(cases, "# c\n[[bin]]\nname = \"x\"\n");
  sl_push(want, "t.toml:2: array tables ([[...]]) are not supported");
  sl_push(cases, "a = \"\"\"x\"\"\"\n");
  sl_push(want, "t.toml:1: multi-line strings are not supported");
  sl_push(cases, "a = '''x'''\n");
  sl_push(want, "t.toml:1: multi-line strings are not supported");
  sl_push(cases, "\n\nx = [1,\n2\n");
  sl_push(want, "t.toml:5: unterminated array");
  sl_push(cases, "x = 1.5\n");
  sl_push(want, "t.toml:1: unsupported value '1.5' (expected a string, integer, boolean, array or inline table)");
  sl_push(cases, "[a]\n[b]\n[a]\n");
  sl_push(want, "t.toml:3: duplicate table [a] (first declared on line 1)");
  sl_push(cases, "x = {{ a = 1, a = 2 }\n");
  sl_push(want, "t.toml:1: duplicate key 'a' in inline table");
  sl_push(cases, "x = \"abc\ny = 1\n");
  sl_push(want, "t.toml:1: unterminated string");
  sl_push(cases, "x = 1 y\n");
  sl_push(want, "t.toml:1: expected the end of the line after the value");
  sl_push(cases, "x 1\n");
  sl_push(want, "t.toml:1: expected '=' after the key");
  sl_push(cases, "x =\n");
  sl_push(want, "t.toml:1: expected a value");
  sl_push(cases, "x = [[1]]\n");
  sl_push(want, "t.toml:1: arrays may hold only strings, integers and booleans");
  sl_push(cases, "x = {{ a = 1,\n b = 2 }\n");
  sl_push(want, "t.toml:1: inline tables must close on the same line");
  sl_push(cases, "x = \"a\\qb\"\n");
  sl_push(want, "t.toml:1: invalid escape in string");
  sl_push(cases, "[a\nx = 1\n");
  sl_push(want, "t.toml:1: expected ']' to close the table header");
  sl_push(cases, "[link]\nlinux.libs = []\n[link.linux]\nlibs = []\n");
  sl_push(want, "t.toml:4: duplicate key 'libs' (first set on line 2)");
  sl_push(cases, "x = 2024-01-01\n");
  sl_push(want, "t.toml:1: unsupported value '2024-01-01' (expected a string, integer, boolean, array or inline table)");
  sl_push(cases, "x = tru\n");
  sl_push(want, "t.toml:1: unsupported value 'tru' (expected a string, integer, boolean, array or inline table)");
  var i: int64 = 0;
  while (i < cases->len) {
    var d: Toml* = toml_parse(sl_get(cases, i), "t.toml");
    t_eq("toml error " + s_int(i), d->error, sl_get(want, i));
    i = i + 1;
  }
}

fn test_toml_edit() {
  var l: StrList* = sl_new();
  defer free(l);
  sl_push(l, "# my project");
  sl_push(l, "[package]");
  sl_push(l, "name = \"app\"   # the name");
  sl_push(l, "");
  sl_push(l, "[dependencies]");
  sl_push(l, "\"github.com/a/b\" = \"v1.0.0\" # pinned");
  sl_push(l, "  old = {{ path = \"../old\" }");
  sl_push(l, "");
  sl_push(l, "# trailing comment");
  sl_push(l, "[link]");
  sl_push(l, "linux.libs = [");
  sl_push(l, "  \"X11\",  # keep?");
  sl_push(l, "]");
  sl_push(l, "[empty]");
  var text: string = lines_of(l) + "\n";

  var r1: string = toml_set_in_text(text, "dependencies", "github.com/a/b", toml_quote("v1.2.0"));
  t_eq("edit: replace keeps comment", r1, s_replace(text, "\"v1.0.0\" # pinned", "\"v1.2.0\" # pinned"));

  var r2: string = toml_set_in_text(text, "dependencies", "github.com/c/d", toml_quote("latest"));
  t_eq("edit: insert after last key (indent kept)", r2,
       s_replace(text, "  old = {{ path = \"../old\" }\n", "  old = {{ path = \"../old\" }\n  \"github.com/c/d\" = \"latest\"\n"));
  t_eq("edit: remove inserted round-trips", toml_remove_in_text(r2, "dependencies", "github.com/c/d"), text);

  var r3: string = toml_set_in_text(text, "empty", "k", "1");
  t_eq("edit: insert into empty section", r3, text + "k = 1\n");

  var r4: string = toml_set_in_text(text, "build", "prelude", "true");
  t_eq("edit: append missing section", r4, text + "\n[build]\nprelude = true\n");
  t_eq("edit: appended section parses", toml_str(toml_parse(r4, "r4"), "build", "prelude"), "true");

  var r5: string = toml_set_in_text(text, "link.linux", "paths", "[\"lib\"]");
  t_eq("edit: insert into dotted-key section", r5, s_replace(text, "]\n[empty]", "]\nlinux.paths = [\"lib\"]\n[empty]"));
  t_eq("edit: dotted insert parses", sl_join(toml_list(toml_parse(r5, "r5"), "link.linux", "paths"), ","), "lib");

  var r6: string = toml_remove_in_text(text, "link.linux", "libs");
  t_eq("edit: remove multi-line array", r6, s_replace(text, "linux.libs = [\n  \"X11\",  # keep?\n]\n", ""));

  var r7: string = toml_set_in_text(text, "link.linux", "libs", "[\"Xi\"]");
  t_eq("edit: replace multi-line array", r7, s_replace(text, "[\n  \"X11\",  # keep?\n]", "[\"Xi\"]"));

  var r8: string = toml_remove_in_text(text, "dependencies", "old");
  t_eq("edit: remove indented inline", r8, s_replace(text, "  old = {{ path = \"../old\" }\n", ""));
  t_eq("edit: remove absent", toml_remove_in_text(text, "dependencies", "nope"), text);
  t_eq("edit: unparsable text unchanged", toml_set_in_text("[[x]]\n", "a", "b", "1"), "[[x]]\n");

  var r9: string = toml_set_in_text(text, "", "top", "1");
  t_eq("edit: top-level key goes before the first table", r9, s_replace(text, "# my project\n[package]", "# my project\ntop = 1\n[package]"));

  t_eq("edit: no trailing newline", toml_set_in_text("[a]\nx = 1", "a", "y", "2"), "[a]\nx = 1\ny = 2\n");
  t_eq("edit: header at EOF", toml_set_in_text("[a]", "a", "y", "2"), "[a]\ny = 2\n");
  t_eq("edit: empty text", toml_set_in_text("", "dependencies", "x/y", "\"v1\""), "[dependencies]\n\"x/y\" = \"v1\"\n");
  t_eq("edit: CRLF kept", toml_set_in_text("[a]\r\nx = 1\r\n", "a", "y", "2"), "[a]\r\nx = 1\r\ny = 2\r\n");
  t_eq("edit: quoted section literal", toml_set_in_text("", "bin.my app", "main", "\"m\""), "[bin.\"my app\"]\nmain = \"m\"\n");

  t_eq("quote: escapes", toml_quote("a\"b\\c\nd"), "\"a\\\"b\\\\c\\nd\"");
  t_eq("key literal: bare", toml_key_literal("json-2_x"), "json-2_x");
  t_eq("key literal: quoted", toml_key_literal("github.com/x/y"), "\"github.com/x/y\"");
}

// ---------------------------------------------------------------------------
// semver
// ---------------------------------------------------------------------------

fn test_semver() {
  var v: SemVer = sv_parse("v1.2.3-rc.1+build.5");
  t_ok("sv: full parse", v.ok && v.major == 1 && v.minor == 2 && v.patch == 3 && s_eq(v.pre, "rc.1"));
  v = sv_parse("1.2.3");
  t_ok("sv: no v", v.ok && v.patch == 3 && slen(v.pre) == 0);
  v = sv_parse("v1.2");
  t_ok("sv: two parts", v.ok && v.minor == 2 && v.patch == 0);
  v = sv_parse("v1");
  t_ok("sv: one part", v.ok && v.major == 1 && v.minor == 0);
  var bad: StrList* = s_split("main,latest,,v,v1.2.3.4,1.x,v1.-2,1.0.0-,1.0.0+,1.0.0-a..b,abcdef0,v1.2.3-a_b", 44);
  defer free(bad);
  var i: int64 = 0;
  while (i < bad->len) {
    t_ok("sv: rejects '" + sl_get(bad, i) + "'", !sv_is(sl_get(bad, i)));
    i = i + 1;
  }
  var order: StrList* = s_split("0.0.1,0.1.0,1.0.0-0,1.0.0-2,1.0.0-10,1.0.0-alpha,1.0.0-alpha.1,1.0.0-alpha.beta,1.0.0-beta,1.0.0-beta.2,1.0.0-beta.11,1.0.0-rc.1,1.0.0,1.0.1,1.1.0,1.10.0,2.0.0,10.0.0", 44);
  defer free(order);
  i = 0;
  while (i + 1 < order->len) {
    var a: string = sl_get(order, i);
    var b: string = sl_get(order, i + 1);
    t_ok("sv: " + a + " < " + b, sv_cmp(a, b) < 0 && sv_cmp(b, a) > 0);
    i = i + 1;
  }
  t_ok("sv: equal ignoring v and build", sv_cmp("v1.2.0+abc", "1.2") == 0);
  t_ok("sv: invalid below valid", sv_cmp("main", "v0.0.1") < 0);
  t_eq("sv: max stable", sv_max(s_split("v1.0.0,v2.0.0-rc.1,v1.10.0,main,v1.9.9", 44)), "v1.10.0");
  t_eq("sv: max pre-release only", sv_max(s_split("v2.0.0-rc.1,v2.0.0-rc.2,junk", 44)), "v2.0.0-rc.2");
  t_eq("sv: max none", sv_max(s_split("main,dev", 44)), "");
  t_eq("sv: max empty", sv_max(sl_new()), "");
  t_eq("sv: canonical 1.2", sv_canonical("1.2"), "v1.2.0");
  t_eq("sv: canonical pre", sv_canonical("v1.0.0-rc.1+b5"), "v1.0.0-rc.1");
  t_eq("sv: canonical bad", sv_canonical("main"), "");

  var lin: StrList* = s_split("v1.4.2=v1,v0.3.1=v0.3,v2.0.0-rc.1=v2,1.2=v1,v0.0.4=v0.0,main=,v10.1.0+b=v10,=", 44);
  defer free(lin);
  i = 0;
  while (i < lin->len) {
    var pair: StrList* = s_split(sl_get(lin, i), 61);
    t_eq("sv: line of '" + sl_get(pair, 0) + "'", sv_line(sl_get(pair, 0)), sl_get(pair, 1));
    free(pair);
    i = i + 1;
  }
}

// ---------------------------------------------------------------------------
// scan
// ---------------------------------------------------------------------------

fn imports_of(r: ScanResult*) -> string {
  var l: StrList* = sl_new();
  var i: int64 = 0;
  while (i < r->nimports) {
    var ir: ImportRef* = scan_import(r, i);
    var g: string = ir->guard;
    if (slen(g) > 0) {
      g = " if " + g;
    }
    sl_push(l, ir->path + g + " @" + s_int(ir->line));
    i = i + 1;
  }
  var joined: string = sl_join(l, "; ");
  free(l);
  return joined;
}

fn externs_of(r: ScanResult*) -> string {
  var l: StrList* = sl_new();
  var i: int64 = 0;
  while (i < r->externs->len) {
    sl_push(l, sl_get(r->extern_names, i) + "=" + sl_get(r->externs, i) + " @" + sl_get(r->extern_lines, i));
    i = i + 1;
  }
  var joined: string = sl_join(l, "; ");
  free(l);
  return joined;
}

fn test_scan_imports() {
  var l: StrList* = sl_new();
  defer free(l);
  sl_push(l, "import `std/io`;");
  sl_push(l, "import `lib/a` as a;");
  sl_push(l, "import $ x, y } from `lib/b` if linux;");
  sl_push(l, "import `sys_windows` if windows;");
  sl_push(l, "// import `no/comment`;");
  sl_push(l, "/* import `no/block` /* nested */ import `no/block2` */ import `after/block`;");
  sl_push(l, "var s: string = `import \\`no/str\\``;");
  sl_push(l, "/* multi");
  sl_push(l, "   line */");
  sl_push(l, "import `posix_only` if posix;");
  sl_push(l, "import `mac` if macos");
  sl_push(l, "var page: string = import_str `data/page.html`;");
  sl_push(l, "import `github.com/x/y/z`;");
  var r: ScanResult* = scan_source(src_of(lines_of(l)));
  defer free(r);
  t_eq("scan: imports", imports_of(r),
       "std/io @1; lib/a @2; lib/b if linux @3; sys_windows if windows @4; after/block @6; posix_only if posix @10; mac if macos @11; github.com/x/y/z @13");
  t_eq("scan: embeds", sl_join(r->embeds, ",") + " @" + sl_join(r->embed_lines, ","), "data/page.html @12");
  t_ok("scan: no main, no tests", !r->has_main && !r->has_tests);
}

fn test_scan_strings() {
  var l: StrList* = sl_new();
  defer free(l);
  sl_push(l, "var a: string = `$f(`import \\`x\\``)} $$ import `;");
  sl_push(l, "import `one`;");
  sl_push(l, "var b: string = `$g(`}`)} import \\`z\\``; import `two`;");
  sl_push(l, "var c: string = `$m[$1}]} $ $k: `}`}.k } $$`; import `three`;");
  sl_push(l, "var d: char = '`'; import `four`; var e: char = '\\''; import `five`;");
  sl_push(l, "var f: char = '$'; import `six`;");
  sl_push(l, "var g: string = `a\\\\`; import `seven`;");
  sl_push(l, "var h: string = `line1");
  sl_push(l, "line2 import `no`");
  sl_push(l, "`; import `eight`;");
  var r: ScanResult* = scan_source(src_of(lines_of(l)));
  defer free(r);
  t_eq("scan: interpolation, chars, escapes", imports_of(r),
       "one @2; two @3; three @4; four @5; five @5; six @6; seven @7; eight @10");

  var fb: ScanResult* = scan_source(src_of("var s: string = `$ `; import `fallback`;\n"));
  defer free(fb);
  t_eq("scan: unterminated interpolation falls back", imports_of(fb), "fallback @1");
}

fn test_scan_asm_externs() {
  var l: StrList* = sl_new();
  defer free(l);
  sl_push(l, "extern fn puts(msg: cstring) -> int32;");
  sl_push(l, "extern fn c_strlen(s: cstring) -> int64 = `strlen`;");
  sl_push(l, "export extern fn rand() -> int32 = `rand`;");
  sl_push(l, "extern fn Win_BitBlt(");
  sl_push(l, "  a: int64,");
  sl_push(l, "  b: int32) -> int32 = `BitBlt`;");
  sl_push(l, "extern fn eff() -> int32 with Render");
  sl_push(l, "  = `eff_sym`;");
  sl_push(l, "extern var g_counter: int32;");
  sl_push(l, "extern var g_flag: int32 = `c_side_flag`;");
  sl_push(l, "extern kernel(block = 256) vadd(a: float32*, n: int32);");
  sl_push(l, "extern fn nolink(a: int32)");
  sl_push(l, "fn after() -> int32 $");
  sl_push(l, "  asm $ mov rax, 1 ; import `no` extern fn x() = `no`");
  sl_push(l, "    `}` '$' /* } */ }");
  sl_push(l, "  extern fn inner(x: fn(int32) -> int32) -> int32 = `inner_sym`;");
  sl_push(l, "  var s: string = `= \\`not\\``;");
  sl_push(l, "  return 0;");
  sl_push(l, "}");
  sl_push(l, "import `after_asm`;");
  sl_push(l, "extern fn arr(p: int32[4]) -> int32");
  sl_push(l, "var q: string = `x`;");
  var r: ScanResult* = scan_source(src_of(lines_of(l)));
  defer free(r);
  t_eq("scan: externs", externs_of(r),
       "puts=puts @1; c_strlen=strlen @2; rand=rand @3; Win_BitBlt=BitBlt @4; eff=eff_sym @7; g_counter=g_counter @9; g_flag=c_side_flag @10; nolink=nolink @12; inner=inner_sym @16; arr=arr @21");
  t_eq("scan: import after asm", imports_of(r), "after_asm @20");
}

fn scan_tests_of(src: string) -> bool {
  var r: ScanResult* = scan_source(src_of(src));
  var has: bool = r->has_tests;
  free(r);
  return has;
}

fn test_scan_main_tests() {
  var l: StrList* = sl_new();
  defer free(l);
  sl_push(l, "struct S $ x: int32; }");
  sl_push(l, "impl S $");
  sl_push(l, "  fn main() -> int32 $ return 0; }");
  sl_push(l, "}");
  sl_push(l, "// fn main() and @test");
  sl_push(l, "var s: string = `fn main @test`;");
  var r: ScanResult* = scan_source(src_of(lines_of(l)));
  defer free(r);
  t_ok("scan: nested fn main not counted", !r->has_main);
  t_ok("scan: @test in comment/string not counted", !r->has_tests);
  sl_push(l, "@test fn t1() -> int32 $ return 0; }");
  sl_push(l, "export fn main() -> int32 $ return 0; }");
  var r2: ScanResult* = scan_source(src_of(lines_of(l)));
  defer free(r2);
  t_ok("scan: top-level fn main", r2->has_main);
  t_ok("scan: @test", r2->has_tests);

  t_ok("scan: @test fn on one line", scan_tests_of("@test fn t() $ }"));
  t_ok("scan: @test export fn", scan_tests_of("@test export fn t() $ }"));
  t_ok("scan: @test then fn on the next line not counted", !scan_tests_of("@test\nfn t() $ }"));
  t_ok("scan: @test @pure then fn on the next line not counted", !scan_tests_of("@test @pure\nfn t() $ }"));
  t_ok("scan: @test /* c */ fn", scan_tests_of("@test /* c */ fn t() $ }"));
  t_ok("scan: @pure @test fn", scan_tests_of("@pure @test fn t() $ }"));
  t_ok("scan: @test @inline! fn", scan_tests_of("@test @inline! fn t() $ }"));
  t_ok("scan: @test before struct not counted", !scan_tests_of("@test struct S $ x: int32; }"));
  t_ok("scan: @test before extern not counted", !scan_tests_of("@test extern fn f() -> int32;"));
  t_ok("scan: export @test not counted", !scan_tests_of("export @test fn t() $ }"));
  t_ok("scan: @test @rule not counted", !scan_tests_of("@test @rule fn t() $ }"));
  t_ok("scan: @unroll(2) @test not counted", !scan_tests_of("@unroll(2) @test fn t() $ }"));
  t_ok("scan: @test @test not counted", !scan_tests_of("@test @test fn t() $ }"));
  t_ok("scan: unknown decorator not counted", !scan_tests_of("@bogus @test fn t() $ }"));
  t_ok("scan: @test inside a body not counted", !scan_tests_of("fn f() $ @test fn t() $ } }"));

  t_ok("guard: none", scan_guard_active("", "windows"));
  t_ok("guard: linux on linux", scan_guard_active("linux", "linux"));
  t_ok("guard: posix on linux", scan_guard_active("posix", "linux"));
  t_ok("guard: posix not on windows", !scan_guard_active("posix", "windows"));
  t_ok("guard: windows", scan_guard_active("windows", "windows") && !scan_guard_active("windows", "linux"));
  t_ok("guard: macos never", !scan_guard_active("macos", "linux") && !scan_guard_active("macos", "windows"));
}

fn exports_of(src: string) -> string {
  var l: ExportList* = scan_exports(src_of(src));
  var out_l: StrList* = sl_new();
  var i: int64 = 0;
  while (i < l->n) {
    var it: ExportItem* = scan_export(l, i);
    sl_push(out_l, it->kind + " " + it->name + "|" + it->sig + " @" + s_int(it->line));
    i = i + 1;
  }
  var joined: string = sl_join(out_l, "\n");
  free(out_l);
  free(l);
  return joined;
}

fn test_scan_exports() {
  var a: StrList* = sl_new();
  defer free(a);
  sl_push(a, "export struct AlPair $ a: int32; b: int32; }");
  sl_push(a, "export fn al_add(a: int32, b: int32, c: int32) -> int32 $ return a + b + c; }");
  sl_push(a, "export fn al_sub(a: int32, b: int32) -> int32 $ return a - b; }");
  var l: ExportList* = scan_exports(src_of(lines_of(a)));
  defer free(l);
  t_int("exports: apilib v1.2.0 count", l->n, 3);
  t_eq("exports: struct AlPair", scan_export(l, 0)->kind + " " + scan_export(l, 0)->name + "|" + scan_export(l, 0)->sig, "struct AlPair|a: int32; b: int32");
  t_eq("exports: al_add sig", scan_export(l, 1)->name + scan_export(l, 1)->sig, "al_add(a: int32, b: int32, c: int32) -> int32");
  t_int("exports: al_sub line", scan_export(l, 2)->line, 3);

  var b: StrList* = sl_new();
  defer free(b);
  sl_push(b, "import `std/io`;");
  sl_push(b, "export fn f() -> string $ return `}}} $$ export fn no_str() $`; }");
  sl_push(b, "// export fn no_line() $ }");
  sl_push(b, "/* } export fn no_block() $ } */");
  sl_push(b, "fn private_fn() -> int32 $ return 0; }");
  sl_push(b, "fn g() $ export fn no_nested() $ } }");
  sl_push(b, "export var g_x: int32 = 5;");
  sl_push(b, "export const K = 3;");
  sl_push(b, "export extern fn c_val(a: int32) -> int32 = `c_val_sym`;");
  sl_push(b, "export enum Color $ Red = 1, Green, Blue = 4 }");
  sl_push(b, "export struct Gen $");
  sl_push(b, "  a: fn(int32, int32) -> int32;   // c $");
  sl_push(b, "  b: string;");
  sl_push(b, "}");
  sl_push(b, "export fn multi(");
  sl_push(b, "  a: int64,   // first");
  sl_push(b, "  b: int32)   ->   int32 $ return 0; }");
  sl_push(b, "@inline export fn deco() $ }");
  sl_push(b, "export extern var g_c: int32;");
  sl_push(b, "export enum Option<T> $ Some(T), None }");
  var want: StrList* = sl_new();
  defer free(want);
  sl_push(want, "fn f|() -> string @2");
  sl_push(want, "var g_x|int32 @7");
  sl_push(want, "const K| @8");
  sl_push(want, "extern c_val|(a: int32) -> int32 = `c_val_sym` @9");
  sl_push(want, "enum Color|Red = 1, Green, Blue = 4 @10");
  sl_push(want, "struct Gen|a: fn(int32, int32) -> int32; b: string @11");
  sl_push(want, "fn multi|(a: int64, b: int32) -> int32 @15");
  sl_push(want, "fn deco|() @18");
  sl_push(want, "extern g_c|: int32 @19");
  sl_push(want, "enum Option|<T> Some(T), None @20");
  t_eq("exports: kinds, strings, comments, nesting", exports_of(lines_of(b)), src_of(sl_join(want, "\n")));

  var names: StrList* = s_split("al_mul,al_add,al_sub", 44);
  defer free(names);
  t_eq("uses: outside strings and comments", sl_join(scan_uses("var x = al_mul(1,2); // al_add\n\"al_sub\"", names), ","), "al_mul 1");
  t_eq("uses: lines, once per line", sl_join(scan_uses(src_of("al_add(al_add(1, 2), 3);\n/* al_sub\n */ x = al_sub;\ny = `$al_mul(1)}`;\nal_mul"), names), ","), "al_add 1,al_sub 3,al_mul 5");
}

// ---------------------------------------------------------------------------
// manifest
// ---------------------------------------------------------------------------

fn man_of(text: string) -> Manifest* {
  return man_parse(toml_parse(text, "/p/mbuild.toml"), "/p");
}

fn dep_text(d: DepSpec*) -> string {
  return d->key + "|" + d->module + "|" + d->version + "|" + d->path + "|" + d->url + "|" + s_int(d->line);
}

fn test_manifest() {
  var m: Manifest* = man_of(manifest_text());
  t_eq("man: example valid", m->error, "");
  t_eq("man: no warnings", sl_join(m->warnings, " / "), "");
  t_eq("man: file", m->file, "/p/mbuild.toml");
  t_eq("man: package", m->name + " " + m->version + " " + m->module, "app 0.1.0 github.com/someone/app");
  t_eq("man: toolchain", m->toolchain, "v0.17.0");
  t_eq("man: targets/flags", sl_join(m->targets, ",") + " " + sl_join(m->flags, ","), "linux,windows --safe");
  t_ok("man: prelude", !m->prelude);
  t_int("man: bins", m->nbins, 1);
  t_eq("man: bin", man_bin(m, 0)->name + " " + man_bin(m, 0)->main, "app src/main.mettle");
  t_int("man: deps", m->ndeps, 6);
  t_eq("man: dep 0", dep_text(man_dep(m, 0)), "github.com/someone/json|github.com/someone/json|v1.2.0|||24");
  t_eq("man: dep 2", dep_text(man_dep(m, 2)), "github.com/someone/edge|github.com/someone/edge|main|||26");
  t_eq("man: alias dep", dep_text(man_dep(m, 3)), "json2|github.com/x/json|v2.0.1|||27");
  t_eq("man: path dep", dep_text(man_dep(m, 4)), "mylib|||../mylib||28");
  t_eq("man: url dep", dep_text(man_dep(m, 5)), "gitlab.com/y/z|gitlab.com/y/z|v1.0.0||https://mirror/z.git|29");
  t_eq("man: dep find by module", man_dep_find(m, "github.com/x/json")->key, "json2");
  t_eq("man: dep find by key", man_dep_find(m, "mylib")->path, "../mylib");
  t_ok("man: dep find absent", man_dep_find(m, "nope") == (DepSpec*)0);
  t_eq("man: profile debug", sl_join(man_profile_flags(m, "debug"), ","), "");
  t_eq("man: profile release", sl_join(man_profile_flags(m, "release"), ","), "--release");
  t_ok("man: has profiles", man_has_profile(m, "debug") && man_has_profile(m, "release") && !man_has_profile(m, "fast"));
  t_eq("man: os list", sl_join(man_os_list(m, "link.libs", "linux"), ","), "raylib");
  t_ok("man: has c", man_has_c(m));

  var d: Manifest* = man_of("[package]\nname = \"x\"\n[profile.fast]\nflags = [\"-O3\"]\ncflags = [\"-O2\", \"-DFAST\"]\n[link]\nlibs = [\"a\"]\nlinux.libs = [\"b\"]\n[link.windows]\nlibs = [\"w\"]\n");
  t_eq("man: defaults valid", d->error, "");
  t_eq("man: default release flags", sl_join(man_profile_flags(d, "release"), ","), "--release");
  t_eq("man: custom profile", sl_join(man_profile_flags(d, "fast"), ","), "-O3");
  t_ok("man: custom profile exists", man_has_profile(d, "fast"));
  t_eq("man: profile cflags", sl_join(man_profile_cflags(d, "fast"), ","), "-O2,-DFAST");
  t_eq("man: profile cflags absent", sl_join(man_profile_cflags(d, "release"), ","), "");
  t_eq("man: profile cflags unknown profile", sl_join(man_profile_cflags(d, "nope"), ","), "");
  t_eq("man: profile no warnings for cflags", sl_join(d->warnings, "|"), "");
  t_eq("man: os list linux", sl_join(man_os_list(d, "link.libs", "linux"), ","), "a,b");
  t_eq("man: os list windows", sl_join(man_os_list(d, "link.libs", "windows"), ","), "a,w");
  t_ok("man: no c", !man_has_c(d));
  t_int("man: no bins", d->nbins, 0);

  var v: Manifest* = man_of("[package]\nname = \"x\"\n[dependencies]\n\"github.com/a/b\" = {{ url = \"u\" }\n[dependencies.local]\npath = \"../l\"\n[dependencies.\"github.com/c/d\"]\nversion = \"v2.0.0\"\n");
  t_eq("man: table deps valid", v->error, "");
  t_eq("man: version defaults to latest", dep_text(man_dep(v, 0)), "github.com/a/b|github.com/a/b|latest||u|4");
  t_eq("man: [dependencies.local]", dep_text(man_dep(v, 1)), "local|||../l||5");
  t_eq("man: [dependencies.\"m\"]", dep_text(man_dep(v, 2)), "github.com/c/d|github.com/c/d|v2.0.0|||7");

  var cases: StrList* = sl_new();
  defer free(cases);
  var want: StrList* = sl_new();
  defer free(want);
  sl_push(cases, "[package]\nversion = \"1.0.0\"\n");
  sl_push(want, "/p/mbuild.toml:1: [package] name is required");
  sl_push(cases, "[package]\nname = 5\n");
  sl_push(want, "/p/mbuild.toml:2: [package] name must be a string, not an integer");
  sl_push(cases, "[package]\nname = \"a b\"\n");
  sl_push(want, "/p/mbuild.toml:2: package name 'a b' may only hold letters, digits, '_', '-' and '.'");
  sl_push(cases, "[package]\nname = \"x\"\n[build]\ntargets = [\"linux\", 3]\n");
  sl_push(want, "/p/mbuild.toml:4: [build] targets must be an array of strings");
  sl_push(cases, "[package]\nname = \"x\"\n[build]\ntargets = [\"macos\"]\n");
  sl_push(want, "/p/mbuild.toml:4: unknown target 'macos' (expected \"linux\" or \"windows\")");
  sl_push(cases, "[package]\nname = \"x\"\n[build]\nprelude = \"yes\"\n");
  sl_push(want, "/p/mbuild.toml:4: [build] prelude must be true or false, not a string");
  sl_push(cases, "[package]\nname = \"x\"\n[dependencies]\njson2 = \"v1.0.0\"\n");
  sl_push(want, "/p/mbuild.toml:4: dependency 'json2' needs a module or a path, e.g. json2 = {{ module = \"host/owner/repo\", version = \"v1.0.0\" }");
  sl_push(cases, "[package]\nname = \"x\"\n[dependencies]\njson2 = {{ version = \"v1.0.0\" }\n");
  sl_push(want, "/p/mbuild.toml:4: dependency 'json2' needs a module or a path, e.g. json2 = {{ module = \"host/owner/repo\", version = \"v1.0.0\" }");
  sl_push(cases, "[package]\nname = \"x\"\n[dependencies]\nl = {{ path = \"../l\", version = \"v1.0.0\" }\n");
  sl_push(want, "/p/mbuild.toml:4: dependency 'l' has both a path and a version");
  sl_push(cases, "[package]\nname = \"x\"\n[dependencies]\nl = {{ module = \"github.com/a/b\", version = 1 }\n");
  sl_push(want, "/p/mbuild.toml:4: dependency 'l': version must be a string");
  sl_push(cases, "[package]\nname = \"x\"\n[dependencies]\n\"github.com/a/b\" = true\n");
  sl_push(want, "/p/mbuild.toml:4: dependency 'github.com/a/b' must be a version string or an inline table, not a boolean");
  sl_push(cases, "[package]\nname = \"x\"\n[dependencies]\nj = {{ module = \"json\" }\n");
  sl_push(want, "/p/mbuild.toml:4: dependency 'j': module 'json' is not a module path (expected host/owner/repo)");
  sl_push(cases, "[package]\nname = \"x\"\n[dependencies]\n\"github.com/a/b\" = \"v1\"\nb = {{ module = \"github.com/a/b\" }\n");
  sl_push(want, "/p/mbuild.toml:5: module 'github.com/a/b' is required twice");
  sl_push(cases, "[package]\nname = \"x\"\n[bin.tool]\nflags = 3\n");
  sl_push(want, "/p/mbuild.toml:4: [bin.tool] flags must be an array of strings, not an integer");
  sl_push(cases, "[package]\nname = \"x\"\n[c]\nsources = \"csrc\"\ncflags = [1]\n");
  sl_push(want, "/p/mbuild.toml:5: [c] cflags must be an array of strings");
  sl_push(cases, "[package]\nname = \"x\"\n[profile.fast]\ncflags = 3\n");
  sl_push(want, "/p/mbuild.toml:4: [profile.fast] cflags must be an array of strings, not an integer");
  sl_push(cases, "[package]\nname = \"x\"\nname = \"y\"\n");
  sl_push(want, "/p/mbuild.toml:3: duplicate key 'name' (first set on line 2)");
  var i: int64 = 0;
  while (i < cases->len) {
    var e: Manifest* = man_of(sl_get(cases, i));
    t_eq("man error " + s_int(i), e->error, sl_get(want, i));
    i = i + 1;
  }

  var w: Manifest* = man_of("[package]\nname = \"x\"\nnmae = \"y\"\n[buidl]\nflags = []\n[profiles.release]\n[bin]\nmain = \"m\"\n[c.macos]\n[zzz]\n[link]\nlib = []\n[dependencies]\nk = {{ path = \"p\", verison = \"v1\" }\n");
  t_eq("man: warnings valid", w->error, "");
  var ww: StrList* = sl_new();
  defer free(ww);
  sl_push(ww, "/p/mbuild.toml:14: unknown field 'verison' in dependency 'k' (did you mean 'version'?)");
  sl_push(ww, "/p/mbuild.toml:3: unknown key 'nmae' in [package] (did you mean 'name'?)");
  sl_push(ww, "/p/mbuild.toml:4: unknown section [buidl] (did you mean [build]?)");
  sl_push(ww, "/p/mbuild.toml:6: unknown section [profiles.release] (did you mean [profile.release]?)");
  sl_push(ww, "/p/mbuild.toml:7: unknown section [bin] (did you mean [bin.NAME]?)");
  sl_push(ww, "/p/mbuild.toml:9: unknown section [c.macos]");
  sl_push(ww, "/p/mbuild.toml:10: unknown section [zzz]");
  sl_push(ww, "/p/mbuild.toml:12: unknown key 'lib' in [link] (did you mean 'libs'?)");
  t_eq("man: warnings", sl_join(w->warnings, "\n"), sl_join(ww, "\n"));

  var z: Manifest* = man_empty("/q", "q");
  defer free(z);
  t_eq("man: empty", z->name + " " + z->file + " " + z->error, "q /q/mbuild.toml ");

  t_ok("man: remote module", man_is_remote_module("github.com/a/b") && man_is_remote_module("example.org/x"));
  t_ok("man: not remote", !man_is_remote_module("json2/x") && !man_is_remote_module("std/io") && !man_is_remote_module("a/b.c"));
  t_eq("man: module of import", man_module_of_import("github.com/a/b/sub/file"), "github.com/a/b");
  t_eq("man: module of import exact", man_module_of_import("github.com/a/b"), "github.com/a/b");
  t_eq("man: module of short import", man_module_of_import("github.com/a"), "");
  t_eq("man: module of local import", man_module_of_import("lib/x"), "");
  t_int("lev: kitten/sitting", man_edit_distance("kitten", "sitting"), 3);
  t_int("lev: empty", man_edit_distance("", "abc"), 3);
}

fn main() -> int32 {
  test_toml_parse();
  test_toml_errors();
  test_toml_edit();
  test_semver();
  test_scan_imports();
  test_scan_strings();
  test_scan_asm_externs();
  test_scan_main_tests();
  test_scan_exports();
  test_manifest();
  say("");
  say("pure_test: " + s_int(g_pass) + " passed, " + s_int(g_fail) + " failed");
  flush_out();
  if (g_fail > 0) {
    return 1;
  }
  return 0;
}
