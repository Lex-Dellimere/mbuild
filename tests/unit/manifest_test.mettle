// manifest_test: the manifest mbuild.mettle emits: typed build settings, [replace],
// [package] mettle, mbuild.local.mettle, components, registries (DESIGN.md 11.7, 6.1).
//
//   mettle test tests/unit/manifest_test.mettle     (leak warnings are expected)
//   tools/mcheck.sh tests/unit/manifest_test.mettle --run
//
// Run both: `mettle test` reports a failing run as skipped (reports issue 10).

import "std/io";
import "../../src/core/base";
import "../../src/model/toml";
import "../../src/model/manifest";

var g_pass: int64 = 0;
var g_fail: int64 = 0;

fn t_ok(name: string, ok: bool) {
  if (ok) {
    g_pass = g_pass + 1;
    say("PASS " + name);
  } else {
    g_fail = g_fail + 1;
    say("FAIL " + name);
  }
}

fn t_eq(name: string, got: string, want: string) {
  if (s_eq(got, want)) {
    g_pass = g_pass + 1;
    say("PASS " + name);
  } else {
    g_fail = g_fail + 1;
    say("FAIL " + name);
    say("     got:  [" + got + "]");
    say("     want: [" + want + "]");
  }
}

fn t_has(name: string, got: string, part: string) {
  if (s_contains(got, part)) {
    g_pass = g_pass + 1;
    say("PASS " + name);
  } else {
    g_fail = g_fail + 1;
    say("FAIL " + name);
    say("     got:  [" + got + "]");
    say("     want: ...[" + part + "]...");
  }
}

var g_kept: Settings* = (Settings*)0;

// Test settings are kept (a short-lived program; this also satisfies the memory analyser).
fn keep(s: Settings*) {
  g_kept = s;
}

fn man_of(text: string) -> Manifest* {
  return man_parse(toml_parse(text, "/p/mbuild.toml"), "/p");
}

fn pkg(rest: string) -> string {
  return "[package]\nname = \"x\"\n" + rest;
}

fn query(profile: string, bin: string, target: string, sets: StrList*) -> SettingsQuery* {
  var q: SettingsQuery* = new SettingsQuery;
  q->profile = profile;
  q->bin = bin;
  q->target = target;
  q->sets = sets;
  return q;
}

// The flags of a profile (no bin, linux), joined by ",", or "ERR: ..." on an error.
fn flags_of(m: Manifest*, profile: string) -> string {
  var s: Settings* = man_settings(m, query(profile, "", "linux", (StrList*)0));
  keep(s);
  if (slen(s->error) > 0) {
    return "ERR: " + s->error;
  }
  return sl_join(man_settings_flags(s, "linux"), ",");
}

fn test_settings() {
  var e: Manifest* = man_of(pkg(""));
  t_eq("empty: valid", e->error, "");
  t_eq("empty: debug", flags_of(e, "debug"), "-s");
  t_eq("empty: release", flags_of(e, "release"), "--release");
  t_eq("empty: profile names", sl_join(man_profile_names(e), ","), "debug,release");
  t_ok("empty: has debug, not fast", man_has_profile(e, "debug") && !man_has_profile(e, "fast"));
  t_eq("empty: unknown profile", flags_of(e, "relase"), "ERR: unknown profile 'relase' (did you mean 'release'?)");
  t_eq("compat: man_profile_flags debug", sl_join(man_profile_flags(e, "debug"), ","), "");
  t_eq("compat: man_profile_flags release", sl_join(man_profile_flags(e, "release"), ","), "--release");

  var r: Manifest* = man_of(pkg("[profile.release]\nflags = [\"--safe\"]\n"));
  t_eq("release flags: valid", r->error, "");
  t_eq("release flags --safe", flags_of(r, "release"), "--release,--safe");

  var rr: Manifest* = man_of(pkg("[profile.release]\nflags = [\"--release\"]\n"));
  t_eq("release flags --release: no parse warning", sl_join(rr->warnings, "|"), "");
  var rs: Settings* = man_settings(rr, query("release", "", "linux", (StrList*)0));
  keep(rs);
  t_eq("release flags --release: once", sl_join(man_settings_flags(rs, "linux"), ","), "--release");
  t_has("release flags --release: warning", sl_join(rs->warnings, "|"), "use optimize = \"full\"");
  t_eq("release flags --release: warning text", sl_join(rs->warnings, "|"), "/p/mbuild.toml:4: flags = [\"--release\"]: use optimize = \"full\" (mbuild passes it for you)");

  var f: Manifest* = man_of(pkg("[profile.fast]\ninherits = \"release\"\ncheck-overflow = true\n"));
  t_eq("fast: valid", f->error, "");
  t_eq("fast: no warnings", sl_join(f->warnings, "|"), "");
  var ag: Manifest* = man_of(pkg("[build]\nagents = false\n"));
  t_eq("build agents: no warnings", sl_join(ag->warnings, "|"), "");
  t_eq("fast inherits release", flags_of(f, "fast"), "--release,--check-overflow");
  var fs: Settings* = man_settings(f, query("fast", "", "linux", (StrList*)0));
  keep(fs);
  t_eq("fast: origins", sl_join(fs->origins, ","), "check-overflow=mbuild.toml:5");
  t_eq("fast: profile names", sl_join(man_profile_names(f), ","), "debug,release,fast");
  var fa: Manifest* = man_of(pkg("[profile.fast]\n"));
  t_eq("fast alone inherits debug", flags_of(fa, "fast"), "-s");
  t_ok("fast alone exists", man_has_profile(fa, "fast"));

  var cy: Manifest* = man_of(pkg("[profile.a]\ninherits = \"b\"\n[profile.b]\ninherits = \"a\"\n"));
  t_has("cycle: inherits", cy->error, "inherits");
  t_has("cycle: cycle", cy->error, "cycle");
  t_eq("cycle: message", cy->error, "/p/mbuild.toml:6: [profile.b] inherits = \"a\": the inherits chain is a cycle (a -> b -> a)");
  var ty: Manifest* = man_of(pkg("[profile.fast]\ninherits = \"relase\"\n"));
  t_has("inherits typo", ty->error, "did you mean \"release\"");

  var bad: Manifest* = man_of(pkg("[profile.release]\noptimize = \"fast\"\n"));
  t_eq("bad enum", bad->error, "/p/mbuild.toml:4: optimize = \"fast\" is not one of \"off\", \"checked\", \"full\" (did you mean \"full\"?)");
  var sy: Manifest* = man_of(pkg("[profile.debug]\nsafe = \"yes\"\n"));
  t_eq("bool type", sy->error, "/p/mbuild.toml:4: `safe` must be true or false");
  var unk: Manifest* = man_of(pkg("[profile.debug]\nsfae = true\n"));
  t_eq("unknown key warning", sl_join(unk->warnings, "|"), "/p/mbuild.toml:4: unknown key 'sfae' in [profile.debug] (did you mean 'safe'?)");

  var b: Manifest* = man_of(pkg("[bin.tool]\nmain = \"tool.mettle\"\nnative-heap = true\nsubsystem = \"windows\"\n"));
  t_eq("bin: valid", b->error, "");
  var bs: Settings* = man_settings(b, query("debug", "tool", "windows", (StrList*)0));
  keep(bs);
  t_eq("bin: windows", sl_join(man_settings_flags(bs, "windows"), ","), "-s,--native-heap,--subsystem,windows");
  t_eq("bin: linux", sl_join(man_settings_flags(bs, "linux"), ","), "-s,--native-heap");
  t_eq("bin: other bin unaffected", flags_of(b, "debug"), "-s");

  var sets: StrList* = sl_new();
  sl_push(sets, "optimize=checked");
  sl_push(sets, "safe=true");
  var ss: Settings* = man_settings(e, query("debug", "", "linux", sets));
  keep(ss);
  t_eq("sets on debug", sl_join(man_settings_flags(ss, "linux"), ","), "-O,--safe,-s");
  t_eq("sets origins", sl_join(ss->origins, ","), "optimize=--set,safe=--set");
  var sets2: StrList* = sl_of("optimize=\"full\"");
  var s2: Settings* = man_settings(e, query("debug", "", "linux", sets2));
  keep(s2);
  t_eq("sets quoted value", sl_join(man_settings_flags(s2, "linux"), ","), "--release,-s");
  var s3: Settings* = man_settings(e, query("debug", "", "linux", sl_of("safe=yes")));
  keep(s3);
  t_eq("sets bool error", s3->error, "--set safe=yes: `safe` must be true or false");
  var s4: Settings* = man_settings(e, query("debug", "", "linux", sl_of("optimise=full")));
  keep(s4);
  t_eq("sets unknown key", s4->error, "--set optimise=full: unknown key 'optimise' (did you mean 'optimize'?)");
  var s5: Settings* = man_settings(e, query("debug", "", "linux", sl_of("stack-trace=false")));
  keep(s5);
  t_eq("sets turn off built-in", sl_join(man_settings_flags(s5, "linux"), ","), "");

  var pu: Manifest* = man_of(pkg("[profile.release]\npgo = \"use\"\n"));
  t_eq("pgo use: parses", pu->error, "");
  t_has("pgo use without file", flags_of(pu, "release"), "ERR: mbuild.toml:4: pgo = \"use\" needs pgo-file");
  var pf: Manifest* = man_of(pkg("[profile.release]\npgo = \"use\"\npgo-file = \"pgo/a.prof\"\n"));
  t_eq("pgo use with file", flags_of(pf, "release"), "--release,--pgo-use=pgo/a.prof");

  var bf: Manifest* = man_of(pkg("[build]\nflags = [\"--explain\"]\n[profile.debug]\nflags = [\"-s\", \"--foo\"]\n"));
  t_eq("raw flags: order and dedupe", flags_of(bf, "debug"), "-s,--foo,--explain");
  var cf: Manifest* = man_of(pkg("[profile.debug]\ncflags = [\"-O1\"]\n[profile.fast]\ncflags = [\"-O2\"]\n"));
  t_eq("cflags along the chain", sl_join(man_profile_cflags(cf, "fast"), ","), "-O1,-O2");
}

fn test_replace_and_removed() {
  var r: Manifest* = man_of(pkg("[replace]\nstrutil = {{ path = \"../strutil\" }\napilib = {{ version = \"v2.0.0\" }\n[replace.edge]\npath = \"../edge\"\n"));
  t_eq("replace: valid", r->error, "");
  t_eq("replace: no warnings", sl_join(r->warnings, "|"), "");
  t_ok("replace: three", r->nreplaces == 3);
  var a: ReplaceSpec* = man_replace_find(r, "strutil");
  t_eq("replace: path", a->path + "|" + a->version + "|" + s_int(a->line), "../strutil||4");
  t_eq("replace: version", man_replace_find(r, "apilib")->version, "v2.0.0");
  t_eq("replace: table form", man_replace_find(r, "edge")->path, "../edge");
  t_ok("replace: absent", man_replace_find(r, "other") == (ReplaceSpec*)0);
  var pv: Manifest* = man_of(pkg("[replace]\nb = {{ path = \"../b\", version = \"v1\" }\n"));
  t_eq("replace: path and version", pv->error, "/p/mbuild.toml:4: [replace] \"b\": path excludes version (a local checkout is used as it is)");
  var ru: Manifest* = man_of(pkg("[replace]\njson = {{ url = \"https://github.com/me/json\", version = \"v1.4.1\" }\n"));
  t_has("replace: url removed", ru->error, "url was removed");
  var rm: Manifest* = man_of(pkg("[replace]\n\"github.com/a/b\" = {{ path = \"../b\" }\n"));
  t_has("replace: module path key", rm->error, "package names");

  var d: Manifest* = man_of(pkg("[dependencies]\nstrutil = \"v1.1.0\"\nauth = {{ version = \"v2.0.0\", registry = \"corp\" }\nwidgets = {{ path = \"../widgets\" }\nloose = {{ registry = \"corp\" }\n[dependencies.tbl]\nversion = \"v1\"\n"));
  t_eq("deps: valid", d->error, "");
  t_ok("deps: five", d->ndeps == 5);
  var su: DepSpec* = man_dep_find(d, "strutil");
  t_eq("deps: string", su->key + "|" + su->version + "|" + su->registry + "|" + su->path, "strutil|v1.1.0||");
  var au: DepSpec* = man_dep_find(d, "auth");
  t_eq("deps: registry", au->version + "|" + au->registry, "v2.0.0|corp");
  t_eq("deps: path", man_dep_find(d, "widgets")->path + "|" + man_dep_find(d, "widgets")->version, "../widgets|");
  t_eq("deps: latest when unstated", man_dep_find(d, "loose")->version, "latest");
  t_eq("deps: table form", man_dep_find(d, "tbl")->version, "v1");
  var dm: Manifest* = man_of(pkg("[dependencies]\n\"github.com/x/y\" = \"v1.0.0\"\n"));
  t_has("deps: module path key", dm->error, "package names");
  t_eq("deps: module path message", dm->error, "/p/mbuild.toml:4: dependency 'github.com/x/y' is a module path: dependencies are package names now (e.g. y = \"v1.0.0\")");
  var du: Manifest* = man_of(pkg("[dependencies]\nlib = {{ url = \"https://x/lib\", version = \"v1\" }\n"));
  t_has("deps: url removed", du->error, "dependency 'lib': url was removed");
  var dmo: Manifest* = man_of(pkg("[dependencies]\nlib = {{ module = \"github.com/a/lib\" }\n"));
  t_has("deps: module removed", dmo->error, "module was removed");
  var ds: Manifest* = man_of(pkg("[dependencies]\nlib = {{ version = \"v1\", submodules = false }\n"));
  t_has("deps: submodules removed", ds->error, "submodules was removed");
  var dup: Manifest* = man_of(pkg("[dependencies]\nStrUtil = \"v1\"\n"));
  t_has("deps: bad name", dup->error, "is not a package name");
  var dst: Manifest* = man_of(pkg("[dependencies]\nstd = \"v1\"\n"));
  t_has("deps: reserved", dst->error, "'std' is reserved");
  var dpr: Manifest* = man_of(pkg("[dependencies]\nw = {{ path = \"../w\", registry = \"corp\" }\n"));
  t_has("deps: path and registry", dpr->error, "both a path and a registry");

  var pm: Manifest* = man_of(pkg("module = \"github.com/a/x\"\n"));
  t_has("package module removed", pm->error, "[package] module was removed");
  var ps: Manifest* = man_of(pkg("submodules = [\"vendor/clib\"]\n"));
  t_has("package submodules removed", ps->error, "[package] include");
  var tc: Manifest* = man_of(pkg("[toolchain]\nmettle = \"v0.17.0\"\n"));
  t_has("toolchain removed", tc->error, "[toolchain] was removed");
  var pmv: Manifest* = man_of("[package]\nname = \"x\"\nmettle = \"0.17\"\n");
  t_eq("package: mettle normalised", pmv->mettle_min, "v0.17.0");
  var pl: Manifest* = man_of("[package]\nname = \"x\"\nmettle = \"latest\"\n");
  t_has("package: mettle latest", pl->error, "/p/mbuild.toml:3: [package] mettle = \"latest\" is not a Mettle version");

  t_ok("package name: ok", man_is_package_name("strutil") && man_is_package_name("a_1"));
  t_ok("package name: bad", !man_is_package_name("Str") && !man_is_package_name("1a") && !man_is_package_name("a-b") && !man_is_package_name(""));
  t_ok("package name: 64", man_is_package_name(s_repeat("a", 64)) && !man_is_package_name(s_repeat("a", 65)));

  var tw: Manifest* = man_of(pkg("[tools]\npkg-config = \"/usr/bin/pkg-config\"\n[workspace]\nmembers = []\n"));
  t_eq("tools: parsed", sl_join(tw->tools, ","), "pkg-config=/usr/bin/pkg-config");
  t_eq("tools/workspace warnings", sl_join(tw->warnings, "|"), "/p/mbuild.toml:3: [tools] is machine-specific: move it to mbuild.local.mettle|/p/mbuild.toml:5: workspaces are not supported yet; use path dependencies (docs/dependencies.md)");

  var it: Toml* = toml_parse("a = {{ s = [\"x\", \"y\"], b = false }\n", "t.toml");
  t_eq("toml: inline array", it->error + toml_field(toml_get(it, "", "a"), "s") + " " + toml_field_kind(toml_get(it, "", "a"), "s"), "[\"x\", \"y\"] 4");
  t_eq("toml: inline array value", sl_join(toml_field_value(toml_get(it, "", "a"), "s")->items, ","), "x,y");
  t_ok("toml: field value absent", toml_field_value(toml_get(it, "", "a"), "z") == (TomlValue*)0);
}

fn local_of(text: string) -> Manifest* {
  return man_parse_local(toml_parse(text, "/p/mbuild.local.mettle"), "/p");
}

fn test_local() {
  var bad: Manifest* = local_of("[tools]\ncc = \"g\"\n[dependencies]\nb = \"v1\"\n");
  t_eq("local: [dependencies]", bad->error, "/p/mbuild.local.mettle:3: [dependencies] is not allowed here (mbuild.local.mettle holds [replace], [tools], [profile.NAME], [build] targets, [components] and [registry.NAME] url)");
  var bb: Manifest* = local_of("[build]\nflags = [\"-x\"]\n");
  t_has("local: [build] flags", bb->error, "[build] flags is not allowed in mbuild.local.mettle");

  var m: Manifest* = man_of(pkg("[build]\ntargets = [\"linux\", \"windows\"]\n[tools]\ncc = \"gcc\"\npkg-config = \"pkgconf\"\n[profile.release]\ncflags = [\"-O2\"]\n[replace]\njson = {{ version = \"v1.4.1\" }\nstrutil = {{ version = \"v1.0.0\" }\n[registry.corp]\nurl = \"https://pkgs.example.com/mettle\"\n"));
  t_eq("local main: valid", m->error, "");
  var l: Manifest* = local_of("[replace]\nstrutil = {{ path = \"../strutil\" }\n[tools]\npkg-config = \"/usr/bin/pkg-config\"\n[profile.release]\ncflags = [\"-march=native\"]\nsafe = true\n[profile.mine]\ninherits = \"release\"\n[build]\ntargets = [\"linux\"]\n[components]\nlogger = \"quiet\"\n[registry.corp]\nurl = \"/mirror/corp\"\n[registry.default]\nurl = \"/mirror/default\"\n");
  t_eq("local: valid", l->error, "");
  t_eq("local: no warnings", sl_join(l->warnings, "|"), "");
  man_merge_local(m, l);
  t_eq("merge: error", m->error, "");
  t_eq("merge: targets", sl_join(m->targets, ","), "linux");
  t_eq("merge: tools", sl_join(m->tools, ","), "cc=gcc,pkg-config=/usr/bin/pkg-config");
  t_eq("merge: cflags", sl_join(man_profile_cflags(m, "release"), ","), "-O2,-march=native");
  t_eq("merge: release flags", flags_of(m, "release"), "--release,--safe");
  t_eq("merge: local profile", flags_of(m, "mine"), "--release,--safe");
  t_eq("merge: profile names", sl_join(man_profile_names(m), ","), "debug,release,mine");
  var su: ReplaceSpec* = man_replace_find(m, "strutil");
  t_ok("merge: local replace wins", su->local && s_eq(su->path, "../strutil"));
  t_ok("merge: main replace kept", !man_replace_find(m, "json")->local);
  t_ok("merge: replace count", m->nreplaces == 2);
  var rs: Settings* = man_settings(m, query("release", "", "linux", (StrList*)0));
  keep(rs);
  t_eq("merge: origin from local", sl_join(rs->origins, ","), "safe=mbuild.local.mettle:7");
  t_eq("merge: local components", sl_join(m->local_components, ","), "logger=quiet");
  t_eq("merge: registry mirror", man_reg_find(m, "corp")->url, "/mirror/corp");
  t_ok("merge: undeclared mirror stays local", m->nregs == 1 && s_eq(man_reg_find(m->local, "default")->url, "/mirror/default"));
  var lc: Manifest* = local_of("[components]\nlogger = 3\n");
  t_has("local: component not a string", lc->error, "[components] logger must be an impl name");
}

// The 13.5 example as the driver emits it.
fn example_text() -> string {
  return "[package]\nname = \"viewer\"\nversion = \"0.3.0\"\ndescription = \"image viewer\"\n[build]\ntargets = [\"linux\", \"windows\"]\n[dependencies]\nstrutil = \"v1.1.0\"\nauth = {{ version = \"v2.0.0\", registry = \"corp\" }\nwidgets = {{ path = \"../widgets\" }\n[registry.corp]\nurl = \"https://pkgs.example.com/mettle\"\n[component.renderer]\ndir = \"src/renderer\"\nmode = \"static\"\nimpls = [\"soft\", \"gl\"]\nwindows = \"soft\"\n[rules]\nfiles = [\"rules/no_alloc_in_draw.mettle\"]\n[profile.release]\noptimize = \"full\"\ncrash-report = false\ncomponents = [\"renderer=gl\"]\n[profile.release.windows]\nsubsystem = \"windows\"\n[profile.debug]\nsafe = true\n";
}

fn settings_of(m: Manifest*, profile: string, bin: string, target: string) -> Settings* {
  var s: Settings* = man_settings(m, query(profile, bin, target, (StrList*)0));
  keep(s);
  return s;
}

fn test_schema() {
  var m: Manifest* = man_parse(toml_parse(example_text(), "/home/me/app/.mbuild/config/manifest.toml"), "/home/me/app");
  t_eq("example: valid", m->error, "");
  t_eq("example: no warnings", sl_join(m->warnings, "|"), "");
  t_eq("example: meta", sl_join(m->meta, ","), "description=image viewer");
  t_ok("example: one component", m->ncomps == 1);
  var c: CompSpec* = man_comp_find(m, "renderer");
  t_eq("example: component", c->name + "|" + c->dir + "|" + c->mode + "|" + sl_join(c->impls, ",") + "|" + sl_join(c->os_defaults, ",") + "|" + c->owner + "|" + s_int(c->line), "renderer|/home/me/app/src/renderer|static|soft,gl|windows=soft|viewer|13");
  t_ok("example: component absent", man_comp_find(m, "logger") == (CompSpec*)0);
  t_ok("example: one registry", m->nregs == 1);
  var r: RegSpec* = man_reg_find(m, "corp");
  t_eq("example: registry", r->name + "|" + r->url + "|" + s_int(r->line), "corp|https://pkgs.example.com/mettle|11");
  t_ok("example: registry absent", man_reg_find(m, "default") == (RegSpec*)0);
  t_eq("example: auth registry", man_dep_find(m, "auth")->registry, "corp");
  t_eq("example: strutil", man_dep_find(m, "strutil")->version + "|" + man_dep_find(m, "strutil")->registry, "v1.1.0|");
  t_eq("example: rules", sl_join(m->rules, ","), "/home/me/app/rules/no_alloc_in_draw.mettle");
  var rw: Settings* = settings_of(m, "release", "", "windows");
  t_eq("example: release windows", sl_join(man_settings_flags(rw, "windows"), ","), "--release,--no-crash-report,--subsystem,windows");
  t_eq("example: release components", sl_join(rw->components, ","), "renderer=gl");
  var rl: Settings* = settings_of(m, "release", "", "linux");
  t_eq("example: release linux", sl_join(man_settings_flags(rl, "linux"), ","), "--release,--no-crash-report");
  t_eq("example: os profile only on its os", rl->subsystem, "console");
  t_eq("example: debug", sl_join(man_settings_flags(settings_of(m, "debug", "", "linux"), "linux"), ","), "--safe,-s");
  t_eq("example: profile names", sl_join(man_profile_names(m), ","), "debug,release");

  var inh: Manifest* = man_of(pkg("[profile.release.windows]\nsubsystem = \"windows\"\n[profile.ship]\ninherits = \"release\"\n[profile.ship.windows]\nnative-heap = true\n"));
  t_eq("os profile: chain", sl_join(man_settings_flags(settings_of(inh, "ship", "", "windows"), "windows"), ","), "--release,--native-heap,--subsystem,windows");
  var oslocal: Manifest* = man_of(pkg("[profile.release]\n"));
  man_merge_local(oslocal, local_of("[profile.release.linux]\ncheck-overflow = true\n"));
  t_eq("os profile: local", sl_join(man_settings_flags(settings_of(oslocal, "release", "", "linux"), "linux"), ","), "--release,--check-overflow");
  var osw: Manifest* = man_of(pkg("[profile.release.linux]\nsfae = true\n[profile.release.macos]\nsafe = true\n"));
  t_has("os profile: unknown key", sl_join(osw->warnings, "|"), "unknown key 'sfae' in [profile.release.linux] (did you mean 'safe'?)");
  t_has("os profile: unknown os", sl_join(osw->warnings, "|"), "unknown section [profile.release.macos]");
  var ost: Manifest* = man_of(pkg("[profile.release.windows]\nsafe = \"yes\"\n"));
  t_has("os profile: typed", ost->error, "`safe` must be true or false");

  var pr: Manifest* = man_of(pkg("[profile.debug]\nprofile-runtime = true\n"));
  t_eq("profile-runtime", flags_of(pr, "debug"), "-s,--profile-runtime");
  var ib: Manifest* = man_of(pkg("[profile.release]\nimage-base = \"0x500000\"\n"));
  t_eq("image-base", flags_of(ib, "release"), "--release,--image-base,0x500000");
  var ibb: Manifest* = man_of(pkg("[profile.release]\nimage-base = \"5M\"\n"));
  t_has("image-base: not hex", ibb->error, "`image-base` must be a hex address");
  var ibs: Settings* = man_settings(pr, query("debug", "", "linux", sl_of("image-base=0x100000")));
  keep(ibs);
  t_eq("image-base: --set", sl_join(man_settings_flags(ibs, "linux"), ","), "-s,--profile-runtime,--image-base,0x100000");
  var ibr: Manifest* = man_of(pkg("[build]\nflags = [\"--image-base\", \"0x1000\"]\n[profile.debug]\nimage-base = \"0x2000\"\n"));
  t_eq("image-base: raw flag dropped", flags_of(ibr, "debug"), "-s,--image-base,0x2000");
  var cps: Settings* = man_settings(pr, query("debug", "", "linux", sl_of("components=a=b")));
  keep(cps);
  t_has("components: not with --set", cps->error, "use --use NAME=IMPL");

  var cb: Manifest* = man_of(pkg("[profile.release]\ncomponents = [\"logger=quiet\", \"renderer=gl\"]\n[profile.fast]\ninherits = \"release\"\ncomponents = [\"logger=file\"]\n[bin.tool]\ncomponents = [\"renderer=soft\"]\n"));
  t_eq("components: valid", cb->error, "");
  t_eq("components: layering order", sl_join(settings_of(cb, "fast", "tool", "linux")->components, ","), "logger=quiet,renderer=gl,logger=file,renderer=soft");
  var cbad: Manifest* = man_of(pkg("[profile.release]\ncomponents = [\"logger\"]\n"));
  t_has("components: entry form", cbad->error, "entries are \"component=impl\"");

  var md: Manifest* = man_of(pkg("[component.logger]\ndir = \"src/logger\"\nmode = \"dynamic\"\nimpls = [\"stdout\"]\n"));
  t_has("component: mode did you mean", md->error, "did you mean \"dyn\"");
  var ms: Manifest* = man_of(pkg("[component.logger]\ndir = \"src/logger\"\nimpls = \"stdout, quiet,file\"\nlinux = \"quiet\"\n"));
  t_eq("component: csv impls, default mode", ms->error + sl_join(man_comp_find(ms, "logger")->impls, ",") + "|" + man_comp_find(ms, "logger")->mode + "|" + sl_join(man_comp_find(ms, "logger")->os_defaults, ","), "stdout,quiet,file|static|linux=quiet");
  var me: Manifest* = man_of(pkg("[component.logger]\ndir = \"src/logger\"\nimpls = []\n"));
  t_has("component: impls empty", me->error, "needs impls");
  var mo: Manifest* = man_of(pkg("[component.logger]\ndir = \"src/logger\"\nimpls = [\"stdout\", \"quiet\"]\nwindows = \"quite\"\n"));
  t_has("component: os default not an impl", mo->error, "windows = \"quite\" is not one of its impls (stdout, quiet) (did you mean \"quiet\"?)");
  var mn: Manifest* = man_of(pkg("[component.Logger]\ndir = \"x\"\nimpls = [\"a\"]\n"));
  t_has("component: name", mn->error, "component name 'Logger'");
  var mdir: Manifest* = man_of(pkg("[component.logger]\nimpls = [\"a\"]\n"));
  t_has("component: dir required", mdir->error, "needs dir");
  var mk: Manifest* = man_of(pkg("[component.logger]\ndir = \"/abs/logger\"\nimpls = [\"a\"]\nmdoe = \"dyn\"\n"));
  t_eq("component: absolute dir kept", man_comp_find(mk, "logger")->dir, "/abs/logger");
  t_has("component: unknown key", sl_join(mk->warnings, "|"), "unknown key 'mdoe' in [component.logger] (did you mean 'mode'?)");

  var bf: Manifest* = man_of(pkg("[bin.boot]\nmain = \"boot.mettle\"\nkind = \"flat\"\n"));
  t_has("bin: flat without triple", bf->error, "kind = \"flat\" needs a freestanding triple");
  var bt: Manifest* = man_of(pkg("[bin.boot]\nmain = \"boot.mettle\"\nkind = \"flat\"\ntriple = \"x86_64-windows\"\n"));
  t_has("bin: flat with a hosted triple", bt->error, "needs a freestanding triple");
  var bok: Manifest* = man_of(pkg("[bin.boot]\nmain = \"boot.mettle\"\nkind = \"flat\"\ntriple = \"x86_64-none\"\nimage-base = \"0x100000\"\n[bin.app]\n[bin.lib]\nkind = \"shared\"\n"));
  t_eq("bin: kinds valid", bok->error, "");
  t_eq("bin: kinds", man_bin(bok, 0)->kind + "/" + man_bin(bok, 0)->triple + "," + man_bin(bok, 1)->kind + "/" + man_bin(bok, 1)->triple + "," + man_bin(bok, 2)->kind, "flat/x86_64-none,exe/,shared");
  t_eq("bin: image-base flag", sl_join(man_settings_flags(settings_of(bok, "debug", "boot", "linux"), "linux"), ","), "-s,--image-base,0x100000");
  var bk: Manifest* = man_of(pkg("[bin.x]\nkind = \"shard\"\n"));
  t_has("bin: kind typo", bk->error, "did you mean \"shared\"");

  var rg: Manifest* = man_of(pkg("[registry.corp]\nurl = \"https://a\"\n[registry.mirror-2]\nurl = \"file:///srv/reg\"\n"));
  t_eq("registries: order", rg->error + rg->regs[0].name + "," + rg->regs[1].name + "|" + rg->regs[1].url, "corp,mirror-2|file:///srv/reg");
  var rgn: Manifest* = man_of(pkg("[registry.corp]\n"));
  t_has("registry: url required", rgn->error, "[registry.corp] needs url");
  var rgu: Manifest* = man_of(pkg("[registry]\nurl = \"x\"\n"));
  t_has("registry: bare section", sl_join(rgu->warnings, "|"), "unknown section [registry] (did you mean [registry.NAME]?)");

  var inc: Manifest* = man_of(pkg("include = [\"src/**\", \"README.md\"]\nlicense = \"MIT\"\nrepository = \"https://example.com/x\"\nauthors = [\"A\", \"B\"]\n"));
  t_eq("package: include", inc->error + sl_join(inc->include, ","), "src/**,README.md");
  t_eq("package: meta", sl_join(inc->meta, ","), "license=MIT,repository=https://example.com/x,authors=A, B");
  t_eq("package: no warnings", sl_join(inc->warnings, "|"), "");
}

fn test_basics() {
  var m: Manifest* = man_of("[package]\nname = \"app\"\nversion = \"0.1.0\"\n[build]\ntargets = [\"linux\", \"windows\"]\nflags = [\"--safe\"]\nprelude = false\n[bin.app]\nmain = \"src/main.mettle\"\nflags = []\n[c]\nsources = [\"csrc\"]\nlibs = [\"m\"]\n[link]\nlibs = [\"raylib\"]\n[link.windows]\n");
  t_eq("basics: valid", m->error, "");
  t_eq("basics: no warnings", sl_join(m->warnings, " / "), "");
  t_eq("basics: package", m->name + " " + m->version, "app 0.1.0");
  t_eq("basics: targets/flags", sl_join(m->targets, ",") + " " + sl_join(m->flags, ","), "linux,windows --safe");
  t_ok("basics: prelude", !m->prelude);
  t_ok("basics: one bin", m->nbins == 1);
  t_eq("basics: bin", man_bin(m, 0)->name + " " + man_bin(m, 0)->main, "app src/main.mettle");
  t_eq("basics: os list", sl_join(man_os_list(m, "link.libs", "linux"), ","), "raylib");
  t_ok("basics: has c", man_has_c(m));

  var d: Manifest* = man_of(pkg("[profile.fast]\ncflags = [\"-O2\", \"-DFAST\"]\n[link]\nlibs = [\"a\"]\nlinux.libs = [\"b\"]\n[link.windows]\nlibs = [\"w\"]\n"));
  t_eq("basics: profile cflags", sl_join(man_profile_cflags(d, "fast"), ","), "-O2,-DFAST");
  t_eq("basics: profile cflags absent", sl_join(man_profile_cflags(d, "release"), ","), "");
  t_eq("basics: profile cflags unknown profile", sl_join(man_profile_cflags(d, "nope"), ","), "");
  t_eq("basics: os list linux", sl_join(man_os_list(d, "link.libs", "linux"), ","), "a,b");
  t_eq("basics: os list windows", sl_join(man_os_list(d, "link.libs", "windows"), ","), "a,w");
  t_ok("basics: no c", !man_has_c(d));
  t_ok("basics: no bins", d->nbins == 0);

  var cases: StrList* = sl_new();
  defer free(cases);
  var want: StrList* = sl_new();
  defer free(want);
  sl_push(cases, "[package]\nversion = \"1.0.0\"\n");
  sl_push(want, "/p/mbuild.toml:1: [package] name is required");
  sl_push(cases, "[package]\nname = 5\n");
  sl_push(want, "/p/mbuild.toml:2: [package] name must be a string, not an integer");
  sl_push(cases, pkg("[build]\ntargets = [\"linux\", 3]\n"));
  sl_push(want, "/p/mbuild.toml:4: [build] targets must be an array of strings");
  sl_push(cases, pkg("[build]\ntargets = [\"macos\"]\n"));
  sl_push(want, "/p/mbuild.toml:4: unknown target 'macos' (expected \"linux\" or \"windows\")");
  sl_push(cases, pkg("[build]\nprelude = \"yes\"\n"));
  sl_push(want, "/p/mbuild.toml:4: [build] prelude must be true or false, not a string");
  sl_push(cases, pkg("[dependencies]\nl = {{ path = \"../l\", version = \"v1.0.0\" }\n"));
  sl_push(want, "/p/mbuild.toml:4: dependency 'l' has both a path and a version");
  sl_push(cases, pkg("[dependencies]\nstrutil = true\n"));
  sl_push(want, "/p/mbuild.toml:4: dependency 'strutil' must be a version string or an inline table, not a boolean");
  sl_push(cases, pkg("[bin.tool]\nflags = 3\n"));
  sl_push(want, "/p/mbuild.toml:4: [bin.tool] flags must be an array of strings, not an integer");
  sl_push(cases, pkg("[c]\nsources = \"csrc\"\ncflags = [1]\n"));
  sl_push(want, "/p/mbuild.toml:5: [c] cflags must be an array of strings");
  sl_push(cases, pkg("[profile.fast]\ncflags = 3\n"));
  sl_push(want, "/p/mbuild.toml:4: [profile.fast] cflags must be an array of strings, not an integer");
  sl_push(cases, pkg("name = \"y\"\n"));
  sl_push(want, "/p/mbuild.toml:3: duplicate key 'name' (first set on line 2)");
  var i: int64 = 0;
  while (i < cases->len) {
    t_eq("basics: error " + s_int(i), man_of(sl_get(cases, i))->error, sl_get(want, i));
    i = i + 1;
  }

  var w: Manifest* = man_of(pkg("nmae = \"y\"\n[buidl]\nflags = []\n[profiles.release]\n[bin]\nmain = \"m\"\n[c.macos]\n[zzz]\n[link]\nlib = []\n[dependencies]\nk = {{ path = \"p\", verison = \"v1\" }\n"));
  t_eq("basics: warnings valid", w->error, "");
  var ww: StrList* = sl_new();
  defer free(ww);
  sl_push(ww, "/p/mbuild.toml:14: unknown field 'verison' in dependency 'k' (did you mean 'version'?)");
  sl_push(ww, "/p/mbuild.toml:3: unknown key 'nmae' in [package] (did you mean 'name'?)");
  sl_push(ww, "/p/mbuild.toml:4: unknown section [buidl] (did you mean [build]?)");
  sl_push(ww, "/p/mbuild.toml:6: unknown section [profiles.release] (did you mean [profile.release]?)");
  sl_push(ww, "/p/mbuild.toml:7: unknown section [bin] (did you mean [bin.NAME]?)");
  sl_push(ww, "/p/mbuild.toml:9: unknown section [c.macos]");
  sl_push(ww, "/p/mbuild.toml:10: unknown section [zzz]");
  sl_push(ww, "/p/mbuild.toml:12: unknown key 'lib' in [link] (did you mean 'libs'?)");
  t_eq("basics: warnings", sl_join(w->warnings, "\n"), sl_join(ww, "\n"));

  var z: Manifest* = man_empty("/q", "q");
  defer free(z);
  t_eq("basics: empty", z->name + " " + z->error, "q ");
  t_ok("basics: edit distance", man_edit_distance("kitten", "sitting") == 3 && man_edit_distance("", "abc") == 3);
}

// mb_import_root and mb_dep_bin.
fn test_import_root_and_dep_bins() {
  var m: Manifest* = man_of(pkg("import-root = \"./src/\"\n[dependencies]\nmeosql = {{ path = \"../meosql\" }\n[dep-bins]\nmeosql = [\"server\", \"admin\"]\n"));
  t_eq("import root: valid", m->error + sl_join(m->warnings, " / "), "");
  t_eq("import root: cleaned", m->import_root, "src");
  t_eq("import root: dir", man_import_dir(m, "/p"), "/p/src");
  t_eq("import root: none", man_import_dir(man_of(pkg("")), "/p") + " " + man_import_dir((Manifest*)0, "/q"), "/p /q");
  t_eq("import root: \".\" is the package", man_import_dir(man_of(pkg("import-root = \".\"\n")), "/p"), "/p");
  t_eq("dep bins: list", sl_join(m->dep_bins, ","), "meosql=server,meosql=admin");
  t_eq("dep bins: of a dep", sl_join(man_dep_bins(m, "meosql"), ","), "server,admin");
  t_eq("dep bins: of another", sl_join(man_dep_bins(m, "other"), ","), "");
  t_eq("import root: absolute", man_of(pkg("import-root = \"/abs\"\n"))->error, "/p/mbuild.toml:3: mb_import_root(\"/abs\"): the import root is a directory inside the package, relative to it (e.g. \"src\")");
  t_eq("import root: outside", man_of(pkg("import-root = \"src/../..\"\n"))->error, "/p/mbuild.toml:3: mb_import_root(\"src/../..\"): the import root is a directory inside the package, relative to it (e.g. \"src\")");
  t_eq("dep bins: unknown dep", man_of(pkg("[dependencies]\nmeosql = {{ path = \"../meosql\" }\n[dep-bins]\nmeosq = [\"server\"]\n"))->error, "/p/mbuild.toml:6: mb_dep_bin(\"meosq\", ...): meosq is not a dependency of this package (did you mean meosql?)");
  t_eq("dep bins: not in mbuild.local.mettle", local_of("[build]\ntargets = [\"linux\"]\n[dep-bins]\nx = [\"y\"]\n")->error, "/p/mbuild.local.mettle:3: [dep-bins] is not allowed here (mbuild.local.mettle holds [replace], [tools], [profile.NAME], [build] targets, [components] and [registry.NAME] url)");
}

fn run_all() -> int64 {
  test_basics();
  test_import_root_and_dep_bins();
  test_settings();
  test_replace_and_removed();
  test_local();
  test_schema();
  say("");
  say("manifest_test: " + s_int(g_pass) + " passed, " + s_int(g_fail) + " failed");
  flush_out();
  return g_fail;
}

@test fn manifest_all() -> int32 {
  if (run_all() > 0) {
    return 1;
  }
  return 0;
}

fn main() -> int32 {
  if (run_all() > 0) {
    return 1;
  }
  return 0;
}
