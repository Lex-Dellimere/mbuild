// testrun_test: what mbuild test reads from runs (testrun), the native copy of an @test file (testnative).
//   tools/mcheck.sh tests/unit/testrun_test.mettle --run

import "std/io";
import "../../src/core/base";
import "../../src/build/testrun";
import "../../src/build/testnative";
import "../../src/build/services";
import "../../src/build/golden";

var g_pass: int64 = 0;
var g_fail: int64 = 0;

fn t_eq(name: string, got: string, want: string) {
  if (s_eq(got, want)) {
    g_pass = g_pass + 1;
    say("PASS " + name);
  } else {
    g_fail = g_fail + 1;
    say("FAIL " + name);
    say("     got:  [" + got + "]");
    say("     want: [" + want + "]");
  }
}

fn test_outputs() {
  var compiled: string = "-- tests/w_test.mettle:2:7 -----\nwarning[W0001]: unused variable 'x'\n\n-- src/a.mettle:9:1 ---\nwarning[M0107]: leaks\nwarning[E0003]: leaked\n";
  var w: StrList* = trn_warnings(compiled);
  defer free(w);
  t_eq("warnings: code and place, E0003 left out", sl_join(w, ","), "W0001 at tests/w_test.mettle:2,M0107 at src/a.mettle:9");
  t_eq("denied: allow", trn_denied(w, "allow"), "");
  t_eq("denied: error", trn_denied(w, "error"), "warning W0001 at tests/w_test.mettle:2");
  t_eq("denied: by prefix", trn_denied(w, "error:M01"), "warning M0107 at src/a.mettle:9");
  t_eq("denied: other codes", trn_denied(w, "error:E99, X"), "");
  t_eq("checks: prefix", s_int(trn_checks("PASS a\nok\nPASS b\n", "PASS")), "2");
  t_eq("checks: none", s_int(trn_checks("PASS a\n", "")), "0");
  t_eq("checks: mbuild-checks sets it", s_int(trn_checks("PASS a\nmbuild-checks: 40\n", "PASS")), "40");
  var sk: StrList* = sl_new();
  defer free(sk);
  var n: int64 = trn_interp("running 3 tests\ntest a ... ok\ntest b ... skipped (calls C function 'f'; ...)\ntest c ... ok\n\n2 passed, 1 skipped (x.mettle)\n", sk);
  t_eq("interp: passed and skipped", s_int(n) + " " + sl_join(sk, ","), "2 b");
  t_eq("secs", trn_secs(1049) + " " + trn_secs(30000) + " " + trn_secs(0), "1.0s 30.0s 0.0s");
  t_eq("tail", trn_tail("a\nb\nc\n", 2, "  "), "  ... (1 lines before)\n  b\n  c\n");
  var r: TrnRun* = trn_run_new(0, 0, 1);
  r->cmd = cmd_new(tool_none());
  r->code = 0;
  t_eq("why: passed", trn_exit_why(r), "");
  r->code = 3;
  t_eq("why: exit", trn_exit_why(r), "exit 3");
  r->code = 139;
  t_eq("why: signal", trn_exit_why(r), "signal 11");
  r->timed_out = true;
  r->timeout_ms = 30000;
  t_eq("why: timeout", trn_exit_why(r), "timeout 30.0s");
  r->timed_out = false;
  r->code = 0;
  r->console = "PASS";
  t_eq("why: no console line", trn_exit_why(r), "no PASS on the console");
  r->console = "DONE";
  r->out = "rp2350: UART0 printed the --exit-on-uart string at 1.000 ms";
  t_eq("why: console line seen", trn_exit_why(r), "");
  r->out = "";
  r->by_exit = true;
  t_eq("why: by exit, passed", trn_exit_why(r), "");
  r->code = 1;
  r->cmd->tool.path = "/x/mflash";
  t_eq("why: by exit, the text and the status", trn_exit_why(r), "no DONE on the console (mflash exited with 1)");
  r->by_exit = false;
  r->console = "";
  r->want_code = 3;
  r->code = 3;
  t_eq("why: expected status", trn_exit_why(r), "");
  r->code = 0;
  t_eq("why: expected status, got 0", trn_exit_why(r), "exit 0, expected 3");
  r->code = 139;
  t_eq("why: expected status, got a signal", trn_exit_why(r), "signal 11, expected 3");
  r->code = 3;
  r->want_out = "boom";
  r->out = "all fine";
  t_eq("why: expected output missing", trn_exit_why(r), "no `boom` in the output");
  r->err = "a boom";
  t_eq("why: expected output in stderr", trn_exit_why(r), "");
  r->want_code = -1;
  t_eq("why: expected output, exit not 0", trn_exit_why(r), "exit 3");
}

fn test_native() {
  var src: string = "import \"calc\";\n@test fn adds() -> int32 {{\n  return 0;\n}\n// @test fn not_one() -> int32 {{\n@test\nfn plain() {{\n  assert(true);\n}\n  @test fn spaced(  ) ->int32 {{ return 0; }\nfn main() -> int32 {{\n  return 0;\n}\n";
  var all: StrList* = tnv_tests(src);
  defer free(all);
  t_eq("tests: in order, returning or not", sl_join(all, ","), "adds\t1,plain\t0,spaced\t1");
  var pick: StrList* = sl_of("spaced");
  defer free(pick);
  sl_push(pick, "adds");
  var sel: StrList* = tnv_pick(all, pick);
  defer free(sel);
  t_eq("pick: source order", sl_join(sel, ","), "adds\t1,spaced\t1");
  var out: string = tnv_source(src, sel);
  var lines: StrList* = s_lines(out);
  defer free(lines);
  t_eq("source: line 1 imports std/io", sl_get(lines, 0), "import \"std/io\"; import \"calc\";");
  t_eq("source: main renamed in place", sl_get(lines, 10), "fn mbt_orig_main() -> int32 {{");
  t_eq("source: lines kept", sl_get(lines, 7), "  assert(true);");
  t_eq("source: the generated main calls them", s_int((int64)s_contains(out, "  print(\"test adds ... \");\n  mbt_failed = mbt_failed + mbt_ran(adds());\n  print(\"test spaced ... \");")), "1");
  t_eq("source: a test without a value", s_int((int64)s_contains(tnv_source(src, sl_of("plain\t0")), "  plain();\n  println(\"ok\");\n")), "1");
  t_eq("passed lines", s_int(tnv_passed("test a ... ok\ntest b ... FAILED (returned 2)\ntest c ... ok\n")), "2");
}

fn test_services() {
  var vars: StrList* = sl_of("MBUILD_PORT_DB=20001");
  defer free(vars);
  sl_push(vars, "MBUILD_TEST_TMP=/r/tmp");
  t_eq("expand: known names", svc_expand("--port=$MBUILD_PORT_DB", vars) + " " + svc_expand("$MBUILD_TEST_TMP/db", vars), "--port=20001 /r/tmp/db");
  t_eq("expand: nothing else", svc_expand("$HOME $MBUILD_PORT_DBX $ x$", vars), "$HOME $MBUILD_PORT_DBX $ x$");
  t_eq("port variable", svc_port_var("db") + " " + svc_port_var("my-cache.2"), "MBUILD_PORT_DB MBUILD_PORT_MY_CACHE_2");
}

fn test_golden() {
  t_eq("diff: equal", gld_diff("a\nb\n", "a\nb\n"), "");
  t_eq("diff: a line", gld_diff("a\nb\nc\n", "a\nB\nc\n"), "at line 2\n  expected: b\n  written:  B");
  t_eq("diff: shorter", gld_diff("a\nb\n", "a\n"), "at line 2\n  expected: b\n  written:  (end of file)");
  t_eq("diff: final newline", gld_diff("a\nb\n", "a\nb"), "at the end (a final newline)");
  var bin: string = "x" + s_view((uint8*)"\0", 1) + "yz";
  var bin2: string = "x" + s_view((uint8*)"\0", 1) + "yy";
  t_eq("diff: binary", gld_diff(bin, bin2), "at byte 3 (4 bytes expected, 4 written)");
}

fn run_all() -> int64 {
  test_outputs();
  test_golden();
  test_services();
  test_native();
  say("");
  say("testrun_test: " + s_int(g_pass) + " passed, " + s_int(g_fail) + " failed");
  flush_out();
  return g_fail;
}

fn main() -> int32 {
  if (run_all() > 0) {
    return 1;
  }
  return 0;
}
