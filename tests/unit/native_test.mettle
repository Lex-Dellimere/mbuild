// native_test: the native module against a project on disk, for tests/e2e/native.sh.
//
//   native_test APP linux|windows prepare        "arg X", "env X", "copy X", "fp X" lines
//   native_test APP linux|windows doctor
//   native_test APP linux|windows explain LOGFILE
//   native_test - linux syms FILE | soname FILE   one library
//
// APP/manifest.toml is the root's manifest (the schema mbuild.mettle emits); the
// DepState is APP/.mbuild/deps/NAME, each with its frozen manifest.toml or none
// (a link stands for a replacement). MB_RUNTIME_DIR: the compiler's runtime
// directory; MB_PROFILE: the profile (default debug).

import "std/io";
import "std/mem";
import "../../src/core/base";
import "../../src/core/path";
import "../../src/core/fs";
import "../../src/model/toml";
import "../../src/model/manifest";
import "../../src/model/project";
import "../../src/build/native";
import "../../src/build/symbols";
import "../../src/core/sys_linux" if linux;
import "../../src/core/sys_windows" if windows;

fn drv_manifest(dir: string, fallback: string) -> Manifest* {
  var file: string = dir + "/manifest.toml";
  var rd: FsRead = fs_read(file);
  if (!rd.ok) {
    return man_empty(dir, fallback);
  }
  var m: Manifest* = man_parse(toml_parse(rd.data, file), dir);
  if (slen(m->error) > 0) {
    fail(m->error);
  }
  return m;
}

// Subdirectories, links to directories included.
fn drv_subdirs(dir: string) -> StrList* {
  var files: StrList* = sl_new();
  var dirs: StrList* = sl_new();
  sys_list_dir(dir, files, dirs);
  var i: int64 = 0;
  while (i < files->len) {
    if (fs_is_dir(dir + "/" + sl_get(files, i))) {
      sl_push(dirs, sl_get(files, i));
    }
    i = i + 1;
  }
  free(files->items);
  free(files);
  sl_sort(dirs);
  return dirs;
}

fn drv_free(l: StrList*) {
  free(l->items);
  free(l);
}

fn drv_deps(root: string) -> DepState* {
  var base_dir: string = root + "/.mbuild/deps";
  var ds: DepState* = depstate_empty(base_dir);
  var names: StrList* = drv_subdirs(base_dir);
  var i: int64 = 0;
  while (i < names->len) {
    var dm: DepModule;
    dm.module = sl_get(names, i);
    dm.version = "v1.0.0";
    dm.dir = base_dir + "/" + dm.module;
    dm.is_path = false;
    dm.man = (Manifest*)0;
    dm.replaced = "";
    dm.checksum = "";
    dm.registry = "fixtures";
    // dir stays the link path, so native must resolve it.
    if (sys_is_link(dm.dir)) {
      dm.replaced = "path";
    }
    if (fs_is_file(dm.dir + "/manifest.toml")) {
      dm.man = drv_manifest(dm.dir, dm.module);
    }
    depstate_add(ds, dm);
    i = i + 1;
  }
  drv_free(names);
  return ds;
}

fn main(argc: int32, argv: cstring*) -> int32 {
  esc_init();
  if (argc < 4) {
    err_line("usage: native_test APP linux|windows prepare|doctor|explain LOGFILE|syms FILE|soname FILE");
    return 2;
  }
  var mode: string = s_from_c(argv[3]);
  if (s_eq(mode, "syms")) {
    var l: StrList* = sym_defined(s_from_c(argv[4]));
    say(sym_format(s_from_c(argv[4])) + " " + s_int(l->len));
    say(sl_join(l, "\n"));
    return 0;
  }
  if (s_eq(mode, "soname")) {
    say("soname " + sym_soname(s_from_c(argv[4])));
    return 0;
  }
  var root: string = sys_realpath(s_from_c(argv[1]));
  if (slen(root) == 0) {
    fail("no such directory: " + s_from_c(argv[1]));
  }
  root = s_replace_byte(root, 92, 47);
  var p: Project* = new Project;
  p->root = root;
  p->man = drv_manifest(root, p_base(root));
  p->has_manifest = true;
  p->opts = options_new();
  p->opts->verbose = slen(env_get("MB_VERBOSE")) > 0;
  g_verbose = p->opts->verbose;
  p->state_dir = root + "/.mbuild";
  var ds: DepState* = drv_deps(root);
  var profile: string = env_get("MB_PROFILE");
  if (slen(profile) == 0) {
    profile = "debug";
  }
  var t: TargetCtx* = targetctx_new(p, s_from_c(argv[2]), profile);
  t->compiler_runtime_dir = s_replace_byte(env_get("MB_RUNTIME_DIR"), 92, 47);
  if (s_eq(mode, "prepare")) {
    var nl: NatLink* = nat_prepare(p, ds, t);
    var i: int64 = 0;
    while (i < nl->mettle_args->len) {
      say("arg " + sl_get(nl->mettle_args, i));
      i = i + 1;
    }
    i = 0;
    while (i < nl->env->len) {
      say("env " + sl_get(nl->env, i));
      i = i + 1;
    }
    i = 0;
    while (i < nl->copy_files->len) {
      say("copy " + sl_get(nl->copy_files, i));
      i = i + 1;
    }
    say("fp " + nl->fingerprint);
    return 0;
  }
  if (s_eq(mode, "doctor")) {
    return nat_doctor(p, ds, t);
  }
  if (s_eq(mode, "explain") && argc >= 5) {
    var rd: FsRead = fs_read(s_from_c(argv[4]));
    if (!rd.ok) {
      fail("cannot read " + s_from_c(argv[4]));
    }
    nat_explain_failure(p, ds, t, rd.data);
    return 0;
  }
  err_line("unknown mode " + mode);
  return 2;
}
