// api_test: a command line over src/pkg/api.mettle for tests/e2e/api.sh.
//
//   api_test surface DIR                  one line per export: kind name file:line|sig
//   api_test diff OLD_DIR NEW_DIR [USE]...  "what name" lines, then "--", then api_render
//                                           (each USE is "name file:line")
//   api_test breaking OLD_DIR NEW_DIR [USE]...  the same over api_breaking
//
// Directories may be given in Linux form under wine.

import "std/io";
import "std/mem";
import "../../src/core/base";
import "../../src/pkg/api";
import "../../src/core/sys_linux" if linux;
import "../../src/core/sys_windows" if windows;

fn drv_win_form(p: string) -> string {
  if (sys_is_wine() && s_starts(p, "/")) {
    return "Z:" + p;
  }
  return p;
}

fn drv_surface(dir: string) -> int32 {
  var s: ApiSurface* = api_surface_dir(drv_win_form(dir));
  var i: int64 = 0;
  while (i < s->names->len) {
    say(sl_get(s->kinds, i) + " " + sl_get(s->names, i) + " " + sl_get(s->files, i) + ":" + sl_get(s->lines, i) + "|" + sl_get(s->sigs, i));
    i = i + 1;
  }
  free(s);
  return 0;
}

fn drv_diff(old_dir: string, new_dir: string, uses: StrList*, breaking: bool) -> int32 {
  var a: ApiSurface* = api_surface_dir(drv_win_form(old_dir));
  var b: ApiSurface* = api_surface_dir(drv_win_form(new_dir));
  var d: ApiDiff* = api_diff(a, b);
  if (breaking) {
    var all: ApiDiff* = d;
    d = api_breaking(all);
    free(all);
  }
  var i: int64 = 0;
  while (i < d->what->len) {
    say(sl_get(d->what, i) + " " + sl_get(d->names, i));
    i = i + 1;
  }
  say("--");
  var text: string = api_render(d, uses);
  if (slen(text) > 0) {
    say(text);
  }
  free(a);
  free(b);
  free(d);
  return 0;
}

fn main(argc: int32, argv: cstring*) -> int32 {
  var args: StrList* = sl_new();
  var i: int32 = 1;
  while (i < argc) {
    sl_push(args, s_from_c(argv[i]));
    i = i + 1;
  }
  var code: int32 = 2;
  if (args->len == 2 && s_eq(sl_get(args, 0), "surface")) {
    code = drv_surface(sl_get(args, 1));
  } else if (args->len >= 3 && (s_eq(sl_get(args, 0), "diff") || s_eq(sl_get(args, 0), "breaking"))) {
    var uses: StrList* = sl_new();
    var k: int64 = 3;
    while (k < args->len) {
      sl_push(uses, sl_get(args, k));
      k = k + 1;
    }
    code = drv_diff(sl_get(args, 1), sl_get(args, 2), uses, s_eq(sl_get(args, 0), "breaking"));
  } else {
    err_line("usage: api_driver surface DIR | diff|breaking OLD NEW [USE]...");
  }
  flush_out();
  return code;
}
