// png_test: inflate and the png decoder over tests/fixtures/png (make.py there writes them), the compare with its tolerance, the writer.
//   tools/mcheck.sh tests/unit/png_test.mettle --run -- tests/fixtures/png TMPDIR

import "std/io";
import "std/mem";
import "../../src/core/base";
import "../../src/core/fs";
import "../../src/build/png";

var g_pass: int64 = 0;
var g_fail: int64 = 0;
var g_dir: string = "tests/fixtures/png";
var g_tmp: string = "/tmp";

fn t_eq(name: string, got: string, want: string) {
  if (s_eq(got, want)) {
    g_pass = g_pass + 1;
    say("PASS " + name);
  } else {
    g_fail = g_fail + 1;
    say("FAIL " + name);
    say("     got:  [" + got + "]");
    say("     want: [" + want + "]");
  }
}

fn want_rgba(x: int64, y: int64, ch: int64) -> int64 {
  if (ch == 0) {
    return (x * 16 + y * 3) & 255;
  }
  if (ch == 1) {
    return (y * 32 + x * 5) & 255;
  }
  if (ch == 2) {
    return (x * y * 7 + 40) & 255;
  }
  return (255 - x * 4 - y * 9) & 255;
}

fn want_gray(x: int64, y: int64) -> int64 {
  return (x * 15 + y * 11) & 255;
}

// the first pixel of im that is not what kind says, as "x,y: r g b a", "" when all are.
fn mismatch(im: PngImage, kind: string) -> string {
  var y: int64 = 0;
  while (y < im.h) {
    var x: int64 = 0;
    while (x < im.w) {
      var o: int64 = (y * im.w + x) * 4;
      var e: int64[4];
      var g: int64 = want_gray(x, y);
      var ch: int64 = 0;
      while (ch < 4) {
        e[ch] = want_rgba(x, y, ch);
        ch = ch + 1;
      }
      if (s_eq(kind, "gray") || s_eq(kind, "gray-key") || s_eq(kind, "graya")) {
        e[0] = g;
        e[1] = g;
        e[2] = g;
        if (!s_eq(kind, "graya")) {
          e[3] = 255;
        }
        if (s_eq(kind, "gray-key") && g == want_gray(1, 0)) {
          e[3] = 0;
        }
      } else if (s_eq(kind, "rgb")) {
        e[3] = 255;
      } else if (s_eq(kind, "pal")) {
        var i: int64 = (x * 3 + y) % 50;
        e[0] = i * 5;
        e[1] = 255 - i * 5;
        e[2] = i * 3;
        e[3] = 255 - i;
      }
      ch = 0;
      while (ch < 4) {
        if ((int64)im.rgba[o + ch] != e[ch]) {
          return s_int(x) + "," + s_int(y) + ": " + s_int((int64)im.rgba[o]) + " " + s_int((int64)im.rgba[o + 1]) + " " + s_int((int64)im.rgba[o + 2]) + " " + s_int((int64)im.rgba[o + 3]);
        }
        ch = ch + 1;
      }
      x = x + 1;
    }
    y = y + 1;
  }
  return s_empty();
}

fn decoded(file: string, kind: string) -> string {
  var im: PngImage = png_read(g_dir + "/" + file);
  if (!im.ok) {
    return im.err;
  }
  var r: string = s_int(im.w) + "x" + s_int(im.h) + " " + mismatch(im, kind);
  free(im.rgba);
  return r;
}

fn test_decode() {
  t_eq("gray, filters 0-4 by row", decoded("g8.png", "gray"), "16x8 ");
  t_eq("gray with a tRNS key", decoded("g8_key.png", "gray-key"), "16x8 ");
  t_eq("gray + alpha", decoded("ga8.png", "graya"), "16x8 ");
  t_eq("rgb", decoded("rgb8.png", "rgb"), "16x8 ");
  t_eq("palette with tRNS", decoded("pal8.png", "pal"), "16x8 ");
  t_eq("rgba, stored blocks", decoded("rgba8_stored.png", "rgba"), "16x8 ");
  t_eq("rgba, fixed Huffman", decoded("rgba8_fixed.png", "rgba"), "16x8 ");
  t_eq("rgba, dynamic Huffman", decoded("rgba8_dyn.png", "rgba"), "64x32 ");
  t_eq("interlaced: refused", decoded("interlaced.png", "rgba"), "is interlaced (mbuild reads non-interlaced PNGs)");
  t_eq("16 bits: refused", decoded("g16.png", "gray"), "has bit depth 16 (mbuild reads 8)");
  t_eq("not a PNG", decoded("make.py", "rgba"), "is not a PNG file");
}

fn cmp(file: string, tol: string) -> string {
  return png_compare(g_dir + "/rgba8.png", g_dir + "/" + file, tol, g_tmp + "/png_test.diff.png");
}

fn test_compare() {
  t_eq("same pixels, stored blocks", cmp("rgba8_stored.png", "0"), "");
  t_eq("exact: any difference fails", cmp("rgba8_near.png", "0"), "differs: 3 of 128 pixels beyond 0 (at most 0), channels off by up to 48");
  t_eq("C alone: F 0", cmp("rgba8_near.png", "3"), "differs: 1 of 128 pixels beyond 3 (at most 0), channels off by up to 48");
  t_eq("C covers it", cmp("rgba8_near.png", "48"), "");
  t_eq("fraction: too many pixels", cmp("rgba8_near.png", "2,0.01,48"), "differs: 2 of 128 pixels beyond 2 (at most 1), channels off by up to 48");
  t_eq("fraction: within", cmp("rgba8_near.png", "3,0.01,48"), "");
  t_eq("hard limit", cmp("rgba8_near.png", "3,0.01,47"), "differs: 1 of 128 pixels beyond 3, a channel off by 48 (at most 47)");
  t_eq("size mismatch", cmp("rgba8_wide.png", "255"), "is 17x8, expected 16x8");
  var d: PngImage = png_read(g_tmp + "/png_test.diff.png");
  t_eq("diff image: red where pixels failed", s_int(d.w) + " " + s_int((int64)d.rgba[8]) + "," + s_int((int64)d.rgba[9]) + "," + s_int((int64)d.rgba[10]) + " " + s_int((int64)d.rgba[1] == (int64)d.rgba[0]), "16 255,0,0 1");
}

fn test_write() {
  var im: PngImage = png_read(g_dir + "/rgba8_dyn.png");
  var path: string = g_tmp + "/png_test.round.png";
  fs_write(path, png_encode(im.w, im.h, im.rgba));
  t_eq("written, read back", decoded_at(path), "64x32 ");
}

fn decoded_at(path: string) -> string {
  var im: PngImage = png_read(path);
  if (!im.ok) {
    return im.err;
  }
  return s_int(im.w) + "x" + s_int(im.h) + " " + mismatch(im, "rgba");
}

fn main(argc: int32, argv: cstring*) -> int32 {
  if (argc > 1) {
    g_dir = s_from_c(argv[1]);
  }
  if (argc > 2) {
    g_tmp = s_from_c(argv[2]);
  }
  test_decode();
  test_compare();
  test_write();
  say("");
  say("png_test: " + s_int(g_pass) + " passed, " + s_int(g_fail) + " failed");
  flush_out();
  if (g_fail > 0) {
    return 1;
  }
  return 0;
}
