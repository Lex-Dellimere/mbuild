// manifest_test: typed build settings, [replace], submodules, [package]
// mettle and mbuild.local.toml (DESIGN.md 12.21 Group M).
//
//   tools/mcheck.sh tests/manifest_test.mettle --run
//
// A program, not an @test suite: `mettle test` (head and v0.17.0) dies with
// an internal compiler error (segfault in IR lowering) on an @test function
// that runs these checks.

import "std/io";
import "../src/base";
import "../src/toml";
import "../src/manifest";

var g_pass: int64 = 0;
var g_fail: int64 = 0;

fn t_ok(name: string, ok: bool) {
  if (ok) {
    g_pass = g_pass + 1;
    say("PASS " + name);
  } else {
    g_fail = g_fail + 1;
    say("FAIL " + name);
  }
}

fn t_eq(name: string, got: string, want: string) {
  if (s_eq(got, want)) {
    g_pass = g_pass + 1;
    say("PASS " + name);
  } else {
    g_fail = g_fail + 1;
    say("FAIL " + name);
    say("     got:  [" + got + "]");
    say("     want: [" + want + "]");
  }
}

fn t_has(name: string, got: string, part: string) {
  if (s_contains(got, part)) {
    g_pass = g_pass + 1;
    say("PASS " + name);
  } else {
    g_fail = g_fail + 1;
    say("FAIL " + name);
    say("     got:  [" + got + "]");
    say("     want: ...[" + part + "]...");
  }
}

var g_kept: Settings* = (Settings*)0;

// Test settings are kept (a short-lived program; this also satisfies the memory analyser).
fn keep(s: Settings*) {
  g_kept = s;
}

fn man_of(text: string) -> Manifest* {
  return man_parse(toml_parse(text, "/p/mbuild.toml"), "/p");
}

fn pkg(rest: string) -> string {
  return "[package]\nname = \"x\"\n" + rest;
}

fn query(profile: string, bin: string, target: string, sets: StrList*) -> SettingsQuery* {
  var q: SettingsQuery* = new SettingsQuery;
  q->profile = profile;
  q->bin = bin;
  q->target = target;
  q->sets = sets;
  return q;
}

// The flags of a profile (no bin, linux), joined by ",", or "ERR: ..." on an error.
fn flags_of(m: Manifest*, profile: string) -> string {
  var s: Settings* = man_settings(m, query(profile, "", "linux", (StrList*)0));
  keep(s);
  if (slen(s->error) > 0) {
    return "ERR: " + s->error;
  }
  return sl_join(man_settings_flags(s, "linux"), ",");
}

fn test_settings() {
  var e: Manifest* = man_of(pkg(""));
  t_eq("empty: valid", e->error, "");
  t_eq("empty: debug", flags_of(e, "debug"), "-s");
  t_eq("empty: release", flags_of(e, "release"), "--release");
  t_eq("empty: profile names", sl_join(man_profile_names(e), ","), "debug,release");
  t_ok("empty: has debug, not fast", man_has_profile(e, "debug") && !man_has_profile(e, "fast"));
  t_eq("empty: unknown profile", flags_of(e, "relase"), "ERR: unknown profile 'relase' (did you mean 'release'?)");
  t_eq("compat: man_profile_flags debug", sl_join(man_profile_flags(e, "debug"), ","), "");
  t_eq("compat: man_profile_flags release", sl_join(man_profile_flags(e, "release"), ","), "--release");

  var r: Manifest* = man_of(pkg("[profile.release]\nflags = [\"--safe\"]\n"));
  t_eq("release flags: valid", r->error, "");
  t_eq("release flags --safe", flags_of(r, "release"), "--release,--safe");

  var rr: Manifest* = man_of(pkg("[profile.release]\nflags = [\"--release\"]\n"));
  t_eq("release flags --release: no parse warning", sl_join(rr->warnings, "|"), "");
  var rs: Settings* = man_settings(rr, query("release", "", "linux", (StrList*)0));
  keep(rs);
  t_eq("release flags --release: once", sl_join(man_settings_flags(rs, "linux"), ","), "--release");
  t_has("release flags --release: warning", sl_join(rs->warnings, "|"), "use optimize = \"full\"");
  t_eq("release flags --release: warning text", sl_join(rs->warnings, "|"), "/p/mbuild.toml:4: flags = [\"--release\"]: use optimize = \"full\" (mbuild passes it for you)");

  var f: Manifest* = man_of(pkg("[profile.fast]\ninherits = \"release\"\ncheck-overflow = true\n"));
  t_eq("fast: valid", f->error, "");
  t_eq("fast: no warnings", sl_join(f->warnings, "|"), "");
  t_eq("fast inherits release", flags_of(f, "fast"), "--release,--check-overflow");
  var fs: Settings* = man_settings(f, query("fast", "", "linux", (StrList*)0));
  keep(fs);
  t_eq("fast: origins", sl_join(fs->origins, ","), "check-overflow=mbuild.toml:5");
  t_eq("fast: profile names", sl_join(man_profile_names(f), ","), "debug,release,fast");
  var fa: Manifest* = man_of(pkg("[profile.fast]\n"));
  t_eq("fast alone inherits debug", flags_of(fa, "fast"), "-s");
  t_ok("fast alone exists", man_has_profile(fa, "fast"));

  var cy: Manifest* = man_of(pkg("[profile.a]\ninherits = \"b\"\n[profile.b]\ninherits = \"a\"\n"));
  t_has("cycle: inherits", cy->error, "inherits");
  t_has("cycle: cycle", cy->error, "cycle");
  t_eq("cycle: message", cy->error, "/p/mbuild.toml:6: [profile.b] inherits = \"a\": the inherits chain is a cycle (a -> b -> a)");
  var ty: Manifest* = man_of(pkg("[profile.fast]\ninherits = \"relase\"\n"));
  t_has("inherits typo", ty->error, "did you mean \"release\"");

  var bad: Manifest* = man_of(pkg("[profile.release]\noptimize = \"fast\"\n"));
  t_eq("bad enum", bad->error, "/p/mbuild.toml:4: optimize = \"fast\" is not one of \"off\", \"checked\", \"full\" (did you mean \"full\"?)");
  var sy: Manifest* = man_of(pkg("[profile.debug]\nsafe = \"yes\"\n"));
  t_eq("bool type", sy->error, "/p/mbuild.toml:4: `safe` must be true or false");
  var unk: Manifest* = man_of(pkg("[profile.debug]\nsfae = true\n"));
  t_eq("unknown key warning", sl_join(unk->warnings, "|"), "/p/mbuild.toml:4: unknown key 'sfae' in [profile.debug] (did you mean 'safe'?)");

  var b: Manifest* = man_of(pkg("[bin.tool]\nmain = \"tool.mettle\"\nnative-heap = true\nsubsystem = \"windows\"\n"));
  t_eq("bin: valid", b->error, "");
  var bs: Settings* = man_settings(b, query("debug", "tool", "windows", (StrList*)0));
  keep(bs);
  t_eq("bin: windows", sl_join(man_settings_flags(bs, "windows"), ","), "-s,--native-heap,--subsystem,windows");
  t_eq("bin: linux", sl_join(man_settings_flags(bs, "linux"), ","), "-s,--native-heap");
  t_eq("bin: other bin unaffected", flags_of(b, "debug"), "-s");

  var sets: StrList* = sl_new();
  sl_push(sets, "optimize=checked");
  sl_push(sets, "safe=true");
  var ss: Settings* = man_settings(e, query("debug", "", "linux", sets));
  keep(ss);
  t_eq("sets on debug", sl_join(man_settings_flags(ss, "linux"), ","), "-O,--safe,-s");
  t_eq("sets origins", sl_join(ss->origins, ","), "optimize=--set,safe=--set");
  var sets2: StrList* = sl_of("optimize=\"full\"");
  var s2: Settings* = man_settings(e, query("debug", "", "linux", sets2));
  keep(s2);
  t_eq("sets quoted value", sl_join(man_settings_flags(s2, "linux"), ","), "--release,-s");
  var s3: Settings* = man_settings(e, query("debug", "", "linux", sl_of("safe=yes")));
  keep(s3);
  t_eq("sets bool error", s3->error, "--set safe=yes: `safe` must be true or false");
  var s4: Settings* = man_settings(e, query("debug", "", "linux", sl_of("optimise=full")));
  keep(s4);
  t_eq("sets unknown key", s4->error, "--set optimise=full: unknown key 'optimise' (did you mean 'optimize'?)");
  var s5: Settings* = man_settings(e, query("debug", "", "linux", sl_of("stack-trace=false")));
  keep(s5);
  t_eq("sets turn off built-in", sl_join(man_settings_flags(s5, "linux"), ","), "");

  var pu: Manifest* = man_of(pkg("[profile.release]\npgo = \"use\"\n"));
  t_eq("pgo use: parses", pu->error, "");
  t_has("pgo use without file", flags_of(pu, "release"), "ERR: mbuild.toml:4: pgo = \"use\" needs pgo-file");
  var pf: Manifest* = man_of(pkg("[profile.release]\npgo = \"use\"\npgo-file = \"pgo/a.prof\"\n"));
  t_eq("pgo use with file", flags_of(pf, "release"), "--release,--pgo-use=pgo/a.prof");

  var bf: Manifest* = man_of(pkg("[build]\nflags = [\"--explain\"]\n[profile.debug]\nflags = [\"-s\", \"--foo\"]\n"));
  t_eq("raw flags: order and dedupe", flags_of(bf, "debug"), "-s,--foo,--explain");
  var cf: Manifest* = man_of(pkg("[profile.debug]\ncflags = [\"-O1\"]\n[profile.fast]\ncflags = [\"-O2\"]\n"));
  t_eq("cflags along the chain", sl_join(man_profile_cflags(cf, "fast"), ","), "-O1,-O2");
}

fn test_replace_and_subs() {
  var r: Manifest* = man_of(pkg("[replace]\n\"github.com/demo/strutil\" = {{ path = \"../strutil\" }\n\"github.com/demo/json\" = {{ url = \"https://github.com/me/json\", version = \"v1.4.1\" }\n\"github.com/demo/apilib\" = {{ version = \"v2.0.0\" }\n[replace.\"github.com/demo/edge\"]\nurl = \"git@github.com:me/edge.git\"\n"));
  t_eq("replace: valid", r->error, "");
  t_eq("replace: no warnings", sl_join(r->warnings, "|"), "");
  t_ok("replace: four", r->nreplaces == 4);
  var a: ReplaceSpec* = man_replace_find(r, "github.com/demo/strutil");
  t_eq("replace: path", a->path + "|" + a->url + "|" + a->version + "|" + s_int(a->line), "../strutil|||4");
  var j: ReplaceSpec* = man_replace_find(r, "github.com/demo/json");
  t_eq("replace: fork", j->path + "|" + j->url + "|" + j->version, "|https://github.com/me/json|v1.4.1");
  t_eq("replace: version", man_replace_find(r, "github.com/demo/apilib")->version, "v2.0.0");
  t_eq("replace: table form", man_replace_find(r, "github.com/demo/edge")->url, "git@github.com:me/edge.git");
  t_ok("replace: absent", man_replace_find(r, "github.com/x/y") == (ReplaceSpec*)0);
  var pv: Manifest* = man_of(pkg("[replace]\n\"github.com/a/b\" = {{ path = \"../b\", version = \"v1\" }\n"));
  t_eq("replace: path and version", pv->error, "/p/mbuild.toml:4: [replace] \"github.com/a/b\": path excludes url and version (a local checkout is used as it is)");
  var mk: Manifest* = man_of(pkg("[replace]\nmylib = {{ path = \"../b\" }\n"));
  t_has("replace: key not a module", mk->error, "[replace] keys are module paths");

  var d: Manifest* = man_of(pkg("[dependencies]\n\"github.com/a/w\" = {{ version = \"v1.0.0\", submodules = false }\n\"github.com/a/b\" = {{ version = \"v2.1.0\", submodules = [\"a\", \"b\"] }\n\"github.com/a/c\" = \"v1.0.0\"\n[dependencies.\"github.com/a/t\"]\nsubmodules = true\n"));
  t_eq("subs: valid", d->error, "");
  t_eq("subs: false", man_dep_find(d, "github.com/a/w")->subs_mode, "none");
  t_eq("subs: list", man_dep_find(d, "github.com/a/b")->subs_mode + " " + sl_join(man_dep_find(d, "github.com/a/b")->subs, ","), "list a,b");
  t_eq("subs: default", man_dep_find(d, "github.com/a/c")->subs_mode, "");
  t_eq("subs: table form", man_dep_find(d, "github.com/a/t")->subs_mode, "all");
  var ds: Manifest* = man_of(pkg("[dependencies]\n\"github.com/a/w\" = {{ version = \"v1.0.0\", submodules = \"x\" }\n"));
  t_eq("subs: string is an error", ds->error, "/p/mbuild.toml:4: dependency 'github.com/a/w': submodules must be true, false or an array of submodule paths");
  var ps: Manifest* = man_of("[package]\nname = \"x\"\nsubmodules = [\"vendor/clib\"]\nmettle = \"0.17\"\n");
  t_eq("package: valid", ps->error, "");
  t_eq("package: submodules", ps->subs_mode + " " + sl_join(ps->subs, ","), "list vendor/clib");
  t_eq("package: mettle normalised", ps->mettle_min, "v0.17.0");
  t_eq("package: defaults", e_defaults(), "all||0");
  var pl: Manifest* = man_of("[package]\nname = \"x\"\nmettle = \"latest\"\n");
  t_has("package: mettle latest", pl->error, "/p/mbuild.toml:3: [package] mettle = \"latest\" is not a Mettle version");

  var tw: Manifest* = man_of(pkg("[tools]\ngit = \"/usr/bin/git\"\n[workspace]\nmembers = []\n"));
  t_eq("tools: parsed", sl_join(tw->tools, ","), "git=/usr/bin/git");
  t_eq("tools/workspace warnings", sl_join(tw->warnings, "|"), "/p/mbuild.toml:3: [tools] is machine-specific: move it to mbuild.local.toml|/p/mbuild.toml:5: workspaces are not supported yet; use path dependencies (docs/dependencies.md)");

  var it: Toml* = toml_parse("a = {{ s = [\"x\", \"y\"], b = false }\n", "t.toml");
  t_eq("toml: inline array", it->error + toml_field(toml_get(it, "", "a"), "s") + " " + toml_field_kind(toml_get(it, "", "a"), "s"), "[\"x\", \"y\"] 4");
  t_eq("toml: inline array value", sl_join(toml_field_value(toml_get(it, "", "a"), "s")->items, ","), "x,y");
  t_ok("toml: field value absent", toml_field_value(toml_get(it, "", "a"), "z") == (TomlValue*)0);
}

fn e_defaults() -> string {
  var e: Manifest* = man_of(pkg(""));
  return e->subs_mode + "|" + e->mettle_min + "|" + s_int(e->nreplaces);
}

fn local_of(text: string) -> Manifest* {
  return man_parse_local(toml_parse(text, "/p/mbuild.local.toml"), "/p");
}

fn test_local() {
  var bad: Manifest* = local_of("[tools]\ngit = \"g\"\n[dependencies]\n\"github.com/a/b\" = \"v1\"\n");
  t_eq("local: [dependencies]", bad->error, "/p/mbuild.local.toml:3: [dependencies] is not allowed here (mbuild.local.toml holds [replace], [tools], [profile.NAME] and [build] targets)");
  var bb: Manifest* = local_of("[build]\nflags = [\"-x\"]\n");
  t_has("local: [build] flags", bb->error, "[build] flags is not allowed in mbuild.local.toml");

  var m: Manifest* = man_of(pkg("[build]\ntargets = [\"linux\", \"windows\"]\n[tools]\ncc = \"gcc\"\ngit = \"git\"\n[profile.release]\ncflags = [\"-O2\"]\n[replace]\n\"github.com/demo/json\" = {{ version = \"v1.4.1\" }\n\"github.com/demo/strutil\" = {{ version = \"v1.0.0\" }\n"));
  t_eq("local main: valid", m->error, "");
  var l: Manifest* = local_of("[replace]\n\"github.com/demo/strutil\" = {{ path = \"../strutil\" }\n[tools]\ngit = \"/usr/bin/git\"\n[profile.release]\ncflags = [\"-march=native\"]\nsafe = true\n[profile.mine]\ninherits = \"release\"\n[build]\ntargets = [\"linux\"]\n");
  t_eq("local: valid", l->error, "");
  t_eq("local: no warnings", sl_join(l->warnings, "|"), "");
  man_merge_local(m, l);
  t_eq("merge: error", m->error, "");
  t_eq("merge: targets", sl_join(m->targets, ","), "linux");
  t_eq("merge: tools", sl_join(m->tools, ","), "cc=gcc,git=/usr/bin/git");
  t_eq("merge: cflags", sl_join(man_profile_cflags(m, "release"), ","), "-O2,-march=native");
  t_eq("merge: release flags", flags_of(m, "release"), "--release,--safe");
  t_eq("merge: local profile", flags_of(m, "mine"), "--release,--safe");
  t_eq("merge: profile names", sl_join(man_profile_names(m), ","), "debug,release,mine");
  var su: ReplaceSpec* = man_replace_find(m, "github.com/demo/strutil");
  t_ok("merge: local replace wins", su->local && s_eq(su->path, "../strutil"));
  t_ok("merge: main replace kept", !man_replace_find(m, "github.com/demo/json")->local);
  t_ok("merge: replace count", m->nreplaces == 2);
  var rs: Settings* = man_settings(m, query("release", "", "linux", (StrList*)0));
  keep(rs);
  t_eq("merge: origin from local", sl_join(rs->origins, ","), "safe=mbuild.local.toml:7");
}

fn run_all() -> int64 {
  test_settings();
  test_replace_and_subs();
  test_local();
  say("");
  say("manifest_test: " + s_int(g_pass) + " passed, " + s_int(g_fail) + " failed");
  flush_out();
  return g_fail;
}

fn main() -> int32 {
  if (run_all() > 0) {
    return 1;
  }
  return 0;
}
